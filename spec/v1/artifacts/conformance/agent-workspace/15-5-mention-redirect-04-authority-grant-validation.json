{
  "vector_id": "15-5-mention-redirect-04",
  "spec_section": "§15.5.30",
  "title": "authority_grant_ref validation: revoked / subject mismatch / controller mismatch",
  "negative": true,
  "preconditions": {
    "sender_principal": "did:web:alice.example",
    "comment": "Three sub-cases share the same overall negative outcome."
  },
  "sub_cases": [
    {
      "case_id": "04a-revoked",
      "grant_state": {
        "id": "cx:grant:01964200-0000-7000-8000-revoked00000",
        "subject": "did:web:alice-agent.example",
        "active": false,
        "revoked_at_anchor": "cx:anchor:01964200-0000-7000-8000-revokerAnchor"
      },
      "expected_reason": "authority_grant_revoked"
    },
    {
      "case_id": "04b-subject-mismatch",
      "grant_state": {
        "id": "cx:grant:01964200-0000-7000-8000-mismatch00001",
        "subject": "did:web:other-agent.example",
        "active": true,
        "attached_authority": { "controller": "did:web:alice.example" }
      },
      "input_target_actor_id": "did:web:alice-agent.example",
      "expected_reason": "authority_grant_subject_mismatch"
    },
    {
      "case_id": "04c-controller-mismatch",
      "grant_state": {
        "id": "cx:grant:01964200-0000-7000-8000-mismatch00002",
        "subject": "did:web:alice-agent.example",
        "active": true,
        "attached_authority": { "controller": "did:web:eve.example" }
      },
      "sender_principal": "did:web:alice.example",
      "expected_reason": "authority_grant_controller_mismatch"
    }
  ],
  "input_event_template": {
    "kind": "cx.message.create",
    "submitter": "did:web:alice.example",
    "requirements": {
      "critical_extensions": [
        {
          "id": "cx.feature.mention_redirect.v1",
          "scope": "payload",
          "fail_closed": true,
          "schema_ref": "cx.schema.content.mention_redirect.v1"
        }
      ]
    },
    "payload": {
      "flow_id": "cx:flow:01964200-0000-7000-8000-000000000011",
      "content": {
        "kind": "cx.content.mention_redirect",
        "body": "varies per sub_case",
        "target_actor_id": "did:web:alice-agent.example",
        "authority_grant_ref": "<sub_case.grant_state.id>",
        "redirect_pair_id": "01964200-0000-7000-8000-dddddddddddd"
      }
    }
  },
  "expected_outcome": {
    "reducer_result": "unauthorized",
    "reason_per_sub_case": "see sub_cases[*].expected_reason",
    "design_note": "All three branches MUST land as `unauthorized` so callers cannot probe grant state via differential error codes; reason is for audit only."
  }
}
