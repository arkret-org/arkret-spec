{
  "vector_id": "15-1-execution-09",
  "spec_section": "§15.1.9",
  "title": "Multiple watchers write same transition → second is FSM precondition no-op",
  "preconditions": {
    "task_state": {
      "execution_state": "active",
      "transparency": "ok",
      "source_authority": "ok"
    },
    "comment": "Controller's client and agent runtime both observe the cancel intent and both submit the same transition."
  },
  "input_events": [
    {
      "kind": "cx.agent_task.execution.transition",
      "submitter": "controller_client",
      "payload": {
        "task_id": "cx:agent_task:01964200-0000-7000-8000-000000000001",
        "cell": "agent_task.cx:agent_task:01964200-0000-7000-8000-000000000001.execution_state",
        "op": "transition",
        "from": "active",
        "to": "cancelled_by_controller",
        "reason": "controller_interrupt"
      }
    },
    {
      "kind": "cx.agent_task.execution.transition",
      "submitter": "agent_runtime",
      "payload": {
        "task_id": "cx:agent_task:01964200-0000-7000-8000-000000000001",
        "cell": "agent_task.cx:agent_task:01964200-0000-7000-8000-000000000001.execution_state",
        "op": "transition",
        "from": "active",
        "to": "cancelled_by_controller",
        "reason": "controller_interrupt"
      }
    }
  ],
  "expected_outcomes": [
    {
      "submitter": "controller_client",
      "reducer_result": "accepted",
      "cell_changes": [
        {
          "cell": "agent_task.cx:agent_task:01964200-0000-7000-8000-000000000001.execution_state",
          "before": "active",
          "after": "cancelled_by_controller"
        }
      ]
    },
    {
      "submitter": "agent_runtime",
      "reducer_result": "failed_precondition",
      "reason": "invalid_task_fsm_transition",
      "response_includes": {
        "current_state": "cancelled_by_controller"
      }
    }
  ],
  "design_note": "Multi-watcher idempotence by FSM `from` precondition. NOT by ⊥ because cas-register predicate filters siblings out."
}
