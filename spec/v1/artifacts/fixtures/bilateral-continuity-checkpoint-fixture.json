{
  "suite": "bilateral_continuity_checkpoint",
  "version": "2026-09-10",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.contact.bilateral_continuity_checkpoint.v1"
  },
  "covers_vectors": [
    "ak.vector.contact.bilateral_continuity_checkpoint.v1"
  ],
  "machine_contracts": [
    "schemas/contact-operations.schema.json#/$defs/bilateral_continuity_checkpoint",
    "schemas/contact-operations.schema.json#/$defs/bilateral_continuity_checkpoint_proposal",
    "schemas/contact-operations.schema.json#/$defs/contact_continuity_evidence",
    "registry/operation-registry.json#ak.self.contact.command.checkpoint.v1",
    "registry/operation-registry.json#ak.peer.contacts.command.submit.v1",
    "registry/outward-disclosure-policy-registry.json"
  ],
  "cases": [
    {
      "name": "root_basis_digest_is_sha256_of_jcs_and_not_wire_state",
      "root_basis": {
        "contact_round_id": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "contact_round": {
          "kind": "normal",
          "sorted_pair_member_ids": [
            "ak:did_core:webvh:z6mkfixturealice",
            "ak:did_core:webvh:z6mkfixturebob"
          ],
          "request_event_ref": "ak:event:AQJmSg1s9QyzppFeJL40dN92YVHZeLdBBt3UWHa9XNOD",
          "request_acceptance_receipt_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
        },
        "request_receipts": [],
        "current_proofs": []
      },
      "expected_root_basis_digest": "sha256:dbd01b215216be726eed28eda97ffa2b2777da213df66bcc5ca399e0f9b13787",
      "wire_member": false
    },
    {
      "name": "history_beyond_64_uses_checkpoint_and_bounded_tail",
      "covered_prefix_count": 64,
      "uncompressed_tail_count": 64,
      "expected": "accepted_and_reaches_unique_root"
    },
    {
      "name": "same_sequence_different_digest_is_fork",
      "sequence": 7,
      "checkpoint_digests": [
        "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "expected_error": "continuity_invalid",
      "winner": null
    },
    {
      "name": "single_roundtrip_countersigns_and_commits_same_checkpoint",
      "peer_operation": "ak.peer.contacts.command.submit.v1",
      "control_kind": "continuity_checkpoint",
      "proposer_signature_count": 1,
      "committed_signature_count": 2,
      "expected": "both_sides_commit_same_checkpoint_digest"
    },
    {
      "name": "response_loss_replays_same_completed_checkpoint",
      "request_replay": "exact",
      "recomputed_signature": false,
      "expected": "same_checkpoint_and_control_receipt_bytes"
    },
    {
      "name": "rollback_or_missing_checkpoint_predecessor_is_invalid",
      "expected_error": "continuity_invalid"
    },
    {
      "name": "wrong_root_pair_accumulator_or_single_signature_is_invalid",
      "expected_error": "continuity_invalid"
    },
    {
      "name": "temporarily_missing_portable_material_is_unavailable",
      "expected_error": "continuity_evidence_unavailable",
      "retry_after_import": true
    },
    {
      "name": "migrated_holder_imports_checkpoint_without_skipping_tail",
      "expected": "accepted_only_after_exact_checkpoint_and_tail_validation"
    },
    {
      "name": "same_exact_pair_cannot_restart_root_when_tail_is_full",
      "same_trust_domain": true,
      "same_actor_pair": true,
      "uncompressed_tail_count": 64,
      "checkpoint_available": false,
      "expected_error": "continuity_evidence_unavailable",
      "may_restart_root": false
    },
    {
      "name": "different_exact_pair_explicit_first_contact_has_independent_root",
      "same_actor_pair": false,
      "explicit_user_action": true,
      "inherits_history": false,
      "inherits_direct_conversation": false,
      "inherits_mls_state": false,
      "expected": "independent_root"
    }
  ],
  "outward_equivalence": {
    "continuity_evidence_unavailable": {
      "http_status": 409,
      "body_shape": "fixed",
      "contact_state_detail": "omitted"
    },
    "continuity_invalid": {
      "http_status": 409,
      "body_shape": "fixed",
      "contact_state_detail": "omitted"
    }
  }
}
