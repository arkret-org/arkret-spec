{
  "profile": "ak.vector_group.security_transaction.v1",
  "version": "2026-09-15.1",
  "suite": "security_transaction_resilience",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.security_transaction.resilience.v1"
  },
  "covers_vectors": [
    "ak.vector.security_transaction.resilience.v1",
    "ak.vector.security_transaction.recovery_terminal_commit.v1"
  ],
  "schema_validation_cases": [
    {
      "name": "backup_rotation_binding_is_closed_per_kind",
      "schema_ref": "schemas/security-transaction.schema.json#/$defs/backup_rotation_binding",
      "expect_valid": true,
      "instance": {
        "backup_kind": "secret_storage",
        "previous_series_id": "ak:backup_series:019a7400-0000-7000-8000-000000000001",
        "new_series_id": "ak:backup_series:019a7400-0000-7000-8000-000000000002",
        "new_backups": [
          {
            "backup_id": "ak:backup:019a7400-0000-7000-8000-000000000003",
            "ciphertext_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ],
        "active_series_event_id": "ak:event:AWKDhmQTc5zyfilaLwPF3xnhoZAjxSha7Z-6grioN9aW",
        "old_backups": [
          {
            "backup_id": "ak:backup:019a7400-0000-7000-8000-000000000005",
            "ciphertext_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        ]
      }
    },
    {
      "name": "partial_series_erase_outcome_has_no_confirmation",
      "schema_ref": "schemas/keys-operations.schema.json#/$defs/backup_series_erase_outcome",
      "expect_valid": true,
      "instance": {
        "transaction_id": "ak:transaction:019a7400-0000-7000-8000-000000000006",
        "request_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "status": "partial",
        "series_results": [
          {
            "backup_kind": "secret_storage",
            "previous_series_id": "ak:backup_series:019a7400-0000-7000-8000-000000000001",
            "new_series_id": "ak:backup_series:019a7400-0000-7000-8000-000000000002",
            "status": "erased",
            "erased_backups": [
              {
                "backup_id": "ak:backup:019a7400-0000-7000-8000-000000000005",
                "ciphertext_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
              }
            ],
            "remaining_backups": []
          },
          {
            "backup_kind": "mls_history",
            "previous_series_id": "ak:backup_series:019a7400-0000-7000-8000-000000000011",
            "new_series_id": "ak:backup_series:019a7400-0000-7000-8000-000000000012",
            "status": "failed_retryable",
            "erased_backups": [],
            "remaining_backups": [
              {
                "backup_id": "ak:backup:019a7400-0000-7000-8000-000000000015",
                "ciphertext_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
              }
            ],
            "reason_code": "storage_temporarily_unavailable"
          }
        ]
      }
    }
  ],
  "fault_matrix": {
    "transaction_kinds": [
      "recovery",
      "security_rotation"
    ],
    "fault_positions": [
      "before_remote_side_effect",
      "after_remote_side_effect_before_local_commit",
      "after_local_commit_before_response"
    ],
    "faults": [
      "crash",
      "response_lost",
      "coordinator_restart",
      "exact_request_replay",
      "conflicting_request_replay",
      "staged_secret_lost",
      "terminal_replay"
    ]
  },
  "assertions": [
    "one_transaction_id_and_one_reserved_id_set",
    "request_plan_step_outputs_and_first_terminal_result_are_durable",
    "exact_replay_returns_the_stored_outcome",
    "conflicting_replay_returns_duplicate_conflict",
    "accepted_webvh_entry_resumes_the_same_reanchor_unit",
    "coordinator_owned_prefix_is_advanced_only_by_the_durable_worker",
    "continue_accepts_only_a_terminal_ready_client_attestation",
    "device_attestation_readiness_is_derived_from_canonical_next_step",
    "recovery_create_freezes_one_unsigned_seal_body_with_no_recovery_effect",
    "recovery_authoritative_results_are_all_invisible_before_the_commit_and_all_visible_after",
    "recovery_first_generation_seal_enters_only_through_commit_recovery_unit",
    "recovery_stored_outcome_is_checked_before_consumed_session_refusal",
    "only_the_atomic_generation_cas_winner_commits_a_first_generation_seal",
    "pointer_switch_precedes_every_old_series_erase",
    "erased_series_never_becomes_active_again",
    "public_store_log_telemetry_and_crash_artifact_contain_no_secret_material"
  ],
  "rotation_cases": [
    {
      "name": "partial_secret_storage_erase_then_restart",
      "authoritative_new_pointers": [
        "secret_storage",
        "mls_history"
      ],
      "first_outcome": {
        "secret_storage": "erased",
        "mls_history": "failed_retryable"
      },
      "expected_after_restart": {
        "secret_storage": "erased",
        "mls_history": "erased",
        "confirmation_emitted_once": true,
        "accepted_erase_step_count": 1
      }
    },
    {
      "name": "erase_before_both_pointer_switches",
      "authoritative_new_pointers": [
        "secret_storage"
      ],
      "expected": {
        "decision": "reject",
        "reason": "failed_precondition",
        "old_backup_deleted": false
      }
    }
  ],
  "continue_cases": [
    {
      "name": "rotation_prefix_one_is_worker_owned",
      "transaction_kind": "security_rotation",
      "accepted_step_count": 1,
      "derived_next_step": "upload_new_material",
      "driver": "durable_transaction_worker",
      "client_continue_present": false,
      "expected": "worker_resumes_same_step"
    },
    {
      "name": "rotation_prefix_four_attested_terminal_continue",
      "transaction_kind": "security_rotation",
      "accepted_step_count": 4,
      "derived_next_step": "local_commit",
      "client_attestation_step": "local_commit",
      "cas_matches": true,
      "reserved_output_matches": true,
      "expected": "accept_terminal_step"
    },
    {
      "name": "rotation_prefix_one_attestation_cannot_drive_worker_step",
      "transaction_kind": "security_rotation",
      "accepted_step_count": 1,
      "derived_next_step": "upload_new_material",
      "client_attestation_step": "local_commit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "continue_without_attestation_is_not_get_alias",
      "transaction_kind": "recovery",
      "accepted_step_count": 0,
      "derived_next_step": "commit_recovery_unit",
      "client_attestation_present": false,
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "recovery_prefix_zero_attested_terminal_continue",
      "transaction_kind": "recovery",
      "accepted_step_count": 0,
      "derived_next_step": "commit_recovery_unit",
      "client_attestation_step": "commit_recovery_unit",
      "cas_matches": true,
      "reserved_output_matches": true,
      "expected": "accept_terminal_step"
    },
    {
      "name": "recovery_has_no_coordinator_owned_prefix",
      "transaction_kind": "recovery",
      "accepted_step_count": 1,
      "derived_next_step": null,
      "client_attestation_step": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    }
  ],
  "recovery_terminal_commit_cases": [
    {
      "name": "create_freezes_the_only_signable_seal_body",
      "phase": "create",
      "expected": "freeze_prepared_plan",
      "frozen_plan_members": [
        "binding.reanchor_batch_receipt_id",
        "binding.first_generation_seal_id",
        "binding.terminal_receipt_id",
        "first_generation_seal_intent",
        "first_generation_seal_body"
      ],
      "committed_command_result_unit_event_digests": [
        "reanchor_digest",
        "authorize_digest"
      ],
      "observable_recovery_effects": []
    },
    {
      "name": "byte_identical_create_replays_the_same_frozen_material",
      "phase": "create",
      "expected": "replay_stored_outcome",
      "replayed_members": [
        "request_digest",
        "prepared_plan",
        "prepared_plan_digest",
        "binding.first_generation_seal_id",
        "first_generation_seal_body"
      ]
    },
    {
      "name": "same_transaction_id_with_different_intent_bytes",
      "phase": "create",
      "expected": "reject_without_side_effect",
      "reason_code": "duplicate_conflict"
    },
    {
      "name": "signing_slot_fence_is_not_released_by_expiry_or_restart",
      "phase": "create",
      "fence_key": [
        "realm_id",
        "replacement_signer_slot",
        "predecessor_ref"
      ],
      "expected": "reject_without_side_effect",
      "expected_reason_code": "seal_signer_slot_fenced"
    },
    {
      "name": "terminal_commit_is_one_atomic_commit",
      "phase": "commit_recovery_unit",
      "expected": "accept_terminal_step",
      "invisible_before_commit": [
        "accepted_reanchor_event",
        "accepted_authorize_event",
        "committed_first_generation_seal",
        "advanced_device_generation",
        "active_verified_replacement_device",
        "consumed_recovery_session",
        "completed_terminal_result"
      ],
      "visible_after_commit": [
        "accepted_reanchor_event",
        "accepted_authorize_event",
        "committed_first_generation_seal",
        "advanced_device_generation",
        "active_verified_replacement_device",
        "consumed_recovery_session",
        "accepted_terminal_step",
        "recovery_completion_attestation",
        "completed_terminal_result"
      ]
    },
    {
      "name": "seal_body_differs_from_the_frozen_body",
      "phase": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "receipt_omits_or_rebinds_first_generation_seal_id",
      "phase": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "ordinary_seal_prepare_or_submit_under_a_recovery_grant",
      "phase": "commit_recovery_unit",
      "attempted_operations": [
        "ak.self.seals.command.prepare.v1",
        "ak.self.seals.command.submit.v1"
      ],
      "expected": "reject_without_side_effect",
      "reason_code": "capability_denied"
    },
    {
      "name": "raw_recovery_seal_without_a_completed_transaction",
      "phase": "post_commit",
      "attempted_paths": [
        "ordinary_seal_submit",
        "federation",
        "history_replay"
      ],
      "expected": "reject_without_side_effect",
      "expected_finality": "none"
    },
    {
      "name": "terminal_response_lost_then_byte_identical_continue",
      "phase": "post_commit",
      "expected": "replay_stored_outcome",
      "stored_outcome_checked_before_live_state_refusal": true,
      "replayed_members": [
        "terminal_result",
        "terminal_result.receipt_id",
        "terminal_result.completion_attestation"
      ]
    },
    {
      "name": "two_units_race_the_same_previous_generation",
      "phase": "post_commit",
      "expected": "single_atomic_cas_winner",
      "loser_residue": [],
      "winner_quarantined": false,
      "rival_outcome": "generation_predecessor_conflict_or_terminal_aborted"
    }
  ],
  "equivalence_output": {
    "canonical_fields": [
      "transaction_id",
      "request_digest",
      "prepared_plan_digest",
      "accepted_steps",
      "terminal_result"
    ],
    "minimum_independent_runners": 2
  }
}
