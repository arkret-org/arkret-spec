  "fault_matrix": {
    "transaction_kinds": [
      "recovery",
      "security_rotation"
    ],
    "fault_positions": [
      "before_remote_side_effect",
      "after_remote_side_effect_before_local_commit",
      "after_local_commit_before_response"
    ],
    "faults": [
      "crash",
      "response_lost",
      "coordinator_restart",
      "exact_request_replay",
      "conflicting_request_replay",
      "staged_secret_lost",
      "terminal_replay"
    ]
  },
  "assertions": [
    "one_transaction_id_and_one_reserved_id_set",
    "request_plan_step_outputs_and_first_terminal_outcome_are_durable",
    "exact_replay_returns_the_stored_outcome",
    "conflicting_replay_returns_duplicate_conflict",
    "accepted_webvh_entry_resumes_the_same_reanchor_unit",
    "coordinator_owned_prefix_is_advanced_only_by_the_durable_worker",
    "continue_accepts_only_a_terminal_ready_client_attestation",
    "device_attestation_readiness_is_derived_from_canonical_next_step",
    "recovery_create_freezes_two_signed_events_current_predecessor_and_ordered_digests_with_no_recovery_effect",
    "recovery_authoritative_results_are_all_invisible_before_the_commit_and_all_visible_after",
    "governance_station_issues_both_recovery_realm_commits_only_inside_commit_recovery_unit",
    "recovery_stored_outcome_is_checked_before_consumed_session_refusal",
    "only_the_atomic_generation_cas_winner_commits_a_reanchor_commit",
    "security_rotation_create_requires_fresh_high_risk_authentication_and_binds_the_authenticated_authorizing_device",
    "erase_rechecks_live_transaction_active_account_non_revoked_authorizing_device_and_current_authority_commit",
    "authorization_lease_is_not_issued_or_accepted",
    "pointer_switch_precedes_every_old_series_erase",
    "erased_series_never_becomes_active_again",
    "public_store_log_telemetry_and_crash_artifact_contain_no_secret_material"
  ],
  "rotation_cases": [
    {
      "name": "partial_secret_storage_erase_then_restart",
      "authoritative_new_pointers": [
        "secret_storage"
      ],
      "first_outcome": {
        "secret_storage": "failed_retryable"
      },
      "expected_after_restart": {
        "secret_storage": "erased",
        "confirmation_emitted_once": true,
        "accepted_erase_step_count": 1
      }
    },
    {
      "name": "erase_before_secret_storage_pointer_switch",
      "authoritative_new_pointers": [
        "secret_storage"
      ],
      "expected": {
        "decision": "reject",
        "reason": "failed_precondition",
        "old_backup_deleted": false
      }
    },
    {
      "name": "erase_after_authorizing_device_revoked",
      "authorizing_device_current": false,
      "authoritative_new_pointers": [
        "secret_storage"
      ],
      "expected": {
        "decision": "reject",
        "reason": "failed_precondition",
        "old_backup_deleted": false
      }
    }
  ],
  "continue_cases": [
    {
      "name": "rotation_prefix_one_is_worker_owned",
      "transaction_kind": "security_rotation",
      "accepted_step_count": 1,
      "derived_next_step": "upload_new_material",
      "driver": "durable_transaction_worker",
      "client_continue_present": false,
      "expected": "worker_resumes_same_step"
    },
    {
      "name": "rotation_prefix_four_attested_terminal_continue",
      "transaction_kind": "security_rotation",
      "accepted_step_count": 4,
      "derived_next_step": "local_commit",
      "client_attestation_step": "local_commit",
      "cas_matches": true,
      "reserved_output_matches": true,
      "expected": "accept_terminal_step"
    },
    {
      "name": "rotation_prefix_one_attestation_cannot_drive_worker_step",
      "transaction_kind": "security_rotation",
      "accepted_step_count": 1,
      "derived_next_step": "upload_new_material",
      "client_attestation_step": "local_commit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "continue_without_attestation_is_not_get_alias",
      "transaction_kind": "recovery",
      "accepted_step_count": 0,
      "derived_next_step": "commit_recovery_unit",
      "client_attestation_present": false,
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "recovery_prefix_zero_attested_terminal_continue",
      "transaction_kind": "recovery",
      "accepted_step_count": 0,
      "derived_next_step": "commit_recovery_unit",
      "client_attestation_step": "commit_recovery_unit",
      "cas_matches": true,
      "reserved_output_matches": true,
      "expected": "accept_terminal_step"
    },
    {
      "name": "recovery_has_no_coordinator_owned_prefix",
      "transaction_kind": "recovery",
      "accepted_step_count": 1,
      "derived_next_step": null,
      "client_attestation_step": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    }
  ],
  "recovery_terminal_commit_cases": [
    {
      "name": "create_freezes_events_predecessor_and_ordered_digests",
      "phase": "create",
      "expected": "freeze_prepared_plan",
      "frozen_plan_members": [
        "binding.reanchor_event_id",
        "binding.authorize_event_id",
        "binding.terminal_receipt_id",
        "reanchor_unit",
        "reanchor_commit_intent",
        "reanchor_commit_intent.predecessor_ref",
        "reanchor_commit_intent.unit_event_digests"
      ],
      "committed_command_result_unit_event_digests": [
        "reanchor_digest",
        "authorize_digest"
      ],
      "observable_recovery_effects": []
    },
    {
      "name": "byte_identical_create_replays_the_same_frozen_material",
      "phase": "create",
      "expected": "replay_stored_outcome",
      "replayed_members": [
        "request_digest",
        "prepared_plan",
        "prepared_plan_digest",
        "binding.reanchor_event_id",
        "binding.authorize_event_id",
        "reanchor_unit",
        "reanchor_commit_intent"
      ]
    },
    {
      "name": "same_transaction_id_with_different_intent_bytes",
      "phase": "create",
      "expected": "reject_without_side_effect",
      "reason_code": "duplicate_conflict"
    },
    {
      "name": "terminal_commit_is_one_atomic_commit",
      "phase": "commit_recovery_unit",
      "expected": "accept_terminal_step",
      "invisible_before_commit": [
        "accepted_reanchor_event",
        "accepted_authorize_event",
        "committed_reanchor_realm_commit",
        "committed_authorize_realm_commit",
        "advanced_device_generation",
        "active_verified_replacement_device",
        "consumed_recovery_session",
        "completed_terminal_outcome"
      ],
      "visible_after_commit": [
        "accepted_reanchor_event",
        "accepted_authorize_event",
        "committed_reanchor_realm_commit",
        "committed_authorize_realm_commit",
        "advanced_device_generation",
        "active_verified_replacement_device",
        "consumed_recovery_session",
        "accepted_terminal_step",
        "recovery_completion_attestation",
        "completed_terminal_outcome"
      ]
    },
    {
      "name": "ordered_event_digests_differ_from_the_frozen_intent",
      "phase": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "swapped_event_digest_order_differs_from_the_frozen_plan",
      "phase": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition",
      "frozen_order": [
        "reanchor_digest",
        "authorize_digest"
      ],
      "submitted_order": [
        "authorize_digest",
        "reanchor_digest"
      ],
      "zero_effects": [
        "accepted_reanchor_event",
        "accepted_authorize_event",
        "committed_reanchor_realm_commit",
        "committed_authorize_realm_commit",
        "advanced_device_generation",
        "active_verified_replacement_device",
        "consumed_recovery_session",
        "accepted_terminal_step",
        "recovery_completion_attestation",
        "completed_terminal_outcome"
      ]
    },
    {
      "name": "terminal_artifact_attempts_to_carry_realm_commit_material",
      "phase": "commit_recovery_unit",
      "forbidden_members": [
        "realm_commit",
        "realm_commit_id",
        "authority_signature"
      ],
      "expected": "reject_without_side_effect",
      "reason_code": "failed_precondition"
    },
    {
      "name": "receipt_completed_at_later_than_the_linearized_commit_time",
      "phase": "commit_recovery_unit",
      "expected": "reject_without_side_effect",
      "reason_code": "recovery_receipt_completed_at_after_commit",
      "note": "The replacement device clock runs ahead, so the signed receipt claims a completed_at the Station has not reached. No skew allowance exists: the Station neither signs a future-dated completion attestation nor blocks until the claimed time.",
      "zero_effects": [
        "accepted_reanchor_event",
        "accepted_authorize_event",
        "committed_reanchor_realm_commit",
        "committed_authorize_realm_commit",
        "advanced_device_generation",
        "active_verified_replacement_device",
        "consumed_recovery_session",
        "accepted_terminal_step",
        "recovery_completion_attestation",
        "completed_terminal_outcome"
      ],
      "retry_with_a_new_receipt": "accepted",
      "retry_with_different_bytes_for_a_frozen_step_outcome": "duplicate_conflict"
    },
    {
      "name": "raw_recovery_commit_without_a_completed_transaction",
      "phase": "post_commit",
      "attempted_paths": [
        "ordinary_commit_submit",
        "federation",
        "history_replay"
      ],
      "expected": "reject_without_side_effect",
      "expected_finality": "none"
    },
    {
      "name": "terminal_response_lost_then_byte_identical_continue",
      "phase": "post_commit",
      "expected": "replay_stored_outcome",
      "stored_outcome_checked_before_live_state_refusal": true,
      "replayed_members": [
        "terminal_outcome",
        "terminal_outcome.receipt_id",
        "terminal_outcome.completion_attestation"
      ]
    },
    {
      "name": "two_units_race_the_same_previous_generation",
      "phase": "post_commit",
      "expected": "single_atomic_cas_winner",
      "loser_residue": [],
      "winner_quarantined": false,
      "rival_outcome": "generation_predecessor_conflict_or_terminal_aborted"
    }
  ],
  "equivalence_output": {
    "canonical_fields": [
      "transaction_id",
      "request_digest",
      "prepared_plan_digest",
      "accepted_steps",
      "terminal_outcome"
    ],
    "minimum_independent_runners": 2
  }
}
