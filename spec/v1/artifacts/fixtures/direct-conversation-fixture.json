  "semantic_cases": [
    {
      "name": "existing_offline_agent_is_found",
      "precondition": "stable binding exists; agent presence offline and KeyPackage inventory is zero",
      "action": "resolve",
      "semantic_outcome": "accept",
      "assertions": [
        "state is found",
        "same Realm and main Strand are returned",
        "no KeyPackage claim occurs",
        "the query-only resolver performs no create phase"
      ]
    },
    {
      "name": "founding_coordinates_are_derived_from_unit_bytes",
      "precondition": "founder authored the three-Event unit in fixed wire order",
      "action": "submit the direct_conversation_founding branch of ak.self.events.command.submit",
      "semantic_outcome": "accept",
      "assertions": [
        "realm_id equals retype of the first Event ID and main_strand_id equals retype of the third Event ID",
        "founding_unit_digest is recomputed from the three ordered Event IDs under the ak.direct-conversation.founding-unit.v1 domain",
        "two independent implementations derive the same coordinates, unit digest and receipt semantics",
        "acceptance fixes the caller-derived coordinates and allocates nothing"
      ]
    },
    {
      "name": "founding_unit_strand_uses_bootstrap_no_basis_shape",
      "precondition": "the third Event of the founding unit is the Realm's main ak.strand.create and the Genesis Seal covers all three Events",
      "action": "admit the unit",
      "semantic_outcome": "accept",
      "assertions": [
        "the Strand carries neither seal_ref, auth_context nor seal_basis and rides the same-batch staged authority-root proof",
        "a no-basis ak.strand.create outside this exact unit is rejected by batch admission",
        "the same Strand carrying seal_ref, auth_context or seal_basis inside the unit is rejected"
      ]
    },
    {
      "name": "server_allocated_founding_identifier_rejected",
      "precondition": "a submission asserts a service-allocated realm_id, a reservation handle or a materialization draft",
      "action": "submit the founding unit",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_founding_unit_invalid",
      "assertions": [
        "zero Events are written",
        "no coordinator election, reserved state or materializing state exists in the contract"
      ]
    },
    {
      "name": "founder_multi_device_concurrency_admits_first_valid_unit",
      "precondition": "two founder devices independently author different valid units for the same pair",
      "action": "both submit concurrently to the same Principal Server slot",
      "semantic_outcome": "accept",
      "assertions": [
        "exactly one unit is accepted and three Events are written once",
        "the losing device receives direct_conversation_slot_already_committed with zero writes",
        "both devices then resolve to the same coordinates"
      ]
    },
    {
      "name": "exact_unit_replay_returns_byte_identical_receipt",
      "precondition": "the unit was accepted but the response was lost, or the service restarted after receipt persistence or outbox enqueue",
      "action": "replay the same signed bytes with the same idempotency_key",
      "semantic_outcome": "accept",
      "assertions": [
        "the stored receipt is returned byte-identically and accepted_at does not advance",
        "no second Event, receipt, slot or outbox entry is produced"
      ]
    },
    {
      "name": "same_idempotency_key_different_unit_conflicts",
      "precondition": "the caller reuses one idempotency_key with a different founding_unit_digest",
      "action": "submit the second unit",
      "semantic_outcome": "reject",
      "expected_reason_code": "duplicate_conflict",
      "assertions": [
        "zero Events are written"
      ]
    },
    {
      "name": "same_and_dual_principal_server_deployments_agree",
      "precondition": "the pair is hosted on one Principal Server in one run and on two Principal Servers in another",
      "action": "run self founding and the federation direct_conversation_founding branch",
      "semantic_outcome": "accept",
      "assertions": [
        "both deployments produce the same unit digest, coordinates and admission verdict",
        "the federation branch omits service_binding_ref and binds destination through service DID headers and the source receipt"
      ]
    },
    {
      "name": "federation_founding_dependency_missing_is_atomic",
      "precondition": "the Contact basis mirror has not reached the destination Principal Server",
      "action": "deliver the founding unit through the peer direct_conversation_founding branch",
      "semantic_outcome": "reject",
      "expected_reason_code": "dependency_missing",
      "assertions": [
        "the response is a top-level HTTP 409 with EventsDependencyMissingProblem",
        "zero Events are written and no per-item partial acceptance occurs",
        "the delivery remains retryable and is never permanently rejected"
      ]
    },
    {
      "name": "leave_or_directional_contact_terminal_suspends",
      "precondition": "stable binding exists and leave, block, or either directional Contact head/scope gate becomes false; Consent is not consulted",
      "action": "resolve and attempt message",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_participant_authority_denied",
      "assertions": [
        "resolver returns suspended with same coordinates",
        "reason classes are not disclosed",
        "no successor Realm is created"
      ]
    },
    {
      "name": "rejoin_uses_same_realm_without_old_keys",
      "precondition": "suspension basis is repaired",
      "action": "resolve and rejoin",
      "semantic_outcome": "accept",
      "assertions": [
        "same binding Realm and main Strand are used",
        "new active MLS generation is projected",
        "old epoch keys and history secret are not automatically delivered"
      ]
    },
    {
      "name": "generic_navigation_excludes_dm",
      "precondition": "stable DM Realm is synchronized",
      "action": "generic collaboration discovery",
      "semantic_outcome": "accept",
      "assertions": [
        "DM Realm is absent",
        "dedicated resolver still returns it"
      ]
    },
    {
      "name": "participant_authority_is_symmetric",
      "precondition": "stable binding active membership current authorization basis and active MLS generation are exact",
      "action": "both participants create own messages",
      "semantic_outcome": "accept",
      "assertions": [
        "creator and peer use the same participant evaluator",
        "technical root is not an operational owner"
      ]
    },
    {
      "name": "third_participant_and_root_governance_denied",
      "precondition": "stable Direct Conversation",
      "action": "add third participant grant admin or modify peer message",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_root_mask_violation"
    },
    {
      "name": "agent_reply_requires_conjunction",
      "precondition": "Agent is a stable participant but runtime key or participation policy is not ready",
      "action": "agent reply",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_participant_authority_denied",
      "assertions": [
        "resolver remains found or suspended independently"
      ]
    }
  ]
}
