  "semantic_cases": [
    {
      "name": "existing_offline_agent_is_found",
      "precondition": "stable binding exists; agent presence offline and KeyPackage inventory is zero",
      "action": "resolve create=true",
      "semantic_outcome": "accept",
      "assertions": [
        "state is found",
        "same Realm and main Strand are returned",
        "no KeyPackage claim occurs",
        "no second allocation occurs"
      ]
    },
    {
      "name": "concurrent_first_resolve_has_one_coordinator",
      "precondition": "both participants resolve concurrently from the same accepted locator evidence",
      "action": "allocate",
      "semantic_outcome": "accept",
      "assertions": [
        "unsigned-byte minimum Principal Server DID is coordinator",
        "one operation and one Realm are allocated"
      ]
    },
    {
      "name": "materializing_restart_recovers_same_ids",
      "precondition": "operation is materializing and response is lost or coordinator restarts",
      "action": "retry using operation_id",
      "semantic_outcome": "accept",
      "assertions": [
        "same operation Realm main Strand and founding Event IDs are returned",
        "no expiry or fallback coordinator is allowed"
      ]
    },
    {
      "name": "stale_reserved_draft_cannot_materialize",
      "precondition": "reserved operation expired without external effect",
      "action": "submit old draft",
      "semantic_outcome": "reject",
      "expected_reason_code": "failed_precondition"
    },
    {
      "name": "leave_or_directional_contact_terminal_suspends",
      "precondition": "stable binding exists and leave, block, or either directional Contact head/scope gate becomes false; Consent is not consulted",
      "action": "resolve and attempt message",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_participant_authority_denied",
      "assertions": [
        "resolver returns suspended with same coordinates",
        "reason classes are not disclosed",
        "no successor Realm is created"
      ]
    },
    {
      "name": "rejoin_uses_same_realm_without_old_keys",
      "precondition": "suspension basis is repaired",
      "action": "resolve and rejoin",
      "semantic_outcome": "accept",
      "assertions": [
        "same binding Realm and main Strand are used",
        "new active MLS generation is projected",
        "old epoch keys and history secret are not automatically delivered"
      ]
    },
    {
      "name": "generic_navigation_excludes_dm",
      "precondition": "stable DM Realm is synchronized",
      "action": "generic collaboration discovery",
      "semantic_outcome": "accept",
      "assertions": [
        "DM Realm is absent",
        "dedicated resolver still returns it"
      ]
    },
    {
      "name": "participant_authority_is_symmetric",
      "precondition": "stable binding active membership current authorization basis and active MLS generation are exact",
      "action": "both participants create own messages",
      "semantic_outcome": "accept",
      "assertions": [
        "creator and peer use the same participant evaluator",
        "technical root is not an operational owner"
      ]
    },
    {
      "name": "third_participant_and_root_governance_denied",
      "precondition": "stable Direct Conversation",
      "action": "add third participant grant admin or modify peer message",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_root_mask_violation"
    },
    {
      "name": "agent_reply_requires_conjunction",
      "precondition": "Agent is a stable participant but runtime key or participation policy is not ready",
      "action": "agent reply",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_participant_authority_denied",
      "assertions": [
        "resolver remains found or suspended independently"
      ]
    }
  ]
}
