  "semantic_cases": [
    {
      "name": "third_member_join_rejected",
      "precondition": "active canonical binding participants are Alice and Bob",
      "action": "ak.member.state join for Carol",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_third_party_member_forbidden"
    },
    {
      "name": "space_create_rejected",
      "precondition": "Realm role is direct_conversation",
      "action": "ak.space.create",
      "semantic_outcome": "reject",
      "expected_reason_code": "direct_conversation_space_forbidden"
    },
    {
      "name": "leave_retires_and_recreate_changes_boundary",
      "precondition": "active canonical binding exists",
      "action": "participant leaves, then resolver create=true",
      "semantic_outcome": "accept",
      "assertions": [
        "old binding is retired",
        "new realm_id differs",
        "new main_strand_id differs",
        "new MLS group differs"
      ]
    },
    {
      "name": "concurrent_candidates_choose_digest_max",
      "precondition": "two valid causally-unreachable active candidates exist for the same pair_key",
      "action": "fold candidates",
      "semantic_outcome": "accept",
      "assertions": [
        "unsigned-byte lexicographically greatest event_digest is canonical",
        "loser projects as duplicate",
        "receive time and event_id do not affect the result"
      ]
    }
