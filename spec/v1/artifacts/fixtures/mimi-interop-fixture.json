{
  "suite": "mimi_interop",
  "version": "2026-04-30",
  "profile": "ak.profile.mimi_interop.v1",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.interop.mimi.v1"
  },
  "covers_vectors": [
    "ak.vector.mimi.provider_directory_draft_pinning.v1",
    "ak.vector.mimi.room_binding_projection.v1",
    "ak.vector.mimi.room_update_branched_effect.v1",
    "ak.vector.mimi.keypackage_claim_lifecycle.v1",
    "ak.vector.mimi.content_roundtrip.v1",
    "ak.vector.mimi.identifier_query_privacy.v1",
    "ak.vector.mimi.identifier_query_source_signature.v1",
    "ak.vector.mimi.consent_isolation.v1",
    "ak.vector.mimi.proxy_download_policy.v1",
    "ak.vector.mimi.provider_directory_signature.v1",
    "ak.vector.mimi.unsupported_draft_fail_closed.v1"
  ],
  "drafts": {
    "protocol": "draft-ietf-mimi-protocol-06",
    "content": "draft-ietf-mimi-content-08",
    "room_policy": "draft-ietf-mimi-room-policy-03",
    "identifier": "draft-kohbrok-mimi-identifiers-01"
  },
  "cases": [
    {
      "vector_id": "ak.vector.mimi.provider_directory_draft_pinning.v1",
      "name": "provider_directory_draft_pinning",
      "input": {
        "schema": "ak.schema.mimi_interop.v1",
        "service_id": "ak:did_core:webvh:z6mkfixturemimiexamplecom",
        "service_kind": "mimi_provider_facade",
        "supported_profiles": [
          "ak.profile.mimi_interop.v1"
        ],
        "mimi": {
          "protocol_draft": "draft-ietf-mimi-protocol-06",
          "content_draft": "draft-ietf-mimi-content-08",
          "room_policy_draft": "draft-ietf-mimi-room-policy-03",
          "identifier_draft": "draft-kohbrok-mimi-identifiers-01",
          "base_url": "https://mimi.example.com/_arkret/open/mimi",
          "provider_id": "mimi://mimi.example.com",
          "endpoints": [
            {
              "endpoint_id": "consent",
              "relative_path": "/consent"
            },
            {
              "endpoint_id": "identifier_query",
              "relative_path": "/identifier-query"
            },
            {
              "endpoint_id": "key_material",
              "relative_path": "/key-material"
            },
            {
              "endpoint_id": "proxy_download",
              "relative_path": "/proxy-download"
            },
            {
              "endpoint_id": "report_abuse",
              "relative_path": "/report-abuse"
            },
            {
              "endpoint_id": "submit_message",
              "relative_path": "/submit-message"
            }
          ],
          "features": [
            "key_material",
            "submit_message",
            "consent",
            "identifier_query",
            "report_abuse",
            "proxy_download"
          ],
          "mls_cipher_suites": [
            "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519"
          ],
          "content_profiles": [
            "application/mimi-content",
            "application/vnd.arkret.content+json"
          ],
          "room_policy_components": [
            "membership_style",
            "moderation"
          ]
        },
        "proof": {
          "kind": "detached_jws",
          "verification_method": "did:webvh:z6mkfixturemimiexamplecom:mimi.example.com#mimi-provider",
          "payload_digest": "sha256:89abcdef0123456789abcdef0123456789abcdef0123456789abcdef01234567",
          "created_at": "2026-07-31T00:00:00.000Z",
          "jws": "a..b"
        }
      },
      "expected": "accepted_only_when_profile_and_pinned_drafts_match"
    },
    {
      "vector_id": "ak.vector.mimi.room_binding_projection.v1",
      "name": "room_binding_projection",
      "input": {
        "kind": "ak.mimi.room_binding",
        "payload": {
          "profile": "ak.profile.mimi_interop.v1",
          "mimi_room_uri": "mimi://mimi.example.com/rooms/01JSMIMI",
          "binding_scope": {
            "realm_id": "ak:realm:ARbIUlzcici90GEaaWOlloxJBixvsfwCb-_GwnOd3EAh",
            "strand_id": "ak:strand:ARbIUlzcici90GEaaWOlloxJBixvsfwCb-_GwnOd3EAh"
          },
          "hub_provider": "did:webvh:z6mkfixturemimiexamplecom:mimi.example.com",
          "local_provider_role": "hub",
          "mls_group_id": "mls-group-01",
          "status": "accepted"
        }
      },
      "expected_cell_ref": "ak:cell:ak.component.mimi.room_binding.v1:mimi%3A%2F%2Fmimi.example.com%2Frooms%2F01JSMIMI",
      "expected": "mimi_room_is_projection_not_canonical_truth"
    },
    {
      "vector_id": "ak.vector.mimi.room_update_branched_effect.v1",
      "name": "room_update_semantic_kind_selects_durable_effect",
      "cases": [
        {
          "name": "binding_kind_requires_exact_caller_event",
          "update_kind": "ak.mimi.room_binding",
          "room_binding_event": "matching_caller_authored_event",
          "expected": "ordinary_event_admission"
        },
        {
          "name": "binding_kind_missing_event",
          "update_kind": "ak.mimi.room_binding",
          "expected_error": "mimi_room_binding_event_invalid"
        },
        {
          "name": "binding_kind_mismatched_event",
          "update_kind": "ak.mimi.room_binding",
          "room_binding_event": "mismatched_caller_authored_event",
          "expected_error": "mimi_room_binding_event_invalid"
        },
        {
          "name": "receipt_only_kind_rejects_event",
          "update_kind": "m.room.name",
          "room_binding_event": "unexpected_caller_authored_event",
          "expected_error": "mimi_room_binding_event_invalid"
        },
        {
          "name": "receipt_only_kind_has_no_event_effect",
          "update_kind": "m.room.name",
          "expected": "receipt_only"
        }
      ],
      "failure_equivalence": {
        "http_status": 400,
        "reason_code": "mimi_room_binding_event_invalid",
        "body_shape": "identical",
        "depends_on_room_or_binding_existence": false
      }
    },
    {
      "vector_id": "ak.vector.mimi.keypackage_claim_lifecycle.v1",
      "name": "keypackage_claim_lifecycle",
      "input": {
        "operation_id": "ak.open.mimi.exchange.request_key_material.v1",
        "target_identifier": "mimi://remote.example/alice",
        "realm_id": "ak:realm:ARbIUlzcici90GEaaWOlloxJBixvsfwCb-_GwnOd3EAh",
        "mimi_room_uri": "mimi://mimi.example.com/rooms/01JSMIMI",
        "requester_provider": "did:webvh:z6mkfixturemimiexamplecom:mimi.example.com",
        "required_content_profile": "ak.profile.mimi_interop.v1",
        "mls_capabilities": [
          "mls_rfc9420"
        ],
        "cipher_suites": [
          "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519"
        ],
        "allow_pseudonymous_credential": true,
        "response": {
          "claim_id": "mls-keypackage-claim-mimi-interop-1",
          "keypackage_ref": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "device_binding": "ak:device:0110c853-1d09-7044-b214-c74240110c85",
          "expires_at": "2026-04-30T01:00:00.000Z",
          "supported_capabilities": [
            "mls_rfc9420"
          ],
          "single_use": true
        },
        "after_welcome": {
          "claim_state": "consumed"
        },
        "failure_shape": {
          "policy_denied": "not_found_equivalent",
          "no_available_device": "not_found_equivalent",
          "target_not_visible": "not_found_equivalent"
        }
      },
      "expected": "single_use_keypackage_claim_consumed_after_welcome_and_failure_shape_is_enumeration_safe"
    },
    {
      "vector_id": "ak.vector.mimi.content_roundtrip.v1",
      "name": "submit_message_text_mapping",
      "input": {
        "source_format": "text/markdown;variant=GFM-MIMI",
        "target_format": "ak.message.create",
        "mimi_room_uri": "mimi://mimi.example.com/rooms/01JSMIMI",
        "original_envelope_digest": "sha256:012345678901234567890123456789012345678901234567890123456789abcd"
      },
      "expected": "mapped_event_preserves_original_envelope_digest_and_mimi_message_id"
    },
    {
      "vector_id": "ak.vector.mimi.identifier_query_privacy.v1",
      "name": "identifier_query_blinded",
      "input": {
        "query": "mimi://remote.example/alice",
        "requester_provider": "did:webvh:z6mkfixturemimiexamplecom:mimi.example.com",
        "privacy_mode": "private_contact_discovery"
      },
      "expected": "returns_psi_match_bits_and_invite_handoff_without_exposing_contact_graph"
    },
    {
      "vector_id": "ak.vector.mimi.identifier_query_source_signature.v1",
      "name": "identifier_query_requires_per_request_source_signature",
      "operation_id": "ak.open.mimi.read.identifiers.v1",
      "cases": [
        {
          "name": "unsigned_query_rejected_before_psi",
          "headers": {
            "Authorization": "Bearer deployment-token-only"
          },
          "expected_http_status": 401,
          "expected_error_code": "http_signature_required",
          "psi_evaluated": false
        },
        {
          "name": "invalid_source_signature_rejected_before_psi",
          "headers": {
            "Signature-Input": "sig1=(\"@method\" \"@target-uri\" \"@authority\" \"content-digest\" \"source-service-id\" \"destination-service-id\" \"provider-id\");created=1787932800;expires=1787933100;keyid=\"did:web:source.example#provider\";alg=\"ed25519\"",
            "Signature": "sig1=:aW52YWxpZA==:"
          },
          "expected_http_status": 401,
          "expected_error_code": "http_signature_invalid",
          "psi_evaluated": false
        },
        {
          "name": "directory_does_not_inherit_profile",
          "operation_ids": [
            "ak.open.mimi.read.provider_directory.v1"
          ],
          "expected": "no_http_signature_required_error_from_this_profile"
        }
      ]
    },
    {
      "vector_id": "ak.vector.mimi.consent_isolation.v1",
      "name": "consent_isolation",
      "input": {
        "consent_state": "accepted",
        "target_identifier": "mimi://remote.example/alice",
        "realm_id": "ak:realm:ARbIUlzcici90GEaaWOlloxJBixvsfwCb-_GwnOd3EAh"
      },
      "expected": "consent_does_not_grant_space_read_or_write_capability"
    },
    {
      "vector_id": "ak.vector.mimi.proxy_download_policy.v1",
      "name": "proxy_download_policy",
      "input": {
        "blob_ref": "ak:blob:0110c853-1d09-7044-b214-c74240110c85",
        "asset_privacy_policy": "provider_proxy"
      },
      "expected": "direct_object_store_url_is_not_returned"
    },
    {
      "vector_id": "ak.vector.mimi.provider_directory_signature.v1",
      "name": "provider_directory_signature",
      "proof_context": "ak.mimi_provider_directory_proof.v1",
      "assertions": [
        "the detached JWS covers the exact canonical unsigned provider-directory projection",
        "the projection's first member is the registered object-family context ak.mimi_provider_directory_proof.v1",
        "a projection carrying any other registered context yields a different digest and fails closed",
        "routing, cipher-suite, content-profile, and room-policy mutations invalidate the proof",
        "empty required capability arrays, another proof controller, routing-shadow extensions, stale proofs, and development digests fail closed",
        "HTTP message signature validity and provider-directory JWS validity remain independent gates"
      ]
    },
    {
      "vector_id": "ak.vector.mimi.unsupported_draft_fail_closed.v1",
      "name": "unsupported_draft_fail_closed",
      "input": {
        "protocol_draft": "draft-ietf-mimi-protocol-99"
      },
      "expected": "reject_or_negotiate_new_profile_without_mutating_reducer_profile"
    }
  ]
}
