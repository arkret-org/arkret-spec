{
  "suite": "discovery_profile_fixture",
  "version": "2026-07-10",
  "runner": {
    "kind": "profile_discovery_coverage",
    "inputs": [
      "profiles/conformance-profiles.json",
      "registry/operation-registry.json",
      "registry/schema-registry.json",
      "schemas/service-describe.schema.json"
    ]
  },
  "cases": [
    {
      "name": "advertised_profile_closure",
      "generator": "for_each_claimable_profile",
      "expected": "All inherited required endpoints, schemas, event kinds, bindings, fixtures, and required feature-discovery tokens are advertised or locally available."
    },
    {
      "name": "surface_tier_does_not_overclaim",
      "generator": "for_each_surface_tier",
      "expected": "The service does not advertise an operation, profile, or schema excluded by its declared surface tier."
    },
    {
      "name": "unknown_required_profile_fails_closed",
      "input": {
        "required_profile": "unknown-required-profile"
      },
      "expected": {
        "decision": "reject",
        "error_code": "unsupported_feature"
      }
    },
    {
      "name": "optional_unknown_feature_is_not_claimed",
      "input": {
        "optional_feature": "ak.feature.example.unknown.v1"
      },
      "expected": {
        "decision": "omit_or_report_unsupported",
        "must_not_advertise_support": true
      }
    }
  ]
}
