  "cases": [
    {
      "name": "agent_provision",
      "vector_id": "ak.vector.agent.provision.v1",
      "runner": "cotest::conformance::agent_vectors::run_agent_provision_vector",
      "requested_scope_commitment": {
        "agent_id": "ak:did_core:webvh:QmTnpRaadxso9gmuqCaoT54ib4kWKNt1F5UuqXN6i5hwey",
        "controller_principal_id": "ak:did_core:webvh:z6mkcontroller",
        "requested_scope": {
          "actions": [
            "ak.event.read",
            "ak.self.committed_event.stream.subscribe.v1"
          ],
          "resources": [
            {
              "kind": "operation",
              "operation": "ak.self.committed_event.stream.subscribe.v1"
            }
          ]
        },
        "expected_digest": "sha256:fcdc0d9a579d073a680854d396140edf510ff90eff74f52124baca4cc2313e83"
      },
      "public_did_service_endpoint": {
        "realm_id": "ak:realm:ATH75ame6bMfYpXtcoLOVb7FKmgpWVniZZqVBz1dUdQa",
        "controller_did": "did:webvh:z6mkcontroller:controller.example",
        "authorization_ref": "did:webvh:QmTnpRaadxso9gmuqCaoT54ib4kWKNt1F5UuqXN6i5hwey:agent.example#managed-controller",
        "requested_scope_digest": "sha256:fcdc0d9a579d073a680854d396140edf510ff90eff74f52124baca4cc2313e83"
      },
      "assertions": [
        "agent provision operation id remains ak.self.agent.command.provision.v1",
        "agent provision capability action matches the operation id",
        "provision fails without a controller recovery policy before creating any Agent DID, PCR, or grant side effect",
        "controller publishes PCR-independent DID entry 0; prepare validates an exact accepted controller_station_id, verifies did and returns exact initial_resolution plus allocation without generating DID/private keys or durable Agent/PCR/accountability/selector/pairing/grant side effects, and MUST NOT allocate principal_control_realm_id",
        "the controller recomputes requested_scope_digest and uses the Arkret SDK canonical authoring API for one ak.agent.provision Event",
        "the provision payload carries no nested proof; the Event envelope proof is the only signature",
        "the provision Event passes the Event proof verifier and admission pipeline; a service-authored or dev-proof substitute is rejected in every mode",
        "one reducer transaction atomically projects provision, accountability and selector typed results; partial projection is impossible",
        "an exact commit retry identified by the allocation and one Event id returns the original outcome, while an Event-id byte mismatch conflicts",
        "a crash is recovered by replaying the same Event and never by minting replacement Event ids or proofs",
        "complete returns the Agent PCR binding and runtime pairing material without any backup-readiness projection, and does not pre-write an Agent profile or runtime key authorization",
        "requested_scope is required, immutable and records a global hard ceiling rather than a grant",
        "the accepted Agent DID service entry is a closed four-field binding that fixes only the domain-separated requested_scope digest and contains no complete scope",
        "pairing and grant admission require a controller-signed verifier-bound private requested_scope disclosure whose digest matches the accepted-at DID commitment",
        "provisioning writes one durable fact whose projections include accountability and selector and never materializes Realm grants",
        "a narrower per-key scope is accepted while a wider action/resource scope or omitted mandatory provision constraint is rejected",
        "grant attach accepts a complete controller-authored ak.capability.grant EventAdmissionSubmission and submits its exact bytes through authority Event submission",
        "the ordinary CapabilityGrantBody has no inner proof or signature; the Event envelope proof is the sole durable issuer signature and service signing or proof fallback is rejected",
        "a narrower Realm grant is accepted while an omitted action or out-of-ceiling content resource is rejected with agent_grant_exceeds_requested_scope",
        "missing accountability grants fail with accountability_grant_missing"
      ]
    },
    {
      "name": "agent_pcr_genesis_forward_declaration",
      "vector_id": "ak.vector.agent.pcr_genesis_declaration.v1",
      "runner": "cotest::conformance::agent_vectors::run_agent_pcr_genesis_declaration_vector",
      "frozen_genesis": {
        "purpose": "agent_control",
        "kat_case_ref": "content-bound-event-id-fixture.json#agent_provision_forward_declaration_is_constructible",
        "derived_event_id": "ak:event:AYj1hkGaeWVFOEdto3Hsqc1nmIwSKd3TswkkqrnOkPa-",
        "derived_realm_id": "ak:realm:AYj1hkGaeWVFOEdto3Hsqc1nmIwSKd3TswkkqrnOkPa-"
      },
      "declared_in_provision": {
        "kat_case_ref": "content-bound-event-id-fixture.json#agent_provision_declares_the_frozen_genesis_realm_id",
        "principal_control_realm_id": "ak:realm:AYj1hkGaeWVFOEdto3Hsqc1nmIwSKd3TswkkqrnOkPa-",
        "derived_event_id": "ak:event:ARHxCFg6VPrOIvvCcWcsGkJZ_J4zIvQqGjMnRVsGg-Xi"
      },
      "assertions": [
        "prepare returns no principal_control_realm_id; the controller derives it from the locally frozen genesis create",
        "the accepted provision returns status=awaiting_pcr_genesis and publishes no DID service entry, pairing handle or list/get visibility",
        "a crash between the two submissions is recovered by replaying the same frozen create bytes; replaying commit returns the same awaiting_pcr_genesis outcome and never authors a second provision",
        "the genesis create is submitted separately and carries no refs entry naming the provision",
        "genesis admission reverse-looks-up an accepted ak.agent.provision whose payload.principal_control_realm_id equals retype of this create event_id",
        "retype of the accepted genesis event_id equals the declared principal_control_realm_id byte for byte",
        "the whole sequence derives without event_id_digest_mismatch, which is the constructibility proof for the named encoding.md §3.1 class C exemption",
        "accepting the genesis returns awaiting_did_binding and keeps the Agent invisible; only accepting controller-signed continuous DID entry 1 moves agent_status from uninitialized to active, publishes the pairing handle and returns status=complete",
        "an ak.realm.create whose purpose is not agent_control triggers neither the agent-status write nor the reverse look-up"
      ]
    },
    {
      "name": "agent_pcr_genesis_same_batch_rejected",
      "vector_id": "ak.vector.agent.pcr_genesis_declaration.v1",
