{
  "profile": "ak.profile.auth_server.v1",
  "version": "2026-08-20",
  "suite": "auth_session_proof",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.auth.session_proof.v1"
  },
  "covers_vectors": [
    "ak.vector.auth.session_grant_audience_binding.v1",
    "ak.vector.session.pop_presentation.v1",
    "ak.vector.session.bare_bearer_rejected_protected.v1",
    "ak.vector.session.dpop_target_uri_binding.v1",
    "ak.vector.session.device_identity_key_separation.v1"
  ],
  "cases": [
    {
      "name": "session_grant_audience_binding",
      "vector_id": "ak.vector.auth.session_grant_audience_binding.v1",
      "kind": "session_grant_request_binding",
      "request_id": "ak:request:0196419b-0000-7000-8000-000000000002",
      "principal_id": "ak:did_core:webvh:z6mkfixture",
      "device_id": "ak:device:0196419b-0000-7000-8000-000000000001",
      "target_audience": "ak:did_core:webvh:z6mkfixtureserviceexample",
      "mismatched_audience": "ak:did_core:webvh:z6mkfixtureotherexample",
      "account_subject": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
      "account_handoff_grant_digest": "sha256:5555555555555555555555555555555555555555555555555555555555555555",
      "holder_jkt": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "session_intent_digest": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
      "verification_method": "did:webvh:z6mkfixture:alice.example#device-key-1",
      "issued_at": "2026-08-20T00:00:00.000Z",
      "expires_at": "2026-08-20T00:05:00.000Z",
      "server_max_ttl_seconds": 900,
      "attempted_verified_profiles": [
        "ak.profile.auth_server.v1"
      ],
      "expected": {
        "audience_mismatch_reason": "audience_mismatch",
        "invalid_binding_reason": "proof_invalid",
        "ttl_behavior": "issuer_fixed",
        "development_verified_profiles": []
      },
      "assertions": [
        "the AccountHandoff DPoP proof binds the holder to this exact issue endpoint and account_handoff_grant",
        "the accepted-device proof binds request_id, account_subject, account_handoff_grant_digest, principal_id, device_id, audience, holder_jkt, verification_method, session intent, and a window no longer than 300 seconds",
        "the origin verifies the accepted-device signature with the durable current accepted-device key in the same current-authorization linearization",
        "human scope and lifetime are issuer-fixed and are not request fields",
        "development_mode=true must not advertise ak.profile.auth_server.v1 in verified_profiles"
      ]
    },
    {
      "name": "pop_presentation",
      "vector_id": "ak.vector.session.pop_presentation.v1",
      "kind": "http_message_signature_pop",
      "method": "POST",
      "target_uri": "https://service.example.com/_arkret/self/events",
      "authority": "service.example.com",
      "path": "/_arkret/self/events",
      "body": "{\"hello\":\"world\"}",
      "content_type": "application/json",
      "content_encoding": null,
      "content_digest_placement": "header",
      "content_digest_algorithm_key": "sha-256",
      "content_digest_member_count": 1,
      "exact_http_content_is_arkret_canonical_json": true,
      "idempotency_key": "idem-pop-0001",
      "key_id": "did:webvh:z6mkfixture:alice.example#session-key-1",
      "created": 1716000000,
      "expires": 1716000120,
      "max_window_seconds": 300,
      "required_components": [
        "@method",
        "@target-uri",
        "@authority",
        "content-digest"
      ],
      "expected": {
        "valid_write": "accepted",
        "tampered_transcript_reason": "unauthenticated",
        "tampered_digest_reason": "unauthenticated",
        "sha256_alias": "rejected",
        "extra_digest_member": "rejected",
        "digest_member_parameter": "rejected",
        "noncanonical_wire_with_canonical_digest": "rejected",
        "noncanonical_wire_with_raw_digest_and_valid_signature": "rejected",
        "trailer_only_content_digest": "rejected",
        "content_coding_with_valid_signature": "rejected"
      },
      "assertions": [
        "valid self write PoP covers method, target-uri, authority, and content-digest",
        "Content-Digest uses one parameter-free sha-256 Byte Sequence member in the HTTP header section",
        "Content-Digest is recomputed against exact HTTP content bytes before trusting the signature",
        "exact HTTP content bytes equal Arkret canonical JSON bytes",
        "parse-then-canonicalize verification is rejected even when the signature is otherwise valid",
        "Content-Encoding and trailer-only Content-Digest are rejected",
        "method, path, or body transcript mismatch rejects the request"
      ]
    },
    {
      "name": "bare_bearer_rejected_protected",
      "vector_id": "ak.vector.session.bare_bearer_rejected_protected.v1",
      "kind": "protected_endpoint_pop_requirement",
      "high_security_profile": "ak.profile.high_security_organization.v1",
      "default_profile": "ak.profile.minimal_client.v1",
      "protected_read_operation_id": "ak.self.events.read.scan.v1",
      "bare_bearer_action": "protected_current_v1_endpoint",
      "public_metadata_operation_id": "ak.self.events.read.describe.v1",
      "public_metadata_surface": "unauthenticated_public_response_only",
      "created": 1716000000,
      "expires": 1716003600,
      "max_window_seconds": 300,
      "expected": {
        "high_security_bare_bearer_reason": "unauthenticated",
        "default_protected_bare_bearer_reason": "unauthenticated",
        "public_metadata_bare_bearer": "treated_as_unauthenticated_public_request",
        "over_window_pop_reason": "unauthenticated"
      },
      "assertions": [
        "production current-v1 protected endpoints reject bare bearer unless sender-constrained proof is present",
        "public metadata surfaces do not treat bare bearer as session or capability authentication",
        "PoP created/expires outside the replay window is rejected even after replay-cache eviction"
      ]
    },
    {
      "name": "session_and_device_identity_key_separation",
      "vector_id": "ak.vector.session.device_identity_key_separation.v1",
      "kind": "key_role_separation",
      "cases": [
        {
          "name": "independent_keys_accepted",
          "grant_binding_jkt": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "session_public_key_fingerprint": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
          "device_public_key_fingerprint": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
          "expected": "accepted"
        },
        {
          "name": "same_key_material_rejected",
          "grant_binding_jkt": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "session_public_key_fingerprint": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
          "device_public_key_fingerprint": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
          "expected": "unauthenticated"
        }
      ],
      "assertions": [
        "the DPoP/RFC 9421 session key may be shared only between those two session proof layers",
        "session and long-term device identity key bytes, fingerprints, and key identifiers must be distinct"
      ]
    },
    {
      "name": "dpop_target_uri_binding",
      "vector_id": "ak.vector.session.dpop_target_uri_binding.v1",
      "kind": "dpop_htu_external_uri_binding",
      "proof": {
        "htm": "POST",
        "htu": "https://service.example.com/_arkret/self/events",
        "ath": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "requests": [
        {
          "name": "direct_full_uri_match",
          "external_uri": "https://service.example.com/_arkret/self/events",
          "trusted_proxy": false,
          "expected": "accepted"
        },
        {
          "name": "same_path_different_authority",
          "external_uri": "https://evil.example.com/_arkret/self/events",
          "trusted_proxy": false,
          "expected": "unauthenticated"
        },
        {
          "name": "same_authority_different_scheme",
          "external_uri": "http://service.example.com/_arkret/self/events",
          "trusted_proxy": false,
          "expected": "unauthenticated"
        },
        {
          "name": "untrusted_forwarded_host_spoof",
          "request_uri": "https://internal.service/_arkret/self/events",
          "forwarded_host": "service.example.com",
          "trusted_proxy": false,
          "expected": "unauthenticated"
        },
        {
          "name": "trusted_proxy_clean_external_uri",
          "request_uri": "http://internal.service/_arkret/self/events",
          "forwarded_host": "service.example.com",
          "forwarded_proto": "https",
          "trusted_proxy": true,
          "headers_scrubbed_at_edge": true,
          "expected": "accepted"
        },
        {
          "name": "authority_unavailable_no_path_fallback",
          "request_path": "/_arkret/self/events",
          "trusted_proxy": false,
          "expected": "unauthenticated"
        }
      ],
      "assertions": [
        "htu comparison removes query and fragment but retains scheme, authority, and path",
        "the same path at a different authority or scheme is rejected",
        "forwarding headers are used only from a configured trusted final proxy after edge scrubbing",
        "an implementation unable to reconstruct the external URI rejects instead of using path-only comparison"
      ]
    }
  ]
}
