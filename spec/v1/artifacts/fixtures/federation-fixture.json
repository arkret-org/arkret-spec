{
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.federation.core.v1"
  },
  "suite": "federation",
  "profile": "ak.vector_group.federation.v1",
  "topology": {
    "realm_id": "ak:realm:0196419b-0000-7000-8000-000000000000",
    "principal_servers": [
      {
        "service_id": "did:webvh:z6mkfixture:server-alpha.example",
        "endpoint": "https://server-alpha.example",
        "role": "origin",
        "plaintext_visible": true
      },
      {
        "service_id": "did:webvh:z6mkfixture:server-beta.example",
        "endpoint": "https://server-beta.example",
        "role": "participant",
        "plaintext_visible": false
      },
      {
        "service_id": "did:webvh:z6mkfixture:server-gamma.example",
        "endpoint": "https://server-gamma.example",
        "role": "witness",
        "plaintext_visible": false
      }
    ],
    "service_binding_ref": {
      "realm_id": "ak:realm:0196419b-0000-7000-8000-000000000000",
      "realm_policy_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "membership_frontier": [
        "ak:event:01964145-8000-7000-8000-000000000000"
      ],
      "delivery_binding_frontier": [
        "ak:event:01964145-8000-7000-8000-000000000001"
      ],
      "destination_service_type": "principal_server",
      "reducer_profile_digest": "sha256:f8223626038ede778a4511687d3d46d7030ec828ce38f4b6008d26c71cc6926f"
    }
  },
  "cases": [
    {
      "name": "reducer_profile_digest_federation_minimal",
      "vector_id": "ak.vector.federation.reducer_profile_digest.v1",
      "resolved_digest_input_source": {
        "registry": "registry/reducer-profile-registry.json",
        "profile_id": "ak.profile.federation_minimal.v1",
        "field": "resolved_digest_input",
        "recompute_from_local_contracts": true
      },
      "expected_digest": "sha256:f8223626038ede778a4511687d3d46d7030ec828ce38f4b6008d26c71cc6926f",
      "mutation_cases": [
        {
          "name": "event_kind_contract_content_changes",
          "target": "event_kind_contracts[event_kind=ak.realm.create].content_digest",
          "mutation": "replace_with_sha256_zeros",
          "expected": "reducer_profile_digest_changes"
        },
        {
          "name": "schema_document_content_changes",
          "target": "schema_contracts[schema_id=ak.schema.event.v1].document_digest",
          "mutation": "replace_with_sha256_zeros",
          "expected": "reducer_profile_digest_changes"
        },
        {
          "name": "canonical_object_key_order_changes",
          "target": "resolved_digest_input",
          "mutation": "reverse_object_insertion_order_recursively",
          "expected": "reducer_profile_digest_unchanged"
        }
      ],
      "expected": "canonical_digest_matches_reducer_profile_registry_row"
    },
    {
      "name": "reducer_profile_mismatch",
      "vector_id": "ak.vector.federation.reducer_profile_digest.v1",
      "sender_reducer_profile_digest": "sha256:f8223626038ede778a4511687d3d46d7030ec828ce38f4b6008d26c71cc6926f",
      "receiver_reducer_profile_digest": "sha256:9acf68105ee4698368137d3ea070548556bfd6f6ad7771df0fdc77f8c97a5e09",
      "expected": "whole_batch_rejected_with_reducer_profile_mismatch"
    },
    {
      "name": "http_message_signature_digest",
      "input": {
        "source_service_id": "did:webvh:z6mkfixture:server-alpha.example",
        "destination_service_id": "did:webvh:z6mkfixture:server-beta.example",
        "method": "POST",
        "target_uri": "https://server-beta.example/_arkret/peer/events",
        "operation_id": "ak.peer.events.command.submit",
        "content_type": "application/json",
        "content_encoding": null,
        "content_digest_placement": "header",
        "content_digest_algorithm_key": "sha-256",
        "content_digest_member_count": 1,
        "exact_http_content_is_arkret_canonical_json": true,
        "content_digest_input": "exact_http_content_bytes",
        "request_canonical_digest_input": "same_exact_http_content_bytes"
      },
      "mutation_cases": [
        {
          "name": "sha256_alias_rejected",
          "content_digest_algorithm_key": "sha256",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "extra_digest_member_rejected",
          "content_digest_algorithm_key": "sha-256",
          "additional_content_digest_member": "sha-512",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "digest_member_parameter_rejected",
          "content_digest_algorithm_key": "sha-256",
          "content_digest_member_parameter": "profile=test",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "noncanonical_wire_with_canonical_digest_rejected",
          "json_value_unchanged": true,
          "exact_http_content_is_arkret_canonical_json": false,
          "content_digest_input": "canonicalized_json_bytes",
          "otherwise_valid_signature": true,
          "expected": "content_digest_mismatch"
        },
        {
          "name": "noncanonical_wire_with_raw_digest_rejected",
          "json_value_unchanged": true,
          "exact_http_content_is_arkret_canonical_json": false,
          "content_digest_input": "exact_http_content_bytes",
          "otherwise_valid_signature": true,
          "expected": "noncanonical_http_content_rejected"
        },
        {
          "name": "trailer_only_content_digest_rejected",
          "content_digest_placement": "trailer",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "content_coding_rejected",
          "content_encoding": "gzip",
          "content_digest_input": "exact_gzip_content_bytes",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        }
      ],
      "expected": "exact_canonical_content_digests_match_signature_input"
    },
    {
      "name": "source_destination_service_id_mismatch",
      "input": {
        "signature_source_service_id": "did:webvh:z6mkfixture:server-alpha.example",
        "header_source_service_id": "did:webvh:z6mkfixture:server-gamma.example",
        "header_destination_service_id": "did:webvh:z6mkfixture:server-beta.example"
      },
      "expected": "request_rejected_or_quarantined"
    },
    {
      "name": "replay_protection",
      "input": {
        "idempotency_key": "0196418b-8000-7000-8000-000000000000",
        "first_body_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "second_body_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "expected": "duplicate_idempotency_key_or_replay_key_rejected"
    },
    {
      "name": "fork_quarantine",
      "input": {
        "event_id": "ak:event:019640f9-8000-7000-8000-000000000000",
        "alpha_event_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "beta_event_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
      },
      "expected": "divergent_realm_history_quarantined"
    },
    {
      "name": "pull_authorization",
      "input": {
        "requester": "did:webvh:z6mkfixture:server-beta.example",
        "source": "did:webvh:z6mkfixture:server-alpha.example",
        "realm_id": "ak:realm:0196419b-0000-7000-8000-000000000000",
        "requested_visibility": "private_plaintext",
        "requester_plaintext_visible": false
      },
      "expected": "unauthorized_backfill_pull_blinded"
    }
  ]
}
