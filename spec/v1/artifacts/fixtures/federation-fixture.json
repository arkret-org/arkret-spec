  "suite": "federation",
  "profile": "ak.vector_group.federation.v1",
  "topology": {
    "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5",
    "stations": [
