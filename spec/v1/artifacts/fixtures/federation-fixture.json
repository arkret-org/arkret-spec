    {
      "name": "seal_prerequisite_closure",
      "vector_id": "ak.vector.federation.seal_prerequisite_closure.v1",
      "request_contract": {
        "single_realm": true,
        "event_count_range": [
          1,
          500
        ],
        "event_phase_order": [
          "control",
          "data"
        ],
        "cbs_proof_bundle_count_range": [
          0,
          64
        ],
        "per_bundle_limits": {
          "seals": 256,
          "control_moves": 1024,
          "inclusion_and_availability_proofs_combined": 2048,
          "dependency_path_depth": 4096
        },
        "closure": "bounded_verifiable_superset_rooted_at_seal_ref_and_seal_basis_leaves",
        "body_contains_idempotency_key": false
      },
      "cases": [
        {
          "case": "complete_control_seal_data_closure",
          "expected": "control_and_basis_seals_resolved_topologically_then_ordinary_events_verified"
        },
        {
          "case": "missing_control_seal_basis_leaf",
          "expected": "item_rejected_dependency_missing_with_missing_seal_refs"
        },
        {
          "case": "missing_target_seal",
          "expected": "item_rejected_dependency_missing_with_missing_seal_refs"
        },
        {
          "case": "missing_nonlocal_predecessor",
          "expected": "item_rejected_dependency_missing_with_missing_seal_refs"
        },
        {
          "case": "missing_seal_delta_control_event",
          "expected": "item_rejected_dependency_missing_with_missing_event_digests"
        },
        {
          "case": "event_seal_dependency_cycle",
          "expected": "permanent_schema_violation"
        },
        {
          "case": "invalid_seal_signature",
          "expected": "permanent_signature_invalid"
        },
        {
          "case": "cross_realm_event_or_seal",
          "expected": "permanent_schema_or_realm_mismatch"
        },
        {
          "case": "invalid_seal_root",
          "expected": "permanent_state_mismatch"
        },
        {
          "case": "unrelated_or_unsorted_or_duplicate_seal",
          "expected": "request_schema_violation_without_receiver_reordering"
        },
        {
          "case": "same_batch_unsealed_grant_then_ordinary_event",
          "expected": "grant_not_visible_for_ordinary_event_authorization"
        },
        {
          "case": "seal_transport",
          "expected": "no_actor_frontier_advance"
        }
      ]
    },
    {
      "name": "seal_prerequisite_partial_retry",
      "vector_id": "ak.vector.federation.seal_partial_retry.v1",
      "cases": [
        {
          "case": "ordinary_batch_independent_success_and_pending",
          "expected": "http_200_partial_with_success_accounted_and_pending_reason"
        },
        {
          "case": "ordinary_batch_all_pending",
          "expected": "http_200_partial_with_empty_accepted_and_duplicate"
        },
        {
          "case": "atomic_founding_unit_pending",
          "expected": "http_409_dependency_missing_problem_with_zero_writes"
        },
        {
          "case": "partial_retry_after_any_success",
          "expected": "new_body_pending_only_new_idempotency_key_and_resigned_digests"
        },
        {
          "case": "all_pending_retry",
          "expected": "new_idempotency_key_required_after_any_response"
        },
        {
          "case": "retry_budget_exhausted",
          "expected": "operator_diagnostic_without_unbounded_retry"
        }
      ]
    },
    {
      "name": "cbs_dependency_resolve",
      "vector_id": "ak.vector.federation.cbs_dependency_resolve.v1",
      "request_contract": {
        "single_realm": true,
        "selector_any_of": [
          "event_ids",
          "event_digests",
          "seal_refs"
        ],
        "max_response_bytes_ceiling": 8388608,
        "read_only": true
      },
      "cases": [
        {
          "case": "requested_seal_returns_bounded_verifiable_superset",
          "expected": "one_target_bundle_and_no_frontier_advance"
        },
        {
          "case": "requested_event_digest_resolved_inside_control_moves",
          "expected": "digest_satisfied_without_duplicate_event_copy"
        },
        {
          "case": "missing_and_undisclosable_selectors",
          "expected": "typed_missing_sets_are_externally_indistinguishable"
        },
        {
          "case": "unsorted_or_duplicate_selector_array",
          "expected": "schema_violation_before_dependency_lookup"
        },
        {
          "case": "success_omits_one_requested_selector",
          "expected": "nonconformant_response_selector_conservation_failure"
        },
        {
          "case": "response_budget_cannot_fully_account_for_all_selectors",
          "expected": "atomic_limit_exceeded_not_partial_or_empty_success"
        },
        {
          "case": "successful_round_does_not_strictly_shrink_missing_sets",
          "expected": "stop_automatic_fetch_and_surface_operator_diagnostic"
        },
        {
          "case": "ninth_consecutive_fetch_round",
          "expected": "fetch_budget_exhausted_without_submit_side_effect"
        },
        {
          "case": "resolve_response_completes_closure",
          "expected": "event_still_requires_new_submit_with_fresh_idempotency_key"
        }
      ]
    },
    {
      "name": "agent_event_admission_receipt_handoff",
      "vector_id": "ak.vector.federation.agent_admission_receipt_handoff.v1",
      "request_contract": {
        "outcome_fields": [
          "accepted",
          "duplicate",
          "rejected",
          "quarantine"
        ],
        "producer_evidence_schema": "ak.schema.authenticated_signer_resolution_evidence.v1",
        "receiver_admission_receipt": false,
        "retained_material": [
          "original_event",
          "producer_evidence",
          "recursive_dependencies"
        ],
        "acceptance_and_dependencies_atomic": true,
        "exact_retry_reuses_canonical_bytes": true,
        "successful_outcome_creates_authority": false
      },
      "cases": [
        {
          "case": "accepted_agent_event",
          "expected": "ordinary_per_event_accepted_without_receiver_receipt"
        },
        {
          "case": "accepted_non_agent_event",
          "expected": "same_per_event_outcome_contract"
        },
        {
          "case": "rejected_quarantined_or_dependency_missing_agent_event",
          "expected": "no_successful_acknowledgement"
        },
        {
          "case": "dependency_write_fails_inside_event_acceptance_transaction",
          "expected": "event_acceptance_rolls_back"
        },
        {
          "case": "two_receivers_accept_the_same_event",
          "expected": "independent_local_persistence_without_new_authority"
        },
        {
          "case": "byte_identical_resubmission_of_an_accepted_event",
          "expected": "duplicate_reuses_original_event_and_evidence"
        },
        {
          "case": "carried_event_id_does_not_match_current_canonical_bytes",
          "expected": "event_id_digest_mismatch_before_dedup_or_side_effects"
        },
        {
          "case": "two_distinct_canonical_preimages_artificially_injected_with_the_same_recomputed_complete_event_id",
          "expected": "witness_disagreement_quarantines_affected_scope"
        },
        {
          "case": "outcome_omits_an_event_from_accepted_and_duplicate",
          "expected": "outbox_obligation_remains_pending"
        },
        {
          "case": "response_transport_authentication_or_outcome_schema_invalid",
          "expected": "outcome_discarded_before_delivery_completion"
        },
        {
          "case": "destination_crashes_before_durable_commit",
          "expected": "no_successful_acknowledgement"
        },
        {
          "case": "destination_crashes_after_commit_before_response",
          "expected": "same_event_retry_returns_duplicate"
        },
        {
          "case": "source_restarts_before_delivery_completion_commit",
          "expected": "same_outbox_event_and_evidence_retry_is_safe"
        },
        {
          "case": "later_current_state_is_available_but_original_evidence_is_missing",
          "expected": "dependency_missing_without_reconstructing_original_authority"
        }
      ]
    },
    {
      "name": "frontier_mismatch_reduction_terminal_states",
      "input": {
        "comparison_key": [
          "realm_id",
          "actor_id",
          "actor_seq"
        ],
        "sibling_tuple": [
          "event_id",
          "event_digest",
          "prev_frontier_digest"
        ],
        "actor_intersection_uses_complete_actor_id": true,
        "validate_before_side_effects": true,
        "direction_binds_origin_and_destination_service": true,
        "aggregate_root_cross_peer_set_equality": false,
        "routine_scan_on_mismatch": false
      },
      "cases": [
        {
          "case": "equal_frontier_roots",
          "expected": "successful_observation_and_reset_without_set_equality_or_completeness"
        },
        {
          "case": "different_roots_with_policy_legitimate_empty_actor_intersection",
          "expected": "success_and_reset_consecutive_failures_without_global_root_convergence"
        },
        {
          "case": "peer_omits_actor_required_by_current_verified_disclosure_policy",
          "expected": "ordinary_required_disclosure_failure_not_fork_evidence"
        },
        {
          "case": "different_roots_from_permanent_legal_replication_scope_difference",
          "expected": "reconciliation_incomplete_diagnostic_without_routine_scan_peer_failure_or_global_root_convergence"
        },
        {
          "case": "peers_hold_different_legal_sibling_subsets_within_limits",
          "expected": "known_id_or_operator_fallback_candidates_use_resolve_submit_admission_then_legal_union"
        },
        {
          "case": "scan_discovers_a_missing_control_event_without_publication_sidecars",
          "expected": "resolve_the_event_id_to_event_federation_submission_before_admission"
        },
        {
          "case": "resolve_returns_the_first_accepted_control_ack_compensation_and_delayed_publication_evidence",
          "expected": "byte_identical_evidence_replays_through_the_same_federation_admission_as_push"
        },
        {
          "case": "ack_required_control_resolve_has_no_control_proposal_ack",
          "expected": "fail_closed_without_receiver_minting_and_without_counting_raw_root_mismatch_as_peer_failure"
        },
        {
          "case": "ackless_human_self_principal_control_resolve_carries_stable_admission_evidence",
          "expected": "accept_only_after_source_station_producer_device_authorize_generation_and_seal_basis_replay"
        },
        {
          "case": "resolve_carrier_contains_both_control_ack_and_ackless_admission_evidence",
          "expected": "schema_violation_before_admission"
        },
        {
          "case": "actually_executed_resolve_or_operator_fallback_remote_network_failure",
          "expected": "ordinary_remote_failure_counts_toward_three_consecutive_failures"
        },
        {
          "case": "carried_event_id_does_not_match_recomputed_complete_event_id",
          "expected": "event_id_digest_mismatch_rejected_before_dedup_index_route_auth_or_quarantine"
        },
        {
          "case": "two_distinct_canonical_preimages_artificially_recompute_to_the_same_complete_event_id",
          "expected": "first_confirmation_quarantines_affected_scope_and_sets_peer_stale"
        },
        {
          "case": "validated_sibling_bucket_exceeds_registered_limit",
          "expected": "first_confirmation_quarantines_affected_scope_and_sets_peer_stale"
        },
        {
          "case": "local_snapshot_changes_during_operator_fallback",
          "expected": "stop_or_restart_with_local_diagnostic_without_peer_failure"
        }
      ]
    },
    {
      "name": "pull_authorization",
      "input": {
        "requester": "did:webvh:z6mkfixtureserverbetaexample:server-beta.example",
        "source": "did:webvh:z6mkfixtureserveralphaexample:server-alpha.example",
        "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5",
        "requested_visibility": "private_plaintext",
        "requester_plaintext_visible": false
      },
      "expected": "unauthorized_backfill_pull_blinded"
    }
  ]
