        "role": "participant",
        "plaintext_visible": false
      },
      {
        "service_id": "ak:did_core:webvh:z6mkfixtureservergammaexample",
        "endpoint": "https://server-gamma.example",
        "role": "witness",
        "plaintext_visible": false
      }
    ],
    "service_binding_ref": {
      "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5",
      "realm_policy_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "membership_frontier": [
        "ak:event:AdxKl-xLUTrlSY_4g_1Fd8-dG5GhLSaMBGSgfzopgvI8"
      ],
      "destination_kind": "station"
    }
  },
  "cases": [
    {
      "name": "ordinary_event_uses_cba_reducer_profile_cell",
      "vector_id": "ak.vector.federation.reducer_profile_resolution.v1",
      "input": {
        "event_kind": "ak.message.create",
        "profile_source": "seal_ref_joined_control_state",
        "settled_reducer_profile": "ak.reducer.core.v1",
        "receiver_supported_reducer_profiles": [
          "ak.reducer.core.v1"
        ],
        "event_declares_reducer_profile": false,
        "service_binding_declares_reducer_profile": false
      },
      "expected": "accepted"
    },
    {
      "name": "settled_reducer_profile_not_implemented",
      "vector_id": "ak.vector.federation.reducer_profile_resolution.v1",
      "input": {
        "profile_source": "seal_ref_joined_control_state",
        "settled_reducer_profile": "ak.reducer.core.v1",
        "receiver_supported_reducer_profiles": []
      },
      "expected": "unsupported_profile"
    },
    {
      "name": "upgrade_target_not_registered",
      "vector_id": "ak.vector.federation.reducer_profile_resolution.v1",
      "input": {
        "source_reducer_profile": "ak.reducer.core.v1",
        "target_reducer_profile": "ak.reducer.unregistered.v1",
        "profile_source": "seal_basis_frozen_predecessor"
      },
      "expected": "unsupported_profile"
    },
    {
      "name": "online_event_omits_offline_publication_evidence",
      "input": {
        "authorization_lease_present": false,
        "ingress_receipt_count": 0,
        "receiver_revalidates_current_admission": true
      },
      "expected": "accepted_without_offline_publication_evidence"
    },
    {
      "name": "delayed_event_requires_lease_bound_receipt",
      "input": {
        "authorization_lease_present": true,
        "ingress_receipt_count": 0
      },
      "expected": "schema_violation"
    },
    {
      "name": "online_event_forbids_unbound_lease_receipt",
      "input": {
        "authorization_lease_present": false,
        "ingress_receipt_count": 1
      },
      "expected": "schema_violation"
    },
    {
      "name": "http_message_signature_digest",
      "input": {
        "source_id": "ak:did_core:webvh:z6mkfixtureserveralphaexample",
        "destination_id": "ak:did_core:webvh:z6mkfixtureserverbetaexample",
        "method": "POST",
        "target_uri": "https://server-beta.example/_arkret/peer/events",
        "operation_id": "ak.peer.events.command.submit.v1",
        "content_type": "application/json",
        "content_encoding": null,
        "content_digest_placement": "header",
        "content_digest_algorithm_key": "sha-256",
        "content_digest_member_count": 1,
        "exact_http_content_is_arkret_canonical_json": true,
        "content_digest_input": "exact_http_content_bytes",
        "request_canonical_digest_input": "same_exact_http_content_bytes"
      },
      "mutation_cases": [
        {
          "name": "sha256_alias_rejected",
          "content_digest_algorithm_key": "sha256",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "extra_digest_member_rejected",
          "content_digest_algorithm_key": "sha-256",
          "additional_content_digest_member": "sha-512",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "digest_member_parameter_rejected",
          "content_digest_algorithm_key": "sha-256",
          "content_digest_member_parameter": "profile=test",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "noncanonical_wire_with_canonical_digest_rejected",
          "json_value_unchanged": true,
          "exact_http_content_is_arkret_canonical_json": false,
          "content_digest_input": "canonicalized_json_bytes",
          "otherwise_valid_signature": true,
          "expected": "content_digest_mismatch"
        },
        {
          "name": "noncanonical_wire_with_raw_digest_rejected",
          "json_value_unchanged": true,
          "exact_http_content_is_arkret_canonical_json": false,
          "content_digest_input": "exact_http_content_bytes",
          "otherwise_valid_signature": true,
          "expected": "noncanonical_http_content_rejected"
        },
        {
          "name": "trailer_only_content_digest_rejected",
          "content_digest_placement": "trailer",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        },
        {
          "name": "content_coding_rejected",
          "content_encoding": "gzip",
          "content_digest_input": "exact_gzip_content_bytes",
          "otherwise_valid_signature": true,
          "expected": "rejected"
        }
      ],
      "expected": "exact_canonical_content_digests_match_signature_input"
    },
    {
      "name": "source_destination_id_mismatch",
      "input": {
        "signature_source_id": "ak:did_core:webvh:z6mkfixtureserveralphaexample",
        "header_source_id": "ak:did_core:webvh:z6mkfixtureservergammaexample",
        "header_destination_id": "ak:did_core:webvh:z6mkfixtureserverbetaexample"
      },
      "expected": "request_rejected_or_quarantined"
    },
    {
      "name": "replay_protection",
      "input": {
        "idempotency_key": "0196418b-8000-7000-8000-000000000000",
        "first_body_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "second_body_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "expected": "duplicate_idempotency_key_or_replay_key_rejected"
    },
    {
      "name": "fork_quarantine",
      "input": {
        "preimages": [
          "{\"value\":1}",
          "{\"value\":2}"
        ],
        "carried_ids": [
          "ak:event:AUggj5Qo1kY0vY4o_zRb8Oq2DVPBj6L72wubwehN8rX2",
          "ak:event:AUggj5Qo1kY0vY4o_zRb8Oq2DVPBj6L72wubwehN8rX2"
        ],
        "injected_digest_hex": "48208f9428d64634bd8e28ff345bf0eab60d53c18fa2fbdb0b9bc1e84df2b5f6",
        "real_hash_collision_claimed": false,
        "expected": {
          "reason": "witness_disagreement",
          "quarantine": true
        }
      },
      "expected": "confirmed_full_hash_collision_quarantined"
    },
    {
      "name": "seal_prerequisite_closure",
      "vector_id": "ak.vector.federation.seal_prerequisite_closure.v1",
      "request_contract": {
        "single_realm": true,
        "event_count_range": [
          1,
          500
        ],
        "event_phase_order": [
          "control",
          "data"
        ],
        "cba_proof_bundle_count_range": [
          0,
          64
        ],
        "per_bundle_limits": {
          "seals": 256,
          "control_moves": 1024,
          "inclusion_and_availability_proofs_combined": 2048,
          "dependency_path_depth": 4096
        },
        "closure": "bounded_verifiable_superset_rooted_at_seal_ref_and_seal_basis_leaves",
        "body_contains_idempotency_key": false
      },
      "cases": [
        {
          "case": "complete_control_seal_data_closure",
          "expected": "control_and_basis_seals_resolved_topologically_then_data_events_verified"
        },
        {
          "case": "missing_control_seal_basis_leaf",
          "expected": "item_rejected_dependency_missing_with_missing_seal_refs"
        },
        {
          "case": "missing_target_seal",
          "expected": "item_rejected_dependency_missing_with_missing_seal_refs"
        },
        {
          "case": "missing_nonlocal_predecessor",
          "expected": "item_rejected_dependency_missing_with_missing_seal_refs"
        },
        {
          "case": "missing_seal_delta_control_event",
          "expected": "item_rejected_dependency_missing_with_missing_event_digests"
        },
        {
          "case": "event_seal_dependency_cycle",
          "expected": "permanent_schema_violation"
        },
        {
          "case": "invalid_seal_signature",
          "expected": "permanent_signature_invalid"
        },
        {
          "case": "cross_realm_event_or_seal",
          "expected": "permanent_schema_or_realm_mismatch"
        },
        {
          "case": "invalid_seal_root",
          "expected": "permanent_state_mismatch"
        },
        {
          "case": "unrelated_or_unsorted_or_duplicate_seal",
          "expected": "request_schema_violation_without_receiver_reordering"
        },
        {
          "case": "same_batch_unsealed_grant_then_data_event",
          "expected": "grant_not_visible_for_data_event_authorization"
        },
        {
          "case": "seal_transport",
          "expected": "no_actor_frontier_advance"
        }
      ]
    },
    {
      "name": "seal_prerequisite_partial_retry",
      "vector_id": "ak.vector.federation.seal_partial_retry.v1",
      "cases": [
        {
          "case": "ordinary_batch_independent_success_and_pending",
          "expected": "http_200_partial_with_success_accounted_and_pending_reason"
        },
        {
          "case": "ordinary_batch_all_pending",
          "expected": "http_200_partial_with_empty_accepted_and_duplicate"
        },
        {
          "case": "atomic_founding_unit_pending",
          "expected": "http_409_dependency_missing_problem_with_zero_writes"
        },
        {
          "case": "partial_retry_after_any_success",
          "expected": "new_body_pending_only_new_idempotency_key_and_resigned_digests"
        },
        {
          "case": "all_pending_retry",
          "expected": "new_idempotency_key_required_after_any_response"
        },
        {
          "case": "retry_budget_exhausted",
          "expected": "operator_diagnostic_without_unbounded_retry"
        }
      ]
    },
    {
      "name": "cba_dependency_resolve",
      "vector_id": "ak.vector.federation.cba_dependency_resolve.v1",
      "request_contract": {
        "single_realm": true,
        "selector_any_of": [
          "event_ids",
          "event_digests",
          "seal_refs"
        ],
        "max_response_bytes_ceiling": 8388608,
        "read_only": true
      },
      "cases": [
        {
          "case": "requested_seal_returns_bounded_verifiable_superset",
          "expected": "one_target_bundle_and_no_frontier_advance"
        },
        {
          "case": "requested_event_digest_resolved_inside_control_moves",
          "expected": "digest_satisfied_without_duplicate_event_copy"
        },
        {
          "case": "missing_and_undisclosable_selectors",
          "expected": "typed_missing_sets_are_externally_indistinguishable"
        },
        {
          "case": "unsorted_or_duplicate_selector_array",
          "expected": "schema_violation_before_dependency_lookup"
        },
        {
          "case": "success_omits_one_requested_selector",
          "expected": "nonconformant_response_selector_conservation_failure"
        },
        {
          "case": "response_budget_cannot_fully_account_for_all_selectors",
          "expected": "atomic_limit_exceeded_not_partial_or_empty_success"
        },
        {
          "case": "successful_round_does_not_strictly_shrink_missing_sets",
          "expected": "stop_automatic_fetch_and_surface_operator_diagnostic"
        },
        {
          "case": "ninth_consecutive_fetch_round",
          "expected": "fetch_budget_exhausted_without_submit_side_effect"
        },
        {
          "case": "resolve_response_completes_closure",
          "expected": "event_still_requires_new_submit_with_fresh_idempotency_key"
        }
      ]
    },
    {
      "name": "agent_event_admission_receipt_handoff",
      "vector_id": "ak.vector.federation.agent_admission_receipt_handoff.v1",
      "request_contract": {
        "outcome_field": "agent_event_admission_receipts",
        "receipt_schema": "ak.schema.agent_signer_admission_receipt.v1",
        "receipt_proof_domain": "ak.agent_signer_admission_receipt.v1",
        "receipted_outcome_classes": [
          "accepted",
          "duplicate"
        ],
        "unreceipted_outcome_classes": [
          "rejected",
          "quarantine",
          "dependency_missing"
        ],
        "receipt_written_in_event_acceptance_transaction": true,
        "self_submit_outcome_omits_receipts": true,
        "receipt_binding_fields": [
          "event_id",
          "realm_id",
          "producer_accepted_at",
          "accepted_at",
          "agent_id",
          "verification_method",
          "producer_signer_resolution_evidence_ref",
          "producer_signer_resolution_evidence_digest",
          "receiver_id"
        ]
      },
      "cases": [
        {
          "case": "accepted_agent_event",
          "expected": "outcome_returns_one_receiver_signed_receipt_for_that_event"
        },
        {
          "case": "accepted_non_agent_event",
          "expected": "outcome_carries_no_receipt_for_that_event"
        },
        {
          "case": "rejected_quarantined_or_dependency_missing_agent_event",
          "expected": "no_receipt_signed_and_none_returned"
        },
        {
          "case": "receipt_write_fails_inside_event_acceptance_transaction",
          "expected": "event_acceptance_rolls_back_with_zero_receipt"
        },
        {
          "case": "two_receivers_accept_the_same_event",
          "expected": "one_receipt_per_receiver_id_as_distinct_historical_branches"
        },
        {
          "case": "byte_identical_resubmission_of_an_accepted_event",
          "expected": "duplicate_returns_the_first_stored_byte_identical_receipt"
        },
        {
          "case": "duplicate_branch_mints_a_new_accepted_at_or_signing_method",
          "expected": "nonconformant_receipt_replay"
        },
        {
          "case": "same_event_id_with_different_canonical_bytes",
          "expected": "duplicate_conflict_with_zero_receipt_and_zero_overwrite"
        },
        {
          "case": "receipt_set_matches_producer_evidence_pair_events_one_to_one",
          "expected": "source_atomically_commits_receipt_and_materialization_obligation"
        },
        {
          "case": "outcome_omits_a_receipt_for_one_such_event",
          "expected": "handoff_incomplete_and_delivery_not_marked_complete"
        },
        {
          "case": "outcome_returns_a_receipt_outside_accepted_and_duplicate",
          "expected": "handoff_incomplete_and_delivery_not_marked_complete"
        },
        {
          "case": "receipt_proof_unparsable_or_receiver_id_mismatch",
          "expected": "handoff_incomplete_and_delivery_not_marked_complete"
        },
        {
          "case": "receipt_producer_evidence_pair_differs_from_the_frozen_origin_pair",
          "expected": "handoff_incomplete_and_delivery_not_marked_complete"
        },
        {
          "case": "source_restarts_before_the_obligation_commit",
          "expected": "same_outbox_row_replays_the_same_event_receiver_receipt_intent"
        },
        {
          "case": "response_transport_authentication_or_outcome_schema_invalid",
          "expected": "outcome_discarded_before_any_receipt_consumption"
        }
      ]
    },
    {
      "name": "pull_authorization",
      "input": {
        "requester": "did:webvh:z6mkfixtureserverbetaexample:server-beta.example",
        "source": "did:webvh:z6mkfixtureserveralphaexample:server-alpha.example",
        "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5",
        "requested_visibility": "private_plaintext",
        "requester_plaintext_visible": false
      },
      "expected": "unauthorized_backfill_pull_blinded"
    }
  ]
}
