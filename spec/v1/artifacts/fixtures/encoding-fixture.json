{
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.encoding.core.v1"
  },
  "profile": "ak.vector_group.encoding.v1",
  "version": "2026-09-14.1",
  "description": "Canonical encoding and digest-algorithm vectors for the current authority-commit protocol.",
  "generator_semantics": "Vectors of kind *_reject_generated carry a `generator` object instead of literal input bytes: the runner MUST construct the input at execution time from the generator parameters (e.g. nesting_depth, array_item_count) following the generator.rule text, so the fixture never stores megabyte-scale literals. Rejection is asserted exactly as for literal-input vectors.",
  "vectors": [
    {
      "vector_id": "ak.vector.encoding.canonical_json.basic.v1",
      "kind": "canonical_json_digest",
      "input": {
        "b": 2,
        "a": 1
      },
      "expected_canonical_bytes_utf8": "{\"a\":1,\"b\":2}",
      "expected_digest": "sha256:43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
    },
    {
      "vector_id": "ak.vector.encoding.digest.blake3.v1",
      "kind": "blake3_digest",
      "input_utf8": "Arkret v1 BLAKE3 conformance",
      "expected_input_hex": "41726b72657420763120424c414b453320636f6e666f726d616e6365",
      "expected_digest": "blake3:6022ce7d372dd7794a374576ca840abdf81a3c01e1aa88660b971200f1ee3fa3",
      "applies_to_profiles": [
        "ak.profile.hash.blake3.v1"
      ],
      "negative_cases": [
        {
          "name": "reject_wrong_suite_prefix",
          "value": "sha256:6022ce7d372dd7794a374576ca840abdf81a3c01e1aa88660b971200f1ee3fa3",
          "expected_error": "digest_algorithm_mismatch"
        },
        {
          "name": "reject_truncated_digest",
          "value": "blake3:6022ce7d372dd7794a374576ca840abdf81a3c01e1aa88660b971200f1ee3f",
          "expected_error": "schema_violation"
        },
        {
          "name": "reject_realm_suite_mismatch",
          "realm_digest_algorithm": "sha256",
          "value": "blake3:6022ce7d372dd7794a374576ca840abdf81a3c01e1aa88660b971200f1ee3fa3",
          "expected_error": "digest_algorithm_mismatch"
        },
        {
          "name": "reject_unknown_suite_downgrade",
          "realm_digest_algorithm": "blake3",
          "value": "unknown:6022ce7d372dd7794a374576ca840abdf81a3c01e1aa88660b971200f1ee3fa3",
          "expected_error": "unsupported_digest_algorithm"
        }
      ],
      "rules": [
        "hash the exact UTF-8 bytes recorded by expected_input_hex without a trailing newline or Unicode normalization",
        "the digest prefix, lowercase hex length, and Realm digest_algorithm are part of the verified suite contract",
        "implementations declaring ak.profile.hash.blake3.v1 MUST pass the positive KAT and every negative case"
      ]
    },
    {
      "vector_id": "ak.vector.encoding.encrypted_envelope_digest.v1",
      "kind": "canonical_minimal_encrypted_envelope_digest",
      "payload_metadata": {
        "version": "1.0",
        "content_type": "application/json",
        "encryption_context": {
          "epoch": 12,
          "group_state_ref": "ak:event:Af-qizSfVETcKiliXG093VVneO4nQF194ZXGkMWJijix"
        }
      },
      "expected_metadata_canonical_bytes_utf8": "{\"content_type\":\"application/json\",\"encryption_context\":{\"epoch\":12,\"group_state_ref\":\"ak:event:Af-qizSfVETcKiliXG093VVneO4nQF194ZXGkMWJijix\"},\"version\":\"1.0\"}",
      "ciphertext_base64url": "Y2lwaGVydGV4dC1leGFtcGxlLTAwMQ",
      "ciphertext_bytes_utf8": "ciphertext-example-001",
      "digest_input_rule": "sha256(canonical_json(payload_metadata) || base64url_decode(ciphertext))",
      "expected_digest": "sha256:8fa15f456452e132ecda28f4ba94ba12f8bf93e7f56a0d110e0ba130f4a219a6",
      "rules": [
        "payload_metadata is exactly {version,content_type,encryption_context}; scope, kind, group id, scheme and sender domain are reconstructed and never duplicated on wire",
        "standard MLS encryption_context omits counter; exporter encryption_context requires the full-width counter and is cross-checked against the exact group-state scheme",
        "implementations MUST NOT hash plaintext payload"
      ]
    }
  ],
