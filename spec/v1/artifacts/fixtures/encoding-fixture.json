{
  "profile": "ck.profile.encoding_vectors.v1",
  "version": "2026-05-06",
  "description": "Machine-readable encoding & crypto vectors mirrored from zh/conformance/conformance-vectors.md §1.3-§1.12. Conformance runners MUST execute every vector and compare canonical_bytes / digest / order outputs. The crypto.ed25519_detached_jws vector lives separately in crypto-signature-fixture.json; the rank_order vector covers hex-Base32 rank string ordering (LIST item placement).",
  "vectors": [
    {
      "vector_id": "ck.vector.encoding.canonical_json.basic.v1",
      "kind": "canonical_json_digest",
      "input": {
        "b": 2,
        "a": 1
      },
      "expected_canonical_bytes_utf8": "{\"a\":1,\"b\":2}",
      "expected_digest": "sha256:43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
    },
    {
      "vector_id": "ck.vector.encoding.canonical_json.nested.v1",
      "kind": "canonical_json",
      "input": {
        "z": {
          "b": "beta",
          "a": "alpha"
        },
        "name": "Alice",
        "arr": [
          true,
          false,
          null
        ]
      },
      "expected_canonical_bytes_utf8": "{\"arr\":[true,false,null],\"name\":\"Alice\",\"z\":{\"a\":\"alpha\",\"b\":\"beta\"}}",
      "rules": [
        "object key MUST be sorted by UTF-16 code unit at every level",
        "array order MUST be preserved as input",
        "string values MUST NOT be rewritten by key sort"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.reject_noncanonical_numbers.v1",
      "kind": "canonical_json_reject",
      "rejected_inputs": [
        {
          "n": "NaN"
        },
        {
          "n": "Infinity"
        },
        {
          "n": "-Infinity"
        },
        {
          "n_literal": 1.0,
          "comment": "JSON number 1.0"
        },
        {
          "n_literal_alt": "1e0",
          "comment": "JSON number 1e0"
        }
      ],
      "rules": [
        "NaN / Infinity / -Infinity MUST reject",
        "-0 MUST reject",
        "v1 signed JSON numbers MUST be integers; 1.0 / 1e0 / fractional or exponent decimal spellings MUST reject instead of being canonicalised",
        "signature verification MUST run only after canonicalisation succeeds"
      ],
      "rejection_reason_codes": [
        "schema_violation",
        "invalid_canonical_json",
        "invalid_encoding"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.reject_malformed_json.v1",
      "kind": "canonical_json_reject",
      "rejected_input_classes": [
        "malformed UTF-8",
        "duplicate JSON object keys at the same level",
        "lone surrogate or ambiguous escape sequence",
        "non-standard literals (NaN, Infinity)",
        "non-integer JSON numbers or parser-accepted numbers that cannot be proven to be integers"
      ],
      "rules": [
        "duplicate keys MUST NOT be silently overwritten by parser default",
        "malformed strings MUST NOT be replaced with U+FFFD before signing",
        "rejection MUST be auditable; reason_code SHOULD be schema_violation, invalid_canonical_json, or invalid_encoding"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.event_digest.v1",
      "kind": "canonical_json_digest",
      "input": {
        "event_id": "ck:event:019640ed-8000-7000-8000-000000000000",
        "kind": "ck.message.create",
        "realm_id": "ck:realm:01964137-0000-7000-8000-000000000000",
        "actor_id": "did:web:alice.example",
        "actor_seq": 1,
        "created_at": "2026-04-26T00:00:00Z",
        "hlc": "01970e589d21-0004-a13f9c2e",
        "prev_refs": [],
        "refs": [],
        "effects": [
          {
            "cell": "ck:cell:message:019640ed-8000-7000-8000-000000000000",
            "op": {
              "kind": "append",
              "value": {
                "strand_id": "ck:strand:01964137-0000-7000-8000-000000000000",
                "message_id": "ck:message:019640ed-8000-7000-8000-000000000000",
                "track_name": "discussion"
              }
            }
          }
        ],
        "seal_ref": "ck:seal:sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "auth_context": {
          "did": "did:web:alice.example",
          "key_id": "device-1",
          "key_epoch": 1,
          "capability_refs": [
            "ck:grant:0196410c-0000-7000-8000-000000000000"
          ]
        },
        "payload": {
          "strand_id": "ck:strand:01964137-0000-7000-8000-000000000000",
          "track_name": "discussion",
          "message_id": "ck:message:019640ed-8000-7000-8000-000000000000",
          "content": {
            "kind": "ck.content.text",
            "body": "hello"
          }
        }
      },
      "expected_canonical_bytes_utf8": "{\"actor_id\":\"did:web:alice.example\",\"actor_seq\":1,\"auth_context\":{\"capability_refs\":[\"ck:grant:0196410c-0000-7000-8000-000000000000\"],\"did\":\"did:web:alice.example\",\"key_epoch\":1,\"key_id\":\"device-1\"},\"created_at\":\"2026-04-26T00:00:00Z\",\"effects\":[{\"cell\":\"ck:cell:message:019640ed-8000-7000-8000-000000000000\",\"op\":{\"kind\":\"append\",\"value\":{\"strand_id\":\"ck:strand:01964137-0000-7000-8000-000000000000\",\"message_id\":\"ck:message:019640ed-8000-7000-8000-000000000000\",\"track_name\":\"discussion\"}}}],\"event_id\":\"ck:event:019640ed-8000-7000-8000-000000000000\",\"hlc\":\"01970e589d21-0004-a13f9c2e\",\"kind\":\"ck.message.create\",\"payload\":{\"content\":{\"body\":\"hello\",\"kind\":\"ck.content.text\"},\"strand_id\":\"ck:strand:01964137-0000-7000-8000-000000000000\",\"message_id\":\"ck:message:019640ed-8000-7000-8000-000000000000\",\"track_name\":\"discussion\"},\"prev_refs\":[],\"realm_id\":\"ck:realm:01964137-0000-7000-8000-000000000000\",\"refs\":[],\"seal_ref\":\"ck:seal:sha256:2222222222222222222222222222222222222222222222222222222222222222\"}",
      "expected_digest": "sha256:2a98c4056c6c7a251b2c410530d796ad5df3858097b0926b4748a98cb0e8eea3",
      "rules": [
        "event digest MUST be derived from canonical bytes after stripping proofs and unsigned, before redaction",
        "event_id MUST appear inside the digest input but does not replace the digest",
        "transport envelope, HTTP headers, sync metadata, and local receive time MUST NOT be hashed",
        "the same event MUST yield the same digest on every Events API and Sync Service"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.event_batch_receipt_digest.v1",
      "kind": "canonical_json_digest",
      "input": {
        "schema": "ck.schema.event_batch_receipt.v1",
        "receipt_id": "ck:receipt:01964186-0000-7000-8000-000000000000",
        "issuer": "did:web:alice.example",
        "receipt_scope": {
          "actor_id": "did:web:alice.example"
        },
        "frontier": {
          "actor_seq": 1,
          "event_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        },
        "events": [
          "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        ],
        "created_at": "2026-04-26T00:00:00Z"
      },
      "expected_canonical_bytes_utf8": "{\"created_at\":\"2026-04-26T00:00:00Z\",\"events\":[\"sha256:1111111111111111111111111111111111111111111111111111111111111111\"],\"frontier\":{\"actor_seq\":1,\"event_digest\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\"},\"issuer\":\"did:web:alice.example\",\"receipt_id\":\"ck:receipt:01964186-0000-7000-8000-000000000000\",\"receipt_scope\":{\"actor_id\":\"did:web:alice.example\"},\"schema\":\"ck.schema.event_batch_receipt.v1\"}",
      "expected_digest": "sha256:d9a59246c869bcc59fbbb8615bdeed7987675ba8cc4134a3c0096a9e0ff80299",
      "fail_conditions": [
        "events array sorted or deduplicated before hashing",
        "proof field included in receipt digest",
        "issuer/receipt_scope/frontier/schema excluded from digest",
        "receipt_id case-folded by implementation"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.signature_binding_payload.v1",
      "kind": "canonical_json_digest",
      "input": {
        "actor_id": "did:web:alice.example",
        "verification_method": "did:web:alice.example#device-1",
        "created_at": "2026-04-26T00:00:00Z",
        "event_digest": "sha256:43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
      },
      "expected_canonical_bytes_utf8": "{\"actor_id\":\"did:web:alice.example\",\"created_at\":\"2026-04-26T00:00:00Z\",\"event_digest\":\"sha256:43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777\",\"verification_method\":\"did:web:alice.example#device-1\"}",
      "expected_digest": "sha256:98d7da309a94b0d188404e649a81fa240e338d62a7848c0ce699c3bbf85f3c6c",
      "rules": [
        "proof MUST bind event_digest, actor DID, verification_method, and created_at",
        "cross-service / cross-domain verification SHOULD additionally bind domain or audience",
        "actual ed25519 detached JWS for this binding lives in crypto-signature-fixture.json"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.hlc_order.v1",
      "kind": "ordering",
      "input": [
        "01970e589d21-0004-bbbbbbbb",
        "01970e589d20-0009-ffffffff",
        "01970e589d21-0003-ffffffff",
        "01970e589d21-0004-a13f9c2e"
      ],
      "expected_ascending": [
        "01970e589d20-0009-ffffffff",
        "01970e589d21-0003-ffffffff",
        "01970e589d21-0004-a13f9c2e",
        "01970e589d21-0004-bbbbbbbb"
      ],
      "rules": [
        "HLC MUST sort by (unix_ms, logical, node_id_hash)",
        "implementations MUST NOT compare HLC as raw wall-clock string unless the profile guarantees fixed-width lowercase hex such that string compare equals tuple compare"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.hlc_logical_overflow.v1",
      "kind": "producer_constraint",
      "input": {
        "last_emitted_hlc": "01970e589d21-ffff-a13f9c2e",
        "observed_unix_ms_hex": "01970e589d21",
        "next_event_requires_same_actor_write": true
      },
      "expected_acceptable_outcomes": [
        "wait until unix_ms_hex advances, then emit 01970e589d22-0000-a13f9c2e",
        "return local error hlc_logical_overflow before canonical bytes are produced; caller retries"
      ],
      "fail_conditions": [
        "logical counter wraps to a smaller value while still emitting events",
        "wall-clock skew is forged to escape overflow at the cost of HLC monotonicity or causality",
        "consumer accepts wrap-around values into accepted history"
      ]
    },
    {
      "vector_id": "ck.vector.encoding.cursor_opaque.core.v1",
      "kind": "cursor_opaqueness",
      "input_cursor": "ck:cursor:eyJoIjoiYWJjZGVmZ2hpamtsbW5vcHFyc3R1diIsInB1cnBvc2UiOiJzdHJlYW0iLCJ0IjoiMjA5OS0xMi0zMFQyMzo1OTo1OVoiLCJ2IjoiMSIsIngiOjQxMDI0NDQ3OTkwMDB9",
      "decoded_payload_canonical_bytes_utf8": "{\"h\":\"abcdefghijklmnopqrstuv\",\"purpose\":\"stream\",\"t\":\"2099-12-30T23:59:59Z\",\"v\":\"1\",\"x\":4102444799000}",
      "fixture_freshness_note": "Timestamps are fixed at year 2099 deliberately so the static vector cannot expire during normal spec lifetime. Implementations generating their own conformance cursors MUST use fresh `t`/`x` matching their authority's clock; do NOT reuse this fixture's `t`/`x` on the wire.",
      "client_rules": [
        "MUST treat cursor as an opaque string and round-trip it verbatim",
        "MUST NOT parse v / purpose / t / h / x to construct the next page request",
        "MUST handle cursor decode failure by treating cursor as opaque, not by aborting the protocol"
      ],
      "server_rules": [
        "MUST validate v, purpose, x, the full core cursor schema, and h handle binding before honouring cursor",
        "syntax validation failure MUST return invalid_param with reason_code invalid_cursor; TTL failure MUST return cursor_expired; handle lookup or binding failure MUST return cursor_integrity_invalid"
      ],
      "fail_conditions": [
        "client parses h/x and rebuilds a request",
        "core server accepts a cursor body without h"
      ]
    },
    {
