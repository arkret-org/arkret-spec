      "ciphertext_base64url": "Y2lwaGVydGV4dC1leGFtcGxlLTAwMQ",
      "ciphertext_bytes_utf8": "ciphertext-example-001",
      "digest_input_rule": "sha256(canonical_json(payload_metadata) || base64url_decode(ciphertext))",
      "aad_digest": "sha256:4cefc2e155017beb49d0877b58eef90318d26fa542db8b6bc0323fa23df65630",
      "expected_digest": "sha256:fa4d70fb617f745133f88062dace64f909c370027191f6f8c04b143c3258a4a8",
      "rules": [
