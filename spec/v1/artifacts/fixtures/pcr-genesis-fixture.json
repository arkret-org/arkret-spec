      "consume_abandonment_challenge",
      "record_orphan_anchor_tombstone_audit_reservation",
      "suppress_reserved_identity_creation_on_every_holder_readable_surface",
      "release_identity_creation_lease"
    ],
    "atomic": true,
    "cases": [
      {
        "name": "challenge_then_confirm_with_a_fresh_handoff",
        "steps": [
          "issue_abandonment_challenge_with_current_lease_holder_handoff",
          "confirm_with_a_different_fresh_account_handoff_grant"
        ],
        "expected": "status_abandoned_with_all_four_atomic_writes_committed_together"
      },
      {
        "name": "confirm_without_a_challenge_is_rejected",
        "attempts": [
          "omit_challenge_id_and_challenge",
          "present_a_challenge_id_that_was_never_issued",
          "reuse_the_handoff_grant_that_obtained_the_challenge"
        ],
        "expected": [
          "schema_violation",
          "failed_precondition",
          "proof_invalid"
        ],
        "zero_writes": true
      },
      {
        "name": "pcr_accepted_between_issuance_and_confirmation",
        "fault_after": "abandonment_challenge_issued",
        "mutation": "accept_the_pcr_genesis_unit_before_confirmation",
        "decided_from": [
          "challenge.did_version_id",
          "challenge.lease_fence"
        ],
        "expected": "identity_creation_already_accepted",
        "zero_writes": true,
        "notes": "Stable terminal. Removing an established identity is the account deletion path, not provisional-identity abandonment."
      },
      {
        "name": "reserved_identity_creation_is_unreadable_after_abandonment",
        "read_surfaces": [
          "account_handoff_outcome.binding.identity_creation_lease.reserved_identity"
        ],
        "expected": "absent_on_every_holder_readable_surface",
        "notes": "Security property, not a cleanup policy."
      },
      {
        "name": "same_request_id_replay_keeps_one_tombstone",
        "attempts": [
          "replay_same_request_id_and_canonical_bytes",
          "expired_unconsumed_challenge",
          "consumed_challenge_with_different_canonical_digest"
        ],
        "expected": [
          "return_recorded_outcome",
          "identity_creation_challenge_expired",
          "identity_creation_challenge_already_consumed"
        ],
        "orphan_anchor_tombstone_count": 1
      }
    ],
