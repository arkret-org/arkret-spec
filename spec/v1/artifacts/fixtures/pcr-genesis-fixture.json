  "registration_saga_cases": [
    {
      "name": "crash_after_did_published_then_exact_resume",
      "initial_state": "reserved",
      "fault_after": "did_published",
      "retry": "same_request_identity_and_canonical_bytes",
      "expected": "resume_to_completed_without_second_did_or_pcr_or_grant"
    },
    {
      "name": "stale_holder_after_fence",
      "initial_state": "did_published",
      "mutation": "increment_lease_fence_and_change_holder_jkt",
      "retry": "old_holder",
      "expected": "identity_creation_lease_fenced_zero_writes"
    },
    {
      "name": "single_use_challenge_distinguishes_terminal_states",
      "attempts": [
        "expired_unconsumed",
        "consumed_different_canonical_digest",
        "consumed_exact_successful_replay"
      ],
      "expected": [
        "identity_creation_challenge_expired",
        "identity_creation_challenge_already_consumed",
        "return_recorded_outcome"
      ]
    },
    {
      "name": "client_rejects_echo_or_post_read_mismatch",
      "mutations": [
        "account_subject",
        "principal_id",
        "did_version_id",
        "log_head_digest",
        "control_key_digest",
        "did_history_0_canonical_bytes"
      ],
      "expected": "fail_closed_before_sign_or_adopt"
    },
    {
      "name": "challenge_issuance_independent_from_renewal",
      "attempts": [
        "acquisition_then_immediate_challenge",
        "renewal_then_immediate_first_challenge",
        "renewal_budget_exhausted_but_issuance_budget_available",
        "concurrent_new_issuances",
        "same_holder_new_fence_within_issuance_window"
      ],
      "expected": [
        "issued_without_lease_extension",
        "issued_without_lease_extension",
        "issued_without_lease_extension",
        "one_issued_one_rate_limited_zero_partial_writes",
        "rate_limited"
      ]
    },
    {
      "name": "challenge_ttl_and_current_execution_authority_are_independent",
      "attempts": [
        "challenge_expires_after_issuing_handoff_and_lease",
        "same_binding_fresh_handoff_reuses_live_proof",
        "old_proof_without_current_live_lease",
        "lock_wait_crosses_lease_or_handoff_expiry",
        "canonical_zero_length_ttl"
      ],
      "expected": [
        "valid_independent_ttl_at_most_300_seconds",
        "same_transcript_no_new_issuance",
        "reject_before_registry_io",
        "reject_without_issuance",
        "reject_without_issuance"
      ]
    }
  ],
  "frozen_reservation_barrier_cases": [
    {
      "name": "missing_expired_mismatched_stale_holder_zero_registry_io",
      "attempts": [
        "no_lease",
        "expired_lease",
        "mismatched_fence",
        "stale_holder"
      ],
      "expected": "fail_closed_before_registry_io_zero_requests_on_registry_spy"
    },
    {
      "name": "concurrent_holders_single_frozen_operation",
      "holders": 2,
      "distinct": [
        "principal_id",
        "canonical_did_operation"
      ],
      "expected": "one_frozen_operation_reaches_registry_other_fails_before_registry_io"
    },
    {
      "name": "crash_after_registry_accept_before_did_published_checkpoint",
      "fault": "crash_after_registry_accept_before_did_published",
      "then": [
        "lease_expiry",
        "fence_takeover",
        "internal_saga_recovery",
        "stale_holder_retry"
      ],
      "expected": "recovery_only_queries_or_exact_replays_frozen_bytes_quorum_f0_stable_accepted_at_stale_holder_rejected"
    },
    {
      "name": "takeover_fresh_device_transcript_vs_frozen_operation_replacement",
      "allowed": "resign_fresh_device_transcript_within_permitted_fields",
      "rejected": [
        "principal_id",
        "did",
        "operation_digest",
        "canonical_bytes"
      ],
      "expected": "replacement_attempts_fail_closed_before_registry_io_frozen_operation_unchanged"
    }
  ],
