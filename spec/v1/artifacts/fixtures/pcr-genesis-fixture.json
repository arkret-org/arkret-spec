      "field": "founding_authorize.payload.authorized_generation_ref",
      "mutation": "set_to_2",
      "expected": "reject",
      "notes": "registration_anchor MUST carry 1, the value the same pcr_genesis_unit initializes (device-lifecycle.md section 5.5.2)."
    },
    {
      "field": "founding_authorize.payload.authorized_by",
      "mutation": "replace_with_a_did",
      "expected": "schema_violation",
      "notes": "authorized_by is a device_id or a did_core_id; under registration_anchor it MUST equal account_id.principal_id and is never a DID."
    },
    {
      "field": "founding_authorize.payload.device_signature",
      "mutation": "flip_one_bit",
      "expected": "proof_invalid"
    },
    {
      "field": "device_possession.canonical_object.account_id",
      "mutation": "remove",
