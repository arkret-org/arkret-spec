      "notes": "the transcript without the injected AccountId binds no account."
    },
    {
      "field": "device_possession.canonical_object.account_id",
      "mutation": "replace_with_principal_id",
      "expected": "schema_violation",
      "notes": "a bare principal core is not an AccountId; accounts with the same principal at different Stations are permanently distinct."
    },
    {
      "field": "device_possession.canonical_object.device_signature",
