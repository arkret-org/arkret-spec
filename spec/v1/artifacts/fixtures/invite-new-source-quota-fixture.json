        },
        {
          "source": "beta",
          "first_admitted_at": "2026-09-02T00:10:00.000Z"
        }
      ],
      "initial_quarantine_entry_sources": [
        "alpha",
        "beta"
      ],
      "contacts": [
        {
          "at": "2026-09-02T01:05:00.000Z",
          "source": "gamma",
          "expected_decision": "admitted"
        }
      ],
      "expected": {
        "final_ledger": [
          {
            "source": "alpha",
            "first_admitted_at": "2026-09-02T00:00:00.000Z"
          },
          {
            "source": "beta",
            "first_admitted_at": "2026-09-02T00:10:00.000Z"
          },
          {
            "source": "gamma",
            "first_admitted_at": "2026-09-02T01:05:00.000Z"
          }
        ],
        "quarantine_entry_sources": [
          "alpha",
          "beta",
          "gamma"
        ]
      },
      "invariants": [
        "the short window is sliding and is counted straight off the ledger timestamps",
        "no fixed-window rotation state exists that could release the ceiling early or late"
      ]
    },
    {
      "name": "seen_source_is_enqueued_without_recharge_or_refresh",
      "deployment_constraints_profile": "narrow",
      "holder_override": null,
      "consent_profile": "default",
      "initial_ledger": [
        {
          "source": "alpha",
          "first_admitted_at": "2026-09-02T00:00:00.000Z"
        },
        {
          "source": "beta",
          "first_admitted_at": "2026-09-02T00:10:00.000Z"
        }
      ],
      "initial_quarantine_entry_sources": [
        "alpha",
        "beta"
      ],
      "contacts": [
        {
          "at": "2026-09-02T00:20:00.000Z",
          "source": "alpha",
          "expected_decision": "seen"
        }
      ],
      "expected": {
        "final_ledger": [
          {
            "source": "alpha",
            "first_admitted_at": "2026-09-02T00:00:00.000Z"
          },
          {
            "source": "beta",
            "first_admitted_at": "2026-09-02T00:10:00.000Z"
          }
        ],
        "quarantine_entry_sources": [
          "alpha",
          "beta",
          "alpha"
        ]
      },
      "invariants": [
        "membership is tested before the two ceilings, so a seen source is admitted even with a full short window",
        "a seen source is not charged again and its first_admitted_at is not refreshed",
        "refreshing it would keep an active harasser permanently fresh inside the retention window"
