        "the same principal core at another Station is a different holder with a separate ledger"
      ]
    },
    {
      "name": "source_dimension_is_the_peer_principal_not_the_transport_source",
      "left": {
        "holder": "holder",
        "source_peer_principal_id": "alpha",
        "source_id": "service_a"
      },
      "right": {
        "holder": "holder",
        "source_peer_principal_id": "alpha",
        "source_id": "service_b"
      },
      "expected": {
        "same_ledger_key": true
      },
      "invariants": [
        "source_id is the authenticated transport source service DID and MUST NOT enter the quota identity",
        "charging per Station would let one Station be punished collectively and let a harasser bypass by switching Stations"
      ]
    },
    {
      "name": "two_peers_behind_one_transport_source_stay_distinct",
      "left": {
        "holder": "holder",
        "source_peer_principal_id": "alpha",
        "source_id": "service_a"
      },
      "right": {
        "holder": "holder",
        "source_peer_principal_id": "beta",
        "source_id": "service_a"
      },
      "expected": {
        "same_ledger_key": false
      },
      "invariants": [
        "two peer principals sharing one transport source are two new sources"
      ]
    }
