  "effective_bounds_cases": [
    {
      "name": "omitted_constraints_object_takes_specification_defaults",
      "deployment_constraints": null,
      "holder_override": null,
      "expected": {
        "decision": "accepted",
        "effective": {
          "window_seconds": 86400,
          "new_sources_per_window": 3,
          "retention_seconds": 2592000,
          "new_sources_per_retention": 30
        }
      },
      "invariants": [
        "an omitted new_source_quota object is not a disabled quota",
        "the quota itself is a MUST, so omission can only select the specification defaults"
      ]
    },
    {
      "name": "omitted_members_take_specification_defaults",
      "deployment_constraints": {
        "window_seconds": 600,
        "retention_seconds": 1200
      },
      "holder_override": null,
      "expected": {
        "decision": "accepted",
        "effective": {
          "window_seconds": 600,
          "new_sources_per_window": 3,
          "retention_seconds": 1200,
          "new_sources_per_retention": 30
        }
      },
      "invariants": [
        "a partially declared object keeps every omitted member at its specification default",
        "a deployment cannot express 'quota off' by dropping members"
      ]
    },
    {
      "name": "holder_override_above_deployment_max_is_clamped",
      "deployment_constraints": {
        "window_seconds": 3600,
        "default_new_sources_per_window": 2,
        "max_new_sources_per_window": 4,
        "retention_seconds": 7200,
        "default_new_sources_per_retention": 3,
        "max_new_sources_per_retention": 8
      },
      "holder_override": {
        "new_sources_per_window": 999,
        "new_sources_per_retention": 999
      },
      "expected": {
        "decision": "accepted",
        "effective": {
          "window_seconds": 3600,
          "new_sources_per_window": 4,
          "retention_seconds": 7200,
          "new_sources_per_retention": 8
        }
      },
      "invariants": [
        "the deployment max_* members are the only widening bound",
        "a holder override never reaches past max_*, so constraints stay a ceiling and never a grant"
      ]
    },
    {
      "name": "holder_zero_override_is_legal_and_narrows_to_zero",
      "deployment_constraints": {
        "window_seconds": 3600,
        "default_new_sources_per_window": 2,
        "max_new_sources_per_window": 4,
        "retention_seconds": 7200,
        "default_new_sources_per_retention": 3,
        "max_new_sources_per_retention": 8
      },
      "holder_override": {
        "new_sources_per_window": 0,
        "new_sources_per_retention": 0
      },
      "expected": {
        "decision": "accepted",
        "effective": {
          "window_seconds": 3600,
          "new_sources_per_window": 0,
          "retention_seconds": 7200,
          "new_sources_per_retention": 0
        }
      },
      "invariants": [
        "0 is a legal subject value that locks the holder to zero new sources",
        "the deployment default_* members never raise a subject value back up"
      ]
    },
    {
      "name": "holder_override_below_default_narrows",
      "deployment_constraints": {
        "window_seconds": 3600,
        "default_new_sources_per_window": 2,
        "max_new_sources_per_window": 4,
        "retention_seconds": 7200,
        "default_new_sources_per_retention": 3,
        "max_new_sources_per_retention": 8
      },
      "holder_override": {
        "new_sources_per_window": 1,
        "new_sources_per_retention": 2
      },
      "expected": {
        "decision": "accepted",
        "effective": {
          "window_seconds": 3600,
          "new_sources_per_window": 1,
          "retention_seconds": 7200,
          "new_sources_per_retention": 2
        }
      },
      "invariants": [
        "a subject may always make itself less reachable than the deployment default"
      ]
    },
    {
      "name": "partial_holder_override_takes_the_deployment_default_for_the_omitted_member",
      "deployment_constraints": {
        "window_seconds": 3600,
        "default_new_sources_per_window": 2,
        "max_new_sources_per_window": 4,
        "retention_seconds": 7200,
        "default_new_sources_per_retention": 3,
        "max_new_sources_per_retention": 8
      },
      "holder_override": {
        "new_sources_per_window": 1
      },
      "expected": {
        "decision": "accepted",
        "effective": {
          "window_seconds": 3600,
          "new_sources_per_window": 1,
          "retention_seconds": 7200,
          "new_sources_per_retention": 3
        }
      },
      "invariants": [
        "an omitted subject member selects default_*, never max_* and never zero"
      ]
    },
    {
      "name": "max_below_default_rejects_the_whole_constraints_object",
      "deployment_constraints": {
        "default_new_sources_per_window": 4,
        "max_new_sources_per_window": 3
      },
      "holder_override": null,
      "expected": {
        "decision": "rejected",
        "error": "schema_violation",
        "partial_member_evaluation": false
      },
      "invariants": [
        "max_new_sources_per_window >= default_new_sources_per_window is a cross-field MUST the schema cannot express",
        "the whole constraints object is rejected; the remaining members MUST NOT keep being evaluated"
      ]
    },
    {
      "name": "max_retention_below_default_retention_rejects_the_whole_constraints_object",
      "deployment_constraints": {
        "default_new_sources_per_retention": 40,
        "max_new_sources_per_retention": 30
      },
      "holder_override": null,
      "expected": {
        "decision": "rejected",
        "error": "schema_violation",
        "partial_member_evaluation": false
      },
      "invariants": [
        "max_new_sources_per_retention >= default_new_sources_per_retention is enforced by the validator"
      ]
    },
    {
      "name": "retention_shorter_than_window_rejects_the_whole_constraints_object",
      "deployment_constraints": {
        "window_seconds": 7200,
        "retention_seconds": 3600
      },
      "holder_override": null,
      "expected": {
        "decision": "rejected",
        "error": "schema_violation",
        "partial_member_evaluation": false
      },
      "invariants": [
        "retention_seconds >= window_seconds, because retention is both the ledger lifetime and the long counting window"
      ]
    },
    {
      "name": "zero_deployment_member_rejects_the_whole_constraints_object",
      "deployment_constraints": {
        "default_new_sources_per_window": 0
      },
      "holder_override": null,
      "expected": {
        "decision": "rejected",
        "error": "schema_violation",
        "partial_member_evaluation": false
      },
      "invariants": [
        "every declared deployment member is >= 1; only the subject side may express 0"
      ]
    }
