  "admission_cases": [
    {
      "name": "short_window_ceiling_admits_then_drops_while_a_charged_source_still_enters",
      "deployment_constraints_profile": "narrow",
      "holder_override": null,
      "consent_profile": "default",
      "initial_ledger": [],
      "initial_quarantine_entry_sources": [],
      "contacts": [
        {
          "at": "2026-09-02T00:00:00.000Z",
          "source": "alpha",
          "expected_decision": "admitted"
        },
        {
          "at": "2026-09-02T00:10:00.000Z",
          "source": "beta",
          "expected_decision": "admitted"
        },
        {
          "at": "2026-09-02T00:20:00.000Z",
          "source": "gamma",
          "expected_decision": "denied"
        },
        {
          "at": "2026-09-02T00:25:00.000Z",
          "source": "alpha",
          "expected_decision": "seen"
        }
      ],
      "expected": {
        "final_ledger": [
          {
            "source": "alpha",
            "first_admitted_at": "2026-09-02T00:00:00.000Z"
          },
          {
            "source": "beta",
            "first_admitted_at": "2026-09-02T00:10:00.000Z"
          }
        ],
        "quarantine_entry_sources": [
          "alpha",
          "beta",
          "alpha"
        ]
      },
      "invariants": [
        "the source over the short-window ceiling is absent from the quarantine typed current result",
        "a denied contact performs zero ledger writes and zero typed current result writes",
        "an already-charged source still enters the typed current result while the short window is full, which is what separates a seen-source ledger from a plain per-holder counter",
        "the requester-visible outcome is unchanged across all four contacts",
        "this timeline starts from an empty ledger inside one short window, so a live deployment can replay it without controlling the clock"
      ]
    },
    {
      "name": "sliding_short_window_readmits_after_the_window_passes",
      "deployment_constraints_profile": "narrow",
      "holder_override": null,
      "consent_profile": "default",
      "initial_ledger": [
        {
