      "cases": [
        {
          "name": "overturn_missing_lift",
          "appeal_state": "under_review",
          "verdict": "overturn",
          "same_batch_lift_target_matches": false,
          "expected": {
            "decision": "reject",
            "reason": "appeal_overturn_missing_lift",
            "appeal_state": "under_review",
            "original_decision_active": true
          }
        },
        {
          "name": "overturn_with_lift",
          "appeal_state": "under_review",
          "verdict": "overturn",
          "same_batch_lift_target_matches": true,
          "original_irreversible_effect": "redaction_tombstone",
          "expected": {
            "decision": "accept",
