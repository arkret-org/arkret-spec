      "duplicate_rsvp_writes": [
        {
          "actor": "did:webvh:z6mkfixturebobexample:bob.example",
          "occurrence_key": "2026-03-08T09:00:00[America/New_York]",
          "entry": {
            "schedule_basis_refs": [
              "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            ],
            "response": {
              "status": "accepted"
            }
          }
        },
        {
          "actor": "did:webvh:z6mkfixturebobexample:bob.example",
          "occurrence_key": "2026-03-08T09:00:00[America/New_York]",
          "entry": {
            "schedule_basis_refs": [
              "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            ],
            "response": {
              "status": "accepted"
            }
          }
        }
      ],
      "expected": {
        "duplicate_byte_equal_entry_noop": true
      },
      "note": "The value-level no-op condition is byte equality of the whole entry, not equality of status alone; differing basis or ciphertext yields distinct heads."
    },
