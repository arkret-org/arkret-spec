    {
      "vector_id": "ak.vector.moderation.appeal_atomicity.v1",
      "assertions": [
        "overturn_without_same_batch_lift_rejected",
        "overturn_with_lift_accepts_atomically",
        "overturn_does_not_resurrect_irreversible_effects",
