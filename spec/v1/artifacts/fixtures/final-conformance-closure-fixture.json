            "other_member_send_decision": "accept",
            "revoked_endpoint_send_decision": "reject",
            "revoked_endpoint_send_code": "device_revoked",
            "self_heal_commit_required": false
          }
        },
        {
          "name": "agent_key_revoke_refuses_only_the_revoked_sender",
