    {
      "vector_id": "ak.vector.mls.key_access_revision_key_access_only.v1",
      "clause_id": "AK-NC-061",
      "decision_points": [
        {
          "id": "key_access_revision_governs_key_access_only",
          "requirement": "An unrelated governance change such as message metadata or a capability grant leaves the key-access revision untouched; only a membership change on the scope's own stream advances it and pauses sending until a covering Commit exists; a device or Agent key revocation leaves it untouched while the governance Station send gate refuses the revoked endpoint's own send at the same cut and other members keep sending.",
          "evidence": [
            "/cases/3",
            "/cases/3/cases/1/expected",
            "/cases/3/cases/2/expected",
            "/cases/3/cases/3/expected",
            "/cases/3/cases/4/expected"
          ]
        },
        {
          "id": "key_access_revision_decides_no_authorization_or_membership",
          "requirement": "The revision carries no authorization or membership decision of its own: a membership change with no key-access effect does not move it, a current revision does not authorize a producer who is not a member, and advancing it admits nobody.",
          "evidence": [
            "/cases/9",
            "/cases/9/samples/1",
            "/cases/9/samples/2"
          ]
        }
      ]
    }
  ],
