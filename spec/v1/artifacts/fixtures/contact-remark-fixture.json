  "semantic_cases": [
    {
      "name": "storage_key_recomputation_mismatch_rejected",
      "semantic_rule": "contact_remark_subject_binds_storage_key",
      "semantic_outcome": "reject",
      "expected_reason_code": "schema_violation",
      "note": "The value validates structurally. After decryption the consumer recomputes principal_key from subject.principal_id and the holder namespace key; a value read from another Contact's key must not be applied and must not overwrite the local verified record.",
