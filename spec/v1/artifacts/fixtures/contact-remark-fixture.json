        "petname": "Wang Wei"
      }
    },
    {
      "name": "wrong_namespace_key_recomputation_rejected",
      "semantic_rule": "contact_remark_subject_binds_storage_key",
      "semantic_outcome": "reject",
      "expected_reason_code": "schema_violation",
      "note": "Recomputing with a namespace key that is not the holder's yields a different principal_key, so the exact storage-key comparison fails even though subject.principal_id is the right peer.",
