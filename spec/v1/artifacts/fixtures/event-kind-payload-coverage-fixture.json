{
  "suite": "event_kind_payload_coverage_fixture",
  "version": "2026-08-09",
  "runner": {
    "kind": "registry_coverage",
    "inputs": [
      "registry/contract-registry.json",
      "registry/event-kind-registry.json",
      "schemas/event-envelope.schema.json",
      "schemas/event-payload.schema.json",
      "schemas/accountability-grant.schema.json",
      "schemas/agent-provision.schema.json",
      "schemas/agent-selector-claim.schema.json",
      "schemas/moderation-appeal.schema.json",
      "schemas/moderation-report.schema.json",
      "schemas/read-cursor.schema.json"
    ]
  },
  "schema_validation_cases": [
    {
      "name": "relation_tombstone_payload_accepts_canonical_target",
      "schema_ref": "schemas/event-payload.schema.json#/$defs/relation_tombstone_payload",
      "expect_valid": true,
      "instance": {
        "relation_id": "ak:relation:AUifoAUG8AEOHYXp999WnI7WlLt19ByDoqYUsFwbw4A4",
        "reason": "relationship no longer applies"
      }
    },
    {
      "name": "relation_tombstone_rejects_update_payload_shape",
      "schema_ref": "schemas/event-payload.schema.json#/$defs/relation_tombstone_payload",
      "expect_valid": false,
      "first_expected_error": "contains:relation_id",
      "instance": {
        "target_ref": "ak:relation:AUifoAUG8AEOHYXp999WnI7WlLt19ByDoqYUsFwbw4A4",
        "patch": []
      }
    },
    {
      "name": "moderation_franking_proof_accepts_canonical_proof",
      "schema_ref": "schemas/moderation-report.schema.json#/$defs/franking_proof",
      "expect_valid": true,
      "instance": {
        "kind": "ak.moderation.franking_proof",
        "franking_proof_id": "ak:franking_proof:0196425b-0000-7000-8000-000000000000",
        "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5",
        "event_id": "ak:event:AQsHmGu_9sPOyJ4aG8VlWQBp8wGGhdC-BjfAaXqrIbk-",
        "routing_metadata_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "ciphertext_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "aad_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "sender_claim": {
          "actor_id": "did:webvh:z6mkfixture:alice.example",
          "device_id": "ak:device:01964137-0000-7000-8000-000000000000",
          "mls_group_id_digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444"
        },
        "received_by": "did:webvh:z6mkfixture:sync.example",
        "received_at": "2026-08-01T00:00:00.000Z",
        "replay_nonce": "fixture-nonce-0001",
        "signature": "c2lnbmF0dXJl"
      }
    },
    {
      "name": "moderation_franking_proof_rejects_report_subject_aliases",
      "schema_ref": "schemas/moderation-report.schema.json#/$defs/franking_proof",
      "expect_valid": false,
      "first_expected_error": "contains:kind",
      "instance": {
        "report_id": "ak:report:ATAqsVFFwxiA6K_flXOCz1_jv_uczcCC90q5dqT7DLm3",
        "target_ref": "ak:event:AQsHmGu_9sPOyJ4aG8VlWQBp8wGGhdC-BjfAaXqrIbk-"
      }
    }
  ],
  "assertions": [
    {
      "id": "catalog_registry_bijection",
      "rule": "contract-registry event_kinds and generated event-kind-registry rows form a one-to-one mapping by kind."
    },
    {
      "id": "payload_schema_ref_resolves",
      "rule": "Every active standard event kind declares exactly one explicit payload_schema_ref; the reference resolves and equals that kind's single Event Envelope payload dispatch. Naming-convention inference and fallback payload definitions are forbidden."
    },
    {
      "id": "wire_scope_matches_envelope",
      "rule": "Durable, actor-private, and ephemeral kinds are accepted only by their designated envelope class."
    },
    {
      "id": "unknown_durable_kind_fails_closed",
      "rule": "An unknown durable event kind is rejected before reducer dispatch."
    }
  ]
}
