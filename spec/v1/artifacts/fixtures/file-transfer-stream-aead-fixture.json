      ]
    },
    {
      "vector_id": "ak.vector.file_transfer.overall_digest_rejected.v1",
      "assertions": [
        "the SHA-256 digest covers the complete concatenated ciphertext in segment order",
        "a valid set of segment tags is not committed when the authenticated overall digest differs"
      ]
    }
  ],
