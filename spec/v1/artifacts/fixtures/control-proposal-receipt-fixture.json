{
  "profile": "ak.vector_group.cba_lattice.v1",
  "version": "2026-07-30",
  "suite": "control_proposal_receipt",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.cba.control_proposal_receipt.v1"
  },
  "covers_vectors": [
    "ak.vector.cba.external_proposal_receipt_quorum.v1",
    "ak.vector.cba.proposal_window_configuration.v1"
  ],
  "cases": [
    {
      "name": "threshold_receipt_set_uses_distinct_current_members",
      "profile": "threshold",
      "threshold": 2,
      "member_receipts": [
        {
          "verification_method": "did:webvh:z6mkfixture:authority-a.example#notary",
          "received_at": "2026-07-29T00:00:00.000Z",
          "decision_due_at": "2026-07-29T00:00:30.000Z",
          "absolute_due_at": "2026-07-29T00:01:30.000Z"
        },
        {
          "verification_method": "did:webvh:z6mkfixture:authority-b.example#notary",
          "received_at": "2026-07-29T00:00:02.000Z",
          "decision_due_at": "2026-07-29T00:00:32.000Z",
          "absolute_due_at": "2026-07-29T00:01:32.000Z"
        }
      ],
      "expected": {
        "decision": "accept",
        "received_at": "2026-07-29T00:00:02.000Z",
        "decision_due_at": "2026-07-29T00:00:30.000Z",
        "absolute_due_at": "2026-07-29T00:01:30.000Z",
        "member_order": [
          "did:webvh:z6mkfixture:authority-a.example#notary",
          "did:webvh:z6mkfixture:authority-b.example#notary"
        ]
      }
    },
    {
      "name": "duplicate_member_does_not_count_twice",
      "threshold": 2,
      "member_verification_methods": [
        "did:webvh:z6mkfixture:authority-a.example#notary",
        "did:webvh:z6mkfixture:authority-a.example#notary"
      ],
      "expected": {
        "decision": "reject",
        "reason": "quorum_unreachable"
      }
    },
    {
      "name": "mixed_authority_set_and_out_of_window_rejected",
      "member_authority_set_refs": [
        "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "received_at_span_ms": 60001,
      "receipt_sla_ms": 60000,
      "expected": {
        "decision": "reject",
        "reason": "failed_precondition"
      }
    },
    {
      "name": "receipt_sla_wire_maximum_is_inclusive",
      "received_at_span_ms": 86400000,
      "receipt_sla_ms": 86400000,
      "expected": {
        "decision": "accept"
      }
    },
    {
      "name": "receipt_sla_above_wire_maximum_is_rejected",
      "received_at_span_ms": 86400001,
      "receipt_sla_ms": 86400001,
      "expected": {
        "decision": "reject",
        "reason": "schema_violation"
      }
    },
    {
      "name": "exact_member_retry_is_byte_identical_and_conflict_cannot_extend",
      "same_proposal_digest": true,
      "same_authority_set_ref": true,
      "second_request_bytes_equal": true,
      "conflicting_second_deadline": "2026-07-29T00:02:00.000Z",
      "expected": {
        "exact_retry": "original_member_receipt",
        "conflicting_retry": "duplicate_conflict",
        "deadline_extended": false
      }
    },
    {
      "name": "decision_proofs_cannot_cross_receipt_sets",
      "receipt_set_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "decision_proof_receipt_digests": [
        "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      ],
      "expected": {
        "decision": "reject",
        "reason": "failed_precondition"
      }
    },
    {
      "name": "proposal_decision_window_after_absolute_deadline_rejected",
      "vector_id": "ak.vector.cba.proposal_window_configuration.v1",
      "realm_configuration": {
        "proposal_decision_window_ms": 3600000,
        "proposal_absolute_deadline_ms": 90000,
        "max_proposal_defers": 0
      },
      "expected": {
        "decision": "reject",
        "reason": "schema_violation",
        "must_not_write_realm_state": true
      }
    },
    {
      "name": "equal_proposal_windows_without_defers_accepted",
      "vector_id": "ak.vector.cba.proposal_window_configuration.v1",
      "realm_configuration": {
        "proposal_decision_window_ms": 90000,
        "proposal_absolute_deadline_ms": 90000,
        "max_proposal_defers": 0
      },
      "expected": {
        "decision": "accept"
      }
    },
    {
      "name": "equal_proposal_windows_with_defers_rejected",
      "vector_id": "ak.vector.cba.proposal_window_configuration.v1",
      "realm_configuration": {
        "proposal_decision_window_ms": 90000,
        "proposal_absolute_deadline_ms": 90000,
        "max_proposal_defers": 1
      },
      "expected": {
        "decision": "reject",
        "reason": "schema_violation",
        "must_not_write_realm_state": true
      }
    }
  ]
}
