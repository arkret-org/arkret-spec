        ],
        "origin_ref_fields": [
          "backup_origin_id"
        ],
        "backup_origin_id_rule": "backup:<canonical BackupId>; when absent use backup:sha256:<hex of exact envelope bytes>; never encode it as sender_domain"
      }
    ],
    "cases": [
      {
        "name": "local_export_is_authoritative",
        "origin": "direct export from locally verified MLS state",
        "result": "local_authoritative, separately accounted, consumes no received slot, and is never evictable"
      },
      {
        "name": "remote_and_rrk_material_remain_candidates",
        "origins": [
          "history_response",
          "organization_recovery_archive"
        ],
        "result": "candidate_only"
      },
      {
        "name": "fake_candidate_matching_fake_ciphertext_is_event_local",
        "preconditions": [
          "outer producer proof verifies",
          "scope/group/epoch/sender domain/AAD/schema/replay checks pass"
        ],
        "result": "bind exact {event_id,event_digest} to candidate_digest metadata; do not pin candidate bytes, promote the candidate for the epoch, or evict another sender candidate as an immediate verification side effect"
      },
      {
        "name": "failed_candidate_attribution",
        "result": "record the exact attempted event and candidate digest as failed metadata without pinning candidate bytes or poisoning the epoch"
      },
      {
        "name": "portable_backup_excludes_candidates",
        "result": "only local_authoritative entries may be serialized; restore on another endpoint creates received candidate material under portable_backup origin and does not transfer authority"
      }
    ],
    "negative_mutations": [
      "wrong_effective_scope",
      "wrong_mls_group_id",
      "wrong_epoch",
      "wrong_outer_event_digest",
      "wrong_transition_event_or_mls_digest",
      "wrong_verified_sender_domain",
      "wrong_reconstructed_aad",
      "wrong_group_ciphersuite",
      "replayed_counter"
    ],
    "material_key": [
      "effective_scope",
      "mls_group_id",
      "epoch",
      "candidate_digest"
    ],
    "material_instance_rule": "Origin is excluded from material identity. Assign immutable material_received_sequence when bytes first become resident; same bytes from a new origin do not refresh it; refetch after byte eviction creates a new resident instance and sequence.",
    "origin_attribution_key": [
      "material_key",
      "origin_domain",
      "origin_ref"
    ],
    "origin_attribution_row_fields": [
      "material_key",
      "origin_domain",
      "origin_quota_domain",
      "origin_ref",
      "first_observed_at",
      "expires_at"
    ],
    "origin_attribution_rule": "origin_ref is retrieval-only and never selects quota identity. Exact duplicate is a no-op. Keep at most 4 rows per candidate, 64 per exact scope/group/epoch/origin_domain/origin_quota_domain and 256 total per epoch. expires_at is immutable first_observed_at+2592000 seconds. Prune expired first, then retain the minimum (expires_at,candidate_digest,origin_domain,JCS(origin_quota_domain),JCS(origin_ref)) tuples. Origin attribution never duplicates bytes or changes material_received_sequence.",
    "event_candidate_binding_key": [
      "event_binding_key",
      "candidate_digest",
      "outcome"
    ],
    "event_attribution_rule": "A success or failure EventCandidateBinding contains no origin and origin cannot be inferred from it. It stores exact Event attribution, candidate_digest, outcome and bounded timestamps only; it never pins candidate secret bytes.",
    "deterministic_eviction": {
      "tier_order": [
        "received material with no success binding, including unbound and failure-only",
        "success-bound received material"
      ],
      "tie_break": [
        "material_received_sequence ascending",
        "candidate_digest UTF-8 ascending"
      ],
      "effect": "Success/failure bindings choose only the tier and never pin bytes. Delete candidate secret bytes and the resident sequence only; retain bounded origin/Event-binding tombstones so refetch can restore material with a new sequence. local_authoritative is never a victim and does not count against received slots."
    },
    "event_candidate_binding_ledger": {
      "row_fields": [
        "event_binding_key",
        "candidate_digest",
        "outcome",
        "first_observed_at",
        "expires_at"
      ],
      "outcomes": [
        "success",
        "failure"
      ],
      "expiry_rule": "expires_at equals immutable first_observed_at plus 2592000 seconds",
      "prune_order": [
        "expired rows first",
        "expires_at ascending",
        "event_id ascending",
        "event_digest ascending",
        "verified_sender_domain ascending",
        "candidate_digest ascending",
        "outcome ascending"
      ],
      "independence": "Pruning attribution metadata never mutates the ciphertext replay ledger, local_authoritative material, or epoch authority."
    }
  },
