        "payload": {
          "strand_id": "ak:strand:01970e58-0004-7000-8000-000000000002"
        },
        "content_present": false,
        "proofs_present": false,
        "verification_stub_retained": true
      }
    },
    {
      "name": "space_target_ref_schema",
      "vector_id": "ak.vector.redaction.space_target_ref_schema.v1",
      "input": "object_lifecycle_payload_with_space_target_ref",
      "expected": "schema_accepts_ck_space_target_ref_rejects_malformed"
    },
    {
      "name": "policy_scope",
      "vector_id": "ak.vector.redaction.policy_scope.v1",
