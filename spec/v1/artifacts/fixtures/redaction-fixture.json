{
  "suite": "redaction",
  "cases": [
    {
      "name": "preserved_fields",
      "vector_id": "ak.vector.redaction.preserve_fields.v1",
      "preserve": [
        "event_id",
        "created_at",
        "actor_id",
        "redacts"
      ]
    },
    {
      "name": "dangling_redaction",
      "input": "redaction_before_target",
      "expected": "pending_until_target_or_expiry"
    },
    {
      "name": "late_target_event",
      "input": "target_arrives_after_redaction",
      "expected": "render_redacted_on_materialization"
    },
    {
      "name": "audit_visibility",
      "input": "redacted_content",
      "expected": "audit_view_retains_tombstone_only"
    },
    {
      "name": "snapshot_pruning_stub",
      "vector_id": "ak.vector.redaction.snapshot_pruning_stub.v1",
      "input": "redacted_payload_pruned_after_snapshot",
      "expected": "snapshot_and_backfill_retain_verification_stub",
      "event": {
        "event_id": "ak:event:01970e58-0004-7000-8000-0000000005a1",
        "kind": "ak.message.create",
        "realm_id": "ak:realm:01970e58-0004-7000-8000-000000000001",
        "actor_id": "did:webvh:z6mkfixture:alice.example",
        "sender_actor_id": "did:webvh:z6mkfixture:alice.example",
        "created_at": "2026-04-26T00:00:00Z",
        "payload": {
          "strand_id": "ak:strand:01970e58-0004-7000-8000-000000000002",
          "content": {
            "kind": "ak.content.text",
            "body": "pruned snapshot plaintext"
          }
        },
        "proofs": [
          {
            "verification_method": "did:webvh:z6mkfixture:alice.example#ck_device_0197",
            "payload_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "signature": "signature-base64url-placeholder"
          }
        ]
      },
      "redaction_receipt": {
        "target_event_id": "ak:event:01970e58-0004-7000-8000-0000000005a1",
        "redaction_event_id": "ak:event:01970e58-0004-7000-8000-0000000005a2",
        "fields": [
          "payload.content"
        ],
        "reason": {
          "code": "retention_pruning",
          "note": "payload pruned after snapshot frontier per retention policy"
        },
        "snapshot": {
