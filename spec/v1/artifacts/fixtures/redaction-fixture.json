            "scope": {
              "storage_boundary": "projection_store",
              "realm_id": "ak:realm:01970e58-0004-7000-8000-000000000001"
            },
            "event_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
            "redaction_authorization_ref": "ak:event:01970e58-0004-7000-8000-0000000005a2",
            "receipt_id": "ak:receipt:01970e58-0004-7000-8000-0000000005a3",
            "completed_at": "2026-04-26T00:05:00Z"
