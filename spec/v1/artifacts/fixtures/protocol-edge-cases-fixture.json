      }
    },
    {
      "name": "retry_after",
      "vector_id": "ak.vector.sdk.retry_after.v1",
      "variants": [
        "retry_after_shorter_than_local_backoff",
        "retry_after_longer_than_local_cap",
        "retry_after_date"
      ],
      "expected": {
        "earliest_retry": "not_before_server_retry_after",
        "long_value_clamped": false
      }
    },
    {
      "name": "pagination_has_more",
      "vector_id": "ak.vector.sdk.pagination_has_more.v1",
      "variants": [
        "empty_items_has_more_true",
        "full_page_has_more_false",
        "short_page_has_more_true"
      ],
      "expected": {
        "continue_only_when_has_more": true
      }
    },
    {
      "name": "confusable_check",
      "vector_id": "ak.vector.encoding.confusable_check.v1",
      "inputs": [
        "alice",
        "aлice",
        "paypaӏ",
        "admin‍",
        "Ａlice"
      ],
      "expected_confusable_classes": [
        "safe_ascii",
        "mixed_script_confusable",
        "mixed_script_confusable",
        "invisible_code_point",
        "compatibility_confusable"
      ],
      "assertions": [
        "the SDK exposes this exact check as a callable utility",
        "the utility does not silently normalize before reporting"
      ]
    },
    {
      "name": "invite_membership_transition_atomicity",
      "vector_id": "ak.vector.invite.membership_transition_atomicity.v1",
      "variants": [
        "create_then_accept_walks_leave_invite_join",
        "accept_without_invite_prestate_is_invalid_membership_transition",
        "cancel_rejected_returns_member_state_to_leave",
        "revoke_with_expired_reason_returns_member_state_to_leave",
        "directed_terminal_move_missing_invitee_is_effects_payload_mismatch",
        "third_party_create_writes_no_member_state_effect",
        "bare_member_state_ban_from_invite_prestate_is_rejected"
      ],
      "expected": {
        "decision": "mixed",
        "positive_member_state_path": [
          "leave",
          "invite",
          "join"
        ]
      },
      "assertions": [
        "ak.invite.create and ak.invite.accept each write invite.lifecycle and member.state in one Control Move",
        "leave to join is never relaxed for the invite path",
        "a rejected or revoked or expired invite returns the member cell to leave in the same Control Move",
        "after the terminal move the subject loses invite-frontier read and key share eligibility in a history_visibility=invited Realm",
        "the 3PID branch produces no member.state effect and over-writing one is effects_payload_mismatch",
        "a live directed invite must be driven terminal before a ban, so the ban edge evaluates as leave to ban"
      ]
    },
    {
      "name": "join_policy_gate_axis_orthogonality",
      "vector_id": "ak.vector.join_policy.gate_axis_orthogonality.v1",
      "variants": [
        "invite_path_hits_principal_denylist",
        "public_realm_cooldown_still_evaluated",
        "closed_realm_applicant_self_join_rejected",
        "closed_realm_admin_write_accepted",
        "dm_bootstrap_batch_reaches_two_members",
        "dm_third_member_add_rejected"
      ],
      "expected": {
        "decision": "mixed",
        "external_reason_code": "gate_check_failed"
      },
      "assertions": [
        "principal_admission and cooldown are evaluated under every default_join_rule including public, invite and closed",
        "ak.invite.create and ak.invite.accept fail closed before writing member.state when the hard gate rejects",
        "closed blocks applicant-initiated entry only; the four authorized-writer branches stay available",
        "the DM bootstrap batch reaches active member count 2",
        "adding a third member to an active DM Realm is still rejected"
      ]
    },
    {
      "name": "invite_quarantine_disclosure_indistinguishable",
      "vector_id": "ak.vector.invite.quarantine_disclosure_indistinguishable.v1",
      "variants": [
        "entered_holder_quarantine",
        "rate_limit_silent_drop",
        "ttl_timeout_drop",
        "holder_not_found",
        "holder_policy_deny"
      ],
      "expected": {
        "decision": "indistinguishable",
        "status": "deferred",
        "disclosed_outcome": "absent"
      },
      "assertions": [
        "all five variants return a byte-identical response body and status code",
        "timing difference across the equivalence class is at most 50ms",
        "the response never carries disclosed_outcome=quarantined; that value is not in the enum",
        "high trust introduction evidence does not widen disclosure, because the leak is consent state and not existence",
        "invite delivery, contact delivery and ak.self.consent.command.request expose no observable that distinguishes quarantine from rejection"
      ]
    },
    {
      "name": "invite_claim_expiry_canonical_time",
      "vector_id": "ak.vector.invite.claim_expiry_canonical_time.v1",
      "variants": [
        "same_signed_claim_receiver_clock_before_expiry",
        "same_signed_claim_receiver_clock_after_expiry",
        "backfill_replay_after_expiry"
      ],
      "expected": {
        "decision": "reject",
        "reason_code": "expired_invite_token",
        "invite_state": "unchanged",
        "shared_effects": "none"
      },
      "assertions": [
        "expiry compares the signed claim event created_at against the invite expires_at and never uses receiver-local now",
        "all clock variants and the backfill replay produce identical outcome and identical invite cell value",
        "the rejected claim writes no shared effect",
        "pending to expired must come from a separate accepted ak.invite.revoke Control Move"
      ]
    }
  ]
}
