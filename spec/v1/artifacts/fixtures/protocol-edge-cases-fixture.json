    {
      "name": "invite_membership_transition_atomicity",
      "vector_id": "ak.vector.invite.membership_transition_atomicity.v1",
      "variants": [
        "create_then_accept_walks_leave_invite_join",
        "accept_without_invite_prestate_is_invalid_membership_transition",
        "cancel_rejected_returns_member_state_to_leave",
        "revoke_with_expired_reason_returns_member_state_to_leave",
        "directed_terminal_move_missing_invitee_is_reducer_projection_failed",
        "third_party_create_writes_no_member_state_effect",
        "bare_member_state_ban_from_invite_prestate_is_rejected",
        "direct_inviter_cancel_revoked_is_accepted",
        "direct_inviter_cancel_missing_or_mismatched_invitee_is_reducer_projection_failed",
        "token_invite_cancel_revoked_is_invite_kind_requires_revoke",
        "token_invite_revoke_revoked_is_accepted",
        "claimed_invite_accept_is_accepted"
      ],
      "expected": {
        "decision": "mixed",
        "positive_member_state_path": [
          "leave",
          "invite",
          "join"
        ]
      },
      "assertions": [
        "ak.invite.create and ak.invite.accept each write invite.lifecycle and member.state in one Control Move",
        "leave to join is never relaxed for the invite path",
        "a rejected or revoked or expired invite returns the member cell to leave in the same Control Move",
        "after the terminal move the subject is not a current member and loses private history-key request and response-stream eligibility under either history_access value",
        "the 3PID branch produces no member.state projection and attempting an extra write is reducer_projection_failed",
        "a live directed invite must be driven terminal before a ban, so the ban edge evaluates as leave to ban",
        "ak.invite.cancel is valid only for a stored direct invitee binding; token and 3PID invites require the high-risk ak.invite.revoke path",
        "a direct cancel requires signed payload.invitee to equal the stored invitee so lifecycle and member writes cannot split",
        "claimed to accepted is a registered invite FSM edge and ak.invite.accept must derive its from state from the frozen cell"
      ]
    },
