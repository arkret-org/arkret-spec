    {
      "name": "confusable_check",
      "vector_id": "ak.vector.encoding.confusable_check.v1",
      "inputs": [
        "alice",
        "aлice",
        "paypaӏ",
        "admin‍",
        "Ａlice"
      ],
      "expected_confusable_classes": [
        "safe_ascii",
        "mixed_script_confusable",
        "mixed_script_confusable",
        "invisible_code_point",
        "compatibility_confusable"
      ],
      "pairwise_cases": [
        {
          "a": "alice",
          "b": "alice",
          "expected": true,
          "reason": "exact"
        },
        {
          "a": "Alice",
          "b": "Ａlice",
          "expected": true,
          "reason": "compatibility_width"
        },
        {
          "a": "paypal",
          "b": "раураl",
          "expected": true,
          "reason": "uts39_cross_script_skeleton"
        },
        {
          "a": "admin",
          "b": "admin‍",
          "expected": true,
          "reason": "registered_default_ignorable"
        },
        {
          "a": "Alice",
          "b": "alice",
          "expected": false,
          "reason": "case_sensitive"
        },
        {
          "a": "Alice",
          "b": "Alicia",
          "expected": false,
          "reason": "distinct_latin_names"
        },
        {
          "a": "王伟",
          "b": "王薇",
          "expected": false,
          "reason": "distinct_cjk_names"
        }
      ],
      "assertions": [
        "the SDK exposes this exact check as a callable utility",
        "the single-input utility does not silently normalize before reporting",
        "arkret_display_confusable_v1 validates both inputs before comparison",
        "pairwise comparison uses the Unicode and UTS #39 versions pinned by string-profile-registry.json"
      ]
    },
