          "rail_available": true,
          "expected": {
            "decision": "reject",
            "reason": "signal_class_denied",
            "durable_event_written": false
          }
        },
        {
          "name": "ttl_above_session_ceiling",
          "scope_signal_classes": [
            "session"
          ],
          "signal_class": "session",
          "ttl_ms": 90000,
          "rail_available": true,
          "expected": {
            "decision": "reject",
            "reason": "signal_ttl_out_of_range",
            "durable_event_written": false
          }
        },
        {
          "name": "rail_unavailable",
          "scope_signal_classes": [
            "session"
          ],
          "signal_class": "session",
          "ttl_ms": 5000,
          "rail_available": false,
          "expected": {
            "decision": "reject",
            "reason": "signal_rail_unavailable",
            "durable_event_written": false,
            "actor_seq_advanced": false,
            "realm_frontier_advanced": false
          }
        }
