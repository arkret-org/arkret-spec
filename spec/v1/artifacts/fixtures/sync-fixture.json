  "to_device_message_idempotency": {
    "vector_id": "ak.vector.sync.to_device_message_idempotency.v1",
    "runner": "cotest::conformance::sync::run_to_device_message_idempotency_vector",
    "dedup_key": [
      "sender_principal_id",
      "sender_device_id",
      "message_id"
    ],
    "cases": [
      {
        "name": "unacked_redelivery_runs_handler_once",
        "deliveries": [
          "ak:device_message:01964137-1000-7000-8000-000000000010",
          "ak:device_message:01964137-1000-7000-8000-000000000010"
        ],
        "canonical_envelope_equal": true,
        "durable_handler_effect_count": 1,
        "dedup_record_persisted_before_ack": true,
        "expected": "accept_and_ack_after_contiguous_persistence"
      },
      {
        "name": "same_message_id_different_content_rejected",
        "message_id": "ak:device_message:01964137-1000-7000-8000-000000000010",
        "canonical_envelope_equal": false,
        "expected_error": "duplicate_conflict",
        "expected_reason_code": "message_id_conflict",
        "expected_queue_insertions": 0
      },
      {
        "name": "different_message_ids_are_distinct",
        "deliveries": [
          "ak:device_message:01964137-1000-7000-8000-000000000010",
          "ak:device_message:01964137-1000-7000-8000-000000000013"
        ],
        "business_content_equal": true,
        "durable_handler_effect_count": 2,
        "expected": "accept_both"
      }
    ]
  },
