  "expired_cursor_not_reused": {
    "description": "client-sync.md §12.3.1 — after cursor_expired / cursor_integrity_invalid, the failed cursor MUST be discarded. The client may only rebuild account.subscribe without after (initial sync) or snapshot-bootstrap via snapshot/head; it MUST NOT reuse the failed cursor as any after= / before= start, and a snapshot frontier event_id MUST NOT be placed into after= (frontier is a stop predicate, not a cursor).",
    "stale_cursor": "ak:cursor:eyJleHBpcmVzX2F0IjoiMjAyNi0wMS0wMVQwMDowMDowMC4wMDBaIiwiaCI6IlpYaHdhWEpsWkMxemRISmxZVzB0YUdGdVpHeGwiLCJpc3N1ZWRfYXQiOiIyMDI1LTEyLTMxVDIzOjU5OjU5LjAwMFoiLCJwdXJwb3NlIjoic3RyZWFtIiwidiI6IjEifQ",
    "trigger_errors": [
      "cursor_expired",
      "cursor_integrity_invalid"
    ],
    "expected": {
      "discard_local_cursor": true,
      "stale_cursor_reused": false,
      "allowed_recovery": [
        {
          "branch": "initial_sync",
          "call": "ak.self.account.stream.subscribe",
          "after_present": false,
          "catchup": true
        },
        {
          "branch": "snapshot_bootstrap",
          "call": "ak.self.snapshot.query.manifest_head",
          "realm_id": "ak:realm:0196419b-0000-7000-8000-000000000000"
        }
      ],
      "forbidden_recovery": [
        {
          "branch": "reuse_failed_cursor",
          "call": "ak.self.events.query.scan",
          "after": "ak:cursor:eyJleHBpcmVzX2F0IjoiMjAyNi0wMS0wMVQwMDowMDowMC4wMDBaIiwiaCI6IlpYaHdhWEpsWkMxemRISmxZVzB0YUdGdVpHeGwiLCJpc3N1ZWRfYXQiOiIyMDI1LTEyLTMxVDIzOjU5OjU5LjAwMFoiLCJwdXJwb3NlIjoic3RyZWFtIiwidiI6IjEifQ",
          "reject_reason": "failed cursor reused as after="
        },
        {
          "branch": "frontier_as_cursor",
          "call": "ak.self.events.query.scan",
          "after": "ak:event:019640ed-8000-7000-8000-000000000000",
          "reject_reason": "invalid_param: snapshot frontier event_id is not a cursor"
        }
      ]
    }
  },
