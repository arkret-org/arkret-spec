          "read-token-bob-multi": "01970e589d22-0001-a13f9c2e",
          "read-token-carol-multi": "01970e589d23-0001-a13f9c2e"
        },
        "on_first_read_anchor_hlc": "01970e589d22-0001-a13f9c2e",
        "aggregator_a_anchor_equals_aggregator_b": true,
        "anchor_never_moves_later": true,
        "shredded_key_restored": false
      }
