{
  "profile": "ak.profile.e2ee_client.v1",
  "version": "2026-06-19",
  "suite": "history_crypto_closure",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.crypto.history_closure.v1"
  },
  "covers_vectors": [
    "ak.vector.e2ee.late_key_recovery.t0_deterministic_visibility.v1",
    "ak.vector.preview.token_scoped_stripped_state.v1",
    "ak.vector.history_sharing.e2ee_prejoin_key_share_policy.v1",
    "ak.vector.history_sharing.principal_control_profile_baseline.v1",
    "ak.vector.history_sharing.direct_conversation_profile_baseline.v1"
  ],
  "cases": [
    {
      "vector_id": "ak.vector.e2ee.late_key_recovery.t0_deterministic_visibility.v1",
      "assertions": [
        "late_recovery_decision_uses_t0_visibility",
        "arrival_order_does_not_change_decision",
        "post_t0_ban_is_not_standalone_reject_reason",
        "key_source_must_recheck_t0_and_share_policy"
      ],
      "scenarios": [
        {
          "name": "visible_at_t0_post_ban_still_recoverable",
          "event_id": "ak:event:AUdE2zhXd0lntgHQeE19ZjdPdxBByiW_E2MrxdxeIf72",
          "receiver": "did:webvh:z6mkfixturebobexample:bob.example",
          "t0_visible": true,
          "t0_member": true,
          "post_t0_membership": "ban",
          "share_policy_allows_history_recovery": true,
          "key_source_rechecked_t0": true,
          "client_arrival_orders": [
            [
              "event",
              "ban"
            ],
            [
              "ban",
              "backfill_event"
            ]
          ],
          "expected": {
            "client_decisions_equal": true,
            "decision": "share_key",
            "depends_on_wall_clock": false,
            "post_t0_ban_used_as_reject_reason": false
          }
        },
        {
          "name": "not_visible_at_t0_rejected",
          "event_id": "ak:event:AQ2m4BnNqhMa9oSEDUOMln4VCq335wtQNf-m8DkB31Ai",
          "receiver": "did:webvh:z6mkfixturebobexample:bob.example",
          "t0_visible": false,
          "t0_member": false,
          "post_t0_membership": "join",
          "share_policy_allows_history_recovery": true,
          "key_source_rechecked_t0": true,
          "expected": {
            "decision": "reject",
            "reason": "key_unavailable",
            "post_t0_ban_used_as_reject_reason": false
          }
        },
        {
          "name": "source_without_recheck_rejected",
          "event_id": "ak:event:AcCsaxV9bUi2UuZF8QlQC-_kgvrklP7Di9_a60uP8oR4",
          "receiver": "did:webvh:z6mkfixturebobexample:bob.example",
          "t0_visible": true,
          "t0_member": true,
          "post_t0_membership": "active",
          "share_policy_allows_history_recovery": true,
          "key_source_rechecked_t0": false,
          "expected": {
            "decision": "reject",
            "reason": "policy_denied"
          }
        }
      ]
    },
    {
      "vector_id": "ak.vector.preview.token_scoped_stripped_state.v1",
      "assertions": [
        "preview_token_returns_only_policy_allowed_fields",
        "forbidden_history_and_grant_fields_omitted",
        "target_digest_and_address_link_kind_scope_confusion_returns_not_found"
      ],
      "policy": {
        "mode": "stripped_state",
        "allowed_fields": [
          "title",
          "summary",
          "join_rule",
          "member_count_bucket"
        ]
      },
      "token": {
        "aud": "did:webvh:z6mkfixturebobexample:bob.example",
        "target_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "address_link_kind": "preview",
        "ttl_seconds": 300
      },
      "requests": [
        {
          "name": "bob_preview",
          "caller": "did:webvh:z6mkfixturebobexample:bob.example",
          "target_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "address_link_kind": "preview",
          "expected": {
            "decision": "accept",
            "response_fields": [
              "join_rule",
              "member_count_bucket",
              "summary",
              "title"
            ],
            "forbidden_fields_present": false
          }
        },
        {
          "name": "mallory_scope_confused_target",
          "caller": "did:webvh:z6mkfixturemalloryexample:mallory.example",
          "target_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "address_link_kind": "preview",
          "expected": {
            "decision": "reject",
            "public_error_shape": "not_found"
          }
        },
        {
          "name": "address_link_kind_rewritten_to_invite",
          "caller": "did:webvh:z6mkfixturebobexample:bob.example",
          "target_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "address_link_kind": "invite",
          "expected": {
            "decision": "reject",
            "public_error_shape": "not_found"
          }
        }
      ],
      "forbidden_fields": [
        "history",
        "member_list",
        "policy_document",
        "join_candidates",
        "write_grant",
        "membership_grant"
      ]
    },
    {
      "vector_id": "ak.vector.history_sharing.e2ee_prejoin_key_share_policy.v1",
      "assertions": [
        "history_visibility_shared_alone_does_not_authorize_key_share",
        "explicit_history_sharing_policy_allows_bound_key_share",
        "read_eligible_unauthorized_source_is_recoverable_not_terminal_and_advertises_retry_sources",
        "preview_token_holder_is_read_class_not_key_share_state",
        "client_without_key_share_keeps_prejoin_event_decryption_pending"
      ],
      "scenarios": [
        {
          "name": "missing_history_sharing_policy",
          "history_visibility": "shared",
          "history_sharing_policy": null,
          "key_source": "archive_node",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied"
          }
        },
        {
          "name": "policy_allows_archive_node",
          "history_visibility": "shared",
          "history_sharing_policy": {
            "policy_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "pre_join_history": "visibility_condition_allowed",
            "allowed_key_sources": [
              "archive_node"
            ],
            "audit_satisfied": true
          },
          "key_source": "archive_node",
          "receiver_state_valid": true,
          "membership_frontier_digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "expected": {
            "decision": "share_key",
            "key_scope_policy_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "membership_frontier_digest_present": true
          }
        },
        {
          "name": "read_allowed_but_key_source_not_authorized",
          "history_visibility": "shared",
          "history_sharing_policy": {
            "policy_digest": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
            "pre_join_history": "visibility_condition_allowed",
            "allowed_key_sources": [
              "key_backup"
            ],
            "audit_satisfied": true
          },
          "key_source": "peer_device",
          "receiver_state_valid": true,
          "membership_frontier_digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied",
            "read_allowed": true,
            "terminal_for_reader": false,
            "client_prejoin_event_state": "decryption_pending",
            "retry_key_sources": [
              "key_backup"
            ]
          }
        },
        {
          "name": "preview_token_rule_cannot_authorize_key_share",
          "history_visibility": "restricted",
          "receiver_class": "preview_token_holder",
          "history_sharing_policy": {
            "policy_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "allowed_receiver_states": [
              "active_member"
            ],
            "restricted_rule_matches": true,
            "restricted_rule_key_sources": [
              "archive_node"
            ]
          },
          "key_source": "archive_node",
          "expected": {
            "decision": "withhold",
            "reason": "history_not_visible",
            "read_projection_allowed": true,
            "plaintext_allowed": false
          }
        },
        {
          "name": "client_without_legal_share",
          "history_visibility": "shared",
          "history_sharing_policy": null,
          "key_share_present": false,
          "expected": {
            "client_prejoin_event_state": "decryption_pending"
          }
        }
      ]
    },
    {
      "vector_id": "ak.vector.history_sharing.principal_control_profile_baseline.v1",
      "assertions": [
        "pcr_restricted_visibility_is_satisfied_by_the_profile_fixed_baseline_without_an_accepted_policy_event",
        "pcr_realm_object_must_not_declare_history_sharing_policy",
        "pcr_must_not_emit_ak_realm_history_sharing_policy",
        "pcr_release_range_is_clamped_to_the_receiving_device_authorize_frontier",
        "pcr_baseline_excludes_archive_node_and_recovery_service_key_sources",
        "ordinary_collaboration_realm_has_no_implied_baseline"
      ],
      "scenarios": [
        {
          "name": "pcr_authorized_device_gets_history_key_from_profile_baseline",
          "realm_profile": "ak.profile.principal_control_realm.v1",
          "history_visibility": "restricted",
          "history_sharing_policy": "profile_fixed_baseline",
          "accepted_history_sharing_policy_event_present": false,
          "receiver_class": "active_member",
          "receiver_state_valid": true,
          "receiver_device_authorize_accepted": true,
          "key_source": "verified_member_device",
          "expected": {
            "decision": "share_key",
            "matched_restricted_rule_id": "principal_control_authorized_device",
            "history_sharing_policy_missing_raised": false,
            "released_range_baseline": "receiver_device_ak_device_authorize_accepted_frontier"
          }
        },
        {
          "name": "pcr_managed_agent_single_event_genesis_still_has_an_effective_policy",
          "realm_profile": "ak.profile.principal_control_realm.v1",
          "genesis_shape": "single_ak_realm_create",
          "history_visibility": "restricted",
          "history_sharing_policy": "profile_fixed_baseline",
          "accepted_history_sharing_policy_event_present": false,
          "expected": {
            "decision": "accept_genesis",
            "history_sharing_policy_missing_raised": false
          }
        },
        {
          "name": "pcr_object_declares_history_sharing_policy",
          "realm_profile": "ak.profile.principal_control_realm.v1",
          "mutation": "ak.realm.create carries payload.object.history_sharing_policy",
          "expected": {
            "decision": "reject",
            "reason": "schema_violation"
          }
        },
        {
          "name": "pcr_emits_history_sharing_policy_event",
          "realm_profile": "ak.profile.principal_control_realm.v1",
          "mutation": "submit ak.realm.history_sharing_policy into the PCR",
          "expected": {
            "decision": "reject",
            "reason": "principal_control_event_kind_forbidden"
          }
        },
        {
          "name": "pcr_release_before_device_authorize_frontier",
          "realm_profile": "ak.profile.principal_control_realm.v1",
          "history_visibility": "restricted",
          "history_sharing_policy": "profile_fixed_baseline",
          "receiver_class": "active_member",
          "key_source": "verified_member_device",
          "requested_range": "epochs_earlier_than_receiver_device_authorize_frontier",
          "release_range_clamp": "range=all_visible_at_t0 is the policy ceiling; the release interval is clamped by the key-management PCR history key share release authorization",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied"
          }
        },
        {
          "name": "pcr_archive_node_source",
          "realm_profile": "ak.profile.principal_control_realm.v1",
          "history_visibility": "restricted",
          "history_sharing_policy": "profile_fixed_baseline",
          "receiver_class": "active_member",
          "key_source": "archive_node",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied"
          }
        },
        {
          "name": "ordinary_realm_restricted_without_policy_event",
          "realm_profile": null,
          "history_visibility": "restricted",
          "history_sharing_policy": null,
          "accepted_history_sharing_policy_event_present": false,
          "baseline_scope": "only ak.profile.principal_control_realm.v1 and ak.profile.direct_conversation_realm.v1 supply a profile-fixed baseline; a Collaboration Realm claiming neither profile gets no implied baseline",
          "expected": {
            "decision": "reject",
            "reason": "history_sharing_policy_missing"
          }
        }
      ]
    },
    {
      "vector_id": "ak.vector.history_sharing.direct_conversation_profile_baseline.v1",
      "assertions": [
        "direct_conversation_key_share_is_evaluated_against_the_profile_fixed_baseline_without_an_accepted_policy_event",
        "generation_zero_provisional_history_key_share_to_the_exact_peer_is_released",
        "pre_join_history_deny_must_not_refuse_the_generation_zero_provisional_history_key_share",
        "direct_conversation_baseline_excludes_archive_node_and_recovery_service_key_sources",
        "post_repair_rejoin_gets_no_key_for_the_absence_window",
        "direct_conversation_realm_object_must_not_declare_history_sharing_policy"
      ],
      "scenarios": [
        {
          "name": "generation_zero_provisional_history_share_to_exact_peer",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "history_visibility": "joined",
          "history_sharing_policy": "profile_fixed_baseline",
          "accepted_history_sharing_policy_event_present": false,
          "authorization_ref": "ak.authority.direct_conversation_bootstrap_participant.v1",
          "bootstrap_phase": "provisional_history_send",
          "receiver_class": "active_member",
          "receiver_is_exact_peer": true,
          "receiver_join_frontier": "realm_genesis",
          "requested_range": "mls_generation_0_exporter_epoch",
          "key_source": "verified_member_device",
          "expected": {
            "decision": "share_key",
            "history_sharing_policy_missing_raised": false,
            "share_audit_event_required": true
          }
        },
        {
          "name": "pre_join_history_deny_must_not_block_generation_zero",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "history_visibility": "joined",
          "history_sharing_policy": "profile_fixed_baseline",
          "pre_join_history": "deny",
          "receiver_class": "active_member",
          "receiver_is_exact_peer": true,
          "receiver_join_frontier": "realm_genesis",
          "requested_range": "mls_generation_0_exporter_epoch",
          "key_source": "verified_member_device",
          "pre_join_disambiguation": "pre_join_history means before Realm membership and the peer is a member from Realm Genesis onward, so no Event has an earlier T0; the pre-join wording of contact-and-direct-conversation.md section 6.2 only means the peer is not yet an MLS leaf",
          "expected": {
            "decision": "share_key",
            "withheld_for_pre_join_history": false
          }
        },
        {
          "name": "direct_conversation_archive_node_source",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "history_visibility": "joined",
          "history_sharing_policy": "profile_fixed_baseline",
          "receiver_class": "active_member",
          "receiver_is_exact_peer": true,
          "key_source": "archive_node",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied"
          }
        },
        {
          "name": "direct_conversation_recovery_service_source",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "history_visibility": "joined",
          "history_sharing_policy": "profile_fixed_baseline",
          "receiver_class": "active_member",
          "receiver_is_exact_peer": true,
          "key_source": "recovery_service",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied"
          }
        },
        {
          "name": "post_repair_rejoin_absence_window_key_share",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "repair_profile": "ak.profile.direct_conversation_repair.v1",
          "history_visibility": "joined",
          "history_sharing_policy": "profile_fixed_baseline",
          "post_removal_recovery": "deny",
          "receiver_class": "active_member",
          "receiver_is_exact_peer": true,
          "receiver_membership_sequence": "join_leave_rejoin",
          "requested_range": "events_authored_during_the_absence_window",
          "key_source": "verified_member_device",
          "expected": {
            "decision": "withhold",
            "reason": "history_not_visible"
          }
        },
        {
          "name": "direct_conversation_object_declares_history_sharing_policy",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "mutation": "ak.realm.create carries payload.object.history_sharing_policy",
          "expected": {
            "decision": "reject",
            "reason": "schema_violation"
          }
        },
        {
          "name": "direct_conversation_founding_unit_appends_history_sharing_policy",
          "realm_profile": "ak.profile.direct_conversation_realm.v1",
          "mutation": "append ak.realm.history_sharing_policy as a fifth Event of the founding unit",
          "expected": {
            "decision": "reject",
            "reason": "direct_conversation_founding_unit_invalid",
            "writes": 0
          }
        }
      ]
    }
  ]
}
