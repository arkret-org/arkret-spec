    {
      "vector_id": "ak.vector.history_sharing.e2ee_prejoin_key_share_policy.v1",
      "assertions": [
        "history_visibility_shared_alone_does_not_authorize_key_share",
        "explicit_history_sharing_policy_allows_bound_key_share",
        "read_eligible_unauthorized_source_is_recoverable_not_terminal_and_advertises_retry_sources",
        "preview_token_holder_is_read_class_not_key_share_state",
        "client_without_key_share_keeps_prejoin_event_decryption_pending"
      ],
      "scenarios": [
        {
          "name": "missing_history_sharing_policy",
          "history_visibility": "shared",
          "history_sharing_policy": null,
          "key_source": "archive_node",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied"
          }
        },
        {
          "name": "policy_allows_archive_node",
          "history_visibility": "shared",
          "history_sharing_policy": {
            "policy_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "pre_join_history": "allow_if_visibility_allows",
            "allowed_key_sources": [
              "archive_node"
            ],
            "audit_satisfied": true
          },
          "key_source": "archive_node",
          "receiver_state_valid": true,
          "membership_frontier_digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "expected": {
            "decision": "share_key",
            "key_scope_policy_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "membership_frontier_digest_present": true
          }
        },
        {
          "name": "read_allowed_but_key_source_not_authorized",
          "history_visibility": "shared",
          "history_sharing_policy": {
            "policy_digest": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
            "pre_join_history": "allow_if_visibility_allows",
            "allowed_key_sources": [
              "key_backup"
            ],
            "audit_satisfied": true
          },
          "key_source": "peer_device",
          "receiver_state_valid": true,
          "membership_frontier_digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "expected": {
            "decision": "withhold",
            "reason": "policy_denied",
            "read_allowed": true,
            "terminal_for_reader": false,
            "client_prejoin_event_state": "decryption_pending",
            "retry_key_sources": [
              "key_backup"
            ]
          }
        },
        {
          "name": "preview_token_rule_cannot_authorize_key_share",
          "history_visibility": "restricted",
          "receiver_class": "preview_token_holder",
          "history_sharing_policy": {
            "policy_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "allowed_receiver_states": [
              "active_member"
            ],
            "restricted_rule_matches": true,
            "restricted_rule_key_sources": [
              "archive_node"
            ]
          },
          "key_source": "archive_node",
          "expected": {
            "decision": "withhold",
            "reason": "history_not_visible",
            "read_projection_allowed": true,
            "plaintext_allowed": false
          }
        },
        {
          "name": "client_without_legal_share",
          "history_visibility": "shared",
          "history_sharing_policy": null,
          "key_share_present": false,
          "expected": {
            "client_prejoin_event_state": "decryption_pending"
          }
