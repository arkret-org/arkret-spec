          "label": "invalid_before_send_replay",
          "message_id": "ak:message:0196419b-0000-7000-8000-000000006201",
          "principal_id": "did:webvh:z6mkfixture:bob.example",
          "device_id": "ak:device:0196419b-0000-7000-8000-000000006202",
