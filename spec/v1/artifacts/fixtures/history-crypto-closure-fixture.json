      ],
      "message_id": "ak:message:0196419b-0000-7000-8000-000000006301",
      "trigger": "on_last_read",
      "eligible_principals": [
        "did:webvh:z6mkfixture:bob.example",
        "did:webvh:z6mkfixture:carol.example",
        "did:webvh:z6mkfixture:david.example"
