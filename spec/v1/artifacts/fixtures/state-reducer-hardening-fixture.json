                },
                "synthesis": {
                  "enabled": true,
                  "is_primary": false
                }
              }
            }
          },
          {
            "name": "disable_and_profile_update_atomic",
            "patch": [
              {
                "path": "tracks.discussion.enabled",
                "op": "set",
                "value": false
              },
              {
                "path": "tracks.discussion.profile",
                "op": "set",
                "value": "review"
              }
            ],
            "expected": {
              "decision": "accept",
              "cell_writes": 1,
              "tracks": {
                "discussion": {
                  "enabled": false,
                  "is_primary": false,
                  "profile": "review"
                },
                "synthesis": {
                  "enabled": true,
                  "is_primary": true
                }
              }
            }
          },
          {
            "name": "disabled_primary_rejected",
            "patch": [
              {
                "path": "tracks.synthesis.enabled",
                "op": "set",
                "value": false
              }
            ],
            "expected": {
              "decision": "reject",
              "reason": "primary_track_required",
              "tracks_unchanged": true
            }
          },
          {
            "name": "last_enabled_track_rejected",
            "patch": [
              {
                "path": "tracks.discussion.enabled",
                "op": "set",
                "value": false
              },
              {
                "path": "tracks.synthesis.enabled",
                "op": "set",
                "value": false
              }
            ],
            "expected": {
              "decision": "reject",
              "reason": "primary_track_required",
              "tracks_unchanged": true
            }
          },
          {
            "name": "primary_conflict_rejected_all_or_nothing",
            "patch": [
              {
                "path": "tracks.synthesis.is_primary",
                "op": "set",
                "value": true
