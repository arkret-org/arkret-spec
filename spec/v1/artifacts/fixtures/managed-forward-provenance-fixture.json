{
  "profile": "ak.profile.federation_minimal.v1",
  "version": "2026-10-18.1",
  "suite": "managed_forward_provenance",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.federation.managed_forward_provenance.v1"
  },
  "covers_vectors": [
    "ak.vector.federation.managed_forward_provenance.v1"
  ],
  "required_schema_refs": [
    "schemas/authority-commit-operations.schema.json#/$defs/forward_managed_actor_provenance",
    "schemas/authority-commit-operations.schema.json#/$defs/peer_submit_request"
  ],
  "setup": {
    "topology": "independent_account_station_and_business_governor",
    "actors": "real_native_provisioned_bot_and_ghost",
    "source": "four_original_service_signed_events_with_source_commits_and_same_device_cut_current_identity",
    "no_seeded_anchors": true,
    "no_human_fallback": true
  },
  "cases": [
    {
      "name": "bot_event_original_closure",
      "expect": "accepted_one_commit"
    },
    {
      "name": "ghost_event_original_closure",
      "expect": "accepted_one_commit"
    },
    {
      "name": "bot_complete_mls_original_closure",
      "expect": "accepted_one_unit"
    },
    {
      "name": "ghost_complete_mls_original_closure",
      "expect": "accepted_one_unit"
    },
    {
      "name": "ghost_reuse_other_business_scope",
      "expect": "accepted_no_second_creation"
    },
    {
      "name": "current_after_valid_governance_handoff",
      "expect": "accepted_with_verified_generation_authority"
    },
    {
      "name": "current_unknown_or_discontinuous_governance_authority",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "missing_creation_slot",
      "expect": "schema_violation_zero_writes"
    },
    {
      "name": "extra_private_history_or_fixed_set",
      "expect": "schema_violation_zero_writes"
    },
    {
      "name": "wrong_actor_service_applet_role_or_tuple",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "wrong_original_signature_or_service_history",
      "expect": "signature_invalid_zero_writes"
    },
    {
      "name": "wrong_commit_source_scope_or_coordinates",
      "expect": "signature_invalid_zero_writes"
    },
    {
      "name": "wrong_pcr_purpose_or_genesis",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "wrong_current_selector_scope_or_covering_commit",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "revoked_expired_unknown_or_inactive_current",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "mixed_device_and_identity_cut",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "altered_sibling_body_digest",
      "expect": "signature_invalid_zero_writes"
    },
    {
      "name": "closure_over_one_mib",
      "expect": "payload_too_large_zero_writes"
    },
    {
      "name": "human_agent_service_or_native_pcr_carries_closure",
      "expect": "schema_violation_zero_writes"
    },
    {
      "name": "atomic_or_replication_carries_closure",
      "expect": "schema_violation_zero_writes"
    },
    {
      "name": "missing_governor_parent_install_membership_policy_approval_or_quota",
      "expect": "rejected_zero_writes"
    },
    {
      "name": "writer_failure_after_verification",
      "expect": "rollback_all_effects_and_audit"
    },
    {
      "name": "exact_retry_after_source_expiry",
      "expect": "original_outcome_no_second_write"
    },
    {
      "name": "cold_governor_exact_retry",
      "expect": "original_bytes_no_new_effects"
    },
    {
      "name": "member_history_scan_snapshot_never_contains_private_closure",
      "expect": "minimal_fact_only"
    }
  ]
