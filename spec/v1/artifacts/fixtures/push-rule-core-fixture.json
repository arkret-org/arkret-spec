          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      },
      "assertions": [
        "strand-engaged here-style updates map to receiver-side mention semantics",
        "mentions_only watch level delivers the engaged notification",
        "shared core reason_code remains watch_allows"
