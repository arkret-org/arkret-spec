          "muted_short_circuit": false,
          "blind_wakeup_required": true,
          "unresolved_client_evaluation": true
        }
      }
    },
    {
      "name": "e2ee_muted_still_short_circuits",
      "watch_level": "muted",
      "event": {
        "mentions_actor": true,
        "is_e2ee": true,
        "local_decrypted": false
      },
      "expected": {
