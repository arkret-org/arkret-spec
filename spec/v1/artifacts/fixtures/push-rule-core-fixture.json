        "client_projection": {
          "should_notify": false,
          "watch_suppressed": false,
          "muted_short_circuit": false,
          "blind_wakeup_required": true,
          "unresolved_client_evaluation": true
        }
      }
    },
    {
      "name": "e2ee_mentions_only_unknown_requires_blind_wakeup",
      "watch_level": "mentions_only",
      "event": {
        "is_e2ee": true,
        "local_decrypted": false
      },
      "client_projection": {
        "mentions_actor_known": false
      },
      "expected": {
        "deliver": true,
