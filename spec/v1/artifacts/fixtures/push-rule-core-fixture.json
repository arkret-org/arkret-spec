{
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.push.rule_core.v1"
  },
  "suite": "push_rule_core_consistency",
  "profile": "ak.profile.push_gateway.blind_wakeup.v1",
  "description": "Shared v1 push rule vectors for conforming SDK implementations.",
  "cases": [
    {
      "name": "muted_direct_mention_short_circuits",
      "watch_level": "muted",
      "event": {
        "mentions_actor": true
      },
      "expected": {
        "deliver": false,
        "blind_wakeup": false,
        "reason_code": "muted",
        "client_projection": {
          "should_notify": false,
          "watch_suppressed": true,
          "muted_short_circuit": true,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      }
    },
    {
      "name": "mentions_only_plain_non_directed_is_filtered",
      "watch_level": "mentions_only",
      "event": {},
      "expected": {
        "deliver": false,
        "blind_wakeup": false,
        "reason_code": "not_mentioned",
        "client_projection": {
          "should_notify": false,
          "watch_suppressed": true,
          "muted_short_circuit": false,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      }
    },
    {
      "name": "mentions_only_assigned_to_actor_delivers",
      "watch_level": "mentions_only",
      "event": {
        "assigned_to_actor": true
      },
      "expected": {
        "deliver": true,
        "blind_wakeup": false,
        "reason_code": "watch_allows",
        "client_projection": {
          "should_notify": true,
          "watch_suppressed": false,
          "muted_short_circuit": false,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      }
    },
    {
      "name": "broadcast_mention_controls_authorized_audience_delivers",
      "vector_id": "ak.vector.push.broadcast_mention_controls.v1",
      "watch_level": "mentions_only",
      "event": {
        "mentions_actor": true
      },
      "expected": {
        "deliver": true,
        "blind_wakeup": false,
        "reason_code": "watch_allows",
        "client_projection": {
          "should_notify": true,
          "watch_suppressed": false,
          "muted_short_circuit": false,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      },
      "assertions": [
        "authorized broadcast mentions deliver under mentions_only watch level",
        "plain directed mentions do not require blind wakeup after local evaluation",
        "shared core reason_code remains watch_allows"
      ]
    },
    {
      "name": "strand_engaged_here_maps_to_receiver_side_mention",
      "vector_id": "ak.vector.push.strand_engaged_mention.v1",
      "watch_level": "mentions_only",
      "event": {
        "mentions_actor": true
      },
      "expected": {
        "deliver": true,
        "blind_wakeup": false,
        "reason_code": "watch_allows",
        "client_projection": {
          "should_notify": true,
          "watch_suppressed": false,
          "muted_short_circuit": false,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      },
      "assertions": [
        "strand-engaged here-style updates map to receiver-side mention semantics",
        "mentions_only watch level delivers the engaged notification",
        "shared core reason_code remains watch_allows"
      ]
    },
    {
      "name": "hardened_realm_disables_recipient_registered_mention_routing",
      "vector_id": "ak.vector.push.mention_routing_hint_disabled_on_hardened_realm.v1",
      "runner": "cotest::conformance::push_rule_core::run_hardened_mention_routing_hint_vector",
      "variants": [
        {
          "realm_profiles": [
            "ak.profile.mls.minimal_metadata_realm.v1"
          ],
          "declared_mention_routing_hint": "recipient_registered_token",
          "expected_effective_hint": "disabled"
        },
        {
          "realm_profiles": [
            "ak.profile.attested_audit.e2ee.v1"
          ],
          "declared_mention_routing_hint": "recipient_registered_token",
          "expected_effective_hint": "disabled"
        },
        {
          "realm_profiles": [
            "ak.profile.disclosed_audit.e2ee.v1"
          ],
          "declared_mention_routing_hint": "recipient_registered_token",
          "expected_effective_hint": "disabled"
        },
        {
          "realm_profiles": [
            "ak.profile.e2ee_client.v1"
          ],
          "declared_mention_routing_hint": "recipient_registered_token",
          "expected_effective_hint": "recipient_registered_token"
        },
        {
          "realm_profiles": [
            "ak.profile.mls.minimal_metadata_realm.v1"
          ],
          "declared_mention_routing_hint": "unknown_hint",
          "expected_effective_hint": "disabled"
        }
      ],
      "expected_hardened_behavior": {
        "register_sidecar_token": false,
        "compare_sidecar_token": false,
        "persist_sidecar_token": false,
        "fallback": "blind_or_batch_wakeup"
      },
      "assertions": [
        "minimal-metadata and both audited E2EE profiles force disabled",
        "explicit recipient_registered_token cannot weaken a hardened profile",
        "unknown hint values fail closed as disabled",
        "ordinary non-hardened E2EE remains the positive control",
        "no registration comparison or persistence occurs before blind or batch fallback"
      ]
    },
    {
      "name": "participating_plain_non_participant_is_filtered",
      "watch_level": "participating",
      "event": {},
      "expected": {
        "deliver": false,
