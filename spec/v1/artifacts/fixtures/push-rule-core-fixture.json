{
  "version": "2026-09-19.1",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.push.rule_core.v1"
  },
  "suite": "push_rule_core_consistency",
  "profile": "ak.profile.push_gateway.blind_wakeup.v1",
  "description": "Shared v1 push rule vectors for conforming SDK implementations.",
  "cases": [
    {
      "name": "muted_direct_mention_short_circuits",
      "watch_level": "muted",
      "event": {
        "mentions_actor": true
      },
      "expected": {
        "deliver": false,
        "blind_wakeup": false,
        "reason_code": "muted",
        "client_projection": {
          "should_notify": false,
          "watch_suppressed": true,
          "muted_short_circuit": true,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      }
    },
    {
      "name": "mentions_only_plain_non_directed_is_filtered",
      "watch_level": "mentions_only",
      "event": {},
      "expected": {
        "deliver": false,
        "blind_wakeup": false,
        "reason_code": "not_mentioned",
        "client_projection": {
          "should_notify": false,
          "watch_suppressed": true,
          "muted_short_circuit": false,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      }
    },
    {
      "name": "mentions_only_assigned_to_actor_delivers",
      "watch_level": "mentions_only",
      "event": {
        "assigned_to_actor": true
      },
      "expected": {
        "deliver": true,
        "blind_wakeup": false,
        "reason_code": "watch_allows",
        "client_projection": {
          "should_notify": true,
          "watch_suppressed": false,
