      "vector_id": "ak.vector.push.broadcast_mention_controls.v1",
      "watch_level": "mentions_only",
      "event": {
        "mentions_actor": true
      },
      "expected": {
        "deliver": true,
        "blind_wakeup": false,
        "reason_code": "watch_allows",
        "client_projection": {
          "should_notify": true,
          "watch_suppressed": false,
          "muted_short_circuit": false,
          "blind_wakeup_required": false,
          "unresolved_client_evaluation": false
        }
      },
      "assertions": [
        "authorized broadcast mentions deliver under mentions_only watch level",
        "plain directed mentions do not require blind wakeup after local evaluation",
        "shared core reason_code remains watch_allows"
      ]
    },
