{
  "suite": "scalability_limits",
  "version": "2026-09-22.1",
  "profile": "ak.profile.core_event_store.v1",
  "runner": {
    "kind": "generated_limit_cases",
    "canonicalization": "fixture_json_v1",
    "must_not_allocate_declared_cardinality": true
  },
  "covers_vectors": [
    "ak.vector.scalability.refs_limit.v1",
    "ak.vector.scalability.relation_expansion_depth.v1",
    "ak.vector.scalability.event_ref_role_limits.v1",
    "ak.vector.scalability.circle_count_limit.v1",
    "ak.vector.scalability.envelope_size_limit.v1",
    "ak.vector.scalability.operation_body_size_limit.v1",
    "ak.vector.scalability.snapshot_inline_capacity.v1",
    "ak.vector.scalability.http_body_preparse_limit.v1",
    "ak.vector.scalability.content_encoding_forbidden.v1",
    "ak.vector.scalability.batch_page_byte_count.v1",
    "ak.vector.scalability.read_unsigned_size_limit.v1",
    "ak.vector.scalability.http_header_limits.v1",
    "ak.vector.scalability.batch_page_limits.v1",
    "ak.vector.scalability.object_control_limits.v1",
    "ak.vector.scalability.capability_limits.v1",
    "ak.vector.scalability.cursor_selector_limits.v1",
    "ak.vector.patch.path_grammar_bounds.v1"
  ],
  "cases": [
    {
      "name": "request_batch_count_and_bytes_are_conjunctive",
      "vector_id": "ak.vector.scalability.batch_page_byte_count.v1",
      "input": {
        "generator": {
          "kind": "operation_batch_matrix",
          "operation_id": "ak.self.events.command.submit.v1",
          "cases": [
            {
              "count": 1000,
              "canonical_body_bytes": 8388608
            },
            {
              "count": 1000,
              "canonical_body_bytes": 8388609
            },
            {
              "count": 1001,
              "canonical_body_bytes": 1048576
            }
          ]
        }
      },
      "expected": {
        "count_and_bytes_both_required": true,
        "count_at_limit_and_bytes_at_limit": "accept_when_items_are_individually_valid",
        "byte_overflow_error_code": "payload_too_large",
        "count_overflow_error_code": "schema_violation",
        "partial_accept_forbidden": true
      }
    },
    {
      "name": "snapshot_capacity_accepts_exact_eight_mib_maximal_projection",
      "vector_id": "ak.vector.scalability.snapshot_inline_capacity.v1",
      "given_state": {
        "generator": {
          "kind": "realm_snapshot_maximal_disclosure_projection",
          "canonical_signed_body_bytes_after_candidate_commit": 8388608
        }
      },
      "expected": {
        "decision": "accept_when_all_other_admission_checks_pass",
        "measurement": "RFC8785 canonical bytes of the complete signed body",
        "paging_or_truncation_used": false
      }
    },
    {
      "name": "snapshot_capacity_rejects_candidate_commit_over_eight_mib",
      "vector_id": "ak.vector.scalability.snapshot_inline_capacity.v1",
      "given_state": {
        "generator": {
          "kind": "realm_snapshot_maximal_disclosure_projection",
          "canonical_signed_body_bytes_after_candidate_commit": 8388609
        }
      },
      "expected": {
        "decision": "reject",
        "error_code": "failed_precondition",
        "reason_code": "snapshot_capacity_exceeded",
        "state_unchanged": true,
        "partial_snapshot_or_hidden_overflow": false
      }
    },
    {
      "name": "snapshot_capacity_concurrent_candidates_share_one_admission_boundary",
      "vector_id": "ak.vector.scalability.snapshot_inline_capacity.v1",
      "given_state": {
        "generator": {
          "kind": "concurrent_realm_snapshot_capacity_candidates",
          "each_candidate_individually_fits_old_cut": true,
          "combined_canonical_signed_body_bytes": 8388609
        }
      },
      "expected": {
        "accepted_winners": 1,
        "loser_rechecks_current_cut": true,
        "loser_error_code": "failed_precondition",
        "loser_reason_code": "snapshot_capacity_exceeded",
        "final_state_within_limit": true
      }
    },
    {
      "name": "reject_realm_active_circle_count_over_limit",
      "vector_id": "ak.vector.scalability.circle_count_limit.v1",
      "given_state": {
        "generator": {
          "kind": "active_circle_count",
          "realm_active_circle_count": 1000
        }
      },
      "input": {
        "event_kind": "ak.circle.create",
        "circle_visibility": "realm_visible"
      },
      "expected": {
        "decision": "reject",
        "error_code": "failed_precondition",
        "reason_code": "circle_count_exceeded",
        "limit": "active circles per Realm <= 1000",
        "state_unchanged": true
      }
    },
    {
      "name": "reject_actor_mls_circle_count_over_limit",
      "vector_id": "ak.vector.scalability.circle_count_limit.v1",
      "given_state": {
        "generator": {
          "kind": "actor_active_mls_circle_memberships",
          "count": 256
        }
      },
      "input": {
        "event_kind": "ak.circle.member.state",
        "target_actor_id": {
          "kind": "service",
          "service_id": "ak:did_core:webvh:z6mkfixture"
        },
        "target_circle_encryption_mode": "mls"
      },
      "expected": {
        "decision": "reject",
        "error_code": "failed_precondition",
        "reason_code": "circle_count_exceeded",
        "limit": "active MLS-backed Circle memberships per actor <= 256",
        "state_unchanged": true
      }
    },
    {
      "name": "reject_realm_active_circle_count_at_limit",
      "vector_id": "ak.vector.scalability.circle_count_limit.v1",
      "given_state": {
        "generator": {
          "kind": "active_circle_count_by_composition",
          "count_composition": {
            "ordinary_active_circles": 1000
          },
          "counting_rule": "The realm's active-Circle count MUST be materialized by building 1000 ordinary Circles, NOT from a pre-summed scalar. Agent Sidecars are not Circle objects and do not consume this limit. A conforming reducer counts 1000 and rejects the next ak.circle.create."
        }
      },
      "input": {
        "event_kind": "ak.circle.create",
        "circle_visibility": "realm_visible"
      },
      "expected": {
        "decision": "reject",
        "error_code": "failed_precondition",
        "reason_code": "circle_count_exceeded",
        "limit": "active circles per Realm <= 1000",
        "state_unchanged": true
      }
    },
    {
      "name": "reject_actor_mls_circle_count_at_limit",
      "vector_id": "ak.vector.scalability.circle_count_limit.v1",
      "given_state": {
        "generator": {
          "kind": "actor_active_mls_circle_memberships_by_composition",
          "count_composition": {
            "ordinary_mls_circle_memberships": 256
          },
          "counting_rule": "The actor's MLS-backed Circle-membership count MUST be materialized as 256 ordinary MLS Circle memberships, NOT from a pre-summed scalar. Agent Sidecar participation is ownership-derived and is not Circle membership. A conforming reducer rejects the next Circle membership."
        }
      },
      "input": {
        "event_kind": "ak.circle.member.state",
        "target_actor_id": {
          "kind": "service",
          "service_id": "ak:did_core:webvh:z6mkfixture"
        },
        "target_circle_encryption_mode": "mls"
      },
      "expected": {
        "decision": "reject",
        "error_code": "failed_precondition",
        "reason_code": "circle_count_exceeded",
        "limit": "active MLS-backed Circle memberships per actor <= 256",
        "state_unchanged": true
      }
    },
    {
      "name": "reject_self_events_batch_over_limit",
      "vector_id": "ak.vector.scalability.batch_page_limits.v1",
      "input": {
        "generator": {
          "kind": "operation_batch_items",
          "operation_id": "ak.self.events.command.submit.v1",
          "count": 1001
        }
      },
      "expected": {
        "decision": "reject",
        "error_code": "schema_violation",
        "must_not_partially_accept": true
      }
    }
  ]
}
