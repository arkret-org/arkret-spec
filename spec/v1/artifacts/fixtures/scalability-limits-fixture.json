      "name": "reject_refs_over_limit",
      "vector_id": "ak.vector.scalability.refs_limit.v1",
      "given_state": {
        "base_event_kind": "ak.message.create"
      },
      "input": {
        "generator": {
          "kind": "event_refs",
          "count": 129,
          "unique": true,
          "role_cycle": [
            "authorized_by",
            "attestation",
            "parent_event",
            "after"
          ]
        }
      },
      "expected": {
        "decision": "reject",
        "error_code": "schema_violation",
        "reason_code": "refs_too_large",
        "limit": "refs <= 128",
        "must_not_enter_reducer": true
      }
    },
