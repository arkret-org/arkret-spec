{
  "version": "2026-08-07",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.encoding.content_bound_event_id.v1"
  },
  "covers_vectors": [
    "ak.vector.event_id.content_bound.v1",
    "ak.vector.object_identity.event_derived.v1",
    "ak.vector.object_identity.subject_derived_realm.v1"
  ],
  "description": "Known-answer vectors for the content-bound event_id layout (zh/conformance/encoding.md section 4.0) and for object ids derived from it (zh/models/common-fields.md section 6.0).",
  "cases": [
    {
      "name": "principal_control_realm_id_is_subject_derived_uuidv7",
      "vector_id": "ak.vector.object_identity.subject_derived_realm.v1",
      "principal_id": "did:webvh:z6mkfixture:alice.example",
      "domain_utf8_hex": "616b3a7265616c6d3a7072696e636970616c2d636f6e74726f6c3a76313a",
      "sha256_digest": "984ba56e2ecf486cfbe0cab2c7a30677848ab632b02dcd0ed4f2bf01bdba5712",
      "derived_realm_id": "ak:realm:984ba56e-2ecf-786c-bbe0-cab2c7a30677",
      "layout": {
        "hash_octets": "digest[0..16]",
        "version": 7,
        "variant_bits": "10",
        "producer_selected_bits": 0
      },
      "expected": {
        "outcome": "accepted",
        "realm_id_source": "subject_derived_from_canonical_principal_did",
        "different_principal_same_realm_id": "rejected",
        "same_principal_second_genesis": "rejected"
      }
    },
    {
      "name": "realm_genesis_id_is_derived_and_self_certifying",
      "vector_id": "ak.vector.object_identity.event_derived.v1",
      "digest_preimage_canonical_bytes_utf8": "{\"actor_id\":\"did:webvh:z6mkfixture:alice.example\",\"actor_seq\":0,\"created_at\":\"2026-08-06T00:00:00.000Z\",\"kind\":\"ak.realm.create\",\"payload\":{\"object\":{\"capability_action_registry_digest\":\"sha256:9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a\",\"created_at\":\"2026-08-06T00:00:00.000Z\",\"created_by\":\"did:webvh:z6mkfixture:alice.example\",\"default_discoverability\":\"invite_only\",\"default_join_rule\":\"invite\",\"encryption_profile\":\"mls_rfc9420\",\"fields\":{},\"history_visibility\":\"joined\",\"notary\":{\"did\":\"did:webvh:z6mkfixture:alice.example\",\"kind\":\"single_did\",\"recovery_members\":[\"did:webvh:z6mkfixture:alice-recovery.example\"]},\"notary_profile\":\"single_did\",\"reducer_profile\":\"ak.reducer.core.v1\",\"schema\":\"ak.schema.realm.v1\",\"schema_refs\":[\"ak.schema.realm.v1\"],\"title\":\"Vector Realm\",\"trust_domain\":\"ak:trust_domain:did.webvh.alice.example\"}},\"prev_refs\":[],\"refs\":[],\"scope_ref\":{\"kind\":\"realm_genesis\"}}",
      "event_digest": "sha256:d70f9ff68130d98c0b8edfb05e4d6c9928e51cc944c4df97b1d7254471eb8355",
      "derived_event_id": "ak:event:1a9cf3a0-35c3-8e7f-b681-30d98c0b8edf",
      "derived_realm_id": "ak:realm:1a9cf3a0-35c3-8e7f-b681-30d98c0b8edf",
      "envelope_omits": [
        "event_id",
        "realm_id"
      ],
      "scope_ref": {
        "kind": "realm_genesis"
      },
      "expected": {
        "outcome": "accepted",
        "realm_id_source": "derived_from_event_id"
      }
    },
    {
      "name": "strand_object_id_is_retyped_event_id",
      "vector_id": "ak.vector.object_identity.event_derived.v1",
      "digest_preimage_canonical_bytes_utf8": "{\"actor_id\":\"did:webvh:z6mkfixture:alice.example\",\"actor_seq\":1,\"created_at\":\"2026-08-06T00:00:00.000Z\",\"kind\":\"ak.strand.create\",\"payload\":{\"object\":{\"created_at\":\"2026-08-06T00:00:00.000Z\",\"created_by\":\"did:webvh:z6mkfixture:alice.example\",\"realm_id\":\"ak:realm:1a9cf3a0-35c3-8e7f-b681-30d98c0b8edf\",\"schema\":\"ak.schema.strand.v1\",\"tracks\":{\"discussion\":{\"enabled\":true,\"name\":\"discussion\"}}}},\"prev_refs\":[],\"realm_id\":\"ak:realm:1a9cf3a0-35c3-8e7f-b681-30d98c0b8edf\",\"refs\":[],\"scope_ref\":{\"kind\":\"realm\",\"realm_id\":\"ak:realm:1a9cf3a0-35c3-8e7f-b681-30d98c0b8edf\"}}",
      "event_digest": "sha256:490efe75d7a3e5a4ff17eaacd5538c244228b2bf76f2d6c40bb81ef40b4059d5",
      "derived_event_id": "ak:event:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
      "derived_object_id": "ak:strand:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
      "expected": {
        "outcome": "accepted",
        "object_id_source": "retype(event_id)"
      }
    },
    {
      "name": "one_event_derives_distinct_report_and_queue_item_typed_ids",
      "vector_id": "ak.vector.object_identity.event_derived.v1",
      "event_kind": "ak.self.moderation.report",
      "derived_event_id": "ak:event:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
      "derived_object_ids": [
        "ak:report:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
        "ak:moderation_queue_item:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea"
      ],
      "identity_key": "full_typed_id",
      "expected": {
        "outcome": "accepted",
        "all_uuid_payloads_equal_event_id": true,
        "full_typed_ids_unique": true,
        "maximum_objects_per_typed_kind": 1
      }
    },
    {
      "name": "closed_single_genesis_kinds_retype_the_event_id",
      "vector_id": "ak.vector.object_identity.event_derived.v1",
      "derived_event_id": "ak:event:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
      "event_kind_to_object_id": {
        "ak.moderation.appeal.submit": "ak:appeal:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
        "ak.audit.session.request": "ak:audit_session:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
        "ak.audit.release": "ak:audit_release:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
        "ak.invite.create": "ak:invite:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea",
        "ak.invite.third_party": "ak:invite:1a9cf3a0-1243-8bf9-b5d7-a3e5a4ff17ea"
      },
      "expected": {
        "outcome": "accepted",
        "all_object_ids_equal_retype_event_id": true
      }
    },
    {
      "name": "create_payload_carrying_object_id_rejected",
      "vector_id": "ak.vector.object_identity.event_derived.v1",
      "mutation": "add payload.object.id",
      "expected": {
        "outcome": "rejected",
        "error": "schema_violation",
        "reason_code": "object_id_not_event_derived"
      }
    },
    {
      "name": "realm_genesis_carrying_realm_id_rejected",
      "vector_id": "ak.vector.object_identity.event_derived.v1",
      "mutation": "add envelope.realm_id to ak.realm.create",
      "expected": {
        "outcome": "rejected",
        "error": "schema_violation",
        "reason_code": "realm_id_not_event_derived"
      }
    },
    {
      "name": "carried_event_id_not_matching_recomputation_rejected",
      "vector_id": "ak.vector.event_id.content_bound.v1",
      "mutation": "flip one hex digit of the carried event_id",
      "expected": {
        "outcome": "rejected",
        "error": "schema_violation",
        "reason_code": "event_id_digest_mismatch",
        "must_not_be_used_before_comparison": [
          "deduplication",
          "indexing",
          "routing",
          "idempotency",
          "authorization"
        ]
      }
    },
    {
      "name": "timestamp_segment_must_equal_created_at_seconds",
      "vector_id": "ak.vector.event_id.content_bound.v1",
      "mutation": "advance the 34-bit timestamp segment by one second",
      "expected": {
        "outcome": "rejected",
        "error": "schema_violation",
        "reason_code": "event_id_digest_mismatch"
      }
    },
    {
      "name": "version_and_variant_nibbles_are_fixed",
      "vector_id": "ak.vector.event_id.content_bound.v1",
      "mutation": "set the version nibble to 7",
      "expected": {
        "outcome": "rejected",
        "error": "schema_violation"
      }
    }
  ]
}
