            "source_sender_routing_mismatch",
            "expired_envelope",
            "mls_state_not_current_winner"
          ]
        }
      },
      "expected": {
        "request_failure_signals_dispatched": 0,
        "item_failure_response": {
          "accepted": true
        },
        "item_failure_signals_dispatched": 0,
        "per_item_results_exposed": false
      }
    },
    {
      "name": "recipient_exact_account_and_mls_binding",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_role_admission_mutations",
          "role": "recipient",
          "mutations": [
            "same_principal_device_other_station",
            "missing_current_device_trust",
            "expired_device_attestation",
            "device_generation_mismatch",
            "agent_key_authorize_event_mismatch",
            "leaf_signature_key_mismatch",
            "scope_group_mismatch",
