          ]
        }
      },
      "expected": {
        "decision": "drop_before_outbound_dispatch",
        "signals_dispatched": 0
      }
    },
    {
      "name": "peer_schema_and_item_failure_boundary",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_role_admission_mutations",
          "role": "destination",
          "request_rejections": [
            "missing_proof",
            "proof_schema_shape_invalid",
            "cross_realm_batch",
            "invalid_peer_signature"
