{
  "suite": "signal_peer_relay",
  "version": "2026-09-25",
  "profile": "ak.profile.signal_peer_relay.v1",
  "runner": {
    "kind": "generated_limit_cases",
    "canonicalization": "fixture_json_v1",
    "must_not_allocate_declared_cardinality": true
  },
  "covers_vectors": [
    "ak.vector.signal.peer_relay.v1",
    "ak.vector.signal.device_authorization_domain.v1"
  ],
  "source_refs": [
    "spec/v1/zh/sync/signal.md",
    "spec/v1/zh/sync/federation.md",
    "spec/v1/artifacts/schemas/signal-relay.schema.json",
    "spec/v1/artifacts/schemas/signal-envelope.schema.json",
    "spec/v1/artifacts/registry/operation-registry.json"
  ],
  "cases": [
    {
      "name": "accept_single_hop_encrypted_signal",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_request",
          "signal_count": 1,
          "canonical_body_bytes": 4096,
          "same_realm": true,
          "source_hosts_sender": true,
          "destination_hosts_eligible_member": true,
          "producer_proof_valid": true,
          "signal_encrypted": true,
          "hop_count": 1,
          "signature_window_ms": 5000
        }
      },
      "expected": {
        "decision": "accept",
        "response": {
          "accepted": true
        },
        "durable_event_written": false,
        "realm_stream_head_advanced": false,
        "envelope_rewritten": false
      }
    },
    {
      "name": "opaque_success_hides_recipient_existence",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_equivalence_pair",
          "variants": [
            "eligible_local_recipient",
            "no_eligible_local_recipient",
            "unknown_realm_or_scope",
            "unknown_sender",
            "invalid_proof_transcript_digest",
            "source_not_current_member_account_host",
            "signal_class_action_denied",
            "expired_or_duplicate_signal"
          ],
          "authenticated_request": true,
          "schema_valid": true
        }
      },
      "expected": {
        "decision": "accept_all_requests_and_silently_drop_ineligible_items",
        "responses_byte_identical": true,
        "response": {
          "accepted": true
        },
        "forbidden_response_fields": [
          "accepted_count",
          "rejected_count",
          "results",
          "recipient_count",
          "reason_code"
        ]
      }
    },
    {
      "name": "reject_cross_realm_batch",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_request",
          "signal_count": 2,
          "same_realm": false
        }
      },
      "expected": {
        "decision": "reject_request",
        "error_code": "schema_violation",
        "signals_dispatched": 0
      }
    },
    {
      "name": "silently_drop_second_peer_hop",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_request",
          "signal_count": 1,
          "hop_count": 2
        }
      },
      "expected": {
        "decision": "silently_drop_item",
        "response": {
          "accepted": true
        },
        "signals_dispatched": 0
      }
    },
    {
      "name": "reject_batch_count_and_body_overflow",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_limit_matrix",
          "dimensions": [
            {
              "field": "signals",
              "limit": 128,
              "values": [
                127,
                128,
                129
              ],
              "over_error_code": "schema_violation"
            },
            {
              "field": "canonical_body_bytes",
              "limit": 1048576,
              "values": [
                1048575,
                1048576,
                1048577
              ],
              "over_error_code": "payload_too_large"
            },
            {
              "field": "signature_window_ms",
              "limit": 5000,
              "values": [
                4999,
                5000,
                5001
              ],
              "over_error_code": "capability_denied"
            }
          ]
        }
      },
      "expected": {
        "at_or_below_limit": "accept_when_all_other_checks_pass",
        "over_limit": "reject_before_dispatch",
        "partial_accept_forbidden": true
      }
    },
    {
      "name": "uncertain_outcome_is_dropped",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_uncertain_outcome",
          "response_lost": true,
          "idempotency_key_present": false
        }
      },
      "expected": {
        "automatic_request_retry": false,
        "strategy": "drop_unconfirmed",
        "recovery": "next_self_contained_signal_or_product_timeout",
        "durable_retry_queue_created": false
      }
    },
    {
      "name": "reject_idempotency_key_and_envelope_rewrite",
      "vector_id": "ak.vector.signal.peer_relay.v1",
      "input": {
        "generator": {
          "kind": "signal_peer_relay_mutations",
          "mutations": [
            "idempotency_key_header_present",
            "source_changes_expires_at",
            "destination_re_signs_producer_envelope",
            "destination_decrypts_and_re_encrypts",
            "source_or_destination_changes_ciphertext"
          ]
        }
      },
      "expected": {
        "decision": "reject",
        "signals_dispatched": 0,
        "producer_envelope_identity_preserved": true
      }
    },
    {
      "name": "device_authorization_domain",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "assertions": [
        "commit_ref selects Realm and scope authorization only; source and recipient authenticate current exact-account device authority independently",
        "the verification_method bare DID projects to the signing principal component of sender_actor_id and its fragment equals sender_device_id; current authorization independently binds the complete ActorId including Station",
        "missing current directory key or trust anchor fails closed at source and recipient, not at a destination performing only authenticated peer and outer-envelope admission",
        "destination must not query a remote device directory, use a same-principal local account, verify producer signatures, replay remote PCR, or maintain an MLS public tree as a relay prerequisite",
        "currently revoked or fenced devices are rejected by source and recipient even if active at commit_ref and the MLS leaf has not yet been removed",
        "recipient requires current exact-account device key and authorization Event to match the active MLS leaf transition binding; successful AEAD does not establish sender identity",
        "queued source dispatch revalidates current device authority, membership, scope, class action, TTL and MLS outer basis",
        "Agent uses the absent-sender_device_id branch only after accepted Agent classification and current key/lifecycle/controller authority verification",
        "Agent sequence high-water is keyed by the verified raw signing-key digest; same-key reauthorization continues the sequence while an accepted new-key runtime replacement starts a new domain"
      ]
    },
    {
      "name": "agent_sender_branch",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_agent_sender_admission",
          "sender_device_id_present": false,
          "accepted_agent_classification": true,
          "current_agent_key": true,
          "lifecycle_active": true,
          "controller_account_active": true,
          "controller_membership_generation_current": true,
          "unique_active_leaf": true,
          "leaf_actor_method_key_authorization_match": true
        }
      },
      "expected": {
        "source_decision": "accept",
        "recipient_decision": "accept_after_aead_and_product_checks"
      }
    },
    {
      "name": "agent_sender_branch_mutations",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_agent_sender_mutations",
          "mutations": [
            "ordinary_account_without_sender_device_id",
            "agent_with_sender_device_id",
            "agent_with_controller_device_id",
            "agent_key_revoked_or_superseded",
            "agent_lifecycle_paused_or_deactivated",
            "controller_membership_generation_ended",
            "same_principal_other_station",
            "stale_agent_leaf",
            "concurrent_different_agent_keys",
            "pairwise_actor_without_sender_device_id"
          ]
        }
      },
      "expected": {
        "source_decision": "reject",
        "recipient_decision": "reject_before_display_or_high_water",
        "destination_does_not_resolve_remote_agent_authority": true
      }
    },
    {
      "name": "destination_without_remote_directory_relays",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_role_admission",
          "role": "destination",
          "peer_auth_valid": true,
          "source_hosts_sender": true,
          "outer_admission_valid": true,
          "remote_device_directory_present": false,
          "local_same_principal_device_other_station_present": true,
          "eligible_local_recipient": true
        }
      },
      "expected": {
        "decision": "relay_unchanged",
        "remote_directory_queries": 0,
        "producer_signature_verifications": 0,
        "response": {
          "accepted": true
        }
      }
    },
    {
      "name": "forged_signature_requires_recipient_authentication",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_role_admission",
          "peer_auth_valid": true,
          "source_hosts_sender": true,
          "outer_admission_valid": true,
          "producer_signature_well_formed": true,
          "producer_signature_valid": false,
          "aead_valid": true
        }
      },
      "expected": {
        "honest_source_decision": "reject",
        "malicious_source_destination_decision": "relay_unchanged",
        "recipient_decision": "reject_before_display_or_effects",
        "recipient_high_water_advanced": false
      }
    },
    {
      "name": "revoked_device_with_unremoved_leaf",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_role_admission",
          "known_device_revoked": true,
          "leaf_still_active": true,
          "producer_signature_valid": true,
          "aead_valid": true,
          "ttl_valid": true
        }
      },
      "expected": {
        "source_decision": "reject",
        "recipient_decision": "reject_before_display_or_effects",
        "recipient_high_water_advanced": false
      }
    },
    {
      "name": "source_revalidates_queued_authority",
      "vector_id": "ak.vector.signal.device_authorization_domain.v1",
      "input": {
        "generator": {
          "kind": "signal_role_admission_mutations",
          "role": "source",
          "local_ingress_passed": true,
          "changes_before_dispatch": [
