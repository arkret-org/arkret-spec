    {
      "name": "cas_mixed_basis",
      "description": "cas_register writes on a non-initial settled value require an explicit CBA basis; null-basis blind overwrites fail closed.",
      "cell": "ck:cell:ck.component.strand.title.v1:ck.strand.019641c6-8000-7000-8000-000000000001",
      "cell_lattice": {
        "plane": "control",
        "lattice": "cas_register",
        "initial_value": null,
        "bottom": "reject"
      },
      "pre_state": {
        "settled_value": "v1",
        "settled_by_seal": "ck:seal:sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "cases": [
        {
          "name": "blind_write_without_basis",
          "event": {
            "id": "ck:event:019641c6-8000-7000-8000-000000000101",
            "plane": "data",
            "seal_ref": "ck:seal:sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "effects": [
              {
                "cell": "ck:cell:ck.component.strand.title.v1:ck.strand.019641c6-8000-7000-8000-000000000001",
                "op": {
                  "kind": "set",
                  "value": "v2"
                }
              }
            ],
            "basis": null
          },
          "expected": {
            "result": "failed_precondition",
            "cell_value": "v1",
            "atomic_rejects_all_effects": true,
            "defensive_join_result": "bottom"
          }
        },
        {
          "name": "control_move_with_head_eq_basis",
          "control_move": {
            "id": "ck:event:019641c6-8000-7000-8000-000000000102",
            "plane": "control",
            "preconditions": [
              {
                "cell": "ck:cell:ck.component.strand.title.v1:ck.strand.019641c6-8000-7000-8000-000000000001",
                "predicate": {
                  "op": "head_eq",
                  "value": "v1"
                }
              }
            ],
            "effects": [
              {
                "cell": "ck:cell:ck.component.strand.title.v1:ck.strand.019641c6-8000-7000-8000-000000000001",
                "op": {
                  "kind": "set",
                  "value": "v2"
                }
              }
            ]
          },
          "expected": {
            "result": "accept_after_valid_seal",
            "cell_value": "v2",
            "replay_order_independent": true
          }
        }
      ],
      "vector_id": "ck.vector.cba_lattice.cas_mixed_basis.v1"
    },
