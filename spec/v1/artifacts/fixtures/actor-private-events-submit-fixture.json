        "/cases/1/variants/0",
        "/cases/2/variants/0"
      ],
      "reject": [
        "/cases/0/variants/2",
        "/cases/1/variants/2",
        "/cases/1/variants/3",
        "/cases/1/variants/9",
        "/cases/2/variants/2",
        "/cases/2/variants/3"
