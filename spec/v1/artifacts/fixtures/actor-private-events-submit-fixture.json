        "/cases/0/variants/0",
        "/cases/1/variants/0",
        "/cases/1/variants/6",
        "/cases/2/variants/0"
      ],
      "reject": [
        "/cases/5/variants/0"
      ]
    },
    {
      "id": "exact_retry_first_outcome",
      "requirement": "The same canonical Event bytes return the first stored outcome without a second write, even after a later write moved the register.",
      "accept": [
        "/cases/0/variants/1",
        "/cases/0/variants/6",
        "/cases/1/variants/1",
        "/cases/1/variants/7",
        "/cases/2/variants/1"
