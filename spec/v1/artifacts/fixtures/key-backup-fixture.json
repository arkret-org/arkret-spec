{
  "suite": "key_backup_schema_validation",
  "fixture_kind": "schema_only",
  "profile": "ak.profile.key_backup.memory_hard.v1",
  "version": "2026-09-11.1",
  "description": "Schema-only positive and negative wire-form validation cases for key backup and recovery contracts. Placeholder nonce/ciphertext/signature values are intentional and MUST NOT be treated as cryptographic conformance vectors. Covers ak.schema.key_backup.v1 series chain rules (genesis vs successor), passphrase_kdf nonce_salt, Argon2id memory-hard floor, PBKDF2 degraded-profile requirement, mixed_secret_storage policy gate, Agent PCR binding across public/plaintext/AAD views, derived whole-object signature projections, and minimal ak.schema.recovery_policy.v1 / ak.schema.recovery_receipt.v1 binding cases including the closed four-method union and rejection of the removed threshold_recovery method. Per identity/key-management.md §7.5.6 / §7.6 / §8, identity/security-transactions.md §2, and crypto-media/device-lifecycle.md §12 / §14. Lint runs tools/artifact_lint against schema_validation_cases[]. Real AEAD/HPKE/signature transcript vectors belong in a separate crypto fixture with reproducible key material and canonical bytes.",
  "runner": {
    "kind": "json_schema_validation_cases",
    "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
    "assertion_fields": [
      "schema_ref",
      "expect_valid",
      "instance"
    ]
  },
