            "service_acceptance_ref": "cx:event:7d000002-0000-7000-8000-000000000000"
          }
        }
      },
      "expected": {
        "outcome": "rejected",
        "reason_code": "delivery_binding_policy_mismatch",
        "must_not_try_next_binding_source": true
      }
    }
  ]
}
