    {
      "vector_id": "ak.vector.device.account_device_signer_evidence.v1",
      "name": "account_device_evidence_exact_closure",
      "evidence_schema": "account-device-signer-evidence.schema.json",
      "root_members": [
        "device_projection_attestation",
        "service_resolution"
      ],
      "content_address_rule": "signer evidence ref equals lowercase SHA-256 of RFC 8785 JCS complete root, with registered signer-evidence prefix",
      "positive": [
        "exact current accepted device authorization and generation are read at one durable cut with the authorization Event and covering RealmCommit",
        "the origin persists the complete root and its content ref before returning a peer or self row",
        "the Service resolution method-native history verifies the attestation assertion method at attested_at",
        "the Event producer verified with this evidence binds exact AccountId, device, method, authorization instance, generation and authorization_window, whether the evidence is read for a historical response or carried as authority_forward producer_device_evidence"
      ],
      "negative": [
        "attestation signed by a Service other than account_id.station_id",
        "Service history omits or supersedes the asserted method at attested_at",
        "outer account or device differs from the signed attestation",
        "attested_at outside original authorization_window",
        "signer_evidence_ref hashes only the attestation or the pruned self projection",
        "authorization Event lacks an accepted covering RealmCommit"
      ],
      "expected": "no usable row and no accepted producer_device_evidence for any negative case; no synthetic evidence ref"
    },
