    "cx.vector.directory.organization_badge_verification.v1",
    "cx.vector.directory.pairwise_did_exclusion.v1",
    "cx.vector.directory.stale_result_rejection.v1",
    "cx.vector.directory.result_common_fields.v1",
    "cx.vector.directory.announce_bidirectional_opt_in.v1",
    "cx.vector.directory.announce_directory_not_authorized.v1",
    "cx.vector.directory.announce_bad_signature.v1",
    "cx.vector.directory.announce_signature_stale.v1",
    "cx.vector.directory.policy_revision_rollback.v1",
    "cx.vector.directory.accept_policy_denied.v1",
    "cx.vector.directory.reannounce_idempotent_ttl.v1",
    "cx.vector.directory.pull_mode_refresh_verification.v1",
    "cx.vector.directory.ttl_expiry_removal.v1",
    "cx.vector.directory.withdraw_blinded_not_found.v1",
    "cx.vector.directory.operator_takedown_audit.v1",
    "cx.vector.directory.takedown_reannounce_rejected.v1",
    "cx.vector.psi.oprf_two_round_shape.v1",
