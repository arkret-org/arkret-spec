    {
      "vector_id": "ck.vector.directory.invite_not_found_blinding.v1",
      "name": "hidden_realm_resolve_indistinguishable",
      "operation_id": "ck.find.directory.query.resolve_realm",
      "inputs": [
        {
          "label": "missing",
          "body": {
            "realm_id": "ck:realm:019640a5-0000-7000-8000-000000000000",
            "requester": "did:web:mallory.example"
          }
        },
        {
          "label": "hidden",
          "body": {
            "realm_id": "ck:realm:019640b5-8000-7000-8000-000000000000",
            "requester": "did:web:mallory.example"
          }
        },
        {
          "label": "invite_only_without_proof",
          "body": {
            "realm_id": "ck:realm:019640c6-0000-7000-8000-000000000000",
            "requester": "did:web:mallory.example"
          }
        }
      ],
      "expected": {
        "same_http_status": 404,
        "same_error_code": "not_found",
        "same_body_shape": [
          "ok",
          "error.code",
          "request_id"
        ],
        "same_timing_class": "privacy_not_found",
        "must_not_include": [
          "realm_id",
          "title",
          "join_rule",
          "discoverability",
          "member_count",
          "service_endpoints"
        ]
      }
    },
