    {
      "name": "plaintext_visible_service_required_for_private_body_processing",
      "operation_id": "ck.self.events.command.submit",
      "input": {
        "service_did": "did:web:search.example",
        "event_kind": "ck.message.create",
        "content_class": "private_plaintext",
        "realm_policy": {
          "plaintext_visible_services": [
            {
              "service_did": "did:web:principal.example",
              "service_type": "principal_server",
              "data_classes": [
                "message_content"
              ],
              "purposes": [
                "events",
                "sync"
              ],
              "visibility": "private_plaintext"
            }
          ]
        }
      },
      "expected": {
        "decision": "deny",
        "error_code": "capability_denied",
        "reason_code": "service_not_plaintext_visible",
        "must_not_forward_plaintext": true
      }
