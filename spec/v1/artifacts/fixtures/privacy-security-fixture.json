{
  "suite": "privacy_security",
  "profile": "cx.profile.privacy_security_vectors.v1",
  "version": "2026-05-02",
  "conformance_vectors": [
    "cx.vector.directory.public_realm_search.v1",
    "cx.vector.directory.organization_search.v1",
