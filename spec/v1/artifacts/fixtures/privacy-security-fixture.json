          }
        },
        {
          "name": "all_grants_active_accepts_exact_signed_value",
          "event_kind": "ak.profile.update",
          "accountable_principal_ids": [
            "ak:did_core:webvh:z6mkfixtureorganizationexample"
          ],
          "matching_active_grants": [
            "ak:did_core:webvh:z6mkfixtureorganizationexample"
          ],
          "expected": {
            "decision": "accept",
            "stored_accountable_principal_ids_equal_signed_payload": true
          }
        },
        {
          "name": "later_revoke_marks_existing_projection_unverified",
          "profile_write_was_valid_when_accepted": true,
          "grant_status_after_acceptance": "revoked",
          "expected": {
            "profile_event_remains_in_log": true,
            "projection_trust_state": "unverified",
            "next_profile_update_with_revoked_entry": "accountability_grant_missing"
          }
        }
      ],
      "assertions": [
        "missing accountability grant rejects the entire profile Event on every conformant verifier",
        "reducer never accepts a field-stripped Actor Profile value",
        "accepted typed current result value preserves the signed payload exactly",
        "unverified presentation state applies only after a previously valid grant expires or is revoked"
      ]
    },
