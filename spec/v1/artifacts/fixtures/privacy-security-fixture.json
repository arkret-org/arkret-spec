    "cx.vector.psi.no_reachability_metadata.v1",
    "cx.vector.psi.quota_blinded_denial.v1"
  ],
  "cases": [
    {
      "vector_id": "cx.vector.directory.invite_not_found_blinding.v1",
      "name": "hidden_realm_resolve_indistinguishable",
      "operation_id": "cx.directory.resolve_realm",
      "inputs": [
        {
          "label": "missing",
          "body": {
            "realm_id": "ck:realm:019640a5-0000-7000-8000-000000000000",
            "requester": "did:web:mallory.example"
          }
        },
        {
          "label": "hidden",
          "body": {
            "realm_id": "ck:realm:019640b5-8000-7000-8000-000000000000",
            "requester": "did:web:mallory.example"
          }
        },
        {
          "label": "invite_only_without_proof",
          "body": {
            "realm_id": "ck:realm:019640c6-0000-7000-8000-000000000000",
            "requester": "did:web:mallory.example"
          }
        }
      ],
      "expected": {
        "same_http_status": 404,
        "same_error_code": "not_found",
        "same_body_shape": [
          "ok",
          "error.code",
          "request_id"
        ],
        "same_timing_class": "privacy_not_found",
        "must_not_include": [
          "realm_id",
          "title",
          "join_rule",
          "discoverability",
          "member_count",
          "service_endpoints"
        ]
      }
    },
    {
      "vector_id": "cx.vector.psi.padding_and_cardinality.v1",
      "name": "private_contact_discovery_padding_and_cardinality",
      "operation_id": "cx.directory.private_contact_discovery",
      "input": {
        "requester": "did:web:alice.example",
        "contacts": [
          {
            "blinded_identifier": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          {
            "blinded_identifier": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        ],
        "padding": {
          "target_batch_size": 128,
          "dummy_count": 126
        }
      },
      "expected": {
        "result_count_does_not_reveal_match_count": true,
        "no_raw_connection_identifier": true,
        "proofs_are_time_bound": true,
        "same_error_class_for_policy_denied_and_no_match": true
      }
    },
    {
      "name": "directory_query_and_ingest_vector_closure",
      "operation_ids": [
        "cx.directory.search_realms",
        "cx.directory.resolve_realm",
        "cx.directory.resolve_target",
        "cx.directory.announce",
        "cx.directory.withdraw",
        "cx.directory.private_contact_discovery"
      ],
      "covers_vectors": [
        "cx.vector.directory.public_realm_search.v1",
        "cx.vector.directory.organization_search.v1",
        "cx.vector.directory.restricted_claim_presentation.v1",
        "cx.vector.directory.unlisted_exact_resolve.v1",
        "cx.vector.directory.resolve_target_blinding.v1",
        "cx.vector.directory.organization_badge_verification.v1",
        "cx.vector.directory.pairwise_did_exclusion.v1",
        "cx.vector.directory.stale_result_rejection.v1",
        "cx.vector.directory.result_common_fields.v1",
        "cx.vector.directory.announce_bidirectional_opt_in.v1",
        "cx.vector.directory.announce_directory_not_authorized.v1",
        "cx.vector.directory.announce_bad_signature.v1",
        "cx.vector.directory.announce_signature_stale.v1",
        "cx.vector.directory.policy_revision_rollback.v1",
        "cx.vector.directory.accept_policy_denied.v1",
        "cx.vector.directory.reannounce_idempotent_ttl.v1",
        "cx.vector.directory.pull_mode_refresh_verification.v1",
        "cx.vector.directory.ttl_expiry_removal.v1",
        "cx.vector.directory.withdraw_blinded_not_found.v1",
        "cx.vector.directory.operator_takedown_audit.v1",
        "cx.vector.directory.takedown_reannounce_rejected.v1",
        "cx.vector.psi.oprf_two_round_shape.v1",
        "cx.vector.psi.no_reachability_metadata.v1",
        "cx.vector.psi.quota_blinded_denial.v1"
      ],
      "expected": {
        "query_results_require_common_fields": [
          "as_of",
          "source_refs",
          "policy_revision"
        ],
        "resolve_target_hidden_targets_are_indistinguishable": true,
        "ingest_requires_resource_directory_opt_in": true,
        "ingest_rejects_bad_signature_and_stale_signature": true,
        "withdraw_and_takedown_have_blinded_external_responses": true,
        "psi_is_set_membership_only": true,
        "psi_denials_are_padded_and_timing_blinded": true
      }
    },
    {
      "name": "plaintext_visible_service_required_for_private_body_processing",
      "operation_id": "cx.events.submit",
      "input": {
        "service_did": "did:web:search.example",
        "event_kind": "cx.message.create",
        "content_class": "private_plaintext",
        "realm_policy": {
          "plaintext_visible_services": [
            {
              "service_did": "did:web:principal.example",
              "service_type": "principal_server",
              "data_classes": [
                "message_content"
              ],
              "purposes": [
                "events",
                "sync"
              ],
              "visibility": "private_plaintext"
            }
          ]
        }
      },
      "expected": {
        "decision": "deny",
        "error_code": "capability_denied",
        "reason_code": "service_not_plaintext_visible",
        "must_not_forward_plaintext": true
      }
    },
    {
      "name": "private_blob_head_range_anti_enumeration",
      "operation_id": "cx.blob.head",
      "inputs": [
        {
          "label": "missing",
          "blob_ref": "ck:blob:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "label": "hidden",
          "blob_ref": "ck:blob:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "expected": {
        "same_http_status": 404,
        "same_error_code": "not_found",
        "must_not_include_headers": [
          "Content-Length",
          "Content-Type",
          "Content-Disposition",
          "Accept-Ranges",
          "Digest"
        ],
        "range_request_same_error_class": true
      }
    },
    {
      "name": "push_blind_wakeup_payload",
      "operation_id": "cx.push.notify",
      "input": {
        "notification": {
          "push_target_id": "cx_push_pseudo_01js0pt0000000000000000000",
          "wakeup_kind": "message",
          "push_hint": "new_message",
          "counts": {
            "unread": 1
          },
          "devices": [
            {
              "push_key": "fcm:eJx9k2-example",
              "app_id": "com.cokret.client"
            }
          ]
        }
      },
      "expected": {
        "no_plaintext_message_content": true,
        "no_member_list": true,
        "no_realm_or_flow_title_for_e2ee": true,
        "forbidden_fields_absent": [
          "notification.event_id",
          "notification.realm_id",
          "notification.kind",
          "notification.sender_actor_id",
          "notification.sender_actor_display_name",
          "notification.realm_title",
          "notification.flow_title"
        ],
        "device_payload_max_bytes": 512
      }
    }
  ]
}
