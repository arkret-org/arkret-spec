  "cases": [
    {
      "name": "mention_selector",
      "vector_id": "ak.vector.agent.mention_selector.v1",
      "kind": "agent_selector_resolution",
      "mention_text_original": "@alice:acme.example/summary",
      "controller_handle": "alice:acme.example",
      "controller_subject": "ak:did_core:webvh:z6mkfixtureacmeexampleusersalice",
      "agent_slug_at_time": "summary",
      "agent_subject": "ak:did_core:webvh:z6mkfixtureagentsacmeexamplealicesummary",
      "changed_agent_slug": "digest",
      "changed_agent_subject": "ak:did_core:webvh:z6mkfixtureagentsacmeexamplealicedigest",
      "persisted_mention": {
        "subject_account_id": {
          "principal_id": "ak:did_core:webvh:z6mkfixtureagentsacmeexamplealicesummary",
          "station_id": "ak:did_core:web:acme.example"
        },
        "controller_subject_account_id": {
          "principal_id": "ak:did_core:webvh:z6mkfixtureacmeexampleusersalice",
          "station_id": "ak:did_core:web:acme.example"
        },
        "agent_slug_at_time": "summary",
        "mention_text_original": "@alice:acme.example/summary"
      },
      "expected": {
        "ambiguous_selector": "fail_closed",
        "unavailable_selector": "fail_closed",
        "historical_target_after_slug_change": {
          "principal_id": "ak:did_core:webvh:z6mkfixtureagentsacmeexamplealicesummary",
          "station_id": "ak:did_core:web:acme.example"
        },
        "same_principal_other_station_account": {
          "principal_id": "ak:did_core:webvh:z6mkfixtureagentsacmeexamplealicesummary",
          "station_id": "ak:did_core:web:other.example"
        },
        "same_principal_other_station_matches": false
      },
      "assertions": [
        "selector resolution binds the persisted mention subject_account_id to the agent complete AccountId, principal and Station component both",
        "controller, slug and original text are audit metadata only",
        "slug changes do not rewrite historical mention targets",
        "ambiguous or unavailable selector claims fail closed",
        "a member account with the same principal on another Station does not match the mention: comparison covers principal_id and station_id, so it produces no mention notification and no authorization or MemberIdentity join hit"
      ]
    },
    {
      "name": "ceiling_tighten",
      "vector_id": "ak.vector.agent.participation.ceiling_tighten.v1",
      "kind": "ceiling_chain",
      "parent_ceiling": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": true,
        "act_on_behalf": false
      },
      "accepted_child_ceiling": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": false,
        "act_on_behalf": false
      },
      "widening_child_ceiling": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": true,
        "act_on_behalf": true
      },
      "strand_widening_ceiling": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": true,
        "act_on_behalf": false
      },
      "expected": {
        "accepted": true,
        "widen_reason": "agent_participation_ceiling_widen"
      },
      "assertions": [
        "Circle and Strand participation ceilings may only drop bits from their parent",
        "a child that enables act_on_behalf below a disabled parent bit is rejected",
        "a Strand that re-enables a Circle-disabled third-party mention bit is rejected"
      ]
    },
    {
      "name": "effective_intersection",
      "vector_id": "ak.vector.agent.participation.effective_intersection.v1",
      "kind": "effective_participation",
      "ordinary_capabilities": [
        "ak.message.create",
        "ak.reaction.add"
      ],
      "governance_ceiling": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": true,
        "act_on_behalf": false
      },
      "selection": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": false,
        "act_on_behalf": true
      },
      "expected": {
        "effective": {
          "reply_message": true,
          "reaction_add": true,
          "reaction_remove": false,
          "accept_third_party_mention": false,
          "act_on_behalf": false
        },
        "after_reply_tighten": {
          "reply_message": false,
          "reaction_add": false,
          "reaction_remove": false,
          "accept_third_party_mention": false,
          "act_on_behalf": false
        },
        "unknown_source_effective": {
          "reply_message": false,
          "reaction_add": false,
          "reaction_remove": false,
          "accept_third_party_mention": false,
          "act_on_behalf": false
        }
      },
      "assertions": [
        "effective participation is the bitwise meet of the current governance/deployment ceiling and controller selection",
        "the five controller selection bits are independent and are not derived from requested scope",
        "participation is an additional action gate and never materializes a capability grant",
        "act-on-behalf is denied when the current ceiling disables it",
        "tightening the ceiling immediately disables the corresponding action gate",
        "unknown or stale ceiling source fails closed to no effective participation"
      ]
    },
    {
      "name": "selection_cas",
      "vector_id": "ak.vector.agent.participation.selection_cas.v1",
      "kind": "selection_cas",
      "target_scope": {
        "kind": "realm",
        "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5"
      },
      "initial_expected_version": 0,
      "governance_ceiling": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": false,
        "act_on_behalf": false
      },
      "selection": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": true,
        "act_on_behalf": false
      },
      "expected": {
        "stored_version": 1,
        "effective": {
          "reply_message": true,
          "reaction_add": true,
          "reaction_remove": false,
          "accept_third_party_mention": false,
          "act_on_behalf": false
        },
        "capped_bits": [
          "accept_third_party_mention"
        ]
      },
      "assertions": [
        "Account Authority stores the full controller selection without converting it into authority",
        "target action enforcement intersects the stored selection with current governance",
        "a capped selection bit grants no action and creates no capability grant"
      ]
    },
    {
      "name": "session_overlay",
      "vector_id": "ak.vector.agent.participation.session_overlay.v1",
      "kind": "session_scope_details",
      "target_scope": {
        "kind": "realm",
        "realm_id": "ak:realm:Ac1aCK8aQdnkYImvdH3DFjq4jDCP198pXYWCGzGuVyj5"
      },
      "selection": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": false,
        "act_on_behalf": false
      },
      "version": 7,
      "next_replace_input": {
        "expected_version": 7
      },
      "expected": {
        "schema_ref": "schemas/agent-operations.schema.json#/$defs/agent_participation_entry",
        "runtime_without_grant": "failed_precondition"
      },
      "assertions": [
        "session scope_details.participation entries are isomorphic to agent_participation_entry",
        "the overlay is a behavior contract and not an authorization boundary",
        "missing backing capability grant still fails the runtime operation"
      ]
    },
    {
      "name": "third_party_mention_gate",
      "vector_id": "ak.vector.agent.participation.third_party_mention_gate.v1",
      "kind": "mention_dispatch_gate",
      "controller_subject": "ak:did_core:webvh:z6mkfixtureacmeexampleusersalice",
      "third_party_subject": "ak:did_core:webvh:z6mkfixtureacmeexampleusersbob",
      "agent_subject": "ak:did_core:webvh:z6mkfixtureagentsacmeexamplealicesummary",
      "effective_before": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": false,
        "act_on_behalf": false
      },
      "effective_after": {
        "reply_message": true,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": true,
        "act_on_behalf": false
      },
      "expected": {
        "third_party_before": {
          "mention_notification": false,
          "inbox_entry": false,
          "push": false,
          "subscribe_projection": false
        },
        "controller_before": {
          "mention_notification": true,
          "inbox_entry": true,
          "push": true,
          "subscribe_projection": true
        },
        "third_party_before_after_flip": {
          "mention_notification": false,
          "inbox_entry": false,
          "push": false,
          "subscribe_projection": false
        },
        "third_party_after": {
          "mention_notification": true,
          "inbox_entry": true,
          "push": true,
          "subscribe_projection": true
        }
      },
      "assertions": [
        "when accept_third_party_mention is false, non-controller mentions fan out to no agent delivery artifacts",
        "the controller's own mention still delivers",
        "enabling third-party mention later is non-retroactive",
        "subsequent third-party mentions deliver only after the effective bit is true"
      ]
    },
    {
