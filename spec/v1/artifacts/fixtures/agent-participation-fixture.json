      },
      "selection": {
        "reply_message": false,
        "reaction_add": true,
        "reaction_remove": false,
        "accept_third_party_mention": false,
        "act_on_behalf": true
      },
      "expected": {
        "accepted": false,
        "reason": "agent_reply_not_permitted",
        "effective": {
          "reply_message": false,
          "reaction_add": true,
          "reaction_remove": false,
          "accept_third_party_mention": false,
          "act_on_behalf": false
