{
  "suite": "security_closure_vectors",
  "profile": "cx.profile.privacy_security_vectors.v1",
  "version": "2026-05-20",
  "description": "Structured negative/edge-case fixtures for security vectors referenced by prose. tools/lint_artifacts.py validates vector_id closure and minimum executable shape.",
  "security_closure_vectors": [
    {
      "vector_id": "cx.vector.federation.idempotency_after_key_revoke.v1",
      "steps": [
        {
          "name": "accepted_original_push",
          "input": {
            "operation_id": "cx.events.submit",
            "headers": {
              "Source-Service-DID": "did:web:alpha.example",
              "Destination-Service-DID": "did:web:beta.example",
              "Source-Trust-Domain": "cx:trust_domain:did.webvh.alpha.example",
              "Destination-Trust-Domain": "cx:trust_domain:did.webvh.beta.example",
              "Request-Canonical-Hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "Idempotency-Key": "idem-001"
            },
            "origin_key_state_hash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          },
          "expected": {
            "outcome": "accepted",
            "invariants": [
              "idempotency cache key includes source service, destination service, request canonical hash, idempotency key, and origin key state hash"
            ]
          }
        },
        {
          "name": "replay_after_service_key_revoke",
          "input": {
            "same_http_bytes_as": "accepted_original_push",
            "origin_key_state_hash": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          },
          "expected": {
            "outcome": "historical_only",
            "reason_code": "service_key_revoked",
            "invariants": [
              "cache hit cannot bypass current key-state verification"
            ]
          }
        },
        {
          "name": "replay_after_realm_binding_removed",
          "input": {
            "same_http_bytes_as": "accepted_original_push",
            "realm_binding_state": "removed"
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "capability_denied",
            "invariants": [
              "receiver re-runs current authorization before treating replay as accepted"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.webrtc.media_plaintext_downgrade.v1",
      "steps": [
        {
          "name": "policy_missing_media_service_decrypts",
          "input": {
            "policy_root_covers_media_service_decrypts": false
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "media_plaintext_policy_missing",
            "invariants": [
              "client does not publish plaintext-visible media key"
            ]
          }
        },
        {
          "name": "sfu_not_plaintext_visible",
          "input": {
            "media_service_decrypts": true,
            "sfu_service_did": "did:web:sfu.example",
            "plaintext_visible_services": []
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "media_plaintext_service_not_visible",
            "invariants": [
              "SFU cannot negotiate plaintext media unless listed by Realm policy"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.identity_link.eager_invalidation.v1",
      "steps": [
        {
          "name": "ban_invalidates_active_link",
          "input": {
            "identity_link_state": "active",
            "membership_transition": "ban"
          },
          "expected": {
            "outcome": "cache_invalidated",
            "reason_code": "identity_link_no_longer_visible",
            "invariants": [
              "directory, sync, invite, and local profile caches stop returning the old link"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.identity_link.policy_tightening_invalidation.v1",
      "steps": [
        {
          "name": "disclosure_policy_tightened",
          "input": {
            "identity_link_state": "active",
            "policy_change": "disclosure_scope_tightened"
          },
          "expected": {
            "outcome": "cache_invalidated",
            "reason_code": "identity_link_policy_tightened",
            "invariants": [
              "old link is not returned until it passes the current policy gate"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.late_key_recovery.removed_actor.v1",
      "steps": [
        {
          "name": "receiver_not_visible_at_t0",
          "input": {
            "receiver_visible_at_t0": false,
            "late_key_source": "backup_node"
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "late_recovery_rejected_membership",
            "invariants": [
              "plaintext never enters verified timeline"
            ]
          }
        },
        {
          "name": "source_did_not_recheck_after_remove",
          "input": {
            "receiver_visible_at_t0": true,
            "current_membership": "removed",
            "source_rechecked_current_share_policy": false
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "late_recovery_share_not_authorized",
            "invariants": [
