            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.invite.oob_code_entropy.v1",
      "steps": [
        {
          "name": "short_offline_token_rejected",
          "input": {
            "oob_code_kind": "offline_token",
            "token_entropy_bits": 64
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "invite_oob_entropy_too_low",
            "invariants": [
              "production offline OOB code must have at least 128 bits of entropy"
            ]
          }
        },
        {
          "name": "lookup_attempt_budget_exceeded",
          "input": {
            "oob_code_kind": "lookup",
            "failed_attempts": 3
          },
          "expected": {
            "outcome": "invalidated",
            "reason_code": "invalidated_by_rate_limit",
            "invariants": [
              "lookup short-code cannot remain claimable after the configured error budget"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.invite.failure_indistinguishable.v1",
      "steps": [
        {
          "name": "all_failure_causes_share_external_shape",
          "input": {
            "failure_causes": [
              "not_found",
              "expired",
              "revoked",
              "consumed",
              "audience_mismatch",
              "inviter_left",
              "policy_gate_failed"
            ]
          },
          "expected": {
            "outcome": "not_found",
            "response": {
              "external_error": "not_found",
              "byte_identical": true,
              "timing_delta_max_ms": 50
            },
            "invariants": [
              "specific reason code is only written to server-side audit log"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.consent.scope_cascade.v1",
      "steps": [
        {
          "name": "any_revoke_cascades_to_scopes",
          "input": {
            "active_scopes": [
              "any",
              "invite",
              "direct_message"
            ],
            "revoked_scope": "any"
          },
          "expected": {
            "outcome": "accepted",
            "invariants": [
              "all concrete scopes in the same consent cell become inactive"
            ]
          }
        },
        {
          "name": "concrete_revoke_does_not_remove_any",
          "input": {
            "active_scopes": [
              "any",
              "invite",
              "direct_message"
            ],
            "revoked_scope": "invite"
          },
          "expected": {
            "outcome": "accepted",
            "invariants": [
              "any and direct_message remain active"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.consent.cache_invalidation.v1",
      "steps": [
        {
          "name": "revoke_invalidates_reachability_and_invite_cache",
          "input": {
            "consent_state": "revoked",
            "cached_surfaces": [
              "directory_reachability",
              "invite_gate",
              "psi_index"
            ]
          },
          "expected": {
            "outcome": "cache_invalidated",
            "reason_code": "consent_revoked",
            "invariants": [
              "directory lookup stops returning peer",
              "next invite precondition re-runs consent gate",
              "PSI index excludes peer at next rotation"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.sync.soft_fail_reconcile.v1",
      "steps": [
        {
          "name": "backfill_resolves_soft_fail",
          "input": {
            "initial_event_state": "soft_failed",
            "backfill_result": "dependencies_available"
          },
          "expected": {
            "outcome": "accepted",
            "invariants": [
              "covered frontier advances deterministically"
            ]
          }
        },
        {
          "name": "backfill_conflict_rejects_soft_fail",
          "input": {
            "initial_event_state": "soft_failed",
            "backfill_result": "permanent_conflict"
          },
          "expected": {
            "outcome": "rejected",
            "reason_code": "failed_precondition",
            "invariants": [
              "event does not remain soft_failed indefinitely"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.lattice.lww_open_set.v1",
      "steps": [
        {
          "name": "input_order_independent_winner",
          "input": {
            "siblings": [
              "cx:event:019a7360-0000-7000-8000-000000000001",
              "cx:event:019a7360-0000-7000-8000-000000000002"
            ],
            "same_logical_time": true
          },
          "expected": {
            "outcome": "accepted",
            "invariants": [
              "all conformant reducers compute the same sibling set, tiebreaker, winner, bottom state, and covered frontier"
            ]
          }
        }
      ]
    },
    {
      "vector_id": "cx.vector.e2ee_relaxed.window_exceeds_ceiling.v1",
      "steps": [
        {
          "name": "policy_write_exceeds_hard_ceiling",
