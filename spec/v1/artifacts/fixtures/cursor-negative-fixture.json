          "decoded_body_utf8": "{\"expires_at\":\"2099-12-31T23:59:59.000Z\",\"h\":\"abcdefghijklmnopqrstuv\",\"issued_at\":\"2026-06-06T00:00:00.000Z\",\"purpose\":\"stream\",\"s\":{},\"v\":\"1\"}",
          "expected_reason_code": "invalid_cursor",
