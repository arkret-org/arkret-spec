  "profile": "ak.vector_group.encoding.v1",
  "version": "2026-07-03",
  "description": "Machine-readable negative cursor vectors mirrored from zh/conformance/conformance-vectors.md section 1.16. Complements the positive opaqueness vector ak.vector.encoding.cursor_opaque.core.v1: every case below is a schema-valid-looking ak:cursor: token that a conformant receiver MUST reject before advancing any server-side state. reason_code values are stable codes from error-code-registry.json (invalid_cursor is surfaced under top-level param_invalid).",
  "vectors": [
    {
      "vector_id": "ak.vector.encoding.reject_invalid_cursor.core.v1",
      "kind": "cursor_negative",
      "cases": [
        {
          "name": "oversized_token",
          "input_cursor": "ak:cursor:",
          "decoded_body_utf8": null,
          "expected_reason_code": "invalid_cursor",
          "violation": "encoded token exceeds the 4KB body cap before any decode work"
        },
        {
          "name": "invalid_base64url",
          "input_cursor": "ak:cursor:!!!not-base64url!!!",
          "decoded_body_utf8": null,
          "expected_reason_code": "invalid_cursor",
          "violation": "token payload is not unpadded base64url"
        },
        {
          "name": "malformed_json",
          "input_cursor": "ak:cursor:eyJ2IjoiMSI",
          "decoded_body_utf8": "{\"v\":\"1\"",
