          "decoded_body_utf8": "{\"expires_at\":\"2099-12-30T00:00:00.000Z\",\"h\":\"abcdefghijklmnopqrstuv\",\"issued_at\":\"2099-12-31T00:00:00.000Z\",\"purpose\":\"stream\",\"v\":\"1\"}",
          "expected_reason_code": "invalid_cursor",
          "violation": "issued_at is after expires_at (negative TTL)"
        },
        {
          "name": "stream_ttl_exceeds_cap",
          "input_cursor": "ak:cursor:eyJleHBpcmVzX2F0IjoiMjA5OS0xMi0zMVQyMzo1OTo1OS4wMDBaIiwiaCI6ImFiY2RlZmdoaWprbG1ub3BxcnN0dXYiLCJpc3N1ZWRfYXQiOiIyMDIwLTAxLTAxVDAwOjAwOjAwLjAwMFoiLCJwdXJwb3NlIjoic3RyZWFtIiwidiI6IjEifQ",
          "decoded_body_utf8": "{\"expires_at\":\"2099-12-31T23:59:59.000Z\",\"h\":\"abcdefghijklmnopqrstuv\",\"issued_at\":\"2020-01-01T00:00:00.000Z\",\"purpose\":\"stream\",\"v\":\"1\"}",
          "expected_reason_code": "invalid_cursor",
          "violation": "expires_at - issued_at exceeds the stream-purpose hard TTL cap of 7 days (encoding.md section 8.3 rule 12)"
