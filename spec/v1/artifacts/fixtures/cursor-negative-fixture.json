          "input_cursor": "ak:cursor:eyJleHBpcmVzX2F0IjoiMjA5OS0xMi0zMVQyMzo1OTo1OS4wMDBaIiwiaCI6ImFiY2RlZmdoaWprbG1ub3BxcnN0dXYiLCJpc3N1ZWRfYXQiOiIyMDIwLTAxLTAxVDAwOjAwOjAwLjAwMFoiLCJwdXJwb3NlIjoiYmFycmllciIsInYiOiIxIn0",
