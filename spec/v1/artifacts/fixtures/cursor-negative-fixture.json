          "input_cursor": "ak:cursor:eyJleHBpcmVzX2F0IjoiMjA5OS0xMi0zMVQyMzo1OTo1OS4wMDBaIiwiaCI6ImFiY2RlZmdoaWprbG1ub3BxcnN0dXYiLCJpc3N1ZWRfYXQiOiIyMDk5LTEyLTMwVDIzOjU5OjU5WiIsInB1cnBvc2UiOiJzdHJlYW0iLCJ2IjoiMSJ9",
          "decoded_body_utf8": "{\"expires_at\":\"2099-12-31T23:59:59.000Z\",\"h\":\"abcdefghijklmnopqrstuv\",\"issued_at\":\"2099-12-30T23:59:59Z\",\"purpose\":\"stream\",\"v\":\"1\"}",
          "expected_reason_code": "invalid_cursor",
          "violation": "issued_at omits the mandatory three millisecond digits; whole seconds MUST use .000Z"
        }
      ],
      "fixture_freshness_note": "All timestamps are pinned so every case stays deterministically rejectable for the spec lifetime: expired cases use year-2020 values (always past), TTL-cap and negative-TTL cases use year-2099 x values (not expired before 2099) with a violation that is checked before any now-relative comparison could differ.",
      "rules": [
        "receivers MUST reject every case before advancing subscription position, barrier wait, or any other server-side state",
        "syntax / schema / TTL-bound failures surface as top-level param_invalid with reason_code invalid_cursor; expiry uses cursor_expired; handle lookup or cross-binding failures (not covered here, they need server state) use cursor_integrity_invalid",
        "receivers MUST enforce the 4KB cap on the encoded token before spending base64 or JSON parsing work",
        "TTL bound checks MUST validate issued_at and expires_at well-formedness first, then issued_at <= expires_at, then issued_at not in the future beyond clock skew, then expires_at - issued_at against the per-purpose cap, so a corrupt issued_at cannot bypass the cap"
      ]
    }
  ]
}
