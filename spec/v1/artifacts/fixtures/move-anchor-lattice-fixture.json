{
  "profile": "cx.profile.move_anchor_lattice_vectors.v1",
  "version": "2026-05-07",
  "vectors": [
    {
      "name": "multi_cell_ban_revokes_grants_atomically",
      "description": "A single Move bans Alice and revokes two grants. The Anchor batch pre-state must satisfy all preconditions; otherwise none of the effects become effective.",
      "pre_state": {
        "anchor": "cx:anchor:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "cells": {
          "cx:cell:cx.component.member.state.v1:did.web.alice.example": {
            "membership": "join",
            "head": "cx:move:sha256:1111111111111111111111111111111111111111111111111111111111111111"
          },
          "cx:cell:cx.component.capability.grant.v1:cx.grant.01js0gr0000000000000000000": {
            "status": "active",
            "head": "cx:move:sha256:2222222222222222222222222222222222222222222222222222222222222222"
          },
          "cx:cell:cx.component.capability.grant.v1:cx.grant.01js0gs0000000000000000000": {
            "status": "active",
            "head": "cx:move:sha256:3333333333333333333333333333333333333333333333333333333333333333"
          }
        }
      },
      "move": {
        "id": "cx:move:sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "issuer": "did:web:admin.example",
        "anchor_ref": "cx:anchor:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "preconditions": [
          {
            "cell": "cx:cell:cx.component.member.state.v1:did.web.alice.example",
            "predicate": {
              "op": "head_eq",
              "value": "cx:move:sha256:1111111111111111111111111111111111111111111111111111111111111111"
            }
          },
          {
            "cell": "cx:cell:cx.component.capability.grant.v1:cx.grant.01js0gr0000000000000000000",
            "predicate": {
              "op": "head_eq",
              "value": "cx:move:sha256:2222222222222222222222222222222222222222222222222222222222222222"
            }
          },
          {
            "cell": "cx:cell:cx.component.capability.grant.v1:cx.grant.01js0gs0000000000000000000",
            "predicate": {
              "op": "head_eq",
              "value": "cx:move:sha256:3333333333333333333333333333333333333333333333333333333333333333"
            }
          }
        ],
        "effects": [
          {
            "cell": "cx:cell:cx.component.member.state.v1:did.web.alice.example",
            "op": {
              "type": "transition",
              "from": "join",
              "to": "ban",
              "reason": "abuse"
            }
          },
          {
            "cell": "cx:cell:cx.component.capability.grant.v1:cx.grant.01js0gr0000000000000000000",
            "op": {
              "type": "remove",
              "tag": "grant-tag-a"
            }
          },
          {
            "cell": "cx:cell:cx.component.capability.grant.v1:cx.grant.01js0gs0000000000000000000",
            "op": {
              "type": "remove",
              "tag": "grant-tag-b"
            }
          }
        ],
        "refs": [
          {
            "id": "cx:grant:01js0ga0000000000000000000",
            "role": "authorized_by"
          }
        ]
      },
      "expected": {
        "verify_move": "pass",
        "atomicity": "all_effects_or_none"
      }
    },
    {
      "name": "cas_register_conflict_returns_bottom",
      "description": "Two anchored Moves concurrently set the same cas-register cell. Query returns structured bottom rather than choosing a winner.",
      "cell": "cx:cell:cx.component.space.policy.v1:cx.space.01js0sp0000000000000000000",
      "lattice": {
        "type": "cas-register",
        "bottom": "reject"
      },
      "anchored_moves": [
        "cx:move:sha256:4444444444444444444444444444444444444444444444444444444444444444",
        "cx:move:sha256:5555555555555555555555555555555555555555555555555555555555555555"
      ],
      "expected": {
        "query": {
          "status": "bottom",
          "bottom": {
            "kind": "conflict",
            "cells": [
              "cx:cell:cx.component.space.policy.v1:cx.space.01js0sp0000000000000000000"
            ],
            "move_ids": [
              "cx:move:sha256:4444444444444444444444444444444444444444444444444444444444444444",
              "cx:move:sha256:5555555555555555555555555555555555555555555555555555555555555555"
            ]
          }
        },
        "dependent_move_result": "fail_bottom"
      }
    },
    {
      "name": "anchor_batch_pre_state_prevents_self_satisfaction",
      "description": "Two Moves in the same Anchor batch are verified against predecessor state. M2 cannot satisfy its precondition from M1 unless M1 was already in a predecessor Anchor.",
      "predecessor_anchor": "cx:anchor:sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "anchor": {
        "id": "cx:anchor:sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "predecessor_refs": [
          "cx:anchor:sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        ],
        "frontier": [
          "cx:move:sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "cx:move:sha256:7777777777777777777777777777777777777777777777777777777777777777"
        ]
      },
      "expected": {
        "anchor_result": "reject",
        "reason": "batch_preconditions_use_predecessor_state"
      }
    },
    {
      "name": "mls_commit_move_requires_covered_frontier",
      "description": "MLS commit is a Move. It fails when covered_frontier_cell does not contain the governance frontier required by the encrypted message path.",
      "move": {
        "id": "cx:move:sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "effects": [
          {
            "cell": "cx:cell:cx.component.mls_epoch.v1:group.01js0mls0000000000000000",
            "op": {
              "type": "set",
              "value": "epoch-42"
            }
          }
        ],
        "preconditions": [
          {
            "cell": "cx:cell:cx.component.covered_frontier.v1:cx.space.01js0sp0000000000000000000",
            "predicate": {
              "op": "contains",
              "value": "cx:anchor:sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
            }
          }
        ]
      },
      "expected": {
        "verify_move": "fail_precondition",
        "normal_governance_moves_continue": true
      }
    },
    {
      "name": "anchorer_cell_bottom_pauses_space_until_recovery",
      "description": "When the anchorer cell resolves to ⊥ (concurrent set on cas-register), the Space enters anchorer_paused. Only recovery_members declared at genesis MAY sign a recovery Anchor that re-anchors the anchorer cell to a new value.",
      "anchor_profile": "mixed",
      "genesis_anchorer": {
        "type": "mixed",
        "primary": "did:web:host-a.example",
        "recovery_members": [
          "did:web:recovery-1.example",
          "did:web:recovery-2.example"
        ]
      },
      "concurrent_anchorer_moves": [
        "cx:move:sha256:1010101010101010101010101010101010101010101010101010101010101010",
        "cx:move:sha256:2020202020202020202020202020202020202020202020202020202020202020"
      ],
      "expected": {
        "anchorer_cell_value": "bottom",
        "space_state": "anchorer_paused",
        "normal_anchor_emission": "blocked",
        "recovery_anchor_emission": "allowed_only_for_recovery_members",
        "post_recovery_state": "effective"
      }
    },
    {
      "name": "signed_compaction_anchor_equals_effective_view",
      "description": "Signed compaction Anchor MUST be equivalent to the deterministic effective_anchor_view of its predecessors: same predecessor_refs (sorted), frontier (union), and recomputed state_root. It MUST NOT drop bottom diagnostics observable from the prior Anchor leaves.",
      "predecessor_leaves": [
        "cx:anchor:sha256:3030303030303030303030303030303030303030303030303030303030303030",
        "cx:anchor:sha256:4040404040404040404040404040404040404040404040404040404040404040"
      ],
      "compaction_anchor": {
        "id": "cx:anchor:sha256:5050505050505050505050505050505050505050505050505050505050505050",
        "predecessor_refs_sorted": [
          "cx:anchor:sha256:3030303030303030303030303030303030303030303030303030303030303030",
          "cx:anchor:sha256:4040404040404040404040404040404040404040404040404040404040404040"
        ],
        "frontier_must_equal": "union(predecessor.frontier)",
        "state_root_must_equal": "recompute(joined_state(predecessor_leaves))"
      },
      "expected": {
        "anchor_result": "accept_when_equivalent_else_reject",
        "preserves_bottom_diagnostics": true,
        "preserves_signature_chain": true,
        "compaction_without_signature": "reject"
      }
    },
    {
      "name": "anchor_dag_genesis_and_multi_leaf_join",
      "description": "Genesis Anchor MUST have predecessor_refs=[]. Multi-leaf Anchor view computes effective_anchor_view as a pure local function; it is NOT itself a new Anchor object until signed.",
      "vectors": [
        {
          "case": "genesis_with_empty_predecessor_refs",
          "anchor": {
            "predecessor_refs": [],
            "frontier": [],
            "anchorer_sig_kind": "single"
          },
          "expected": "accept"
        },
        {
          "case": "non_genesis_with_empty_predecessor_refs",
          "anchor": {
            "predecessor_refs": [],
            "frontier": [
              "cx:move:sha256:6060606060606060606060606060606060606060606060606060606060606060"
            ]
          },
          "expected": "reject"
        },
        {
          "case": "multi_leaf_effective_view_is_pure_function",
          "leaves": [
            "cx:anchor:sha256:7070707070707070707070707070707070707070707070707070707070707070",
            "cx:anchor:sha256:8080808080808080808080808080808080808080808080808080808080808080"
          ],
          "expected": {
            "needs_signature": false,
            "is_new_anchor_object": false,
            "deterministic": true
          }
        },
        {
          "case": "signed_compaction_required_for_persistent_compression",
          "leaves": [
            "cx:anchor:sha256:7070707070707070707070707070707070707070707070707070707070707070",
            "cx:anchor:sha256:8080808080808080808080808080808080808080808080808080808080808080"
          ],
          "expected": {
            "needs_signature": true,
            "anchorer_sig_required": true
          }
        }
      ]
    }
  ]
}
