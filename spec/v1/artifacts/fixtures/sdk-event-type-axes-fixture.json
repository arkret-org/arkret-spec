{
  "suite": "sdk_event_type_axes",
  "version": "2026-08-02",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.sdk.event_type_axes.v1"
  },
  "covers_vectors": [
    "ak.vector.sdk.event_type_axes.v1"
  ],
  "cases": [
    {
      "name": "control_move_without_basis_compile_fails",
      "outer_shape": "ControlMove",
      "omitted_fields": [
        "seal_basis"
      ],
      "expected": "compile_fail_or_inaccessible_constructor"
    },
    {
      "name": "ordinary_event_requires_admission_basis",
      "outer_shape": "ordinary_event",
      "omitted_fields": [
        "seal_ref",
        "auth_context"
      ],
      "expected": "compile_fail_or_inaccessible_constructor"
    },
    {
      "name": "anchor_unit_not_inferred_from_missing_fields",
      "outer_shape": "RawEventBatch",
      "attempt": "submit_as_anchor_unit",
      "expected": "compile_fail_or_validation_error"
    },
    {
      "name": "mls_commit_requires_full_bytes_epochs_and_frontier",
      "payload_shape": "MlsCommitPayload",
      "omitted_fields": [
        "commit_bytes_b64",
        "base_epoch",
        "next_epoch",
        "governance_binding.security_frontier_digest"
      ],
      "expected": "compile_fail_or_inaccessible_constructor"
    },
    {
      "name": "plain_ordinary_event_rejects_mls_commit_validator",
      "outer_shape": "ordinary_event",
      "payload_shape": "PlainPayload<MessageContent>",
      "attempt": "validate_as_mls_commit",
      "expected": "type_error"
    },
    {
      "name": "mls_encrypted_payload_cannot_serialize_as_plain",
      "payload_shape": "MlsEncryptedPayload<MessageContent>",
      "attempt": "serialize_as_plain_payload",
      "expected": "type_error"
    },
    {
      "name": "verified_submission_matches_service_schema",
      "outer_shape": "ordinary_event",
      "payload_shape": "MlsEncryptedPayload<MessageContent>",
      "expected": "sdk_bytes_pass_event_schema_canonicalization_and_proof_transcript"
    }
  ],
  "forbidden_public_api": [
    "unchecked_submission_from_raw_map",
    "mutable_verified_submission_envelope",
    "submit_raw_event_without_shape_conversion"
  ]
}
