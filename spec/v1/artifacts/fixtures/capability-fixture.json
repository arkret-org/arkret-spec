      "vector_id": "ak.vector.realm.authority_root_bootstrap.v1",
      "cases": [
        {
          "name": "registered_authority_root_genesis",
          "batch_order": [
            "ak.realm.create",
            "ak.realm.policy_bundle"
          ],
          "created_by": "did:webvh:z6mkfixture:founder.example",
          "authority_root_cell": "ak:cell:ak.component.realm.authority_root.v1:null",
          "authority_root_value": {
            "controller_id": "did:webvh:z6mkfixture:founder.example",
            "controller_epoch": 0,
            "authority_generation": 0,
            "capability_action_registry_digest": "sha256:9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a9a"
          },
          "expected": {
            "decision": "accept_atomically",
            "creator_membership": "join",
            "registered_cell_write_count": 5,
            "authority_root_present_at_genesis_seal": true,
            "creator_effective_owner_at_genesis_seal": true,
            "creator_strand_create_at_accepted_seal": "allowed",
            "creator_can_grant_member_strand_create": true,
            "member_without_explicit_grant": "missing_capability"
          }
        },
        {
          "name": "missing_authority_root_cell",
