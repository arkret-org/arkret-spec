      "constraint": {
        "constraint_kind": "temporal",
        "constraint_subkind": "edit_window",
        "applies_to_actions": [
          "ak.message.revise.own"
        ],
        "effect": "allow",
        "message_edit_window": "PT15M"
      },
      "target_created_at": "2026-04-26T00:00:00.000Z",
      "cases": [
        {
          "name": "matching_action_inside_window",
          "action": "ak.message.revise.own",
          "verification_time": "2026-04-26T00:10:00.000Z",
          "expected_matches": true
        },
        {
          "name": "matching_action_outside_window",
          "action": "ak.message.revise.own",
          "verification_time": "2026-04-26T00:21:00.000Z",
          "hard_future_skew_ms": 300000,
          "expected_matches": false
        },
        {
          "name": "unrelated_action_is_neutral_for_allow",
          "action": "ak.message.create",
          "verification_time": "2026-04-27T00:00:00.000Z",
