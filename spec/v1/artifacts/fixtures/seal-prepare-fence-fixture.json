{
  "suite": "seal_prepare_signing_slot_fence",
  "version": "2026-09-10",
  "runner": {
    "kind": "json_schema_and_semantic_cases",
    "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
    "schema_assertion_fields": [
      "schema_ref",
      "expect_valid",
      "instance"
    ],
    "semantic_assertion_fields": [
      "semantic_outcome",
      "expected_reason_code",
      "fence_state",
      "station_state"
    ]
  },
  "covers_vectors": [
    "ak.vector.seals.prepare_signing_slot_fence.v1"
  ],
  "fence_key": {
    "members": [
      "realm_id",
      "signer_slot",
      "predecessor_ref"
    ],
    "forbidden_members": [
      "session_grant_id",
      "device_connection",
      "worker_id",
      "lease_holder",
      "idempotency_key",
      "wall_clock_window"
    ],
    "operation_id": "ak.self.seals.command.prepare.v1",
    "rule": "The Station atomically and durably freezes one canonical request and one unsigned body per fence key before the first body leaves the service. The exact canonical request replays that byte-identical body; every other request on the same fence is refused with seal_signer_slot_fenced and zero writes."
  },
