          "configuration_ref": "ak:event:AQsHmGu_9sPOyJ4aG8VlWQBp8wGGhdC-BjfAaXqrIbk-",
          "command_results": [
            {
              "event_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
              "outcome": "committed",
