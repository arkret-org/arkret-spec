      "semantic_outcome": "accept",
      "fence_state": {
        "existing_fence": "none"
      },
      "station_state": {
        "basis_is_current_accepted": true,
        "signer_slot_current": true,
        "fence_committed_before_response": true
      },
      "instance": {
        "realm_id": "ak:realm:ARKJ9576lYcSucoyvgOXfrky7T5uCvf5VUw56g_J_Pil",
        "predecessor_ref": "ak:seal:sha256:1111111111111111111111111111111111111111111111111111111111111111",
