      "vector_id": "ak.vector.blob.content_key_derivation.v1",
      "assertions": [
        "An Event ref and equivalent proof hash resolved to the same verified winning group state produce the same key; the immutable wire key_ref remains AAD-bound."
      ]
    },
    {
      "name": "historical_epoch",
      "vector_id": "ak.vector.blob.content_key_derivation.v1",
      "assertions": [
        "Recover an authorized historical epoch; never substitute current epoch or use a reference as permission."
      ]
    },
    {
      "name": "state_resolution_failure",
      "vector_id": "ak.vector.blob.content_key_derivation.v1",
      "assertions": [
        "Unresolved, non-winning, ambiguous or wrong-scope state and missing/unauthorized checkpoint fail before exporter or decrypt; no fallback."
      ]
    },
    {
      "name": "descriptor_binding",
      "vector_id": "ak.vector.blob.content_key_derivation.v1",
      "assertions": [
        "Missing or malformed salt and unregistered key/key-envelope members fail closed; changing salt, key_ref, scheme, algorithm, size or MIME fails AEAD/outer authentication and releases no unauthenticated plaintext."
      ]
    },
    {
      "name": "durable_retry",
      "vector_id": "ak.vector.blob.content_key_derivation.v1",
      "assertions": [
        "Exact retry/restart uses the same salt, frozen descriptor and ciphertext; changed plaintext creates a new object salt."
      ]
    },
    {
      "name": "thumbnail",
      "vector_id": "ak.vector.blob.content_key_derivation.v1",
      "assertions": [
        "Use separate salt/key/nonce for an independently encrypted thumbnail; refs and metadata are outer-authenticated and no post-encryption digest enters KDF/AAD."
      ]
    }
