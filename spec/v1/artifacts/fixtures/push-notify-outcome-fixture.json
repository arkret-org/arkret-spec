    "spec/v1/artifacts/registry/error-code-registry.json"
  ],
  "description": "Conformance vectors for the ak.edge.push.command.notify.v1 response contract (push-notifications.md §5.2). The response is conserved against notification.devices[]: every input device_id appears in outcomes[] exactly once, none is missing, none is duplicated, and none appears that was not requested. A target-level failure is expanded into one same-reason rejected outcome per input device, so a second response shape never exists. gateway_status accepted/duplicate mean the gateway durably took the route over and the caller MUST NOT resend; only a rejected outcome carrying retry_after_ms transfers the next attempt back to the caller, and only for the two registered caller-retryable reasons. Cases whose schema_only_valid is true but whose semantic_outcome is reject satisfy JSON Schema yet MUST be rejected by a conforming verifier for the listed registered reason code, because conservation is a cross-field invariant JSON Schema cannot express. Placeholder pseudonyms and device ids are structural only and MUST NOT be treated as cryptographic vectors.",
  "runner": {
    "kind": "json_schema_and_semantic_cases",
    "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
    "schema_assertion_fields": [
      "schema_ref",
      "expect_valid",
      "instance"
    ],
    "semantic_assertion_fields": [
      "semantic_outcome",
      "expected_reason_code"
    ]
  },
  "request_context": {
    "notes": "Every response case below is evaluated against this one request. Its devices[] is the conserved input set.",
    "instance": {
      "notification": {
        "push_target_id": "ak:pseudonym:push:kosc9iQ4gVct1OB-b6X364WIFIsJFVbVzn7BMBs1sm8",
        "wakeup_kind": "message",
        "devices": [
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f"
          },
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-b021-3c4d5e6f7a8b"
          }
        ]
      }
    }
  },
  "schema_validation_cases": [
    {
      "name": "all_input_devices_accepted",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_outcome",
      "expect_valid": true,
      "semantic_outcome": "accept",
      "notes": "Both input devices durably taken over. Neither outcome carries reason_code or retry_after_ms; the caller owns no further attempt.",
      "instance": {
        "push_target_id": "ak:pseudonym:push:kosc9iQ4gVct1OB-b6X364WIFIsJFVbVzn7BMBs1sm8",
        "outcomes": [
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
            "gateway_status": "accepted"
          },
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-b021-3c4d5e6f7a8b",
            "gateway_status": "accepted"
          }
        ]
      }
    },
    {
      "name": "partial_rejection_drives_registration_cleanup",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_outcome",
      "expect_valid": true,
      "semantic_outcome": "accept",
      "notes": "Second device has no live registration. Cleanup is addressed by (push_target_id, device_id); the response never returns push_key, so the caller can drop the registration without the raw provider token crossing the wire.",
      "instance": {
        "push_target_id": "ak:pseudonym:push:kosc9iQ4gVct1OB-b6X364WIFIsJFVbVzn7BMBs1sm8",
        "outcomes": [
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
            "gateway_status": "accepted"
          },
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-b021-3c4d5e6f7a8b",
            "gateway_status": "rejected",
            "reason_code": "push_token_unknown"
          }
        ]
      }
    },
    {
      "name": "target_level_failure_is_expanded_per_device",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_outcome",
      "expect_valid": true,
      "semantic_outcome": "accept",
      "notes": "Unknown push target is a target-level failure. It MUST be expanded into one same-reason rejected outcome per input device rather than collapsing into a target-scoped shape, which is what keeps conservation unconditional.",
      "instance": {
        "push_target_id": "ak:pseudonym:push:kosc9iQ4gVct1OB-b6X364WIFIsJFVbVzn7BMBs1sm8",
        "outcomes": [
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
            "gateway_status": "rejected",
            "reason_code": "push_target_unknown"
          },
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-b021-3c4d5e6f7a8b",
            "gateway_status": "rejected",
            "reason_code": "push_target_unknown"
          }
        ]
      }
    },
    {
      "name": "caller_retryable_rejection_carries_backoff",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_outcome",
      "expect_valid": true,
      "semantic_outcome": "accept",
      "notes": "push_gateway_unreachable is one of exactly two caller-retryable reasons. retry_after_ms is the sole wire signal that the caller, not the gateway, owns the next attempt for that device.",
      "instance": {
        "push_target_id": "ak:pseudonym:push:kosc9iQ4gVct1OB-b6X364WIFIsJFVbVzn7BMBs1sm8",
        "outcomes": [
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
            "gateway_status": "accepted"
          },
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-b021-3c4d5e6f7a8b",
            "gateway_status": "rejected",
            "reason_code": "push_gateway_unreachable",
            "retry_after_ms": 2000
          }
        ]
      }
    },
    {
      "name": "exact_replay_reports_duplicate",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_outcome",
      "expect_valid": true,
      "semantic_outcome": "accept",
      "notes": "Replay under the same Idempotency-Key and body. duplicate means an earlier request already took the route over and this one produced no new delivery; like accepted it forbids caller resend. It never means the request repeated a device_id, which devices[] uniqueness already forbids.",
      "instance": {
        "push_target_id": "ak:pseudonym:push:kosc9iQ4gVct1OB-b6X364WIFIsJFVbVzn7BMBs1sm8",
        "outcomes": [
          {
            "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
            "gateway_status": "duplicate"
