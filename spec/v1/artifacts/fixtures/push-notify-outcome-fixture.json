  "source_refs": [
    "spec/v1/zh/discovery/push-notifications.md",
    "spec/v1/zh/sync/service-http-binding.md",
    "spec/v1/artifacts/schemas/push-operations.schema.json#/$defs/push_notify_outcome",
    "spec/v1/artifacts/schemas/push-operations.schema.json#/$defs/push_notify_device_outcome",
