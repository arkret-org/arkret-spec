  "registration_handoff_lifecycle_cases": [
    {
      "name": "exact_replay_after_lost_response",
      "steps": [
        "gateway_durable_commit_active",
        "response_lost",
        "station_replays_identical_body"
      ],
      "expected": "byte_identical_signed_receipt_and_one_active_installation"
    },
    {
      "name": "same_registration_id_different_body_conflicts",
      "steps": [
        "install_active",
        "replay_same_source_and_registration_id_with_different_push_key"
      ],
      "expected": "duplicate_conflict_and_zero_mutation"
    },
    {
      "name": "successor_tombstones_predecessor_atomically",
      "steps": [
        "install_registration_0001",
        "install_registration_0002_superseding_0001",
        "deliver_delayed_install_for_0001"
      ],
      "expected": "registration_0002_active_and_0001_terminal_without_old_route_revival"
    },
    {
      "name": "revoke_wins_over_delayed_install",
      "steps": [
        "commit_revoked_tombstone_for_registration_0001",
        "deliver_delayed_active_body_for_registration_0001"
      ],
      "expected": "terminal_revoked_and_provider_route_absent"
    },
    {
      "name": "source_destination_and_device_are_exact",
      "variants": [
        "wrong_source_station",
        "wrong_destination_gateway",
        "wrong_device",
        "wrong_push_target",
        "cross_station_supersedes"
      ],
      "expected": "reject_before_route_mutation_or_disclosure"
    },
    {
      "name": "tenant_isolation",
      "variants": [
        "same_registration_id_from_two_source_stations",
        "same_provider_token_from_two_source_stations",
        "cross_station_admin_or_worker_lookup"
      ],
      "expected": "separate_tenant_objects_no_cross_station_index_log_access_or_dedup"
    }
  ],
