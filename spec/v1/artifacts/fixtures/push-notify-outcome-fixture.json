      }
    },
    {
      "name": "rejected_without_reason_code_is_invalid",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_device_outcome",
      "expect_valid": false,
      "first_expected_error": "$: 'reason_code' is a required property",
      "semantic_outcome": "reject",
      "expected_reason_code": "schema_violation",
      "notes": "reason_code is REQUIRED when gateway_status=rejected; without it the caller cannot tell a terminal rejection from a retryable one.",
      "instance": {
        "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
        "gateway_status": "rejected"
      }
    },
    {
      "name": "reason_code_on_accepted_is_invalid",
      "schema_ref": "schemas/push-operations.schema.json#/$defs/push_notify_device_outcome",
      "expect_valid": false,
      "first_expected_error": "contains:should not be valid under {'anyOf': [{'required': ['reason_code']}, {'required': ['retry_after_ms']}]}",
      "semantic_outcome": "reject",
      "expected_reason_code": "schema_violation",
      "notes": "A durably accepted route has no rejection reason. Allowing one would reintroduce the ambiguity between acceptance and failure that the closed gateway_status enum exists to remove.",
      "instance": {
        "device_id": "ak:device:0192f3a1-4c2b-7d5e-9f10-2a3b4c5d6e7f",
        "gateway_status": "accepted",
