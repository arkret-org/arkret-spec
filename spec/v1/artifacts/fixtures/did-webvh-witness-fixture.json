    {
      "name": "same_controlling_organization_does_not_satisfy_distinct_requirement",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_controlling_organization_unverified",
      "notes": "Two distinct witness keys, one operator. Counting keys instead of controlling organizations would let a single operator satisfy a two-organization requirement alone, which empties the requirement of meaning.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 2,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
