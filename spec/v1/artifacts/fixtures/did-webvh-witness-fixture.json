  "method_policy_cases": [
    {
      "name": "standard_witness_parameter_is_the_only_policy_source",
      "semantic_outcome": "accept",
      "notes": "The did:webvh 1.0 shape. threshold is within 1..witnesses.length and every witness id is a unique did:key. This is the only structure an Arkret verifier reads as witness policy.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 2,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            },
            {
              "id": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG"
            }
          ]
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "absent_witness_parameter_means_no_method_witness",
      "semantic_outcome": "accept",
      "notes": "Absence is not malformation. A DID that never declared method witnesses is legitimately unwitnessed at the method layer; deployment policy may still refuse to use it on high-risk paths, but that is an overlay decision and not a parse failure.",
      "parameters": {
        "method": "did:webvh:1.0"
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "aliased_witness_keys_fail_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "The single most dangerous case. A log carrying witnesses / witness_threshold instead of witness was produced against a non-standard dialect, so the true policy is unknown. Reading it as no policy would silently turn a DID that declares two witnesses into one that requires none, which is a fail-open, not a compatibility fallback.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witnesses": [
          "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2",
          "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG"
        ],
        "witness_threshold": 2
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "arkret_overlay_fields_inside_method_parameter_fail_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "profileMinThreshold / structuredWitnesses / watcherEvidence / maxAgeSeconds are Arkret deployment policy. Inside method history they force external verifiers to cope with unregistered keys, make policy rotation require rewriting DID history, and let a holder self-declare both the threshold and the evidence that satisfies it.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "profileMinThreshold": 1,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            }
          ],
          "structuredWitnesses": [
            {
              "did": "did:web:witness-a.example",
              "controllingOrg": "did:web:org-a.example"
            }
          ],
          "maxAgeSeconds": 3600
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "non_did_key_witness_id_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "did:webvh 1.0 constrains witness identifiers to did:key. Any other form describes something that is not a method witness.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "witnesses": [
            {
              "id": "did:web:witness-a.example"
            }
          ]
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "undecodable_did_key_witness_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "The witness id is shaped like a did:key and passes any pattern check, but its multibase payload does not decode to a well-formed public key compatible with the log's Data Integrity cryptosuite. did:webvh 1.0 requires this to be caught during parameter validation, not deferred to signature verification: an undecodable key that is allowed to occupy a threshold slot silently hollows out the threshold, because that slot can never be satisfied by any proof.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "witnesses": [
            {
              "id": "did:key:z6MkNOTAVALIDMULTIBASEPAYLOAD"
            }
          ]
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "cryptosuite_incompatible_witness_key_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "The X25519 multikey is decodable and has the right X25519 length, but validation_context selects eddsa-jcs-2022, which requires Ed25519 witness keys.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "witnesses": [
            {
              "id": "did:key:z6LSkKotYNWWMJ1xWXiDE2JEDEYgo1tVSNgtPt1uyVJg6QRU"
            }
          ]
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "threshold_above_witness_count_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "An unsatisfiable threshold is a declaration error, not an instruction to ignore witnessing.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 3,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            },
            {
              "id": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG"
            }
          ]
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "duplicate_witness_id_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_parameter_malformed",
      "notes": "A repeated id would let one key be counted twice toward threshold.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 2,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            },
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            }
          ]
        }
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "missing_witness_proofs_file_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_proofs_unavailable",
      "notes": "Policy is declared but did-witness.json is unreachable or has no entry for this versionId. Unavailable evidence is not absent policy.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            }
          ]
        }
      },
      "witness_proofs": {
        "version_id": "2-zFixtureVersionTwo",
        "proofs_available": false
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "proof_from_unlisted_signer_does_not_count",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_proof_invalid",
      "notes": "A syntactically fine proof signed by a key outside parameters.witness proves nothing about the declared witness set.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            }
          ]
        }
      },
      "witness_proofs": {
        "version_id": "2-zFixtureVersionTwo",
        "proofs_available": true,
        "signers": [
          "did:key:z6Mkg26jczDiqsPK4momfvhZTTyFefWEyxYiSisFJ2wWJFkg"
        ]
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "fewer_valid_proofs_than_threshold_fails_closed",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_threshold_not_met",
      "notes": "One valid proof against a declared threshold of two. Effective threshold is the strictest intersection of the method threshold and the deployment minimum, so a holder can raise this bar but never lower it.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 2,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
            },
            {
              "id": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG"
            }
          ]
        }
      },
      "witness_proofs": {
        "version_id": "2-zFixtureVersionTwo",
        "proofs_available": true,
        "signers": [
          "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
        ]
      },
      "validation_context": {
        "cryptosuite": "eddsa-jcs-2022"
      }
    },
    {
      "name": "holder_declared_threshold_cannot_lower_deployment_minimum",
      "semantic_outcome": "reject",
      "expected_reason_code": "webvh_witness_threshold_not_met",
      "notes": "The log declares threshold 1 while deployment policy requires 2. Effective threshold is 2; otherwise any holder could opt out of the deployment's witnessing requirement by editing its own log.",
      "parameters": {
        "method": "did:webvh:1.0",
        "witness": {
          "threshold": 1,
          "witnesses": [
            {
              "id": "did:key:z6MkhFwXNFWosLeugvSf4wcL9t3uuRXueGSFTRgSvHhWj5G2"
