  "projection_admission_contract": "Ordered transcript cases for the authority_commit_projection vectors. Every case fixes the initial committed state, the exact Events and their order, whether a covering RealmCommit exists and what it binds, the applicable domain CAS, the retry input, and the result observed through the SDK API. The absence of a shared effect is asserted explicitly (no accepted result, no shared current update, no fanout, no authorization basis) rather than encoded as a single pending flag. Each case names the SDK clause decision points it carries as \"<clause_id>/<decision_point_id>\".",
  "projection_admission_cases": [
    {
      "name": "ordinary_event_without_a_covering_commit_has_no_shared_effect",
      "vector_id": "ak.vector.authority_commit_projection.ordinary_event_requires_commit_before_shared_effect.v1",
      "covers_decision_points": [
        "AK-SDK-004/ordinary_event_has_no_shared_effect_before_its_commit",
        "AK-SDK-011/an_ordinary_event_is_not_admitted_from_a_local_projection_either"
      ],
      "initial_committed_state": {
        "stream": "realm_main",
        "committed_head": {
          "stream_position": 1
        },
        "authorization_instance": "grant_writer_active",
        "domain_cas": "absent"
      },
      "steps": [
        {
          "step": 1,
          "action": "submit",
          "event": "E_ordinary",
          "state_changing": false,
          "authorization_ref": "grant_writer_active",
          "covering_commit": null
        },
        {
          "step": 2,
          "action": "observe_through_sdk_api",
          "after_step": 1
        }
      ],
      "expected": {
        "reported_write_state": "queued",
        "shared_current_updated": false,
        "fanout_emitted": false,
        "usable_as_authorization_basis": false,
        "local_display": "draft_distinguishable_from_committed"
      },
      "note": "authorization_ref resolving in committed typed state is necessary, not sufficient; without a covering RealmCommit there is no accepted result and no shared effect"
    },
    {
      "name": "ordinary_event_becomes_committed_under_its_own_commit",
      "vector_id": "ak.vector.authority_commit_projection.ordinary_event_requires_commit_before_shared_effect.v1",
      "covers_decision_points": [
        "AK-SDK-004/ordinary_event_has_no_shared_effect_before_its_commit"
      ],
      "initial_committed_state": {
        "stream": "realm_main",
        "committed_head": {
          "stream_position": 1
        },
        "authorization_instance": "grant_writer_active",
        "domain_cas": "absent"
      },
      "steps": [
        {
          "step": 1,
          "action": "submit",
          "event": "E_ordinary",
          "state_changing": false,
          "authorization_ref": "grant_writer_active",
          "covering_commit": null
        },
        {
          "step": 2,
          "action": "deliver_commit",
          "event_ref": "E_ordinary",
          "stream": "realm_main",
          "stream_position": 2,
          "previous_commit_ref": "position_1",
          "governance_generation": 1,
          "signature": "valid"
        },
        {
          "step": 3,
          "action": "observe_through_sdk_api",
          "after_step": 2
        }
      ],
      "expected": {
        "reported_write_state": "committed",
        "shared_current_updated": true,
        "fanout_emitted": true,
        "usable_as_authorization_basis": true
      },
      "note": "the positive contrast: the same Event is consumable once, and only once, its Commit arrives"
    },
    {
      "name": "state_changing_event_waits_without_a_covering_commit",
