      },
      "steps": [
        {
          "step": 1,
          "action": "submit_ordered_batch",
          "batch": "ordinary",
          "slots": [
            {
              "slot": 0,
              "event": "E_grant_issue",
              "state_changing": true
            },
            {
              "slot": 1,
              "event": "E_dependent",
              "state_changing": true,
              "authorization_ref": "grant_issued_in_slot_0"
            }
          ]
        },
        {
          "step": 2,
          "action": "observe_through_sdk_api",
          "after_step": 1,
          "subject": "E_dependent"
        }
      ],
      "expected": {
        "slot_0": "queued",
        "slot_1_outcome": "rejected",
        "reason": "the slot 0 write has no RealmCommit yet, so it is not an authorization instance",
        "shared_current_updated": false,
        "writes_nothing_for_slot_1": true
      },
      "note": "the obligation is that in-batch projection cannot create authority, not that a batch may carry no authority source at all"
    },
