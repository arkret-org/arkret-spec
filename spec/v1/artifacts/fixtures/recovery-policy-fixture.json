  "semantic_cases": [
    {
      "name": "canonical_threshold_policy_uses_one_publication_signature_after_reconstruction",
      "threshold_k": 3,
      "active_recovery_signing_key_count": 1,
      "active_paired_hpke_key_count": 1,
      "publication_rule_issuer_set_equals_active_recovery_key_set": true,
      "publication_signature_threshold": 1,
      "expected": {
        "decision": "accept",
        "required_share_count": 3,
        "required_publication_signature_count": 1
      }
    },
    {
      "name": "missing_threshold_signing_or_paired_hpke_key_rejected",
      "variants": [
        {
          "variant": "missing_recovery_keys",
          "expected_error_code": "schema_violation"
        },
        {
          "variant": "missing_recovery_key_agreements",
          "expected_error_code": "schema_violation"
        },
        {
          "variant": "dangling_key_agreement_ref",
          "expected_error_code": "failed_precondition"
        }
      ],
      "expected_decision": "reject"
    },
    {
      "name": "threshold_publication_issuer_projection_mismatch_rejected",
      "variants": [
        {
          "variant": "issuer_missing_active_recovery_key",
          "expected_error_code": "failed_precondition"
        },
        {
          "variant": "issuer_contains_unknown_verification_method",
          "expected_error_code": "failed_precondition"
        },
        {
          "variant": "issuer_is_share_holder_did",
          "expected_error_code": "failed_precondition"
        },
        {
          "variant": "publication_threshold_copied_from_threshold_k",
          "expected_error_code": "schema_violation"
        }
      ],
      "expected_decision": "reject"
    },
    {
      "name": "canonical_pcr_event_follows_ordinary_ingress_and_seal",
      "event_kind": "ak.policy.set",
      "realm_profile": "ak.profile.principal_control_realm.v1",
      "payload_shape": [
        "policy_id",
        "value"
      ],
      "event_actor_matches_policy_principal": true,
      "event_scope_matches_principal_control_realm": true,
      "lease_actor_and_scope_match_event": true,
      "ordinary_event_admission_used": true,
      "control_seal_materialized": true,
      "expected": {
        "decision": "accept",
        "projection_saved": true,
        "acceptance_basis_immutable": true
      }
    },
    {
      "name": "policy_id_actor_scope_and_lease_mismatch_rejected",
      "variants": [
        {
          "variant": "payload_policy_id_differs_from_value_policy_id",
          "expected_error_code": "failed_precondition"
        },
        {
          "variant": "actor_differs_from_value_principal_id",
          "expected_error_code": "recovery_principal_isolation"
        },
        {
          "variant": "realm_is_not_principal_control_realm",
          "expected_error_code": "recovery_principal_isolation"
        },
        {
          "variant": "scope_ref_differs_from_principal_control_realm",
          "expected_error_code": "recovery_principal_isolation"
        },
        {
          "variant": "lease_actor_differs_from_event_actor",
          "expected_error_code": "proof_invalid"
        },
        {
          "variant": "lease_scope_differs_from_event_scope",
          "expected_error_code": "proof_invalid"
        }
      ],
      "expected_decision": "reject",
      "projection_saved": false
    },
    {
      "name": "pcr_policy_family_and_special_path_bypass_rejected",
      "variants": [
        {
          "variant": "non_recovery_policy_value",
          "expected_error_code": "schema_violation"
        },
        {
          "variant": "recovery_endpoint_skips_profile_allowlist",
          "expected_conformance_failure": true
        },
        {
          "variant": "recovery_endpoint_skips_event_reducer",
          "expected_conformance_failure": true
        },
        {
          "variant": "recovery_endpoint_skips_authorization_lease",
          "expected_error_code": "schema_violation"
        },
        {
          "variant": "recovery_endpoint_saves_before_control_seal",
          "expected_error_code": "frontier_unavailable"
        }
      ],
      "expected_decision": "reject",
      "projection_saved": false
    },
    {
      "name": "unsealed_retry_is_single_event_and_retry_safe",
      "same_event_id": true,
      "same_canonical_event_bytes": true,
      "control_seal_materialized": false,
      "expected": {
        "decision": "reject",
        "error_code": "frontier_unavailable",
        "second_event_created": false,
        "active_policy_advanced": false
      }
    }
  ],
  "minimum_independent_runners": 2
