{
  "profile": "ak.profile.morph.schema_migration_transformations.v1",
  "version": "2026-06-24",
  "suite": "morph_schema_migration",
  "runner": {
    "kind": "named_suite",
    "entrypoint": "ak.suite.morph.schema_migration.v1"
  },
  "description": "Deterministic ak.morph.schema_migrate transformation vectors (zh/models/morph.md §4.1 S3 + the migration profile additional_requirements.deterministic_transformation_must). Each vector seeds a Morph from input.fields with input.from_schema_refs, POSTs a ak.morph.schema_migrate carrying input.payload, then asserts the post-migration Morph fields projection equals expected_output under Arkret canonical JSON (sorted keys, no whitespace). expected_output_digest is sha256 over those canonical bytes. The transformation_rules[] dialect ids are the canonical ak.transform.*.v1 set the profile transformation_rules_v1_grammar declares. Schema ids are the registered reference profiles ak.schema.morph.customer_risk.v1 and its additive extension ak.schema.morph.customer_risk.ext.v1.",
  "covers_vectors": [
    "ak.vector.morph.transformation_identity.v1",
    "ak.vector.morph.transformation_rename.v1",
    "ak.vector.morph.transformation_type_widen.v1",
    "ak.vector.morph.transformation_default_backfill.v1"
  ],
  "vectors": [
    {
      "vector_id": "ak.vector.morph.transformation_identity.v1",
      "kind": "morph_schema_migrate_transformation",
      "description": "Identity transformation preserves all fields and canonical values.",
      "input": {
        "morph_kind": "customer_risk",
        "from_schema_refs": [
          "ak.schema.morph.customer_risk.v1"
        ],
        "fields": {
          "risk_score": 7,
          "status": "open"
        },
        "payload": {
          "from_schema_refs": [
            "ak.schema.morph.customer_risk.v1"
          ],
          "to_schema_refs": [
            "ak.schema.morph.customer_risk.v1"
          ],
          "compatibility_class": "transformation",
          "transformation_rules": [
            {
              "rule": "ak.transform.identity.v1"
            }
          ]
        }
      },
      "expected_output": {
        "risk_score": 7,
        "status": "open"
      },
      "expected_output_digest": "sha256:be821986e41569d5b57dd22365fd68552b4d674235d993ea62959c12fbcfaa79"
    },
    {
      "vector_id": "ak.vector.morph.transformation_rename.v1",
      "kind": "morph_schema_migrate_transformation",
      "description": "A field-rename transformation: fields.risk_score is renamed to fields.score; the unrelated fields.status passes through untouched. Pure rename, replay-deterministic.",
      "input": {
        "morph_kind": "customer_risk",
        "from_schema_refs": [
          "ak.schema.morph.customer_risk.v1"
        ],
        "fields": {
          "risk_score": 7,
          "status": "open"
        },
        "payload": {
          "from_schema_refs": [
            "ak.schema.morph.customer_risk.v1"
          ],
          "to_schema_refs": [
            "ak.schema.morph.customer_risk.v1",
            "ak.schema.morph.customer_risk.ext.v1"
          ],
          "compatibility_class": "transformation",
          "transformation_rules": [
            {
              "rule": "ak.transform.rename.v1",
              "from": "risk_score",
              "to": "score"
            }
          ]
        }
      },
      "expected_output": {
        "score": 7,
        "status": "open"
      },
      "expected_output_digest": "sha256:26963200f86db72ffe26be9f61c6d0fd69520da45d7789846991410642623002"
    },
    {
      "vector_id": "ak.vector.morph.transformation_default_backfill.v1",
      "kind": "morph_schema_migrate_transformation",
      "description": "A default-backfill transformation: a new optional field fields.priority is backfilled with the deterministic default \"normal\" while existing fields.status is preserved. Backfill is idempotent (it never overwrites a present value).",
      "input": {
        "morph_kind": "customer_risk",
        "from_schema_refs": [
          "ak.schema.morph.customer_risk.v1"
        ],
        "fields": {
          "status": "open"
        },
        "payload": {
          "from_schema_refs": [
            "ak.schema.morph.customer_risk.v1"
          ],
          "to_schema_refs": [
            "ak.schema.morph.customer_risk.v1",
            "ak.schema.morph.customer_risk.ext.v1"
          ],
          "compatibility_class": "transformation",
          "transformation_rules": [
            {
              "rule": "ak.transform.default_backfill.v1",
              "to": "priority",
              "value": "normal"
            }
          ]
        }
      },
      "expected_output": {
        "priority": "normal",
        "status": "open"
      },
      "expected_output_digest": "sha256:2e65212a3ffcf95965be6a743922ae0e5d4231dfe4d842551e3da2b0118d815e"
    },
    {
      "vector_id": "ak.vector.morph.transformation_type_widen.v1",
      "kind": "morph_schema_migrate_transformation",
      "description": "Integer-to-number widening preserves the JSON numeric value while changing its declared schema acceptance set.",
      "input": {
        "morph_kind": "customer_risk",
        "from_schema_refs": [
          "ak.schema.morph.customer_risk.v1"
        ],
        "fields": {
          "confidence": 7,
          "status": "open"
        },
        "payload": {
          "from_schema_refs": [
            "ak.schema.morph.customer_risk.v1"
          ],
          "to_schema_refs": [
            "ak.schema.morph.customer_risk.v1",
            "ak.schema.morph.customer_risk.ext.v1"
          ],
          "compatibility_class": "transformation",
          "transformation_rules": [
            {
              "rule": "ak.transform.type_widen.v1",
              "field": "confidence",
              "from_kind": "integer",
              "to_kind": "number"
            }
          ]
        }
      },
      "expected_output": {
        "confidence": 7,
        "status": "open"
      },
      "expected_output_digest": "sha256:3894463f741ab60b7eaad3b1917aa0fefaf6c1be14721618c19aea4b775fbdc4"
    }
  ]
}
