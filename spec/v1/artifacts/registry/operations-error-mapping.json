{
  "$schema": "https://cokret.dev/spec/v1/artifacts/registry/operations-error-mapping.schema.json",
  "version": "2026-06-10",
  "kind": "operations_error_mapping",
  "source_role": "canonical",
  "source_of_truth": true,
  "description": "Canonical mapping from canonical operation_id (artifacts/registry/operation-registry.json) to the error codes the operation MAY emit. Derived from prose error policy in zh/sync/service-http-binding.md §2.3 and from error-code-registry.json scope/description. Receivers of an operation SHOULD treat any error code listed here as a known reply shape; codes that map only to the universal failure surface (e.g. internal_error, service_unavailable) are not repeated per operation. cross-link target for zh/sync/service-http-binding.md §2.3.",
  "rules": {
    "universal_codes": "Every protected operation MAY additionally return any of: unauthenticated, auth_expired, soft_logged_out, did_proof_required, invalid_signature, capability_denied, schema_violation, bad_json, bad_query, missing_param, invalid_param, rate_limited, too_large, conflict, internal_error, service_unavailable, not_implemented, unsupported_feature, unsupported_event_kind. These are the universal failure surface and are NOT repeated in each operation entry.",
    "operation_specific": "operation_specific[] lists the error codes that are semantically tied to this operation's domain logic (event ingest, key claim, blob upload, push gateway, directory ingest, ...). An entry may name either a top-level code from error-code-registry.json `codes` or a sub-code from its `reason_codes` section (carried under a top-level code such as failed_precondition or schema_violation). Consumers discriminate by first matching the entry against the registry's top-level `codes` set; an entry not found there is a reason_code and matches the error reply's `reason_code` field rather than its top-level `code`. Receivers SHOULD recognize and surface these codes specifically.",
    "endpoint_aliases": "Each operation entry lists its canonical HTTP method+path alias for human navigation; alternative bindings (gRPC, MQ) inherit the same error code set.",
    "operation_coverage": "Every operation_id in artifacts/registry/operation-registry.json MUST appear exactly once in operations[]. An empty operation_specific[] means the operation has no domain-specific reply shape beyond the universal failure surface."
  },
  "operations": [
    {
      "operation_id": "ck.gate.account.command.register",
      "http_alias": "POST /_cokret/gate/account/register",
      "operation_specific": [
        "proof_invalid",
        "duplicate_conflict",
        "failed_precondition"
      ],
      "description": "Account registration creates or binds a deployment-local account record to principal_id. The request uses principal_id rather than did, does not accept handle, and handle evidence can only be returned as signed ck.schema.handle_claim.v1 data or digest/ref."
    },
    {
      "operation_id": "ck.gate.account.command.pair_device",
      "http_alias": "POST /_cokret/gate/account/device-pair",
      "operation_specific": [],
      "description": "No operation-specific error codes beyond the universal failure surface."
    },
    {
      "operation_id": "ck.gate.account.command.issue_session_grant",
      "http_alias": "POST /_cokret/gate/account/session-grants",
      "operation_specific": [
        "audience_unknown",
        "proof_invalid",
        "verification_method_principal_mismatch",
        "agent_paused",
        "agent_deactivated",
        "accountability_grant_missing"
      ],
      "description": "Session grant issuance. Shared by human user_session and agent runtime branches (CKP-0008 §4.6): when `proof.proof_kind=\"agent_key_proof\"`, agent-specific failure codes apply — `proof_invalid` for transcript / nonce / audience binding failures of the agent_key_proof, `verification_method_principal_mismatch` when the verification_method DID does not match `principal_id`, `agent_paused` / `agent_deactivated` for lifecycle-gated rejections of the target agent principal, and `accountability_grant_missing` when the controller's accountability grant over the agent has been revoked or lapsed its freshness window so the agent is no longer eligible to receive a session grant (zh/identity/account-lifecycle.md §9.1)."
    },
    {
      "operation_id": "ck.gate.account.command.revoke_session",
      "http_alias": "POST /_cokret/gate/account/session-grants/revoke",
      "operation_specific": [
        "session_grant_not_found",
        "session_revoke_selector_conflict",
        "proof_invalid"
      ],
      "description": "Session grant/access-token revocation. Empty body revokes the current request's session grant; cross grant/device/all_sessions selectors require fresh proof and never revoke device authorization or write durable ck.account.status."
    },
    {
      "operation_id": "ck.gate.account.command.pair_agent_key",
      "http_alias": "POST /_cokret/gate/account/agent-key-pair",
      "operation_specific": [
        "verification_method_principal_mismatch",
        "pairing_request_expired",
        "proof_invalid",
        "agent_deactivated"
      ],
      "description": "Native personal agent runtime key pairing (CKP-0008 §4.5). 412 responses use these codes; pairing into an already-deactivated agent principal is terminal."
    },
    {
      "operation_id": "ck.self.agent.command.provision",
      "http_alias": "POST /_cokret/self/agents",
      "operation_specific": [
        "failed_precondition",
        "accountability_grant_missing"
      ],
      "description": "Provision a native personal agent principal (CKP-0008). The op is the aggregate `ck.self.agent.command.provision` capability action (capability-action-registry.json) and fans out `ck.profile.create` + `ck.identity.accountability_grant` + `ck.agent.key.authorize` + `ck.capability.grant`. `accountability_grant_missing` is returned when the orchestrator cannot write or validate the fan-out `ck.identity.accountability_grant` (controller lacks `ck.self.agent.command.provision` authority or its required constraints, the candidate grant fails accountability schema checks, or a concurrent state cell makes the grant unauditable). Other ineligibility reasons surface as `failed_precondition`."
    },
    {
      "operation_id": "ck.self.agent.query.list",
      "http_alias": "GET /_cokret/self/agents",
      "operation_specific": [
        "cursor_invalid"
      ]
    },
    {
      "operation_id": "ck.self.agent.resource.get",
      "http_alias": "GET /_cokret/self/agents/{agent_principal_id}",
      "operation_specific": [
        "not_found"
      ],
      "description": "not_found is returned both for nonexistent agent principals and for agents not visible to the caller (uniform failure surface, matches ck.self.events.resource.get pattern)."
    },
    {
      "operation_id": "ck.self.agent.command.pause",
