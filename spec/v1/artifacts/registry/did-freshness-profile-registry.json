{
  "version": "2026-08-29.1",
  "source_of_truth": true,
  "description": "Canonical registry of the did-usage-and-verification.md section 5.4 freshness profile ids a DID authority call site may reference. Registration fixes the id and its risk_tier; the numeric windows are declared per deployment and enter profile_policy of the section 5.3 resolver policy snapshot, so no network-wide minute count is implied.",
  "registry_rules": [
    "freshness_profile_id values MUST be unique and MUST match ^ak\\.did_freshness\\.[a-z0-9_]+\\.v[0-9]+$",
    "Every current-DID authority call site MUST reference exactly one registered freshness_profile_id; accepted_at_history verifier actions carry freshness_profile_id=null and are pinned to their registered historical position; natural-language tier guessing is forbidden",
    "An unknown id, an unregistered action or a non-matching did_method_selector MUST be treated as the high tier with synchronous_refresh_or_fail_closed; there is no path that defaults to accepting any cached binding",
    "risk_tier is fixed by registration. A deployment declares only the numeric windows, which MUST satisfy the tier constraints in did-usage-and-verification.md section 5.4",
    "Adding a profile is a backward-compatible minor; changing an existing profile's risk_tier requires a new id",
    "call_sites is the exhaustive bidirectional map. Every row MUST byte-match did_authority on the corresponding operation or event-kind source row; risk_tier never creates an implicit call site"
  ],
  "evidence_classes": [
    {
      "evidence_class": "registration_control",
      "requires_current_did": true,
      "failure_code": "current_did_authority_unavailable"
    },
    {
      "evidence_class": "accepted_at_history",
      "requires_current_did": false,
      "freshness_profile_id": null,
      "failure_code": "historical_did_evidence_invalid"
    },
    {
      "evidence_class": "pcr_authority",
      "requires_current_did": false,
      "freshness_profile_id": null,
      "failure_code": "pcr_authority_stale"
    },
    {
      "evidence_class": "current_external_claim",
      "requires_current_did": true,
      "failure_code": "current_did_authority_unavailable"
    },
    {
      "evidence_class": "method_successor",
      "requires_current_did": true,
      "failure_code": "did_method_successor_invalid"
    },
    {
      "evidence_class": "optional_did_root_recovery",
      "requires_current_did": true,
      "failure_code": "current_did_authority_unavailable"
    },
    {
      "evidence_class": "ongoing_governance",
      "requires_current_did": true,
      "failure_code": "current_did_authority_unavailable"
    }
  ],
