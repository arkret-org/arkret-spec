{
  "version": "2026-08-16.1",
  "source_of_truth": true,
  "description": "Closed outward-exposure decision for every event kind admitted into a Principal Control Realm. ak.profile.principal_control_realm.v1 realm_event_kind_policy.allowed_event_kinds closes the write direction; this registry closes the read direction. A kind with an empty exposures[] is PCR-private and MUST NOT be reachable through any ak.open.* / ak.peer.* / cross-principal ak.self.* surface or public DID Document entry. A kind with exposures[] declares every path by which it legitimately leaves the Realm, each with its carrier form, exact schema location and gating authorization policy. Adding an outward path without registering it here is a release-gate failure, not an implementation detail.",
  "registry_rules": [
    "The event_kind set MUST equal ak.profile.principal_control_realm.v1 realm_event_kind_policy.allowed_event_kinds exactly. A kind admitted for write with no exposure decision, and an exposure decision for a kind that cannot be written, both fail the gate.",
    "exposures[] is a list, not a single value: one kind MAY leave the Realm through several independent paths, and each path carries its own authorization policy.",
    "An empty exposures[] means PCR-private. The gate rejects a private kind whose literal kind string is reachable inside any outward carrier schema fragment registered here.",
    "carrier declares what actually crosses the boundary: exact_event is the verbatim signed Event, derived_field is a projected value, receipt and seal are acceptance evidence over the Event, did_service_entry is a public DID Document service entry.",
    "authorization_policy_id and anti_enumeration_policy_id MUST reference a policy registered below. public is an explicit policy value; a missing authorization_policy_id is never read as public.",
    "Every exposure resolves exactly one reusable outward disclosure policy through outward_disclosure_policy_mapping, unless it carries an explicit outward_disclosure_policy_id override. The referenced policy is defined in outward-disclosure-policy-registry.json.",
    "surface=operation requires an operation_id registered in operation-registry.json and a direction of request or response. surface=did_document carries no operation_id because a DID Document is published outside the operation registry."
  ],
  "carrier_kinds": {
    "exact_event": "The verbatim signed Event Envelope, byte-preserved by the carrier.",
    "derived_field": "A value projected from the Event or from the cell it writes; not the Event itself.",
    "receipt": "Signed acceptance evidence naming the Event.",
    "seal": "An accepted Seal disclosed as coverage evidence for the named Event digest.",
    "did_service_entry": "A service entry in a publicly resolvable DID Document."
  },
  "surface_kinds": {
    "operation": "A registered service operation in operation-registry.json.",
    "did_document": "A publicly resolvable DID Document, outside the operation registry."
  },
  "outward_disclosure_policy_mapping": {
    "public_authorization_policy_id": "ak.pcr_exposure_policy.public.v1",
    "public_policy_id": "ak.outward_disclosure.public.v1",
    "anti_enumeration_policy_ids": {
      "ak.pcr_anti_enumeration.indistinguishable_not_found.v1": "ak.outward_disclosure.private_not_found.v1",
      "ak.pcr_anti_enumeration.single_valued_failure.v1": "ak.outward_disclosure.private_single_failure.v1",
      "ak.pcr_anti_enumeration.rate_limited_uniform_failure.v1": "ak.outward_disclosure.target_private_claim.v1"
    },
    "authenticated_default_policy_id": "ak.outward_disclosure.authenticated_exact.v1"
  },
  "authorization_policies": [
    {
      "policy_id": "ak.pcr_exposure_policy.current_holder_authorized.v1",
      "description": "Current holder session bound to the exact target account authority pair. A recovery actor first completes the existing recovery transaction and becomes current holder; caller-declared intent is never authorization."
    },
    {
      "policy_id": "ak.pcr_exposure_policy.shared_realm_membership.v1",
      "description": "Caller and subject are both effective joined members of the request Collaboration Realm at evaluation time. That Realm MUST NOT be a Principal Control Realm."
    },
    {
      "policy_id": "ak.pcr_exposure_policy.relationship_or_shared_context.v1",
      "description": "A current authorization relationship between caller and subject: a shared Realm the caller is joined to, or a current call, session or Contact context."
    },
    {
      "policy_id": "ak.pcr_exposure_policy.federation_peer_service_auth.v1",
      "description": "Authenticated federation peer service with Source/Destination service DID and Content-Digest binding over the exact carrier bytes."
    },
    {
      "policy_id": "ak.pcr_exposure_policy.account_authority_service_auth.v1",
      "description": "Authenticated Account Authority or Principal Server service call carrying that operation's own authority evidence."
    },
    {
      "policy_id": "ak.pcr_exposure_policy.contact_pending_verified_mirror_target.v1",
      "description": "Authenticated exact target holder with a pending_incoming Contact row and a CAS-persisted verified mirror whose Event bytes and source receipt bind the requested ak.contact.requested Event."
    },
    {
      "policy_id": "ak.pcr_exposure_policy.public.v1",
      "description": "Deliberately unauthenticated. Only a value the subject itself chose to publish may use this policy."
    }
  ],
  "anti_enumeration_policies": [
    {
      "policy_id": "ak.pcr_anti_enumeration.indistinguishable_not_found.v1",
      "description": "Unknown subject, wrong authority pair and unauthorized caller share one not_found outcome."
    },
    {
      "policy_id": "ak.pcr_anti_enumeration.single_valued_failure.v1",
      "description": "Per-subject failure uses a single value, so absent, withheld and unauthorized are indistinguishable."
    },
    {
      "policy_id": "ak.pcr_anti_enumeration.rate_limited_uniform_failure.v1",
      "description": "Uniform failure shape plus a registered per-caller rate limit on the subject selector."
    }
  ],
