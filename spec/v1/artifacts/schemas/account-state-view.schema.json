{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/account-state-view.schema.json",
  "title": "Arkret Account current state",
  "description": "Account Station view of authority-committed typed current state selected by closed domain selectors.",
  "oneOf": [
    {
      "$ref": "#/$defs/current"
    },
    {
      "$ref": "#/$defs/coverage"
    }
  ],
  "$defs": {
    "current": {
      "type": "object",
      "required": [
        "realm_id",
        "governance_generation",
        "stream_heads",
        "entries"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "governance_generation": {
          "description": "Station tenure these entries and stream heads were read under.",
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "stream_heads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-commit.schema.json#/$defs/stream_head"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "./current-state.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "realm_id",
        "stream_heads",
        "complete_for_authorized_streams"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "stream_heads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-commit.schema.json#/$defs/stream_head"
          }
        },
        "complete_for_authorized_streams": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
