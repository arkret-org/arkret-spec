{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/seal-conclusion.schema.json",
  "title": "Arkret Seal Conclusion",
  "description": "Exact, scope-authorized governance result proofs authenticated by the sole frozen authority. See cbs-profiles section 9.",
  "$ref": "#/$defs/conclusion_set",
  "$defs": {
    "cell_state": {
      "type": "object",
      "required": [
        "revision_event_id",
        "value"
      ],
      "properties": {
        "revision_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "value": {
          "description": "Complete registered business value of this exact sequenced_state Cell. Validate against its canonical cell contract, never arbitrary caller JSON."
        }
      },
      "additionalProperties": false
    },
    "cell_selector": {
      "type": "object",
      "required": [
        "kind",
        "cell_id"
      ],
      "properties": {
        "kind": {
          "const": "cell"
        },
        "cell_id": {
          "$ref": "./event-envelope.schema.json#/$defs/cell_ref"
        }
      },
      "additionalProperties": false
    },
    "cell_result": {
      "type": "object",
      "required": [
        "selector",
        "state"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/cell_selector"
        },
        "state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cell_state"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "cell_range_selector": {
      "type": "object",
      "required": [
        "kind",
        "lower_cell_id",
        "upper_cell_id"
      ],
      "properties": {
        "kind": {
          "const": "cell_range"
        },
        "lower_cell_id": {
          "$ref": "./event-envelope.schema.json#/$defs/cell_ref"
        },
        "upper_cell_id": {
          "$ref": "./event-envelope.schema.json#/$defs/cell_ref"
        }
      },
      "additionalProperties": false
    },
    "cell_range_result": {
      "type": "object",
      "required": [
        "selector",
        "cells"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/cell_range_selector"
        },
        "cells": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "cell_id",
              "state"
            ],
            "properties": {
              "cell_id": {
                "$ref": "./event-envelope.schema.json#/$defs/cell_ref"
              },
              "state": {
                "$ref": "#/$defs/cell_state"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "command_selector": {
      "type": "object",
      "required": [
        "kind",
        "event_digest"
      ],
      "properties": {
        "kind": {
          "const": "command"
        },
        "event_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "command_result": {
      "type": "object",
      "required": [
        "selector",
        "result"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/command_selector"
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "./seal.schema.json#/$defs/command_result"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "command_effect_selector": {
      "type": "object",
      "required": [
        "kind",
        "event_digest",
        "cell_id"
      ],
      "properties": {
        "kind": {
          "const": "command_effect"
        },
        "event_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/digest"
        },
        "cell_id": {
          "$ref": "./event-envelope.schema.json#/$defs/cell_ref"
        }
      },
      "additionalProperties": false
    },
    "command_effect_result": {
      "type": "object",
      "required": [
        "selector",
        "state"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/command_effect_selector"
        },
        "state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cell_state"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ancestry_selector": {
      "type": "object",
      "required": [
        "kind",
        "ancestor_seal_ref"
      ],
      "properties": {
        "kind": {
          "const": "ancestry"
        },
        "ancestor_seal_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        }
      },
      "additionalProperties": false
    },
    "ancestry_result": {
      "type": "object",
      "required": [
        "selector",
        "is_ancestor"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/ancestry_selector"
        },
        "is_ancestor": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/cell_selector"
        },
        {
          "$ref": "#/$defs/cell_range_selector"
        },
        {
          "$ref": "#/$defs/command_selector"
        },
        {
          "$ref": "#/$defs/command_effect_selector"
        },
        {
          "$ref": "#/$defs/ancestry_selector"
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/cell_result"
        },
        {
          "$ref": "#/$defs/cell_range_result"
        },
        {
          "$ref": "#/$defs/command_result"
        },
        {
          "$ref": "#/$defs/command_effect_result"
        },
        {
          "$ref": "#/$defs/ancestry_result"
        }
      ]
    },
    "query": {
      "type": "object",
      "required": [
        "target_seal_ref",
        "selectors"
      ],
      "properties": {
        "target_seal_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/selector"
          },
          "uniqueItems": true
        },
        "known_configuration_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "description": "Optional transfer hint naming an already authenticated receiver configuration. It grants no trust or visibility, is not part of immutable result signatures, and only allows omission of a handoff prefix the receiver independently possesses."
        }
      },
      "additionalProperties": false,
      "description": "Exact historical query. Selectors are JCS-byte sorted, unique, registered-operation-derived and individually authorized. Cell ranges are complete half-open Unicode CellRef intervals; there is no arbitrary predicate or latest query."
    },
    "statement": {
      "type": "object",
      "required": [
        "realm_id",
        "configuration_ref",
        "authority_seal_ref",
        "target_seal_ref",
        "results"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "configuration_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "authority_seal_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "target_seal_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "additionalProperties": false,
      "description": "Immutable exact read facts at target, an ancestor-or-self of authority_seal_ref. The signer must durably possess and have fully validated the target state and execution result."
    },
    "certificate": {
      "type": "object",
      "required": [
        "statement",
        "signature"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/statement"
        },
        "signature": {
          "$ref": "./seal.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "JWS payload is RFC8785 JCS({context:\"ak.seal.conclusion.v1\",statement}). payload_digest is SHA-256 of that payload. This is a single-authority read attestation, not a Seal commit, controller authorization, freshness lease or proof of data availability.",
      "x-arkret-max-canonical-bytes": 8388608
    },
    "handoff_statement": {
      "type": "object",
      "required": [
        "realm_id",
        "configuration_ref",
        "handoff_seal_ref",
        "next_configuration_ref",
        "next_configuration"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "configuration_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "handoff_seal_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "next_configuration_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "next_configuration": {
          "$ref": "./realm.schema.json#/$defs/notary_configuration"
        }
      },
      "additionalProperties": false,
      "description": "The previous sole authority authenticates its accepted final replacement Seal, exact successor configuration and permanent end of its write authority. The successor cannot authenticate itself."
    },
    "handoff_certificate": {
      "type": "object",
      "required": [
        "statement",
        "signature"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/handoff_statement"
        },
        "signature": {
          "$ref": "./seal.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "JWS payload is RFC8785 JCS({context:\"ak.seal.configuration_handoff.v1\",statement}); payload_digest uses SHA-256. Persist the complete certificate with the successor before activating that successor; it is never self-authorized by the new keys."
    },
    "conclusion_set": {
      "type": "object",
      "required": [
        "configuration_handoffs",
        "conclusions"
      ],
      "properties": {
        "configuration_handoffs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/handoff_certificate"
          }
        },
        "conclusions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/certificate"
          }
        }
      },
      "additionalProperties": false,
      "description": "Authenticated from an independently verified Realm genesis configuration or durable trusted configuration. Handoffs follow installation order without gaps, loops or unrelated entries. This container is unsigned; each enclosed certificate is independently verified. Missing genesis dependencies use existing exact dependency resolution. No implicit trust in candidate-supplied configurations."
    }
  }
}
