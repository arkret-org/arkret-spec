{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/protocol-journey-traceability.schema.json",
  "title": "Arkret Protocol Journey Static Traceability Registry",
  "description": "Closed static A-J, CJ01-CJ22 and PJ01-PJ18 contract map. Revision SHAs, execution status, results, runtime evidence, attestation payloads and self references are deliberately not fields of this schema.",
  "type": "object",
  "required": [
    "version",
    "source_of_truth",
    "description",
    "closed_world",
    "evidence_boundary",
    "resolution_rule",
    "contract_families",
    "journeys"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "source_of_truth": { "const": true },
    "description": { "type": "string", "minLength": 1 },
    "closed_world": { "const": true },
    "evidence_boundary": { "$ref": "#/$defs/evidence_boundary" },
    "resolution_rule": { "type": "string", "minLength": 1 },
    "contract_families": { "$ref": "#/$defs/contract_families" },
    "journeys": { "$ref": "#/$defs/journeys" }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence_boundary": {
      "type": "object",
      "required": [
        "static_contract_only",
        "execution_evidence_is_external",
        "self_reference_forbidden",
        "runtime_or_release_evidence_fields_forbidden"
      ],
      "properties": {
        "static_contract_only": { "const": true },
        "execution_evidence_is_external": { "const": true },
        "self_reference_forbidden": { "const": true },
        "runtime_or_release_evidence_fields_forbidden": { "const": true }
      },
      "additionalProperties": false
    },
    "static_ref": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(?:^|/)protocol-journey-traceability(?:\\.json)?(?:#|$)" }
    },
    "static_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ak\\.[a-z0-9_]+(?:[.-][a-z0-9_]+)+$"
    },
    "consumer": {
      "type": "string",
      "enum": [
        "arkret-rust-sdk",
        "soland",
        "soland-contracts",
        "garth",
        "coauth",
        "sodmin",
        "inkson",
        "savfox",
        "chime",
        "yoface",
        "bridges",
        "floria",
        "starid",
        "teabay",
        "cotest"
      ]
    },
    "contract_family": {
      "type": "object",
      "required": [
        "prose_refs",
        "schema_pointers",
        "operation_ids",
        "event_kinds",
        "action_ids",
        "profile_ids",
        "authority_source_ids",
        "vector_ids",
        "lint_rule_ids",
        "consumers"
      ],
      "properties": {
        "prose_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_ref" },
          "minItems": 1,
          "uniqueItems": true
        },
        "schema_pointers": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/static_ref" },
              { "pattern": "^spec/v1/artifacts/schemas/[^#]+\\.json#(?:/.*)?$" }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operation_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "event_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "action_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "profile_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "authority_source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_id" },
          "uniqueItems": true
        },
        "vector_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/static_id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "lint_rule_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contract_families": {
      "type": "object",
      "required": [
        "bootstrap_and_holder_binding",
        "contact_and_resolver",
        "personal_agent_lifecycle",
        "participation_and_attribution",
        "stable_dm_operation_control",
        "membership_join_compensation",
        "history_ingress_keypackage",
        "sidecar",
        "signer_and_planner",
        "static_release_traceability"
      ],
      "properties": {
        "bootstrap_and_holder_binding": { "$ref": "#/$defs/contract_family" },
        "contact_and_resolver": { "$ref": "#/$defs/contract_family" },
        "personal_agent_lifecycle": { "$ref": "#/$defs/contract_family" },
        "participation_and_attribution": { "$ref": "#/$defs/contract_family" },
        "stable_dm_operation_control": { "$ref": "#/$defs/contract_family" },
        "membership_join_compensation": { "$ref": "#/$defs/contract_family" },
        "history_ingress_keypackage": { "$ref": "#/$defs/contract_family" },
        "sidecar": { "$ref": "#/$defs/contract_family" },
        "signer_and_planner": { "$ref": "#/$defs/contract_family" },
        "static_release_traceability": { "$ref": "#/$defs/contract_family" }
      },
      "additionalProperties": false
    },
    "contract_family_id": {
      "type": "string",
      "enum": [
        "bootstrap_and_holder_binding",
        "contact_and_resolver",
        "personal_agent_lifecycle",
        "participation_and_attribution",
        "stable_dm_operation_control",
        "membership_join_compensation",
        "history_ingress_keypackage",
        "sidecar",
        "signer_and_planner",
        "static_release_traceability"
      ]
    },
    "journey_row": {
      "type": "object",
      "required": ["journey_id", "contract_family"],
      "properties": {
        "journey_id": {
          "type": "string",
          "enum": [
            "A", "B", "C", "D", "E", "F", "G", "H", "I", "J",
            "CJ01", "CJ02", "CJ03", "CJ04", "CJ05", "CJ06", "CJ07", "CJ08", "CJ09", "CJ10", "CJ11", "CJ12", "CJ13", "CJ14", "CJ15", "CJ16", "CJ17", "CJ18", "CJ19", "CJ20", "CJ21", "CJ22",
            "PJ01", "PJ02", "PJ03", "PJ04", "PJ05", "PJ06", "PJ07", "PJ08", "PJ09", "PJ10", "PJ11", "PJ12", "PJ13", "PJ14", "PJ15", "PJ16", "PJ17", "PJ18"
          ]
        },
        "contract_family": { "$ref": "#/$defs/contract_family_id" }
      },
      "additionalProperties": false
    },
    "journeys": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/journey_a" },
        { "$ref": "#/$defs/journey_b" },
        { "$ref": "#/$defs/journey_c" },
        { "$ref": "#/$defs/journey_d" },
        { "$ref": "#/$defs/journey_e" },
        { "$ref": "#/$defs/journey_f" },
        { "$ref": "#/$defs/journey_g" },
        { "$ref": "#/$defs/journey_h" },
        { "$ref": "#/$defs/journey_i" },
        { "$ref": "#/$defs/journey_j" },
        { "$ref": "#/$defs/journey_cj01" },
        { "$ref": "#/$defs/journey_cj02" },
        { "$ref": "#/$defs/journey_cj03" },
        { "$ref": "#/$defs/journey_cj04" },
        { "$ref": "#/$defs/journey_cj05" },
        { "$ref": "#/$defs/journey_cj06" },
        { "$ref": "#/$defs/journey_cj07" },
        { "$ref": "#/$defs/journey_cj08" },
        { "$ref": "#/$defs/journey_cj09" },
        { "$ref": "#/$defs/journey_cj10" },
        { "$ref": "#/$defs/journey_cj11" },
        { "$ref": "#/$defs/journey_cj12" },
        { "$ref": "#/$defs/journey_cj13" },
        { "$ref": "#/$defs/journey_cj14" },
        { "$ref": "#/$defs/journey_cj15" },
        { "$ref": "#/$defs/journey_cj16" },
        { "$ref": "#/$defs/journey_cj17" },
        { "$ref": "#/$defs/journey_cj18" },
        { "$ref": "#/$defs/journey_cj19" },
        { "$ref": "#/$defs/journey_cj20" },
        { "$ref": "#/$defs/journey_cj21" },
        { "$ref": "#/$defs/journey_cj22" },
        { "$ref": "#/$defs/journey_pj01" },
        { "$ref": "#/$defs/journey_pj02" },
        { "$ref": "#/$defs/journey_pj03" },
        { "$ref": "#/$defs/journey_pj04" },
        { "$ref": "#/$defs/journey_pj05" },
        { "$ref": "#/$defs/journey_pj06" },
        { "$ref": "#/$defs/journey_pj07" },
        { "$ref": "#/$defs/journey_pj08" },
        { "$ref": "#/$defs/journey_pj09" },
        { "$ref": "#/$defs/journey_pj10" },
        { "$ref": "#/$defs/journey_pj11" },
        { "$ref": "#/$defs/journey_pj12" },
        { "$ref": "#/$defs/journey_pj13" },
        { "$ref": "#/$defs/journey_pj14" },
        { "$ref": "#/$defs/journey_pj15" },
        { "$ref": "#/$defs/journey_pj16" },
        { "$ref": "#/$defs/journey_pj17" },
        { "$ref": "#/$defs/journey_pj18" }
      ],
      "items": false,
      "minItems": 50,
      "maxItems": 50
    },
    "journey_a": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "A" }, "contract_family": { "const": "personal_agent_lifecycle" } } } ] },
    "journey_b": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "B" }, "contract_family": { "const": "personal_agent_lifecycle" } } } ] },
    "journey_c": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "C" }, "contract_family": { "const": "membership_join_compensation" } } } ] },
    "journey_d": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "D" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_e": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "E" }, "contract_family": { "const": "participation_and_attribution" } } } ] },
    "journey_f": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "F" }, "contract_family": { "const": "personal_agent_lifecycle" } } } ] },
    "journey_g": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "G" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_h": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "H" }, "contract_family": { "const": "signer_and_planner" } } } ] },
    "journey_i": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "I" }, "contract_family": { "const": "stable_dm_operation_control" } } } ] },
    "journey_j": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "J" }, "contract_family": { "const": "signer_and_planner" } } } ] },
    "journey_cj01": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ01" }, "contract_family": { "const": "bootstrap_and_holder_binding" } } } ] },
    "journey_cj02": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ02" }, "contract_family": { "const": "bootstrap_and_holder_binding" } } } ] },
    "journey_cj03": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ03" }, "contract_family": { "const": "bootstrap_and_holder_binding" } } } ] },
    "journey_cj04": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ04" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_cj05": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ05" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_cj06": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ06" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_cj07": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ07" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_cj08": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ08" }, "contract_family": { "const": "stable_dm_operation_control" } } } ] },
    "journey_cj09": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ09" }, "contract_family": { "const": "membership_join_compensation" } } } ] },
    "journey_cj10": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ10" }, "contract_family": { "const": "history_ingress_keypackage" } } } ] },
    "journey_cj11": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ11" }, "contract_family": { "const": "history_ingress_keypackage" } } } ] },
    "journey_cj12": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ12" }, "contract_family": { "const": "sidecar" } } } ] },
    "journey_cj13": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ13" }, "contract_family": { "const": "sidecar" } } } ] },
    "journey_cj14": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ14" }, "contract_family": { "const": "sidecar" } } } ] },
    "journey_cj15": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ15" }, "contract_family": { "const": "sidecar" } } } ] },
    "journey_cj16": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ16" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_cj17": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ17" }, "contract_family": { "const": "contact_and_resolver" } } } ] },
    "journey_cj18": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ18" }, "contract_family": { "const": "participation_and_attribution" } } } ] },
    "journey_cj19": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ19" }, "contract_family": { "const": "participation_and_attribution" } } } ] },
    "journey_cj20": { "allOf": [ { "$ref": "#/$defs/journey_row" }, { "properties": { "journey_id": { "const": "CJ20" }, "contract_family": { "const": "history_ingress_keypackage" } } } ] },
