{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/typed-current-result.schema.json",
  "title": "Arkret Typed Realm Current Result",
  "description": "Closed domain result selected without protocol typed current result IDs. Every result names the last authority commit that affected the typed target.",
  "oneOf": [
    {
      "$ref": "#/$defs/realm_authority_root_result"
    },
    {
      "$ref": "#/$defs/realm_profile_result"
    },
    {
      "$ref": "#/$defs/realm_policy_result"
    },
    {
      "$ref": "#/$defs/member_state_result"
    },
    {
      "$ref": "#/$defs/strand_result"
    },
    {
      "$ref": "#/$defs/message_reactions_result"
    },
    {
      "$ref": "#/$defs/mls_group_result"
    },
    {
      "$ref": "#/$defs/agent_key_result"
    },
    {
      "$ref": "#/$defs/agent_status_result"
    }
  ],
  "$defs": {
    "revision": {
      "type": "object",
      "required": [
        "commit_id",
        "stream_position"
      ],
      "properties": {
        "commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "stream_position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "realm_authority_root_value": {
      "type": "object",
      "description": "Closed value of the lifetime-stable Realm authority root. Every member is derived by the registered ak.realm.create value_projection from the signed envelope and create payload; an author-supplied member is a realm_authority_root_conflict, never an accepted write.",
      "required": [
        "controller_actor_id",
        "controller_epoch",
        "authority_generation"
      ],
      "properties": {
        "controller_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "description": "Current root controller. At genesis it is exactly the create envelope actor_id."
        },
        "controller_epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "Increments only on a root controller rotation. Genesis is 0."
        },
        "authority_generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Increments only on a planned governance Station handoff. Genesis is 0."
        }
      },
      "additionalProperties": false
    },
    "realm_authority_root_result": {
      "type": "object",
      "description": "Singleton authority-root typed current result. The selector carries no component beyond its kind, so (realm_id, selector) is the Realm's lifetime-stable authority root identity.",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "realm_authority_root"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "$ref": "#/$defs/realm_authority_root_value"
        }
      },
      "additionalProperties": false
    },
    "realm_profile_result": {
      "type": "object",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "realm_profile"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "$ref": "./realm-profile.schema.json"
        }
      },
      "additionalProperties": false
    },
    "realm_policy_result": {
      "type": "object",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "realm_policy"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "$ref": "./policy.schema.json"
        }
      },
      "additionalProperties": false
    },
    "member_state_result": {
      "type": "object",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind",
            "actor_id"
          ],
          "properties": {
            "kind": {
              "const": "member_state"
            },
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "type": "object",
          "required": [
            "membership"
          ],
          "properties": {
            "membership": {
              "enum": [
                "join",
                "knock",
                "leave",
                "ban"
              ]
            },
            "joined_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "strand_result": {
      "type": "object",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand"
            },
            "strand_id": {
              "type": "string",
              "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "$ref": "./strand.schema.json"
        }
      },
      "additionalProperties": false
    },
    "message_reactions_result": {
      "type": "object",
      "required": [
        "selector",
        "revision",
        "reactions"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind",
            "event_id"
          ],
          "properties": {
            "kind": {
              "const": "message_reactions"
            },
            "event_id": {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "reactions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "actor_id",
              "key"
            ],
            "properties": {
              "actor_id": {
                "$ref": "./common-ids.schema.json#/$defs/actor_id"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "mls_group_result": {
      "type": "object",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind",
            "scope_ref"
          ],
          "properties": {
            "kind": {
              "const": "mls_group"
            },
            "scope_ref": {
              "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "$ref": "#/$defs/mls_group_current"
        }
      },
      "additionalProperties": false
    },
    "mls_group_current": {
      "type": "object",
      "required": [
        "effective_scope",
        "genesis_event_ref",
        "current_mls_commit_event_ref",
        "epoch",
        "current_key_access_revision",
        "covered_key_access_revision",
        "public_tree_ref"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "current_mls_commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "current_key_access_revision": {
          "type": "integer",
          "minimum": 0
        },
        "covered_key_access_revision": {
          "type": "integer",
          "minimum": 0
        },
        "public_tree_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        }
      },
      "additionalProperties": false
    },
    "canonical_event_dot": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}:(0|[1-9][0-9]{0,2})$",
      "description": "Stable tag of one registered reducer write: the canonical <event_id>:<write_index> dot of zh/models/event-and-patch.md section 2.4.2. A bare event_id is never a valid tag."
    },
    "agent_key_authorization_entry": {
      "type": "object",
      "description": "One tagged entry of the agent_key typed current result. The tag is the canonical dot of the accepted Event write that produced it; the value is the complete authorize or revoke payload of that Event.",
      "required": [
        "tag_id",
        "value"
      ],
      "properties": {
        "tag_id": {
          "$ref": "#/$defs/canonical_event_dot"
        },
        "value": {
          "oneOf": [
            {
              "$ref": "./event-payload.schema.json#/$defs/agent_key_authorize_payload"
            },
            {
              "$ref": "./event-payload.schema.json#/$defs/agent_key_revoke_payload"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "agent_key_result": {
      "type": "object",
      "description": "Registered reducer projection of one Agent signing key. It is the single state source a portable state witness may quote; a service-private key table is not an alternative.",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "description": "Composite subject derived from (agent_id, agent_key_id). Producers MUST NOT spell it by string concatenation.",
          "required": [
            "kind",
            "agent_id",
            "agent_key_id"
          ],
          "properties": {
            "kind": {
              "const": "agent_key"
            },
            "agent_id": {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            },
            "agent_key_id": {
              "$ref": "./event-payload.schema.json#/$defs/agent_key_id"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "$ref": "#/$defs/agent_key_current"
        }
      },
      "additionalProperties": false
    },
    "agent_status_result": {
      "type": "object",
      "description": "Registered Agent lifecycle projection. The first active value has exactly one provenance: the delegated PCR genesis ak.realm.create conditional write of zh/models/realm-and-space.md section 2.5.1.",
      "required": [
        "selector",
        "revision",
        "value"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "required": [
            "kind",
            "agent_id"
          ],
          "properties": {
            "kind": {
              "const": "agent_status"
            },
            "agent_id": {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "value": {
          "type": "string",
          "enum": [
            "uninitialized",
            "active",
            "paused",
            "deactivated"
          ]
        }
      },
      "additionalProperties": false
    },
    "agent_key_current": {
      "type": "object",
      "description": "Closed value of the agent_key typed current result.",
      "required": [
        "authorizations"
      ],
      "properties": {
        "authorizations": {
          "type": "array",
          "description": "Canonically sorted active tagged-set entries. A revoke entry is a witnessed revocation boundary marker, never an active authorization.",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/agent_key_authorization_entry"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
