{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/grant-constraint.schema.json",
  "title": "Contrix Grant Constraint",
  "type": "object",
  "required": [
    "constraint_type",
    "effect"
  ],
  "properties": {
    "constraint_id": {
      "type": "string",
      "description": "Optional stable identifier of this constraint within the grant; used for diagnostics and overrides."
    },
    "constraint_type": {
      "type": "string",
      "enum": [
        "temporal",
        "field_access",
        "type_restriction",
        "scope_limitation",
        "delegation_control",
        "quota",
        "claim_based",
        "confidentiality"
      ],
      "description": "Constraint family discriminator. v1 collapses what were 15 types into 8 by absorbing narrowly-scoped types into their conceptual parent: edit_window → temporal; container_move → scope_limitation; rate_limiting + resource_limit → quota; approval_workflow + accountability + device_session → claim_based (with subtype); encryption_requirement + visibility_control → confidentiality (with subtype). Use the optional 'subtype' field to indicate the original specialization where evaluation logic differs."
    },
    "effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "evaluation_class": {
      "type": "string",
      "enum": [
        "stateless",
        "grant_local",
        "realm_state",
        "external"
      ],
      "description": "Cacheability/dependency hint for the authorization evaluator. stateless = pure function of (constraint, op, now); grant_local = depends on the grant object only; realm_state = depends on Realm frontier (membership, policy_version, etc.); external = depends on data outside the Realm causal frontier (claim revocation status, rate-limit history counts, async approval). Each constraint_type has a canonical evaluation_class declared in constraint-schema.md §2.3; implementations MAY tighten (e.g. grant_local → stateless) but MUST NOT loosen (e.g. external as stateless). Auth evaluators SHOULD use this hint to gate fast-path caching."
    },
    "not_before": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "recurrence": {
      "type": "object",
      "description": "Recurrence rule for temporal constraints. Used by constraint-schema.md §3.1.",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "custom"
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "uniqueItems": true
        },
        "window_start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "window_end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "max_duration": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
      "description": "ISO 8601 duration."
    },
    "max_session_duration": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "inactivity_timeout": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "expires_after": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
      "description": "ISO 8601 duration; used by approval_workflow constraint instead of expires_after_ms."
    },
    "condition": {
      "type": "object",
      "description": "Conditional predicate for field_access and similar constraints. The `kind` value is a registered named condition from constraint-schema.md §4.1; unknown kinds MUST fail closed. Implementations MUST NOT introduce ad hoc string DSL predicates.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "object_is_owned_by_actor",
            "actor_is_assignee",
            "actor_is_responsible",
            "actor_is_guardian",
            "actor_is_controller",
            "object_in_actor_container",
            "object_is_unencrypted",
            "object_is_encrypted",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": true
    },
    "fields_write_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_write_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_read_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_read_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitive_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sensitive_handling": {
      "type": "string",
      "enum": [
        "redact",
        "hash",
        "omit"
      ]
    },
    "object_type_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_type_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "realm_kind_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collaboration"
        ]
      },
      "uniqueItems": true,
      "description": "v1 reserved / deprecated no-op. All v1 Realms share one security-boundary kind, so producers SHOULD NOT emit this field and receivers MUST ignore it. Board/list are Space kinds — use space_kind_allow."
    },
    "realm_kind_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collaboration"
        ]
      },
      "uniqueItems": true,
      "description": "v1 reserved / deprecated no-op. Producers SHOULD NOT emit this field and receivers MUST ignore it."
    },
    "morph_type_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "morph_type_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "space_kind_allow": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Allowed Space kinds (e.g. 'board', 'list', or profile-registered kinds like 'swimlane', 'calendar_bucket'). Reducer/profile MUST validate kind value."
    },
    "space_kind_deny": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "facet_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      },
      "uniqueItems": true
    },
    "facet_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      },
      "uniqueItems": true
    },
    "allowed_view_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "allowed_flow_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "allowed_circle_ids": {
      "type": "array",
      "description": "Limits Circle-scoped capability actions to the listed Circle ids. Used by cx.circle.manage / cx.circle.member.manage style grants; unconstrained Realm-wide Circle management grants are not a normal permission shape.",
      "items": {
        "type": "string",
        "pattern": "^cx:circle:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "denied_flow_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "allowed_space_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "denied_space_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "allowed_view_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_view_renderers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relation_kind_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_from_container_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:(space|flow|morph):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "allowed_to_container_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:(space|flow|morph):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "wip_limit_override": {
      "type": "boolean",
      "default": false
    },
    "denied_view_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "denied_view_renderers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_tracks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "denied_tracks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "visibility_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "world_readable",
          "shared",
          "invited",
          "joined",
          "restricted"
        ]
      },
      "uniqueItems": true
    },
    "deny_redacted_history": {
      "type": "boolean"
    },
    "blob_max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "blob_presign_max_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "description": "Maximum TTL, in seconds, that this grant permits for cx.blob.presign. The service must clamp requested max_age_seconds to the smaller of this value and deployment policy."
    },
    "blob_presign_scope": {
      "type": "object",
      "description": "Scope limiter for cx.blob.presign grants: allowed purposes plus optional blob/realm restrictions.",
      "properties": {
        "purpose_allow": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "media_inline",
              "thumbnail",
              "download"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "blob_ref_pattern": {
          "type": "string"
        },
        "realm_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "purpose_allow"
      ],
      "additionalProperties": false
    },
    "max_total_blob_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_artifact_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum artifact size in bytes for applet / agent / export operations."
    },
    "allowed_data_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true,
      "description": "Data classification labels this grant may read, export, transform, or send to external endpoints."
    },
    "allowed_endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Allowed outbound endpoint origins or deployment-approved endpoint patterns for applet / agent / connector operations."
    },
    "message_edit_window": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "message_redact_window": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "allow_redact_after_window": {
      "type": "boolean"
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "delegation_path": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
      }
    },
    "prohibit_subdelegation": {
      "type": "boolean"
    },
    "delegation_scope": {
      "type": "string",
      "enum": [
        "narrowing_only",
        "same_scope",
        "custom"
      ]
    },
    "allow_scope_expansion": {
      "type": "boolean"
    },
    "require_parent_reference": {
      "type": "boolean"
    },
    "max_operations": {
      "type": "integer",
      "minimum": 0
    },
    "period": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "burst": {
      "type": "integer",
      "minimum": 0
    },
    "constraint_scope": {
      "type": "string"
    },
    "max_resources": {
      "type": "integer",
      "minimum": 0
    },
    "resource_type": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "before_commit",
        "proposal_then_approve",
        "after_commit_review"
      ]
    },
    "approval_actor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
      }
    },
    "approval_relation": {
      "type": "string",
      "enum": [
        "responsible",
        "controller",
        "guardian",
        "space_admin",
        "custom"
      ]
    },
    "timeout": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "auto_reject_on_timeout": {
      "type": "boolean"
    },
    "proposal_morph_type": {
      "type": "string"
    },
    "approval_threshold": {
      "type": "string",
      "enum": [
        "majority",
        "unanimous",
        "quorum",
        "custom"
      ]
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
      }
    },
    "accountability_required": {
      "type": "boolean"
    },
    "guardian_approval_required": {
      "type": "boolean"
    },
    "controller_approval_required": {
      "type": "boolean"
    },
    "encryption_required": {
      "type": "boolean"
    },
    "key_rotation_period": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "max_key_age": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "require_key_backup": {
      "type": "boolean"
    },
    "approved_key_issuers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
      }
    },
    "requires_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_type"
        ],
        "anyOf": [
          { "required": ["issuer"] },
          { "required": ["trusted_issuers"] }
        ],
        "properties": {
          "claim_type": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
          },
          "trusted_issuers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
            },
            "uniqueItems": true
          },
          "subject_matches_actor": {
            "type": "boolean",
            "default": true,
            "description": "If true, the credential subject DID MUST match the actor DID."
          },
          "value_constraints": {
            "type": "object",
            "description": "Per-field equality / membership constraints on credential claims.",
            "additionalProperties": true
          },
          "organization": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
          },
          "status": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "trusted_claim_issuers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
      }
    },
    "claim_refresh_required": {
      "type": "boolean"
    },
    "claim_max_age": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "depends_on_moderation_state": {
      "type": "boolean",
      "description": "Cache-invalidation hint: when true, this grant's authorization decisions depend on the cx.component.moderation_state.v1 cell (see policy-server.md §7.1 and capabilities.md §18.1) and the grant's cache entry MUST be invalidated when that cell changes. Default false: ordinary grants (cx.flow.update / cx.message.create / org membership grants) do NOT take a cache hit on every moderation decision. v1 capabilities.md §18.1 lists three conditions where MUST be explicitly true (moderator-role grants, condition-selector subjects referencing moderation state, constraints referencing moderation queue / cell). Schema-side enforcement of condition (2) is in capability-grant.schema.json via if/then on actions[]; conditions (1) and (3) are reducer-side lint."
    },
    "subtype": {
      "type": "string",
      "description": "Optional discriminator within a constraint_type. Standard values: claim_based.{claim,approval,accountability,device_session}; quota.{rate,resource}; confidentiality.{encryption,visibility}; temporal.{window,edit_window,redact_window,session}. Implementations MAY require subtype for these families and fail closed on unknown values.",
      "enum": [
        "claim",
        "approval",
        "accountability",
        "device_session",
        "rate",
        "resource",
        "encryption",
        "visibility",
        "window",
        "edit_window",
        "redact_window",
        "session"
      ]
    },
    "applies_to_actions": {
      "type": "array",
      "description": "Optional restriction of a temporal constraint to specific capability actions (e.g. ['cx.message.revise', 'cx.message.redact']). Replaces what used to be the dedicated edit_window constraint type.",
      "items": {
        "type": "string",
        "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
      },
      "uniqueItems": true
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
