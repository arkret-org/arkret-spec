{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/contact-operations.schema.json",
  "title": "Arkret Contact and Direct Conversation Operation DTOs",
  "description": "Closed request/response DTOs for contact lifecycle operations and direct conversation resolver.",
  "anyOf": [
    {
      "$ref": "#/$defs/contact_request_request_body"
    },
    {
      "$ref": "#/$defs/contact_request_outcome"
    },
    {
      "$ref": "#/$defs/contact_respond_request_body"
    },
    {
      "$ref": "#/$defs/contact_respond_outcome"
    },
    {
      "$ref": "#/$defs/contact_list"
    },
    {
      "$ref": "#/$defs/contact_tombstone_request_body"
    },
    {
      "$ref": "#/$defs/contact_tombstone"
    },
    {
      "$ref": "#/$defs/direct_conversation_resolve_request_body"
    },
    {
      "$ref": "#/$defs/direct_conversation_resolve_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^ak:cursor:[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "consent_scope": {
      "type": "string",
      "enum": [
        "invite",
        "direct_message",
        "voice_call",
        "video_call",
        "presence",
        "any"
      ]
    },
    "consent_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consent_scope"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "consent_scope_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consent_scope"
      },
      "uniqueItems": true
    },
    "event_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "contact_state": {
      "type": "string",
      "enum": [
        "pending_outgoing",
        "pending_incoming",
        "accepted",
        "rejected",
        "expired",
        "tombstoned"
      ]
    },
    "direct_conversation_summary": {
      "type": "object",
      "required": [
        "realm_id",
        "main_strand_id",
        "state"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "main_strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "binding_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "retired",
            "duplicate",
            "non_canonical"
          ]
        }
      },
      "additionalProperties": false
    },
    "contact_agent_projection": {
      "type": "object",
      "required": [
        "agent_id",
        "controller_id"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "controller_id": {
          "$ref": "#/$defs/did"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "agent_slug": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
        },
        "avatar_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "direct_conversation": {
          "$ref": "#/$defs/direct_conversation_summary"
        }
      },
      "additionalProperties": false
    },
    "contact_list_row": {
      "type": "object",
      "required": [
        "peer",
        "state",
        "granted_by_me",
        "granted_to_me",
        "bidirectional_scopes"
      ],
      "properties": {
        "peer": {
          "$ref": "#/$defs/did"
        },
        "state": {
          "$ref": "#/$defs/contact_state"
        },
        "request_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "response_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "tombstone_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "granted_by_me": {
          "$ref": "#/$defs/consent_scope_list"
        },
        "granted_to_me": {
          "$ref": "#/$defs/consent_scope_list"
        },
        "bidirectional_scopes": {
          "$ref": "#/$defs/consent_scope_list"
        },
        "effective_scopes": {
          "$ref": "#/$defs/consent_scope_list",
          "description": "Optional shorthand. When present, MUST equal bidirectional_scopes."
        },
        "invite_consent_grant_ref": {
          "$ref": "#/$defs/event_id",
          "description": "Optional. Event ref of the peer-issued ak.consent.grant (scope invite or any) granting the holder the right to send Realm/Strand invites to this peer. Present only when granted_to_me includes invite or any. Used by the holder as consent_grant introduction evidence to invite this contact into a Realm without a locator URL."
        },
        "peer_service_id": {
          "$ref": "#/$defs/did",
          "description": "Optional. Principal Server service DID hosting the peer, when known (e.g. learned from a cross-Principal-Server contact delivery). Lets the holder address responses/invites to the peer's home server. Omitted for same-Principal-Server contacts."
        },
        "direct_conversation": {
          "$ref": "#/$defs/direct_conversation_summary"
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact_agent_projection"
          }
        }
      },
      "additionalProperties": false
    },
    "contact_request_request_body": {
      "type": "object",
      "required": [
        "target",
        "requested_scopes"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/did"
        },
        "requested_scopes": {
          "$ref": "#/$defs/consent_scopes"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Optional free-text greeting carried into contact_requested_payload.message. NFC-normalized per canonical encoding rules."
        },
        "idempotency_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recipient_service_id": {
          "$ref": "#/$defs/did",
          "description": "Optional cross-Principal-Server addressing (see contact-and-direct-conversation.md §4.1). When target is hosted on a different Principal Server, the requester MUST supply the target home service DID so the issuer-side server federates the signed ak.contact.requested fact via ak.peer.contacts.command.submit. Omit for same-server requests."
        },
        "introduction_evidence": {
          "$ref": "./peer-contact-delivery-request.schema.json#/$defs/contact_introduction_evidence",
          "description": "Optional evidence explaining how the requester found the target. Required by the issuer-side Principal Server when it federates a first-contact request to another Principal Server; if omitted, the server MUST derive compliant evidence or treat the request as explicit_address."
        }
      },
      "additionalProperties": false
    },
    "contact_request_outcome": {
      "type": "object",
      "required": [
        "request_event_ref",
        "requester_consent_refs",
        "state"
      ],
      "properties": {
        "request_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "requester_consent_refs": {
          "$ref": "#/$defs/event_refs"
        },
        "state": {
          "const": "pending_outgoing"
        }
      },
      "additionalProperties": false
    },
    "contact_respond_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "requester",
        "action"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/event_id"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ]
        },
        "granted_scopes": {
          "$ref": "#/$defs/consent_scopes"
        },
        "requester_service_id": {
          "$ref": "#/$defs/did",
          "description": "Optional cross-Principal-Server addressing (see contact-and-direct-conversation.md §4.1). When the original requester is hosted on a different Principal Server, the responder supplies the requester home service DID so the accept / reject fact is federated back via ak.peer.contacts.command.submit. Omit for same-server responses."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "accept"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "granted_scopes"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "contact_respond_outcome": {
      "type": "object",
      "required": [
        "response_event_ref",
        "state"
      ],
      "properties": {
        "response_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "consent_grant_refs": {
          "$ref": "#/$defs/event_refs"
        },
        "state": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "contact_list": {
      "type": "object",
      "required": [
        "contacts",
        "has_more"
      ],
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact_list_row"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "contact_tombstone_request_body": {
      "type": "object",
      "required": [
        "contact"
      ],
      "properties": {
        "contact": {
          "$ref": "#/$defs/did"
        },
        "revoke_scopes": {
          "$ref": "#/$defs/consent_scopes"
        },
        "full_peer_revoke": {
          "type": "boolean",
          "default": false,
          "description": "When true, UI/admin explicitly requested revocation beyond contact-managed grant dots."
        },
        "block_peer": {
          "type": "boolean",
          "default": false,
          "description": "When true, additionally add the peer DID to the holder invite_receive_policy.blocked_subjects, so future invite delivery from this peer is dropped and disclosed opaquely. Models a hard block (\"拉黑\") on top of contact tombstone."
        },
        "peer_service_id": {
          "$ref": "#/$defs/did",
          "description": "Optional cross-Principal-Server addressing (see contact-and-direct-conversation.md §4.1). When contact (the peer) is hosted on a different Principal Server, the holder supplies the peer home service DID so the issuer-side server federates the signed ak.contact.tombstoned fact via ak.peer.contacts.command.submit. Omit for same-server tombstones; when absent the issuer falls back to the peer recorded peer_service_id on the stored contact row."
        }
      },
      "additionalProperties": false
    },
    "contact_tombstone": {
      "type": "object",
      "required": [
        "tombstone_event_ref",
        "state"
      ],
      "properties": {
        "tombstone_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "consent_revoke_refs": {
          "$ref": "#/$defs/event_refs"
        },
        "state": {
          "const": "tombstoned"
        },
        "partial_revoke": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "direct_conversation_resolve_request_body": {
      "type": "object",
      "required": [
        "peer"
      ],
      "properties": {
        "peer": {
          "$ref": "#/$defs/did"
        },
        "create": {
          "type": "boolean",
          "default": false
        },
        "idempotency_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "peer_claim_request": {
          "$ref": "./keypackage-operations.schema.json#/$defs/peer_key_packages_claim_request_body",
          "description": "Requester-signed peer KeyPackage claim returned from the preceding remote_keypackage_claim authoring step. It is accepted only for create=true and must exactly match the reserved draft."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "peer_claim_request"
            ]
          },
          "then": {
            "required": [
              "create",
              "idempotency_key"
            ],
            "properties": {
              "create": {
                "const": true
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "direct_conversation_resolve_outcome": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "found",
            "authoring_required",
            "not_found",
            "retired",
            "non_canonical"
          ]
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "main_strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "binding_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "created": {
          "type": "boolean"
        },
        "authoring_kind": {
          "type": "string",
          "enum": [
            "remote_keypackage_claim",
            "direct_conversation_materialization"
          ]
        },
        "claim_authorization_draft": {
          "$ref": "./keypackage-operations.schema.json#/$defs/peer_key_packages_claim_authorization_draft",
          "description": "Immutable peer claim request and explicit service/trust-domain transport binding reserved by the source service. The participant signs the canonical authorization transcript and resubmits draft.request plus requester_authorization as peer_claim_request."
        },
        "materialization_draft": {
          "type": "object",
          "required": [
            "materialization_id",
            "claim_nonce",
            "mls_group_id",
            "mls_genesis_event_ref",
            "mls_commit_event_ref",
            "mls_welcome_event_ref",
            "claimed_keypackage",
            "realm_event",
            "founding_grant_event",
            "peer_member_event",
            "main_strand_event",
            "binding_event",
            "expires_at"
          ],
          "properties": {
            "materialization_id": { "$ref": "#/$defs/non_empty_string" },
            "claim_nonce": { "$ref": "./keypackage-operations.schema.json#/$defs/base64url" },
            "mls_group_id": { "$ref": "#/$defs/non_empty_string" },
            "mls_genesis_event_ref": { "$ref": "#/$defs/event_id" },
            "mls_commit_event_ref": { "$ref": "#/$defs/event_id" },
            "mls_welcome_event_ref": { "$ref": "#/$defs/event_id" },
            "claimed_keypackage": { "$ref": "./keypackage-operations.schema.json#/$defs/keypackage_claim_record" },
            "claim_receipt": { "$ref": "./keypackage-operations.schema.json#/$defs/peer_keypackage_claim_receipt" },
            "realm_event": { "$ref": "#/$defs/unsigned_direct_materialization_event" },
            "founding_grant_event": { "$ref": "#/$defs/unsigned_direct_materialization_event" },
            "peer_member_event": { "$ref": "#/$defs/unsigned_direct_materialization_event" },
            "main_strand_event": { "$ref": "#/$defs/unsigned_direct_materialization_event" },
            "binding_event": { "$ref": "#/$defs/unsigned_direct_materialization_event" },
            "expires_at": { "$ref": "#/$defs/timestamp" }
          },
          "additionalProperties": false,
          "description": "Immutable client-side materialization plan issued only after a KeyPackage claim is final. The participant submits realm_event, founding_grant_event, and peer_member_event as the atomic ordinary-Realm bootstrap unit, authors real MLS genesis/add-commit/Welcome objects from claimed_keypackage, then submits the post-bootstrap Realm Events before binding_event in the participant PCR. No service may synthesize participant Event proofs or MLS ciphertext."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "authoring_required"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "authoring_kind",
              "created"
            ],
            "properties": {
              "created": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "authoring_kind"
                  ]
                },
                {
                  "required": [
                    "claim_authorization_draft"
                  ]
                },
                {
                  "required": [
                    "materialization_draft"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "authoring_kind": {
                "const": "remote_keypackage_claim"
              }
            },
            "required": [
              "authoring_kind"
            ]
          },
          "then": {
            "required": [
              "claim_authorization_draft"
            ],
            "not": {
              "required": ["materialization_draft"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "authoring_kind": {
                "const": "direct_conversation_materialization"
              }
            },
            "required": [
              "authoring_kind"
            ]
          },
          "then": {
            "required": [
              "materialization_draft"
            ],
            "not": {
              "required": [
                "claim_authorization_draft"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "unsigned_direct_materialization_event": {
      "type": "object",
      "required": ["event_id", "kind", "realm_id", "actor_id", "actor_seq", "hlc", "payload", "proofs"],
      "properties": {
        "event_id": { "$ref": "#/$defs/event_id" },
        "kind": {
          "enum": [
            "ak.realm.create",
            "ak.member.state",
            "ak.strand.create",
            "ak.direct_conversation.bound"
          ]
        },
        "realm_id": { "$ref": "./common-ids.schema.json#/$defs/realm_id" },
        "actor_id": { "$ref": "./common-ids.schema.json#/$defs/did" },
        "actor_seq": { "type": "integer", "minimum": 0 },
        "hlc": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "proofs": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": true
    }
  }
}
