{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/contact-operations.schema.json",
  "title": "Arkret Contact and Direct Conversation Operation DTOs",
  "description": "Closed request/response DTOs for contact lifecycle operations and direct conversation resolver.",
  "anyOf": [
    {
      "$ref": "#/$defs/contact_request_request_body"
    },
    {
      "$ref": "#/$defs/contact_request_outcome"
    },
    {
      "$ref": "#/$defs/contact_respond_request_body"
    },
    {
      "$ref": "#/$defs/contact_respond_outcome"
    },
    {
      "$ref": "#/$defs/contact_reject_request_body"
    },
    {
      "$ref": "#/$defs/contact_reject_outcome"
    },
    {
      "$ref": "#/$defs/contact_list"
    },
    {
      "$ref": "#/$defs/contact_tombstone_request_body"
    },
    {
      "$ref": "#/$defs/contact_tombstone"
    },
    {
      "$ref": "#/$defs/contact_scope_update_request_body"
    },
    {
      "$ref": "#/$defs/contact_scope_update_outcome"
    },
    {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/direct_conversation_resolve_request"
    },
    {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/direct_conversation_resolve_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^ak:cursor:[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "contact_state": {
      "type": "string",
      "enum": [
        "pending_outgoing",
        "pending_incoming",
        "accepted",
        "rejected",
        "expired",
        "tombstoned"
      ]
    },
    "direct_conversation_summary": {
      "type": "object",
      "description": "Contact-list projection of an already materialized stable Direct Conversation. Coordinates and binding identity are immutable; state only says whether the same conversation is currently sendable. Creation progress is exposed only by direct_conversation_resolve_outcome and its durable operation.",
      "required": [
        "realm_id",
        "main_strand_id",
        "binding_event_ref",
        "state"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "main_strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "binding_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "state": {
          "type": "string",
          "enum": [
            "found",
            "suspended"
          ]
        }
      },
      "additionalProperties": false
    },
    "contact_agent_projection": {
      "type": "object",
      "required": [
        "agent_id",
        "controller_id"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "controller_id": {
          "$ref": "#/$defs/did"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "agent_slug": {
          "$ref": "string-profiles.schema.json#/$defs/agent_slug"
        },
        "avatar_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "direct_conversation": {
          "$ref": "#/$defs/direct_conversation_summary"
        }
      },
      "additionalProperties": false
    },
    "contact_list_row": {
      "type": "object",
      "required": [
        "peer",
        "state",
        "granted_to_peer_scopes",
        "granted_by_peer_scopes",
        "bidirectional_scopes"
      ],
      "properties": {
        "peer": {
          "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_peer"
        },
        "state": {
          "$ref": "#/$defs/contact_state"
        },
        "request_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "response_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "tombstone_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "granted_to_peer_scopes": {
          "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_scopes"
        },
        "granted_by_peer_scopes": {
          "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_scopes"
        },
        "bidirectional_scopes": {
          "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_scopes"
        },
        "effective_scopes": {
          "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_scopes",
          "description": "Optional shorthand. When present, MUST equal bidirectional_scopes."
        },
        "peer_service_id": {
          "$ref": "#/$defs/did",
          "description": "Optional. Principal Server service DID hosting the peer, when known (e.g. learned from a cross-Principal-Server contact delivery). Lets the holder address responses/invites to the peer's home server. Omitted for same-Principal-Server contacts."
        },
        "direct_conversation": {
          "$ref": "#/$defs/direct_conversation_summary"
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact_agent_projection"
          }
        }
      },
      "additionalProperties": false
    },
    "contact_request_request_body": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_operation_request"
    },
    "contact_request_outcome": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_request_outcome"
    },
    "contact_respond_request_body": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_respond_request"
    },
    "contact_respond_outcome": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_respond_outcome"
    },
    "contact_reject_request_body": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_reject_request"
    },
    "contact_reject_outcome": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_reject_outcome"
    },
    "contact_list": {
      "type": "object",
      "required": [
        "contacts",
        "has_more"
      ],
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact_list_row"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "contact_tombstone_request_body": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_tombstone_request"
    },
    "contact_tombstone": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_tombstone_outcome"
    },
    "contact_scope_update_request_body": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_scope_update_request"
    },
    "contact_scope_update_outcome": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/contact_scope_update_outcome"
    },
    "direct_conversation_resolve_request_body": {
      "$ref": "./protocol-journey-wire.schema.json#/$defs/direct_conversation_resolve_request"
    }
  }
}
