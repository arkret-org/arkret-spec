{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/morph-customer-risk.schema.json",
  "title": "Arkret Morph Customer Risk Example",
  "description": "Reference business-field schema for the morph.md customer_risk example. It constrains the fields object carried by a ak.schema.morph.v1 container.",
  "$comment": "Logical schema id is ak.schema.morph.customer_risk.v1 (dotted, used in schema_refs[]); the artifact file name uses hyphens (morph-customer-risk.schema.json). Do not derive the id from the file name.",
  "type": "object",
  "required": [
    "morph_kind",
    "fields"
  ],
  "properties": {
    "morph_kind": {
      "const": "customer_risk",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "morph-customer-risk.schema.json#/properties/morph_kind",
        "owner": "morph-customer-risk.schema.json#/properties/morph_kind",
        "values": [
          "customer_risk"
        ]
      }
    },
    "fields": {
      "type": "object",
      "required": [
        "status",
        "severity"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "investigating",
            "mitigated",
            "closed"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "morph-customer-risk.schema.json#/properties/fields/properties/status",
            "owner": "morph-customer-risk.schema.json#/properties/fields/properties/status",
            "values": [
              "open",
              "investigating",
              "mitigated",
              "closed"
            ]
          }
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "morph-customer-risk.schema.json#/properties/fields/properties/severity",
            "owner": "morph-customer-risk.schema.json#/properties/fields/properties/severity",
            "values": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
