{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/view.schema.json",
  "title": "Arkret View",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "kind",
    "query",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ak.schema.view.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "collection",
        "timeline",
        "graph",
        "document",
        "composite"
      ]
    },
    "renderer": {
      "$ref": "#/$defs/view_renderer"
    },
    "title": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "description": "View sharing visibility. Private views are actor-private account data; shared views are canonical Realm objects."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "tombstoned"
      ],
      "default": "active",
      "description": "View lifecycle. Absent means active for compatibility. Shared View removal is an ak.view.update patch to tombstoned; tombstoned is terminal."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the ak.view.update that transitioned state to tombstoned. Actor-supplied values MUST be rejected."
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "visible_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field_path"
      }
    },
    "layout": {
      "type": "object"
    },
    "collection": {
      "$ref": "#/$defs/collection_config"
    },
    "timeline": {
      "$ref": "#/$defs/timeline_config"
    },
    "graph": {
      "$ref": "#/$defs/graph_config"
    },
    "document": {
      "$ref": "#/$defs/document_config"
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard_config"
    },
    "sort": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sort_spec"
      }
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collection"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "collection"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "timeline"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "timeline"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "graph"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "graph"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "document"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "document"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "composite"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "dashboard"
        ],
        "properties": {
          "renderer": {
            "enum": [
              "dashboard",
              "custom"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "tombstoned"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "state_changed_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "state_changed_at"
          ]
        }
      }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$"
    },
    "view_renderer": {
      "type": "string",
      "enum": [
        "board",
        "list",
        "table",
        "calendar",
        "gantt",
        "timeline",
        "thread",
        "chat",
        "forum",
        "graph",
        "tree",
        "document",
        "dashboard",
        "custom"
      ]
    },
    "cursor": {
      "type": "string",
      "pattern": "^ak:cursor:[A-Za-z0-9_-]+$"
    },
    "state_frontier": {
      "type": "object",
      "required": [
        "state_digest"
      ],
      "properties": {
        "state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "actor_frontiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actor_id",
              "actor_seq",
              "event_id"
            ],
            "properties": {
              "actor_id": {
                "$ref": "#/$defs/did"
              },
              "actor_seq": {
                "type": "integer",
                "minimum": 0
              },
              "event_id": {
                "type": "string",
                "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "hlc": {
                "type": "string",
                "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "projection_object": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ak:(realm|space|circle|strand|message|morph):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "realm",
            "space",
            "circle",
            "strand",
            "message",
            "morph"
          ]
        },
        "morph_type": {
          "type": "string"
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "collection_group_source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "model",
            "field",
            "value"
          ],
          "properties": {
            "model": {
              "const": "field_value"
            },
            "field": {
              "$ref": "#/$defs/field_path"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "model",
            "scope_container_id",
            "container_id",
            "relation_kind"
          ],
          "properties": {
            "model": {
              "const": "relation_container"
            },
            "scope_container_id": {
              "$ref": "#/$defs/object_ref"
            },
            "container_id": {
              "$ref": "#/$defs/object_ref"
            },
            "relation_kind": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "model",
            "start",
            "end",
            "timezone"
          ],
          "properties": {
            "model": {
              "const": "time_bucket"
            },
            "start": {
              "$ref": "#/$defs/timestamp"
            },
            "end": {
              "$ref": "#/$defs/timestamp"
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "model",
            "row_key",
            "column_key"
          ],
          "properties": {
            "model": {
              "const": "crosstab_cell"
            },
            "row_key": {
              "type": "string",
              "minLength": 1
            },
            "column_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "collection_position": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "model",
            "container_id",
            "rank"
          ],
          "properties": {
            "model": {
              "const": "field_value"
            },
            "container_id": {
              "type": "string",
              "minLength": 1
            },
            "rank": {
              "type": "string",
              "pattern": "^[0-9A-Za-z]{1,128}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "model",
            "scope_container_id",
            "container_id",
            "relation_kind",
            "relation_id",
            "rank"
          ],
          "properties": {
            "model": {
              "const": "relation"
            },
            "scope_container_id": {
              "$ref": "#/$defs/object_ref"
            },
            "container_id": {
              "$ref": "#/$defs/object_ref"
            },
            "relation_kind": {
              "type": "string",
              "minLength": 1
            },
            "relation_id": {
              "type": "string",
              "pattern": "^ak:relation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "rank": {
              "type": "string",
              "pattern": "^[0-9A-Za-z]{1,128}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "model",
            "start",
            "sort_key"
          ],
          "properties": {
            "model": {
              "const": "time_window"
            },
            "start": {
              "$ref": "#/$defs/timestamp"
            },
            "end": {
              "oneOf": [
                {
                  "$ref": "#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "sort_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "model",
            "row_key",
            "column_key",
            "sort_key"
          ],
          "properties": {
            "model": {
              "const": "crosstab_cell"
            },
            "row_key": {
              "type": "string",
              "minLength": 1
            },
            "column_key": {
              "type": "string",
              "minLength": 1
            },
            "sort_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "sort_key"
          ],
          "properties": {
            "sort_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "projection_item": {
      "type": "object",
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "$ref": "#/$defs/projection_object"
        },
        "render": {
          "type": "string",
          "enum": [
            "card",
            "row",
            "tile",
            "compact",
            "badge",
            "message"
          ]
        },
        "display": {
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/collection_position"
        },
        "state": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "collection_projection_group": {
      "type": "object",
      "required": [
        "key",
        "title",
        "items",
        "limited"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "string",
          "pattern": "^[0-9A-Za-z]{1,128}$"
        },
        "source": {
          "$ref": "#/$defs/collection_group_source"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_item"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "limited": {
          "type": "boolean"
        },
        "wip_state": {
          "type": "string",
          "enum": [
            "ok",
            "over_limit",
            "unknown"
          ]
        },
        "total_estimate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "view_projection_request_body": {
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": false
    },
    "collection_projection_view": {
      "type": "object",
      "required": [
        "projection",
        "view_id",
        "frontier"
      ],
      "properties": {
        "projection": {
          "type": "string",
          "const": "collection"
        },
        "renderer": {
          "$ref": "#/$defs/view_renderer"
        },
        "view_id": {
          "type": "string",
          "pattern": "^ak:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "frontier": {
          "$ref": "#/$defs/state_frontier"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection_projection_group"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_item"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "groups"
          ]
        },
        {
          "required": [
            "items"
          ]
        }
      ],
      "additionalProperties": false
    },
    "document_morph_projection_outcome": {
      "type": "object",
      "required": [
        "document",
        "versions",
        "relations",
        "comments",
        "cursor_presence"
      ],
      "properties": {
        "document": {
          "type": "object",
          "required": [
            "morph_id",
            "realm_id",
            "morph_type",
            "state",
            "body"
          ],
          "properties": {
            "morph_id": {
              "type": "string",
              "pattern": "^ak:morph:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "morph_type": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "state_changed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "fields": {
              "type": "object"
            },
            "body": true,
            "schema_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "created_by": {
              "$ref": "#/$defs/did"
            },
            "created_at": {
              "$ref": "#/$defs/timestamp"
            },
            "updated_by": {
              "$ref": "#/$defs/did"
            },
            "updated_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "additionalProperties": true
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "cursor_presence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "frontier": {
          "$ref": "#/$defs/state_frontier"
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "object_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "morph_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relation": {
          "type": [
            "object",
            "null"
          ]
        },
        "order_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort_spec"
          }
        }
      },
      "additionalProperties": true
    },
    "sort_spec": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field_path"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "nulls": {
          "type": "string",
          "enum": [
            "first",
            "last"
          ]
        }
      },
      "additionalProperties": false
    },
    "collection_grouping": {
      "type": "object",
      "description": "Grouping / lane / time-bucket / matrix configuration; mirrors models/views.md §3.3. Conditional required-ness is enforced per mode.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "field",
            "relation_container",
            "time_bucket",
            "matrix"
          ]
        },
        "field": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "board_space_id": {
          "type": "string",
          "pattern": "^ak:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "container_relation_kind": {
          "type": "string",
          "default": "contains"
        },
        "item_relation_kind": {
          "type": "string"
        },
        "start_field": {
          "type": "string"
        },
        "end_field": {
          "type": "string"
        },
        "rows_by": {
          "type": "string"
        },
        "columns_by": {
          "type": "string"
        },
        "hidden_count_policy": {
          "type": "string",
          "enum": [
            "omit",
            "authorized_estimate",
            "authorized_exact"
          ],
          "default": "omit"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "field"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "field",
              "lanes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "relation_container"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "board_space_id",
              "item_relation_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "time_bucket"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "start_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "matrix"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "rows_by",
              "columns_by"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "collection_config": {
      "type": "object",
      "required": [
        "item_order_by",
        "grouping"
      ],
      "properties": {
        "item_object_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "item_facets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "item_render": {
          "type": "string",
          "enum": [
            "card",
            "row",
            "tile",
            "compact",
            "badge",
            "message"
          ]
        },
        "item_order_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sort_spec"
          },
          "description": "Stable item ordering; mirrors models/views.md §3.2. Drag-ordered collections SHOULD sort by rank."
        },
        "display_fields": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Display columns (dot path + format); see models/views.md §3.2."
        },
        "count_policy": {
          "type": "string",
          "enum": [
            "omit",
            "authorized_estimate",
            "authorized_exact"
          ],
          "default": "omit",
          "description": "Collection-level count policy; see models/views.md §3.2."
        },
        "grouping": {
          "$ref": "#/$defs/collection_grouping"
        }
      },
      "anyOf": [
        {
          "required": [
            "item_object_types"
          ]
        },
        {
          "required": [
            "item_facets"
          ]
        }
      ],
      "additionalProperties": true
    },
    "timeline_config": {
      "type": "object",
      "additionalProperties": true
    },
    "graph_config": {
      "type": "object",
      "additionalProperties": true
    },
    "document_config": {
      "type": "object",
      "additionalProperties": true
    },
    "dashboard_config": {
      "type": "object",
      "required": [
        "widgets"
      ],
      "properties": {
        "widgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "widget_id",
              "kind"
            ],
            "properties": {
              "widget_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "collection",
                  "timeline",
                  "graph",
                  "document",
                  "metric",
                  "text",
                  "custom"
                ]
              },
              "source_view_ref": {
                "$ref": "#/$defs/object_ref"
              },
              "query": {
                "$ref": "#/$defs/query"
              },
              "title": {
                "type": "string"
              },
              "layout": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "source_view_ref"
                ]
              },
              {
                "required": [
                  "query"
                ]
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "text",
                      "custom"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "object_ref": {
      "type": "string",
      "pattern": "^(ak:(realm|space|circle|strand|message|morph|relation|event|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|did:.+)$"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
