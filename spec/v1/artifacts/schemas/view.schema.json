{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/view.schema.json",
  "title": "Cokret View",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "kind",
    "query",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ck:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ck.schema.view.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "collection",
        "timeline",
        "graph",
        "document",
        "composite"
      ]
    },
    "renderer": {
      "$ref": "#/$defs/view_renderer"
    },
    "title": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "description": "View sharing visibility. Private views are actor-private account data; shared views are canonical Realm objects."
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "visible_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field_path"
      }
    },
    "layout": {
      "type": "object"
    },
    "collection": {
      "$ref": "#/$defs/collection_config"
    },
    "timeline": {
      "$ref": "#/$defs/timeline_config"
    },
    "graph": {
      "$ref": "#/$defs/graph_config"
    },
    "document": {
      "$ref": "#/$defs/document_config"
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard_config"
    },
    "sort": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sort_spec"
      }
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collection"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "collection"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "timeline"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "timeline"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "graph"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "graph"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "document"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "document"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "composite"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "dashboard"
        ],
        "properties": {
          "renderer": {
            "enum": [
              "dashboard",
              "custom"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$"
    },
    "view_renderer": {
      "type": "string",
      "enum": [
        "board",
        "list",
        "table",
        "calendar",
        "gantt",
        "timeline",
        "thread",
        "chat",
        "forum",
        "graph",
        "tree",
        "document",
        "dashboard",
        "custom"
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "object_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "morph_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor_ref": {
          "$ref": "#/$defs/ref"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relation": {
          "type": [
            "object",
            "null"
          ]
        },
        "order_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort_spec"
          }
        }
      },
      "additionalProperties": true
    },
    "sort_spec": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field_path"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "nulls": {
          "type": "string",
          "enum": [
            "first",
            "last"
          ]
        }
      },
      "additionalProperties": false
    },
    "collection_grouping": {
      "type": "object",
      "description": "Grouping / lane / time-bucket / matrix configuration; mirrors models/views.md §3.3. Conditional required-ness is enforced per mode.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "field",
            "relation_container",
            "time_bucket",
            "matrix"
          ]
        },
        "field": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "board_space_id": {
          "type": "string",
          "pattern": "^ck:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "container_relation_kind": {
          "type": "string",
          "default": "contains"
        },
        "item_relation_kind": {
          "type": "string"
        },
        "start_field": {
          "type": "string"
        },
        "end_field": {
          "type": "string"
        },
        "rows_by": {
          "type": "string"
        },
        "columns_by": {
          "type": "string"
        },
        "hidden_count_policy": {
          "type": "string",
          "enum": [
            "omit",
            "authorized_estimate",
            "authorized_exact"
          ],
          "default": "omit"
        },
        "wip_limit_enforcement": {
          "type": "string",
          "enum": [
            "warn",
            "reject",
            "require_review"
          ],
          "default": "warn"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "field"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "field",
              "lanes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "relation_container"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "board_space_id",
              "item_relation_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "time_bucket"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "start_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "matrix"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "rows_by",
              "columns_by"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "collection_config": {
      "type": "object",
      "properties": {
        "item_object_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_render": {
          "type": "string",
          "enum": [
            "card",
            "row",
            "tile",
            "compact",
            "badge",
            "message"
          ]
        },
        "item_order_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sort_spec"
          },
          "description": "Stable item ordering; mirrors models/views.md §3.2. Drag-ordered collections SHOULD sort by rank."
        },
        "display_fields": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Display columns (dot path + format); see models/views.md §3.2."
        },
        "selection_policy": {
          "type": "string",
          "enum": [
            "none",
            "single",
            "multiple"
          ],
          "default": "multiple",
          "description": "UI selection policy; see models/views.md §3.2."
        },
        "count_policy": {
          "type": "string",
          "enum": [
            "omit",
            "authorized_estimate",
            "authorized_exact"
          ],
          "default": "omit",
          "description": "Collection-level count policy; see models/views.md §3.2."
        },
        "grouping": {
          "$ref": "#/$defs/collection_grouping"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "anyOf": [
        {
          "required": [
            "item_object_types"
          ]
        },
        {
          "required": [
            "item_facets"
          ]
        }
      ],
      "additionalProperties": true
    },
    "timeline_config": {
      "type": "object",
      "additionalProperties": true
    },
    "graph_config": {
      "type": "object",
      "additionalProperties": true
    },
    "document_config": {
      "type": "object",
      "additionalProperties": true
    },
    "dashboard_config": {
      "type": "object",
      "required": [
        "widgets"
      ],
      "properties": {
        "widgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "widget_id",
              "kind"
            ],
            "properties": {
              "widget_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "collection",
                  "timeline",
                  "graph",
                  "document",
                  "metric",
                  "text",
                  "custom"
                ]
              },
              "source_view_ref": {
                "$ref": "#/$defs/ref"
              },
              "query": {
                "$ref": "#/$defs/query"
              },
              "title": {
                "type": "string"
              },
              "layout": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "source_view_ref"
                ]
              },
              {
                "required": [
                  "query"
                ]
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "text",
                      "custom"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "string",
      "pattern": "^(ck:(realm|flow|message|morph|relation|event|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|did:.+)$"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
