{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/view.schema.json",
  "title": "Contrix View",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "kind",
    "query",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.view.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "collection",
        "timeline",
        "graph",
        "document",
        "composite"
      ]
    },
    "renderer": {
      "$ref": "#/$defs/view_renderer"
    },
    "title": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "description": "View sharing visibility. Private views are actor-private account data; shared views are canonical Realm objects."
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "visible_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field_path"
      }
    },
    "layout": {
      "type": "object"
    },
    "collection": {
      "$ref": "#/$defs/collection_config"
    },
    "timeline": {
      "$ref": "#/$defs/timeline_config"
    },
    "graph": {
      "$ref": "#/$defs/graph_config"
    },
    "document": {
      "$ref": "#/$defs/document_config"
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard_config"
    },
    "sort": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sort_spec"
      }
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$"
    },
    "view_renderer": {
      "type": "string",
      "enum": [
        "board",
        "list",
        "table",
        "calendar",
        "gantt",
        "timeline",
        "thread",
        "chat",
        "forum",
        "graph",
        "tree",
        "document",
        "dashboard",
        "custom"
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "object_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "morph_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor_ref": {
          "$ref": "#/$defs/ref"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relation": {
          "type": [
            "object",
            "null"
          ]
        },
        "order_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort_spec"
          }
        }
      },
      "additionalProperties": true
    },
    "sort_spec": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field_path"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "nulls": {
          "type": "string",
          "enum": [
            "first",
            "last"
          ]
        }
      },
      "additionalProperties": false
    },
    "collection_config": {
      "type": "object",
      "properties": {
        "item_object_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_render": {
          "type": "string",
          "enum": [
            "card",
            "row",
            "tile",
            "compact",
            "badge",
            "message"
          ]
        },
        "grouping": {
          "type": "object"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "anyOf": [
        {
          "required": [
            "item_object_types"
          ]
        },
        {
          "required": [
            "item_facets"
          ]
        }
      ],
      "additionalProperties": true
    },
    "timeline_config": {
      "type": "object",
      "additionalProperties": true
    },
    "graph_config": {
      "type": "object",
      "additionalProperties": true
    },
    "document_config": {
      "type": "object",
      "additionalProperties": true
    },
    "dashboard_config": {
      "type": "object",
      "additionalProperties": true
    },
    "ref": {
      "type": "string",
      "pattern": "^(cx:(realm|flow|message|morph|relation|event|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|did:.+)$"
    }
  },
  "additionalProperties": true
}
