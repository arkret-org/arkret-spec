{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/view.schema.json",
  "title": "Arkret View",
  "type": "object",
  "required": [
    "schema",
    "realm_id",
    "kind",
    "state",
    "query",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:view:[A-Za-z0-9_-]{44}$",
      "description": "Present on the materialised object. MUST be absent from the create Event payload: zh/models/common-fields.md derives it from the create Event's own event_id (retyped), so a payload-supplied id would be a second, forgeable truth."
    },
    "schema": {
      "const": "ak.schema.view.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "collection",
        "timeline",
        "graph",
        "document",
        "composite"
      ]
    },
    "renderer": {
      "$ref": "#/$defs/view_renderer"
    },
    "title": {
      "$ref": "string-profiles.schema.json#/$defs/display_text_512"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "description": "View sharing visibility. Private views are actor-private account data; shared views are canonical Realm objects."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "tombstoned"
      ],
      "description": "Required View lifecycle state. Shared View removal is an ak.view.update patch to tombstoned; tombstoned is terminal."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the ak.view.update that transitioned state to tombstoned. Actor-supplied values MUST be rejected."
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "visible_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field_path"
      }
    },
    "layout": {
      "type": "object"
    },
    "collection": {
      "$ref": "#/$defs/collection_config"
    },
    "timeline": {
      "$ref": "#/$defs/timeline_config"
    },
    "graph": {
      "$ref": "#/$defs/graph_config"
    },
    "document": {
      "$ref": "#/$defs/document_config"
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard_config"
    },
    "created_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collection"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "collection"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "timeline"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "timeline"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "graph"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "graph"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "document"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "document"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "document"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "dashboard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "composite"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "dashboard"
        ],
        "properties": {
          "renderer": {
            "enum": [
              "dashboard",
              "custom"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "collection"
              ]
            },
            {
              "required": [
                "timeline"
              ]
            },
            {
              "required": [
                "graph"
              ]
            },
            {
              "required": [
                "document"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "tombstoned"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "state_changed_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "state_changed_at"
          ]
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$"
    },
    "view_renderer": {
      "$ref": "./query.schema.json#/$defs/view_renderer"
    },
    "state_frontier": {
      "type": "object",
      "required": [
        "state_digest"
      ],
      "properties": {
        "state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
          }
        },
        "actor_frontiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actor_id",
              "actor_seq",
              "event_id"
            ],
            "properties": {
              "actor_id": {
                "$ref": "./common-ids.schema.json#/$defs/actor_id"
              },
              "actor_seq": {
                "type": "integer",
                "minimum": 0
              },
              "event_id": {
                "type": "string",
                "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
              },
              "hlc": {
                "type": "string",
                "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "document_morph_projection_outcome": {
      "type": "object",
      "required": [
        "document",
        "versions",
        "relations",
        "comments",
        "cursor_presence"
      ],
      "properties": {
        "document": {
          "type": "object",
          "required": [
            "morph_id",
            "realm_id",
            "morph_kind",
            "state",
            "body"
          ],
          "properties": {
            "morph_id": {
              "type": "string",
              "pattern": "^ak:morph:[A-Za-z0-9_-]{44}$"
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "morph_kind": {
              "type": "string"
            },
            "title": {
              "$ref": "string-profiles.schema.json#/$defs/display_text_512"
            },
            "state": {
              "type": "string"
            },
            "state_changed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "fields": {
              "type": "object"
            },
            "body": true,
            "schema_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "created_by": {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            },
            "created_at": {
              "$ref": "#/$defs/timestamp"
            },
            "updated_by": {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            },
            "updated_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "additionalProperties": true
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "cursor_presence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "frontier": {
          "$ref": "#/$defs/state_frontier"
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "object_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "morph_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relation": {
          "type": [
            "object",
            "null"
          ]
        },
        "order_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort_spec"
          }
        }
      },
      "additionalProperties": true
    },
    "sort_spec": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field_path"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "nulls": {
          "type": "string",
          "enum": [
            "first",
            "last"
          ]
        }
      },
      "additionalProperties": false
    },
    "collection_grouping": {
      "type": "object",
      "description": "Grouping / lane / time-bucket / matrix configuration; mirrors models/views.md §3.3. Conditional required-ness is enforced per mode.",
      "propertyNames": {
        "not": {
          "enum": ["selection_policy", "page_size", "wip_limit_enforcement"]
        }
      },
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "field",
            "relation_container",
            "time_bucket",
            "matrix"
          ]
        },
        "field": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "board_space_id": {
          "type": "string",
          "pattern": "^ak:space:[A-Za-z0-9_-]{44}$"
        },
        "container_relation_kind": {
          "type": "string",
          "default": "contains"
        },
        "item_relation_kind": {
          "type": "string"
        },
        "start_field": {
          "type": "string"
        },
        "end_field": {
          "type": "string"
        },
        "rows_by": {
          "type": "string"
        },
        "columns_by": {
          "type": "string"
        },
        "hidden_count_policy": {
          "type": "string",
          "enum": [
            "omit",
            "authorized_estimate",
            "authorized_exact"
          ],
          "default": "omit"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "field"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "field",
              "lanes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "relation_container"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "board_space_id",
              "item_relation_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "time_bucket"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "start_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "matrix"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "rows_by",
              "columns_by"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "collection_config": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["selection_policy", "page_size", "wip_limit_enforcement"]
        }
      },
      "required": [
        "item_order_by",
        "grouping"
      ],
      "properties": {
        "item_object_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "item_facets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "item_render": {
          "type": "string",
          "enum": [
            "card",
            "row",
            "tile",
            "compact",
            "badge",
            "message"
          ]
        },
        "item_order_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sort_spec"
          },
          "description": "Stable item ordering; mirrors models/views.md §3.2. Drag-ordered collections SHOULD sort by rank."
        },
        "display_fields": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Display columns (dot path + format); see models/views.md §3.2."
        },
        "count_policy": {
          "type": "string",
          "enum": [
            "omit",
            "authorized_estimate",
            "authorized_exact"
          ],
          "default": "omit",
          "description": "Collection-level count policy; see models/views.md §3.2."
        },
        "grouping": {
          "$ref": "#/$defs/collection_grouping"
        }
      },
      "anyOf": [
        {
          "required": [
            "item_object_kinds"
          ]
        },
        {
          "required": [
            "item_facets"
          ]
        }
      ],
      "additionalProperties": true
    },
    "timeline_config": {
      "$ref": "./morph.schema.json#/$defs/facet_config"
    },
    "graph_config": {
      "$ref": "./morph.schema.json#/$defs/facet_config"
    },
    "document_config": {
      "$ref": "./morph.schema.json#/$defs/facet_config"
    },
    "dashboard_config": {
      "type": "object",
      "required": [
        "widgets"
      ],
      "properties": {
        "widgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "widget_id",
              "kind"
            ],
            "properties": {
              "widget_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "collection",
                  "timeline",
                  "graph",
                  "document",
                  "metric",
                  "text",
                  "custom"
                ]
              },
              "source_view_ref": {
                "$ref": "#/$defs/object_ref"
              },
              "query": {
                "$ref": "#/$defs/query"
              },
              "title": {
                "$ref": "string-profiles.schema.json#/$defs/display_text_512"
              },
              "layout": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "source_view_ref"
                ]
              },
              {
                "required": [
                  "query"
                ]
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "text",
                      "custom"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "object_ref": {
      "type": "string",
      "pattern": "^(ak:(realm|space|circle|strand|message|morph|relation|event|view):[A-Za-z0-9_-]{44}|did:.+)$"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
