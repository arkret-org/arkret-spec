{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/media-operations.schema.json",
  "title": "Arkret Realtime Media Operation DTOs",
  "description": "Closed request DTOs for realtime media service operations. ak.self.media.read.ice_config responses use ice-config-response.schema.json.",
  "anyOf": [
    {
      "$ref": "#/$defs/media_ice_config_request_body"
    }
  ],
  "$defs": {
    "call_id": {
      "$ref": "./call-recording-artifact.schema.json#/$defs/call_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "media_ice_config_request_body": {
      "type": "object",
      "required": [
        "realm_id",
        "call_id",
        "actor_id",
        "device_id",
        "mode"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "call_id": {
          "$ref": "#/$defs/call_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "mode": {
          "type": "string",
          "enum": [
            "p2p",
            "sfu",
            "turn"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
