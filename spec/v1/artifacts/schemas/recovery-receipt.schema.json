{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/recovery-receipt.schema.json",
  "title": "Arkret Recovery Receipt",
  "description": "Sole complete replacement-device-signed Recovery intent. The two original signed Event submissions and accepted PCR predecessor are inline. This receipt is signed before admission; only the paired authority completion proves two actual consecutive Commits and device activation. No prepared plan or outer terminal attestation exists.",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "transaction_id",
    "account_id",
    "expires_at",
    "recovery_session_id",
    "session_grant_ref",
    "session_grant_cnf_jkt",
    "policy_id",
    "policy_version",
    "trust_domain",
    "new_device_id",
    "identity_model",
    "recovery_authority_kind",
    "previous_model_generation_ref",
    "new_model_generation_ref",
    "proof_summary",
    "recovery_unit",
    "unlocked_backups",
    "welcome_count",
    "outcome",
    "started_at",
    "completed_at",
    "signature_proof"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.recovery_receipt.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "recovery-receipt.schema.json#/properties/schema",
        "owner": "recovery-receipt.schema.json#/properties/schema",
        "values": [
          "ak.schema.recovery_receipt.v1"
        ]
      }
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Caller-preallocated stable transaction identity. The complete canonical signed receipt, including this ID, is frozen before submission and cannot be replaced under this ID."
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id",
      "description": "Exact recovered AccountId. The replacement-device method proves only its principal projection; the accepted recovery session and device authorization independently bind this complete account, including station_id."
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable session identifier used by every proof transcript, backup decrypt proof, and MLS Welcome replay during this recovery. A byte-identical resubmission of an already accepted receipt is idempotent and MUST return the stored receipt; only a SECOND, DIFFERENT receipt for the same session id and exact account is a conflict. Rejecting the byte-identical replay would make a lost response unrecoverable, which zh/identity/security-transactions.md section 1 invariants 3 and 4 forbid."
    },
    "session_grant_ref": {
      "$ref": "./common-ids.schema.json#/$defs/session_grant_ref"
    },
    "session_grant_cnf_jkt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "new_device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identity_model": {
      "const": "pcr_policy",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "recovery-receipt.schema.json#/properties/identity_model",
        "owner": "recovery-receipt.schema.json#/properties/identity_model",
        "values": [
          "pcr_policy"
        ]
      }
    },
    "recovery_authority_kind": {
      "type": "string",
      "enum": [
        "pcr_policy",
        "did_root"
      ],
      "description": "did_root is valid only when the accepted PCR policy explicitly enabled that optional factor.",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "recovery-receipt.schema.json#/properties/recovery_authority_kind",
        "owner": "recovery-receipt.schema.json#/properties/recovery_authority_kind",
        "values": [
          "pcr_policy",
          "did_root"
        ]
      }
    },
    "previous_model_generation_ref": {
      "type": "integer",
      "minimum": 1,
      "description": "PCR device generation snapshotted at recovery-session creation."
    },
    "new_model_generation_ref": {
      "type": "integer",
      "minimum": 2,
      "description": "Accepted monotonic PCR device generation after completion."
    },
    "proof_summary": {
      "type": "object",
      "required": [
        "kind",
        "proof_digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "did_root",
            "recovery_unlock",
            "device_quorum",
            "trusted_recovery_service"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "recovery-receipt.schema.json#/properties/proof_summary/properties/kind",
            "owner": "recovery-receipt.schema.json#/properties/proof_summary/properties/kind",
            "values": [
              "did_root",
              "recovery_unlock",
              "device_quorum",
              "trusted_recovery_service"
            ]
          }
        },
        "proof_digest": {
          "$ref": "#/$defs/digest",
          "description": "Canonical-JSON digest of the proof transcript used to satisfy the active recovery policy. Auditors recompute against the originating proof event to verify."
        },
        "quorum_participant_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Required for device_quorum; equals the number of distinct participating member devices.",
          "x-arkret-member-role": "count"
        }
      },
      "additionalProperties": false
    },
    "recovery_unit": {
      "type": "object",
      "required": [
        "predecessor_ref",
        "events"
      ],
      "properties": {
        "predecessor_ref": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
                },
                {
                  "properties": {
                    "event": {
                      "properties": {
                        "kind": {
                          "const": "ak.device.reanchor",
                          "x-arkret-value-ownership": {
                            "class": "namespaced_symbol",
                            "authority": "recovery-receipt.schema.json#/properties/recovery_unit/properties/events/prefixItems/0/allOf/1/properties/event/properties/kind",
                            "owner": "recovery-receipt.schema.json#/properties/recovery_unit/properties/events/prefixItems/0/allOf/1/properties/event/properties/kind",
                            "values": [
                              "ak.device.reanchor"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
                },
                {
                  "properties": {
                    "event": {
                      "properties": {
                        "kind": {
                          "const": "ak.device.authorize",
                          "x-arkret-value-ownership": {
                            "class": "namespaced_symbol",
                            "authority": "recovery-receipt.schema.json#/properties/recovery_unit/properties/events/prefixItems/1/allOf/1/properties/event/properties/kind",
                            "owner": "recovery-receipt.schema.json#/properties/recovery_unit/properties/events/prefixItems/1/allOf/1/properties/event/properties/kind",
                            "values": [
                              "ak.device.authorize"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false,
      "description": "Exactly the two original EventAdmissionSubmission slots in reanchor/authorize order and their already accepted PCR predecessor. Original producer proofs and applicable approval_signatures are retained. Neither Event may depend on this receipt digest/signature or a future Commit."
    },
    "unlocked_backups": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "backup_kind",
          "backup_id",
          "series_id",
          "ciphertext_digest"
        ],
        "properties": {
          "backup_kind": {
            "type": "string",
            "enum": [
              "secret_storage"
            ],
            "x-arkret-value-ownership": {
              "class": "owned_symbol",
              "authority": "recovery-receipt.schema.json#/properties/unlocked_backups/items/properties/backup_kind",
              "owner": "recovery-receipt.schema.json#/properties/unlocked_backups/items/properties/backup_kind",
              "values": [
                "secret_storage"
              ]
            }
          },
          "backup_id": {
            "type": "string",
            "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "series_id": {
            "type": "string",
            "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "ciphertext_digest": {
            "$ref": "#/$defs/digest"
          }
        },
        "additionalProperties": false
      }
    },
    "welcome_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of MLS Welcomes successfully replayed for the recovering device.",
      "x-arkret-member-role": "count"
    },
    "welcome_realm_summaries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "realm_id",
          "mls_group_id",
          "epoch"
        ],
        "properties": {
          "realm_id": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          },
          "mls_group_id": {
            "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
          },
          "epoch": {
            "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "aborted_by_user",
        "policy_denied",
        "evidence_insufficient",
        "service_defined"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "recovery-receipt.schema.json#/properties/outcome",
        "owner": "recovery-receipt.schema.json#/properties/outcome",
        "values": [
          "completed",
          "partial",
          "aborted_by_user",
          "policy_denied",
          "evidence_insufficient",
          "service_defined"
        ]
      },
      "x-arkret-outcome-scope": "recovery_session_execution"
    },
    "outcome_reason_code": {
      "type": "string",
      "description": "Free-form reason code; MUST be present when outcome != 'completed'."
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Authoring time at which the replacement device signed 'complete this recovery if every check passes'. It is not proof that anything was committed. The durable, linearized commit time is the completed_at of the paired ak.schema.recovery_completion_attestation.v1, which MUST NOT be earlier than this value."
    },
    "signature_proof": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "Exact replacement-device method bound to the original verified RecoverySession candidate. At first admission verify with that session-frozen key, not a current accepted-device lookup. After completion the original accepted authorization and completion proof independently bind the same key."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ],
          "description": "v1 fixes the recovery-strand replacement device possession proof to Ed25519 (zh/crypto-media/device-lifecycle.md sections 5.2 and 14; transaction binding in zh/identity/security-transactions.md section 2). The three-algorithm set in zh/identity/key-management.md section 7.9 belongs to recovery_policy.method signing entries.alg and MUST NOT be reused as a reason to widen this one.",
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "recovery-receipt.schema.json#/properties/signature_proof/properties/signature_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url signature over UTF8('ak.identity.recovery_receipt.signature.v1\\n') followed by RFC 8785 JCS of all present top-level receipt members except signature_proof. The closed receipt shape fixes the projection; absent optional members are omitted and every present optional member is authenticated."
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proof_summary": {
            "properties": {
              "kind": {
                "const": "device_quorum",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "recovery-receipt.schema.json#/allOf/0/if/properties/proof_summary/properties/kind",
                  "owner": "recovery-receipt.schema.json#/allOf/0/if/properties/proof_summary/properties/kind",
                  "values": [
                    "device_quorum"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "proof_summary"
        ]
      },
      "then": {
        "properties": {
          "proof_summary": {
            "required": [
              "quorum_participant_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "not": {
              "const": "completed",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "recovery-receipt.schema.json#/allOf/1/if/properties/outcome/not",
                "owner": "recovery-receipt.schema.json#/allOf/1/if/properties/outcome/not",
                "values": [
                  "completed"
                ]
              }
            },
            "x-arkret-outcome-scope": "recovery_session_execution"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "outcome_reason_code"
        ]
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    }
  },
  "x-arkret-signature-domain": "ak.identity.recovery_receipt.signature.v1"
}
