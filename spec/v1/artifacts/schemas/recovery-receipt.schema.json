{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/recovery-receipt.schema.json",
  "title": "Arkret Recovery Receipt",
  "description": "Signed completion receipt for a principal recovery strand. Bound to the recovery_session_id, identity model, model generation, accepted device authorization path, every proof, backup unlock, and MLS Welcome replay action. Formal recovery receipts are signed only after the recovering device has been accepted via ak.device.authorize; pre-authorization failures use server outcome/audit evidence instead. See crypto-media/device-lifecycle.md §15.",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "transaction_id",
    "principal_id",
    "recovery_session_id",
    "policy_id",
    "policy_version",
    "trust_domain",
    "new_device_id",
    "identity_model",
    "previous_model_generation_ref",
    "result_model_generation_ref",
    "authorization_event_id",
    "proof_summary",
    "backup_classes_unlocked",
    "welcome_count",
    "outcome",
    "started_at",
    "completed_at",
    "auth_data"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.recovery_receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "RecoveryTransaction that reserved this receipt id. It MUST equal the transaction whose binding.terminal_receipt_id is this receipt_id, which is what lets a verifier holding only the receipt resolve the authorizing transaction; binding.terminal_receipt_id alone is one-way. See zh/identity/security-transactions.md section 2."
    },
    "principal_id": {
      "$ref": "#/$defs/did"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable session identifier used by every proof transcript, backup decrypt proof, and MLS Welcome replay during this recovery. A byte-identical resubmission of an already accepted receipt is idempotent and MUST return the stored receipt; only a SECOND, DIFFERENT receipt for the same session id and principal is a conflict. Rejecting the byte-identical replay would make a lost response unrecoverable, which zh/identity/security-transactions.md section 1 invariants 3 and 4 forbid."
    },
    "policy_id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "new_device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identity_model": {
      "type": "string",
      "enum": [
        "cross_signing",
        "enrollment_authority"
      ]
    },
    "previous_model_generation_ref": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*-[^\\s]+$"
        }
      ],
      "description": "Server-snapshotted generation at recovery-session creation: accepted SSK generation for cross_signing or pre-reanchor DID versionId for enrollment_authority."
    },
    "result_model_generation_ref": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*-[^\\s]+$"
        }
      ],
      "description": "Accepted generation after completion. Equals previous_model_generation_ref for an A-model fresh-device recovery without reset; equals the re-anchor did_version_id for B-model recovery."
    },
    "authorization_event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_list_update_event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reanchor_event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reanchor_batch_receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "proof_summary": {
      "type": "object",
      "required": [
        "kind",
        "proof_digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "principal_signing",
            "recovery_unlock",
            "device_quorum",
            "trusted_recovery_service",
            "threshold_recovery"
          ]
        },
        "proof_digest": {
          "$ref": "#/$defs/hash",
          "description": "Canonical-JSON digest of the proof transcript used to satisfy the active recovery policy. Auditors recompute against the originating proof event to verify."
        },
        "quorum_participant_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Required for device_quorum and threshold_recovery; equals the number of participating members / shares."
        },
        "share_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "description": "When kind=threshold_recovery, the share_ids that participated. MUST be a subset of the active policy's shares[]."
        }
      },
      "additionalProperties": false
    },
    "backup_classes_unlocked": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "backup_kind",
          "backup_id",
          "series_id",
          "ciphertext_digest"
        ],
        "properties": {
          "backup_kind": {
            "type": "string",
            "enum": [
              "did_recovery",
              "secret_storage",
              "mls_history"
            ]
          },
          "backup_id": {
            "type": "string",
            "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "series_id": {
            "type": "string",
            "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "ciphertext_digest": {
            "$ref": "#/$defs/hash"
          }
        },
        "additionalProperties": false
      }
    },
    "welcome_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of MLS Welcomes successfully replayed for the recovering device."
    },
    "welcome_realm_summary": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "realm_id",
          "mls_group_id",
          "epoch"
        ],
        "properties": {
          "realm_id": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          },
          "mls_group_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "aborted_by_user",
        "policy_denied",
        "evidence_insufficient",
        "service_defined"
      ]
    },
    "outcome_reason_code": {
      "type": "string",
      "description": "Free-form reason code; MUST be present when outcome != 'completed'."
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature",
        "signed_fields"
      ],
      "properties": {
        "verification_method": {
          "type": "string",
          "description": "DID URL of the new_device_id's accepted device key. Receivers MUST resolve it through the principal control stream and verify that ak.device.authorize for new_device_id was accepted before this receipt was signed; service keys and unauthorised fresh-device keys MUST NOT sign a formal recovery_receipt."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ],
          "description": "v1 fixes the recovery-strand replacement device possession proof to Ed25519 (zh/crypto-media/device-lifecycle.md sections 5.2 and 15). The three-algorithm set in zh/identity/key-management.md section 7.9 belongs to recovery_policy.recovery_keys[].alg and MUST NOT be reused as a reason to widen this one."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "allOf": [
            {
              "contains": {
                "const": "schema"
              }
            },
            {
              "contains": {
                "const": "receipt_id"
              }
            },
            {
              "contains": {
                "const": "principal_id"
              }
            },
            {
              "contains": {
                "const": "recovery_session_id"
              }
            },
            {
              "contains": {
                "const": "policy_id"
              }
            },
            {
              "contains": {
                "const": "policy_version"
              }
            },
            {
              "contains": {
                "const": "trust_domain"
              }
            },
            {
              "contains": {
                "const": "new_device_id"
              }
            },
            {
              "contains": {
                "const": "identity_model"
              }
            },
            {
              "contains": {
                "const": "previous_model_generation_ref"
              }
            },
            {
              "contains": {
                "const": "result_model_generation_ref"
              }
            },
            {
              "contains": {
                "const": "authorization_event_id"
              }
            },
            {
              "contains": {
                "const": "proof_summary"
              }
            },
            {
              "contains": {
                "const": "backup_classes_unlocked"
              }
            },
            {
              "contains": {
                "const": "welcome_count"
              }
            },
            {
              "contains": {
                "const": "outcome"
              }
            },
            {
              "contains": {
                "const": "started_at"
              }
            },
            {
              "contains": {
                "const": "completed_at"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proof_summary": {
            "properties": {
              "kind": {
                "const": "threshold_recovery"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "proof_summary"
        ]
      },
      "then": {
        "properties": {
          "proof_summary": {
            "required": [
              "quorum_participant_count",
              "share_ids"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_summary": {
            "properties": {
              "kind": {
                "const": "device_quorum"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "proof_summary"
        ]
      },
      "then": {
        "properties": {
          "proof_summary": {
            "required": [
              "quorum_participant_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "not": {
              "const": "completed"
            }
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "outcome_reason_code"
        ],
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "outcome_reason_code"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "welcome_realm_summary"
        ]
      },
      "then": {
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "welcome_realm_summary"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_model": {
            "const": "cross_signing"
          }
        },
        "required": [
          "identity_model"
        ]
      },
      "then": {
        "required": [
          "device_list_update_event_id"
        ],
        "properties": {
          "previous_model_generation_ref": {
            "type": "integer",
            "minimum": 1
          },
          "result_model_generation_ref": {
            "type": "integer",
            "minimum": 1
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "contains": {
                  "const": "device_list_update_event_id"
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "reanchor_event_id"
              ]
            },
            {
              "required": [
                "reanchor_batch_receipt_id"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "reanchor_event_id",
          "reanchor_batch_receipt_id"
        ],
        "properties": {
          "previous_model_generation_ref": {
            "type": "string",
            "pattern": "^[1-9][0-9]*-[^\\s]+$"
          },
          "result_model_generation_ref": {
            "type": "string",
            "pattern": "^[1-9][0-9]*-[^\\s]+$"
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "reanchor_event_id"
                    }
                  },
                  {
                    "contains": {
                      "const": "reanchor_batch_receipt_id"
                    }
                  }
                ]
              }
            }
          }
        },
        "not": {
          "required": [
            "device_list_update_event_id"
          ]
        }
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    }
  }
}
