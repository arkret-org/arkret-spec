{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/sdk-conformance-claim.schema.json",
  "x-arkret-conformance-vector": "ak.vector.sdk_conformance.claim_validation.v1",
  "title": "Arkret SDK Conformance Claim",
  "description": "Signed, artifact-bound SDK release claim. The proof covers RFC 8785 JCS bytes of the object with proof omitted, prefixed by the UTF-8 domain separator arkret-sdk-conformance-claim-v1 followed by LF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sdk_name",
    "sdk_version",
    "sdk_artifact",
    "spec_revision",
    "contract_digest",
    "issued_at",
    "issuer",
    "clause_claims",
    "proof"
  ],
  "properties": {
    "sdk_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sdk_artifact": {
      "$ref": "#/$defs/artifact_subject"
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": {
        "pattern": "^0{40}$"
      }
    },
    "contract_digest": {
      "$ref": "#/$defs/nonzero_digest"
    },
    "issued_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "clause_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/clause_claim"
      }
    },
    "build_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/build_variant"
      },
      "description": "Optional per-build profile inventory for source or multi-variant SDK distributions. Each complete features/configuration inventory is covered by the claim proof and the existing AK-SDK-015 build_variant_inventory digest. Variant IDs MUST be unique; no separate per-feature digest is carried."
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "nonzero_digest": {
      "allOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "not": {
            "pattern": "^(sha256|blake3):0{64}$"
          }
        }
      ]
    },
    "artifact_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(https|oci|git|urn):.+$",
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/nonzero_digest"
        }
      }
    },
    "build_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "features",
        "configuration",
        "claimed_profiles"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "features": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$"
          },
          "description": "Complete enabled feature names, sorted in strictly increasing ASCII order. An empty array explicitly represents no enabled optional features."
        },
        "configuration": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          },
          "description": "Complete non-secret behavior-affecting build configuration, including target, compiler/toolchain, profile, default-feature policy and relevant flags. Keys are tool-qualified stable names, values are exact canonical build inputs. Defaults MUST be expanded. Secrets MUST NOT be included. The publisher MUST fail closed if the inventory cannot reproduce the claimed configuration."
        },
        "claimed_profiles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ak\\.profile\\.[a-z0-9_.-]+\\.v1$"
          }
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verification_method"
      ],
      "properties": {
        "id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$",
          "maxLength": 2048
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$",
          "maxLength": 2048
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 43,
          "maxLength": 8192
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence_ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vector_result",
            "public_api_inventory",
            "build_variant_inventory",
            "code_audit",
            "config_audit",
            "data_flow_audit"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/nonzero_digest"
        }
      }
    },
    "clause_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "result",
        "evidence"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^AK-SDK-[0-9]{3}$"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "not_applicable"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ]
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
