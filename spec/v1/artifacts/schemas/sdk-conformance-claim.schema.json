{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/sdk-conformance-claim.schema.json",
  "x-arkret-conformance-vector": "ak.vector.sdk_conformance.claim_validation.v1",
  "title": "Arkret SDK Conformance Claim",
  "description": "Machine-verifiable SDK release claim against artifacts/profiles/conformance-profiles.json#sdk_conformance_contract. Clause-id uniqueness and required-evidence coverage are semantic checks performed after JSON Schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sdk_name",
    "sdk_version",
    "spec_revision",
    "contract_digest",
    "clause_claims"
  ],
  "properties": {
    "sdk_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "clause_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/clause_claim"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vector_result",
            "public_api_inventory",
            "code_audit",
            "config_audit",
            "data_flow_audit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "clause_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "result",
        "evidence"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^AK-SDK-[0-9]{3}$"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "not_applicable"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ]
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
