{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/policy.schema.json",
  "title": "Arkret Policy",
  "type": "object",
  "required": [
    "id",
    "schema",
    "policy_type",
    "rules",
    "default_effect",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ak.schema.policy.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "access",
        "encryption",
        "retention",
        "federation",
        "moderation",
        "discoverability",
        "join",
        "history_visibility",
        "plaintext_visibility",
        "media",
        "applet",
        "agent"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policy_rule"
      }
    },
    "default_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "policy_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "policy_rule": {
      "type": "object",
      "description": "Closed policy rule. Extension rules must carry an explicit schema_ref/profile_ref instead of adding undeclared fields to the signed policy body.",
      "required": [
        "rule_id",
        "kind",
        "effect"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "resource",
            "server",
            "actor",
            "temporal",
            "rate_limit",
            "crypto",
            "moderation",
            "extension"
          ]
        },
        "effect": {
          "$ref": "#/$defs/policy_effect"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "realm",
                  "strand",
                  "space",
                  "object",
                  "service"
                ]
              },
              "realm_id": {
                "$ref": "./common-ids.schema.json#/$defs/realm_id"
              },
              "resource_ref": {
                "type": "string",
                "pattern": "^(ak:[a-z0-9_]+:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*|did:[^\\s]+)$"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "servers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/server_selector"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^ak\\.schema\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "actions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "resource"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "resources"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "server"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "servers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "extension"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "schema_ref"
                ]
              },
              {
                "required": [
                  "profile_ref"
                ]
              }
            ],
            "required": [
              "params"
            ]
          }
        }
      ]
    },
    "trust_domain": {
      "type": "string",
      "pattern": "^ak:trust_domain:[a-z0-9][a-z0-9._\\-:]{0,127}$"
    },
    "domain_name": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Lowercase DNS A-label domain. Matching semantics are label-boundary based and defined by governance/content-moderation.md."
    },
    "server_selector": {
      "type": "object",
      "description": "Selector for federation server policy rules. Domain rules match normalized DNS labels only; service_id exact rules take precedence in policy evaluation.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service_id",
            "domain",
            "trust_domain"
          ]
        },
        "service_id": {
          "$ref": "#/$defs/did"
        },
        "domain": {
          "$ref": "#/$defs/domain_name"
        },
        "match_subdomains": {
          "type": "boolean",
          "default": false
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service_id"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "service_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "domain"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "domain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "trust_domain"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "trust_domain"
            ]
          }
        }
      ]
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
