{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/policy.schema.json",
  "title": "Arkret Policy",
  "type": "object",
  "required": [
    "id",
    "schema",
    "policy_kind",
    "rules",
    "default_effect",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ak.schema.policy.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "policy.schema.json#/properties/schema",
        "owner": "policy.schema.json#/properties/schema",
        "values": [
          "ak.schema.policy.v1"
        ]
      }
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "policy_kind": {
      "type": "string",
      "enum": [
        "access",
        "encryption",
        "retention",
        "federation",
        "moderation",
        "discoverability",
        "join",
        "history_access",
        "plaintext_visibility",
        "media",
        "applet",
        "agent"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "policy.schema.json#/properties/policy_kind",
        "owner": "policy.schema.json#/properties/policy_kind",
        "values": [
          "access",
          "encryption",
          "retention",
          "federation",
          "moderation",
          "discoverability",
          "join",
          "history_access",
          "plaintext_visibility",
          "media",
          "applet",
          "agent"
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policy_rule"
      }
    },
    "default_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "policy.schema.json#/properties/default_effect",
        "owner": "policy.schema.json#/properties/default_effect",
        "values": [
          "allow",
          "deny",
          "quarantine",
          "require_review"
        ]
      }
    },
    "default_review_requirement": {
      "$ref": "#/$defs/management_review_requirement"
    },
    "default_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "join",
          "publish",
          "create_bot",
          "map_ghost"
        ],
        "x-arkret-value-ownership": {
          "class": "owned_symbol",
          "authority": "policy.schema.json#/properties/default_operations/items",
          "owner": "policy.schema.json#/properties/default_operations/items",
          "values": [
            "join",
            "publish",
            "create_bot",
            "map_ghost"
          ]
        }
      },
      "description": "Required when a managed default is require_review: only these review-capable operations use that default; nonselected operations default deny unless an explicit rule matches."
    },
    "priority": {
      "type": "integer"
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "policy_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "policy.schema.json#/$defs/policy_effect",
        "owner": "policy.schema.json#/$defs/policy_effect",
        "values": [
          "allow",
          "deny",
          "quarantine",
          "require_review"
        ]
      }
    },
    "policy_rule": {
      "type": "object",
      "description": "Closed policy rule. Extension rules must carry an explicit schema_ref/profile_ref instead of adding undeclared fields to the signed policy body.",
      "required": [
        "rule_id",
        "kind",
        "effect"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "resource",
            "server",
            "actor",
            "temporal",
            "rate_limit",
            "crypto",
            "moderation",
            "extension",
            "agent",
            "applet"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "policy.schema.json#/$defs/policy_rule/properties/kind",
            "owner": "policy.schema.json#/$defs/policy_rule/properties/kind",
            "values": [
              "action",
              "resource",
              "server",
              "actor",
              "temporal",
              "rate_limit",
              "crypto",
              "moderation",
              "extension",
              "agent",
              "applet"
            ]
          }
        },
        "effect": {
          "$ref": "#/$defs/policy_effect"
        },
        "priority": {
          "type": "integer",
          "default": 0,
          "description": "Rule evaluation priority. Higher values are evaluated first; omitted means 0."
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "realm",
                  "strand",
                  "space",
                  "object",
                  "service"
                ],
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/properties/resources/items/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/properties/resources/items/properties/kind",
                  "values": [
                    "realm",
                    "strand",
                    "space",
                    "object",
                    "service"
                  ]
                }
              },
              "realm_id": {
                "$ref": "./common-ids.schema.json#/$defs/realm_id"
              },
              "resource_ref": {
                "type": "string",
                "pattern": "^(ak:[a-z0-9_]+:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*|did:[^\\s]+)$"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "servers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/server_selector"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^ak\\.schema\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "agent_target": {
          "$ref": "#/$defs/agent_target"
        },
        "agent_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "join",
              "authorize",
              "execute",
              "read",
              "deliver",
              "publish",
              "serve"
            ],
            "x-arkret-value-ownership": {
              "class": "owned_symbol",
              "authority": "policy.schema.json#/$defs/policy_rule/properties/agent_operations/items",
              "owner": "policy.schema.json#/$defs/policy_rule/properties/agent_operations/items",
              "values": [
                "join",
                "authorize",
                "execute",
                "read",
                "deliver",
                "publish",
                "serve"
              ]
            }
          }
        },
        "applet_target": {
          "$ref": "#/$defs/applet_target"
        },
        "applet_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "install",
              "create_bot",
              "map_ghost",
              "join",
              "authorize",
              "execute",
              "read",
              "deliver",
              "publish",
              "serve",
              "invoke"
            ],
            "x-arkret-value-ownership": {
              "class": "owned_symbol",
              "authority": "policy.schema.json#/$defs/policy_rule/properties/applet_operations/items",
              "owner": "policy.schema.json#/$defs/policy_rule/properties/applet_operations/items",
              "values": [
                "install",
                "create_bot",
                "map_ghost",
                "join",
                "authorize",
                "execute",
                "read",
                "deliver",
                "publish",
                "serve",
                "invoke"
              ]
            }
          }
        },
        "review_requirement": {
          "$ref": "#/$defs/management_review_requirement"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/0/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/0/if/properties/kind",
                  "values": [
                    "action"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "actions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "resource",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/1/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/1/if/properties/kind",
                  "values": [
                    "resource"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "resources"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "server",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/2/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/2/if/properties/kind",
                  "values": [
                    "server"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "servers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "extension",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/3/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/3/if/properties/kind",
                  "values": [
                    "extension"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "schema_ref"
                ]
              },
              {
                "required": [
                  "profile_ref"
                ]
              }
            ],
            "required": [
              "parameters"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/4/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/4/if/properties/kind",
                  "values": [
                    "agent"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "agent_target",
              "agent_operations"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "conditions"
                  ]
                },
                {
                  "required": [
                    "parameters"
                  ]
                },
                {
                  "required": [
                    "schema_ref"
                  ]
                },
                {
                  "required": [
                    "profile_ref"
                  ]
                },
                {
                  "required": [
                    "servers"
                  ]
                },
                {
                  "required": [
                    "applet_target"
                  ]
                },
                {
                  "required": [
                    "applet_operations"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "agent_target"
                  ]
                },
                {
                  "required": [
                    "agent_operations"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "applet",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/5/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/5/if/properties/kind",
                  "values": [
                    "applet"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "applet_target",
              "applet_operations"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "agent_target"
                  ]
                },
                {
                  "required": [
                    "agent_operations"
                  ]
                },
                {
                  "required": [
                    "conditions"
                  ]
                },
                {
                  "required": [
                    "parameters"
                  ]
                },
                {
                  "required": [
                    "servers"
                  ]
                },
                {
                  "required": [
                    "schema_ref"
                  ]
                },
                {
                  "required": [
                    "profile_ref"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "applet_target"
                  ]
                },
                {
                  "required": [
                    "applet_operations"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "review_requirement"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "applet"
                ],
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/6/then/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/6/then/properties/kind",
                  "values": [
                    "agent",
                    "applet"
                  ]
                }
              },
              "effect": {
                "const": "require_review",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/6/then/properties/effect",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/6/then/properties/effect",
                  "values": [
                    "require_review"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "applet"
                ],
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/7/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/7/if/properties/kind",
                  "values": [
                    "agent",
                    "applet"
                  ]
                }
              },
              "effect": {
                "const": "require_review",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/7/if/properties/effect",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/7/if/properties/effect",
                  "values": [
                    "require_review"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "effect"
            ]
          },
          "then": {
            "required": [
              "review_requirement"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/8/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/8/if/properties/kind",
                  "values": [
                    "agent"
                  ]
                }
              },
              "effect": {
                "const": "require_review",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/8/if/properties/effect",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/8/if/properties/effect",
                  "values": [
                    "require_review"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "effect"
            ]
          },
          "then": {
            "properties": {
              "agent_operations": {
                "items": {
                  "enum": [
                    "join",
                    "publish"
                  ],
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "policy.schema.json#/$defs/policy_rule/allOf/8/then/properties/agent_operations/items",
                    "owner": "policy.schema.json#/$defs/policy_rule/allOf/8/then/properties/agent_operations/items",
                    "values": [
                      "join",
                      "publish"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "applet",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/9/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/9/if/properties/kind",
                  "values": [
                    "applet"
                  ]
                }
              },
              "effect": {
                "const": "require_review",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/policy_rule/allOf/9/if/properties/effect",
                  "owner": "policy.schema.json#/$defs/policy_rule/allOf/9/if/properties/effect",
                  "values": [
                    "require_review"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "effect"
            ]
          },
          "then": {
            "properties": {
              "applet_operations": {
                "items": {
                  "enum": [
                    "join",
                    "publish",
                    "create_bot",
                    "map_ghost"
                  ],
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "policy.schema.json#/$defs/policy_rule/allOf/9/then/properties/applet_operations/items",
                    "owner": "policy.schema.json#/$defs/policy_rule/allOf/9/then/properties/applet_operations/items",
                    "values": [
                      "join",
                      "publish",
                      "create_bot",
                      "map_ghost"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "domain_name": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Lowercase DNS A-label domain. Matching semantics are label-boundary based and defined by governance/content-moderation.md."
    },
    "server_selector": {
      "type": "object",
      "description": "Selector for federation server policy rules. Domain rules match normalized DNS labels only; service_id exact rules take precedence in policy evaluation.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service_id",
            "domain",
            "trust_domain"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "policy.schema.json#/$defs/server_selector/properties/kind",
            "owner": "policy.schema.json#/$defs/server_selector/properties/kind",
            "values": [
              "service_id",
              "domain",
              "trust_domain"
            ]
          }
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "domain": {
          "$ref": "#/$defs/domain_name"
        },
        "match_subdomains": {
          "type": "boolean",
          "default": false
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service_id",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/server_selector/allOf/0/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/server_selector/allOf/0/if/properties/kind",
                  "values": [
                    "service_id"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "service_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "domain",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "policy.schema.json#/$defs/server_selector/allOf/1/if/properties/kind",
                  "owner": "policy.schema.json#/$defs/server_selector/allOf/1/if/properties/kind",
                  "values": [
                    "domain"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
