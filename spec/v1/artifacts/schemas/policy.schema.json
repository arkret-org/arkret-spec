{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/policy.schema.json",
  "title": "Contrix Policy",
  "type": "object",
  "required": [
    "id",
    "schema",
    "policy_type",
    "rules",
    "default_effect",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.policy.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "access",
        "encryption",
        "retention",
        "federation",
        "moderation",
        "discoverability",
        "join",
        "history_visibility",
        "plaintext_visibility",
        "media",
        "applet",
        "agent"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy_rule"
      }
    },
    "default_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "policy_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "policy_rule": {
      "type": "object",
      "description": "Closed policy rule. Extension rules must carry an explicit schema_ref/profile_ref instead of adding undeclared fields to the signed policy body.",
      "required": [
        "rule_id",
        "kind",
        "effect"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "resource",
            "actor",
            "temporal",
            "rate_limit",
            "crypto",
            "moderation",
            "extension"
          ]
        },
        "effect": {
          "$ref": "#/$defs/policy_effect"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^cx\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "realm",
                  "flow",
                  "space",
                  "object",
                  "service"
                ]
              },
              "realm_id": {
                "type": "string",
                "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "ref": {
                "type": "string",
                "pattern": "^(cx:[a-z0-9_]+:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*|did:[^\\s]+)$"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^cx\\.schema\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^cx\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "action" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["actions"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "resource" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["resources"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "extension" } },
            "required": ["kind"]
          },
          "then": {
            "anyOf": [
              { "required": ["schema_ref"] },
              { "required": ["profile_ref"] }
            ],
            "required": ["params"]
          }
        }
      ]
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
