{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/policy.schema.json",
  "title": "Contrix Policy",
  "type": "object",
  "required": [
    "id",
    "policy_type",
    "rules",
    "default_effect",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.policy.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "access",
        "encryption",
        "retention",
        "federation",
        "moderation",
        "discoverability",
        "join",
        "history_visibility",
        "plaintext_visibility",
        "media",
        "applet",
        "agent"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "effect"
        ],
        "properties": {
          "effect": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "quarantine",
              "require_review"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "default_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "valid_from": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
