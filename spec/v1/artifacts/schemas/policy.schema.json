{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/policy.schema.json",
  "title": "Arkret Policy",
  "type": "object",
  "required": [
    "id",
    "schema",
    "policy_kind",
    "rules",
    "default_effect",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ak.schema.policy.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "policy_kind": {
      "type": "string",
      "enum": [
        "access",
        "encryption",
        "retention",
        "federation",
        "moderation",
        "discoverability",
        "join",
        "history_access",
        "plaintext_visibility",
        "media",
        "applet",
        "agent"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policy_rule"
      }
    },
    "default_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "default_review_requirement": {
      "$ref": "#/$defs/management_review_requirement"
    },
    "default_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "join",
          "publish",
          "create_bot",
          "map_ghost"
        ]
      },
      "description": "Required when a managed default is require_review: only these review-capable operations use that default; nonselected operations default deny unless an explicit rule matches."
    },
    "priority": {
      "type": "integer"
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "policy_effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "policy_rule": {
      "type": "object",
      "description": "Closed policy rule. Extension rules must carry an explicit schema_ref/profile_ref instead of adding undeclared fields to the signed policy body.",
      "required": [
        "rule_id",
        "kind",
        "effect"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "resource",
            "server",
            "actor",
            "temporal",
            "rate_limit",
            "crypto",
            "moderation",
            "extension",
            "agent",
            "applet"
          ]
        },
        "effect": {
          "$ref": "#/$defs/policy_effect"
        },
        "priority": {
          "type": "integer",
          "default": 0,
          "description": "Rule evaluation priority. Higher values are evaluated first; omitted means 0."
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "realm",
                  "strand",
                  "space",
                  "object",
                  "service"
                ]
              },
              "realm_id": {
                "$ref": "./common-ids.schema.json#/$defs/realm_id"
              },
              "resource_ref": {
                "type": "string",
                "pattern": "^(ak:[a-z0-9_]+:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*|did:[^\\s]+)$"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "servers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/server_selector"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^ak\\.schema\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "agent_target": {
          "$ref": "#/$defs/agent_target"
        },
        "agent_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "join",
              "authorize",
              "execute",
              "read",
              "deliver",
              "publish",
              "serve"
            ]
          }
        },
        "applet_target": {
          "$ref": "#/$defs/applet_target"
        },
        "applet_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "install",
              "create_bot",
              "map_ghost",
              "join",
              "authorize",
              "execute",
              "read",
              "deliver",
              "publish",
              "serve",
              "invoke"
            ]
          }
        },
        "review_requirement": {
          "$ref": "#/$defs/management_review_requirement"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "actions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "resource"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "resources"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "server"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "servers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "extension"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "schema_ref"
                ]
              },
              {
                "required": [
                  "profile_ref"
                ]
              }
            ],
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "agent_target",
              "agent_operations"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "conditions"
                  ]
                },
                {
                  "required": [
                    "params"
                  ]
                },
                {
                  "required": [
                    "schema_ref"
                  ]
                },
                {
                  "required": [
                    "profile_ref"
                  ]
                },
                {
                  "required": [
                    "servers"
                  ]
                },
                {
                  "required": [
                    "applet_target"
                  ]
                },
                {
                  "required": [
                    "applet_operations"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "agent_target"
                  ]
                },
                {
                  "required": [
                    "agent_operations"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "applet"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "applet_target",
              "applet_operations"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "agent_target"
                  ]
                },
                {
                  "required": [
                    "agent_operations"
                  ]
                },
                {
                  "required": [
                    "conditions"
                  ]
                },
                {
                  "required": [
                    "params"
                  ]
                },
                {
                  "required": [
                    "servers"
                  ]
                },
                {
                  "required": [
                    "schema_ref"
                  ]
                },
                {
                  "required": [
                    "profile_ref"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "applet_target"
                  ]
                },
                {
                  "required": [
                    "applet_operations"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "review_requirement"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "applet"
                ]
              },
              "effect": {
                "const": "require_review"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "applet"
                ]
              },
              "effect": {
                "const": "require_review"
              }
            },
            "required": [
              "kind",
              "effect"
            ]
          },
          "then": {
            "required": [
              "review_requirement"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              },
              "effect": {
                "const": "require_review"
              }
            },
            "required": [
              "kind",
              "effect"
            ]
          },
          "then": {
            "properties": {
              "agent_operations": {
                "items": {
                  "enum": [
                    "join",
                    "publish"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "applet"
              },
              "effect": {
                "const": "require_review"
              }
            },
            "required": [
              "kind",
              "effect"
            ]
          },
          "then": {
            "properties": {
              "applet_operations": {
                "items": {
                  "enum": [
                    "join",
                    "publish",
                    "create_bot",
                    "map_ghost"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "domain_name": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Lowercase DNS A-label domain. Matching semantics are label-boundary based and defined by governance/content-moderation.md."
    },
    "server_selector": {
      "type": "object",
      "description": "Selector for federation server policy rules. Domain rules match normalized DNS labels only; service_id exact rules take precedence in policy evaluation.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service_id",
            "domain",
            "trust_domain"
          ]
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "domain": {
          "$ref": "#/$defs/domain_name"
        },
        "match_subdomains": {
          "type": "boolean",
          "default": false
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service_id"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "service_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "domain"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "domain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "trust_domain"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "trust_domain"
            ]
          }
        }
      ]
    },
    "agent_target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "controller_account_id"
          ],
          "properties": {
            "kind": {
              "const": "controller"
            },
            "controller_account_id": {
              "$ref": "./common-ids.schema.json#/$defs/account_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "agent_account_id"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "agent_account_id": {
              "$ref": "./common-ids.schema.json#/$defs/account_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "applet_target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "actor_id"
          ],
          "properties": {
            "kind": {
              "const": "requester"
            },
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "applet_id",
            "effective_scope"
          ],
          "properties": {
            "kind": {
              "const": "installation"
            },
            "applet_id": {
              "$ref": "./common-ids.schema.json#/$defs/applet_id"
            },
            "effective_scope": {
              "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "actor_id"
          ],
          "properties": {
            "kind": {
              "const": "managed_actor"
            },
            "actor_id": {
              "allOf": [
                {
                  "$ref": "./common-ids.schema.json#/$defs/actor_id"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "account"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "management_review_requirement": {
      "type": "object",
      "required": [
        "approver_actor_ids",
        "threshold",
        "max_age_seconds"
      ],
      "properties": {
        "approver_actor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          }
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "rules": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "agent"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        },
        "required": [
          "rules"
        ]
      },
      "then": {
        "required": [
          "realm_id"
        ],
        "properties": {
          "policy_kind": {
            "const": "agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rules": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "applet"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        },
        "required": [
          "rules"
        ]
      },
      "then": {
        "required": [
          "realm_id"
        ],
        "properties": {
          "policy_kind": {
            "const": "applet"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_kind": {
            "enum": [
              "agent",
              "applet"
            ]
          },
          "default_effect": {
            "const": "require_review"
          }
        },
        "required": [
          "policy_kind",
          "default_effect"
        ]
      },
      "then": {
        "required": [
          "default_review_requirement",
          "default_operations"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "default_review_requirement"
              ]
            },
            {
              "required": [
                "default_operations"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_kind": {
            "const": "agent"
          }
        },
        "required": [
          "policy_kind"
        ]
      },
      "then": {
        "properties": {
          "default_operations": {
            "items": {
              "enum": [
                "join",
                "publish"
              ]
            }
          }
        }
      }
    }
  ]
}
