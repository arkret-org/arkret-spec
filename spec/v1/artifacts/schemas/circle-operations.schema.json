{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/circle-operations.schema.json",
  "title": "Arkret Circle Self-Management Operation DTOs",
  "description": "Closed request/response DTOs for the self-surface Circle administration operations (ak.self.circle.*). Every write operation carries the caller-signed ak.circle.* Event and the service submits those exact bytes through ordinary Event admission; the durable Circle object model is circle.schema.json. See spec/v1/zh/models/circle.md and spec/v1/zh/sync/service-http-binding.md.",
  "anyOf": [
    {
      "$ref": "#/$defs/circle_create_request_body"
    },
    {
      "$ref": "#/$defs/circle_view"
    },
    {
      "$ref": "#/$defs/circle_list"
    },
    {
      "$ref": "#/$defs/circle_member_request_body"
    },
    {
      "$ref": "#/$defs/circle_member_delete_request_body"
    },
    {
      "$ref": "#/$defs/circle_membership_outcome"
    },
    {
      "$ref": "#/$defs/circle_scope_rotate_outcome"
    }
  ],
  "$defs": {
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "circle_state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "tombstoned"
      ]
    },
    "circle_view": {
      "type": "object",
      "description": "Circle projection row returned by create/get/lifecycle operations. Reducer-managed mls_group_id is present exactly for MLS-backed Circles; actor create payloads cannot carry it.",
      "required": [
        "circle_id",
        "realm_id",
        "title",
        "display",
        "directory_visibility",
        "join_rule",
        "history_access",
        "encryption_profile",
        "state",
        "member_ids",
        "created_by",
        "created_at"
      ],
      "properties": {
        "circle_id": {
          "$ref": "./common-ids.schema.json#/$defs/circle_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9_.-]+\\.v1$",
          "description": "Create-locked Circle semantic profile discriminator. Ordinary Circles omit it; profile-specific Circles expose it so clients can apply mandatory filtering."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "summary": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        },
        "display": {
          "$ref": "./circle.schema.json#/$defs/display"
        },
        "directory_visibility": {
          "type": "string",
          "enum": [
            "member_ids",
            "realm_members"
          ]
        },
        "join_rule": {
          "type": "string",
          "enum": [
            "invite",
            "knock",
            "public"
          ]
        },
        "history_access": {
          "type": "string",
          "enum": [
            "since_join",
            "all_history_for_current_members"
          ]
        },
        "content_encryption_floor": {
          "type": "string",
          "enum": [
            "allow_plaintext",
            "e2ee_required"
          ]
        },
        "metadata_encryption_floor": {
          "type": "string",
          "enum": [
            "allow_plaintext",
            "e2ee_required"
          ]
        },
        "encryption_profile": {
          "type": "string",
          "enum": [
            "none",
            "mls_rfc9420"
          ]
        },
        "content_scheme": {
          "enum": [
            "mls_rfc9420",
            "mls_exporter_aead_v1"
          ]
        },
        "mls_group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Reducer-derived base64url_no_pad(utf8(canonical CircleId))."
        },
        "durability_policy": {
          "type": "string",
          "enum": [
            "none",
            "organization_recovery_key"
          ]
        },
        "state": {
          "$ref": "#/$defs/circle_state"
        },
        "viewer_membership": {
          "$ref": "./event-payload.schema.json#/$defs/membership_state",
          "description": "The caller's own Circle membership state when one exists."
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor_id"
          },
          "uniqueItems": true,
          "description": "Active Circle member ActorIds (strict subset of parent Realm.members). Empty after tombstone. The member count is derived as member_ids.length and is never carried as a separate wire field; directory-only previews never carry member_ids and use the privacy-bucketed preview contract instead."
        },
        "created_by": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_by": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "encryption_profile": {
                "const": "none"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "content_scheme"
                  ]
                },
                {
                  "required": [
                    "mls_group_id"
                  ]
                },
                {
                  "required": [
                    "durability_policy"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "encryption_profile": {
                "const": "mls_rfc9420"
              }
            }
          },
          "then": {
            "required": [
              "content_scheme",
              "mls_group_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "content_scheme": {
                "const": "mls_rfc9420"
              }
            },
            "required": [
              "content_scheme"
            ]
          },
          "then": {
            "properties": {
              "history_access": {
                "const": "since_join"
              }
            },
            "not": {
              "required": [
                "durability_policy"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_scheme": {
                "const": "mls_exporter_aead_v1"
              }
            },
            "required": [
              "content_scheme"
            ]
          },
          "then": {
            "required": [
              "durability_policy"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "circle_create_request_body": {
      "type": "object",
      "description": "Carries the caller-signed ak.circle.create Event and nothing else. The Circle id is retype(create_event.event.event_id), so the service cannot name the Circle and MUST NOT synthesize the Event: every actor-supplied field lives in create_event.event.payload.object, and the parent Realm is create_event.event.realm_id. See spec/v1/zh/models/circle.md and spec/v1/zh/sync/service-http-binding.md.",
      "required": [
        "create_event"
      ],
      "properties": {
        "create_event": {
          "allOf": [
            {
              "$ref": "./service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
            },
            {
              "properties": {
                "event": {
                  "properties": {
                    "kind": {
                      "const": "ak.circle.create"
                    }
                  },
                  "required": [
                    "kind",
                    "realm_id"
                  ]
                }
              },
              "required": [
                "event"
              ]
            }
          ],
          "description": "Closed ak.circle.create Event authored and signed by the authenticated caller. Admission requires the payload closed union and forbids id/mls_group_id. The reducer derives both identifiers. encryption_profile='none' is allowed only when the parent Realm content-encryption floor permits plaintext."
        }
      },
      "additionalProperties": false
    },
    "circle_list": {
      "type": "object",
      "required": [
        "realm_id",
        "circles"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "circles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/circle_view"
          }
        }
      },
      "additionalProperties": false
    },
    "circle_member_request_body": {
      "type": "object",
      "description": "Carries the caller-signed ak.circle.member.state Event and nothing else. The target actor and the membership value live in member_event.event.payload; the Circle is payload.circle_id and MUST equal the path circle_id. The service MUST NOT add a capability verdict to the payload it submits: circle_member_state_payload is closed, and the ak.circle.member.manage decision is the admission path's, evaluated against projected grants rather than asserted by the request.",
      "required": [
        "member_event"
      ],
      "properties": {
        "member_event": {
          "allOf": [
            {
              "$ref": "./service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
            },
            {
              "properties": {
                "event": {
                  "properties": {
                    "kind": {
                      "const": "ak.circle.member.state"
                    }
                  },
                  "required": [
                    "kind",
                    "realm_id"
                  ]
                }
              },
              "required": [
                "event"
              ]
            }
          ],
          "description": "Closed ak.circle.member.state Event authored and signed by the authenticated caller. The service MUST submit these exact bytes through ordinary Event admission and MUST NOT co-sign, rebuild or synthesize the Event. Admission MUST verify that event.actor_id is the authenticated caller and that payload.circle_id names the path Circle. Moving another actor to join requires ak.circle.member.manage narrowed by allowed_circle_ids, and the target MUST already be a joined parent-Realm member; knock requires join_rule=knock. A self-service join is gated on the Circle join_rule instead."
        }
      },
      "additionalProperties": false
    },
    "circle_member_delete_request_body": {
      "type": "object",
      "description": "Carries the caller-signed ak.circle.member.state leave Event and nothing else. The path circle_id and actor_id MUST respectively equal member_event.event.payload.circle_id and payload.member_id; member_event.event.realm_id MUST equal the path Circle's parent Realm. The path name actor_id is a route selector only; the canonical Event payload identity field is member_id. The service submits the exact signed Event through ordinary Event admission and MUST NOT rebuild it or synthesize a leave Event.",
      "required": [
        "member_event"
      ],
      "properties": {
        "member_event": {
          "allOf": [
            {
              "$ref": "./service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
            },
            {
              "properties": {
                "event": {
                  "properties": {
                    "kind": {
                      "const": "ak.circle.member.state"
                    },
                    "payload": {
                      "properties": {
                        "membership": {
                          "const": "leave"
                        },
                        "expected_membership": {
                          "$ref": "./event-payload.schema.json#/$defs/membership_state"
                        }
                      },
                      "required": [
                        "circle_id",
                        "member_id",
                        "membership",
                        "expected_membership"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "realm_id",
                    "payload"
                  ]
                }
              },
              "required": [
                "event"
              ]
            }
          ],
          "description": "Closed ak.circle.member.state Event authored and signed by the authenticated caller, with membership fixed to leave and expected_membership carrying the concrete current membership as the signed head_eq guard. Admission MUST bind the Event proof to the exact account-local lineage selected by the authenticated session; matching only the caller DID is insufficient. Removing another actor requires ak.circle.member.manage narrowed to the path Circle; self-service leave uses ak.circle.member.add."
        }
      },
      "additionalProperties": false
    },
    "circle_membership_outcome": {
      "type": "object",
      "required": [
        "circle_id",
        "member_id",
        "membership"
      ],
      "properties": {
        "circle_id": {
          "$ref": "./common-ids.schema.json#/$defs/circle_id"
        },
        "member_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "membership": {
          "$ref": "./event-payload.schema.json#/$defs/membership_state"
        }
      },
      "additionalProperties": false
    },
    "circle_scope_rotate_outcome": {
      "type": "object",
      "required": [
        "circle_id"
      ],
      "properties": {
        "circle_id": {
          "$ref": "./common-ids.schema.json#/$defs/circle_id"
        },
        "mls_group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "note": {
          "type": "string",
          "description": "Reducer-emitted reason code on Ignored / Rejected, or unsupported-feature note while MLS scope rotation is not wired end-to-end."
        }
      },
      "additionalProperties": false
    }
  }
}
