{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/encrypted-envelope.schema.json",
  "title": "Cokret Encrypted Payload Envelope",
  "type": "object",
  "required": [
    "scheme",
    "version",
    "group_id",
    "epoch",
    "content_type",
    "ciphertext",
    "aad_visibility_event_id",
    "aad",
    "key_ref",
    "aad_digest",
    "payload_digest"
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "cleartext_commitment"
        ]
      },
      {
        "required": [
          "authentication_tag"
        ]
      }
    ]
  },
  "properties": {
    "scheme": {
      "const": "mls-rfc9420"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "content_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "aad_visibility_event_id": {
      "type": "string",
      "enum": [
        "hidden",
        "routing_digest",
        "opaque_id"
      ],
      "description": "Normative discriminator for event id visibility in aad. hidden forbids aad.event_id and aad.event_ref_digest; routing_digest requires aad.event_ref_digest and forbids aad.event_id; opaque_id requires aad.event_id and forbids aad.event_ref_digest."
    },
    "aad": {
      "type": "object",
      "required": [
        "realm_id",
        "event_kind"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "event_kind": {
          "type": "string",
          "pattern": "^ck\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "event_ref_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "causal_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "causal_ref_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "event_id",
              "event_ref_digest"
            ]
          },
          {
            "required": [
              "causal_refs",
              "causal_ref_digests"
            ]
          }
        ]
      },
      "additionalProperties": false
    },
    "key_ref": {
      "type": "object",
      "required": [
        "algorithm",
        "group_state_ref"
      ],
      "properties": {
        "algorithm": {
          "const": "MLS"
        },
        "group_state_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "Reference to accepted ck.mls.genesis / winning ck.mls.commit event."
            },
            {
              "type": "string",
              "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$",
              "description": "Equivalent group state proof hash."
            }
          ],
          "description": "v1 MLS group state lookup hint. MUST point to accepted ck.mls.genesis / winning ck.mls.commit / equivalent group state proof. Does NOT replace MLS transcript verification. See encryption-and-audit.md §4. Ratchet tree material MUST NOT be carried in the per-message envelope; group state changes flow through ck.mls.genesis / Welcome / Commit events."
        }
      },
      "additionalProperties": false,
      "description": "MLS group binding hints. Closed object: privacy-sensitive AAD must not be smuggled through here. Forbidden in v1: ratchet_tree, leaf_node, group_info (these MUST NOT be replicated per-message)."
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "aad_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "aad_visibility_event_id": {
            "const": "hidden"
          }
        },
        "required": [
          "aad_visibility_event_id"
        ]
      },
      "then": {
        "properties": {
          "aad": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "event_id"
                  ]
                },
                {
                  "required": [
                    "event_ref_digest"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aad_visibility_event_id": {
            "const": "routing_digest"
          }
        },
        "required": [
          "aad_visibility_event_id"
        ]
      },
      "then": {
        "properties": {
          "aad": {
            "required": [
              "event_ref_digest"
            ],
            "not": {
              "required": [
                "event_id"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aad_visibility_event_id": {
            "const": "opaque_id"
          }
        },
        "required": [
          "aad_visibility_event_id"
        ]
      },
      "then": {
        "properties": {
          "aad": {
            "required": [
              "event_id"
            ],
            "not": {
              "required": [
                "event_ref_digest"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
