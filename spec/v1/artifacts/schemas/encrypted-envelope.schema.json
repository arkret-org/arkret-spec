{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/encrypted-envelope.schema.json",
  "title": "Contrix Encrypted Payload Envelope",
  "type": "object",
  "required": [
    "scheme",
    "version",
    "group_id",
    "epoch",
    "content_type",
    "ciphertext",
    "aad",
    "aad_digest",
    "payload_digest"
  ],
  "properties": {
    "scheme": {
      "const": "mls-rfc9420"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "content_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "authentication_tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "aad": {
      "type": "object",
      "required": [
        "space_id",
        "event_kind"
      ],
      "properties": {
        "space_id": {
          "type": "string",
          "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
        },
        "event_kind": {
          "type": "string",
          "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
        },
        "event_ref_hash": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "causal_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
          }
        },
        "causal_ref_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
          }
        }
      },
      "not": {
        "required": [
          "event_id",
          "event_ref_hash"
        ]
      },
      "additionalProperties": true
    },
    "key_ref": {
      "type": "object",
      "required": [
        "algorithm"
      ],
      "properties": {
        "algorithm": {
          "const": "MLS"
        },
        "group_state_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$",
              "description": "Reference to accepted cx.mls.genesis / winning cx.mls.commit event."
            },
            {
              "type": "string",
              "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$",
              "description": "Equivalent group state proof hash."
            }
          ],
          "description": "v1 MLS group state lookup hint. MUST point to accepted cx.mls.genesis / winning cx.mls.commit / equivalent group state proof. Does NOT replace MLS transcript verification. See encryption-and-audit.md §4. Ratchet tree material MUST NOT be carried in the per-message envelope; group state changes flow through cx.mls.genesis / Welcome / Commit events."
        }
      },
      "additionalProperties": false,
      "description": "MLS group binding hints. Closed object: privacy-sensitive AAD must not be smuggled through here. Forbidden in v1: ratchet_tree, leaf_node, group_info (these MUST NOT be replicated per-message)."
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "aad_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "cleartext_commitment": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$",
      "description": "Reserved (v1: optional, default absent). When present, MUST be sha256 over canonical cleartext bytes derived under the scheme's Cleartext Commitment Profile (`scheme=mls-rfc9420` defines the canonicalization in encryption-and-audit.md §4). Lets recipients detect ciphertext malleability where the producer commits to a specific plaintext without revealing it. v1 implementations MAY ignore this field; v2 MAY make it required for new schemes."
    }
  },
  "additionalProperties": true
}
