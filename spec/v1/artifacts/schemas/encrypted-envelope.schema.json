{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/encrypted-envelope.schema.json",
  "title": "Arkret Encrypted Payload Envelope",
  "description": "Closed recoverable application ciphertext. encryption_scheme selects the registered construction, content_type selects decrypted business content. No implicit standard-MLS or plaintext fallback.",
  "type": "object",
  "required": [
    "version",
    "content_type",
    "encryption_scheme",
    "encryption_context",
    "ciphertext"
  ],
  "properties": {
    "version": {
      "const": "1.0",
      "x-arkret-value-ownership": {
        "class": "version_text",
        "authority": "encrypted-envelope.schema.json#/properties/version",
        "owner": "encrypted-envelope.schema.json#/properties/version",
        "values": [
          "1.0"
        ]
      }
    },
    "content_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "encryption_scheme": {
      "$ref": "./content-encryption.schema.json#/$defs/encryption_scheme"
    },
    "encryption_context": {
      "$ref": "#/$defs/encryption_context"
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "routing_context": {
      "type": "object",
      "required": [
        "target_ref",
        "routing_tag"
      ],
      "properties": {
        "target_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "routing_tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false,
      "description": "Present only for a registered reaction outer Event kind. The reaction kind and routing_window=floor(unix_ms(outer.created_at)/3600000) are derived inputs to AAD/KDF and never wire fields. All non-reaction kinds forbid routing_context."
    },
    "epoch_content_encryption_context": {
      "type": "object",
      "required": [
        "epoch",
        "group_state_ref",
        "content_key_salt",
        "root_ref",
        "key_commitment",
        "protection"
      ],
      "properties": {
        "epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "group_state_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "routing_context": {
          "$ref": "#/$defs/routing_context"
        },
        "content_key_salt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "root_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "key_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "protection": {
          "$ref": "./content-encryption.schema.json#/$defs/protection"
        }
      },
      "additionalProperties": false,
      "description": "Recoverable epoch-content context, not RFC 9420 PrivateMessage. Immutable scope, endpoint, strategy and algorithm are reconstructed from original signed Event and accepted historical state."
    },
    "encryption_context": {
      "$ref": "#/$defs/epoch_content_encryption_context",
      "description": "Recoverable epoch-content context, not RFC 9420 PrivateMessage. Immutable scope, endpoint, strategy and algorithm are reconstructed from original signed Event and accepted historical state."
    }
  }
}
