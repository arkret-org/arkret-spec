{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/invite.schema.json",
  "title": "Arkret Invite",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "inviter_account_id",
    "state",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:invite:[A-Za-z0-9_-]{44}$"
    },
    "schema": {
      "const": "ak.schema.invite.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "inviter_account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "invitee_account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "introduction_evidence_digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest of private invite delivery introduction_evidence. Raw locator tokens and receive-policy state MUST NOT appear in durable Realm events."
    },
    "third_party_invite": {
      "$ref": "#/$defs/third_party_invite"
    },
    "capability_grant_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ak:grant:[A-Za-z0-9_-]{44}$"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "revoked",
        "expired",
        "claimed",
        "send_failed",
        "revoked_by_capability_loss",
        "revoked_by_inviter_left",
        "invalidated_by_rate_limit"
      ]
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id",
      "description": "Reducer-derived actor that produced the most recent invite state update."
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "invitee_account_id"
        ],
        "not": {
          "required": [
            "third_party_invite"
          ]
        }
      },
      "then": {
        "required": [
          "introduction_evidence_digest"
        ]
      }
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "third_party_invite": {
      "type": "object",
      "description": "Wire-level 3PID/OOB invite binding. No plaintext email/phone/SMS code is allowed here. `oob_code_kind` distinguishes offline high-entropy token validation from server-side lookup short-code validation.",
      "required": [
        "oob_code_kind",
        "verification_id",
        "verification_public_key"
      ],
      "properties": {
        "display_name_hint": {
          "type": "string",
          "maxLength": 128,
          "description": "Non-identifying UI hint only; MUST NOT contain plaintext 3PID."
        },
        "token_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Salted commitment to a high-entropy invite token. Required for offline_token mode."
        },
        "token_salt_id": {
          "type": "string",
          "pattern": "^(?!ak:)",
          "minLength": 1,
          "maxLength": 128,
          "description": "Opaque handle for the verification service's private salt record. The salt value itself MUST NOT appear on wire."
        },
        "lookup_table_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Opaque verification-service lookup table reference for short-code mode. The raw short code MUST NOT appear on wire."
        },
        "pepper_id": {
          "type": "string",
          "pattern": "^(?!ak:)",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-private pepper generation identifier for lookup mode; the pepper value itself is never on wire."
        },
        "oob_code_kind": {
          "type": "string",
          "enum": [
            "offline_token",
            "lookup"
          ],
          "description": "offline_token means the out-of-band code is itself >=128-bit entropy and validated against token_commitment. lookup means the human-readable code is only an index into a server-private lookup table protected by rate limits and pepper/HMAC storage."
        },
        "token_entropy_bits": {
          "type": "integer",
          "minimum": 128,
          "description": "Required for offline_token mode. Entropy estimate excluding separators."
        },
        "verification_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "verification_public_key": {
          "type": "string",
          "minLength": 1,
          "description": "Ephemeral public key or DID verification method used by the verification service to sign claim results."
        },
        "max_claims": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "default": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "oob_code_kind": {
                "const": "offline_token"
              }
            },
            "required": [
              "oob_code_kind"
            ]
          },
          "then": {
            "required": [
              "token_commitment",
              "token_salt_id",
              "token_entropy_bits"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "oob_code_kind": {
                "const": "lookup"
              }
            },
            "required": [
              "oob_code_kind"
            ]
          },
          "then": {
            "required": [
              "lookup_table_ref",
              "pepper_id"
            ]
          }
        }
      ]
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
