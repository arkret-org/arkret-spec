{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/invite.schema.json",
  "title": "Arkret Invite",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "inviter_account_id",
    "invitee_account_id",
    "introduction_evidence_digest",
    "state",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:invite:[A-Za-z0-9_-]{44}$"
    },
    "schema": {
      "const": "ak.schema.invite.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "invite.schema.json#/properties/schema",
        "owner": "invite.schema.json#/properties/schema",
        "values": [
          "ak.schema.invite.v1"
        ]
      }
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "inviter_account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "invitee_account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "introduction_evidence_digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest of private invite delivery introduction_evidence. Raw locator tokens and receive-policy state MUST NOT appear in durable Realm events."
    },
    "capability_grant_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ak:grant:[A-Za-z0-9_-]{44}$"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "revoked",
        "expired"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "invite.schema.json#/properties/state",
        "owner": "invite.schema.json#/properties/state",
        "values": [
          "pending",
          "accepted",
          "rejected",
          "revoked",
          "expired"
        ]
      }
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id",
      "description": "Reducer-derived actor that produced the most recent invite state update."
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "invite_live_target_occupied_problem_extensions": {
      "type": "object",
      "description": "Closed top-level RFC 9457 extensions for failed_precondition with reason_code=invite_live_target_occupied. The occupying create_event_id determines invite_id by retype; no Event is accepted and no current write is produced.",
      "x-arkret-name-role": "problem_extensions",
      "required": [
        "reason_code",
        "invite_id",
        "create_event_id"
      ],
      "properties": {
        "reason_code": {
          "const": "invite_live_target_occupied",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "invite.schema.json#/$defs/invite_live_target_occupied_problem_extensions/properties/reason_code",
            "owner": "invite.schema.json#/$defs/invite_live_target_occupied_problem_extensions/properties/reason_code",
            "values": [
              "invite_live_target_occupied"
            ]
          }
        },
        "invite_id": {
          "$ref": "#/properties/id"
        },
        "create_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
