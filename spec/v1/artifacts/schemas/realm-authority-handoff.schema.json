{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-authority-handoff.schema.json",
  "title": "Arkret Realm Authority Handoff",
  "x-arkret-signature-domains": [
    "ak.realm_authority_handoff_old_signature.v1",
    "ak.realm_authority_handoff_new_acceptance_signature.v1"
  ],
  "description": "Closed planned transfer from one Realm authority generation to its unique successor. Both service signatures and the controller-authored change Event are required; this is not a quorum vote.",
  "type": "object",
  "required": [
    "handoff_id",
    "realm_id",
    "from_generation",
    "to_generation",
    "from_service_id",
    "to_service_id",
    "final_stream_heads_digest",
    "snapshot_ref",
    "change_event_ref",
    "change_commit_id",
    "old_authority_signature",
    "new_authority_acceptance_signature"
  ],
  "properties": {
    "handoff_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_authority_handoff_id"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "from_generation": {
      "type": "integer",
      "minimum": 0
    },
    "to_generation": {
      "type": "integer",
      "minimum": 1
    },
    "from_service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "to_service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "final_stream_heads_digest": {
      "$ref": "./event-envelope.schema.json#/$defs/digest"
    },
    "historical_signer_facts_digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest",
      "description": "New handoffs require SHA256(JCS complete sorted {target,producer_signer_fact} inventory); existing_original-only schema absence cannot transfer new digest-bearing history. Both original handoff contexts sign it."
    },
    "snapshot_ref": {
      "$ref": "./common-ids.schema.json#/$defs/realm_snapshot_id"
    },
    "change_event_ref": {
      "$ref": "./common-ids.schema.json#/$defs/event_id"
    },
    "change_commit_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_commit_id",
      "description": "The Realm-stream commit for change_event_ref; it is not a cross-stream final commit."
    },
    "old_authority_signature": {
      "$ref": "./detached-object-signature.schema.json#/$defs/realm_authority_handoff_old_signature"
    },
    "new_authority_acceptance_signature": {
      "$ref": "./detached-object-signature.schema.json#/$defs/realm_authority_handoff_new_acceptance_signature"
    }
  },
  "additionalProperties": false
}
