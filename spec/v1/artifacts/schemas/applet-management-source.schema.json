{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-management-source.schema.json",
  "title": "Arkret Applet Operation-bound Management Source",
  "oneOf": [
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/scope_request"
    },
    {
      "$ref": "#/$defs/scope_confirmation"
    },
    {
      "$ref": "#/$defs/source_request"
    }
  ],
  "$defs": {
    "signature": {
      "type": "object",
      "required": [
        "verification_method",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "operation_binding": {
      "type": "object",
      "required": [
        "purpose",
        "operation_id",
        "request_digest",
        "requester_actor_id",
        "governance_station_id",
        "governance_generation",
        "effective_scope",
        "subject_account_id",
        "nonce"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "managed_subject",
            "management_review"
          ]
        },
        "operation_id": {
          "enum": [
            "ak.self.events.command.submit.v1",
            "ak.self.management_review.command.request.v1"
          ]
        },
        "request_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "requester_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "properties": {
            "kind": {
              "const": "service"
            }
          }
        },
        "governance_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "governance_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "subject_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "managed_subject"
              }
            }
          },
          "then": {
            "properties": {
              "operation_id": {
                "const": "ak.self.events.command.submit.v1"
              }
            }
          },
          "else": {
            "properties": {
              "operation_id": {
                "const": "ak.self.management_review.command.request.v1"
              }
            }
          }
        }
      ]
    },
    "managed_device_projection": {
      "type": "object",
      "description": "Exact same-cut managed Account Device projection for the operation-bound review source only. Covered by the enclosing source proof; not the Human directory attestation or a new Device authentication scheme.",
      "required": [
        "account_id",
        "device_id",
        "device_signing_key_did",
        "hpke_key",
        "device_authorize_event_id",
        "authorized_generation_ref",
        "device_status",
        "attested_at",
        "expires_at",
        "authorization_window"
      ],
      "properties": {
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id",
          "description": "Exact account owning the device projection. The proof controller MUST project exactly onto account_id.station_id; an attestation that verifies under any other Station key is not evidence about this account."
        },
        "device_id": {
          "$ref": "./keys-operations.schema.json#/$defs/device_id"
        },
        "device_signing_key_did": {
          "$ref": "./keys-operations.schema.json#/$defs/did_key"
        },
        "hpke_key": {
          "$ref": "./keys-operations.schema.json#/$defs/non_empty_string"
        },
        "device_authorize_event_id": {
          "$ref": "./keys-operations.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "authorized_generation_ref": {
          "$ref": "./recovery-session.schema.json#/$defs/pcr_generation_ref"
        },
        "device_status": {
          "const": "active",
          "description": "This surface attests usable devices only. A revoked or fenced device is omitted from device_keys or reported through the non-enumerating failures shape, so the attested status is constant rather than a disclosure channel."
        },
        "attested_at": {
          "$ref": "./keys-operations.schema.json#/$defs/timestamp",
          "description": "Same source cut as the enclosing evaluated_at."
        },
        "expires_at": {
          "$ref": "./keys-operations.schema.json#/$defs/timestamp",
          "description": "Bounded by enclosing source expiry and original authorization window."
        },
        "authorization_window": {
          "type": "object",
          "required": [
            "not_before",
            "expires_at"
          ],
          "properties": {
            "not_before": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "expires_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            }
          },
          "additionalProperties": false,
          "description": "Exact finite original managed Device window, independent of this source proof freshness."
        }
      },
      "additionalProperties": false
    },
    "managed_device_authorization": {
      "type": "object",
      "description": "Exact immutable original Device authorization coordinates; the enclosing operation binding replaces the business-forward request binding, not the original authorization proof.",
      "required": [
        "verification_method",
        "authorization_ref",
        "revision",
        "governance_generation",
        "accepted_at"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "authorization_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "revision": {
          "$ref": "./typed-current-result.schema.json#/$defs/revision"
        },
        "governance_generation": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "managed_device_source": {
      "type": "object",
      "required": [
        "projection",
        "authorization"
      ],
      "properties": {
        "projection": {
          "$ref": "#/$defs/managed_device_projection"
        },
        "authorization": {
          "$ref": "#/$defs/managed_device_authorization"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "binding",
        "creation",
        "service_resolution",
        "station_resolution",
        "current",
        "authority_bundles",
        "evaluated_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/operation_binding"
        },
        "creation": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/managed_creation_originals"
        },
        "service_resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/authenticated_service_resolution",
          "properties": {
            "service_kind": {
              "const": "applet_service"
            }
          }
        },
        "station_resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/authenticated_service_resolution",
          "properties": {
            "service_kind": {
              "const": "station"
            }
          }
        },
        "current": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/managed_identity_current"
        },
        "authority_bundles": {
          "type": "array",
          "items": {
            "$ref": "./realm-authority-bundle.schema.json"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "device_source": {
          "$ref": "#/$defs/managed_device_source"
        },
        "evaluated_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "binding": {
                "properties": {
                  "purpose": {
                    "const": "management_review"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "device_source"
            ]
          },
          "else": {
            "not": {
              "required": [
                "device_source"
              ]
            }
          }
        }
      ],
      "x-arkret-max-canonical-bytes": 2097152,
      "x-arkret-signature-domain": "ak.applet.management_source.v1"
    },
    "scope_request": {
      "type": "object",
      "required": [
        "source_station_id",
        "subject_account_id",
        "device_id",
        "control_event",
        "nonce"
      ],
      "properties": {
        "source_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "subject_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "control_event": {
          "$ref": "./event-envelope.schema.json"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        }
      },
      "additionalProperties": false
    },
    "scope_confirmation": {
      "type": "object",
      "required": [
        "applet_id",
        "service_id",
        "source_station_id",
        "subject_account_id",
        "device_id",
        "governance_station_id",
        "governance_generation",
        "effective_scope",
        "registration_ref",
        "registration_epoch",
        "grant_ids",
        "request_digest",
        "nonce",
        "evaluated_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "source_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "subject_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "governance_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "governance_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "registration_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "registration_epoch": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "grant_ids": {
          "type": "array",
          "items": {
            "$ref": "./agent-operations.schema.json#/$defs/grant_id"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "request_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        "evaluated_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "x-arkret-signature-domain": "ak.applet.device_scope_confirmation.v1",
      "x-arkret-max-canonical-bytes": 16384
    },
    "source_request": {
      "type": "object",
      "required": [
        "binding",
        "operation_request"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/operation_binding"
        },
        "operation_request": {
          "oneOf": [
            {
              "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
            },
            {
              "$ref": "./management-review-operations.schema.json#/$defs/request"
            }
          ],
          "allOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "subject_managed_source"
                    ]
                  },
                  {
                    "required": [
                      "managed_source"
                    ]
                  },
                  {
                    "required": [
                      "device_scope_confirmations"
                    ]
                  },
                  {
                    "required": [
                      "approval_signatures"
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "binding": {
                "properties": {
                  "purpose": {
                    "const": "managed_subject"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "operation_request": {
                "required": [
                  "event"
                ],
                "properties": {
                  "event": {
                    "properties": {
                      "kind": {
                        "const": "ak.capability.grant"
                      },
                      "actor_id": {
                        "$ref": "./common-ids.schema.json#/$defs/actor_id",
                        "properties": {
                          "kind": {
                            "const": "service"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "operation_request": {
                "required": [
                  "management_operation",
                  "target"
                ],
                "properties": {
                  "management_operation": {
                    "enum": [
                      "join",
                      "publish"
                    ]
                  },
                  "target": {
                    "properties": {
                      "kind": {
                        "const": "event"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
