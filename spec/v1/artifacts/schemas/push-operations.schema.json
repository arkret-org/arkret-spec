{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/push-operations.schema.json",
  "title": "Cokret Push Gateway Operation DTOs",
  "description": "Closed request and response DTOs for ck.edge.push.command.register_device, ck.edge.push.command.unregister_device, and ck.push.notify.",
  "anyOf": [
    {
      "$ref": "#/$defs/push_register_device_request_body"
    },
    {
      "$ref": "#/$defs/push_register_device_outcome"
    },
    {
      "$ref": "#/$defs/push_unregister_device_request_body"
    },
    {
      "$ref": "#/$defs/push_unregister_device_outcome"
    },
    {
      "$ref": "#/$defs/push_notify_request_body"
    },
    {
      "$ref": "#/$defs/push_notify_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "push_target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{16,256}$",
      "description": "Pairwise pseudonym for one (recipient_service_did, principal, device, push_route) tuple. It MUST NOT be a DID, DID URL, Realm id, Flow id, Message id, Event id, or stable cross-Realm correlation key."
    },
    "registration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Push gateway local registration id. It is not a registered ck:<kind> protocol object id."
    },
    "push_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "counts": {
      "type": "object",
      "properties": {
        "badge": {
          "description": "Coarse unread indicator. Under blind_wakeup it MUST NOT carry a plaintext absolute unread count (activity side channel); only a boolean presence flag or a policy-declared bucket string is allowed. See push-notifications.md §5.1.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "1",
                "2-5",
                "6+"
              ]
            }
          ]
        },
        "unread_increment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "missed_call": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      },
      "additionalProperties": false
    },
    "device_route": {
      "type": "object",
      "required": [
        "device_id"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "push_key": {
          "$ref": "#/$defs/push_key"
        },
        "app_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "platform": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "blind_notification": {
      "type": "object",
      "required": [
        "push_target_id",
        "wakeup_kind",
        "devices"
      ],
      "properties": {
        "push_target_id": {
          "$ref": "#/$defs/push_target_id"
        },
        "wakeup_kind": {
          "type": "string",
          "enum": [
            "message",
            "mention",
            "reaction",
            "call_invite"
          ]
        },
        "push_hint": {
          "type": "string",
          "enum": [
            "new_message",
            "incoming_call",
            "mention_self",
            "l10n_key"
          ],
          "description": "Sanitized hint sentinel. When the value is \"l10n_key\" the actual localization key MUST be carried in push_hint_l10n_key (this enum value is a form selector, not a literal display token). See push-notifications.md §5.1 / §4.5."
        },
        "push_hint_l10n_key": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Localization key value, only present (and required) when push_hint == \"l10n_key\". MUST be an l10n key token, never plaintext body or any identifying metadata."
        },
        "evaluation_locus_unresolved": {
          "type": "boolean",
          "description": "Set true when the client has been woken but server-side rule matching is not yet resolved (E2EE client-side rule fallback). Pure local-evaluation signal; carries no metadata. See push-notifications.md §4.5."
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/device_route"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "event_id"
            ]
          },
          {
            "required": [
              "realm_id"
            ]
          },
          {
            "required": [
              "sender_actor_id"
            ]
          },
          {
            "required": [
              "sender_actor_display_name"
            ]
          },
          {
            "required": [
              "realm_title"
            ]
          },
          {
            "required": [
              "flow_title"
            ]
          }
        ]
      },
      "additionalProperties": false
    },
    "visible_notification": {
      "type": "object",
      "required": [
        "push_target_id",
        "wakeup_kind",
        "devices",
        "event_id",
        "realm_id",
        "sender_actor_id"
      ],
      "properties": {
        "push_target_id": {
          "$ref": "#/$defs/push_target_id"
        },
        "wakeup_kind": {
          "type": "string",
          "enum": [
            "message",
            "mention",
            "reaction",
            "call_invite"
          ]
        },
        "push_hint": {
          "type": "string",
          "enum": [
            "new_message",
            "incoming_call",
            "mention_self",
            "l10n_key"
          ],
          "description": "Sanitized hint sentinel. When the value is \"l10n_key\" the actual localization key MUST be carried in push_hint_l10n_key (this enum value is a form selector, not a literal display token). See push-notifications.md §5.1 / §4.5."
        },
        "push_hint_l10n_key": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Localization key value, only present (and required) when push_hint == \"l10n_key\"."
        },
        "evaluation_locus_unresolved": {
          "type": "boolean",
          "description": "Set true when the client has been woken but server-side rule matching is not yet resolved. See push-notifications.md §4.5."
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/device_route"
          }
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "sender_actor_id": {
          "$ref": "#/$defs/did"
        }
      },
      "additionalProperties": false
    },
    "notify_rejection": {
      "type": "object",
      "required": [
        "push_target_id",
        "reason_code"
      ],
      "properties": {
        "push_target_id": {
          "$ref": "#/$defs/push_target_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "push_register_device_request_body": {
      "type": "object",
      "required": [
        "device_id",
        "push_gateway",
        "push_key"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "push_gateway": {
          "$ref": "#/$defs/url"
        },
        "push_key": {
          "$ref": "#/$defs/push_key"
        },
        "platform": {
          "$ref": "#/$defs/non_empty_string"
        },
        "app_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recipient_service_did": {
          "$ref": "#/$defs/did"
        }
      },
      "additionalProperties": false
    },
    "push_register_device_outcome": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "registration_id": {
          "$ref": "#/$defs/registration_id"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "push_unregister_device_request_body": {
      "type": "object",
      "required": [
        "device_id"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "push_key": {
          "$ref": "#/$defs/push_key"
        },
        "app_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "push_unregister_device_outcome": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "push_notify_request_body": {
      "type": "object",
      "required": [
        "notification"
      ],
      "properties": {
        "notification": {
          "oneOf": [
            {
              "$ref": "#/$defs/blind_notification"
            },
            {
              "$ref": "#/$defs/visible_notification"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "push_notify_outcome": {
      "type": "object",
      "required": [
        "rejected"
      ],
      "properties": {
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notify_rejection"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
