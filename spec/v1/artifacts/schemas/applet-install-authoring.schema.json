{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-install-authoring.schema.json",
  "title": "Arkret Applet Managed-Actor Authoring DTOs",
  "description": "The single closed Station preview to Applet authoring carrier for install_bot and provision_ghost. No install-only operation, branch-specific bundle aliases, or derived request identifier exists.",
  "oneOf": [
    {
      "$ref": "#/$defs/install_authoring_request_basis"
    },
    {
      "$ref": "#/$defs/ghost_authoring_request_basis"
    },
    {
      "$ref": "#/$defs/authoring_request"
    },
    {
      "$ref": "#/$defs/install_preview_response_body"
    },
    {
      "$ref": "#/$defs/ghost_preview_request_body"
    },
    {
      "$ref": "#/$defs/ghost_preview_response_body"
    },
    {
      "$ref": "#/$defs/author_request_body"
    },
    {
      "$ref": "#/$defs/author_response_body"
    }
  ],
  "$defs": {
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "managed_actor_proof": {
      "type": "object",
      "description": "Closed Applet managed-actor request/bundle proof. audience_id is the exact recipient service DidCoreId: basis.service_id for the request and basis.target_station_id for the bundle. It is an identity binding, not a generic string or multi-audience selector.",
      "required": [
        "kind",
        "verification_method",
        "payload_digest",
        "created_at",
        "audience_id",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "detached_jws",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/managed_actor_proof/properties/kind",
            "owner": "applet-install-authoring.schema.json#/$defs/managed_actor_proof/properties/kind",
            "values": [
              "detached_jws"
            ]
          }
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "audience_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "registration_epoch_evidence": {
      "$ref": "./applet-registration-epoch-evidence.schema.json"
    },
    "registration_event": {
      "allOf": [
        {
          "$ref": "./event-envelope.schema.json"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "ak.applet.registration",
              "x-arkret-value-ownership": {
                "class": "namespaced_symbol",
                "authority": "applet-install-authoring.schema.json#/$defs/registration_event/allOf/1/properties/kind",
                "owner": "applet-install-authoring.schema.json#/$defs/registration_event/allOf/1/properties/kind",
                "values": [
                  "ak.applet.registration"
                ]
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "manifest"
              ],
              "properties": {
                "manifest": {
                  "type": "object",
                  "required": [
                    "registration_epoch_evidence"
                  ],
                  "properties": {
                    "registration_epoch_evidence": {
                      "$ref": "#/$defs/registration_epoch_evidence"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "capability_grant_event": {
      "allOf": [
        {
          "$ref": "./event-envelope.schema.json"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.capability.grant",
              "x-arkret-value-ownership": {
                "class": "namespaced_symbol",
                "authority": "applet-install-authoring.schema.json#/$defs/capability_grant_event/allOf/1/properties/kind",
                "owner": "applet-install-authoring.schema.json#/$defs/capability_grant_event/allOf/1/properties/kind",
                "values": [
                  "ak.capability.grant"
                ]
              }
            }
          }
        }
      ]
    },
    "approval_request": {
      "type": "object",
      "required": [
        "approve_actions",
        "ghost_actor_mode",
        "delegated_native_actors_allowed",
        "e2ee_join_allowed",
        "widget_allowed"
      ],
      "properties": {
        "approve_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ghost_actor_mode": {
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/approval_request/properties/ghost_actor_mode",
            "owner": "applet-install-authoring.schema.json#/$defs/approval_request/properties/ghost_actor_mode",
            "values": [
              "disallowed",
              "controller_approved",
              "policy_declared"
            ]
          }
        },
        "delegated_native_actors_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        },
        "e2ee_join_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        },
        "widget_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        }
      },
      "additionalProperties": false
    },
    "actor_policy": {
      "type": "object",
      "properties": {
        "ghost_actor_mode": {
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/actor_policy/properties/ghost_actor_mode",
            "owner": "applet-install-authoring.schema.json#/$defs/actor_policy/properties/ghost_actor_mode",
            "values": [
              "disallowed",
              "controller_approved",
              "policy_declared"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "e2ee_policy": {
      "type": "object",
      "properties": {
        "mls_join_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        }
      },
      "additionalProperties": false
    },
    "widget_policy": {
      "type": "object",
      "properties": {
        "widget_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        }
      },
      "additionalProperties": false
    },
    "install_authoring_request_basis": {
      "type": "object",
      "required": [
        "schema",
        "purpose",
        "target_station_id",
        "install_actor_id",
        "applet_id",
        "service_id",
        "package_digest",
        "effective_scope",
        "approval_request",
        "registration_event",
        "capability_grant_events"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_install_authoring_request_basis.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/install_authoring_request_basis/properties/schema",
            "owner": "applet-install-authoring.schema.json#/$defs/install_authoring_request_basis/properties/schema",
            "values": [
              "ak.schema.applet_install_authoring_request_basis.v1"
            ]
          }
        },
        "purpose": {
          "const": "install_applet",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/install_authoring_request_basis/properties/purpose",
            "owner": "applet-install-authoring.schema.json#/$defs/install_authoring_request_basis/properties/purpose",
            "values": [
              "install_applet"
            ]
          }
        },
        "target_station_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "install_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "approval_request": {
          "$ref": "#/$defs/approval_request"
        },
        "actor_policy": {
          "$ref": "#/$defs/actor_policy"
        },
        "e2ee_policy": {
          "$ref": "#/$defs/e2ee_policy"
        },
        "widget_policy": {
          "$ref": "#/$defs/widget_policy"
        },
        "registration_event": {
          "$ref": "#/$defs/registration_event"
        },
        "capability_grant_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability_grant_event"
          }
        }
      },
      "additionalProperties": false,
      "description": "Administrator-authored service installation intent. No Bot or Ghost is created by service installation."
    },
    "ghost_authoring_request_basis": {
      "type": "object",
      "required": [
        "schema",
        "purpose",
        "target_station_id",
        "applet_id",
        "service_id",
        "external_ref",
        "registration_event_ref",
        "authorization_ref",
        "registration_epoch_evidence",
        "package_digest",
        "effective_scope"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_ghost_authoring_request_basis.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/ghost_authoring_request_basis/properties/schema",
            "owner": "applet-install-authoring.schema.json#/$defs/ghost_authoring_request_basis/properties/schema",
            "values": [
              "ak.schema.applet_ghost_authoring_request_basis.v1"
            ]
          }
        },
        "purpose": {
          "const": "provision_ghost",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/ghost_authoring_request_basis/properties/purpose",
            "owner": "applet-install-authoring.schema.json#/$defs/ghost_authoring_request_basis/properties/purpose",
            "values": [
              "provision_ghost"
            ]
          }
        },
        "target_station_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "external_ref": {
          "$ref": "./realm-actor.schema.json#/$defs/ghost_external_tuple"
        },
        "display_name": {
          "$ref": "./string-profiles.schema.json#/$defs/display_text_256"
        },
        "registration_event_ref": {
          "$ref": "./account-operations.schema.json#/$defs/event_id"
        },
        "authorization_ref": {
          "$ref": "./agent-operations.schema.json#/$defs/grant_id"
        },
        "registration_epoch_evidence": {
          "$ref": "#/$defs/registration_epoch_evidence"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "existing_managed_actor": {
          "$ref": "./applet-ghost-operations.schema.json#/$defs/existing_managed_actor"
        }
      },
      "additionalProperties": false,
      "description": "Bounded creation intent at the owning Realm current governance Station. Runtime creates one independently controller-signed candidate and Service-signed Event; governance verifies the exact candidate and commits it via the standard Event submission. No Account/PCR aggregate."
    },
    "authoring_request": {
      "type": "object",
      "x-arkret-signature-domain": "ak.applet_managed_actor_authoring_request_proof.v1",
      "required": [
        "schema",
        "purpose",
        "basis",
        "governance_station_id",
        "issued_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_managed_actor_authoring_request.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/authoring_request/properties/schema",
            "owner": "applet-install-authoring.schema.json#/$defs/authoring_request/properties/schema",
            "values": [
              "ak.schema.applet_managed_actor_authoring_request.v1"
            ]
          }
        },
        "purpose": {
          "enum": [
            "provision_bot",
            "provision_ghost"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/authoring_request/properties/purpose",
            "owner": "applet-install-authoring.schema.json#/$defs/authoring_request/properties/purpose",
            "values": [
              "provision_bot",
              "provision_ghost"
            ]
          }
        },
        "basis": {
          "oneOf": [
            {
              "$ref": "#/$defs/bot_authoring_request_basis"
            },
            {
              "$ref": "#/$defs/ghost_authoring_request_basis"
            }
          ]
        },
        "governance_station_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Current governance Station service identity for the target Realm. The Station signs the resulting RealmCommit after revalidating the authoring request at the stream head."
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/managed_actor_proof"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "provision_bot",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "applet-install-authoring.schema.json#/$defs/authoring_request/allOf/0/if/properties/purpose",
                  "owner": "applet-install-authoring.schema.json#/$defs/authoring_request/allOf/0/if/properties/purpose",
                  "values": [
                    "provision_bot"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "$ref": "#/$defs/bot_authoring_request_basis"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "provision_ghost",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "applet-install-authoring.schema.json#/$defs/authoring_request/allOf/1/if/properties/purpose",
                  "owner": "applet-install-authoring.schema.json#/$defs/authoring_request/allOf/1/if/properties/purpose",
                  "values": [
                    "provision_ghost"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "$ref": "#/$defs/ghost_authoring_request_basis"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "install_preview_response_body": {
      "type": "object",
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "$ref": "./applet-install-plan.schema.json"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "ghost_preview_request_body": {
      "type": "object",
      "required": [
        "external_ref",
        "effective_scope"
      ],
      "properties": {
        "external_ref": {
          "$ref": "./realm-actor.schema.json#/$defs/ghost_external_tuple"
        },
        "display_name": {
          "$ref": "./string-profiles.schema.json#/$defs/display_text_256"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        }
      },
      "additionalProperties": false
    },
    "ghost_preview_response_body": {
      "type": "object",
      "required": [
        "authoring_request"
      ],
      "properties": {
        "authoring_request": {
          "$ref": "#/$defs/authoring_request"
        },
        "existing_managed_actor": {
          "$ref": "./applet-ghost-operations.schema.json#/$defs/existing_managed_actor"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "author_request_body": {
      "type": "object",
      "required": [
        "authoring_request"
      ],
      "properties": {
        "authoring_request": {
          "$ref": "#/$defs/authoring_request"
        }
      },
      "additionalProperties": false
    },
    "author_response_body": {
      "type": "object",
      "required": [
        "create_event"
      ],
      "properties": {
        "create_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "properties": {
                "kind": {
                  "const": "ak.realm.actor.create",
                  "x-arkret-value-ownership": {
                    "class": "namespaced_symbol",
                    "authority": "applet-install-authoring.schema.json#/$defs/author_response_body/properties/create_event/allOf/1/properties/kind",
                    "owner": "applet-install-authoring.schema.json#/$defs/author_response_body/properties/create_event/allOf/1/properties/kind",
                    "values": [
                      "ak.realm.actor.create"
                    ]
                  }
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "bot_authoring_request_basis": {
      "type": "object",
      "required": [
        "schema",
        "purpose",
        "target_station_id",
        "applet_id",
        "service_id",
        "registration_event_ref",
        "authorization_ref",
        "registration_epoch_evidence",
        "package_digest",
        "effective_scope",
        "request_id"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_bot_authoring_request_basis.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/bot_authoring_request_basis/properties/schema",
            "owner": "applet-install-authoring.schema.json#/$defs/bot_authoring_request_basis/properties/schema",
            "values": [
              "ak.schema.applet_bot_authoring_request_basis.v1"
            ]
          }
        },
        "purpose": {
          "const": "provision_bot",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-install-authoring.schema.json#/$defs/bot_authoring_request_basis/properties/purpose",
            "owner": "applet-install-authoring.schema.json#/$defs/bot_authoring_request_basis/properties/purpose",
            "values": [
              "provision_bot"
            ]
          }
        },
        "target_station_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "display_name": {
          "$ref": "./string-profiles.schema.json#/$defs/display_text_256"
        },
        "registration_event_ref": {
          "$ref": "./account-operations.schema.json#/$defs/event_id"
        },
        "authorization_ref": {
          "$ref": "./agent-operations.schema.json#/$defs/grant_id"
        },
        "registration_epoch_evidence": {
          "$ref": "#/$defs/registration_epoch_evidence"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        }
      },
      "additionalProperties": false,
      "description": "Bounded creation intent at the owning Realm current governance Station. Runtime creates one independently controller-signed candidate and Service-signed Event; governance verifies the exact candidate and commits it via the standard Event submission. No Account/PCR aggregate."
    }
  }
}
