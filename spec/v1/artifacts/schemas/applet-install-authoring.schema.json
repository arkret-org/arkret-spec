{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-install-authoring.schema.json",
  "title": "Arkret Applet Managed-Actor Authoring DTOs",
  "description": "The single closed Principal Server preview to Applet authoring carrier for install_bot and provision_ghost. No legacy install-only operation, branch-specific bundle aliases, or derived request identifier exists.",
  "oneOf": [
    {
      "$ref": "#/$defs/install_authoring_request_basis"
    },
    {
      "$ref": "#/$defs/ghost_authoring_request_basis"
    },
    {
      "$ref": "#/$defs/authoring_request"
    },
    {
      "$ref": "#/$defs/install_preview_outcome"
    },
    {
      "$ref": "#/$defs/ghost_preview_request_body"
    },
    {
      "$ref": "#/$defs/ghost_preview_outcome"
    },
    {
      "$ref": "#/$defs/author_request_body"
    },
    {
      "$ref": "#/$defs/managed_actor_bundle"
    },
    {
      "$ref": "#/$defs/author_outcome"
    }
  ],
  "$defs": {
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "ghost_external_tuple": {
      "type": "object",
      "required": ["protocol", "instance_id", "external_id"],
      "properties": {
        "protocol": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
        "instance_id": {
          "allOf": [
            { "$ref": "./account-operations.schema.json#/$defs/non_empty_string" },
            { "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor" }
          ]
        },
        "external_id": {
          "allOf": [
            { "$ref": "./account-operations.schema.json#/$defs/non_empty_string" },
            { "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor" }
          ]
        }
      },
      "additionalProperties": false
    },
    "registration_epoch_evidence": {
      "$ref": "./applet-registration-epoch-evidence.schema.json"
    },
    "registration_event": {
      "allOf": [
        {
          "$ref": "./event-envelope.schema.json"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "ak.applet.registration"
            },
            "payload": {
              "type": "object",
              "required": [
                "manifest"
              ],
              "properties": {
                "manifest": {
                  "type": "object",
                  "required": [
                    "registration_epoch_evidence"
                  ],
                  "properties": {
                    "registration_epoch_evidence": {
                      "$ref": "#/$defs/registration_epoch_evidence"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "capability_grant_event": {
      "allOf": [
        {
          "$ref": "./event-envelope.schema.json"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.capability.grant"
            }
          }
        }
      ]
    },
    "approval_request": {
      "type": "object",
      "required": [
        "approve_actions",
        "ghost_actor_mode",
        "delegated_native_actors_allowed",
        "e2ee_join_allowed",
        "widget_allowed"
      ],
      "properties": {
        "approve_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ghost_actor_mode": {
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ]
        },
        "delegated_native_actors_allowed": {
          "type": "boolean"
        },
        "e2ee_join_allowed": {
          "type": "boolean"
        },
        "widget_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "actor_policy": {
      "type": "object",
      "properties": {
        "ghost_actor_mode": {
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ]
        }
      },
      "additionalProperties": false
    },
    "e2ee_policy": {
      "type": "object",
      "properties": {
        "mls_join_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "widget_policy": {
      "type": "object",
      "properties": {
        "widget_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "install_authoring_request_basis": {
      "type": "object",
      "required": [
        "schema",
        "purpose",
        "target_principal_server_id",
        "install_actor_id",
        "applet_id",
        "service_id",
        "package_digest",
        "effective_scope",
        "approval_request",
        "registration_event",
        "capability_grant_events"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_install_authoring_request_basis.v1"
        },
        "purpose": {
          "const": "install_bot"
        },
        "target_principal_server_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "install_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "approval_request": {
          "$ref": "#/$defs/approval_request"
        },
        "actor_policy": {
          "$ref": "#/$defs/actor_policy"
        },
        "e2ee_policy": {
          "$ref": "#/$defs/e2ee_policy"
        },
        "widget_policy": {
          "$ref": "#/$defs/widget_policy"
        },
        "registration_event": {
          "$ref": "#/$defs/registration_event"
        },
        "capability_grant_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability_grant_event"
          }
        }
      },
      "additionalProperties": false
    },
    "ghost_authoring_request_basis": {
      "type": "object",
      "required": [
        "schema",
        "purpose",
        "target_principal_server_id",
        "applet_id",
        "service_id",
        "realm_id",
        "external_ref",
        "registration_event_ref",
        "authorization_ref",
        "registration_epoch_evidence",
        "package_digest"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_ghost_authoring_request_basis.v1"
        },
        "purpose": {
          "const": "provision_ghost"
        },
        "target_principal_server_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "external_ref": {
          "$ref": "#/$defs/ghost_external_tuple"
        },
        "display_name": {
          "$ref": "./string-profiles.schema.json#/$defs/display_text_256"
        },
        "registration_event_ref": {
          "$ref": "./account-operations.schema.json#/$defs/event_id"
        },
        "authorization_ref": {
          "$ref": "./agent-operations.schema.json#/$defs/grant_id"
        },
        "registration_epoch_evidence": {
          "$ref": "#/$defs/registration_epoch_evidence"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "authoring_request": {
      "type": "object",
      "x-arkret-proof-context": "ak.applet_managed_actor_authoring_request_proof.v1",
      "required": ["schema", "purpose", "basis", "hosting_notary", "issued_at", "expires_at", "proof"],
      "properties": {
        "schema": { "const": "ak.schema.applet_managed_actor_authoring_request.v1" },
        "purpose": { "enum": ["install_bot", "provision_ghost"] },
        "basis": {
          "oneOf": [
            { "$ref": "#/$defs/install_authoring_request_basis" },
            { "$ref": "#/$defs/ghost_authoring_request_basis" }
          ]
        },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "hosting_notary": { "$ref": "./realm.schema.json#/$defs/notary_signer_descriptor" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "proof": { "$ref": "./event-envelope.schema.json#/$defs/proof" }
      },
      "allOf": [
        {
          "if": { "required": ["purpose"], "properties": { "purpose": { "const": "install_bot" } } },
          "then": {
            "required": ["plan_digest"],
            "properties": { "basis": { "$ref": "#/$defs/install_authoring_request_basis" } }
          }
        },
        {
          "if": { "required": ["purpose"], "properties": { "purpose": { "const": "provision_ghost" } } },
          "then": {
            "properties": { "basis": { "$ref": "#/$defs/ghost_authoring_request_basis" } },
            "not": { "required": ["plan_digest"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "install_preview_outcome": {
      "type": "object",
      "required": [
        "plan",
        "authoring_request"
      ],
      "properties": {
        "plan": {
          "$ref": "./applet-install-plan.schema.json"
        },
        "authoring_request": {
          "$ref": "#/$defs/authoring_request"
        }
      },
      "additionalProperties": false
    },
    "ghost_preview_request_body": {
      "type": "object",
      "required": [
        "realm_id",
        "external_ref"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "external_ref": {
          "$ref": "#/$defs/ghost_external_tuple"
        },
        "display_name": {
          "$ref": "./string-profiles.schema.json#/$defs/display_text_256"
        }
      },
      "additionalProperties": false
    },
    "ghost_preview_outcome": {
      "type": "object",
      "required": [
        "authoring_request"
      ],
      "properties": {
        "authoring_request": {
          "$ref": "#/$defs/authoring_request"
        }
      },
      "additionalProperties": false
    },
    "author_request_body": {
      "type": "object",
      "required": [
        "authoring_request"
      ],
      "properties": {
        "authoring_request": {
          "$ref": "#/$defs/authoring_request"
        }
      },
      "additionalProperties": false
    },
    "managed_actor_bundle": {
      "type": "object",
      "x-arkret-proof-context": "ak.applet_managed_actor_bundle_proof.v1",
      "required": [
        "schema",
        "authoring_request_digest",
        "managed_actor_provision_event",
        "pcr_genesis_event",
        "accountability_grant_event",
        "profile_event",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.applet_managed_actor_authoring_bundle.v1"
        },
        "authoring_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "managed_actor_provision_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "ak.applet.managed_actor.provision"
                }
              }
            }
          ]
        },
        "pcr_genesis_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "ak.realm.create"
                }
              }
            }
          ]
        },
        "accountability_grant_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "ak.identity.accountability_grant"
                }
              }
            }
          ]
        },
        "profile_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "ak.profile.create"
                }
              }
            }
          ]
        },
        "proof": {
          "$ref": "./event-envelope.schema.json#/$defs/proof"
        }
      },
      "additionalProperties": false
    },
    "author_outcome": {
      "type": "object",
      "required": [
        "managed_actor_bundle"
      ],
      "properties": {
        "managed_actor_bundle": {
          "$ref": "#/$defs/managed_actor_bundle"
        }
      },
      "additionalProperties": false
    }
  }
}
