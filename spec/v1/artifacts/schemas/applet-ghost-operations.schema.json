{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-ghost-operations.schema.json",
  "title": "Arkret Applet Ghost Actor Operation DTOs",
  "description": "Closed preview, commit, and outcome DTOs for receiver-side Applet-managed Ghost provisioning. The commit carrier is exactly the signed authoring request plus its role-neutral managed-actor bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/ghost_preview_request_body"
    },
    {
      "$ref": "#/$defs/ghost_preview_outcome"
    },
    {
      "$ref": "#/$defs/ghost_actor_provision_request_body"
    },
    {
      "$ref": "#/$defs/ghost_actor_provision_outcome"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "event_ref": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "grant_ref": {
      "$ref": "./agent-operations.schema.json#/$defs/grant_id"
    },
    "ghost_preview_request_body": {
      "$ref": "./applet-install-authoring.schema.json#/$defs/ghost_preview_request_body"
    },
    "ghost_preview_outcome": {
      "$ref": "./applet-install-authoring.schema.json#/$defs/ghost_preview_outcome"
    },
    "ghost_actor_provision_request_body": {
      "type": "object",
      "required": [
        "authoring_request",
        "managed_actor_bundle"
      ],
      "properties": {
        "authoring_request": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/authoring_request"
        },
        "managed_actor_bundle": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/managed_actor_bundle"
        }
      },
      "additionalProperties": false
    },
    "ghost_actor_provision_outcome": {
      "type": "object",
      "required": [
        "ghost_actor_id",
        "actor_principal_server_id",
        "managed_actor_provision_ref",
        "principal_control_realm_id",
        "profile_event_ref",
        "accountability_grant_ref",
        "authorization_ref"
      ],
      "properties": {
        "ghost_actor_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "actor_principal_server_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "managed_actor_provision_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "principal_control_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "profile_event_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "accountability_grant_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "authorization_ref": {
          "$ref": "#/$defs/grant_ref"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        }
      },
      "additionalProperties": false
    }
  }
}
