{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-ghost-operations.schema.json",
  "title": "Arkret Applet Ghost Actor Operation DTOs",
  "description": "Closed preview, commit, and outcome DTOs for receiver-side Applet-managed Ghost provisioning. The commit carrier is exactly the signed authoring request plus its role-neutral managed-actor bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/ghost_preview_request_body"
    },
    {
      "$ref": "#/$defs/ghost_preview_outcome"
    }
  ],
  "$defs": {
    "ghost_preview_request_body": {
      "$ref": "./applet-install-authoring.schema.json#/$defs/ghost_preview_request_body"
    },
    "ghost_preview_outcome": {
      "$ref": "./applet-install-authoring.schema.json#/$defs/ghost_preview_outcome"
    },
    "existing_managed_actor": {
      "type": "object",
      "required": [
        "ghost_actor_id",
        "creation_ref"
      ],
      "properties": {
        "ghost_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        },
        "creation_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        }
      },
      "additionalProperties": false
    }
  }
}
