{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/morph.schema.json",
  "title": "Arkret Morph",
  "type": "object",
  "required": [
    "schema",
    "realm_id",
    "schema_refs",
    "morph_kind",
    "created_by",
    "created_at"
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "title"
        ],
        "$comment": "forbidden Morph top-level metadata; canonical path is metadata.title or encrypted_metadata"
      },
      {
        "required": [
          "summary"
        ],
        "$comment": "forbidden Morph top-level metadata; canonical path is metadata.summary or encrypted_metadata"
      },
      {
        "required": [
          "encrypted_payload"
        ],
        "$comment": "forbidden encrypted content carrier; canonical name is encrypted_content"
      },
      {
        "required": [
          "content",
          "encrypted_content"
        ]
      },
      {
        "required": [
          "metadata",
          "encrypted_metadata"
        ]
      }
    ]
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:morph:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Present on the materialised object. MUST be absent from the create Event payload: zh/models/common-fields.md derives it from the create Event's own event_id (retyped), so a payload-supplied id would be a second, forgeable truth."
    },
    "schema": {
      "const": "ak.schema.morph.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "scope_circle_id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id",
      "description": "Optional reference to an intra-Realm Circle that defines this Morph's effective scope. Omitted means Realm-default scope. The producer signs the corresponding Event.scope_ref; the receiver verifies scope_circle_id.realm_id == Morph.realm_id and exact equality between the derived scope and Event.scope_ref before materializing the object's immutable effective_scope."
    },
    "schema_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(ak\\.schema\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*[A-Za-z0-9_.:-]*)$"
      },
      "description": "Authoritative schema set for Morph fields and transition validation. Reducers MUST validate fields against exactly these refs; morph_kind and facets are not a replacement for schema_refs."
    },
    "morph_kind": {
      "type": "string",
      "minLength": 1
    },
    "facets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/facet_config"
      }
    },
    "metadata": {
      "$ref": "#/$defs/morph_metadata"
    },
    "encrypted_metadata": {
      "$ref": "./encrypted-envelope.schema.json",
      "description": "Encrypted envelope whose plaintext is a morph_metadata object. Required instead of plaintext metadata when the effective metadata_encryption_floor is e2ee_required."
    },
    "content": {
      "$ref": "#/$defs/content_block"
    },
    "encrypted_content": {
      "$ref": "./encrypted-envelope.schema.json",
      "description": "Encrypted envelope whose plaintext is a ContentBlock for Morph content."
    },
    "fields": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "redacted"
      ],
      "description": "Morph lifecycle state. 'active' is the default. Reducer enforces transitions per common-fields.md §5.1: ak.morph.archive MUST come from 'active' (else failed_precondition reason=morph_not_active); ak.morph.restore MUST come from 'archived' (else morph_not_archived); ak.redaction targeting the morph MUST come from {'active','archived'} (else morph_already_terminal). Same-state self-transitions MUST fail. 'redacted' is the irreversible terminal."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent state transition. MUST be set when state != 'active'; MUST be the created_at of the corresponding ak.morph.archive / ak.morph.restore / redaction Event. Aligns with Space.state_changed_at and the common-fields rule in models/common-fields.md §3."
    },
    "stage": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "planned",
        "in_progress",
        "blocked",
        "done",
        "cancelled",
        "superseded"
      ],
      "description": "Optional Morph business-progression stage. Orthogonal to top-level 'state' (physical lifecycle). A morph_kind profile MAY require it; generic mirror/data Morphs may omit it. If absent, the first ak.morph.stage.set initializes the axis to any registered value; later changes follow the normal transition rules. ak.morph.update / ak.morph.schema_migrate patches on stage / stage_changed_at MUST be rejected. Stage transitions do not carry a reason/note; explanations belong in a referenced Message. See models/common-fields.md §5.3."
    },
    "stage_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent stage transition. MUST be ignored when present on wire; reducer overwrites with the triggering ak.morph.stage.set event's created_at. Same-value self-transitions MUST NOT update this field."
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "archived",
              "redacted"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "state_changed_at"
        ]
      }
    },
    {
      "if": {
        "required": [
          "stage_changed_at"
        ]
      },
      "then": {
        "required": [
          "stage"
        ]
      }
    }
  ],
  "$defs": {
    "facet_config": {
      "type": "object",
      "additionalProperties": true
    },
    "morph_metadata": {
      "type": "object",
      "description": "Extensible user-readable Morph metadata. Morph business fields stay in the top-level fields object; metadata carries display-oriented fields such as title and summary. In MLS / E2EE realms this object is encrypted as encrypted_metadata unless the Realm explicitly opts into plaintext metadata.",
      "properties": {
        "title": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_512"
        },
        "summary": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        }
      },
      "not": {
        "$comment": "Reducer-owned fields and Morph business fields stay top-level and MUST NOT be mirrored inside metadata.",
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "schema"
            ]
          },
          {
            "required": [
              "realm_id"
            ]
          },
          {
            "required": [
              "scope_circle_id"
            ]
          },
          {
            "required": [
              "schema_refs"
            ]
          },
          {
            "required": [
              "morph_kind"
            ]
          },
          {
            "required": [
              "facets"
            ]
          },
          {
            "required": [
              "fields"
            ]
          },
          {
            "required": [
              "stage"
            ]
          },
          {
            "required": [
              "stage_changed_at"
            ]
          },
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "state_changed_at"
            ]
          },
          {
            "required": [
              "created_by"
            ]
          },
          {
            "required": [
              "created_at"
            ]
          },
          {
            "required": [
              "updated_by"
            ]
          },
          {
            "required": [
              "updated_at"
            ]
          },
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "encrypted_content"
            ]
          },
          {
            "required": [
              "encrypted_payload"
            ]
          }
        ]
      },
      "additionalProperties": true
    },
    "content_kind": {
      "type": "string",
      "pattern": "^(ak\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/content_kind"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        }
      },
      "additionalProperties": true,
      "not": {
        "$comment": "Reject discriminator field `type`, composite child array name `blocks`, and byte-count field `size`; canonical content blocks use `kind`, composite children use `parts`, and byte counts use `size_bytes`.",
        "anyOf": [
          {
            "required": [
              "type"
            ]
          },
          {
            "required": [
              "blocks"
            ]
          },
          {
            "required": [
              "size"
            ],
            "$comment": "byte counts use size_bytes"
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ak.content.composite"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "parts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ak.content.long_text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/content_block_long_text"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ak.content.text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "body": {
                "maxLength": 262144,
                "description": "Inline text body. Authoritative bound is 256 KiB UTF-8 bytes enforced by a byte validator; maxLength is a not-wider code-point fast bound. Longer bodies MUST use ak.content.long_text (zh/models/content-types.md section 4.1.4)."
              }
            }
          }
        }
      ]
    },
    "content_block_long_text": {
      "type": "object",
      "description": "ak.content.long_text: plain text whose full normalized UTF-8 body exceeds the 256 KiB inline boundary (or, by the narrow exception in zh/models/content-types.md section 4.1.4, whose Event would otherwise exceed the 1 MiB envelope limit). Exactly one of the plaintext branch (blob_ref + size_bytes + media_type) and the E2EE branch (attachment) applies. v1 core Content Block: no feature gate, no server-side opt-out.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "format",
            "body",
            "body_kind",
            "blob_ref",
            "size_bytes",
            "media_type"
          ],
          "properties": {
            "kind": {
              "const": "ak.content.long_text"
            },
            "format": {
              "type": "string",
              "enum": [
                "plain",
                "markdown"
              ],
              "description": "Closed set for long text. prosemirror_json is forbidden here; structured rich text needs its own Content Block."
            },
            "body": {
              "type": "string",
              "maxLength": 4096,
              "description": "Inline fallback. Authoritative bound is 4096 UTF-8 bytes enforced by a byte validator; maxLength is a not-wider code-point fast bound."
            },
            "body_kind": {
              "type": "string",
              "enum": [
                "prefix",
                "summary"
              ]
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            },
            "blob_ref": {
              "type": "string",
              "pattern": "^ak:blob:(sha256|blake3):[0-9a-f]{64}$",
              "description": "Hash-addressed Blob ref for the full normalized UTF-8 body. UUID blob refs are forbidden here because they carry no digest commitment."
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Normalized full UTF-8 body bytes. The >256 KiB rule and the narrow Event-overflow exception are normative validator rules (zh/models/content-types.md section 4.1.4), not a schema minimum."
            },
            "media_type": {
              "type": "string",
              "enum": [
                "text/plain",
                "text/markdown"
              ],
              "description": "MUST match format. No parameters: charset is fixed to UTF-8 by this kind."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "plain"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "media_type": {
                    "const": "text/plain"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "markdown"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "media_type": {
                    "const": "text/markdown"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind",
            "format",
            "body",
            "body_kind",
            "attachment"
          ],
          "properties": {
            "kind": {
              "const": "ak.content.long_text"
            },
            "format": {
              "type": "string",
              "enum": [
                "plain",
                "markdown"
              ],
              "description": "Closed set for long text. prosemirror_json is forbidden here; structured rich text needs its own Content Block."
            },
            "body": {
              "type": "string",
              "maxLength": 4096,
              "description": "Inline fallback. Authoritative bound is 4096 UTF-8 bytes enforced by a byte validator; maxLength is a not-wider code-point fast bound."
            },
            "body_kind": {
              "type": "string",
              "enum": [
                "prefix",
                "summary"
              ]
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            },
            "attachment": {
              "$ref": "./blob.schema.json#/$defs/encrypted_attachment",
              "description": "Encrypted full-body Blob descriptor. MUST use scheme ak.blob.stream_aead.v1 with the matching _stream alg; whole-file AEAD is forbidden for long text."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "attachment": {
                  "properties": {
                    "scheme": {
                      "const": "ak.blob.stream_aead.v1"
                    }
                  },
                  "required": [
                    "scheme"
                  ]
                }
              }
            },
            {
              "properties": {
                "attachment": {
                  "required": [
                    "scheme",
                    "nonce_prefix",
                    "segment_bytes",
                    "segment_count",
                    "size_bytes"
                  ],
                  "properties": {
                    "blob_ref": {
                      "type": "string",
                      "pattern": "^ak:blob:(sha256|blake3):[0-9a-f]{64}$",
                      "description": "Long text MUST use a hash-addressed Blob ref; the <suite>:<hex> part MUST equal attachment.ciphertext_digest and the Blob metadata content_digest."
                    },
                    "encryption_algorithm": {
                      "type": "string",
                      "enum": [
                        "mls_exporter_aead_xchacha20poly1305_stream",
                        "mls_exporter_aead_aes_256_gcm_stream"
                      ]
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Normalized full UTF-8 plaintext body bytes; encrypted_attachment.size_bytes is the plaintext count that segment_count = ceil(size_bytes / segment_bytes) is derived from (zh/crypto-media/media-and-blob.md section 3.1 / 3.3.1). The >256 KiB rule and the narrow Event-overflow exception are normative validator rules, not a schema minimum."
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "plain"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "attachment": {
                    "properties": {
                      "media_type": {
                        "const": "text/plain"
                      }
                    },
                    "required": [
                      "media_type"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "markdown"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "attachment": {
                    "properties": {
                      "media_type": {
                        "const": "text/markdown"
                      }
                    },
                    "required": [
                      "media_type"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  },
  "unevaluatedProperties": false
}
