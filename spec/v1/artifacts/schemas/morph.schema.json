{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/morph.schema.json",
  "title": "Contrix Morph",
  "type": "object",
  "required": [
    "id",
    "schema",
    "space_id",
    "morph_type",
    "created_by",
    "created_at"
  ],
  "not": {
    "required": [
      "content",
      "encrypted_payload"
    ]
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:morph:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.morph.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "morph_type": {
      "type": "string",
      "minLength": 1
    },
    "facets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/facet_config"
      }
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/content_block"
    },
    "encrypted_payload": {
      "$ref": "./encrypted-envelope.schema.json"
    },
    "fields": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted",
        "redacted"
      ],
      "description": "Morph lifecycle state. 'active' is the default. Reducer enforces transitions per common-fields.md §5.1: cx.morph.archive MUST come from 'active' (else failed_precondition reason=morph_not_active); cx.morph.restore MUST come from 'archived' (else morph_not_archived); cx.redaction targeting the morph MUST come from {'active','archived'} (else morph_already_terminal). Same-state self-transitions MUST fail. 'deleted' and 'redacted' are irreversible terminals."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent state transition. MUST be set when state != 'active'; MUST be the created_at of the corresponding cx.morph.archive / cx.morph.restore / cx.morph.tombstone / redaction Event. Aligns with Place.state_changed_at and the common-fields rule in models/common-fields.md §3."
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "facet_config": {
      "type": "object",
      "additionalProperties": true
    },
    "content_kind": {
      "type": "string",
      "pattern": "^(cx\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/content_kind"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        }
      },
      "additionalProperties": true
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
