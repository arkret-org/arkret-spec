{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-join-intake.schema.json",
  "title": "Arkret Realm Join Intake",
  "description": "Join discovery and bootstrap through the verified current governance Station. An inviter Station and Directory provide only routing hints; neither is an authority source.",
  "oneOf": [
    {
      "$ref": "#/$defs/self_prepare_request_body"
    },
    {
      "$ref": "#/$defs/self_prepare_response_body"
    },
    {
      "$ref": "#/$defs/self_preview_request_body"
    },
    {
      "$ref": "#/$defs/self_preview_response_body"
    },
    {
      "$ref": "#/$defs/peer_preview_request_body"
    },
    {
      "$ref": "#/$defs/peer_preview_response_body"
    },
    {
      "$ref": "#/$defs/peer_bootstrap_request_body"
    },
    {
      "$ref": "#/$defs/peer_bootstrap_response_body"
    }
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^ak:request:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invite_id": {
      "type": "string",
      "pattern": "^ak:invite:[A-Za-z0-9_-]{44}$"
    },
    "join_target": {
      "type": "object",
      "required": [
        "realm_id",
        "authority_locator_hints"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "invite_id": {
          "$ref": "#/$defs/invite_id"
        },
        "authority_locator_hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          },
          "description": "One to eight untrusted locator cores, strictly sorted by service_id UTF-8 bytes. service_id is the semantic identity key; duplicate or conflicting representations of one service_id invalidate the entire array."
        },
        "realm_invite_link_id": {
          "$ref": "./realm-invite-link.schema.json#/$defs/realm_invite_link_id"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "invite_id",
          "realm_invite_link_id"
        ]
      }
    },
    "join_intent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "invite_id"
          ],
          "properties": {
            "kind": {
              "const": "invite_accept",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-join-intake.schema.json#/$defs/join_intent/oneOf/0/properties/kind",
                "owner": "realm-join-intake.schema.json#/$defs/join_intent/oneOf/0/properties/kind",
                "values": [
                  "invite_accept"
                ]
              }
            },
            "invite_id": {
              "$ref": "#/$defs/invite_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "member_join",
                "knock"
              ],
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-join-intake.schema.json#/$defs/join_intent/oneOf/1/properties/kind",
                "owner": "realm-join-intake.schema.json#/$defs/join_intent/oneOf/1/properties/kind",
                "values": [
                  "member_join",
                  "knock"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_invite_link_id",
            "link_proof"
          ],
          "properties": {
            "kind": {
              "const": "invite_link_accept",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-join-intake.schema.json#/$defs/join_intent/oneOf/2/properties/kind",
                "owner": "realm-join-intake.schema.json#/$defs/join_intent/oneOf/2/properties/kind",
                "values": [
                  "invite_link_accept"
                ]
              }
            },
            "realm_invite_link_id": {
              "$ref": "./realm-invite-link.schema.json#/$defs/realm_invite_link_id"
            },
            "link_proof": {
              "$ref": "./realm-invite-link.schema.json#/$defs/proof"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "public_preview": {
      "type": "object",
      "required": [
        "realm_id",
        "join_rule",
        "history_access",
        "governance_generation"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "join_rule": {
          "$ref": "./realm.schema.json#/properties/default_join_rule"
        },
        "history_access": {
          "$ref": "./realm.schema.json#/properties/history_access"
        },
        "governance_generation": {
          "description": "Station tenure the intake descriptor was answered under.",
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "display_name": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "self_preview_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "target"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "target": {
          "$ref": "#/$defs/join_target"
        },
        "link_proof": {
          "$ref": "./realm-invite-link.schema.json#/$defs/proof"
        }
      },
      "additionalProperties": false
    },
    "self_preview_response_body": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "preview"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "preview": {
          "$ref": "#/$defs/public_preview"
        }
      },
      "additionalProperties": false,
      "description": "Pre-join disclosure relayed by the caller's own Station. authority_bundle is the RealmAuthorityBundle that Station fetched with its own nonce and verified before asking the current governance Station for the preview; the preview is not membership, a join commitment or verified governance state.",
      "x-arkret-name-role": "response_body"
    },
    "peer_preview_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "requester_account_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "invite_id": {
          "$ref": "#/$defs/invite_id"
        },
        "realm_invite_link_id": {
          "$ref": "./realm-invite-link.schema.json#/$defs/realm_invite_link_id"
        },
        "link_proof": {
          "$ref": "./realm-invite-link.schema.json#/$defs/proof"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "invite_id",
          "realm_invite_link_id"
        ]
      }
    },
    "peer_preview_response_body": {
      "type": "object",
      "required": [
        "request_id",
        "preview"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "preview": {
          "$ref": "#/$defs/public_preview"
        }
      },
      "additionalProperties": false,
      "description": "Disclosure answered by the verified current governance Station. It carries no authority bundle: the caller Station has already verified this Station through its own nonce-bound RealmAuthorityBundle and authenticates it as Destination-Service-ID.",
      "x-arkret-name-role": "response_body"
    },
    "self_prepare_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "target",
        "intent"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "target": {
          "$ref": "#/$defs/join_target"
        },
        "intent": {
          "$ref": "#/$defs/join_intent"
        }
      },
      "additionalProperties": false
    },
    "self_prepare_response_body": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "realm_stream_head"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "realm_stream_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        }
      },
      "additionalProperties": false,
      "description": "Current context for authoring a producer-signed join Event. It does not reserve a position or authorize admission.",
      "x-arkret-name-role": "response_body"
    },
    "peer_bootstrap_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "member_account_id",
        "membership_commit_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "member_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "membership_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id",
          "description": "RealmCommit of the member's own join that opened the caller's held stream, or re-anchored it after the caller had no joined hosted member left: ak.member.state{join} or ak.invite.accept for a directed Invite on the Realm stream, or ak.circle.member.state{join} on the Circle stream. Circle bootstrap requires current parent-Realm membership; a parent-Realm join Commit cannot replace the Circle join Commit (zh/sync/federation.md section 4.1.1)."
        },
        "history_stream_ref": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_ref",
          "description": "Optional exact target stream for a stream_history original instead of a full recovery baseline. The same accepted current membership and authenticated member Station checks apply. The response signed Account/stream coverage must match this request, and cannot bootstrap or overwrite current state."
        }
      },
      "additionalProperties": false
    },
    "peer_bootstrap_response_body": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "snapshot",
        "visible_stream_heads"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "snapshot": {
          "$ref": "./realm-state-snapshot.schema.json"
        },
        "visible_stream_heads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-commit.schema.json#/$defs/stream_head"
          }
        }
      },
      "additionalProperties": false,
      "description": "The verified current authority returns a snapshot whose retention_and_history_floor for the membership Commit's exact stream is that join position, with a visible head at or above it. Other authorized streams retain their own history floors. The caller verifies that prefix evidence, installs the disclosed snapshot current_state_entries as its typed current anchored at their stream heads, then scans each permitted stream from its own floor to its advertised head (zh/sync/federation.md section 4.1.1). After an already accepted registered atomic unit has completed member-station materialization, a governing Snapshot refresh preserves that caller's canonical history floor proved under zh/governance/history-visibility.md section 3.1 and its complete authorized current cut. Under since_join, floor zero requires the exact current founding join and position zero to belong to the same proven accepted atomic unit, with its complete originals and continuous Commit chain; later rejoin, missing originals, Realm purpose or low position alone cannot supply this exception. Direct Conversation four-item founding is never four independent single-join bootstrap exceptions. This clarification does not change the initial ordinary single-join bootstrap prefix, Circle gates, signatures, governance tenure, exact scope, membership or continuous-prefix verification, and adds no operation or DTO.",
      "x-arkret-name-role": "response_body"
    }
  }
}
