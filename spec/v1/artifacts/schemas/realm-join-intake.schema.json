{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-join-intake.schema.json",
  "title": "Arkret Realm Join Intake",
  "description": "Join discovery and bootstrap through the verified current governance Station. An inviter Station and Directory provide only routing hints; neither is an authority source.",
  "oneOf": [
    {
      "$ref": "#/$defs/self_prepare_request_body"
    },
    {
      "$ref": "#/$defs/self_prepare_outcome"
    },
    {
      "$ref": "#/$defs/self_preview_request_body"
    },
    {
      "$ref": "#/$defs/self_preview_outcome"
    },
    {
      "$ref": "#/$defs/peer_preview_request_body"
    },
    {
      "$ref": "#/$defs/peer_preview_outcome"
    },
    {
      "$ref": "#/$defs/peer_bootstrap_request_body"
    },
    {
      "$ref": "#/$defs/peer_bootstrap_outcome"
    },
    {
      "$ref": "#/$defs/self_application_status_request_body"
    },
    {
      "$ref": "#/$defs/self_application_status_outcome"
    },
    {
      "$ref": "#/$defs/peer_application_status_request_body"
    },
    {
      "$ref": "#/$defs/peer_application_status_outcome"
    }
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^ak:request:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invite_id": {
      "type": "string",
      "pattern": "^ak:invite:[A-Za-z0-9_-]{44}$"
    },
    "invite_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "join_target": {
      "type": "object",
      "required": [
        "realm_id",
        "authority_locator_hints"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "invite_id": {
          "$ref": "#/$defs/invite_id"
        },
        "invite_token": {
          "$ref": "#/$defs/invite_token"
        },
        "authority_locator_hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          },
          "description": "One to eight untrusted locator cores, strictly sorted by service_id UTF-8 bytes. service_id is the semantic identity key; duplicate or conflicting representations of one service_id invalidate the entire array."
        }
      },
      "additionalProperties": false
    },
    "join_intent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "invite_id",
            "invite_token"
          ],
          "properties": {
            "kind": {
              "const": "invite_accept"
            },
            "invite_id": {
              "$ref": "#/$defs/invite_id"
            },
            "invite_token": {
              "$ref": "#/$defs/invite_token"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "member_join",
                "knock"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "public_preview": {
      "type": "object",
      "required": [
        "realm_id",
        "join_rule",
        "history_access",
        "governance_generation"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "join_rule": {
          "$ref": "./realm.schema.json#/properties/default_join_rule"
        },
        "history_access": {
          "$ref": "./realm.schema.json#/properties/history_access"
        },
        "governance_generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Station tenure the intake descriptor was answered under."
        },
        "display_name": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "self_preview_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "target"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "target": {
          "$ref": "#/$defs/join_target"
        }
      },
      "additionalProperties": false
    },
    "self_preview_outcome": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "preview"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "preview": {
          "$ref": "#/$defs/public_preview"
        }
      },
      "additionalProperties": false
    },
    "peer_preview_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "requester_account_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "invite_id": {
          "$ref": "#/$defs/invite_id"
        },
        "invite_token": {
          "$ref": "#/$defs/invite_token"
        }
      },
      "additionalProperties": false
    },
    "peer_preview_outcome": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "preview"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "preview": {
          "$ref": "#/$defs/public_preview"
        }
      },
      "additionalProperties": false
    },
    "self_prepare_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "target",
        "intent"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "target": {
          "$ref": "#/$defs/join_target"
        },
        "intent": {
          "$ref": "#/$defs/join_intent"
        }
      },
      "additionalProperties": false
    },
    "self_prepare_outcome": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "realm_stream_head"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "realm_stream_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        }
      },
      "additionalProperties": false,
      "description": "Current context for authoring a producer-signed join Event. It does not reserve a position or authorize admission."
    },
    "application_status_request": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "application_event_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "application_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "application_status_outcome": {
      "type": "object",
      "required": [
        "request_id",
        "status"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "status": {
          "enum": [
            "pending",
            "committed",
            "rejected"
          ]
        },
        "commit": {
          "$ref": "./realm-commit.schema.json"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "self_application_status_request_body": {
      "$ref": "#/$defs/application_status_request"
    },
    "peer_application_status_request_body": {
      "$ref": "#/$defs/application_status_request"
    },
    "self_application_status_outcome": {
      "$ref": "#/$defs/application_status_outcome"
    },
    "peer_application_status_outcome": {
      "$ref": "#/$defs/application_status_outcome"
    },
    "peer_bootstrap_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "member_account_id",
        "membership_commit_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "member_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "membership_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        }
      },
      "additionalProperties": false
    },
    "peer_bootstrap_outcome": {
      "type": "object",
      "required": [
        "request_id",
        "authority_bundle",
        "snapshot",
        "visible_stream_heads"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "authority_bundle": {
          "$ref": "./realm-authority-bundle.schema.json"
        },
        "snapshot": {
          "$ref": "./realm-state-snapshot.schema.json"
        },
        "visible_stream_heads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-commit.schema.json#/$defs/stream_head"
          }
        }
      },
      "additionalProperties": false,
      "description": "The verified current authority returns a snapshot and every stream head visible after the membership Commit. The caller then scans every permitted stream from its snapshot floor to the advertised head."
    }
  }
}
