{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-install-operations.schema.json",
  "title": "Arkret Applet Install Operation DTOs",
  "description": "Closed request/response DTOs for ak.self.applet.install.command.preview, ak.self.applet.command.install, and ak.self.applet.command.revoke. The InstallPlan body itself is defined in applet-install-plan.schema.json.",
  "oneOf": [
    {
      "$ref": "#/$defs/applet_install_preview_request_body"
    },
    {
      "$ref": "../schemas/applet-install-plan.schema.json"
    },
    {
      "$ref": "#/$defs/applet_install_request_body"
    },
    {
      "$ref": "#/$defs/applet_install_outcome"
    },
    {
      "$ref": "#/$defs/applet_revoke_request_body"
    },
    {
      "$ref": "#/$defs/applet_revoke_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "applet_id": {
      "type": "string",
      "pattern": "^ak:applet:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_ref": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^ak:grant:[A-Za-z0-9_-]{44}$"
    },
    "typed_ref": {
      "type": "string",
      "pattern": "^ak:[a-z][a-z0-9_]*:[A-Za-z0-9._:-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "applet_package": {
      "$ref": "../schemas/applet-package.schema.json"
    },
    "effective_scope": {
      "$ref": "../schemas/applet-install-plan.schema.json#/$defs/effective_scope"
    },
    "scope_grant": {
      "$ref": "../schemas/applet-install-plan.schema.json#/$defs/scope_grant"
    },
    "approval_request": {
      "type": "object",
      "required": [
        "approve_actions",
        "ghost_actors_allowed",
        "delegated_native_actors_allowed",
        "e2ee_join_allowed",
        "widget_allowed"
      ],
      "properties": {
        "approve_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ghost_actors_allowed": {
          "type": "boolean"
        },
        "delegated_native_actors_allowed": {
          "type": "boolean"
        },
        "e2ee_join_allowed": {
          "type": "boolean"
        },
        "widget_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "actor_policy": {
      "type": "object",
      "properties": {
        "bot_membership": {
          "type": "string",
          "enum": [
            "invite",
            "join",
            "disabled"
          ]
        },
        "ghost_actor_mode": {
          "type": "string",
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ]
        }
      },
      "additionalProperties": false
    },
    "e2ee_policy": {
      "type": "object",
      "properties": {
        "mls_join_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "widget_policy": {
      "type": "object",
      "properties": {
        "widget_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rejected_item": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "requested_scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_install_preview_request_body": {
      "type": "object",
      "required": [
        "applet_package",
        "effective_scope",
        "approval_request"
      ],
      "properties": {
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "approval_request": {
          "$ref": "#/$defs/approval_request"
        }
      },
      "additionalProperties": false
    },
    "applet_install_request_body": {
      "type": "object",
      "required": [
        "plan_digest",
        "applet_package",
        "effective_scope",
        "registration_event",
        "capability_grant_events"
      ],
      "properties": {
        "plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "registration_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "ak.applet.registration"
                }
              }
            }
          ],
          "description": "Caller-signed formal registration Event. actor_id MUST equal the authenticated install admin, payload MUST exactly equal the registration derived from applet_package, and the controller proof copied into payload.proof remains independently required."
        },
        "capability_grant_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "./event-envelope.schema.json"
              },
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "ak.capability.grant"
                  }
                }
              }
            ]
          },
          "description": "Caller-signed formal capability-grant Events. Each Event actor and grant issuer MUST equal the authenticated install admin; subjects, actions, resources and applet_authority constraints MUST exactly match the recomputed install plan and effective_scope."
        },
        "actor_policy": {
          "$ref": "#/$defs/actor_policy"
        },
        "e2ee_policy": {
          "$ref": "#/$defs/e2ee_policy"
        },
        "widget_policy": {
          "$ref": "#/$defs/widget_policy"
        }
      },
      "additionalProperties": false
    },
    "applet_install_outcome": {
      "type": "object",
      "required": [
        "ok",
        "install_id",
        "applet_id",
        "registration_event_ref",
        "registration_epoch",
        "bot_actor_id",
        "capability_grant_refs",
        "membership_event_refs",
        "e2ee_authorization_refs",
        "widget_policy_ref",
        "effective_status",
        "rejected"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "install_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "applet_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/did"
            },
            {
              "$ref": "#/$defs/applet_id"
            }
          ]
        },
        "registration_event_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/event_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration_epoch": {
          "$ref": "#/$defs/hash"
        },
        "bot_actor_id": {
          "$ref": "#/$defs/did"
        },
        "capability_grant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant_id"
          },
          "uniqueItems": true
        },
        "membership_event_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          },
          "uniqueItems": true
        },
        "e2ee_authorization_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          },
          "uniqueItems": true
        },
        "widget_policy_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/event_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_status": {
          "type": "string",
          "enum": [
            "installed",
            "partially_installed",
            "rejected"
          ]
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_item"
          }
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_request_body": {
      "type": "object",
      "required": [
        "effective_scope",
        "reason_code",
        "revoke_mode"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only",
            "revoke_delegated_sessions"
          ]
        },
        "proof": {
          "$ref": "../schemas/account-operations.schema.json#/$defs/account_lifecycle_proof",
          "description": "Required when revoke_mode includes delegated session revocation in production. The proof signs the canonical ak.gate.account.command.revoke_session transcript reconstructed from the active applet install selector."
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_outcome": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "revoked_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typed_ref"
          },
          "uniqueItems": true
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_item"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
