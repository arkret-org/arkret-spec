{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-install-operations.schema.json",
  "title": "Arkret Applet Install Operation DTOs",
  "description": "Closed request/response DTOs for ak.self.applet.install.command.preview.v1, ak.self.applet.command.install.v1, and ak.self.applet.command.revoke.v1. The InstallPlan body itself is defined in applet-install-plan.schema.json.",
  "oneOf": [
    {
      "$ref": "#/$defs/applet_install_preview_request_body"
    },
    {
      "$ref": "./applet-install-authoring.schema.json#/$defs/install_preview_outcome"
    },
    {
      "$ref": "./applet-install-authoring.schema.json#/$defs/author_request_body"
    },
    {
      "$ref": "./applet-install-authoring.schema.json#/$defs/author_outcome"
    },
    {
      "$ref": "../schemas/applet-install-plan.schema.json"
    },
    {
      "$ref": "#/$defs/applet_install_request_body"
    },
    {
      "$ref": "#/$defs/applet_install_outcome"
    },
    {
      "$ref": "#/$defs/applet_revoke_preview_request_body"
    },
    {
      "$ref": "#/$defs/applet_revoke_preview_outcome"
    },
    {
      "$ref": "#/$defs/applet_revoke_request_body"
    },
    {
      "$ref": "#/$defs/applet_revoke_outcome"
    }
  ],
  "$defs": {
    "applet_id": {
      "$ref": "./common-ids.schema.json#/$defs/applet_id"
    },
    "event_ref": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "grant_id": {
      "$ref": "./agent-operations.schema.json#/$defs/grant_id"
    },
    "typed_ref": {
      "$ref": "./account-operations.schema.json#/$defs/typed_ref"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "applet_package": {
      "$ref": "../schemas/applet-package.schema.json"
    },
    "effective_scope": {
      "$ref": "../schemas/applet-install-plan.schema.json#/$defs/effective_scope"
    },
    "rejected_scope_row": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "requested_scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_install_preview_request_body": {
      "type": "object",
      "required": [
        "applet_package",
        "authoring_request_basis"
      ],
      "properties": {
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "authoring_request_basis": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/install_authoring_request_basis"
        }
      },
      "additionalProperties": false
    },
    "applet_install_request_body": {
      "oneOf": [
        {
          "$ref": "#/$defs/applet_install_first_request_body"
        },
        {
          "$ref": "#/$defs/applet_install_reuse_request_body"
        }
      ]
    },
    "applet_install_first_request_body": {
      "type": "object",
      "required": [
        "applet_package",
        "authoring_request",
        "managed_actor_bundle"
      ],
      "properties": {
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "authoring_request": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/authoring_request"
        },
        "managed_actor_bundle": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/managed_actor_bundle"
        }
      },
      "additionalProperties": false
    },
    "reuse_existing_managed_actor": {
      "type": "object",
      "description": "Immutable anchors of the one existing Bot authority winner for this applet and target Station. The receiver recomputes every field from accepted local state.",
      "required": [
        "actor_id",
        "managed_actor_provision_ref",
        "pcr_genesis_ref",
        "accountability_grant_ref",
        "profile_event_ref",
        "initial_package_bot_actor_id"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "managed_actor_provision_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "pcr_genesis_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "accountability_grant_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "profile_event_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "initial_package_bot_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        }
      },
      "additionalProperties": false
    },
    "applet_install_reuse_request_body": {
      "type": "object",
      "required": [
        "applet_package",
        "authoring_request",
        "reuse_existing_managed_actor"
      ],
      "properties": {
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "authoring_request": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/authoring_request"
        },
        "reuse_existing_managed_actor": {
          "$ref": "#/$defs/reuse_existing_managed_actor"
        }
      },
      "additionalProperties": false
    },
    "applet_install_outcome": {
      "type": "object",
      "required": [
        "install_id",
        "applet_id",
        "registration_event_ref",
        "registration_epoch",
        "bot_actor_id",
        "bot_actor_provision_ref",
        "bot_principal_control_realm_id",
        "capability_grant_refs",
        "e2ee_authorization_refs",
        "widget_policy_ref",
        "effective_status",
        "rejections"
      ],
      "properties": {
        "install_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "registration_event_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "registration_epoch": {
          "$ref": "#/$defs/digest"
        },
        "bot_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "bot_actor_provision_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "bot_principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "capability_grant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant_id"
          },
          "uniqueItems": true
        },
        "e2ee_authorization_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          },
          "uniqueItems": true
        },
        "widget_policy_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/event_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_status": {
          "type": "string",
          "enum": [
            "installed",
            "partially_installed"
          ]
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_scope_row"
          }
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_request_body": {
      "type": "object",
      "required": [
        "revoke_plan_digest",
        "effective_scope",
        "reason_code",
        "revoke_mode",
        "capability_revoke_events",
        "membership_state_events"
      ],
      "properties": {
        "revoke_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only"
          ]
        },
        "capability_revoke_events": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "allOf": [
                      {
                        "$ref": "./service-operation-dtos.schema.json#/$defs/EventSubmitEnvelope"
                      },
                      {
                        "type": "object",
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "ak.capability.revoke"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "description": "Exactly one caller-signed ak.capability.revoke initial submission for every active grant in the recomputed plan."
        },
        "membership_state_events": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "allOf": [
                      {
                        "$ref": "./service-operation-dtos.schema.json#/$defs/EventSubmitEnvelope"
                      },
                      {
                        "type": "object",
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "ak.member.state"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "description": "Caller-signed membership removals in the plan, or an empty array when the install owns no managed membership."
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_preview_request_body": {
      "type": "object",
      "required": [
        "effective_scope",
        "reason_code",
        "revoke_mode"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only"
          ]
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_plan": {
      "type": "object",
      "required": [
        "applet_id",
        "effective_scope",
        "registration_epoch",
        "reason_code",
        "revoke_mode",
        "capability_revocations",
        "membership_removals",
        "widget_token_refs"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "registration_epoch": {
          "$ref": "#/$defs/digest"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only"
          ]
        },
        "capability_revocations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/applet_capability_revoke_intent"
          }
        },
        "membership_removals": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/applet_membership_remove_intent"
          }
        },
        "widget_token_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typed_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "applet_capability_revoke_intent": {
      "type": "object",
      "required": [
        "event_kind",
        "grant_id",
        "expected_revision",
        "registration_epoch",
        "reason_code"
      ],
      "properties": {
        "event_kind": {
          "const": "ak.capability.revoke"
        },
        "grant_id": {
          "$ref": "#/$defs/grant_id"
        },
        "expected_revision": {
          "$ref": "./typed-current-result.schema.json#/$defs/revision",
          "description": "Exact revision of the same active capability_grant current result returned by the governing Station in this preview plan. It is covered by the canonical plan digest and MUST be copied byte-for-byte into the caller-signed ak.capability.revoke payload."
        },
        "registration_epoch": {
          "$ref": "#/$defs/digest"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_membership_remove_intent": {
      "type": "object",
      "required": [
        "event_kind",
        "member_id",
        "membership",
        "reason_code"
      ],
      "properties": {
        "event_kind": {
          "const": "ak.member.state"
        },
        "member_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "membership": {
          "const": "leave"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_preview_outcome": {
      "type": "object",
      "required": [
        "revoke_plan"
      ],
      "properties": {
        "revoke_plan": {
          "$ref": "#/$defs/applet_revoke_plan",
          "description": "Canonical exact revoke plan. The preview carries no revoke_plan_digest: the caller computes SHA-256 over RFC 8785 JCS of this plan and submits that value as applet_revoke_request_body.revoke_plan_digest."
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_step": {
      "description": "Closed state-dependent saga step. Event steps use the immutable submitted EventId before acceptance and the exact CommittedEventRef only after acceptance or duplicate resolution. Local effects always use a non-Event typed resource reference.",
      "oneOf": [
        {
          "$ref": "#/$defs/applet_revoke_submitted_event_step"
        },
        {
          "$ref": "#/$defs/applet_revoke_committed_event_step"
        },
        {
          "$ref": "#/$defs/applet_revoke_local_effect_step"
        }
      ]
    },
    "applet_revoke_submitted_event_step": {
      "type": "object",
      "required": [
        "effect_kind",
        "submitted_event_id",
        "status"
      ],
      "properties": {
        "effect_kind": {
          "$ref": "#/$defs/applet_revoke_event_effect_kind"
        },
        "submitted_event_id": {
          "$ref": "#/$defs/event_ref"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "rejected"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_committed_event_step": {
      "type": "object",
      "required": [
        "effect_kind",
        "committed_event_ref",
        "status"
      ],
      "properties": {
        "effect_kind": {
          "$ref": "#/$defs/applet_revoke_event_effect_kind"
        },
        "committed_event_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_local_effect_step": {
      "type": "object",
      "required": [
        "effect_kind",
        "effect_ref",
        "status"
      ],
      "properties": {
        "effect_kind": {
          "type": "string",
          "enum": [
            "widget_token_invalidation",
            "local_applet_fence"
          ]
        },
        "effect_ref": {
          "$ref": "#/$defs/applet_revoke_local_effect_ref"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "duplicate",
            "rejected"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_event_effect_kind": {
      "type": "string",
      "enum": [
        "capability_revoke_event",
        "membership_state_event"
      ]
    },
    "applet_revoke_outcome": {
      "type": "object",
      "required": [
        "operation_id",
        "revoke_plan_digest",
        "status",
        "steps"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^ak:operation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revoke_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "in_progress",
            "partially_completed"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/applet_revoke_step"
          }
        },
        "revoked_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applet_revoke_effect_ref"
          },
          "uniqueItems": true
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_scope_row"
          }
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_effect_ref": {
      "description": "CommittedEventRef for a durable revoke Event, or a local typed resource reference for service-local widget token or fence effects. Bare EventId and RealmCommitId strings are not valid effect references.",
      "oneOf": [
        {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        {
          "$ref": "#/$defs/applet_revoke_local_effect_ref"
        }
      ]
    },
    "applet_revoke_local_effect_ref": {
      "description": "Typed service-local revoke effect reference. EventId and RealmCommitId are forbidden because only Event admission can produce a committed Event coordinate.",
      "type": "string",
      "pattern": "^ak:(?!event:|realm_commit:)[a-z][a-z0-9_]*:[A-Za-z0-9._~:/-]+$"
    }
  }
}
