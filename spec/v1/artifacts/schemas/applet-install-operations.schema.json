{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-install-operations.schema.json",
  "title": "Arkret Applet Install Operation DTOs",
  "description": "Closed request/response DTOs for ak.self.applet.install.command.preview, ak.self.applet.command.install, and ak.self.applet.command.revoke. The InstallPlan body itself is defined in applet-install-plan.schema.json.",
  "oneOf": [
    {
      "$ref": "#/$defs/applet_install_preview_request_body"
    },
    {
      "$ref": "./applet-install-authoring.schema.json#/$defs/preview_outcome"
    },
    {
      "$ref": "./applet-install-authoring.schema.json#/$defs/author_request_body"
    },
    {
      "$ref": "./applet-install-authoring.schema.json#/$defs/author_outcome"
    },
    {
      "$ref": "../schemas/applet-install-plan.schema.json"
    },
    {
      "$ref": "#/$defs/applet_install_request_body"
    },
    {
      "$ref": "#/$defs/applet_install_outcome"
    },
    {
      "$ref": "#/$defs/applet_revoke_preview_request_body"
    },
    {
      "$ref": "#/$defs/applet_revoke_preview_outcome"
    },
    {
      "$ref": "#/$defs/applet_revoke_request_body"
    },
    {
      "$ref": "#/$defs/applet_revoke_outcome"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "applet_id": {
      "$ref": "./common-ids.schema.json#/$defs/applet_id"
    },
    "event_ref": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "grant_id": {
      "$ref": "./agent-operations.schema.json#/$defs/grant_id"
    },
    "typed_ref": {
      "$ref": "./account-operations.schema.json#/$defs/typed_ref"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "applet_package": {
      "$ref": "../schemas/applet-package.schema.json"
    },
    "effective_scope": {
      "$ref": "../schemas/applet-install-plan.schema.json#/$defs/effective_scope"
    },
    "scope_grant": {
      "$ref": "../schemas/applet-install-plan.schema.json#/$defs/scope_grant"
    },
    "approval_request": {
      "type": "object",
      "required": [
        "approve_actions",
        "ghost_actor_mode",
        "delegated_native_actors_allowed",
        "e2ee_join_allowed",
        "widget_allowed"
      ],
      "properties": {
        "approve_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ghost_actor_mode": {
          "type": "string",
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ],
          "description": "Ghost actor admission intent echoed from the plan. It is the same three-valued field the commit carries as actor_policy.ghost_actor_mode; the preview MUST echo it verbatim so there is no second spelling to keep consistent."
        },
        "delegated_native_actors_allowed": {
          "type": "boolean"
        },
        "e2ee_join_allowed": {
          "type": "boolean"
        },
        "widget_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "actor_policy": {
      "type": "object",
      "properties": {
        "bot_membership": {
          "type": "string",
          "enum": [
            "invite",
            "join",
            "disabled"
          ]
        },
        "ghost_actor_mode": {
          "type": "string",
          "enum": [
            "disallowed",
            "controller_approved",
            "policy_declared"
          ]
        }
      },
      "additionalProperties": false
    },
    "e2ee_policy": {
      "type": "object",
      "properties": {
        "mls_join_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "widget_policy": {
      "type": "object",
      "properties": {
        "widget_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rejected_item": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "requested_scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_install_preview_request_body": {
      "type": "object",
      "required": [
        "applet_package",
        "authoring_request_basis"
      ],
      "properties": {
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "authoring_request_basis": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/authoring_request_basis"
        }
      },
      "additionalProperties": false
    },
    "applet_install_request_body": {
      "type": "object",
      "required": [
        "applet_package",
        "authoring_request",
        "managed_actor_bundle"
      ],
      "properties": {
        "applet_package": {
          "$ref": "#/$defs/applet_package"
        },
        "authoring_request": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/authoring_request"
        },
        "managed_actor_bundle": {
          "$ref": "./applet-install-authoring.schema.json#/$defs/managed_actor_bundle"
        }
      },
      "additionalProperties": false
    },
    "applet_install_outcome": {
      "type": "object",
      "required": [
        "ok",
        "install_id",
        "applet_id",
        "registration_event_ref",
        "registration_epoch",
        "bot_actor_id",
        "bot_actor_principal_server_id",
        "bot_actor_provision_ref",
        "bot_principal_control_realm_id",
        "capability_grant_refs",
        "membership_event_refs",
        "e2ee_authorization_refs",
        "widget_policy_ref",
        "effective_status",
        "rejected"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "install_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "registration_event_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/event_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration_epoch": {
          "$ref": "#/$defs/digest"
        },
        "bot_actor_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "bot_actor_principal_server_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "bot_actor_provision_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "bot_principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "capability_grant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant_id"
          },
          "uniqueItems": true
        },
        "membership_event_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          },
          "uniqueItems": true
        },
        "e2ee_authorization_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          },
          "uniqueItems": true
        },
        "widget_policy_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/event_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_status": {
          "type": "string",
          "enum": [
            "installed",
            "partially_installed",
            "rejected"
          ]
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_item"
          }
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_request_body": {
      "type": "object",
      "required": [
        "revoke_plan_digest",
        "effective_scope",
        "reason_code",
        "revoke_mode",
        "capability_revoke_events",
        "membership_state_events"
      ],
      "properties": {
        "revoke_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only",
            "revoke_delegated_sessions"
          ]
        },
        "capability_revoke_events": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "./service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "allOf": [
                      {
                        "$ref": "./service-operation-dtos.schema.json#/$defs/EventSubmitEnvelope"
                      },
                      {
                        "type": "object",
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "ak.capability.revoke"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "description": "Exactly one caller-signed ak.capability.revoke initial submission for every active grant in the recomputed plan."
        },
        "membership_state_events": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "./service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "allOf": [
                      {
                        "$ref": "./service-operation-dtos.schema.json#/$defs/EventSubmitEnvelope"
                      },
                      {
                        "type": "object",
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "ak.member.state"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "description": "Caller-signed membership removals in the plan, or an empty array when the install owns no managed membership."
        },
        "proof": {
          "$ref": "../schemas/account-operations.schema.json#/$defs/account_lifecycle_proof",
          "description": "Required when revoke_mode includes delegated session revocation in production. The proof signs the canonical ak.gate.account.command.revoke_session transcript reconstructed from the active applet install selector."
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_preview_request_body": {
      "type": "object",
      "required": [
        "effective_scope",
        "reason_code",
        "revoke_mode"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only",
            "revoke_delegated_sessions"
          ]
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_plan": {
      "type": "object",
      "required": [
        "applet_id",
        "effective_scope",
        "registration_epoch",
        "reason_code",
        "revoke_mode",
        "capability_revocations",
        "membership_removals",
        "widget_token_refs",
        "delegated_session_refs"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "effective_scope": {
          "$ref": "#/$defs/effective_scope"
        },
        "registration_epoch": {
          "$ref": "#/$defs/digest"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revoke_mode": {
          "type": "string",
          "enum": [
            "revoke_all",
            "revoke_runtime_only",
            "revoke_widget_only",
            "revoke_delegated_sessions"
          ]
        },
        "capability_revocations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/applet_capability_revoke_intent"
          }
        },
        "membership_removals": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/applet_membership_remove_intent"
          }
        },
        "widget_token_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typed_ref"
          }
        },
        "delegated_session_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typed_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "applet_capability_revoke_intent": {
      "type": "object",
      "required": [
        "event_kind",
        "grant_id",
        "registration_epoch",
        "reason_code"
      ],
      "properties": {
        "event_kind": {
          "const": "ak.capability.revoke"
        },
        "grant_id": {
          "$ref": "#/$defs/grant_id"
        },
        "registration_epoch": {
          "$ref": "#/$defs/digest"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_membership_remove_intent": {
      "type": "object",
      "required": [
        "event_kind",
        "member_id",
        "membership",
        "reason_code"
      ],
      "properties": {
        "event_kind": {
          "const": "ak.member.state"
        },
        "member_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "membership": {
          "type": "string",
          "enum": [
            "leave",
            "remove"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_preview_outcome": {
      "type": "object",
      "required": [
        "revoke_plan_digest",
        "revoke_plan"
      ],
      "properties": {
        "revoke_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "revoke_plan": {
          "$ref": "#/$defs/applet_revoke_plan"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_step": {
      "type": "object",
      "required": [
        "effect_kind",
        "effect_ref",
        "status"
      ],
      "properties": {
        "effect_kind": {
          "type": "string",
          "enum": [
            "capability_revoke_event",
            "membership_state_event",
            "widget_token_invalidation",
            "delegated_session_revocation",
            "local_applet_fence"
          ]
        },
        "effect_ref": {
          "$ref": "#/$defs/typed_ref"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "duplicate",
            "rejected"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "applet_revoke_outcome": {
      "type": "object",
      "required": [
        "ok",
        "operation_id",
        "revoke_plan_digest",
        "status",
        "steps"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^ak:operation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revoke_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "in_progress",
            "partially_completed"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/applet_revoke_step"
          }
        },
        "revoked_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typed_ref"
          },
          "uniqueItems": true
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_item"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
