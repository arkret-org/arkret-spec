{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/capability-grant.schema.json",
  "title": "Contrix Capability Grant",
  "type": "object",
  "required": [
    "id",
    "issuer",
    "subject",
    "actions",
    "resources",
    "proofs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:grant:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.capability.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requires_claims"
          ],
          "properties": {
            "kind": {
              "const": "condition"
            },
            "requires_claims": {
              "$ref": "./grant-constraint.schema.json#/properties/requires_claims"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
        "description": "Canonical action vocabulary. MUST be of the form cx.<segment>.<segment>... matching capabilities.md §5. Bare names without the cx. prefix are not permitted; consult capabilities.md before introducing new action names. Wildcards within a segment are not permitted in this schema; the resource selector controls scope, not action expansion."
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "./resource-selector.schema.json"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "./grant-constraint.schema.json"
      },
      "description": "Constraints applied to this grant. Delegation control MUST be expressed via a constraint with constraint_type='delegation_control' and 'max_delegation_depth' (canonical, see capabilities.md §10). The early-draft top-level 'delegable' boolean is removed — it duplicated max_delegation_depth=0 semantics with no precedence rule. Implementations MUST reject grants carrying a top-level 'delegable' field as schema_violation. Default when no delegation_control constraint is present: not delegable (equivalent to max_delegation_depth=0)."
    },
    "parent_grant_id": {
      "type": "string",
      "pattern": "^cx:grant:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "revoked_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-schema.json#/$defs/proof"
      },
      "minItems": 1
    },
    "attached_authority": {
      "type": "object",
      "description": "Optional binding to a cx.schema.agent_authority.v1 attestation. REQUIRED (reducer-enforced) when grant subject is an agent DID whose agent_authority.acting_mode == 'delegated_assistant'. Two evidence shapes are supported in v1: anchored_event_ref (preferred, verifiable inclusion proof) and state_witness (issuer-signed snapshot, TTL-bound). The Rev 7 inline_copy variant is reserved for v2 air-gapped scenarios. **P-D1 sync-verify policy (2026)**: anchored_event_ref MUST be verified synchronously against the controller's principal server BEFORE the grant releases any source Space access (membership / MLS Welcome / history visibility / import_attestation reference); unverified grants stay in `pending_verification` and the reducer MUST NOT downgrade-then-accept (no `unverified_authority` fast path). state_witness is the offline-friendly form for controller-server-unreachable scenarios. See extensions/agent-workspace-profile.md §5.",
      "required": ["evidence_kind"],
      "oneOf": [
        {
          "properties": {
            "evidence_kind": { "const": "anchored_event_ref" },
            "authority_event_ref": {
              "type": "string",
              "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "authority_event_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "anchor_inclusion_proof": { "type": "object" }
          },
          "required": ["evidence_kind", "authority_event_ref", "authority_event_hash"],
          "additionalProperties": false
        },
        {
          "properties": {
            "evidence_kind": { "const": "state_witness" },
            "witness_issuer": {
              "type": "string",
              "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
            },
            "witness_signature": { "type": "string" },
            "agent_id": {
              "type": "string",
              "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
            },
            "controller": {
              "type": "string",
              "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
            },
            "responsible_actor": {
              "type": "string",
              "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
            },
            "acting_mode": { "type": "string" },
            "valid_until": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [
            "evidence_kind",
            "witness_issuer",
            "witness_signature",
            "agent_id",
            "controller",
            "valid_until"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "not": {
    "required": [
      "delegable"
    ]
  },
  "allOf": [
    {
      "$comment": "Lint condition (2) from capabilities.md §18.1: grants whose actions[] include moderator-role actions MUST carry a constraint with depends_on_moderation_state=true. Conditions (1) and (3) (subject condition selector referencing moderation state, constraints referencing moderation queue/cell) are reducer-side lint and not enforced here.",
      "if": {
        "properties": {
          "actions": {
            "type": "array",
            "contains": {
              "type": "string",
              "enum": [
                "cx.moderation.decision",
                "cx.moderation.decision.lift",
                "cx.space.moderate"
              ]
            }
          }
        },
        "required": [
          "actions"
        ]
      },
      "then": {
        "required": [
          "constraints"
        ],
        "properties": {
          "constraints": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "depends_on_moderation_state"
              ],
              "properties": {
                "depends_on_moderation_state": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
