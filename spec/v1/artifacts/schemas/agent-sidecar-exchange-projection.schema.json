{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/agent-sidecar-exchange-projection.schema.json",
  "title": "Arkret Agent Sidecar Exchange Projection",
  "description": "Disposable controller-device-local cache for one source-routed native Sidecar exchange. Every field is a deterministic fold of accepted Sidecar-scoped Events. This object is not wire truth, is not Account Data, is never merged across devices, and may always be deleted and rebuilt.",
  "type": "object",
  "required": [
    "schema",
    "controller_id",
    "sidecar_id",
    "exchange_id",
    "origin",
    "source_track_ref",
    "source_hlc",
    "client_order_key",
    "addressed_agent_ids",
    "completion_policy",
    "coordinator_agent_id",
    "coordinator_assignment_event_id",
    "participating_agent_ids",
    "private_request_event_id",
    "user_facing_response_event_ids",
    "status",
    "folded_frontier"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.agent_sidecar_exchange_projection.v1"
    },
    "controller_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "sidecar_id": {
      "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
    },
    "exchange_id": {
      "$ref": "#/$defs/exchange_id"
    },
    "origin": {
      "const": "source_track_routed"
    },
    "source_track_ref": {
      "$ref": "#/$defs/source_track_ref"
    },
    "source_event_id": {
      "$ref": "#/$defs/event_id",
      "description": "Optional accepted Event id copied from the request context as the source Event for this exchange. This identifies one Event, not a frontier or trust anchor."
    },
    "source_hlc": {
      "$ref": "#/$defs/hlc"
    },
    "client_order_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~=-]{1,128}$"
    },
    "addressed_agent_ids": {
      "type": "array",
      "items": {
        "$ref": "./common-ids.schema.json#/$defs/did_core_id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "completion_policy": {
      "const": "coordinator"
    },
    "coordinator_agent_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "coordinator_assignment_event_id": {
      "$ref": "#/$defs/event_id"
    },
    "participating_agent_ids": {
      "type": "array",
      "items": {
        "$ref": "./common-ids.schema.json#/$defs/did_core_id"
      },
      "uniqueItems": true
    },
    "private_request_event_id": {
      "$ref": "#/$defs/event_id"
    },
    "user_facing_response_event_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_id"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "delivered",
        "responding",
        "complete",
        "failed"
      ]
    },
    "failure_reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "terminal_event_id": {
      "$ref": "#/$defs/event_id",
      "description": "Controller-authored ak.agent.sidecar.exchange.control Event that produced complete or failed."
    },
    "folded_frontier": {
      "$ref": "#/$defs/folded_frontier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure_reason_code",
          "terminal_event_id"
        ],
        "properties": {
          "user_facing_response_event_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "responding",
              "complete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "user_facing_response_event_ids": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "failure_reason_code"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "terminal_event_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "delivered"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "user_facing_response_event_ids": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "failure_reason_code"
              ]
            },
            {
              "required": [
                "terminal_event_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "responding"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "terminal_event_id"
          ]
        }
      }
    }
  ],
  "$defs": {
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "exchange_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~=-]{22,128}$",
      "description": "Opaque controller-private idempotency identity; it is not a Sidecar locator and MUST NOT be copied into shared events."
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "folded_frontier": {
      "type": "object",
      "description": "Local cache coverage. event_ids are the canonical sorted maximal causal heads of all contributing accepted exchange facts. event_set_digest commits to the canonical sorted complete contributing Event-id set. max_hlc is display/cache metadata only and never proves causal dominance.",
      "required": [
        "event_ids",
        "event_set_digest",
        "max_hlc"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "event_set_digest": {
          "$ref": "#/$defs/hash"
        },
        "max_hlc": {
          "$ref": "#/$defs/hlc"
        }
      },
      "additionalProperties": false
    },
    "track_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "source_track_ref": {
      "type": "object",
      "required": [
        "realm_id",
        "strand_id",
        "track_name"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "track_name": {
          "$ref": "#/$defs/track_name"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
