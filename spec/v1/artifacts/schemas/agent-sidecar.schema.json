{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/agent-sidecar.schema.json",
  "title": "Arkret Agent Sidecar",
  "description": "Controller-owned private AI workspace bound one-to-one to (realm_id, controller_id). Agent Sidecar is a first-class native protocol scope, not a Circle profile, backing Circle, or editable membership container. See spec/v1/zh/models/sidecar.md.",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "controller_id",
    "encryption_profile",
    "state",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
    },
    "schema": {
      "const": "ak.schema.agent_sidecar.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "controller_id": {
      "$ref": "./common-ids.schema.json#/$defs/core_id"
    },
    "encryption_profile": {
      "const": "mls_rfc9420",
      "description": "Agent Sidecar is always protected by an independent MLS group; plaintext fallback is invalid."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "tombstoned"
      ]
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "suspended",
              "tombstoned"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "state_changed_at"
        ]
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  },
  "unevaluatedProperties": false
}
