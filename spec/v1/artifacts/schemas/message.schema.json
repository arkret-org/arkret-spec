{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/message.schema.json",
  "title": "Arkret Message",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "strand_id",
    "track_name",
    "state",
    "created_by",
    "created_at"
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "metadata",
          "encrypted_metadata"
        ]
      },
      {
        "required": [
          "content",
          "encrypted_content"
        ]
      },
      {
        "required": [
          "encrypted_payload"
        ],
        "$comment": "forbidden encrypted content carrier; canonical name is encrypted_content"
      },
      {
        "required": [
          "track"
        ],
        "$comment": "forbidden track key; canonical name is track_name"
      },
      {
        "required": [
          "fields"
        ],
        "$comment": "forbidden Message extension metadata; canonical path is metadata.fields or encrypted_metadata"
      }
    ]
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "const": "active"
        }
      },
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "not": {
            "required": [
              "encrypted_content"
            ]
          }
        },
        {
          "required": [
            "encrypted_content"
          ],
          "not": {
            "required": [
              "content"
            ]
          }
        }
      ]
    },
    {
      "properties": {
        "state": {
          "const": "redacted"
        }
      },
      "required": [
        "redaction_ref",
        "state_changed_at"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "encrypted_content"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "For ak.message.create, the reducer derives this value by retyping the UUIDv7 of the creating Event.event_id from ak:event: to ak:message:. It is not independently producer-chosen."
    },
    "schema": {
      "const": "ak.schema.message.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "track_name": {
      "type": "string",
      "const": "discussion",
      "description": "Strand track key for this Message. v1 Message objects are restricted to the Strand discussion track. Profiles that need another timeline kind MUST register a separate object/event profile instead of overloading Message.track_name."
    },
    "effective_scope": {
      "$ref": "#/$defs/effective_scope",
      "description": "Read-only immutable effective scope of this Message, materialized from the accepted Event.scope_ref after the receiver verifies it against the Strand's frozen pre-state (models/circle.md §6.1-§6.2). kind='realm' for Realm-default scope; kind='circle' when the Message's Strand was Circle-scoped at write time. A later Strand scope rebind MUST NOT reinterpret already-written Messages. This field MUST NOT appear in actor-supplied content payload (reason=effective_scope_reducer_managed)."
    },
    "content": {
      "$ref": "#/$defs/content_block"
    },
    "encrypted_content": {
      "allOf": [
        {
          "$ref": "./encrypted-envelope.schema.json"
        },
        {
          "properties": {
            "content_type": {
              "const": "application/vnd.arkret.message+json"
            }
          }
        }
      ],
      "description": "Encrypted envelope whose plaintext is the Message ContentBlock."
    },
    "metadata": {
      "$ref": "#/$defs/message_metadata"
    },
    "encrypted_metadata": {
      "allOf": [
        {
          "$ref": "./encrypted-envelope.schema.json"
        },
        {
          "properties": {
            "content_type": {
              "const": "application/vnd.arkret.message-metadata+json"
            }
          }
        }
      ],
      "description": "Encrypted envelope whose plaintext is a message_metadata object."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "redacted"
      ],
      "description": "Top-level lifecycle state for messages. Messages do not have a separate deleted/tombstone state; retention or moderation removal uses ak.message.redact and state=redacted so the message slot and audit metadata remain stable."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent state transition. MUST be set when state != 'active'; MUST be the created_at of the corresponding ak.message.redact Event. Aligns with the common-fields rule in models/common-fields.md §3."
    },
    "revision_root": {
      "type": "string",
      "pattern": "^ak:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "First revision in this message's edit chain. The first revision MUST have revision_root == id. Maintained by ak.message.revise reducer."
    },
    "edited_at": {
      "$ref": "#/$defs/timestamp"
    },
    "redaction_ref": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Required when state=redacted; references the ak.message.redact event that produced this state. MUST be absent for other states."
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did",
      "description": "Reducer-derived actor that produced the most recent materialized message update, such as ak.message.revise or ak.message.redact."
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "effective_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm"
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "./common-ids.schema.json#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "content_kind": {
      "type": "string",
      "pattern": "^(ak\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "agent_slug": {
      "$ref": "string-profiles.schema.json#/$defs/agent_slug",
      "description": "Controller-scoped native personal agent selector slug used by @<controller-handle>/<agent_slug>. Not a global handle or authorization subject."
    },
    "mention_node": {
      "type": "object",
      "required": [
        "kind",
        "subject_id"
      ],
      "properties": {
        "kind": {
          "const": "mention"
        },
        "subject_id": {
          "$ref": "#/$defs/did",
          "description": "Authoritative mention target principal DID. For native personal agent selectors this is the agent principal DID, not the controller DID."
        },
        "display_name_at_time": {
          "type": "string"
        },
        "handle_at_time": {
          "type": "string"
        },
        "controller_subject_id": {
          "$ref": "#/$defs/did",
          "description": "Audit metadata for @<controller-handle>/<agent_slug> inputs. MUST NOT replace subject_id for routing, authorization, or attribution."
        },
        "controller_handle_at_time": {
          "type": "string"
        },
        "agent_slug_at_time": {
          "$ref": "#/$defs/agent_slug"
        },
        "mention_text_original": {
          "type": "string"
        },
        "resolved_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "content_block": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/content_kind"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        },
        "attachments": {
          "type": "array",
          "maxItems": 32,
          "description": "Profile-defined attachment hints. At most 32; canonical durable attachment relations SHOULD use Relation attached_to.",
          "items": {
            "type": "object"
          }
        },
        "reply_context": {
          "type": "object",
          "properties": {
            "message_ref": {
              "type": "string",
              "pattern": "^ak:(message|event):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sender_actor_id": {
              "$ref": "#/$defs/did"
            },
            "excerpt": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "not": {
            "required": [
              "type"
            ]
          }
        }
      },
      "additionalProperties": true,
      "not": {
        "$comment": "Mirror of event-payload.schema.json $defs.content_block: reject discriminator field `type` (canonical: `kind`), composite child array name `blocks` (canonical: `parts`), and byte-count field `size` (canonical: `size_bytes`). Keeps materialized Message and Event payload schemas in lockstep so that the materialized Message.content cannot smuggle through wire-forbidden field names.",
        "anyOf": [
          {
            "required": [
              "type"
            ]
          },
          {
            "required": [
              "blocks"
            ]
          },
          {
            "required": [
              "size"
            ],
            "$comment": "byte counts use size_bytes"
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ak.content.composite"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "parts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ak.content.long_text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/content_block_long_text"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ak.content.text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "body": {
                "maxLength": 262144,
                "description": "Inline text body. Authoritative bound is 256 KiB UTF-8 bytes enforced by a byte validator; maxLength is a not-wider code-point fast bound. Longer bodies MUST use ak.content.long_text (zh/models/content-types.md section 4.1.4)."
              }
            }
          }
        }
      ]
    },
    "content_block_long_text": {
      "type": "object",
      "description": "ak.content.long_text: plain text whose full normalized UTF-8 body exceeds the 256 KiB inline boundary (or, by the narrow exception in zh/models/content-types.md section 4.1.4, whose Event would otherwise exceed the 1 MiB envelope limit). Exactly one of the plaintext branch (blob_ref + size_bytes + media_type) and the E2EE branch (attachment) applies. v1 core Content Block: no feature gate, no server-side opt-out.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "format",
            "body",
            "body_kind",
            "blob_ref",
            "size_bytes",
            "media_type"
          ],
          "properties": {
            "kind": {
              "const": "ak.content.long_text"
            },
            "format": {
              "type": "string",
              "enum": [
                "plain",
                "markdown"
              ],
              "description": "Closed set for long text. prosemirror_json is forbidden here; structured rich text needs its own Content Block."
            },
            "body": {
              "type": "string",
              "maxLength": 4096,
              "description": "Inline fallback. Authoritative bound is 4096 UTF-8 bytes enforced by a byte validator; maxLength is a not-wider code-point fast bound."
            },
            "body_kind": {
              "type": "string",
              "enum": [
                "prefix",
                "summary"
              ]
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            },
            "blob_ref": {
              "type": "string",
              "pattern": "^ak:blob:(sha256|blake3):[0-9a-f]{64}$",
              "description": "Hash-addressed Blob ref for the full normalized UTF-8 body. UUID blob refs are forbidden here because they carry no digest commitment."
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Normalized full UTF-8 body bytes. The >256 KiB rule and the narrow Event-overflow exception are normative validator rules (zh/models/content-types.md section 4.1.4), not a schema minimum."
            },
            "media_type": {
              "type": "string",
              "enum": [
                "text/plain",
                "text/markdown"
              ],
              "description": "MUST match format. No parameters: charset is fixed to UTF-8 by this kind."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "plain"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "media_type": {
                    "const": "text/plain"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "markdown"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "media_type": {
                    "const": "text/markdown"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind",
            "format",
            "body",
            "body_kind",
            "attachment"
          ],
          "properties": {
            "kind": {
              "const": "ak.content.long_text"
            },
            "format": {
              "type": "string",
              "enum": [
                "plain",
                "markdown"
              ],
              "description": "Closed set for long text. prosemirror_json is forbidden here; structured rich text needs its own Content Block."
            },
            "body": {
              "type": "string",
              "maxLength": 4096,
              "description": "Inline fallback. Authoritative bound is 4096 UTF-8 bytes enforced by a byte validator; maxLength is a not-wider code-point fast bound."
            },
            "body_kind": {
              "type": "string",
              "enum": [
                "prefix",
                "summary"
              ]
            },
            "line_count": {
              "type": "integer",
              "minimum": 0
            },
            "attachment": {
              "$ref": "./blob.schema.json#/$defs/encrypted_attachment",
              "description": "Encrypted full-body Blob descriptor. MUST use scheme ak.blob.stream_aead.v1 with the matching _stream alg; whole-file AEAD is forbidden for long text."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "attachment": {
                  "properties": {
                    "scheme": {
                      "const": "ak.blob.stream_aead.v1"
                    }
                  },
                  "required": [
                    "scheme"
                  ]
                }
              }
            },
            {
              "properties": {
                "attachment": {
                  "required": [
                    "scheme",
                    "nonce_prefix",
                    "segment_bytes",
                    "segment_count",
                    "size_bytes"
                  ],
                  "properties": {
                    "blob_ref": {
                      "type": "string",
                      "pattern": "^ak:blob:(sha256|blake3):[0-9a-f]{64}$",
                      "description": "Long text MUST use a hash-addressed Blob ref; the <suite>:<hex> part MUST equal attachment.ciphertext_digest and the Blob metadata content_digest."
                    },
                    "alg": {
                      "type": "string",
                      "enum": [
                        "mls_exporter_aead_xchacha20poly1305_stream",
                        "mls_exporter_aead_aes_256_gcm_stream"
                      ]
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Normalized full UTF-8 plaintext body bytes; encrypted_attachment.size_bytes is the plaintext count that segment_count = ceil(size_bytes / segment_bytes) is derived from (zh/crypto-media/media-and-blob.md section 3.1 / 3.3.1). The >256 KiB rule and the narrow Event-overflow exception are normative validator rules, not a schema minimum."
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "plain"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "attachment": {
                    "properties": {
                      "media_type": {
                        "const": "text/plain"
                      }
                    },
                    "required": [
                      "media_type"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "format": {
                    "const": "markdown"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "properties": {
                  "attachment": {
                    "properties": {
                      "media_type": {
                        "const": "text/markdown"
                      }
                    },
                    "required": [
                      "media_type"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "message_metadata": {
      "type": "object",
      "description": "Extensible user-readable Message metadata. In MLS / E2EE realms this object is encrypted as encrypted_metadata unless the Realm explicitly opts into plaintext metadata.",
      "properties": {
        "fields": {
          "$ref": "#/$defs/metadata_fields"
        },
        "sidecar_exchange_binding": {
          "$ref": "./agent-sidecar-event-exchange-binding.schema.json",
          "description": "Agent Sidecar exchange binding. Legal only inside encrypted_metadata plaintext of an event whose effective scope is the Sidecar backing Circle; forbidden in plaintext metadata and in shared Realm/Circle events (see forbidden-wire-fields.json and zh/models/sidecar.md §7.2)."
        }
      },
      "not": {
        "$comment": "Reducer-owned fields stay top-level and MUST NOT be mirrored inside metadata.",
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "schema"
            ]
          },
          {
            "required": [
              "realm_id"
            ]
          },
          {
            "required": [
              "strand_id"
            ]
          },
          {
            "required": [
              "track"
            ]
          },
          {
            "required": [
              "track_name"
            ]
          },
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "state_changed_at"
            ]
          },
          {
            "required": [
              "revision_root"
            ]
          },
          {
            "required": [
              "edited_at"
            ]
          },
          {
            "required": [
              "redaction_ref"
            ]
          },
          {
            "required": [
              "created_by"
            ]
          },
          {
            "required": [
              "created_at"
            ]
          },
          {
            "required": [
              "updated_by"
            ]
          },
          {
            "required": [
              "updated_at"
            ]
          },
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "encrypted_content"
            ]
          },
          {
            "required": [
              "encrypted_payload"
            ]
          }
        ]
      },
      "additionalProperties": true
    },
    "metadata_fields": {
      "type": "object",
      "description": "Profile-defined Message metadata fields. Reducer-owned lifecycle and revision fields are forbidden here to avoid dual sources of truth.",
      "not": {
        "anyOf": [
          {
            "required": [
              "revision_root"
            ]
          },
          {
            "required": [
              "visible_state"
            ]
          },
          {
            "required": [
              "redacted"
            ]
          },
          {
            "required": [
              "edited_at"
            ]
          },
          {
            "required": [
              "redaction_ref"
            ]
          },
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "state_changed_at"
            ]
          },
          {
            "required": [
              "track"
            ]
          },
          {
            "required": [
              "track_name"
            ]
          }
        ]
      },
      "additionalProperties": true
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "$comment": "Top-level uses unevaluatedProperties (not additionalProperties) because the top-level oneOf branches contribute evaluated properties; additionalProperties at the top level would not see those and could wrongly reject legitimate oneOf-branch fields (JSON Schema additionalProperties/oneOf pitfall).",
  "unevaluatedProperties": false
}
