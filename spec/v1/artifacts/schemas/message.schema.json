{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/message.schema.json",
  "title": "Contrix Message",
  "type": "object",
  "required": [
    "id",
    "schema",
    "space_id",
    "flow_id",
    "track",
    "state",
    "created_by",
    "created_at"
  ],
  "oneOf": [
    {
      "properties": {
        "state": {
          "const": "active"
        }
      },
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "not": {
            "required": [
              "encrypted_payload"
            ]
          }
        },
        {
          "required": [
            "encrypted_payload"
          ],
          "not": {
            "required": [
              "content"
            ]
          }
        }
      ]
    },
    {
      "properties": {
        "state": {
          "const": "redacted"
        }
      },
      "required": [
        "redaction_ref"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "encrypted_payload"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "state": {
          "const": "deleted"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "encrypted_payload"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:message:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.message.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "track": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Active track name on the target Flow. v1 reducers only recognise 'discussion' for Message timeline; profiles MAY declare additional track names carrying Message timelines but v1 interop SHOULD use 'discussion'."
    },
    "content": {
      "$ref": "#/$defs/content_block"
    },
    "encrypted_payload": {
      "$ref": "./encrypted-envelope.schema.json"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "redacted",
        "deleted"
      ],
      "description": "Top-level lifecycle state, aligned with Flow.state / Place.state. Replaces the legacy fields.visible_state / fields.redacted blackbox shape."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent state transition. MUST be set when state != 'active'; MUST be the created_at of the corresponding cx.message.redact / tombstone Event. Aligns with Place.state_changed_at and the common-fields rule in data-structures.md §3."
    },
    "revision_root": {
      "type": "string",
      "pattern": "^cx:message:[0-9a-hjkmnp-z]{26}$",
      "description": "First revision in this message's edit chain. The first revision MUST have revision_root == id. Maintained by cx.message.revise reducer."
    },
    "edited_at": {
      "$ref": "#/$defs/timestamp"
    },
    "redaction_ref": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$",
      "description": "Required when state=redacted; references the cx.message.redact event that produced this state. MUST be absent for other states."
    },
    "fields": {
      "type": "object",
      "description": "Client metadata, reaction summaries, etc. MUST NOT contain revision_root, visible_state, redacted, edited_at or redaction_ref — those moved to top-level fields in v1.",
      "not": {
        "anyOf": [
          {
            "required": [
              "revision_root"
            ]
          },
          {
            "required": [
              "visible_state"
            ]
          },
          {
            "required": [
              "redacted"
            ]
          },
          {
            "required": [
              "edited_at"
            ]
          },
          {
            "required": [
              "redaction_ref"
            ]
          }
        ]
      }
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "content_kind": {
      "type": "string",
      "pattern": "^(cx\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/content_kind"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        },
        "reply_context": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^cx:(message|event):[0-9a-hjkmnp-z]{26}$"
            },
            "sender": {
              "$ref": "#/$defs/did"
            },
            "excerpt": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
