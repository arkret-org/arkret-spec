{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/message.schema.json",
  "title": "Contrix Message",
  "type": "object",
  "required": [
    "id",
    "schema",
    "realm_id",
    "flow_id",
    "track_name",
    "state",
    "created_by",
    "created_at"
  ],
  "not": {
    "anyOf": [
      { "required": ["metadata", "encrypted_metadata"] },
      { "required": ["content", "encrypted_content"] },
      { "required": ["encrypted_payload"], "$comment": "legacy encrypted content carrier; canonical name is encrypted_content" },
      { "required": ["track"], "$comment": "legacy Flow track key; canonical name is track_name" },
      { "required": ["fields"], "$comment": "legacy Message extension metadata; canonical path is metadata.fields or encrypted_metadata" }
    ]
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "const": "active"
        }
      },
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "not": {
            "required": [
              "encrypted_content"
            ]
          }
        },
        {
          "required": [
            "encrypted_content"
          ],
          "not": {
            "required": [
              "content"
            ]
          }
        }
      ]
    },
    {
      "properties": {
        "state": {
          "const": "redacted"
        }
      },
      "required": [
        "redaction_ref",
        "state_changed_at"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "encrypted_content"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.message.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "track_name": {
      "type": "string",
      "const": "discussion",
      "description": "Flow track key for this Message. v1 Message objects are restricted to the Flow discussion track. Profiles that need another timeline kind MUST register a separate object/event profile instead of overloading Message.track_name."
    },
    "effective_scope": {
      "$ref": "#/$defs/effective_scope",
      "description": "Reducer-stamped immutable effective scope of this Message, materialized from the scope_circle_id effective at create time (models/circle.md §6.1-§6.2). kind='realm' for Realm-default scope; kind='circle' when the message's Flow was Circle-scoped at write time. Immutable: a later Flow scope rebind MUST NOT reinterpret already-written messages — each message retains its write-time effective_scope and old-scope history/key eligibility. MUST NOT appear in actor-supplied submit payload (reducer-managed, reason=effective_scope_reducer_managed); the reducer stamps it on accept."
    },
    "content": {
      "$ref": "#/$defs/content_block"
    },
    "encrypted_content": {
      "$ref": "./encrypted-envelope.schema.json",
      "description": "Encrypted envelope whose plaintext is the Message ContentBlock."
    },
    "metadata": {
      "$ref": "#/$defs/message_metadata"
    },
    "encrypted_metadata": {
      "$ref": "./encrypted-envelope.schema.json",
      "description": "Encrypted envelope whose plaintext is a message_metadata object."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "redacted"
      ],
      "description": "Top-level lifecycle state for messages. Messages do not have a separate deleted/tombstone state; retention or moderation removal uses cx.message.redact and state=redacted so the message slot and audit metadata remain stable."
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent state transition. MUST be set when state != 'active'; MUST be the created_at of the corresponding cx.message.redact Event. Aligns with the common-fields rule in models/common-fields.md §3."
    },
    "revision_root": {
      "type": "string",
      "pattern": "^cx:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "First revision in this message's edit chain. The first revision MUST have revision_root == id. Maintained by cx.message.revise reducer."
    },
    "edited_at": {
      "$ref": "#/$defs/timestamp"
    },
    "redaction_ref": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Required when state=redacted; references the cx.message.redact event that produced this state. MUST be absent for other states."
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did",
      "description": "Reducer-derived actor that produced the most recent materialized message update, such as cx.message.revise or cx.message.redact."
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "effective_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "realm_id"],
          "properties": {
            "kind": { "const": "realm" },
            "realm_id": {
              "type": "string",
              "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "realm_id", "circle_id"],
          "properties": {
            "kind": { "const": "circle" },
            "realm_id": {
              "type": "string",
              "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "circle_id": {
              "type": "string",
              "pattern": "^cx:circle:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "content_kind": {
      "type": "string",
      "pattern": "^(cx\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/content_kind"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        },
        "reply_context": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^cx:(message|event):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sender_actor_id": {
              "$ref": "#/$defs/did"
            },
            "excerpt": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "not": { "required": ["type"] }
        }
      },
      "additionalProperties": true,
      "not": {
        "$comment": "Mirror of event-payload.schema.json $defs.content_block: reject legacy discriminator `type` (canonical: `kind`), legacy composite child array name `blocks` (canonical: `parts`), and byte-count field `size` (canonical: `size_bytes`). Keeps materialized Message and Event payload schemas in lockstep so that the materialized Message.content cannot smuggle through wire-forbidden field names.",
        "anyOf": [
          { "required": ["type"] },
          { "required": ["blocks"] },
          { "required": ["size"], "$comment": "byte counts use size_bytes" }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "cx.content.composite" } },
            "required": ["kind"]
          },
          "then": { "required": ["parts"] }
        }
      ]
    },
    "message_metadata": {
      "type": "object",
      "description": "Extensible user-readable Message metadata. In MLS / E2EE realms this object is encrypted as encrypted_metadata unless the Realm explicitly opts into plaintext metadata.",
      "properties": {
        "fields": {
          "$ref": "#/$defs/metadata_fields"
        }
      },
      "not": {
        "$comment": "Reducer-owned fields stay top-level and MUST NOT be mirrored inside metadata.",
        "anyOf": [
          { "required": ["id"] },
          { "required": ["schema"] },
          { "required": ["realm_id"] },
          { "required": ["flow_id"] },
          { "required": ["track"] },
          { "required": ["track_name"] },
          { "required": ["state"] },
          { "required": ["state_changed_at"] },
          { "required": ["revision_root"] },
          { "required": ["edited_at"] },
          { "required": ["redaction_ref"] },
          { "required": ["created_by"] },
          { "required": ["created_at"] },
          { "required": ["updated_by"] },
          { "required": ["updated_at"] },
          { "required": ["content"] },
          { "required": ["encrypted_content"] },
          { "required": ["encrypted_payload"] }
        ]
      },
      "additionalProperties": true
    },
    "metadata_fields": {
      "type": "object",
      "description": "Profile-defined Message metadata fields. Reducer-owned lifecycle and revision fields are forbidden here to avoid dual sources of truth.",
      "not": {
        "anyOf": [
          { "required": ["revision_root"] },
          { "required": ["visible_state"] },
          { "required": ["redacted"] },
          { "required": ["edited_at"] },
          { "required": ["redaction_ref"] },
          { "required": ["state"] },
          { "required": ["state_changed_at"] },
          { "required": ["track"] },
          { "required": ["track_name"] }
        ]
      },
      "additionalProperties": true
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
