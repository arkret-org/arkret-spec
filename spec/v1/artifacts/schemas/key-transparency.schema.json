{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-transparency.schema.json",
  "x-arkret-conformance-vector": "ak.vector.identity.key_transparency_proofs.v1",
  "title": "Arkret Key Transparency Evidence",
  "description": "Canonical Arkret-specific evidence for ak.profile.key_transparency.v1 and high-security/sovereign log-backed witness requirements. This wire object is not an implementation of IETF KEYTRANS and MUST NOT be advertised as such; interop with draft-ietf-keytrans-protocol-05 requires a separately registered adapter/profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "log_service_id",
    "principal_id",
    "key_material_digest",
    "log_head",
    "inclusion_proof",
    "consistency_proof",
    "witness_signatures"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.key_transparency.v1"
    },
    "log_service_id": {
      "$ref": "#/$defs/did"
    },
    "principal_id": {
      "$ref": "./common-ids.schema.json#/$defs/core_id"
    },
    "key_material_digest": {
      "$ref": "#/$defs/digest"
    },
    "log_head": {
      "$ref": "#/$defs/log_head"
    },
    "inclusion_proof": {
      "$ref": "#/$defs/inclusion_proof"
    },
    "consistency_proof": {
      "$ref": "#/$defs/consistency_proof"
    },
    "witness_signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/witness_signature"
      }
    }
  },
  "$defs": {
    "did": {
      "$ref": "./common-ids.schema.json#/$defs/core_id"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$",
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "log_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_count",
        "tree_root",
        "issued_at"
      ],
      "properties": {
        "leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "tree_root": {
          "$ref": "#/$defs/digest"
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      }
    },
    "inclusion_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_index",
        "leaf_count",
        "audit_path"
      ],
      "properties": {
        "leaf_index": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "audit_path": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "consistency_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_leaf_count",
        "to_leaf_count",
        "audit_path"
      ],
      "properties": {
        "from_leaf_count": {
          "type": "integer",
          "minimum": 0
        },
        "to_leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "audit_path": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "witness_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_did",
        "verification_method",
        "signature"
      ],
      "properties": {
        "witness_did": {
          "$ref": "#/$defs/did"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "signature": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384
        }
      }
    }
  }
}
