{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-read-operations.schema.json",
  "title": "Arkret Realm Read Operation DTOs",
  "description": "Closed response DTOs for the self-surface Realm read operations (ak.self.realm.*). Realm read returns the lifecycle projection and export returns a full event-log + operation dump. See spec/v1/zh/models/realm-and-space.md.",
  "anyOf": [
    {
      "$ref": "#/$defs/realm_lifecycle_view"
    },
    {
      "$ref": "#/$defs/realm_export"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "realm_lifecycle_view": {
      "type": "object",
      "required": [
        "realm_id",
        "owner_id",
        "member_ids",
        "deleted"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "owner_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          },
          "uniqueItems": true
        },
        "deleted": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean",
          "default": false
        },
        "frozen": {
          "type": "boolean",
          "default": false
        },
        "terminal_state": {
          "type": "string",
          "enum": [
            "tombstoned",
            "destroyed"
          ]
        },
        "successor_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        }
      },
      "additionalProperties": false
    },
    "realm_export": {
      "type": "object",
      "required": [
        "schema",
        "realm_id",
        "generated_at",
        "operations",
        "events"
      ],
      "properties": {
        "schema": {
          "const": "ak.export.realm.v1"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Operation dump rows {operation_id, realm_id, object_kind, operation_type, payload, created_at}."
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Event-log dump rows {event_id, realm_id, event_kind, operation_type, operation_id, sender, payload, created_at}."
        }
      },
      "additionalProperties": false
    }
  }
}
