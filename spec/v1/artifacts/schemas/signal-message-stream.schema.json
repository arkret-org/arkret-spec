{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/signal-message-stream.schema.json",
  "title": "Arkret Message Stream Signal Plaintext",
  "description": "Closed decrypted plaintext payload profile for transient Message generation previews carried only inside ak.schema.signal_envelope.v1. It is not a durable Event or Content Block.",
  "oneOf": [
    {
      "$ref": "#/$defs/keyframe"
    },
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/abort"
    }
  ],
  "$defs": {
    "common_properties": {
      "type": "object",
      "required": [
        "kind",
        "payload_sequence",
        "strand_id",
        "message_id",
        "attempt",
        "stream_id",
        "sequence",
        "frame_kind"
      ],
      "properties": {
        "kind": {
          "const": "ak.message.stream",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "signal-message-stream.schema.json#/$defs/common_properties/properties/kind",
            "owner": "signal-message-stream.schema.json#/$defs/common_properties/properties/kind",
            "values": [
              "ak.message.stream"
            ]
          }
        },
        "payload_sequence": {
          "description": "Strictly increasing but non-contiguous sequence within (sender_actor_id, sender_device_id, canonical scope_ref), including the complete ActorId. It is independent of the per-stream seq and participates in generic Signal replay handling.",
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "message_id": {
          "$ref": "#/$defs/message_id",
          "description": "Predeclared final Message identity, derived by retyping the complete 33-octet token of the planned ak.message.create Event.event_id."
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stream_id": {
          "type": "string",
          "pattern": "^ak:message_stream:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "frame_kind": {
          "enum": [
            "keyframe",
            "delta",
            "abort"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signal-message-stream.schema.json#/$defs/common_properties/properties/frame_kind",
            "owner": "signal-message-stream.schema.json#/$defs/common_properties/properties/frame_kind",
            "values": [
              "keyframe",
              "delta",
              "abort"
            ]
          }
        }
      }
    },
    "preview_text": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$",
      "description": "Authoritative limit is 16 KiB of valid UTF-8, enforced after decryption by a byte validator. maxLength is a not-wider code-point fast bound. LF, CR and TAB are allowed; other C0 controls and DEL are forbidden."
    },
    "message_id": {
      "$ref": "./agent-operations.schema.json#/$defs/message_id"
    },
    "strand_id": {
      "$ref": "./agent-operations.schema.json#/$defs/strand_id"
    },
    "keyframe": {
      "allOf": [
        {
          "$ref": "#/$defs/common_properties"
        },
        {
          "type": "object",
          "required": [
            "format",
            "text",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "ak.message.stream",
              "x-arkret-value-ownership": {
                "class": "namespaced_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/keyframe/allOf/1/properties/kind",
                "owner": "signal-message-stream.schema.json#/$defs/keyframe/allOf/1/properties/kind",
                "values": [
                  "ak.message.stream"
                ]
              }
            },
            "payload_sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            },
            "message_id": {
              "$ref": "#/$defs/message_id"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "stream_id": {
              "type": "string",
              "pattern": "^ak:message_stream:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
            },
            "frame_kind": {
              "const": "keyframe",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/keyframe/allOf/1/properties/frame_kind",
                "owner": "signal-message-stream.schema.json#/$defs/keyframe/allOf/1/properties/frame_kind",
                "values": [
                  "keyframe"
                ]
              }
            },
            "format": {
              "enum": [
                "plain",
                "markdown"
              ],
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/keyframe/allOf/1/properties/format",
                "owner": "signal-message-stream.schema.json#/$defs/keyframe/allOf/1/properties/format",
                "values": [
                  "plain",
                  "markdown"
                ]
              }
            },
            "text": {
              "$ref": "#/$defs/preview_text"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "delta": {
      "allOf": [
        {
          "$ref": "#/$defs/common_properties"
        },
        {
          "type": "object",
          "required": [
            "base_sequence",
            "text_append"
          ],
          "properties": {
            "kind": {
              "const": "ak.message.stream",
              "x-arkret-value-ownership": {
                "class": "namespaced_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/delta/allOf/1/properties/kind",
                "owner": "signal-message-stream.schema.json#/$defs/delta/allOf/1/properties/kind",
                "values": [
                  "ak.message.stream"
                ]
              }
            },
            "payload_sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            },
            "message_id": {
              "$ref": "#/$defs/message_id"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "stream_id": {
              "type": "string",
              "pattern": "^ak:message_stream:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
              "not": {
                "enum": [
                  "0"
                ],
                "x-arkret-value-ownership": {
                  "class": "decimal_text",
                  "authority": "signal-message-stream.schema.json#/$defs/delta/allOf/1/properties/sequence/not",
                  "owner": "signal-message-stream.schema.json#/$defs/delta/allOf/1/properties/sequence/not",
                  "values": [
                    "0"
                  ]
                }
              }
            },
            "frame_kind": {
              "const": "delta",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/delta/allOf/1/properties/frame_kind",
                "owner": "signal-message-stream.schema.json#/$defs/delta/allOf/1/properties/frame_kind",
                "values": [
                  "delta"
                ]
              }
            },
            "base_sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
            },
            "text_append": {
              "allOf": [
                {
                  "$ref": "#/$defs/preview_text"
                },
                {
                  "minLength": 1
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "abort": {
      "allOf": [
        {
          "$ref": "#/$defs/common_properties"
        },
        {
          "type": "object",
          "required": [
            "reason_code"
          ],
          "properties": {
            "kind": {
              "const": "ak.message.stream",
              "x-arkret-value-ownership": {
                "class": "namespaced_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/kind",
                "owner": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/kind",
                "values": [
                  "ak.message.stream"
                ]
              }
            },
            "payload_sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            },
            "message_id": {
              "$ref": "#/$defs/message_id"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "stream_id": {
              "type": "string",
              "pattern": "^ak:message_stream:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sequence": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
              "not": {
                "enum": [
                  "0"
                ],
                "x-arkret-value-ownership": {
                  "class": "decimal_text",
                  "authority": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/sequence/not",
                  "owner": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/sequence/not",
                  "values": [
                    "0"
                  ]
                }
              }
            },
            "frame_kind": {
              "const": "abort",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/frame_kind",
                "owner": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/frame_kind",
                "values": [
                  "abort"
                ]
              }
            },
            "reason_code": {
              "enum": [
                "generation_cancelled",
                "generation_failed",
                "superseded"
              ],
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/reason_code",
                "owner": "signal-message-stream.schema.json#/$defs/abort/allOf/1/properties/reason_code",
                "values": [
                  "generation_cancelled",
                  "generation_failed",
                  "superseded"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
