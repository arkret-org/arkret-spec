{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/control-proposal-decision.schema.json",
  "title": "Arkret Control Proposal Receipt and Decision",
  "description": "Quorum-capable proposal-ingress receipt sets and signed reject/defer decisions for CBA Control Moves. Deadlines provide bounded authority decisions, never acceptance or Seal finality.",
  "oneOf": [
    {
      "$ref": "#/$defs/proposal_receipt"
    },
    {
      "$ref": "#/$defs/proposal_decision"
    }
  ],
  "$defs": {
    "proposal_receipt": {
      "type": "object",
      "required": [
        "kind",
        "realm_id",
        "proposal_digest",
        "received_at",
        "decision_due_at",
        "absolute_due_at",
        "defer_count",
        "authority_set_ref",
        "member_receipts"
      ],
      "properties": {
        "kind": {
          "const": "proposal_receipt"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/hash"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "decision_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "absolute_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "defer_count": {
          "const": 0
        },
        "authority_set_ref": {
          "$ref": "#/$defs/hash"
        },
        "member_receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proposal_member_receipt"
          },
          "description": "Canonical ascending verification_method order. Distinct valid members, not array length, determine quorum."
        }
      },
      "additionalProperties": false
    },
    "proposal_member_receipt": {
      "type": "object",
      "required": [
        "realm_id",
        "proposal_digest",
        "received_at",
        "decision_due_at",
        "absolute_due_at",
        "authority_set_ref",
        "signature"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/hash"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "decision_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "absolute_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "authority_set_ref": {
          "$ref": "#/$defs/hash"
        },
        "signature": {
          "$ref": "#/$defs/proof"
        }
      },
      "additionalProperties": false
    },
    "proposal_decision": {
      "type": "object",
      "required": [
        "kind",
        "realm_id",
        "proposal_digest",
        "receipt_digest",
        "decided_at",
        "decision_due_at",
        "absolute_due_at",
        "defer_count",
        "reason_code",
        "authority_set_ref",
        "proofs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "signed_reject",
            "signed_defer"
          ]
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/hash"
        },
        "receipt_digest": {
          "$ref": "#/$defs/hash"
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "decision_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "absolute_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "defer_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "authority_set_ref": {
          "$ref": "#/$defs/hash"
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proof"
          },
          "description": "Canonical ascending verification_method order. Every proof signs the same decision payload and the set independently satisfies the receipt authority quorum."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "signed_reject"
              }
            }
          },
          "then": {
            "properties": {
              "defer_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "reason_code": {
                "enum": [
                  "capability_denied",
                  "cas_conflict",
                  "policy_denied",
                  "schema_violation",
                  "superseded"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "signed_defer"
              }
            }
          },
          "then": {
            "properties": {
              "defer_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "reason_code": {
                "enum": [
                  "dependency_missing",
                  "quorum_unreachable",
                  "temporarily_unavailable"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "signed_defer": {
      "allOf": [
        {
          "$ref": "#/$defs/proposal_decision"
        },
        {
          "properties": {
            "kind": {
              "const": "signed_defer"
            }
          }
        }
      ]
    },
    "proposal_receipt_issue_request": {
      "type": "object",
      "description": "Typed authority input used by a local signer or the registered HTTP operation to issue one immutable member receipt.",
      "required": [
        "event",
        "authorization_lease"
      ],
      "properties": {
        "event": {
          "$ref": "./event-envelope.schema.json"
        },
        "authorization_lease": {
          "$ref": "./offline-publication.schema.json#/$defs/authorization_lease"
        },
        "cba_proof_bundles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./cba-proof-bundle.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "proposal_receipt_issue_outcome": {
      "type": "object",
      "required": [
        "member_receipt"
      ],
      "properties": {
        "member_receipt": {
          "$ref": "#/$defs/proposal_member_receipt"
        }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "proof": {
      "type": "object",
      "required": [
        "verification_method",
        "payload_digest",
        "created_at",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "payload_digest": {
          "$ref": "#/$defs/hash"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.(?:[A-Za-z0-9_-]+)?\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
