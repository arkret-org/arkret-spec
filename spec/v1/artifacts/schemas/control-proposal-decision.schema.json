{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/control-proposal-decision.schema.json",
  "title": "Arkret Control Proposal Ack and Decision",
  "description": "Single-authority Control Proposal Ack and durable signed reject/defer decisions. Deadlines bound authority decisions; they do not promise command acceptance.",
  "oneOf": [
    {
      "$ref": "#/$defs/control_proposal_ack"
    },
    {
      "$ref": "#/$defs/proposal_decision"
    }
  ],
  "$defs": {
    "control_proposal_ack": {
      "type": "object",
      "required": [
        "kind",
        "realm_id",
        "proposal_digest",
        "received_at",
        "decision_due_at",
        "absolute_due_at",
        "defer_count",
        "authority_set_ref",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "signed_ack"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "decision_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "absolute_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "defer_count": {
          "const": 0
        },
        "authority_set_ref": {
          "$ref": "#/$defs/digest"
        },
        "signature": {
          "$ref": "#/$defs/proof"
        }
      },
      "additionalProperties": false
    },
    "proposal_decision": {
      "type": "object",
      "required": [
        "kind",
        "realm_id",
        "proposal_digest",
        "proposal_ack_digest",
        "decided_at",
        "decision_due_at",
        "absolute_due_at",
        "defer_count",
        "reason_code",
        "authority_set_ref",
        "proof"
      ],
      "properties": {
        "kind": {
          "enum": [
            "signed_reject",
            "signed_defer"
          ]
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "proposal_ack_digest": {
          "$ref": "#/$defs/digest"
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "decision_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "absolute_due_at": {
          "$ref": "#/$defs/timestamp"
        },
        "defer_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "authority_set_ref": {
          "$ref": "#/$defs/digest"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "signed_reject"
              }
            }
          },
          "then": {
            "properties": {
              "defer_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "reason_code": {
                "enum": [
                  "capability_denied",
                  "cas_conflict",
                  "policy_denied",
                  "schema_violation",
                  "superseded"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "signed_defer"
              }
            }
          },
          "then": {
            "properties": {
              "defer_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "reason_code": {
                "enum": [
                  "dependency_missing",
                  "temporarily_unavailable"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "signed_defer": {
      "allOf": [
        {
          "$ref": "#/$defs/proposal_decision"
        },
        {
          "properties": {
            "kind": {
              "const": "signed_defer"
            }
          }
        }
      ]
    },
    "signed_reject": {
      "allOf": [
        {
          "$ref": "#/$defs/proposal_decision"
        },
        {
          "properties": {
            "kind": {
              "const": "signed_reject"
            }
          }
        }
      ]
    },
    "control_proposal_ack_issue_request": {
      "type": "object",
      "description": "Typed authority input used by a local signer or the registered HTTP operation to issue one immutable authority Ack. Online intake has no lease; delayed intake requires and independently validates one. The explicit mode prevents an invalid delayed request from being silently downgraded to online.",
      "required": [
        "event",
        "publication_mode"
      ],
      "properties": {
        "event": {
          "$ref": "./event-envelope.schema.json"
        },
        "publication_mode": {
          "enum": [
            "online",
            "delayed"
          ]
        },
        "authorization_lease": {
          "$ref": "./offline-publication.schema.json#/$defs/authorization_lease"
        },
        "cbs_proof_bundles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./cbs-proof-bundle.schema.json"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_mode": {
                "const": "delayed"
              }
            },
            "required": [
              "publication_mode"
            ]
          },
          "then": {
            "required": [
              "authorization_lease"
            ]
          },
          "else": {
            "not": {
              "required": [
                "authorization_lease"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "control_proposal_ack_issue_outcome": {
      "type": "object",
      "required": [
        "authority_ack"
      ],
      "properties": {
        "authority_ack": {
          "$ref": "#/$defs/control_proposal_ack"
        }
      },
      "additionalProperties": false
    },
    "control_proposal_decision_submit_request_body": {
      "type": "object",
      "description": "Standard authenticated carrier for a complete signed defer or signed reject. The receiver resolves the durable proposal and its canonical Ack before accepting any decision; request data cannot create or replace those facts.",
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/proposal_decision"
        }
      },
      "additionalProperties": false
    },
    "control_proposal_decision_submit_outcome": {
      "type": "object",
      "required": [
        "status",
        "proposal_digest",
        "decision_digest",
        "decision_kind",
        "proposal_state"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision_kind": {
          "enum": [
            "signed_defer",
            "signed_reject"
          ]
        },
        "proposal_state": {
          "enum": [
            "deferred",
            "rejected"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_kind": {
                "const": "signed_defer"
              }
            },
            "required": [
              "decision_kind"
            ]
          },
          "then": {
            "properties": {
              "proposal_state": {
                "const": "deferred"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_kind": {
                "const": "signed_reject"
              }
            },
            "required": [
              "decision_kind"
            ]
          },
          "then": {
            "properties": {
              "proposal_state": {
                "const": "rejected"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "control_proposal_decision_read_request_body": {
      "type": "object",
      "required": [
        "realm_id",
        "proposal_digest"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "control_proposal_decision_read_outcome": {
      "type": "object",
      "description": "Authenticated observation of the durable proposal/Ack/decision/Seal state. This is a read projection; it cannot synthesize an Ack or clear a pending proposal.",
      "required": [
        "realm_id",
        "proposal_digest",
        "proposal_event_kind",
        "proposal_authority_kind",
        "proposal_state"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "proposal_event_kind": {
          "type": "string",
          "pattern": "^ak\\.[a-z0-9_.-]+$"
        },
        "proposal_authority_kind": {
          "enum": [
            "control_proposal_ack",
            "ackless_event_proof"
          ],
          "description": "Discriminates ordinary Ack-governed proposals from the narrow authority-authored self-principal PCR Ack-less exception. ak.device.revoke is always control_proposal_ack."
        },
        "proposal_state": {
          "enum": [
            "pending",
            "deferred",
            "overdue",
            "rejected",
            "sealed"
          ]
        },
        "control_proposal_ack": {
          "$ref": "#/$defs/control_proposal_ack"
        },
        "defer_decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/signed_defer"
          }
        },
        "terminal_reject": {
          "$ref": "#/$defs/signed_reject"
        },
        "fault_reason": {
          "const": "control_proposal_decision_overdue"
        },
        "accepted_seal_id": {
          "$ref": "./seal.schema.json#/$defs/seal_ref",
          "description": "The unique confirmed non-quarantined Seal whose command_results contains this proposal. An Event belongs to at most one command result in the confirmed history, so multiple direct covering Seals are invalid. This is an acceptance observation, not the current confirmed head or an authoring seal_basis."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proposal_state": {
                "const": "pending"
              }
            },
            "required": [
              "proposal_state"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "defer_decisions"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "terminal_reject"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "fault_reason"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "accepted_seal_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_state": {
                "const": "deferred"
              }
            },
            "required": [
              "proposal_state"
            ]
          },
          "then": {
            "required": [
              "defer_decisions"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "terminal_reject"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "fault_reason"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "accepted_seal_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_state": {
                "const": "overdue"
              }
            },
            "required": [
              "proposal_state"
            ]
          },
          "then": {
            "required": [
              "fault_reason"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "terminal_reject"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "accepted_seal_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_state": {
                "const": "rejected"
              }
            },
            "required": [
              "proposal_state"
            ]
          },
          "then": {
            "required": [
              "terminal_reject"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "fault_reason"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "accepted_seal_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_state": {
                "const": "sealed"
              }
            },
            "required": [
              "proposal_state"
            ]
          },
          "then": {
            "required": [
              "accepted_seal_id"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "terminal_reject"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "fault_reason"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_authority_kind": {
                "const": "control_proposal_ack"
              }
            },
            "required": [
              "proposal_authority_kind"
            ]
          },
          "then": {
            "required": [
              "control_proposal_ack"
            ]
          },
          "else": {
            "properties": {
              "proposal_state": {
                "enum": [
                  "pending",
                  "sealed"
                ]
              }
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "control_proposal_ack"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "defer_decisions"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "terminal_reject"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_event_kind": {
                "const": "ak.device.revoke"
              }
            },
            "required": [
              "proposal_event_kind"
            ]
          },
          "then": {
            "properties": {
              "proposal_authority_kind": {
                "const": "control_proposal_ack"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "proof": {
      "type": "object",
      "required": [
        "verification_method",
        "payload_digest",
        "created_at",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.(?:[A-Za-z0-9_-]+)?\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
