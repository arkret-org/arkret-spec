{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/calendar-event.schema.json",
  "title": "Arkret Calendar Event Profile Fields",
  "type": "object",
  "required": [
    "start",
    "end",
    "timezone",
    "all_day"
  ],
  "properties": {
    "start": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "end": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA time zone name."
    },
    "all_day": {
      "type": "boolean"
    },
    "recurrence": {
      "$ref": "#/$defs/recurrence"
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/$defs/calendar_location"
        },
        {
          "$ref": "./encrypted-envelope.schema.json"
        }
      ]
    },
    "call_id": {
      "type": "string",
      "pattern": "^ak:call:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attendees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attendee"
      },
      "uniqueItems": true,
      "maxItems": 1000
    }
  },
  "additionalProperties": false,
  "$defs": {
    "recurrence": {
      "type": "object",
      "required": [
        "frequency"
      ],
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "interval": {
          "type": "integer",
          "minimum": 1
        },
        "by_day": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/n_day"
          },
          "uniqueItems": true
        },
        "by_month": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?:[1-9]|1[0-2])$"
          },
          "uniqueItems": true
        },
        "by_month_day": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": -31,
            "maximum": 31,
            "not": { "const": 0 }
          },
          "uniqueItems": true
        },
        "by_set_position": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": -366,
            "maximum": 366,
            "not": { "const": 0 }
          },
          "uniqueItems": true
        },
        "first_day_of_week": {
          "$ref": "#/$defs/week_day"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?$",
          "description": "RFC 8984 LocalDateTime interpreted in the calendar event timezone; no UTC offset or Z suffix is allowed."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "count",
              "until"
            ]
          }
        }
      ]
    },
    "week_day": {
      "type": "string",
      "enum": ["mo", "tu", "we", "th", "fr", "sa", "su"]
    },
    "n_day": {
      "type": "object",
      "required": ["day"],
      "properties": {
        "day": { "$ref": "#/$defs/week_day" },
        "nth_of_period": {
          "type": "integer",
          "minimum": -366,
          "maximum": 366,
          "not": { "const": 0 }
        }
      },
      "additionalProperties": false
    },
    "calendar_location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "geo_uri": {
          "type": "string",
          "pattern": "^geo:"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "attendee": {
      "type": "object",
      "required": [
        "actor_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "organizer"
          ]
        },
        "display_name_snapshot": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
