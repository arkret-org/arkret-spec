{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/snapshot.schema.json",
  "title": "Contrix Snapshot Manifest",
  "type": "object",
  "required": [
    "snapshot_ref",
    "space_id",
    "reducer_profile",
    "schema_profile_refs",
    "state_hash",
    "frontier",
    "event_set_commitment",
    "chunks",
    "signature"
  ],
  "properties": {
    "snapshot_ref": {
      "type": "string",
      "pattern": "^cx:snapshot:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reducer_profile": {
      "type": "string",
      "pattern": "^cx\\.reducer(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
    },
    "security_class": {
      "type": "string",
      "enum": [
        "standard",
        "high_assurance"
      ],
      "default": "standard",
      "description": "Snapshot verification class. high_assurance requires verification_hints with inclusion challenge and non-accepted-input digests."
    },
    "schema_profile_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "state_hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "frontier": {
      "type": "object",
      "required": [
        "event_ids",
        "timeline_hlc"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "timeline_hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "additionalProperties": true
    },
    "event_set_commitment": {
      "type": "object",
      "required": [
        "algorithm",
        "root",
        "covered_event_count"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "ordered_event_id_sha256_v1",
            "merkle_event_set_v1"
          ]
        },
        "root": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "covered_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_frontier": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "actor_seq_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actor_id",
              "from_seq",
              "to_seq",
              "root"
            ],
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
              },
              "from_seq": {
                "type": "integer",
                "minimum": 0
              },
              "to_seq": {
                "type": "integer",
                "minimum": 0
              },
              "root": {
                "type": "string",
                "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verification_hints": {
      "type": "object",
      "required": [
        "verification_profile"
      ],
      "properties": {
        "verification_profile": {
          "type": "string",
          "enum": [
            "standard",
            "high_assurance"
          ]
        },
        "inclusion_proof_url": {
          "type": "string"
        },
        "challenge_window_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "witness_quorum": {
          "type": "integer",
          "minimum": 0
        },
        "conflict_records_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "soft_failed_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "quarantined_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        }
      },
      "additionalProperties": true
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_ref",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "chunk_ref": {
            "type": "string",
            "pattern": "^cx:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "signature": {
      "$ref": "./event-schema.json#/$defs/proof"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "security_class": { "const": "high_assurance" } },
        "required": ["security_class"]
      },
      "then": {
        "required": ["verification_hints"],
        "properties": {
          "verification_hints": {
            "required": [
              "verification_profile",
              "inclusion_proof_url",
              "challenge_window_seconds",
              "witness_quorum",
              "conflict_records_digest",
              "soft_failed_digest",
              "quarantined_digest"
            ],
            "properties": {
              "verification_profile": { "const": "high_assurance" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
