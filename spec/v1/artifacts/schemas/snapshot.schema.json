{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/snapshot.schema.json",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "title": "Cokret Snapshot Manifest",
  "type": "object",
  "required": [
    "id",
    "realm_id",
    "reducer_profile",
    "schema_profile_refs",
    "state_digest",
    "frontier",
    "event_set_commitment",
    "chunks",
    "security_class",
    "created_by",
    "created_at",
    "authority_binding",
    "signature"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ck:snapshot:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "reducer_profile": {
      "type": "string",
      "pattern": "^ck\\.reducer(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
    },
    "security_class": {
      "type": "string",
      "enum": [
        "standard",
        "high_assurance"
      ],
      "default": "standard",
      "description": "Snapshot verification class. high_assurance requires verification_hints with inclusion challenge and non-accepted-input digests."
    },
    "schema_profile_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ck\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "state_digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$",
      "description": "Hash of the canonical reducer-derived state at the snapshot frontier (Lattice cell values keyed by cell_family/cell_subject, plus reducer_profile / schema_profile_refs). This binds *what the state is*. Paired with event_set_commitment which binds *which events produced it*: a verifier replays the events covered by event_set_commitment under reducer_profile and MUST obtain the same state_digest. The two digests are independent and BOTH required — state_digest alone cannot detect missing-event tampering, event_set_commitment alone cannot detect reducer divergence."
    },
    "frontier": {
      "type": "object",
      "required": [
        "event_ids",
        "timeline_hlc"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "timeline_hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "additionalProperties": true
    },
    "event_set_commitment": {
      "type": "object",
      "description": "Commitment to the *set of events* whose replay produces state_digest. Algorithm + root + covered_event_count name the canonical reduction of those events; covered_seals / actor_seq_ranges narrow which event ids and per-actor sequences are bound. Paired with state_digest (see state_digest description): both fields are independently required because state_digest binds reducer output and event_set_commitment binds reducer input.",
      "required": [
        "algorithm",
        "root",
        "covered_event_count"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "ordered_event_id_sha256_v1",
            "merkle_event_set_v1"
          ]
        },
        "root": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        },
        "covered_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_seals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "description": "When present, MUST denote the same event id set as the top-level frontier.event_ids (set equality): both bind the same snapshot frontier. Consumers MUST reject the snapshot on any mismatch (cross-field consistency enforced by snapshot-schema.md section 5, not by JSON Schema)."
        },
        "actor_seq_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actor_id",
              "from_seq",
              "to_seq",
              "root"
            ],
            "properties": {
              "actor_id": {
                "$ref": "./common-ids.schema.json#/$defs/did"
              },
              "from_seq": {
                "type": "integer",
                "minimum": 0
              },
              "to_seq": {
                "type": "integer",
                "minimum": 0
              },
              "root": {
                "type": "string",
                "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verification_hints": {
      "type": "object",
      "required": [
        "verification_profile"
      ],
      "properties": {
        "verification_profile": {
          "type": "string",
          "enum": [
            "standard",
            "high_assurance"
          ]
        },
        "inclusion_proof_url": {
          "type": "string"
        },
        "challenge_window_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "witness_quorum": {
          "type": "integer",
          "minimum": 0
        },
        "conflict_records_digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        },
        "soft_failed_digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        },
        "quarantined_digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_ref",
          "digest",
          "size_bytes"
        ],
        "properties": {
          "chunk_ref": {
            "type": "string",
            "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
          },
          "digest": {
            "type": "string",
            "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$",
      "description": "DID of the snapshot issuer (server / Realm notary / federation witness). Required because the snapshot signature transcript binds this field via x-canonical-bytes-include."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Issuer-local timestamp when the snapshot manifest was sealed. RFC 3339 UTC, MUST end with 'Z'. Required because the snapshot signature transcript binds this field via x-canonical-bytes-include."
    },
    "authority_binding": {
      "type": "object",
      "description": "Evidence that created_by was authorized to seal this snapshot at created_at. Verifiers MUST reject the snapshot when this binding cannot be checked against Realm policy / witness quorum at or before created_at.",
      "required": [
        "issuer",
        "authority_kind",
        "auth_state_digest",
        "auth_frontier",
        "checked_at"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+$",
          "description": "MUST equal top-level created_by. Aligns with the canonical 'issuer' DID field used by audit-ryw-receipt, range-completeness-attestation, capability-grant, etc. (see common-fields.md §4.2)."
        },
        "authority_kind": {
          "type": "string",
          "enum": [
            "realm_owner",
            "realm_policy_snapshot_issuer",
            "witness_quorum"
          ]
        },
        "auth_state_digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$",
          "description": "Hash of the authorization state used to verify snapshot issuer authority."
        },
        "auth_frontier": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Realm auth/policy frontier proving the signer authority at created_at."
        },
        "checked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "witness_attestations": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json#/$defs/proof"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "$ref": "./event-envelope.schema.json#/$defs/proof",
      "description": "Detached proof over the JCS canonical snapshot manifest bytes with only the signature field omitted. The signed transcript therefore binds id, realm_id, reducer_profile, schema_profile_refs, state_digest, frontier, event_set_commitment, chunks (chunk_ref / digest / size_bytes), security_class, verification_hints, created_by, created_at, and authority_binding. Because security_class is signed (and required), a high_assurance -> standard downgrade cannot be performed without invalidating the signature.",
      "x-canonical-bytes-include": [
        "id",
        "realm_id",
        "reducer_profile",
        "schema_profile_refs",
        "state_digest",
        "frontier",
        "event_set_commitment",
        "chunks",
        "security_class",
        "verification_hints",
        "created_by",
        "created_at",
        "authority_binding"
      ],
      "x-canonical-bytes-exclude": [
        "signature"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "security_class": {
            "const": "high_assurance"
          }
        },
        "required": [
          "security_class"
        ]
      },
      "then": {
        "required": [
          "verification_hints"
        ],
        "properties": {
          "verification_hints": {
            "required": [
              "verification_profile",
              "inclusion_proof_url",
              "challenge_window_seconds",
              "witness_quorum",
              "conflict_records_digest",
              "soft_failed_digest",
              "quarantined_digest"
            ],
            "properties": {
              "verification_profile": {
                "const": "high_assurance"
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
