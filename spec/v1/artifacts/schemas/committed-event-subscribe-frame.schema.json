{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/committed-event-subscribe-frame.schema.json",
  "title": "CommittedEventSubscribeFrame",
  "description": "Closed frame union emitted by ak.self.committed_event.stream.subscribe.v1 over NDJSON or an Arkret WebSocket channel.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "committed_event",
        "checkpoint",
        "heartbeat",
        "catchup_complete",
        "epoch_rotation",
        "dropped",
        "resync_required",
        "unauthorized",
        "quarantined"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "committed-event-subscribe-frame.schema.json#/properties/kind",
        "owner": "committed-event-subscribe-frame.schema.json#/properties/kind",
        "values": [
          "committed_event",
          "checkpoint",
          "heartbeat",
          "catchup_complete",
          "epoch_rotation",
          "dropped",
          "resync_required",
          "unauthorized",
          "quarantined"
        ]
      }
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "cursor": {
      "type": "string",
      "pattern": "^ak:cursor:[A-Za-z0-9_-]{1,2028}$",
      "maxLength": 2048
    },
    "payload": {
      "type": "object"
    },
    "reconnect_after_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "committed_event",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/0/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/0/properties/kind",
            "values": [
              "committed_event"
            ]
          }
        },
        "payload": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/CommittedEventView"
        }
      },
      "required": [
        "kind",
        "payload",
        "realm_id",
        "cursor"
      ],
      "not": {
        "required": [
          "reconnect_after_ms"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "epoch_rotation",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/1/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/1/properties/kind",
            "values": [
              "epoch_rotation"
            ]
          }
        },
        "payload": {
          "$ref": "#/$defs/epoch_rotation_payload"
        }
      },
      "required": [
        "kind",
        "payload",
        "realm_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cursor"
            ]
          },
          {
            "required": [
              "reconnect_after_ms"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "enum": [
            "checkpoint",
            "catchup_complete"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/2/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/2/properties/kind",
            "values": [
              "checkpoint",
              "catchup_complete"
            ]
          }
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "reconnect_after_ms"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "dropped",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/3/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/3/properties/kind",
            "values": [
              "dropped"
            ]
          }
        }
      },
      "required": [
        "kind",
        "realm_id",
        "cursor"
      ],
      "not": {
        "required": [
          "payload"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "resync_required",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/4/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/4/properties/kind",
            "values": [
              "resync_required"
            ]
          }
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cursor"
            ]
          },
          {
            "required": [
              "payload"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "unauthorized",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/5/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/5/properties/kind",
            "values": [
              "unauthorized"
            ]
          }
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cursor"
            ]
          },
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "reconnect_after_ms"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "heartbeat",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/6/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/6/properties/kind",
            "values": [
              "heartbeat"
            ]
          }
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "realm_id"
            ]
          },
          {
            "required": [
              "cursor"
            ]
          },
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "reconnect_after_ms"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "quarantined",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "committed-event-subscribe-frame.schema.json#/oneOf/7/properties/kind",
            "owner": "committed-event-subscribe-frame.schema.json#/oneOf/7/properties/kind",
            "values": [
              "quarantined"
            ]
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "realm_id",
            "error_code",
            "affected_stream_refs"
          ],
          "properties": {
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "error_code": {
              "const": "witness_disagreement",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "committed-event-subscribe-frame.schema.json#/oneOf/7/properties/payload/properties/error_code",
                "owner": "committed-event-subscribe-frame.schema.json#/oneOf/7/properties/payload/properties/error_code",
                "values": [
                  "witness_disagreement"
                ]
              }
            },
            "affected_stream_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "./realm-commit.schema.json#/$defs/stream_ref"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cursor"
            ]
          },
          {
            "required": [
              "reconnect_after_ms"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "epoch_rotation_payload": {
      "type": "object",
      "required": [
        "new_epoch"
      ],
      "properties": {
        "new_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    }
  }
}
