{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/mimi-operations.schema.json",
  "title": "Arkret MIMI Operation DTOs",
  "description": "Closed request/response DTOs for MIMI provider interop. Key-material uses the existing keypackage-operations claim request and command outcome directly, as registered by operation-registry.",
  "anyOf": [
    {
      "$ref": "#/$defs/mimi_room_update_request_body"
    },
    {
      "$ref": "#/$defs/mimi_room_update_response_body"
    },
    {
      "$ref": "#/$defs/mimi_notify_request_body"
    },
    {
      "$ref": "#/$defs/mimi_notify_response_body"
    },
    {
      "$ref": "#/$defs/mimi_submit_message_request_body"
    },
    {
      "$ref": "#/$defs/mimi_submit_message_response_body"
    },
    {
      "$ref": "#/$defs/mimi_request_consent_request_body"
    },
    {
      "$ref": "#/$defs/mimi_request_consent_response_body"
    },
    {
      "$ref": "#/$defs/mimi_update_consent_request_body"
    },
    {
      "$ref": "#/$defs/mimi_update_consent_response_body"
    },
    {
      "$ref": "#/$defs/mimi_identifier_query_request_body"
    },
    {
      "$ref": "#/$defs/mimi_identifier_query_response_body"
    },
    {
      "$ref": "#/$defs/mimi_report_abuse_request_body"
    },
    {
      "$ref": "#/$defs/mimi_report_abuse_response_body"
    },
    {
      "$ref": "#/$defs/mimi_proxy_download_request_body"
    },
    {
      "$ref": "#/$defs/mimi_proxy_download_response_body"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "strand_id": {
      "$ref": "./agent-operations.schema.json#/$defs/strand_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "report_id": {
      "type": "string",
      "pattern": "^ak:report:[A-Za-z0-9_-]{44}$"
    },
    "consent_id": {
      "type": "string",
      "pattern": "^ak:consent:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Opaque private request correlation only; never a native permission selector."
    },
    "blob_ref": {
      "$ref": "./agent-operations.schema.json#/$defs/blob_ref"
    },
    "mimi_uri": {
      "$ref": "./mimi-interop.schema.json#/$defs/mimi_uri"
    },
    "mimi_room_uri": {
      "$ref": "./mimi-interop.schema.json#/$defs/mimi_room_uri"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+={0,2}$",
      "minLength": 1
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "proof": {
      "$ref": "./event-envelope.schema.json#/$defs/proof",
      "$comment": "Wire shape only. Every request/outcome family that carries actor proofs declares its own proofs array inline so that each object family owns a distinct detached-proof node with its own registered context (mimi-interop.md section 5.1); a single shared proofs alias would put unrelated MIMI operations under one domain separation."
    },
    "signature": {
      "type": "object",
      "required": [
        "kind",
        "verification_method",
        "payload_digest",
        "created_at",
        "domain",
        "audience",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "detached_jws",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mimi-operations.schema.json#/$defs/signature/properties/kind",
            "owner": "mimi-operations.schema.json#/$defs/signature/properties/kind",
            "values": [
              "detached_jws"
            ]
          }
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "DID URL of a verification method authorized by the issuer's current DID Document (extensions/mimi-interop.md section 5.1)."
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "domain": {
          "$ref": "#/$defs/non_empty_string"
        },
        "audience": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty_string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "opaque_payload": {
      "type": "object",
      "required": [
        "content_type",
        "payload_digest"
      ],
      "properties": {
        "content_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "payload": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "target_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "mimi_room_update_request_body": {
      "type": "object",
      "required": [
        "mls_group_id",
        "update"
      ],
      "properties": {
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "update": {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/non_empty_string",
              "description": "Semantic update kind and durable-effect discriminator. It MUST equal the kind inside the decoded opaque payload. ak.mimi.room_binding selects the caller-authored Event branch; every other value selects the receipt-only branch."
            },
            "payload": {
              "$ref": "#/$defs/opaque_payload"
            }
          },
          "additionalProperties": false
        },
        "epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "confirmed_transcript_hash": {
          "$ref": "#/$defs/digest"
        },
        "sender_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "room_binding_event": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission",
          "description": "Complete caller-authored and caller-signed ak.mimi.room_binding initial submission. It is required exactly when /update/kind is ak.mimi.room_binding. The facade MUST first verify that the decoded opaque payload carries the same semantic kind, then bind the Event's exact payload to the path room, target Realm and Strand, MLS group, and authenticated MIMI operation and submit these exact bytes through authority Event submission. It MUST NOT synthesize, rebuild or co-sign the Event. Every other receipt-only branch MUST omit this field."
        }
      },
      "additionalProperties": false
    },
    "mimi_room_update_response_body": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "room_state_ref": {
          "$ref": "#/$defs/event_id"
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "mimi_notify_request_body": {
      "type": "object",
      "required": [
        "notification"
      ],
      "properties": {
        "notification": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/non_empty_string"
            },
            "fanout_ref": {
              "$ref": "#/$defs/non_empty_string"
            },
            "delivery_hint": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "additionalProperties": false
        },
        "origin_provider_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "routing": {
          "type": "object",
          "properties": {
            "mimi_room_uri": {
              "$ref": "#/$defs/mimi_room_uri"
            },
            "target_provider_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/did_core_id"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mimi_notify_response_body": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "ciphertext": {
      "type": "object",
      "required": [
        "content_type",
        "ciphertext_digest",
        "payload"
      ],
      "properties": {
        "content_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/digest"
        },
        "payload": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "mimi_submit_message_request_body": {
      "type": "object",
      "required": [
        "sender_actor_id",
        "device_id",
        "ciphertext"
      ],
      "properties": {
        "sender_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "ciphertext": {
          "$ref": "#/$defs/ciphertext"
        },
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "associated_data": {
          "$ref": "#/$defs/opaque_payload"
        }
      },
      "additionalProperties": false
    },
    "mimi_submit_message_response_body": {
      "type": "object",
      "required": [
        "delivery"
      ],
      "properties": {
        "event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "delivery": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "accepted",
                "partial",
                "rejected"
              ],
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "mimi-operations.schema.json#/$defs/mimi_submit_message_response_body/properties/delivery/properties/status",
                "owner": "mimi-operations.schema.json#/$defs/mimi_submit_message_response_body/properties/delivery/properties/status",
                "values": [
                  "accepted",
                  "partial",
                  "rejected"
                ]
              }
            },
            "delivered_to_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/did_core_id"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "mimi_request_consent_request_body": {
      "type": "object",
      "x-arkret-proof-context": "ak.mimi_request_consent_request_proof.v1",
      "required": [
        "requester_actor_id",
        "holder_account_id",
        "purpose",
        "proofs"
      ],
      "properties": {
        "requester_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "description": "Exact Actor the requester is asking as, Station and actor role included. consent-model.md section 6.1 compares an ordinary peer by complete ActorId and forbids falling back to a bare principal. The operation proof MUST authenticate this exact Actor through its current accepted authority. Transport authentication MUST bind the complete request and authenticated source; a provider transport signature authenticates only that service and does not authorize the Actor. Proving key control under some principal does not authorize an arbitrary account of that principal."
        },
        "holder_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id",
          "description": "Exact Account the request is addressed to, chosen and signed by the requester. It is not evidence that the holder exists, is visible or has consented: creating the private correlation queries no consent current state, and a request that is syntactically valid and authenticated MUST produce an indistinguishable opaque outcome whether or not the holder exists. A correlation may freeze a target nobody can legitimately accept; it carries no authority. This operation resolves no aliases -- the external identifier to Arkret identity mapping happens before it, under the section 10 rules."
        },
        "purpose": {
          "type": "string",
          "enum": [
            "invite",
            "voice_call",
            "video_call",
            "presence"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mimi-operations.schema.json#/$defs/mimi_request_consent_request_body/properties/purpose",
            "owner": "mimi-operations.schema.json#/$defs/mimi_request_consent_request_body/properties/purpose",
            "values": [
              "invite",
              "voice_call",
              "video_call",
              "presence"
            ]
          }
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id",
          "description": "Optional interop context. It grants no Realm authority and neither widens nor narrows the consent scope; when present it is covered by the unsigned-body digest like every other member."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1,
          "description": "Required requester operation proof over ak.mimi_request_consent_request_proof.v1. Resolve the exact Actor's current accepted Account device generation or Agent runtime authorization under mimi-interop.md section 5.1; DID controller key possession and provider transport signatures do not authorize an Actor. Agent runtime requires current controller/lifecycle, provision and key ceilings and operation-scoped authenticated runtime authority. No generic remote PCR disclosure carrier is registered for this request: missing authorized current evidence MUST fail closed before correlation creation or holder lookup."
        }
      },
      "additionalProperties": false,
      "description": "Request that a named Arkret holder grant consent to a named Arkret Actor. The signed request writes both identities in full and the facade freezes exactly those into its private correlation, so update_consent is a byte comparison rather than a re-resolution against whatever the facade's current Station or alias table happens to say."
    },
    "mimi_request_consent_response_body": {
      "type": "object",
      "required": [
        "consent_id"
      ],
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/consent_id"
        },
        "challenge": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "mimi_update_consent_request_body": {
      "type": "object",
      "description": "Caller signs a complete ak.consent.replace Event. body.consent_id equals private correlation.consent_id only; it is never the native selector. Exact holder Account/PCR/peer and original root/device/source gates apply. Accept adds or replaces only the correlation concrete scope; deny/revoke removes an existing entry, including expired ones. All other entries and optional-member presence remain byte-for-byte equal to the signed exact prestate. Facade compares the authenticated complete exact prestate; final PCR acceptance atomically checks that same expected revision or never_written predicate and performs the full replacement, never server merge or a distributed transaction. Wrong correlation/decision/stale new write uses opaque not_found. Exact accepted retry restores original correlation/decision/Event outcome before new-current evaluation and never replays a write.",
      "x-arkret-proof-context": "ak.mimi_update_consent_request_proof.v1",
      "required": [
        "consent_id",
        "decision",
        "actor_id",
        "consent_event",
        "signature"
      ],
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/consent_id"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "deny",
            "revoke"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mimi-operations.schema.json#/$defs/mimi_update_consent_request_body/properties/decision",
            "owner": "mimi-operations.schema.json#/$defs/mimi_update_consent_request_body/properties/decision",
            "values": [
              "accept",
              "deny",
              "revoke"
            ]
          }
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "consent_event": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission",
          "description": "Caller signs a complete ak.consent.replace Event. body.consent_id equals private correlation.consent_id only; it is never the native selector. Exact holder Account/PCR/peer and original root/device/source gates apply. Accept adds or replaces only the correlation concrete scope; deny/revoke removes an existing entry, including expired ones. All other entries and optional-member presence remain byte-for-byte equal to the signed exact prestate. Facade compares the authenticated complete exact prestate; final PCR acceptance atomically checks that same expected revision or never_written predicate and performs the full replacement, never server merge or a distributed transaction. Wrong correlation/decision/stale new write uses opaque not_found. Exact accepted retry restores original correlation/decision/Event outcome before new-current evaluation and never replays a write."
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "reason": {
          "$ref": "string-profiles.schema.json#/$defs/audit_reason_text"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "consent_event": {
              "properties": {
                "event": {
                  "properties": {
                    "kind": {
                      "const": "ak.consent.replace",
                      "x-arkret-value-ownership": {
                        "class": "namespaced_symbol",
                        "authority": "mimi-operations.schema.json#/$defs/mimi_update_consent_request_body/allOf/0/properties/consent_event/properties/event/properties/kind",
                        "owner": "mimi-operations.schema.json#/$defs/mimi_update_consent_request_body/allOf/0/properties/consent_event/properties/event/properties/kind",
                        "values": [
                          "ak.consent.replace"
                        ]
                      }
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "event"
              ]
            }
          }
        }
      ]
    },
    "mimi_update_consent_response_body": {
      "type": "object",
      "required": [
        "consent_id",
        "decision",
        "updated_at",
        "event_ref"
      ],
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/consent_id"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "deny",
            "revoke"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mimi-operations.schema.json#/$defs/mimi_update_consent_response_body/properties/decision",
            "owner": "mimi-operations.schema.json#/$defs/mimi_update_consent_response_body/properties/decision",
            "values": [
              "accept",
              "deny",
              "revoke"
            ]
          }
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "event_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "identifier": {
      "type": "object",
      "required": [
        "kind",
        "identifier_commitment"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "mimi_uri",
            "did",
            "handle",
            "phone",
            "email",
            "opaque"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mimi-operations.schema.json#/$defs/identifier/properties/kind",
            "owner": "mimi-operations.schema.json#/$defs/identifier/properties/kind",
            "values": [
              "mimi_uri",
              "did",
              "handle",
              "phone",
              "email",
              "opaque"
            ]
          }
        },
        "identifier_commitment": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "mimi_identifier_query_request_body": {
      "type": "object",
      "x-arkret-proof-context": "ak.mimi_identifier_query_request_proof.v1",
      "required": [
        "identifiers"
      ],
      "properties": {
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "privacy_profile": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "mimi_identifier_query_response_body": {
      "type": "object",
      "x-arkret-proof-context": "ak.mimi_identifier_query_outcome_proof.v1",
      "required": [
        "matches",
        "has_more"
      ],
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "identifier_commitment",
              "matched"
            ],
            "properties": {
              "identifier_commitment": {
                "$ref": "#/$defs/digest"
              },
              "matched": {
                "type": "boolean"
              },
              "mimi_uri": {
                "$ref": "#/$defs/mimi_uri"
              },
              "subject_id": {
                "$ref": "#/$defs/did_core_id"
              }
            },
            "additionalProperties": false
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "mimi_report_abuse_request_body": {
      "type": "object",
      "description": "Holder-signed MIMI report claim for a service-authored moderation Event. The body carries no provider identity, reporter identity or pre-signed Event mirror: the facade derives them from authenticated transport, reporter_authority and this exact claim.",
      "required": [
        "reporter_authority",
        "report_claim"
      ],
      "properties": {
        "reporter_authority": {
          "$ref": "#/$defs/mimi_reporter_authority"
        },
        "report_claim": {
          "$ref": "#/$defs/mimi_report_claim"
        }
      },
      "additionalProperties": false
    },
    "mimi_report_claim": {
      "type": "object",
      "description": "Exact reporter-signed input to the facade's service-authored ak.self.moderation.report Event. The facade derives reporter_id, provenance and source_provider_id from authenticated authority, never from a body echo.",
      "required": [
        "realm_id",
        "scope_ref",
        "target_ref",
        "report_reason_code"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "scope_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
        },
        "target_ref": {
          "$ref": "./event-payload.schema.json#/$defs/moderation_report_payload/properties/target_ref"
        },
        "report_reason_code": {
          "$ref": "./event-payload.schema.json#/$defs/moderation_report_payload/properties/report_reason_code"
        },
        "description": {
          "$ref": "./event-payload.schema.json#/$defs/moderation_report_payload/properties/description"
        },
        "evidence_refs": {
          "$ref": "./event-payload.schema.json#/$defs/moderation_report_payload/properties/evidence_refs"
        },
        "evidence_package": {
          "$ref": "./event-payload.schema.json#/$defs/moderation_report_payload/properties/evidence_package"
        },
        "franking_proof": {
          "$ref": "./event-payload.schema.json#/$defs/moderation_report_payload/properties/franking_proof"
        }
      },
      "additionalProperties": false
    },
    "mimi_reporter_authority": {
      "type": "object",
      "x-arkret-signature-domain": "ak.mimi_reporter_authority_proof.v1",
      "description": "Holder-signed, short-lived binding from the external reporter to one complete current Arkret ActorId. The proof transcript covers the complete closed request with only reporter_authority.proof omitted: reporter_authority and report_claim. The verifier resolves the current device or authorized Agent proxy key independently, authenticates the Provider at the transport layer, and verifies both full CommittedEventRefs remain current before the facade service authors an Event; carrier fields never self-authorize.",
      "required": [
        "actor_id",
        "membership_ref",
        "room_binding_ref",
        "expires_at",
        "proof"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "membership_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "room_binding_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "mimi_report_abuse_response_body": {
      "type": "object",
      "required": [
        "report_id"
      ],
      "properties": {
        "report_id": {
          "$ref": "#/$defs/report_id"
        },
        "routed_to_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did_core_id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "mimi_proxy_download_request_body": {
      "type": "object",
      "required": [
        "asset_ref",
        "requester_id"
      ],
      "properties": {
        "asset_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob_ref"
            },
            {
              "$ref": "#/$defs/non_empty_string"
            }
          ]
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "ohttp_context": {
          "type": "object",
          "required": [
            "context_id",
            "request_digest"
          ],
          "properties": {
            "context_id": {
              "allOf": [
                {
                  "$ref": "#/$defs/non_empty_string"
                },
                {
                  "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
                }
              ]
            },
            "request_digest": {
              "$ref": "#/$defs/digest"
            },
            "relay_provider_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "encapsulated_request": {
              "$ref": "#/$defs/base64url"
            }
          },
          "additionalProperties": false
        },
        "range": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "mimi_proxy_download_response_body": {
      "type": "object",
      "required": [
        "download_ref"
      ],
      "properties": {
        "download_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "download_request_headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    }
  }
}
