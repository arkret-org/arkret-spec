{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/mimi-operations.schema.json",
  "title": "Arkret MIMI Operation DTOs",
  "description": "Closed request/response DTOs for MIMI provider interop operation bindings.",
  "anyOf": [
    {
      "$ref": "#/$defs/mimi_key_material_request_body"
    },
    {
      "$ref": "#/$defs/mimi_key_material_outcome"
    },
    {
      "$ref": "#/$defs/mimi_room_update_request_body"
    },
    {
      "$ref": "#/$defs/mimi_room_update_outcome"
    },
    {
      "$ref": "#/$defs/mimi_notify_request_body"
    },
    {
      "$ref": "#/$defs/mimi_notify_outcome"
    },
    {
      "$ref": "#/$defs/mimi_submit_message_request_body"
    },
    {
      "$ref": "#/$defs/mimi_submit_message_outcome"
    },
    {
      "$ref": "#/$defs/mimi_group_info_outcome"
    },
    {
      "$ref": "#/$defs/mimi_request_consent_request_body"
    },
    {
      "$ref": "#/$defs/mimi_request_consent_outcome"
    },
    {
      "$ref": "#/$defs/mimi_update_consent_request_body"
    },
    {
      "$ref": "#/$defs/mimi_update_consent_outcome"
    },
    {
      "$ref": "#/$defs/mimi_identifier_query_request_body"
    },
    {
      "$ref": "#/$defs/mimi_identifier_query_outcome"
    },
    {
      "$ref": "#/$defs/mimi_report_abuse_request_body"
    },
    {
      "$ref": "#/$defs/mimi_report_abuse_outcome"
    },
    {
      "$ref": "#/$defs/mimi_proxy_download_request_body"
    },
    {
      "$ref": "#/$defs/mimi_proxy_download_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^ak:report:[A-Za-z0-9_-]{44}$"
    },
    "consent_id": {
      "type": "string",
      "pattern": "^ak:consent:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "mimi_uri": {
      "type": "string",
      "pattern": "^mimi://[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+={0,2}$",
      "minLength": 1
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "$ref": "./event-envelope.schema.json#/$defs/proof"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      },
      "minItems": 1
    },
    "signature": {
      "type": "object",
      "required": [
        "kind",
        "verification_method",
        "payload_digest",
        "created_at",
        "domain",
        "audience",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "detached_jws"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "DID URL of a verification method authorized by the issuer's current DID Document (extensions/mimi-interop.md section 5.1)."
        },
        "payload_digest": {
          "$ref": "#/$defs/hash"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "domain": {
          "$ref": "#/$defs/non_empty_string"
        },
        "audience": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty_string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "jws": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "opaque_payload": {
      "type": "object",
      "required": [
        "content_type",
        "payload_digest"
      ],
      "properties": {
        "content_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "payload_digest": {
          "$ref": "#/$defs/hash"
        },
        "payload": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "target_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "key_package": {
      "type": "object",
      "required": [
        "device_id",
        "mls_key_package"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "key_package_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mls_key_package": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "group_info": {
      "type": "object",
      "required": [
        "mls_group_id",
        "epoch",
        "group_info"
      ],
      "properties": {
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "group_info": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "mimi_key_material_request_body": {
      "type": "object",
      "required": [
        "requester",
        "strand_id",
        "device_id"
      ],
      "properties": {
        "requester": {
          "$ref": "#/$defs/did"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "mimi_room_uri": {
          "$ref": "#/$defs/mimi_uri"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        }
      },
      "additionalProperties": false
    },
    "mimi_key_material_outcome": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "key_packages"
          ]
        },
        {
          "required": [
            "group_info"
          ]
        },
        {
          "required": [
            "failures"
          ]
        }
      ],
      "properties": {
        "key_packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key_package"
          }
        },
        "group_info": {
          "$ref": "#/$defs/group_info"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "mimi_room_update_request_body": {
      "type": "object",
      "required": [
        "mls_group_id",
        "update"
      ],
      "properties": {
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "update": {
          "type": "object",
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/non_empty_string"
            },
            "payload": {
              "$ref": "#/$defs/opaque_payload"
            }
          },
          "additionalProperties": false
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_transcript_hash": {
          "$ref": "#/$defs/hash"
        },
        "sender_actor_id": {
          "$ref": "#/$defs/did"
        }
      },
      "additionalProperties": false
    },
    "mimi_room_update_outcome": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "room_state_ref": {
          "$ref": "#/$defs/event_id"
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    },
    "mimi_notify_request_body": {
      "type": "object",
      "required": [
        "notification"
      ],
      "properties": {
        "notification": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/non_empty_string"
            },
            "fanout_ref": {
              "$ref": "#/$defs/non_empty_string"
            },
            "delivery_hint": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "additionalProperties": false
        },
        "origin_provider": {
          "$ref": "#/$defs/did"
        },
        "routing": {
          "type": "object",
          "properties": {
            "mimi_room_uri": {
              "$ref": "#/$defs/mimi_uri"
            },
            "target_providers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/did"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mimi_notify_outcome": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ciphertext": {
      "type": "object",
      "required": [
        "content_type",
        "ciphertext_digest",
        "payload"
      ],
      "properties": {
        "content_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/hash"
        },
        "payload": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "mimi_submit_message_request_body": {
      "type": "object",
      "required": [
        "sender_actor_id",
        "device_id",
        "ciphertext"
      ],
      "properties": {
        "sender_actor_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "ciphertext": {
          "$ref": "#/$defs/ciphertext"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "associated_data": {
          "$ref": "#/$defs/opaque_payload"
        }
      },
      "additionalProperties": false
    },
    "mimi_submit_message_outcome": {
      "type": "object",
      "required": [
        "delivery"
      ],
      "properties": {
        "event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "delivery": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "accepted",
                "partial",
                "rejected"
              ]
            },
            "delivered_to": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/did"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    },
    "mimi_group_info_outcome": {
      "type": "object",
      "required": [
        "group_info"
      ],
      "properties": {
        "group_info": {
          "$ref": "#/$defs/group_info"
        },
        "room_binding_ref": {
          "$ref": "#/$defs/event_id"
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        }
      },
      "additionalProperties": false
    },
    "consent_target": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "did",
            "mimi_uri",
            "handle",
            "provider_user"
          ]
        },
        "id": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "mimi_request_consent_request_body": {
      "type": "object",
      "required": [
        "requester_id",
        "target",
        "purpose"
      ],
      "properties": {
        "requester_id": {
          "$ref": "#/$defs/did"
        },
        "target": {
          "$ref": "#/$defs/consent_target"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "invite",
            "direct_message",
            "voice_call",
            "video_call",
            "presence",
            "any"
          ]
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        }
      },
      "additionalProperties": false
    },
    "mimi_request_consent_outcome": {
      "type": "object",
      "required": [
        "consent_id",
        "status"
      ],
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/consent_id"
        },
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "challenge": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "mimi_update_consent_request_body": {
      "type": "object",
      "required": [
        "consent_id",
        "decision",
        "actor_id",
        "signature"
      ],
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/consent_id"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "deny",
            "revoke"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/did"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "mimi_update_consent_outcome": {
      "type": "object",
      "required": [
        "status",
        "updated_at"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "event_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": "object",
      "required": [
        "kind",
        "identifier_commitment"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "mimi_uri",
            "did",
            "handle",
            "phone",
            "email",
            "opaque"
          ]
        },
        "identifier_commitment": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "mimi_identifier_query_request_body": {
      "type": "object",
      "required": [
        "identifiers"
      ],
      "properties": {
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "privacy_profile": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        }
      },
      "additionalProperties": false
    },
    "mimi_identifier_query_outcome": {
      "type": "object",
      "required": [
        "matches",
        "has_more"
      ],
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "identifier_commitment",
              "matched"
            ],
            "properties": {
              "identifier_commitment": {
                "$ref": "#/$defs/hash"
              },
              "matched": {
                "type": "boolean"
              },
              "mimi_uri": {
                "$ref": "#/$defs/mimi_uri"
              },
              "subject": {
                "$ref": "#/$defs/did"
              }
            },
            "additionalProperties": false
          }
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mimi_report_abuse_request_body": {
      "type": "object",
      "required": [
        "strand_id",
        "target_ref",
        "reporter",
        "abuse_reason_code"
      ],
      "properties": {
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "mimi_room_uri": {
          "$ref": "#/$defs/mimi_uri"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "target_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reporter": {
          "$ref": "#/$defs/did"
        },
        "abuse_reason_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_package": {
          "$ref": "#/$defs/opaque_payload"
        },
        "franking_proof": {
          "$ref": "#/$defs/opaque_payload"
        },
        "description": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "mimi_report_abuse_outcome": {
      "type": "object",
      "required": [
        "report_id",
        "status"
      ],
      "properties": {
        "report_id": {
          "$ref": "#/$defs/report_id"
        },
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "routed_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "mimi_proxy_download_request_body": {
      "type": "object",
      "required": [
        "asset_ref",
        "requester"
      ],
      "properties": {
        "asset_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob_ref"
            },
            {
              "$ref": "#/$defs/non_empty_string"
            }
          ]
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "ohttp_context": {
          "type": "object",
          "required": [
            "context_id",
            "request_digest"
          ],
          "properties": {
            "context_id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "request_digest": {
              "$ref": "#/$defs/hash"
            },
            "relay_provider": {
              "$ref": "#/$defs/did"
            },
            "encapsulated_request": {
              "$ref": "#/$defs/base64url"
            }
          },
          "additionalProperties": false
        },
        "range": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "mimi_proxy_download_outcome": {
      "type": "object",
      "required": [
        "download_ref"
      ],
      "properties": {
        "download_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  }
}
