{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/circle.schema.json",
  "title": "Arkret Circle",
  "description": "Circle — an intra-Realm scoped event/message boundary with its own membership, history_access and optional independent MLS group. Parent Realm membership supplies only the current-membership intersection gate; history_access is never dynamically inherited. Read-receipt policy is not a Circle object member or metadata patch: ak.scope.read_receipt_policy is its sole writer and scope_read_receipt_policy its sole current carrier (zh/discovery/read-receipts.md §2.5).",
  "type": "object",
  "required": [
    "schema",
    "realm_id",
    "title",
    "display",
    "directory_visibility",
    "join_rule",
    "history_access",
    "state",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id",
      "description": "Present on the materialised object. MUST be absent from the create Event payload: zh/models/common-fields.md derives it from the create Event's own event_id (retyped), so a payload-supplied id would be a second, forgeable truth."
    },
    "schema": {
      "const": "ak.schema.circle.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "circle.schema.json#/properties/schema",
        "owner": "circle.schema.json#/properties/schema",
        "values": [
          "ak.schema.circle.v1"
        ]
      }
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id",
      "description": "Parent Realm. create-locked; Circle never re-binds to another Realm."
    },
    "profile_ref": {
      "type": "string",
      "pattern": "^ak\\.profile\\.[a-z0-9_.-]+\\.v1$",
      "description": "Optional create-locked Circle semantic profile discriminator. Ordinary Circles omit it. Profile-specific creation paths MUST persist their registered profile id. Agent Sidecar is a separate ak.schema.agent_sidecar.v1 object and MUST NOT be represented by this field."
    },
    "title": {
      "$ref": "string-profiles.schema.json#/$defs/display_text_256"
    },
    "summary": {
      "$ref": "string-profiles.schema.json#/$defs/short_text",
      "maxLength": 2048
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "directory_visibility": {
      "type": "string",
      "enum": [
        "members",
        "realm_members"
      ],
      "description": "Who may see this Circle exists as a directory entry. 'members' means only Circle members see its title/display/member_ids. 'realm_members' exposes directory metadata only and does NOT grant event or history access.",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "circle.schema.json#/properties/directory_visibility",
        "owner": "circle.schema.json#/properties/directory_visibility",
        "values": [
          "members",
          "realm_members"
        ]
      }
    },
    "join_rule": {
      "type": "string",
      "enum": [
        "invite",
        "knock",
        "public"
      ],
      "description": "public permits parent-Realm members to self-join; invite requires an authorized administrator using ak.circle.member.add.others with the required same-unit audit. v1 has no Circle invitation or acceptance workflow. All joins bind the exact current parent membership revision.",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "circle.schema.json#/properties/join_rule",
        "owner": "circle.schema.json#/properties/join_rule",
        "values": [
          "invite",
          "knock",
          "public"
        ]
      }
    },
    "history_access": {
      "type": "string",
      "enum": [
        "since_join",
        "all_history_for_current_members"
      ],
      "description": "Circle's own governance history range ratchet, initialized by Circle create. The only state-changing update is all_history_for_current_members to since_join; widening is permanently forbidden. It is never dynamically inherited from or capped by the parent Realm history_access, while current access still requires active parent-Realm membership. Standard MLS requires since_join.",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "circle.schema.json#/properties/history_access",
        "owner": "circle.schema.json#/properties/history_access",
        "values": [
          "since_join",
          "all_history_for_current_members"
        ]
      }
    },
    "agent_participation": {
      "type": "object",
      "description": "Optional wrapped five-bit Agent ceiling. When present every bit is explicit and may only tighten the parent Realm ceiling.",
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "$ref": "./principal-operations.schema.json#/$defs/participation_bits"
        }
      },
      "additionalProperties": false
    },
    "mls_group_id": {
      "$ref": "./common-ids.schema.json#/$defs/mls_group_id",
      "description": "Reducer-derived from this Circle's circle-branch effective scope; both realm_id and circle_id enter the scope key bytes. Present only on the materialized MLS-backed Circle and forbidden in the actor-supplied create payload."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "tombstoned"
      ],
      "description": "Circle lifecycle state. v1 defines active, archived, and tombstoned only; Circle has no independent freeze or destroy state because parent Realm freeze/destroy applies at the Realm boundary.",
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "circle.schema.json#/properties/state",
        "owner": "circle.schema.json#/properties/state",
        "values": [
          "active",
          "archived",
          "tombstoned"
        ]
      }
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "archived",
              "tombstoned"
            ],
            "x-arkret-value-ownership": {
              "class": "owned_symbol",
              "authority": "circle.schema.json#/allOf/0/if/properties/state",
              "owner": "circle.schema.json#/allOf/0/if/properties/state",
              "values": [
                "archived",
                "tombstoned"
              ]
            }
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "state_changed_at"
        ]
      }
    }
  ],
  "$defs": {
    "display": {
      "type": "object",
      "required": [
        "short_name",
        "color_token",
        "symbol"
      ],
      "properties": {
        "short_name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9 _-]{0,23}$",
          "description": "Human-facing short name. Unique per (realm_id, short_name) case-insensitive — reducer-enforced. Circle naming has no Sidecar-reserved prefix because Sidecar is a separate native scope."
        },
        "color_token": {
          "type": "string",
          "enum": [
            "slate",
            "red",
            "orange",
            "amber",
            "yellow",
            "lime",
            "green",
            "emerald",
            "teal",
            "cyan",
            "sky",
            "blue",
            "indigo",
            "violet",
            "fuchsia",
            "pink",
            "gray_high_contrast"
          ],
          "description": "Color token from the spec-controlled palette. Clients MUST map token -> theme color (light/dark/high-contrast) consistently across devices; clients MUST NOT reassign tokens.",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "circle.schema.json#/$defs/display/properties/color_token",
            "owner": "circle.schema.json#/$defs/display/properties/color_token",
            "values": [
              "slate",
              "red",
              "orange",
              "amber",
              "yellow",
              "lime",
              "green",
              "emerald",
              "teal",
              "cyan",
              "sky",
              "blue",
              "indigo",
              "violet",
              "fuchsia",
              "pink",
              "gray_high_contrast"
            ]
          }
        },
        "symbol": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "emoji"
              ]
            },
            {
              "required": [
                "glyph"
              ]
            }
          ],
          "properties": {
            "emoji": {
              "type": "string"
            },
            "glyph": {
              "type": "string",
              "enum": [
                "lock",
                "shield",
                "eye",
                "eye_off",
                "user_shield",
                "fingerprint",
                "key",
                "diamond",
                "flame",
                "leaf",
                "seal",
                "compass",
                "atom",
                "bolt",
                "moon",
                "sun",
                "star",
                "globe",
                "satellite",
                "ring",
                "chain",
                "tag",
                "flag",
                "scroll",
                "scale",
                "hourglass",
                "spark"
              ],
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "circle.schema.json#/$defs/display/properties/symbol/properties/glyph",
                "owner": "circle.schema.json#/$defs/display/properties/symbol/properties/glyph",
                "values": [
                  "lock",
                  "shield",
                  "eye",
                  "eye_off",
                  "user_shield",
                  "fingerprint",
                  "key",
                  "diamond",
                  "flame",
                  "leaf",
                  "seal",
                  "compass",
                  "atom",
                  "bolt",
                  "moon",
                  "sun",
                  "star",
                  "globe",
                  "satellite",
                  "ring",
                  "chain",
                  "tag",
                  "flag",
                  "scroll",
                  "scale",
                  "hourglass",
                  "spark"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  },
  "unevaluatedProperties": false
}
