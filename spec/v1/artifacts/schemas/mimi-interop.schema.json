{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/mimi-interop.schema.json",
  "title": "Arkret MIMI Interoperability",
  "description": "Provider directory, room binding, and content mapping receipt objects for ak.profile.mimi_interop.v1.",
  "$comment": "Intentionally relaxed interop-extension surface: this profile tracks evolving IETF MIMI Internet-Drafts (see zh/extensions/mimi-interop.md §1), so additionalProperties is left open at the top level and on the mimi/binding_scope/payload subtrees to forward-carry draft fields without a breaking schema bump. Known fields are pinned; unknown draft fields are tolerated rather than rejected. The proof object below gives a minimal required core so the openness is limited to known extension subtrees and does not mask a missing signature. Unknown fields anywhere on this surface are security-inert (see zh/extensions/mimi-interop.md §9.2): receivers MUST ignore them for all security decisions and MUST NOT let them affect authorization, identity binding, policy_root, MLS epoch/group state, routing, or any signature/digest transcript.",
  "anyOf": [
    {
      "$ref": "#/$defs/provider_directory"
    },
    {
      "$ref": "#/$defs/room_binding"
    },
    {
      "$ref": "#/$defs/content_mapping_receipt"
    }
  ],
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "mimi_uri": {
      "type": "string",
      "pattern": "^mimi://[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[A-Za-z0-9_+\\-/=:.]{32,}$"
    },
    "provider_directory": {
      "type": "object",
      "required": [
        "service_type",
        "supported_profiles",
        "mimi"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.mimi_interop.v1"
        },
        "service_id": {
          "$ref": "#/$defs/did"
        },
        "service_type": {
          "const": "mimi_provider_facade"
        },
        "supported_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "ak.profile.mimi_interop.v1"
          }
        },
        "mimi": {
          "type": "object",
          "required": [
            "protocol_draft",
            "content_draft",
            "base_url",
            "provider_id",
            "features"
          ],
          "properties": {
            "protocol_draft": {
              "const": "draft-ietf-mimi-protocol-06"
            },
            "content_draft": {
              "const": "draft-ietf-mimi-content-08"
            },
            "room_policy_draft": {
              "const": "draft-ietf-mimi-room-policy-03"
            },
            "identifier_draft": {
              "const": "draft-kohbrok-mimi-identifiers-01"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "provider_id": {
              "$ref": "#/$defs/mimi_uri"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "key_material",
                  "room_update",
                  "notify",
                  "submit_message",
                  "group_info",
                  "consent",
                  "identifier_query",
                  "report_abuse",
                  "proxy_download"
                ]
              },
              "uniqueItems": true
            },
            "mls_cipher_suites": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519"
                ]
              },
              "uniqueItems": true,
              "description": "Generated from active canonical_id rows in mls-ciphersuite-registry.json."
            },
            "content_profiles": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "application/mimi-content",
                  "text/plain;charset=utf-8",
                  "text/markdown;variant=GFM-MIMI",
                  "application/vnd.arkret.content+json"
                ]
              },
              "uniqueItems": true
            },
            "room_policy_components": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        },
        "proof": {
          "type": "object",
          "required": [
            "verification_method",
            "signature"
          ],
          "properties": {
            "verification_method": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "room_binding": {
      "type": "object",
      "description": "MIMI room binding effect payload. In CBA/Lattice state, the cell subject is payload.mimi_room_uri for ak.component.mimi.room_binding.v1.",
      "required": [
        "receipt_kind",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.mimi_interop.v1"
        },
        "kind": {
          "const": "ak.mimi.room_binding"
        },
        "payload": {
          "type": "object",
          "required": [
            "profile",
            "mimi_room_uri",
            "binding_scope",
            "hub_provider",
            "local_provider_role",
            "status"
          ],
          "properties": {
            "profile": {
              "const": "ak.profile.mimi_interop.v1"
            },
            "mimi_room_uri": {
              "$ref": "#/$defs/mimi_uri"
            },
            "binding_scope": {
              "type": "object",
              "required": [
                "realm_id",
                "strand_id"
              ],
              "properties": {
                "realm_id": {
                  "$ref": "./common-ids.schema.json#/$defs/realm_id"
                },
                "strand_id": {
                  "type": "string",
                  "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "additionalProperties": true
            },
            "hub_provider": {
              "$ref": "#/$defs/did"
            },
            "follower_providers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/did"
              },
              "uniqueItems": true
            },
            "local_provider_role": {
              "type": "string",
              "enum": [
                "hub",
                "follower",
                "observer"
              ]
            },
            "mls_group_id": {
              "type": "string"
            },
            "content_profile": {
              "type": "string",
              "enum": [
                "application/mimi-content",
                "text/plain;charset=utf-8",
                "text/markdown;variant=GFM-MIMI",
                "application/vnd.arkret.content+json"
              ]
            },
            "policy_root": {
              "$ref": "#/$defs/hash"
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "accepted",
                "revoked",
                "migrating"
              ],
              "description": "Room binding lifecycle status. Initial status MUST be proposed or accepted; legal transitions are proposed->accepted, proposed->revoked, accepted->migrating, accepted->revoked, migrating->accepted (verified migration proof), migrating->revoked. revoked is the only terminal state; illegal transitions are rejected with mimi_room_binding_status_transition_invalid. Normative state machine: zh/extensions/mimi-interop.md §4.2."
            },
            "migration_outcome": {
              "type": "string",
              "enum": [
                "completed",
                "rolled_back"
              ],
              "description": "Outcome of a migrating->accepted transition: completed (new topology in effect) or rolled_back (original topology restored). MUST be present on a migrating->accepted Control Move so the result is auditable; MUST be absent on other transitions. Normative: zh/extensions/mimi-interop.md §4.2."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "content_mapping_receipt": {
      "type": "object",
      "required": [
        "kind",
        "profile",
        "mimi_room_uri",
        "source_format",
        "target_format",
        "original_envelope_digest",
        "mapped_operation_id"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.mimi_interop.v1"
        },
        "receipt_kind": {
          "const": "content_mapping_receipt",
          "description": "Interop-audit object discriminator. This object is not an Event Envelope and this value is not an event kind."
        },
        "profile": {
          "const": "ak.profile.mimi_interop.v1"
        },
        "mimi_room_uri": {
          "$ref": "#/$defs/mimi_uri"
        },
        "source_format": {
          "type": "string",
          "enum": [
            "application/mimi-content",
            "text/plain;charset=utf-8",
            "text/markdown;variant=GFM-MIMI",
            "application/vnd.arkret.content+json"
          ]
        },
        "target_format": {
          "type": "string",
          "enum": [
            "ak.message.create",
            "ak.message.revise",
            "ak.message.redact",
            "ak.reaction.add",
            "ak.reaction.remove",
            "ak.relation.create",
            "application/mimi-content",
            "application/vnd.arkret.content+json"
          ]
        },
        "original_envelope_digest": {
          "$ref": "#/$defs/hash"
        },
        "mapped_operation_id": {
          "type": "string"
        },
        "mimi_message_id": {
          "type": "string"
        },
        "arkret_event_id": {
          "type": "string",
          "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "accepted_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": true
    }
  }
}
