{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/mimi-interop.schema.json",
  "title": "Cokret MIMI Interoperability",
  "description": "Provider directory, room binding, and content mapping receipt objects for ck.profile.mimi_interop.v1.",
  "$comment": "Intentionally relaxed interop-extension surface: this profile tracks evolving IETF MIMI Internet-Drafts (see zh/extensions/mimi-interop.md §1), so additionalProperties is left open at the top level and on the mimi/binding_scope/payload subtrees to forward-carry draft fields without a breaking schema bump. Known fields are pinned; unknown draft fields are tolerated rather than rejected. The proof object below gives a minimal required core so the openness is limited to known extension subtrees and does not mask a missing signature.",
  "anyOf": [
    {
      "$ref": "#/$defs/provider_directory"
    },
    {
      "$ref": "#/$defs/room_binding"
    },
    {
      "$ref": "#/$defs/content_mapping_receipt"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "mimi_uri": {
      "type": "string",
      "pattern": "^mimi://[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[A-Za-z0-9_+\\-/=:.]{32,}$"
    },
    "provider_directory": {
      "type": "object",
      "required": [
        "service_type",
        "supported_profiles",
        "mimi"
      ],
      "properties": {
        "schema": {
          "const": "ck.schema.mimi_interop.v1"
        },
        "service_did": {
          "$ref": "#/$defs/did"
        },
        "service_type": {
          "const": "mimi_provider_facade"
        },
        "supported_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "ck.profile.mimi_interop.v1"
          }
        },
        "mimi": {
          "type": "object",
          "required": [
            "protocol_draft",
            "content_draft",
            "base_url",
            "provider_id",
            "features"
          ],
          "properties": {
            "protocol_draft": {
              "const": "draft-ietf-mimi-protocol-06"
            },
            "content_draft": {
              "const": "draft-ietf-mimi-content-08"
            },
            "room_policy_draft": {
              "const": "draft-ietf-mimi-room-policy-03"
            },
            "identifier_draft": {
              "const": "draft-kohbrok-mimi-identifiers-01"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "provider_id": {
              "$ref": "#/$defs/mimi_uri"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "key_material",
                  "room_update",
                  "notify",
                  "submit_message",
                  "group_info",
                  "consent",
                  "identifier_query",
                  "report_abuse",
                  "proxy_download"
                ]
              },
              "uniqueItems": true
            },
            "mls_cipher_suites": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "content_profiles": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "application/mimi-content",
                  "text/plain;charset=utf-8",
                  "text/markdown;variant=GFM-MIMI",
                  "application/vnd.cokret.content+json"
                ]
              },
              "uniqueItems": true
            },
            "room_policy_components": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        },
        "proof": {
          "type": "object",
          "required": [
            "verification_method",
            "signature"
          ],
          "properties": {
            "verification_method": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "room_binding": {
      "type": "object",
      "description": "MIMI room binding effect payload. In Move/Anchor/Lattice state, the cell subject is payload.mimi_room_uri for ck.component.mimi.room_binding.v1.",
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "ck.schema.mimi_interop.v1"
        },
        "kind": {
          "const": "ck.mimi.room_binding"
        },
        "payload": {
          "type": "object",
          "required": [
            "profile",
            "mimi_room_uri",
            "binding_scope",
            "hub_provider",
            "local_provider_role"
          ],
          "properties": {
            "profile": {
              "const": "ck.profile.mimi_interop.v1"
            },
            "mimi_room_uri": {
              "$ref": "#/$defs/mimi_uri"
            },
            "binding_scope": {
              "type": "object",
              "required": [
                "realm_id",
                "flow_id"
              ],
              "properties": {
                "realm_id": {
                  "type": "string",
                  "pattern": "^ck:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "flow_id": {
                  "type": "string",
                  "pattern": "^ck:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "additionalProperties": true
            },
            "hub_provider": {
              "$ref": "#/$defs/did"
            },
            "follower_providers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/did"
              },
              "uniqueItems": true
            },
            "local_provider_role": {
              "type": "string",
              "enum": [
                "hub",
                "follower",
                "observer"
              ]
            },
            "mls_group_id": {
              "type": "string"
            },
            "content_profile": {
              "type": "string",
              "enum": [
                "application/mimi-content",
                "text/plain;charset=utf-8",
                "text/markdown;variant=GFM-MIMI",
                "application/vnd.cokret.content+json"
              ]
            },
            "policy_root": {
              "$ref": "#/$defs/hash"
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "accepted",
                "revoked",
                "migrating"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "content_mapping_receipt": {
      "type": "object",
      "required": [
        "kind",
        "profile",
        "mimi_room_uri",
        "source_format",
        "target_format",
        "original_envelope_digest",
        "mapped_operation_id"
      ],
      "properties": {
        "schema": {
          "const": "ck.schema.mimi_interop.v1"
        },
        "kind": {
          "const": "ck.mimi.mapping_receipt"
        },
        "profile": {
          "const": "ck.profile.mimi_interop.v1"
        },
        "mimi_room_uri": {
          "$ref": "#/$defs/mimi_uri"
        },
        "source_format": {
          "type": "string",
          "enum": [
            "application/mimi-content",
            "text/plain;charset=utf-8",
            "text/markdown;variant=GFM-MIMI",
            "application/vnd.cokret.content+json"
          ]
        },
        "target_format": {
          "type": "string",
          "enum": [
            "ck.message.create",
            "ck.message.revise",
            "ck.message.redact",
            "ck.reaction.add",
            "ck.reaction.remove",
            "ck.relation.create",
            "application/mimi-content",
            "application/vnd.cokret.content+json"
          ]
        },
        "original_envelope_digest": {
          "$ref": "#/$defs/hash"
        },
        "mapped_operation_id": {
          "type": "string"
        },
        "mimi_message_id": {
          "type": "string"
        },
        "cokret_event_id": {
          "type": "string",
          "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "additionalProperties": true
    }
  }
}
