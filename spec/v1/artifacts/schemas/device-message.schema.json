{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/device-message.schema.json",
  "title": "Cokret Device Message Envelope",
  "type": "object",
  "required": [
    "kind",
    "sender_principal_id",
    "sender_device_id",
    "recipient_principal_id",
    "recipient_device_id",
    "sent_at",
    "expires_at",
    "content"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^ck\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "sender_principal_id": {
      "$ref": "#/$defs/did",
      "description": "Sender Principal DID. Intentionally NOT named sender_actor_id: device messages are out-of-band per-device transport envelopes that travel principal-to-principal outside any Realm context, so the Realm-scoped Actor identity used by message.schema.json / event-payload.schema.json does not apply here. Pair with sender_device_id for cross-signing binding."
    },
    "sender_device_id": {
      "$ref": "#/$defs/device_id"
    },
    "recipient_principal_id": {
      "$ref": "#/$defs/did",
      "description": "Recipient Principal DID. Same naming rationale as sender_principal_id — device messages are not Realm-scoped, so Actor identity is not used. Pair with recipient_device_id for targeted device delivery."
    },
    "recipient_device_id": {
      "$ref": "#/$defs/device_id"
    },
    "sent_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "content": {
      "type": "object"
    },
    "device_proof": {
      "type": "object",
      "description": "Optional per-device transport proof block. Schema-open extension point keyed by device-lifecycle.md §5.2 cross-signing binding (typical sub-fields: cross_signing_binding, sender_device_key_fingerprint, signature_over_content_digest). MUST NOT replace MLS authentication of the enclosing envelope; included only when an additional out-of-band per-device transport binding is required (e.g. SAS verification, dehydrated-device proofs). Receivers MUST treat unknown sub-fields as opaque and MUST NOT trust device_proof in isolation."
    },
    "unsigned": {
      "type": "object",
      "description": "Optional non-authenticated metadata block (transport-layer hints only). Receivers MUST NOT trust any field here for authorization, ordering, or cryptographic verification. Typical sub-fields: progress (delivery progress hint), error_context (transport-layer error diagnostics), retry_after_ms. By convention this block is excluded from the signed transcript of the enclosing transport envelope and is dropped on persist."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "ck.key.verification.request",
              "ck.key.verification.ready",
              "ck.key.verification.start",
              "ck.key.verification.accept",
              "ck.key.verification.key",
              "ck.key.verification.mac",
              "ck.key.verification.done",
              "ck.key.verification.cancel"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/key_verification_content"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "methods",
              "timestamp",
              "expires_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.ready"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "methods"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "method"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.accept"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "commitment"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.key"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "key"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.mac"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "mac",
              "keys"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.key.verification.cancel"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "transaction_id",
              "from_device",
              "code"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.secret.request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/secret_request_content"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ck.secret.send"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/secret_send_content"
          }
        }
      }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~=-]{1,128}$"
    },
    "secret_request_content": {
      "type": "object",
      "description": "ck.secret.request to-device content (device-lifecycle.md §10.7). A newly authorized device asks an existing authorized device to hand over an account-scope secret over HPKE. Carries no secret material itself.",
      "required": [
        "request_id",
        "secret_id",
        "from_device",
        "recipient_hpke_public_key"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/transaction_id",
          "description": "Caller-generated random correlation id; MUST NOT be reused after the request is answered or cancelled."
        },
        "secret_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Opaque identifier of the requested secret, e.g. yougen_mls_account_secret."
        },
        "from_device": {
          "$ref": "#/$defs/device_id",
          "description": "Requesting (new) device; MUST equal envelope sender_device_id."
        },
        "recipient_hpke_public_key": {
          "type": "string",
          "minLength": 1,
          "description": "base64url X25519 HPKE public key the requesting device controls and the responder seals to. SHOULD be the device hpke_key or the ephemeral key already established by the bound SAS verification transcript."
        }
      },
      "additionalProperties": true
    },
    "secret_send_content": {
      "type": "object",
      "description": "ck.secret.send to-device content (device-lifecycle.md §10.7). The existing authorized device returns the requested secret HPKE-sealed to the requester's recipient_hpke_public_key. The plaintext is never visible to the queue service.",
      "required": [
        "request_id",
        "secret_id",
        "from_device",
        "scheme",
        "enc",
        "ciphertext"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/transaction_id",
          "description": "Correlates to the pending ck.secret.request; MUST equal the request_id authenticated inside the sealed plaintext. Receivers MUST drop sends that do not match a locally pending request_id."
        },
        "secret_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "from_device": {
          "$ref": "#/$defs/device_id",
          "description": "Authorizing (existing) device; MUST equal envelope sender_device_id and MUST be a non-revoked device of the recipient principal."
        },
        "scheme": {
          "const": "ck.hpke_x25519_aead_xchacha20poly1305.v1"
        },
        "enc": {
          "type": "string",
          "minLength": 1,
          "description": "base64url HPKE (RFC 9180) encapsulated key (KEM output)."
        },
        "ciphertext": {
          "type": "string",
          "minLength": 1,
          "description": "base64url HPKE AEAD ciphertext over the secret plaintext. The HPKE AAD is the RFC 8785 JCS canonical JSON of {kind, sender_principal_id, sender_device_id, recipient_principal_id, recipient_device_id, expires_at_unix} where expires_at_unix is expires_at normalized to integer Unix seconds (device-lifecycle.md §10.7); both sides reconstruct it from the DeviceMessageEnvelope. Freshness for sent_at (server-assigned) is bound by the one-time request_id authenticated inside the sealed plaintext."
        }
      },
      "additionalProperties": true
    },
    "key_verification_content": {
      "type": "object",
      "required": [
        "transaction_id",
        "from_device"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "from_device": {
          "$ref": "#/$defs/device_id"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ck\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "uniqueItems": true
        },
        "method": {
          "type": "string",
          "pattern": "^ck\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "key_agreement_protocols": {
          "$ref": "#/$defs/string_list"
        },
        "hashes": {
          "$ref": "#/$defs/string_list"
        },
        "message_authentication_codes": {
          "$ref": "#/$defs/string_list"
        },
        "short_authentication_string": {
          "$ref": "#/$defs/string_list"
        },
        "commitment": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mac": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "keys": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified_keys": {
          "$ref": "#/$defs/string_list"
        },
        "signatures": {
          "type": "object"
        },
        "code": {
          "enum": [
            "user_cancelled",
            "timeout",
            "unknown_transaction",
            "unexpected_message",
            "unsupported_method",
            "unsupported_algorithm",
            "mismatched_commitment",
            "mismatched_mac",
            "device_revoked",
            "untrusted_device",
            "policy_denied",
            "accepted_by_other_device",
            "cross_signing_reset"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": true
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
