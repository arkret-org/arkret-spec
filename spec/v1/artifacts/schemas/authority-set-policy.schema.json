{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/authority-set-policy.schema.json",
  "title": "Arkret Authority Set Policy",
  "description": "A recovery or admission signer policy materialized by the current governance Station. It is not an offline publication lease.",
  "type": "object",
  "required": [
    "schema",
    "authority_set_id",
    "policy_kind",
    "scope_ref",
    "source_commit_id",
    "authorization_rules"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.authority_set_policy.v1"
    },
    "authority_set_id": {
      "type": "string",
      "pattern": "^ak\\.authority_set\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
    },
    "policy_kind": {
      "enum": [
        "principal_control",
        "realm_admission"
      ]
    },
    "scope_ref": {
      "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
    },
    "source_commit_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
    },
    "authorization_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "issuer_role",
          "allowed_actions",
          "issuers",
          "threshold"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "issuer_role": {
            "enum": [
              "identity_recovery",
              "accepted_device",
              "realm_admission"
            ]
          },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
            }
          },
          "issuers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "verification_method"
              ],
              "properties": {
                "verification_method": {
                  "$ref": "./common-ids.schema.json#/$defs/did_url"
                }
              },
              "additionalProperties": false
            }
          },
          "threshold": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
