{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/mls-welcome-refs.schema.json",
  "title": "Arkret MLS Welcome Recipient Discovery",
  "oneOf": [
    {
      "$ref": "#/$defs/welcome_refs_request"
    },
    {
      "$ref": "#/$defs/welcome_refs_outcome"
    }
  ],
  "$defs": {
    "welcome_refs_request": {
      "type": "object",
      "description": "Authenticated own-recipient discovery, not an arbitrary recipient query. Closed canonical request <=64 KiB. Cursor binds exact auth endpoint, scope/group, effective limit and frozen eligibility window.",
      "required": [
        "effective_scope",
        "mls_group_id"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./mls-governance-proof-bundle.schema.json#/$defs/effective_scope"
        },
        "mls_group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 65536
    },
    "welcome_refs_outcome": {
      "type": "object",
      "description": "Only next_cursor presence indicates another page. A nonterminal page MUST contain at least one item; no duplicated terminal flag is carried.",
      "required": [
        "welcome_refs"
      ],
      "properties": {
        "welcome_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/event_id"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "next_cursor"
            ]
          },
          "then": {
            "properties": {
              "welcome_refs": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "x-arkret-max-canonical-bytes": 65536
    }
  }
}
