{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup-active-series.schema.json",
  "title": "Arkret Key Backup Active Series Record",
  "description": "Signed principal-control record selecting the canonical backup series for one (actor_id, backup_kind). This closes the rollback gap when multiple series exist after compromise rotation or migration. Receivers MUST verify this record before choosing a series from list results.",
  "type": "object",
  "required": [
    "schema",
    "actor_id",
    "backup_kind",
    "active_series_id",
    "series_pointer_version",
    "previous_series_ids",
    "frontier_ref",
    "issued_at",
    "auth_data"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.key_backup_active_series.v1"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "backup_kind": {
      "$ref": "#/$defs/backup_kind"
    },
    "active_series_id": {
      "$ref": "#/$defs/backup_series_id"
    },
    "series_pointer_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly monotonic per (actor_id, backup_kind). The first record is 1 and every successor is previous+1; receivers reject rollback, gaps and same-version forks."
    },
    "previous_series_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/backup_series_id"
      },
      "description": "Retained old series used only for read-old-data or erasure transition. MUST NOT be treated as a primary recovery source."
    },
    "frontier_ref": {
      "$ref": "#/$defs/frontier_ref",
      "description": "Principal Control Realm frontier and current identity-root device generation under which active_series_id was selected."
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature",
        "signed_fields",
        "device_authorize_event_id"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url signature over canonical_json(record without auth_data.signature)."
        },
        "signed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "allOf": [
            {
              "contains": {
                "const": "schema"
              }
            },
            {
              "contains": {
                "const": "actor_id"
              }
            },
            {
              "contains": {
                "const": "backup_kind"
              }
            },
            {
              "contains": {
                "const": "active_series_id"
              }
            },
            {
              "contains": {
                "const": "series_pointer_version"
              }
            },
            {
              "contains": {
                "const": "previous_series_ids"
              }
            },
            {
              "contains": {
                "const": "frontier_ref"
              }
            },
            {
              "contains": {
                "const": "issued_at"
              }
            }
          ]
        },
        "device_authorize_event_id": {
          "type": "string",
          "pattern": "^ak:event:[A-Za-z0-9_-]{44}$",
          "description": "Accepted current-generation ak.device.authorize Event anchoring the device that signed this active-series selection."
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "backup_kind": {
      "type": "string",
      "enum": [
        "did_recovery",
        "secret_storage",
        "mls_history"
      ]
    },
    "backup_series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "frontier_ref": {
      "type": "object",
      "required": [
        "frontier_digest",
        "device_generation_ref"
      ],
      "properties": {
        "frontier_digest": {
          "$ref": "#/$defs/hash"
        },
        "seal_ref": {
          "type": "string",
          "pattern": "^ak:seal:(?:(?:sha256|blake3):[0-9a-f]{64})$"
        },
        "device_generation_ref": {
          "type": "string",
          "pattern": "^[1-9][0-9]*-[^\\s]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
