{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup-active-series.schema.json",
  "title": "Arkret Key Backup Active Series Record",
  "description": "Signed principal-control record selecting the backup series for one actor and backup kind. Servers verify the accepted record; ordinary clients consume BackupActiveSeriesState from their Account Station instead of replaying PCR history. Native records are signed by the real current manager Service, while record.actor_id is the target Realm actor. Source refs name strictly earlier accepted native writers; no self Event/Commit ID enters this preimage. The outer native manager Event is independently signed. Native version/predecessor comparison is scoped by full actor, exact effective_scope and backup_kind; Device publishers cannot select series. Recovery enabled=false is not a backup/series gate.",
  "type": "object",
  "required": [
    "schema",
    "actor_id",
    "backup_kind",
    "active_series_id",
    "series_pointer_version",
    "previous_series_ids",
    "issued_at",
    "signature_proof"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.key_backup_active_series.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "key-backup-active-series.schema.json#/properties/schema",
        "owner": "key-backup-active-series.schema.json#/properties/schema",
        "values": [
          "ak.schema.key_backup_active_series.v1"
        ]
      }
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "backup_kind": {
      "$ref": "#/$defs/backup_kind"
    },
    "active_series_id": {
      "$ref": "#/$defs/backup_series_id"
    },
    "series_pointer_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly monotonic per (actor_id, backup_kind). The first record is 1 and every successor is previous+1; receivers reject rollback, gaps and same-version forks."
    },
    "previous_series_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/backup_series_id"
      },
      "description": "Retained old series used only for read-old-data or erasure transition. MUST NOT be treated as a primary recovery source."
    },
    "source_commit_ref": {
      "$ref": "./key-backup.schema.json#/properties/source_commit_ref",
      "description": "Principal Control Realm source RealmCommit and current identity-root device generation under which active_series_id was selected."
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signature_proof": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ],
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "key-backup-active-series.schema.json#/properties/signature_proof/properties/signature_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url signature over RFC 8785 JCS(record without signature_proof.signature). The closed record shape fixes the authenticated projection."
        },
        "device_authorize_event_id": {
          "type": "string",
          "pattern": "^ak:event:[A-Za-z0-9_-]{44}$",
          "x-arkret-preimage-commitment": "fixed_event",
          "description": "Accepted current-generation ak.device.authorize Event anchoring the device that signed this active-series selection."
        }
      },
      "additionalProperties": false
    },
    "custodian_actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "custody_authorization_ref": {
      "$ref": "./common-ids.schema.json#/$defs/event_id",
      "x-arkret-preimage-commitment": "fixed_event"
    },
    "effective_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "key-backup-active-series.schema.json#/properties/effective_scope/oneOf/0/properties/kind",
                "owner": "key-backup-active-series.schema.json#/properties/effective_scope/oneOf/0/properties/kind",
                "values": [
                  "realm"
                ]
              }
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "key-backup-active-series.schema.json#/properties/effective_scope/oneOf/1/properties/kind",
                "owner": "key-backup-active-series.schema.json#/properties/effective_scope/oneOf/1/properties/kind",
                "values": [
                  "circle"
                ]
              }
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "./common-ids.schema.json#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "manager_ref": {
      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
    },
    "recovery_ref": {
      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
    },
    "recipient_ref": {
      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "backup_kind": {
      "type": "string",
      "enum": [
        "secret_storage"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "key-backup-active-series.schema.json#/$defs/backup_kind",
        "owner": "key-backup-active-series.schema.json#/$defs/backup_kind",
        "values": [
          "secret_storage"
        ]
      }
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    }
  },
  "dependentRequired": {
    "custodian_actor_id": [
      "custody_authorization_ref"
    ],
    "custody_authorization_ref": [
      "custodian_actor_id"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_id": {
            "properties": {
              "kind": {
                "const": "realm",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "key-backup-active-series.schema.json#/allOf/0/if/properties/actor_id/properties/kind",
                  "owner": "key-backup-active-series.schema.json#/allOf/0/if/properties/actor_id/properties/kind",
                  "values": [
                    "realm"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ],
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          }
        },
        "required": [
          "actor_id"
        ]
      },
      "then": {
        "required": [
          "effective_scope",
          "manager_ref",
          "recovery_ref",
          "recipient_ref"
        ],
        "properties": {
          "actor_id": {
            "$ref": "./common-ids.schema.json#/$defs/realm_actor"
          },
          "signature_proof": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "device_authorize_event_id"
                  ]
                }
              ]
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "source_commit_ref"
              ]
            },
            {
              "required": [
                "custodian_actor_id"
              ]
            },
            {
              "required": [
                "custody_authorization_ref"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "source_commit_ref"
        ],
        "properties": {
          "signature_proof": {
            "required": [
              "device_authorize_event_id"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "effective_scope"
              ]
            },
            {
              "required": [
                "manager_ref"
              ]
            },
            {
              "required": [
                "recovery_ref"
              ]
            },
            {
              "required": [
                "recipient_ref"
              ]
            }
          ]
        }
      }
    }
  ]
}
