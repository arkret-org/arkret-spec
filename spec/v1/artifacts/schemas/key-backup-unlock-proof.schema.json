{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup-unlock-proof.schema.json",
  "title": "Arkret Key Backup Unlock Proof",
  "description": "Exact single-object backup unlock intent signed by the accepted current device or by the verified recovery session frozen replacement identity key. Current authority and immutable object identity are rechecked even on exact replay. Native realm_actor_device is same-scope encrypted predecessor retrieval, not archive decryption authority. realm_actor_manager is exact current-manager archival ciphertext retrieval with a separate private capability. All native challenges bind actual current governor, actor/scope, original manager/policy, target packet/series/digest, audience and request epoch. No Account/PCR or current-key fallback. Native manager_ref/recovery_ref are current requester authority, not an instruction to rewrite or equate the target packet historical author refs. Original packet authorization/source remain frozen. Device series_predecessor unlock is only the exact current selected-series head; full actor/scope/requester/complete envelope digest/challenge bind together. Native envelope_digest is SHA256(JCS(complete original packet including signature_proof.signature)), never signature-excluding supersedes_digest. Exact target packet, ciphertext, current head for Device, current requester and original historical author remain distinct checked bindings.",
  "type": "object",
  "required": [
    "schema",
    "backup_id",
    "backup_kind",
    "series_id",
    "ciphertext_digest",
    "challenge",
    "issued_at",
    "signature_proof",
    "kind",
    "expires_at",
    "audience",
    "service_id"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.key_backup_unlock_proof.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "key-backup-unlock-proof.schema.json#/properties/schema",
        "owner": "key-backup-unlock-proof.schema.json#/properties/schema",
        "values": [
          "ak.schema.key_backup_unlock_proof.v1"
        ]
      }
    },
    "recovery_session_id": {
      "$ref": "#/$defs/recovery_session_id"
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id",
      "description": "Exact authenticated account pair; both principal and Station must equal the challenge or frozen recovery session."
    },
    "requesting_device_id": {
      "$ref": "#/$defs/device_id"
    },
    "backup_id": {
      "$ref": "#/$defs/backup_id"
    },
    "backup_kind": {
      "$ref": "#/$defs/backup_kind"
    },
    "series_id": {
      "$ref": "#/$defs/backup_series_id"
    },
    "ciphertext_digest": {
      "$ref": "#/$defs/digest"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Required exact server challenge: current-device challenge record, or recovery_session.challenge. Caller-minted values are forbidden."
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signature_proof": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "current_device: exact current accepted device method; recovery_session: the exact frozen requesting_device_public_key_did from the session. A recovery factor signer or arbitrary DID resolver fallback MUST NOT authorize this intent."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ],
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "key-backup-unlock-proof.schema.json#/properties/signature_proof/properties/signature_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url signature over RFC 8785 JCS(unlock proof without signature_proof.signature), including every present closed-branch field."
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "current_device",
        "recovery_session",
        "realm_actor_device",
        "realm_actor_manager"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "key-backup-unlock-proof.schema.json#/properties/kind",
        "owner": "key-backup-unlock-proof.schema.json#/properties/kind",
        "values": [
          "current_device",
          "recovery_session",
          "realm_actor_device",
          "realm_actor_manager"
        ]
      }
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "audience": {
      "$ref": "./keys-operations.schema.json#/$defs/non_empty_string",
      "description": "Exact authenticated service origin. Must equal the current-device server challenge origin or the recovery service origin bound by the authenticated recovery grant."
    },
    "service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "challenge_id": {
      "$ref": "./keys-operations.schema.json#/$defs/keys_backups_unlock_challenge/properties/challenge_id"
    },
    "subject_actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "custody_authorization_ref": {
      "$ref": "./common-ids.schema.json#/$defs/event_id",
      "x-arkret-preimage-commitment": "fixed_event"
    },
    "content_history": {
      "$ref": "./content-encryption.schema.json#/$defs/history_backup_access"
    },
    "realm_actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_actor_id"
    },
    "effective_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "key-backup-unlock-proof.schema.json#/properties/effective_scope/oneOf/0/properties/kind",
                "owner": "key-backup-unlock-proof.schema.json#/properties/effective_scope/oneOf/0/properties/kind",
                "values": [
                  "realm"
                ]
              }
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "key-backup-unlock-proof.schema.json#/properties/effective_scope/oneOf/1/properties/kind",
                "owner": "key-backup-unlock-proof.schema.json#/properties/effective_scope/oneOf/1/properties/kind",
                "values": [
                  "circle"
                ]
              }
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "./common-ids.schema.json#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "manager_ref": {
      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
    },
    "recovery_ref": {
      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
    },
    "recipient_ref": {
      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
    },
    "device_authorize_event_id": {
      "$ref": "./common-ids.schema.json#/$defs/event_id"
    },
    "device_generation": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "enum": [
        "series_predecessor",
        "archive_recovery"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "key-backup-unlock-proof.schema.json#/properties/purpose",
        "owner": "key-backup-unlock-proof.schema.json#/properties/purpose",
        "values": [
          "series_predecessor",
          "archive_recovery"
        ]
      }
    },
    "envelope_digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "backup_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_id"
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_kind": {
      "$ref": "./key-backup-active-series.schema.json#/$defs/backup_kind"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "current_device",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/0/properties/kind",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/0/properties/kind",
            "values": [
              "current_device"
            ]
          }
        }
      },
      "required": [
        "challenge_id",
        "account_id",
        "requesting_device_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "recovery_session_id"
            ]
          },
          {
            "required": [
              "envelope_digest"
            ]
          }
        ]
      },
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "realm_actor_id"
                ]
              },
              {
                "required": [
                  "effective_scope"
                ]
              },
              {
                "required": [
                  "manager_ref"
                ]
              },
              {
                "required": [
                  "recovery_ref"
                ]
              },
              {
                "required": [
                  "recipient_ref"
                ]
              },
              {
                "required": [
                  "device_authorize_event_id"
                ]
              },
              {
                "required": [
                  "device_generation"
                ]
              },
              {
                "required": [
                  "purpose"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "recovery_session",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/1/properties/kind",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/1/properties/kind",
            "values": [
              "recovery_session"
            ]
          }
        }
      },
      "required": [
        "recovery_session_id",
        "account_id",
        "requesting_device_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "challenge_id"
            ]
          },
          {
            "required": [
              "subject_actor_id"
            ]
          },
          {
            "required": [
              "custody_authorization_ref"
            ]
          },
          {
            "required": [
              "content_history"
            ]
          },
          {
            "required": [
              "envelope_digest"
            ]
          }
        ]
      },
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "realm_actor_id"
                ]
              },
              {
                "required": [
                  "effective_scope"
                ]
              },
              {
                "required": [
                  "manager_ref"
                ]
              },
              {
                "required": [
                  "recovery_ref"
                ]
              },
              {
                "required": [
                  "recipient_ref"
                ]
              },
              {
                "required": [
                  "device_authorize_event_id"
                ]
              },
              {
                "required": [
                  "device_generation"
                ]
              },
              {
                "required": [
                  "purpose"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "realm_actor_device",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/2/properties/kind",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/2/properties/kind",
            "values": [
              "realm_actor_device"
            ]
          }
        },
        "purpose": {
          "const": "series_predecessor",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/2/properties/purpose",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/2/properties/purpose",
            "values": [
              "series_predecessor"
            ]
          }
        },
        "signature_proof": {
          "properties": {
            "signature_algorithm": {
              "const": "Ed25519",
              "x-arkret-value-ownership": {
                "class": "external_literal",
                "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
                "owner": "key-backup-unlock-proof.schema.json#/oneOf/2/properties/signature_proof/properties/signature_algorithm",
                "values": [
                  "Ed25519"
                ]
              }
            }
          }
        }
      },
      "required": [
        "realm_actor_id",
        "effective_scope",
        "manager_ref",
        "recovery_ref",
        "recipient_ref",
        "purpose",
        "challenge_id",
        "requesting_device_id",
        "device_authorize_event_id",
        "device_generation",
        "envelope_digest"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "account_id"
            ]
          },
          {
            "required": [
              "recovery_session_id"
            ]
          },
          {
            "required": [
              "subject_actor_id"
            ]
          },
          {
            "required": [
              "custody_authorization_ref"
            ]
          },
          {
            "required": [
              "content_history"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "realm_actor_manager",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/3/properties/kind",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/3/properties/kind",
            "values": [
              "realm_actor_manager"
            ]
          }
        },
        "purpose": {
          "const": "archive_recovery",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/3/properties/purpose",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/3/properties/purpose",
            "values": [
              "archive_recovery"
            ]
          }
        },
        "signature_proof": {
          "properties": {
            "signature_algorithm": {
              "const": "Ed25519",
              "x-arkret-value-ownership": {
                "class": "external_literal",
                "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
                "owner": "key-backup-unlock-proof.schema.json#/oneOf/3/properties/signature_proof/properties/signature_algorithm",
                "values": [
                  "Ed25519"
                ]
              }
            }
          }
        }
      },
      "required": [
        "realm_actor_id",
        "effective_scope",
        "manager_ref",
        "recovery_ref",
        "recipient_ref",
        "purpose",
        "challenge_id",
        "envelope_digest"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "account_id"
            ]
          },
          {
            "required": [
              "recovery_session_id"
            ]
          },
          {
            "required": [
              "subject_actor_id"
            ]
          },
          {
            "required": [
              "custody_authorization_ref"
            ]
          },
          {
            "required": [
              "content_history"
            ]
          },
          {
            "required": [
              "requesting_device_id"
            ]
          },
          {
            "required": [
              "device_authorize_event_id"
            ]
          },
          {
            "required": [
              "device_generation"
            ]
          }
        ]
      }
    }
  ],
  "dependentRequired": {
    "subject_actor_id": [
      "custody_authorization_ref"
    ],
    "custody_authorization_ref": [
      "subject_actor_id"
    ]
  }
}
