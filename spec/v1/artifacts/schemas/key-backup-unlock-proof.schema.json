{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup-unlock-proof.schema.json",
  "title": "Arkret Key Backup Unlock Proof",
  "description": "Proof presented before a recovery strand downloads or unlocks a key-backup envelope. It binds a backup read/decrypt action to one recovery_session_id, requesting device, backup object, selected series, ciphertext digest, and the proof transcript accepted by the recovery session.",
  "type": "object",
  "required": [
    "schema",
    "recovery_session_id",
    "account_id",
    "requesting_device_id",
    "backup_id",
    "backup_kind",
    "series_id",
    "ciphertext_digest",
    "proof_kind",
    "proof_digest",
    "issued_at",
    "auth_data"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.key_backup_unlock_proof.v1"
    },
    "recovery_session_id": {
      "$ref": "#/$defs/recovery_session_id"
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id",
      "description": "Exact account that owns both the recovery session and backup. A verification method is checked only against account_id.principal_id; the accepted session independently binds account_id.station_id."
    },
    "requesting_device_id": {
      "$ref": "#/$defs/device_id"
    },
    "backup_id": {
      "$ref": "#/$defs/backup_id"
    },
    "backup_kind": {
      "$ref": "#/$defs/backup_kind"
    },
    "series_id": {
      "$ref": "#/$defs/backup_series_id"
    },
    "ciphertext_digest": {
      "$ref": "#/$defs/digest"
    },
    "proof_kind": {
      "$ref": "#/$defs/proof_kind"
    },
    "proof_digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest of the canonical recovery proof transcript that moved the session to verified."
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Optional echo of the recovery-session challenge; when present it MUST match the session snapshot."
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "DID URL for either the accepted requesting device key after authorization, or the recovery-session proof key before a recovery_public_key unlock."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url signature over RFC 8785 JCS(unlock proof without auth_data.signature). The closed proof shape fixes the authenticated projection, including challenge exactly when present."
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "backup_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_id"
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_kind": {
      "$ref": "./key-backup-active-series.schema.json#/$defs/backup_kind"
    },
    "proof_kind": {
      "type": "string",
      "enum": [
        "principal_signing",
        "recovery_unlock",
        "device_quorum",
        "trusted_recovery_service",
        "threshold_recovery"
      ]
    }
  }
}
