{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup-unlock-proof.schema.json",
  "title": "Arkret Key Backup Unlock Proof",
  "description": "Exact single-object backup unlock intent signed by the accepted current device or by the verified recovery session frozen replacement identity key. Current authority and immutable object identity are rechecked even on exact replay.",
  "type": "object",
  "required": [
    "schema",
    "account_id",
    "requesting_device_id",
    "backup_id",
    "backup_kind",
    "series_id",
    "ciphertext_digest",
    "challenge",
    "issued_at",
    "signature_proof",
    "kind",
    "expires_at",
    "audience",
    "service_id"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.key_backup_unlock_proof.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "key-backup-unlock-proof.schema.json#/properties/schema",
        "owner": "key-backup-unlock-proof.schema.json#/properties/schema",
        "values": [
          "ak.schema.key_backup_unlock_proof.v1"
        ]
      }
    },
    "recovery_session_id": {
      "$ref": "#/$defs/recovery_session_id"
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id",
      "description": "Exact authenticated account pair; both principal and Station must equal the challenge or frozen recovery session."
    },
    "requesting_device_id": {
      "$ref": "#/$defs/device_id"
    },
    "backup_id": {
      "$ref": "#/$defs/backup_id"
    },
    "backup_kind": {
      "$ref": "#/$defs/backup_kind"
    },
    "series_id": {
      "$ref": "#/$defs/backup_series_id"
    },
    "ciphertext_digest": {
      "$ref": "#/$defs/digest"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Required exact server challenge: current-device challenge record, or recovery_session.challenge. Caller-minted values are forbidden."
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signature_proof": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "current_device: exact current accepted device method; recovery_session: the exact frozen requesting_device_public_key_did from the session. A recovery factor signer or arbitrary DID resolver fallback MUST NOT authorize this intent."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ],
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "key-backup-unlock-proof.schema.json#/properties/signature_proof/properties/signature_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url signature over RFC 8785 JCS(unlock proof without signature_proof.signature), including every present closed-branch field."
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "current_device",
        "recovery_session"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "key-backup-unlock-proof.schema.json#/properties/kind",
        "owner": "key-backup-unlock-proof.schema.json#/properties/kind",
        "values": [
          "current_device",
          "recovery_session"
        ]
      }
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "audience": {
      "$ref": "./keys-operations.schema.json#/$defs/non_empty_string",
      "description": "Exact authenticated service origin. Must equal the current-device server challenge origin or the recovery service origin bound by the authenticated recovery grant."
    },
    "service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "challenge_id": {
      "$ref": "./keys-operations.schema.json#/$defs/keys_backups_unlock_challenge/properties/challenge_id"
    },
    "nonce": {
      "$ref": "./keys-operations.schema.json#/$defs/base64url"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "backup_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_id"
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_kind": {
      "$ref": "./key-backup-active-series.schema.json#/$defs/backup_kind"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "current_device",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/0/properties/kind",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/0/properties/kind",
            "values": [
              "current_device"
            ]
          }
        }
      },
      "required": [
        "challenge_id",
        "nonce"
      ],
      "not": {
        "required": [
          "recovery_session_id"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "recovery_session",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "key-backup-unlock-proof.schema.json#/oneOf/1/properties/kind",
            "owner": "key-backup-unlock-proof.schema.json#/oneOf/1/properties/kind",
            "values": [
              "recovery_session"
            ]
          }
        }
      },
      "required": [
        "recovery_session_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "challenge_id"
            ]
          },
          {
            "required": [
              "nonce"
            ]
          }
        ]
      }
    }
  ]
}
