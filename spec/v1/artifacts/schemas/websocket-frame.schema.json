{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/websocket-frame.schema.json",
  "title": "Arkret WebSocket Frame",
  "description": "Closed union of all application frames for ak.profile.binding.websocket.v1. Duplicate JSON member names and the advertised UTF-8 byte limit are enforced before JSON Schema validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/server_frame"
    },
    {
      "$ref": "#/$defs/client_frame"
    }
  ],
  "$defs": {
    "connection_id": {
      "$ref": "./account-operations.schema.json#/$defs/opaque_registration_id"
    },
    "nonce": {
      "$ref": "./account-operations.schema.json#/$defs/opaque_registration_id"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,64}$"
    },
    "operation_id": {
      "type": "string",
      "enum": [
        "ak.self.account.stream.subscribe.v1",
        "ak.self.committed_event.stream.subscribe.v1",
        "ak.self.signal.stream.subscribe.v1"
      ],
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "websocket-frame.schema.json#/$defs/operation_id",
        "owner": "websocket-frame.schema.json#/$defs/operation_id",
        "values": [
          "ak.self.account.stream.subscribe.v1",
          "ak.self.committed_event.stream.subscribe.v1",
          "ak.self.signal.stream.subscribe.v1"
        ]
      }
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "cursor": {
      "$ref": "./account-subscribe-frame.schema.json#/$defs/cursor_value"
    },
    "account_filter": {
      "$ref": "./account-subscribe-frame.schema.json#/$defs/account_filter"
    },
    "account_open_parameters": {
      "oneOf": [
        {
          "$ref": "./account-subscribe-frame.schema.json#/$defs/account_subscribe_parameters"
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "$ref": "#/$defs/cursor"
            },
            "catchup": {
              "type": "boolean"
            },
            "filter": {
              "$ref": "#/$defs/account_filter"
            },
            "wait_for": {
              "$ref": "#/$defs/cursor"
            },
            "realm_list_parameters": {
              "$ref": "./account-subscribe-frame.schema.json#/$defs/realm_list_parameters"
            },
            "replace_filter": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "replace_filter": {
                    "const": true,
                    "x-arkret-value-ownership": {
                      "class": "numeric",
                      "authority": "websocket-frame.schema.json#/$defs/account_open_parameters/oneOf/1/allOf/0/if/properties/replace_filter",
                      "owner": "websocket-frame.schema.json#/$defs/account_open_parameters/oneOf/1/allOf/0/if/properties/replace_filter",
                      "values": [
                        true
                      ]
                    }
                  }
                },
                "required": [
                  "replace_filter"
                ]
              },
              "then": {
                "required": [
                  "after",
                  "filter"
                ]
              }
            }
          ],
          "required": [
            "wait_for"
          ]
        }
      ]
    },
    "events_open_parameters": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "actor_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          }
        },
        "after": {
          "$ref": "#/$defs/cursor"
        },
        "catchup": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "realm_ids"
          ]
        },
        {
          "required": [
            "actor_ids"
          ]
        }
      ],
      "additionalProperties": false
    },
    "signal_open_parameters": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "challenge": {
      "type": "object",
      "required": [
        "kind",
        "connection_id",
        "nonce",
        "expires_at"
      ],
      "properties": {
        "kind": {
          "const": "challenge",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/challenge/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/challenge/properties/kind",
            "values": [
              "challenge"
            ]
          }
        },
        "connection_id": {
          "$ref": "#/$defs/connection_id"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "authenticate": {
      "type": "object",
      "required": [
        "kind",
        "connection_id",
        "session_grant",
        "dpop_proof"
      ],
      "properties": {
        "kind": {
          "const": "authenticate",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/authenticate/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/authenticate/properties/kind",
            "values": [
              "authenticate"
            ]
          }
        },
        "connection_id": {
          "$ref": "#/$defs/connection_id"
        },
        "session_grant": {
          "type": "string",
          "pattern": "^[\\u0021-\\u007E]+$",
          "minLength": 1,
          "maxLength": 16384
        },
        "dpop_proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "minLength": 32,
          "maxLength": 16384
        }
      },
      "additionalProperties": false
    },
    "welcome": {
      "type": "object",
      "required": [
        "kind",
        "connection_id",
        "max_frame_bytes",
        "max_channel_count",
        "max_connection_pending_bytes",
        "max_channel_pending_bytes",
        "max_connection_pending_frame_count",
        "max_channel_pending_frame_count",
        "heartbeat_interval_ms",
        "authentication_expires_at"
      ],
      "properties": {
        "kind": {
          "const": "welcome",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/welcome/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/welcome/properties/kind",
            "values": [
              "welcome"
            ]
          }
        },
        "connection_id": {
          "$ref": "#/$defs/connection_id"
        },
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "max_channel_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "x-arkret-member-role": "count"
        },
        "max_connection_pending_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "max_channel_pending_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "max_connection_pending_frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "x-arkret-member-role": "count"
        },
        "max_channel_pending_frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384,
          "x-arkret-member-role": "count"
        },
        "heartbeat_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        },
        "authentication_expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "open": {
      "oneOf": [
        {
          "$ref": "#/$defs/open_account"
        },
        {
          "$ref": "#/$defs/open_events"
        },
        {
          "$ref": "#/$defs/open_signal"
        }
      ]
    },
    "open_account": {
      "type": "object",
      "required": [
        "kind",
        "channel_id",
        "operation_id",
        "parameters"
      ],
      "properties": {
        "kind": {
          "const": "open",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/open_account/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/open_account/properties/kind",
            "values": [
              "open"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "operation_id": {
          "const": "ak.self.account.stream.subscribe.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "websocket-frame.schema.json#/$defs/open_account/properties/operation_id",
            "owner": "websocket-frame.schema.json#/$defs/open_account/properties/operation_id",
            "values": [
              "ak.self.account.stream.subscribe.v1"
            ]
          }
        },
        "parameters": {
          "$ref": "#/$defs/account_open_parameters"
        }
      },
      "additionalProperties": false
    },
    "open_events": {
      "type": "object",
      "required": [
        "kind",
        "channel_id",
        "operation_id",
        "parameters"
      ],
      "properties": {
        "kind": {
          "const": "open",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/open_events/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/open_events/properties/kind",
            "values": [
              "open"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "operation_id": {
          "const": "ak.self.committed_event.stream.subscribe.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "websocket-frame.schema.json#/$defs/open_events/properties/operation_id",
            "owner": "websocket-frame.schema.json#/$defs/open_events/properties/operation_id",
            "values": [
              "ak.self.committed_event.stream.subscribe.v1"
            ]
          }
        },
        "parameters": {
          "$ref": "#/$defs/events_open_parameters"
        }
      },
      "additionalProperties": false
    },
    "open_signal": {
      "type": "object",
      "required": [
        "kind",
        "channel_id",
        "operation_id",
        "parameters"
      ],
      "properties": {
        "kind": {
          "const": "open",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/open_signal/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/open_signal/properties/kind",
            "values": [
              "open"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "operation_id": {
          "const": "ak.self.signal.stream.subscribe.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "websocket-frame.schema.json#/$defs/open_signal/properties/operation_id",
            "owner": "websocket-frame.schema.json#/$defs/open_signal/properties/operation_id",
            "values": [
              "ak.self.signal.stream.subscribe.v1"
            ]
          }
        },
        "parameters": {
          "$ref": "#/$defs/signal_open_parameters"
        }
      },
      "additionalProperties": false
    },
    "opened": {
      "type": "object",
      "required": [
        "kind",
        "channel_id",
        "operation_id"
      ],
      "properties": {
        "kind": {
          "const": "opened",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/opened/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/opened/properties/kind",
            "values": [
              "opened"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": [
        "kind",
        "channel_id",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "data",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/data/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/data/properties/kind",
            "values": [
              "data"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "payload": {
          "$ref": "#/$defs/data_payload"
        }
      },
      "additionalProperties": false
    },
    "data_payload": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "./account-subscribe-frame.schema.json"
            },
            {
              "properties": {
                "kind": {
                  "const": "delta",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "websocket-frame.schema.json#/$defs/data_payload/oneOf/0/allOf/1/properties/kind",
                    "owner": "websocket-frame.schema.json#/$defs/data_payload/oneOf/0/allOf/1/properties/kind",
                    "values": [
                      "delta"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "./committed-event-subscribe-frame.schema.json"
            },
            {
              "properties": {
                "kind": {
                  "const": "committed_event",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "websocket-frame.schema.json#/$defs/data_payload/oneOf/1/allOf/1/properties/kind",
                    "owner": "websocket-frame.schema.json#/$defs/data_payload/oneOf/1/allOf/1/properties/kind",
                    "values": [
                      "committed_event"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "$ref": "./signal-stream-frame.schema.json#/$defs/signal"
        }
      ]
    },
    "channel_control_payload": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "./account-subscribe-frame.schema.json"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "catchup_complete",
                    "checkpoint",
                    "heartbeat",
                    "dropped",
                    "resync_required",
                    "unauthorized"
                  ],
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "websocket-frame.schema.json#/$defs/channel_control_payload/anyOf/0/allOf/1/properties/kind",
                    "owner": "websocket-frame.schema.json#/$defs/channel_control_payload/anyOf/0/allOf/1/properties/kind",
                    "values": [
                      "catchup_complete",
                      "checkpoint",
                      "heartbeat",
                      "dropped",
                      "resync_required",
                      "unauthorized"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "./committed-event-subscribe-frame.schema.json"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "checkpoint",
                    "heartbeat",
                    "catchup_complete",
                    "epoch_rotation",
                    "dropped",
                    "resync_required",
                    "unauthorized"
                  ],
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "websocket-frame.schema.json#/$defs/channel_control_payload/anyOf/1/allOf/1/properties/kind",
                    "owner": "websocket-frame.schema.json#/$defs/channel_control_payload/anyOf/1/allOf/1/properties/kind",
                    "values": [
                      "checkpoint",
                      "heartbeat",
                      "catchup_complete",
                      "epoch_rotation",
                      "dropped",
                      "resync_required",
                      "unauthorized"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "$ref": "./signal-stream-frame.schema.json#/$defs/heartbeat"
        },
        {
          "$ref": "./signal-stream-frame.schema.json#/$defs/drain"
        },
        {
          "$ref": "./signal-stream-frame.schema.json#/$defs/unauthorized"
        }
      ]
    },
    "connection_drain_payload": {
      "type": "object",
      "required": [
        "kind",
        "reconnect_after_ms",
        "close_at"
      ],
      "properties": {
        "kind": {
          "const": "drain",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/connection_drain_payload/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/connection_drain_payload/properties/kind",
            "values": [
              "drain"
            ]
          }
        },
        "reconnect_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "close_at": {
          "$ref": "#/$defs/timestamp",
          "x-arkret-member-role": "instant"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "control": {
      "oneOf": [
        {
          "$ref": "#/$defs/channel_control"
        },
        {
          "$ref": "#/$defs/connection_control"
        }
      ]
    },
    "channel_control": {
      "type": "object",
      "required": [
        "kind",
        "frame_scope",
        "channel_id",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "control",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/channel_control/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/channel_control/properties/kind",
            "values": [
              "control"
            ]
          }
        },
        "frame_scope": {
          "const": "channel",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/channel_control/properties/frame_scope",
            "owner": "websocket-frame.schema.json#/$defs/channel_control/properties/frame_scope",
            "values": [
              "channel"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "payload": {
          "$ref": "#/$defs/channel_control_payload"
        }
      },
      "additionalProperties": false
    },
    "connection_control": {
      "type": "object",
      "required": [
        "kind",
        "frame_scope",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "control",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/connection_control/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/connection_control/properties/kind",
            "values": [
              "control"
            ]
          }
        },
        "frame_scope": {
          "const": "connection",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/connection_control/properties/frame_scope",
            "owner": "websocket-frame.schema.json#/$defs/connection_control/properties/frame_scope",
            "values": [
              "connection"
            ]
          }
        },
        "payload": {
          "$ref": "#/$defs/connection_drain_payload"
        }
      },
      "additionalProperties": false
    },
    "error_body": {
      "type": "object",
      "required": [
        "error_code",
        "message"
      ],
      "properties": {
        "error_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "description": "Must resolve to a registered code in error-code-registry.json codes[]. This closed transport error body is not the HTTP RFC 9457 Problem Details."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        }
      },
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/channel_error"
        },
        {
          "$ref": "#/$defs/connection_error"
        }
      ]
    },
    "channel_error": {
      "type": "object",
      "required": [
        "kind",
        "frame_scope",
        "channel_id",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "error",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/channel_error/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/channel_error/properties/kind",
            "values": [
              "error"
            ]
          }
        },
        "frame_scope": {
          "const": "channel",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/channel_error/properties/frame_scope",
            "owner": "websocket-frame.schema.json#/$defs/channel_error/properties/frame_scope",
            "values": [
              "channel"
            ]
          }
        },
        "channel_id": {
          "$ref": "#/$defs/channel_id"
        },
        "error": {
          "$ref": "#/$defs/error_body"
        }
      },
      "additionalProperties": false
    },
    "connection_error": {
      "type": "object",
      "required": [
        "kind",
        "frame_scope",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "error",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/connection_error/properties/kind",
            "owner": "websocket-frame.schema.json#/$defs/connection_error/properties/kind",
            "values": [
              "error"
            ]
          }
        },
        "frame_scope": {
          "const": "connection",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "websocket-frame.schema.json#/$defs/connection_error/properties/frame_scope",
            "owner": "websocket-frame.schema.json#/$defs/connection_error/properties/frame_scope",
            "values": [
              "connection"
            ]
          }
        },
        "error": {
          "$ref": "#/$defs/error_body"
        }
      },
