{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-state-snapshot.schema.json",
  "title": "Arkret Realm Snapshot",
  "description": "Authority-signed typed materialization for current bootstrap. It includes only requester-visible streams and is followed by each stream's commit tail; it is not a typed current result tree, replay container or independent omission proof.",
  "type": "object",
  "required": [
    "snapshot_id",
    "realm_id",
    "governance_generation",
    "visible_stream_heads",
    "current_state_entries",
    "retention_and_history_floor",
    "created_at",
    "signature"
  ],
  "properties": {
    "snapshot_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_snapshot_id"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "governance_generation": {
      "type": "integer",
      "minimum": 0,
      "description": "Station tenure this snapshot is bound to. A consumer MUST refuse a snapshot whose generation is not the Realm's current governing Station tenure."
    },
    "visible_stream_heads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./realm-commit.schema.json#/$defs/stream_head"
      }
    },
    "current_state_entries": {
      "type": "array",
      "items": {
        "$ref": "./typed-current-result.schema.json"
      }
    },
    "retention_and_history_floor": {
      "type": "object",
      "required": [
        "history_access",
        "stream_floors"
      ],
      "properties": {
        "history_access": {
          "enum": [
            "since_join",
            "all_history_for_current_members"
          ]
        },
        "stream_floors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "stream_ref",
              "oldest_position"
            ],
            "properties": {
              "stream_ref": {
                "$ref": "./realm-commit.schema.json#/$defs/stream_ref"
              },
              "oldest_position": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "./detached-object-signature.schema.json#/$defs/realm_snapshot_signature"
    }
  },
  "additionalProperties": false
}
