{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/flow.schema.json",
  "title": "Contrix Flow",
  "type": "object",
  "required": [
    "id",
    "schema",
    "space_id",
    "title",
    "tracks",
    "created_by",
    "created_at"
  ],
  "not": {
    "required": [
      "body",
      "encrypted_payload"
    ]
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.flow.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "body": {
      "$ref": "#/$defs/content_block"
    },
    "encrypted_payload": {
      "$ref": "./encrypted-envelope.schema.json"
    },
    "fields": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted",
        "redacted"
      ]
    },
    "state_changed_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Reducer-derived timestamp of the most recent state transition. MUST be set when state != 'active'; MUST be the created_at of the corresponding cx.flow.archive / cx.flow.tombstone / redaction Event. Aligns with Place.state_changed_at and the common-fields rule in data-structures.md §3."
    },
    "tracks": {
      "type": "array",
      "description": "Active Flow tracks. Tracks are pure section pointers (synthesis vs discussion timeline) — they do NOT carry independent membership / permissions / history visibility / E2EE. Any sub-Space-level access scoping MUST be modelled as a child Space referenced via 'discussion_space_ref'. At most one track may explicitly set is_primary=true; when none does, the reducer derives the primary track by the deterministic rules in object-model-standard.md.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flow_track"
      },
      "contains": {
        "type": "object",
        "required": [
          "is_primary"
        ],
        "properties": {
          "is_primary": {
            "const": true
          }
        }
      },
      "minContains": 0,
      "maxContains": 1,
      "uniqueItems": true
    },
    "discussion_space_ref": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$",
      "description": "Optional reference to a child Space that hosts this Flow's discussion-side membership, history visibility, and (if E2EE) MLS group. Setting this fields means the discussion lives in its own security boundary distinct from the Flow's parent Space. When unset, discussion timeline events live in the parent Space and inherit its access. This replaces the v1 pre-rc 'track_scoped' hybrid (membership / permissions / history_visibility / e2ee scope fields)."
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "content_kind": {
      "type": "string",
      "pattern": "^(cx\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/content_kind"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        }
      },
      "additionalProperties": true
    },
    "track_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "flow_track": {
      "type": "object",
      "description": "Flow track — a pure section pointer (synthesis vs discussion timeline). Tracks do NOT carry independent membership / permissions / history visibility / E2EE. To give the discussion side its own security boundary, set Flow.discussion_space_ref to a child Space.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/track_name"
        },
        "is_primary": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "template": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
