{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/resource-selector.schema.json",
  "title": "Cokret Resource Selector",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "realm",
        "space",
        "circle",
        "flow",
        "message",
        "morph",
        "object",
        "relation",
        "view",
        "event",
        "actor",
        "schema",
        "policy",
        "invite",
        "notification",
        "read_cursor",
        "blob",
        "*"
      ]
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "space_id": {
      "type": "string",
      "pattern": "^ck:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "circle_id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id"
    },
    "object_type": {
      "type": "string"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^ck:(realm|space|circle|flow|message|morph|relation|view|event|policy|invite|blob):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical object reference. Acceptable typed-id kinds match the v1 resource selector kind enum (see resource-selector-grammar.md §3.1). Notably MUST NOT include 'actor_profile' (use the 'actor' selector with did pattern), nor non-canonical 'board' / 'list' / 'card' / 'subject' / 'room' kinds — board / list / swimlane / calendar bucket are Space objects and MUST use the 'space' kind together with the 'allowed_space_kinds' constraint to restrict which Space kinds the grant covers."
    },
    "flow_id": {
      "type": "string",
      "pattern": "^ck:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^ck:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "morph_id": {
      "type": "string",
      "pattern": "^ck:morph:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "morph_type": {
      "type": "string"
    },
    "relation_kind": {
      "type": "string"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^ck:relation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "view_id": {
      "type": "string",
      "pattern": "^ck:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/did",
      "description": "Concrete principal / service / agent DID. v1 forbids actor:*; actor selectors MUST NOT use a wildcard subject."
    },
    "schema_ref": {
      "type": "string"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^ck:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invite_id": {
      "type": "string",
      "pattern": "^ck:invite:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "match_scope": {
      "type": "string",
      "enum": [
        "exact",
        "subtree",
        "children",
        "realm_wide"
      ]
    }
  },
  "allOf": [
    {
      "$comment": "resource-selector-grammar.md §3.1: notification / read_cursor selectors are realm-scoped and the object part is *-only (notification:<realm>:* / read_cursor:<realm>:*). A bare {\"kind\":\"read_cursor\"} with no realm_id would otherwise match every principal's read cursors across all Realms (see C04-07). Force realm_id and forbid a precise object id (no notification_id / read_cursor_id field exists; selection is realm-wide *-only).",
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "notification",
              "read_cursor"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "realm_id"
        ]
      }
    }
  ],
  "additionalProperties": false
}
