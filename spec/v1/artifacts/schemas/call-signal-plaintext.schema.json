{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/call-signal-plaintext.schema.json",
  "title": "Arkret Call Signal Plaintext",
  "description": "Closed top-level plaintext object carried inside a SignalEnvelope encrypted_payload for ak.call.signal. The signal_kind-specific data object is validated by the corresponding normative branch in zh/crypto-media/webrtc-signaling.md.",
  "type": "object",
  "required": [
    "kind",
    "payload_sequence",
    "call_id",
    "signal_kind",
    "seq",
    "data"
  ],
  "properties": {
    "kind": {
      "const": "ak.call.signal"
    },
    "payload_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "description": "Strictly increasing but non-contiguous u64 within (sender_actor_id, sender_device_id, canonical scope_ref); arbitrary forward gaps are accepted. The complete ActorId is part of the sequence domain. It is independent of seq, the per-call anti-rollback sequence monotonic over (realm_id, call_id, actor_id, device_id)."
    },
    "call_id": {
      "type": "string",
      "pattern": "^ak:call:[A-Za-z0-9_-]{44}$"
    },
    "signal_kind": {
      "type": "string",
      "enum": [
        "invite",
        "answer",
        "candidate",
        "reject",
        "hangup",
        "renegotiate",
        "mute_state",
        "media_state",
        "speaking",
        "focus_join",
        "focus_leave",
        "moderation",
        "error",
        "ack"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object",
      "description": "Signal-kind-specific payload. Producers and consumers MUST additionally validate the closed field rules for the selected signal_kind in webrtc-signaling.md; this extension point is encrypted end-to-end and is not interpreted by the Signal service."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "signal_kind": {
            "const": "moderation"
          }
        },
        "required": [
          "signal_kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "kick",
                  "ban",
                  "end_for_all"
                ]
              },
              "target_actor_id": {
                "$ref": "./common-ids.schema.json#/$defs/actor_id"
              },
              "target_device_id": {
                "$ref": "./common-ids.schema.json#/$defs/device_id"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "kick"
                    }
                  }
                },
                "then": {
                  "required": [
                    "target_actor_id",
                    "target_device_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "ban"
                    }
                  }
                },
                "then": {
                  "required": [
                    "target_actor_id"
                  ],
                  "not": {
                    "required": [
                      "target_device_id"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "end_for_all"
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "target_actor_id"
                        ]
                      },
                      {
                        "required": [
                          "target_device_id"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
