{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/availability-receipt.schema.json",
  "title": "Arkret AvailabilityReceipt",
  "description": "Signed holder commitment that Event bytes are available until retention_expires_at. Digest membership roots do not prove byte availability; CBA models availability independently.",
  "type": "object",
  "required": [
    "realm_id",
    "event_id",
    "bytes_digest",
    "holder_id",
    "retention_expires_at",
    "signature"
  ],
  "properties": {
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "bytes_digest": {
      "$ref": "#/$defs/digest"
    },
    "holder_id": {
      "$ref": "#/$defs/did_core_id"
    },
    "retention_expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "signature": {
      "$ref": "#/$defs/proof"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "proof": {
      "type": "object",
      "required": [
        "kind",
        "verification_method",
        "payload_digest",
        "created_at",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "detached_jws"
        },
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest",
          "description": "Hash of canonical AvailabilityReceipt bytes with signature omitted."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.(?:[A-Za-z0-9_-]+)?\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
