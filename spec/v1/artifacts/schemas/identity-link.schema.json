{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/identity-link.schema.json",
  "title": "Arkret Historical MLS IdentityLink",
  "description": "Closed canonical plaintext retained only as exact historical MLS authentication material. This is not a current disclosure operation, lookup response, credential, membership grant, or a minimal_metadata_realm profile. The enclosing verified Event/Commit, MLS epoch and exact LeafNode remain mandatory authentication context.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "pairwise_id",
    "principal_id",
    "device_id",
    "realm_id",
    "trust_domain",
    "mls_leaf_index",
    "mls_epoch",
    "response_signing_verification_method",
    "response_signing_algorithm",
    "response_signing_public_key_base64url",
    "response_signing_public_key_digest",
    "effective_at",
    "proof"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.identity_link.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "identity-link.schema.json#/properties/schema",
        "owner": "identity-link.schema.json#/properties/schema",
        "values": [
          "ak.schema.identity_link.v1"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "identity-link.schema.json#/properties/status",
        "owner": "identity-link.schema.json#/properties/status",
        "values": [
          "active",
          "revoked"
        ]
      }
    },
    "pairwise_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "principal_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "device_id": {
      "$ref": "./common-ids.schema.json#/$defs/device_id"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "strand_id": {
      "$ref": "./strand.schema.json#/properties/id"
    },
    "track_name": {
      "type": "string",
      "minLength": 1
    },
    "mls_group_id": {
      "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
    },
    "mls_leaf_index": {
      "type": "integer",
      "minimum": 0
    },
    "mls_epoch": {
      "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
    },
    "response_signing_verification_method": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "response_signing_algorithm": {
      "const": "Ed25519",
      "x-arkret-value-ownership": {
        "class": "external_literal",
        "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
        "owner": "identity-link.schema.json#/properties/response_signing_algorithm",
        "values": [
          "Ed25519"
        ]
      }
    },
    "response_signing_public_key_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "x-arkret-member-role": "binary_encoding"
    },
    "response_signing_public_key_digest": {
      "$ref": "./event-envelope.schema.json#/$defs/digest"
    },
    "effective_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "disclosure_policy_id": {
      "$ref": "./policy.schema.json#/properties/id"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "proof": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm",
        "payload_digest",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "signature_algorithm": {
          "const": "Ed25519",
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "identity-link.schema.json#/$defs/proof/properties/signature_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        },
        "payload_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "proof_metadata": {
      "type": "object",
      "required": [
        "verification_method",
        "signature_algorithm"
      ],
      "properties": {
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "signature_algorithm": {
          "const": "Ed25519",
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "identity-link.schema.json#/$defs/proof_metadata/properties/signature_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "proof_preimage": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "pairwise_id",
        "principal_id",
        "device_id",
        "realm_id",
        "trust_domain",
        "mls_leaf_index",
        "mls_epoch",
        "response_signing_verification_method",
        "response_signing_algorithm",
        "response_signing_public_key_base64url",
        "response_signing_public_key_digest",
        "effective_at",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.identity_link.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "identity-link.schema.json#/$defs/proof_preimage/properties/schema",
            "owner": "identity-link.schema.json#/$defs/proof_preimage/properties/schema",
            "values": [
              "ak.schema.identity_link.v1"
            ]
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "identity-link.schema.json#/$defs/proof_preimage/properties/status",
            "owner": "identity-link.schema.json#/$defs/proof_preimage/properties/status",
            "values": [
              "active",
              "revoked"
            ]
          }
        },
        "pairwise_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "trust_domain": {
          "$ref": "./common-ids.schema.json#/$defs/trust_domain"
        },
        "strand_id": {
          "$ref": "./strand.schema.json#/properties/id"
        },
        "track_name": {
          "type": "string",
          "minLength": 1
        },
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "mls_leaf_index": {
          "type": "integer",
          "minimum": 0
        },
        "mls_epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "response_signing_verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "response_signing_algorithm": {
          "const": "Ed25519",
          "x-arkret-value-ownership": {
            "class": "external_literal",
            "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
            "owner": "identity-link.schema.json#/$defs/proof_preimage/properties/response_signing_algorithm",
            "values": [
              "Ed25519"
            ]
          }
        },
        "response_signing_public_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "x-arkret-member-role": "binary_encoding"
        },
        "response_signing_public_key_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/digest"
        },
        "effective_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "disclosure_policy_id": {
          "$ref": "./policy.schema.json#/properties/id"
        },
        "proof": {
          "$ref": "#/$defs/proof_metadata"
        }
      },
      "additionalProperties": false,
      "x-arkret-signature-domain": "ak.identity_link.v1",
      "dependentRequired": {
        "strand_id": [
          "track_name"
        ]
      }
    }
  },
  "dependentRequired": {
    "strand_id": [
      "track_name"
    ]
  }
}
