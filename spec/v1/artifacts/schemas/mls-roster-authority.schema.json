{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/mls-roster-authority.schema.json",
  "title": "Arkret MLS roster authority evidence",
  "description": "Station-signed historical Add authority and complete member-authorized roster read. Leaf indices and MLS secrets are never carried.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "mls_member_group_state_material_read_request_body": {
      "type": "object",
      "description": "Authenticated member read of accepted Genesis public RFC material at an exact target membership/history cut. The Account Station binds caller_actor_id to the session and forwards all selectors unchanged to governance.",
      "required": [
        "realm_id",
        "effective_scope",
        "mls_group_id",
        "epoch",
        "group_state_event_id",
        "caller_actor_id",
        "target_commit_event_ref",
        "target_epoch",
        "group_info_ref",
        "ratchet_tree_ref"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/realm_id"
        },
        "effective_scope": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/effective_scope"
        },
        "mls_group_id": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/mls_group_id"
        },
        "epoch": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/epoch"
        },
        "group_state_event_id": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/group_state_event_id"
        },
        "caller_actor_id": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/caller_actor_id"
        },
        "target_commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "target_epoch": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/target_epoch"
        },
        "group_info_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        },
        "ratchet_tree_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        },
        "max_response_bytes": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/MlsGroupStateMaterialRequestBody/properties/max_response_bytes"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "mls_add_authority_attestation": {
      "type": "object",
      "description": "For Account/Agent recipients, signed by the owning Account Station. For Realm actors, signed by the governance Station that actually accepts the Add; claim_authority_ref equals the original receipt's signed claim authority. Different claim and Add issuers require verified same-Realm authority succession and complete exact ledger import.",
      "required": [
        "attestor_station_id",
        "realm_id",
        "effective_scope",
        "mls_group_id",
        "genesis_event_ref",
        "commit_event_ref",
        "commit_stream_position",
        "epoch",
        "welcome_id",
        "claim_id",
        "actor_id",
        "endpoint",
        "authorization_event_ref",
        "leaf_signature_key_base64url",
        "claim_record_digest",
        "claim_receipt",
        "attested_at",
        "signature"
      ],
      "properties": {
        "attestor_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "commit_stream_position": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
          "not": {
            "enum": [
              "0"
            ],
            "x-arkret-value-ownership": {
              "class": "decimal_text",
              "authority": "mls-roster-authority.schema.json#/$defs/mls_add_authority_attestation/properties/epoch/not",
              "owner": "mls-roster-authority.schema.json#/$defs/mls_add_authority_attestation/properties/epoch/not",
              "values": [
                "0"
              ]
            }
          }
        },
        "welcome_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_welcome_delivery_id"
        },
        "claim_id": {
          "$ref": "./mls-welcome-delivery.schema.json#/properties/keypackage_claim_ref"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "endpoint": {
          "$ref": "./mls-welcome-delivery.schema.json#/properties/recipient_endpoint"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "leaf_signature_key_base64url": {
          "$ref": "#/$defs/signature_key",
          "x-arkret-member-role": "binary_encoding"
        },
        "claim_record_digest": {
          "$ref": "#/$defs/digest"
        },
        "claim_receipt": {
          "$ref": "./keypackage-operations.schema.json#/$defs/peer_keypackage_claim_receipt"
        },
        "claim_authority_ref": {
          "$ref": "./realm-commit.schema.json#/properties/authority_ref"
        },
        "attested_at": {
          "$ref": "./event-payload.schema.json#/$defs/timestamp"
        },
        "signature": {
          "$ref": "./keypackage-operations.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "actor_id": {
                "$ref": "./common-ids.schema.json#/$defs/realm_actor"
              }
            },
            "required": [
              "actor_id"
            ]
          },
          "then": {
            "required": [
              "claim_authority_ref"
            ],
            "properties": {
              "endpoint": {
                "properties": {
                  "kind": {
                    "const": "device",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "mls-roster-authority.schema.json#/$defs/mls_add_authority_attestation/allOf/0/then/properties/endpoint/properties/kind",
                      "owner": "mls-roster-authority.schema.json#/$defs/mls_add_authority_attestation/allOf/0/then/properties/endpoint/properties/kind",
                      "values": [
                        "device"
                      ]
                    }
                  }
                }
              },
              "claim_receipt": {
                "required": [
                  "claim_authority_ref"
                ],
                "properties": {
                  "request": {
                    "required": [
                      "target_actor_id"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "claim_authority_ref"
                  ]
                }
              ]
            },
            "properties": {
              "claim_receipt": {
                "properties": {
                  "request": {
                    "not": {
                      "required": [
                        "target_actor_id"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "mls_add_authority_attest_request_body": {
      "type": "object",
      "description": "Transport-only full claim outcome lets governance verify the destination receipt's claims_digest before retaining only the signed minimal attestation. It is never returned by roster read.",
      "required": [
        "attestation",
        "claim_outcome"
      ],
      "properties": {
        "attestation": {
          "$ref": "#/$defs/mls_add_authority_attestation"
        },
        "claim_outcome": {
          "$ref": "./keypackage-operations.schema.json#/$defs/keypackages_claim_response_body",
          "x-arkret-outcome-scope": "origin_keypackage_claim_attempt"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "attest_add_response_body": {
      "type": "object",
      "required": [
        "status",
        "attestation_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "installed",
            "duplicate"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mls-roster-authority.schema.json#/$defs/attest_add_response_body/properties/status",
            "owner": "mls-roster-authority.schema.json#/$defs/attest_add_response_body/properties/status",
            "values": [
              "installed",
              "duplicate"
            ]
          }
        },
        "attestation_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "mls_member_roster_authority_read_request_body": {
      "type": "object",
      "required": [
        "realm_id",
        "effective_scope",
        "mls_group_id",
        "target_commit_event_ref",
        "target_epoch",
        "caller_actor_id"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "target_commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "target_epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "caller_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "description": "Authenticated own-Station member selector. The Station authorizes the exact accepted target and derives Genesis from immutable accepted provenance in the same read cut; the member need not read a prejoin Genesis or a complete current baseline.",
      "x-arkret-name-role": "request_body"
    },
    "mls_roster_authority_read_request_body": {
      "type": "object",
      "required": [
        "realm_id",
        "effective_scope",
        "mls_group_id",
        "genesis_event_ref",
        "target_commit_event_ref",
        "target_epoch",
        "caller_actor_id"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "target_commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "target_epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "caller_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "roster_genesis_record": {
      "type": "object",
      "required": [
        "kind",
        "genesis_event_ref",
        "actor_id",
        "leaf_signature_key_base64url",
        "endpoint",
        "authorization_event_ref"
      ],
      "properties": {
        "kind": {
          "const": "genesis",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mls-roster-authority.schema.json#/$defs/roster_genesis_record/properties/kind",
            "owner": "mls-roster-authority.schema.json#/$defs/roster_genesis_record/properties/kind",
            "values": [
              "genesis"
            ]
          }
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "leaf_signature_key_base64url": {
          "$ref": "#/$defs/signature_key",
          "x-arkret-member-role": "binary_encoding"
        },
        "endpoint": {
          "$ref": "./mls-welcome-delivery.schema.json#/properties/recipient_endpoint"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "roster_add_record": {
      "type": "object",
      "required": [
        "kind",
        "commit_event_ref",
        "consumed_proposal_ordinal",
        "sender_actor_id",
        "proposal_wire_base64url",
        "attestation",
        "attestor_resolution"
      ],
      "properties": {
        "kind": {
          "const": "add",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mls-roster-authority.schema.json#/$defs/roster_add_record/properties/kind",
            "owner": "mls-roster-authority.schema.json#/$defs/roster_add_record/properties/kind",
            "values": [
              "add"
            ]
          }
        },
        "commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "consumed_proposal_ordinal": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based index of this inline Add in the accepted Commit PublicMessage's ProposalOrRef vector, counting every consumed Proposal kind."
        },
        "sender_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "proposal_wire_base64url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Canonical unpadded base64url of the exact TLS-serialized RFC 9420 Proposal body at consumed_proposal_ordinal in the accepted, signed Commit PublicMessage. It is never an independent Proposal handshake input or a synthetic ProposalRef.",
          "x-arkret-member-role": "binary_encoding"
        },
        "attestation": {
          "$ref": "#/$defs/mls_add_authority_attestation"
        },
        "claim_issuer_resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/authenticated_service_resolution",
          "description": "Required only for Realm actor Add records, even when both issuers are equal. Immutable complete Station method history frozen from the actual claim; service_id equals claim_receipt.destination_id and validates its signature at claimed_at. Not a current route."
        },
        "attestor_resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/authenticated_service_resolution",
          "description": "Immutable complete Station method history frozen with the Add. service_id equals attestation.attestor_station_id and validates its signature at attested_at. Account/Agent also verifies the same Station claim signature using this closure; Realm actor uses its separate claim_issuer_resolution. Not a current route."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "attestation": {
                "properties": {
                  "actor_id": {
                    "$ref": "./common-ids.schema.json#/$defs/realm_actor"
                  }
                },
                "required": [
                  "actor_id"
                ]
              }
            },
            "required": [
              "attestation"
            ]
          },
          "then": {
            "required": [
              "claim_issuer_resolution"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "claim_issuer_resolution"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "roster_record": {
      "oneOf": [
        {
          "$ref": "#/$defs/roster_genesis_record"
        },
        {
          "$ref": "#/$defs/roster_add_record"
        }
      ]
    },
    "roster_manifest": {
      "type": "object",
      "description": "Governance Station signature covers every member except signature, including both immutable Blob refs copied from the exact accepted Genesis. A later-joined member verifies this manifest before using those refs in the member public material request. records_digest is SHA-256 over RFC 8785 JCS of the complete ordered roster_record array, independent of page boundaries.",
      "required": [
        "governance_station_id",
        "realm_id",
        "effective_scope",
        "mls_group_id",
        "genesis_event_ref",
        "group_info_ref",
        "ratchet_tree_ref",
        "target_commit_event_ref",
        "target_epoch",
        "authority_head_commit_event_ref",
        "caller_actor_id",
        "total_record_count",
        "page_count",
        "records_digest",
        "issued_at",
        "signature"
      ],
      "properties": {
        "governance_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "mls_group_id": {
          "$ref": "./common-ids.schema.json#/$defs/mls_group_id"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "group_info_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        },
        "ratchet_tree_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        },
        "target_commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "target_epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "authority_head_commit_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "caller_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "total_record_count": {
          "type": "integer",
          "minimum": 1,
          "x-arkret-member-role": "count"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "x-arkret-member-role": "count"
        },
        "records_digest": {
          "$ref": "#/$defs/digest"
        },
        "issued_at": {
          "$ref": "./event-payload.schema.json#/$defs/timestamp"
        },
        "signature": {
          "$ref": "./keypackage-operations.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "roster_read_response_body": {
      "type": "object",
      "description": "One governance-signed page containing the longest continuous prefix of 1..8 complete records that fits the 2 MiB canonical JSON response limit. Pages are cut-bound, and next_cursor identifies the next record offset; no caller-selected page size or partial record is permitted. Page boundaries also include the exact self-only signing-key projection budget; either envelope exceeding 2 MiB makes the complete roster unavailable.",
      "required": [
        "manifest",
        "page_index",
        "records"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/roster_manifest"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/roster_record"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "roster_signing_key": {
      "type": "object",
      "description": "Public key selected by the authenticated own Account Station for the enclosing exact signed object and its original timestamp. A DID URL is only a key selector; this result is not portable authority or a resolver source.",
      "required": [
        "verification_method",
        "public_key_base64url"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "public_key_base64url": {
          "$ref": "#/$defs/signature_key",
          "x-arkret-member-role": "binary_encoding"
        }
      },
      "additionalProperties": false
    },
    "roster_add_signing_keys": {
      "type": "object",
      "required": [
        "record_digest",
        "claim_receipt_signing_key",
        "attestation_signing_key"
      ],
      "properties": {
        "record_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 of RFC 8785 JCS of the exact complete Add record on this page, including frozen closure."
        },
        "claim_receipt_signing_key": {
          "$ref": "#/$defs/roster_signing_key"
        },
        "attestation_signing_key": {
          "$ref": "#/$defs/roster_signing_key"
        }
      },
      "additionalProperties": false
    },
    "self_roster_read_response_body": {
      "type": "object",
      "description": "Non-portable authenticated own-Station result. roster is the unchanged signed governance page. Exactly one key entry per Add record on that page, in the same order; no entry for Genesis. Keys bind exact signature kid, purpose, timestamp and record digest; current or remote self-asserted keys cannot substitute. Entire canonical response is at most 2 MiB.",
      "required": [
        "roster",
        "manifest_signing_key",
        "add_signing_keys"
      ],
      "properties": {
        "roster": {
          "$ref": "#/$defs/roster_read_response_body"
        },
        "manifest_signing_key": {
          "$ref": "#/$defs/roster_signing_key"
        },
        "add_signing_keys": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/roster_add_signing_keys"
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    }
  }
}
