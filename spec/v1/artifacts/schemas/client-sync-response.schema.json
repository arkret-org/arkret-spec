{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/client-sync-response.schema.json",
  "title": "Contrix Client Sync Response",
  "type": "object",
  "required": [
    "next_batch"
  ],
  "properties": {
    "next_batch": {
      "$ref": "#/$defs/cursor_value"
    },
    "spaces": {
      "type": "object",
      "properties": {
        "join": {
          "$ref": "#/$defs/space_bucket"
        },
        "invite": {
          "$ref": "#/$defs/space_bucket"
        },
        "knock": {
          "$ref": "#/$defs/space_bucket"
        },
        "leave": {
          "$ref": "#/$defs/space_bucket"
        }
      },
      "additionalProperties": false
    },
    "to_device": {
      "$ref": "#/$defs/device_message_container"
    },
    "device_lists": {
      "type": "object"
    },
    "account_data": {
      "$ref": "#/$defs/event_container"
    },
    "presence": {
      "$ref": "#/$defs/event_container"
    },
    "notifications": {
      "$ref": "#/$defs/event_container"
    },
    "partial": {
      "type": "boolean"
    },
    "priority": {
      "type": "string"
    }
  },
  "$defs": {
    "cursor_value": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cx:cursor:.+$"
        },
        {
          "$ref": "./cursor.schema.json"
        }
      ]
    },
    "event_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "device_message_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./device-message.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "type": "object",
      "required": [
        "events",
        "limited"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        },
        "limited": {
          "type": "boolean"
        },
        "prev_batch": {
          "$ref": "#/$defs/cursor_value"
        }
      },
      "additionalProperties": true
    },
    "space_entry": {
      "type": "object",
      "properties": {
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "state": {
          "$ref": "#/$defs/event_container"
        },
        "state_after": {
          "$ref": "#/$defs/event_container"
        },
        "ephemeral": {
          "$ref": "#/$defs/event_container"
        },
        "account_data": {
          "$ref": "#/$defs/event_container"
        },
        "summary": {
          "type": "object"
        },
        "unread_notifications": {
          "type": "object"
        },
        "move_states": {
          "type": "array",
          "description": "Per-Move protocol-state views (move_id + move_state + optional bottom diagnostic) for Moves carried by this entry. See zh/sync/service-surface.md §5.5.",
          "items": {
            "type": "object",
            "required": [
              "move_id",
              "move_state"
            ],
            "properties": {
              "move_id": {
                "type": "string",
                "pattern": "^cx:move:(?:(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
              },
              "move_state": {
                "type": "string",
                "enum": [
                  "pending_anchor",
                  "effective",
                  "failed_precondition",
                  "failed_bottom",
                  "rejected_anchor",
                  "anchorer_paused"
                ]
              },
              "bottom": {
                "$ref": "./bottom.schema.json"
              }
            },
            "additionalProperties": false
          }
        },
        "bottoms": {
          "type": "array",
          "description": "Structured Bottom diagnostics for cells whose effective Lattice join resolved to ⊥ under the current Anchor view. Each entry pins (cell, status, bottom). See zh/sync/service-surface.md §5.5.",
          "items": {
            "type": "object",
            "required": [
              "cell",
              "status",
              "bottom"
            ],
            "properties": {
              "cell": {
                "type": "string",
                "pattern": "^cx:cell:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "bottom",
                  "conflict"
                ]
              },
              "bottom": {
                "$ref": "./bottom.schema.json"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "space_bucket": {
      "type": "object",
      "patternProperties": {
        "^cx:space:[0-9a-hjkmnp-z]{26}$": {
          "$ref": "#/$defs/space_entry"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
