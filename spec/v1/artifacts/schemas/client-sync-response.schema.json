{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/client-sync-response.schema.json",
  "title": "Contrix Client Sync Response",
  "type": "object",
  "required": [
    "cursor"
  ],
  "properties": {
    "cursor": {
      "$ref": "#/$defs/cursor_value",
      "description": "Stream cursor (purpose='stream') describing the frontier covered by this response. Pass it back as the 'since' field on the next /sync call."
    },
    "spaces": {
      "type": "object",
      "properties": {
        "join": {
          "$ref": "#/$defs/space_bucket"
        },
        "invite": {
          "$ref": "#/$defs/space_bucket"
        },
        "knock": {
          "$ref": "#/$defs/space_bucket"
        },
        "leave": {
          "$ref": "#/$defs/space_bucket"
        }
      },
      "additionalProperties": false
    },
    "to_device": {
      "$ref": "#/$defs/device_message_container"
    },
    "device_lists": {
      "type": "object"
    },
    "account_data": {
      "$ref": "#/$defs/event_container"
    },
    "presence": {
      "$ref": "#/$defs/event_container"
    },
    "notifications": {
      "$ref": "#/$defs/event_container"
    },
    "partial": {
      "type": "boolean"
    },
    "priority": {
      "type": "string"
    }
  },
  "$defs": {
    "cursor_value": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cx:cursor:.+$"
        },
        {
          "$ref": "./cursor.schema.json"
        }
      ]
    },
    "event_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "device_message_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./device-message.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "type": "object",
      "required": [
        "events",
        "limited"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        },
        "limited": {
          "type": "boolean"
        },
        "prev_cursor": {
          "$ref": "#/$defs/cursor_value",
          "description": "Stream cursor pointing backward in the timeline for backfilling history before this batch."
        }
      },
      "additionalProperties": true
    },
    "space_entry": {
      "type": "object",
      "properties": {
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "state": {
          "$ref": "#/$defs/event_container"
        },
        "state_after": {
          "$ref": "#/$defs/event_container"
        },
        "ephemeral": {
          "$ref": "#/$defs/event_container"
        },
        "account_data": {
          "$ref": "#/$defs/event_container"
        },
        "summary": {
          "type": "object"
        },
        "unread_notifications": {
          "type": "object"
        },
        "event_states": {
          "type": "array",
          "description": "Per-event protocol-state views (event_id + event_state) for reducer-input events carried by this entry. The 'bottom' detail object lives separately in 'bottoms' below — keyed by cell, not duplicated per event — so wire body is not doubled. Receivers correlate event_state=failed_bottom with the cell-level bottom diagnostic via the cells listed in bottom.cells[]. See zh/sync/service-surface.md §5.5.",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "event_state"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
              },
              "event_state": {
                "type": "string",
                "enum": [
                  "pending_anchor",
                  "effective",
                  "failed_precondition",
                  "failed_bottom",
                  "rejected_anchor",
                  "anchorer_paused"
                ]
              },
              "reason": {
                "type": "string",
                "description": "Optional short reason code (e.g., 'recovery_witness_missing'). For failure detail beyond the enum."
              }
            },
            "additionalProperties": false
          }
        },
        "bottoms": {
          "type": "array",
          "description": "Structured Bottom diagnostics for cells whose effective Lattice join resolved to ⊥ under the current Anchor view. Each entry pins (cell, status, bottom). See zh/sync/service-surface.md §5.5.",
          "items": {
            "type": "object",
            "required": [
              "cell",
              "status",
              "bottom"
            ],
            "properties": {
              "cell": {
                "type": "string",
                "pattern": "^cx:cell:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "bottom",
                  "conflict"
                ]
              },
              "bottom": {
                "$ref": "./bottom.schema.json"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "space_bucket": {
      "type": "object",
      "patternProperties": {
        "^cx:space:[0-9a-hjkmnp-z]{26}$": {
          "$ref": "#/$defs/space_entry"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
