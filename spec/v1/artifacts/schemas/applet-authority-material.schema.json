{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-authority-material.schema.json",
  "title": "Arkret Applet Authority Material",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/outcome"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "effective_scope",
        "grant_ids"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "grant_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./agent-operations.schema.json#/$defs/grant_id"
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 4194304
    },
    "outcome": {
      "type": "object",
      "required": [
        "applet_id",
        "service_id",
        "effective_scope",
        "registration",
        "grant_events",
        "current_results",
        "current_binding"
      ],
      "properties": {
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "registration": {
          "$ref": "./applet-edge-operations.schema.json#/$defs/applet_committed_event"
        },
        "grant_events": {
          "type": "array",
          "items": {
            "$ref": "./applet-edge-operations.schema.json#/$defs/applet_committed_event"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "current_results": {
          "type": "array",
          "items": {
            "$ref": "./exact-current-results-read.schema.json#/$defs/exact_current_result_present"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "current_binding": {
          "$ref": "#/$defs/current_binding"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 4194304
    },
    "current_binding": {
      "description": "Same-cut current effective installation of the authenticated Service in the exact Applet scope. Historical material access and creation confirmation do not require active status. Unknown authority or dependencies fail the entire read.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "registration_ref",
            "registration_epoch",
            "service_id"
          ],
          "properties": {
            "status": {
              "const": "active"
            },
            "registration_ref": {
              "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
            },
            "registration_epoch": {
              "$ref": "./applet-package.schema.json#/$defs/digest"
            },
            "service_id": {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "inactive"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
