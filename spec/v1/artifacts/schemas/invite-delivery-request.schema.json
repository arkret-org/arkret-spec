{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/invite-delivery-request.schema.json",
  "title": "Cokret Invite Delivery Request",
  "description": "Private service-to-service request used by an inviter-side Principal Server to deliver a Realm invite to the invitee-side Principal Server. The request carries an explicit invite address and introduction evidence; raw locator tokens are never written into durable Realm events.",
  "type": "object",
  "required": [
    "schema",
    "invite_event",
    "invite_address",
    "introduction_evidence",
    "idempotency_key"
  ],
  "properties": {
    "schema": {
      "const": "ck.schema.invite_delivery_request.v1"
    },
    "invite_event": {
      "$ref": "./event-envelope.schema.json",
      "description": "The ck.invite.create EventEnvelope or equivalent accepted event view being delivered."
    },
    "invite_address": {
      "$ref": "#/$defs/invite_address"
    },
    "introduction_evidence": {
      "$ref": "#/$defs/introduction_evidence"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false,
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "event_ref": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invite_address": {
      "type": "object",
      "required": [
        "subject_id",
        "recipient_service_did"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/did",
          "description": "Principal DID of the invite recipient. v1 core defaults principal DIDs to did:webvh; did:web is only valid for principal identity when an explicit deployment profile or resolver policy allows it."
        },
        "recipient_service_did": {
          "$ref": "#/$defs/did",
          "description": "Principal Server service DID that accepts invite delivery for subject_id."
        },
        "recipient_service_type": {
          "const": "principal_server",
          "description": "v1 only allows Principal Server invite delivery. Omit by default; if present, the value MUST be principal_server."
        }
      },
      "additionalProperties": false
    },
    "invite_delivery_target": {
      "type": "object",
      "required": [
        "recipient_service_did"
      ],
      "properties": {
        "recipient_service_did": {
          "$ref": "#/$defs/did"
        },
        "recipient_service_type": {
          "const": "principal_server",
          "description": "v1 only allows Principal Server invite delivery. Omit by default; if present, the value MUST be principal_server."
        }
      },
      "additionalProperties": false
    },
    "introduction_evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/locator_ref_evidence"
        },
        {
          "$ref": "#/$defs/shared_realm_evidence"
        },
        {
          "$ref": "#/$defs/same_principal_server_evidence"
        },
        {
          "$ref": "#/$defs/explicit_address_evidence"
        }
      ]
    },
    "locator_ref_evidence": {
      "type": "object",
      "required": [
        "kind",
        "principal_locator"
      ],
      "properties": {
        "kind": {
          "const": "locator_ref"
        },
        "principal_locator": {
          "$ref": "./principal-locator.schema.json"
        }
      },
      "additionalProperties": false
    },
    "shared_realm_evidence": {
      "type": "object",
      "required": [
        "kind",
        "realm_id",
        "inviter_member_ref",
        "invitee_member_ref"
      ],
      "properties": {
        "kind": {
          "const": "shared_realm"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "inviter_member_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "invitee_member_ref": {
          "$ref": "#/$defs/event_ref"
        }
      },
      "additionalProperties": false
    },
    "same_principal_server_evidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "same_principal_server"
        }
      },
      "additionalProperties": false
    },
    "explicit_address_evidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "explicit_address"
        }
      },
      "additionalProperties": false
    },
    "invite_delivery_outcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "duplicate",
            "deferred"
          ],
          "description": "Generic receive status. It MUST NOT reveal whether subject_id exists or whether policy quarantined/dropped the invite unless receiver policy explicitly allows disclosure."
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
