{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/extension-manifest.schema.json",
  "title": "Arkret Extension Manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "extension_id",
    "namespace",
    "protocol_layer_kind",
    "manifest_digest",
    "publisher_id",
    "published_at",
    "dependency_refs",
    "payload_schema_refs",
    "reducer_contract_refs",
    "required_actions",
    "confidentiality_class",
    "transport_rail_ids",
    "recovery_profile_ref",
    "federation_profile_ref",
    "conformance_vector_refs",
    "resource_limits",
    "proofs"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^ak\\.manifest\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
    },
    "extension_id": {
      "type": "string",
      "pattern": "^ak\\.extension\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "protocol_layer_kind": {
      "type": "string",
      "enum": [
        "collaboration_base",
        "extension"
      ]
    },
    "manifest_digest": {
      "$ref": "#/$defs/hash"
    },
    "publisher_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "published_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "dependency_refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/registry_content_ref"
      }
    },
    "payload_schema_refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/registry_content_ref"
      }
    },
    "reducer_contract_refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/reducer_contract_ref"
      }
    },
    "required_actions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
      }
    },
    "confidentiality_class": {
      "type": "string",
      "enum": [
        "plaintext_allowed",
        "recipient_encrypted",
        "e2ee_required"
      ]
    },
    "transport_rail_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
      }
    },
    "recovery_profile_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
        },
        {
          "type": "null"
        }
      ]
    },
    "federation_profile_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conformance_vector_refs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/registry_content_ref"
      }
    },
    "resource_limits": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "max_canonical_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "max_item_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_operation_count_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "./event-envelope.schema.json#/$defs/proof"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "registry_content_ref": {
      "type": "object",
      "required": [
        "registry_id",
        "digest"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$",
          "description": "Versioned registry symbol for a dependency, payload schema, or conformance vector."
        },
        "digest": {
          "$ref": "#/$defs/hash"
        },
        "retrieval_url": {
          "type": "string",
          "format": "uri",
          "description": "Optional retrieval hint only. The registry_id plus digest, not this URL, identifies the referenced content."
        }
      },
      "additionalProperties": false
    },
    "reducer_contract_ref": {
      "type": "object",
      "required": [
        "reducer_contract_id",
        "digest",
        "lattice_profile_ref",
        "concurrency_class"
      ],
      "properties": {
        "reducer_contract_id": {
          "type": "string",
          "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
        },
        "digest": {
          "$ref": "#/$defs/hash"
        },
        "lattice_profile_ref": {
          "type": "string",
          "pattern": "^ak\\.profile\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
        },
        "concurrency_class": {
          "type": "string",
          "enum": [
            "merge_safe",
            "exclusive",
            "security_barrier"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
