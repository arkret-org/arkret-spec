{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/content-encryption.schema.json",
  "title": "Arkret recoverable application-content encryption",
  "$defs": {
    "encryption_scheme": {
      "const": "ak.encryption.epoch_content_aead.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "content-encryption.schema.json#/$defs/encryption_scheme",
        "owner": "content-encryption.schema.json#/$defs/encryption_scheme",
        "values": [
          "ak.encryption.epoch_content_aead.v1"
        ]
      }
    },
    "encryption_backup_strategy": {
      "const": "ak.encryption_backup.epoch_content_roots.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "content-encryption.schema.json#/$defs/encryption_backup_strategy",
        "owner": "content-encryption.schema.json#/$defs/encryption_backup_strategy",
        "values": [
          "ak.encryption_backup.epoch_content_roots.v1"
        ]
      }
    },
    "root_context": {
      "type": "object",
      "required": [
        "effective_scope",
        "genesis_event_ref",
        "epoch",
        "group_state_ref",
        "cipher_suite",
        "encryption_backup_strategy",
        "backup_strategy_ref"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "group_state_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "cipher_suite": {
          "type": "string",
          "minLength": 1
        },
        "encryption_backup_strategy": {
          "$ref": "#/$defs/encryption_backup_strategy"
        },
        "backup_strategy_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": [
        "actor_id",
        "endpoint",
        "authorization_event_ref",
        "signature_key_base64url"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "endpoint": {
          "$ref": "./mls-welcome-delivery.schema.json#/properties/recipient_endpoint"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "signature_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "x-arkret-member-role": "binary_encoding"
        }
      },
      "additionalProperties": false
    },
    "content_context": {
      "type": "object",
      "required": [
        "root_context",
        "root_ref",
        "purpose",
        "encryption_scheme",
        "encryption_algorithm",
        "producer",
        "content_key_salt"
      ],
      "properties": {
        "root_context": {
          "$ref": "#/$defs/root_context"
        },
        "root_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "purpose": {
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "content-encryption.schema.json#/$defs/content_context/properties/purpose",
            "owner": "content-encryption.schema.json#/$defs/content_context/properties/purpose",
            "values": [
              "event_body"
            ]
          },
          "const": "event_body"
        },
        "encryption_scheme": {
          "$ref": "#/$defs/encryption_scheme"
        },
        "encryption_algorithm": {
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "content-encryption.schema.json#/$defs/content_context/properties/encryption_algorithm",
            "owner": "content-encryption.schema.json#/$defs/content_context/properties/encryption_algorithm",
            "values": [
              "aes128_gcm"
            ]
          },
          "const": "aes128_gcm"
        },
        "producer": {
          "$ref": "#/$defs/endpoint"
        },
        "content_key_salt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false
    },
    "content_epoch_root": {
      "type": "object",
      "required": [
        "item_kind",
        "secret_id",
        "root_context",
        "root_ref",
        "root_base64url"
      ],
      "properties": {
        "item_kind": {
          "const": "content_epoch_root",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "content-encryption.schema.json#/$defs/content_epoch_root/properties/item_kind",
            "owner": "content-encryption.schema.json#/$defs/content_epoch_root/properties/item_kind",
            "values": [
              "content_epoch_root"
            ]
          }
        },
        "secret_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "root_context": {
          "$ref": "#/$defs/root_context"
        },
        "root_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "root_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "x-arkret-member-role": "binary_encoding"
        }
      },
      "additionalProperties": false
    },
    "coverage_entry": {
      "type": "object",
      "required": [
        "source",
        "root_refs",
        "blob_refs"
      ],
      "properties": {
        "source": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "root_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "blob_refs": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/blob_ref"
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "effective_scope",
        "genesis_event_ref",
        "cut",
        "entries",
        "backup_refs",
        "previous_page_digest",
        "page_digest"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "cut": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_entry"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "backup_refs": {
          "type": "array",
          "items": {
            "$ref": "./key-backup.schema.json#/properties/backup_id"
          },
          "minItems": 0,
          "maxItems": 65536,
          "uniqueItems": true
        },
        "previous_page_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "key_selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source_event_ref",
            "content_path"
          ],
          "properties": {
            "kind": {
              "const": "content_key",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "content-encryption.schema.json#/$defs/key_selector/oneOf/0/properties/kind",
                "owner": "content-encryption.schema.json#/$defs/key_selector/oneOf/0/properties/kind",
                "values": [
                  "content_key"
                ]
              }
            },
            "source_event_ref": {
              "$ref": "./common-ids.schema.json#/$defs/event_id",
              "x-arkret-preimage-commitment": "fixed_event"
            },
            "content_path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
              "maxLength": 1024
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "root_context",
            "root_ref",
            "closed_epoch_cut"
          ],
          "properties": {
            "kind": {
              "const": "epoch_root",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "content-encryption.schema.json#/$defs/key_selector/oneOf/1/properties/kind",
                "owner": "content-encryption.schema.json#/$defs/key_selector/oneOf/1/properties/kind",
                "values": [
                  "epoch_root"
                ]
              }
            },
            "root_context": {
              "$ref": "#/$defs/root_context"
            },
            "root_ref": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "closed_epoch_cut": {
              "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "history_grant": {
      "type": "object",
      "required": [
        "recipient",
        "recipient_hpke_key_base64url",
        "recipient_key_event_ref",
        "history_cut",
        "authorization_event_ref",
        "expires_at",
        "entries"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/endpoint"
        },
        "recipient_hpke_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "x-arkret-member-role": "binary_encoding"
        },
        "recipient_key_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "history_cut": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "selector",
              "sealed_key_base64url"
            ],
            "properties": {
              "selector": {
                "$ref": "#/$defs/key_selector"
              },
              "sealed_key_base64url": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9_-]{85}[AQgw]|[A-Za-z0-9_-]{106}[AEIMQUYcgkosw048])$",
                "minLength": 86,
                "maxLength": 107,
                "x-arkret-member-role": "binary_encoding"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Original signed grant references an accepted ak.mls.history_request authored by its exact recipient endpoint. HPKE info and aad equal JCS({recipient,recipient_hpke_key_base64url,recipient_key_event_ref,history_cut,authorization_event_ref,expires_at,selector}). sealed_key_base64url is canonical unpadded base64url(enc[32] || ciphertext || tag[16]), exactly 64 or 80 decoded bytes for a 16/32-byte key. Default RFC9180 suite is X25519/HKDF-SHA256/ChaCha20Poly1305, mode Base, seq=0; no wire nonce."
    },
    "recovery_binding": {
      "type": "object",
      "required": [
        "replacement",
        "authorization_event_ref",
        "base_group_state_ref",
        "expected_epoch",
        "inventory_digest"
      ],
      "properties": {
        "replacement": {
          "$ref": "#/$defs/endpoint"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "base_group_state_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "expected_epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "custody": {
      "type": "object",
      "required": [
        "custodian_actor_id",
        "recovery_policy_ref",
        "recipient_key_ref"
      ],
      "properties": {
        "custodian_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "recovery_policy_ref": {
          "$ref": "./key-backup.schema.json#/properties/recovery_policy_ref"
        },
        "recipient_key_ref": {
          "$ref": "./key-backup.schema.json#/properties/encryption/properties/recipient_key_ref"
        }
      },
      "additionalProperties": false
    },
    "history_recovery": {
      "type": "object",
      "required": [
        "state",
        "pcr_cut",
        "coverage_head_digest",
        "restored_event_count",
        "cleanup_completed",
        "inventory_blob_ref",
        "replacement"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "ready"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "content-encryption.schema.json#/$defs/history_recovery/properties/state",
            "owner": "content-encryption.schema.json#/$defs/history_recovery/properties/state",
            "values": [
              "pending",
              "ready"
            ]
          }
        },
        "pcr_cut": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "coverage_head_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "restored_event_count": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "cleanup_inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cleanup_completed": {
          "type": "boolean"
        },
        "inventory_blob_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        },
        "cleanup_blob_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        },
        "replacement": {
          "$ref": "#/$defs/endpoint"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "content-encryption.schema.json#/$defs/history_recovery/allOf/0/if/properties/state",
                  "owner": "content-encryption.schema.json#/$defs/history_recovery/allOf/0/if/properties/state",
                  "values": [
                    "ready"
                  ]
                }
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "cleanup_completed": {
                "const": true,
                "x-arkret-value-ownership": {
                  "class": "numeric",
                  "authority": "content-encryption.schema.json#/$defs/history_recovery/allOf/0/then/properties/cleanup_completed",
                  "owner": "content-encryption.schema.json#/$defs/history_recovery/allOf/0/then/properties/cleanup_completed",
                  "values": [
                    true
                  ]
                }
              }
            },
            "required": [
              "cleanup_blob_ref",
              "cleanup_inventory_digest"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cleanup_blob_ref"
                  ]
                },
                {
                  "required": [
                    "cleanup_inventory_digest"
                  ]
                }
              ]
            },
            "properties": {
              "cleanup_completed": {
                "const": false,
                "x-arkret-value-ownership": {
                  "class": "numeric",
                  "authority": "content-encryption.schema.json#/$defs/history_recovery/allOf/0/else/properties/cleanup_completed",
                  "owner": "content-encryption.schema.json#/$defs/history_recovery/allOf/0/else/properties/cleanup_completed",
                  "values": [
                    false
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "protection": {
      "type": "object",
      "required": [
        "root_refs",
        "blob_refs",
        "backup_refs"
      ],
      "properties": {
        "root_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maxItems": 256,
          "uniqueItems": true,
          "minItems": 1
        },
        "blob_refs": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/blob_ref"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "backup_refs": {
          "type": "array",
          "items": {
            "$ref": "./key-backup.schema.json#/properties/backup_id"
          },
          "maxItems": 256,
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "history_request": {
      "type": "object",
      "required": [
        "recipient",
        "recipient_hpke_key_base64url",
        "history_cut",
        "authorization_event_ref",
        "expires_at"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/endpoint"
        },
        "recipient_hpke_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "x-arkret-member-role": "binary_encoding"
        },
        "history_cut": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "history_backup_access": {
      "type": "object",
      "required": [
        "source",
        "root_refs"
      ],
      "properties": {
        "source": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "root_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "recovery_inventory_entry": {
      "type": "object",
      "required": [
        "effective_scope",
        "genesis_event_ref",
        "base_group_state_ref",
        "epoch",
        "old_leaves"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "base_group_state_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "epoch": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "old_leaves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "leaf_index",
              "endpoint"
            ],
            "properties": {
              "leaf_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "endpoint": {
                "$ref": "#/$defs/endpoint"
              }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "recovery_inventory": {
      "type": "object",
      "required": [
        "actor_id",
        "replacement",
        "authorization_event_ref",
        "pcr_cut",
        "entries"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "replacement": {
          "$ref": "#/$defs/endpoint"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "pcr_cut": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recovery_inventory_entry"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Private canonical Blob preimage, streamed/hashed without a global group-count truncation. Entries ordered by unsigned bytes of JCS({effective_scope,genesis_event_ref}), unique by that pair; old_leaves ordered by leaf_index. Includes empty scopes and exact native endpoint provenance; local Account Station durable membership/admission ledger is frozen at the recovery fence."
    },
    "scope_cleanup": {
      "type": "object",
      "required": [
        "effective_scope",
        "genesis_event_ref",
        "winning_commit",
        "remaining_old_leaf_count",
        "root_refs",
        "backup_refs"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "winning_commit": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "remaining_old_leaf_count": {
          "const": 0,
          "x-arkret-value-ownership": {
            "class": "numeric",
