{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-configuration-operations.schema.json",
  "title": "Arkret Applet Bounded Configuration Operations",
  "oneOf": [
    {
      "$ref": "#/$defs/applet_configuration_request_body"
    },
    {
      "$ref": "#/$defs/response_body"
    },
    {
      "$ref": "#/$defs/applet_configuration_execution_request_body"
    },
    {
      "$ref": "#/$defs/execution_response_body"
    },
    {
      "$ref": "#/$defs/peer_applet_configuration_request_body"
    }
  ],
  "$defs": {
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "new_bot",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "applet-configuration-operations.schema.json#/$defs/selection/oneOf/0/properties/kind",
                "owner": "applet-configuration-operations.schema.json#/$defs/selection/oneOf/0/properties/kind",
                "values": [
                  "new_bot"
                ]
              }
            },
            "display_name": {
              "$ref": "./string-profiles.schema.json#/$defs/display_text_256"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "actor_id"
          ],
          "properties": {
            "kind": {
              "const": "existing_realm_actor",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "applet-configuration-operations.schema.json#/$defs/selection/oneOf/1/properties/kind",
                "owner": "applet-configuration-operations.schema.json#/$defs/selection/oneOf/1/properties/kind",
                "values": [
                  "existing_realm_actor"
                ]
              }
            },
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_actor"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "intent": {
      "type": "object",
      "required": [
        "request_id",
        "service_id",
        "effective_scope",
        "selection"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "additionalProperties": false
    },
    "applet_configuration_request_body": {
      "type": "object",
      "required": [
        "command",
        "intent"
      ],
      "properties": {
        "command": {
          "enum": [
            "configure",
            "cancel",
            "recover"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-configuration-operations.schema.json#/$defs/applet_configuration_request_body/properties/command",
            "owner": "applet-configuration-operations.schema.json#/$defs/applet_configuration_request_body/properties/command",
            "values": [
              "configure",
              "cancel",
              "recover"
            ]
          }
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "approval_signatures": {
          "type": "array",
          "items": {
            "$ref": "./approval-signature.schema.json"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 262144,
      "x-arkret-name-role": "request_body"
    },
    "execution_intent": {
      "type": "object",
      "required": [
        "request_id",
        "applet_id",
        "service_id",
        "governance_station_id",
        "governance_generation",
        "effective_scope",
        "registration_ref",
        "registration_epoch",
        "originating_actor_id",
        "selection"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "governance_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "registration_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "registration_epoch": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "originating_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "properties": {
            "kind": {
              "const": "account",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "applet-configuration-operations.schema.json#/$defs/execution_intent/properties/originating_actor_id/properties/kind",
                "owner": "applet-configuration-operations.schema.json#/$defs/execution_intent/properties/originating_actor_id/properties/kind",
                "values": [
                  "account"
                ]
              }
            }
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "additionalProperties": false
    },
    "applet_configuration_execution_request_body": {
      "type": "object",
      "required": [
        "command",
        "intent",
        "governance_station_id",
        "governance_generation",
        "issued_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "command": {
          "enum": [
            "configure",
            "cancel",
            "recover"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-configuration-operations.schema.json#/$defs/applet_configuration_execution_request_body/properties/command",
            "owner": "applet-configuration-operations.schema.json#/$defs/applet_configuration_execution_request_body/properties/command",
            "values": [
              "configure",
              "cancel",
              "recover"
            ]
          }
        },
        "intent": {
          "$ref": "#/$defs/execution_intent"
        },
        "governance_station_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "x-arkret-signature-domain": "ak.applet.configuration_command.v1",
      "x-arkret-max-canonical-bytes": 262144,
      "x-arkret-name-role": "request_body"
    },
    "execution_response_body": {
      "type": "object",
      "required": [
        "request_id",
        "intent_digest",
        "service_id",
        "status",
        "evaluated_at",
        "proof"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "intent_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "status": {
          "enum": [
            "pending",
            "candidate",
            "created",
            "reused",
            "denied",
            "cancelled"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-configuration-operations.schema.json#/$defs/execution_response_body/properties/status",
            "owner": "applet-configuration-operations.schema.json#/$defs/execution_response_body/properties/status",
            "values": [
              "pending",
              "candidate",
              "created",
              "reused",
              "denied",
              "cancelled"
            ]
          }
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        },
        "creation_refs": {
          "type": "array",
          "items": {
            "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "evaluated_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/signature"
        },
        "create_event": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json"
            },
            {
              "properties": {
                "kind": {
                  "const": "ak.realm.actor.create",
                  "x-arkret-value-ownership": {
                    "class": "namespaced_symbol",
                    "authority": "applet-configuration-operations.schema.json#/$defs/execution_response_body/properties/create_event/allOf/1/properties/kind",
                    "owner": "applet-configuration-operations.schema.json#/$defs/execution_response_body/properties/create_event/allOf/1/properties/kind",
                    "values": [
                      "ak.realm.actor.create"
                    ]
                  }
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "created",
                  "reused"
                ],
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "applet-configuration-operations.schema.json#/$defs/execution_response_body/allOf/0/if/properties/status",
                  "owner": "applet-configuration-operations.schema.json#/$defs/execution_response_body/allOf/0/if/properties/status",
                  "values": [
                    "created",
                    "reused"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "actor_id",
              "creation_refs"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "actor_id"
                  ]
                },
                {
                  "required": [
                    "creation_refs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "applet-configuration-operations.schema.json#/$defs/execution_response_body/allOf/1/if/properties/status",
                  "owner": "applet-configuration-operations.schema.json#/$defs/execution_response_body/allOf/1/if/properties/status",
                  "values": [
                    "candidate"
                  ]
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "create_event"
            ]
          },
          "else": {
            "not": {
              "required": [
                "create_event"
              ]
            }
          }
        }
      ],
      "x-arkret-signature-domain": "ak.applet.configuration_outcome.v1",
      "x-arkret-max-canonical-bytes": 262144,
      "description": "Runtime may return a signed creation candidate Event; created/reused is permitted only with the original governance acceptance Commit. Candidate generation is not identity acceptance. Administrator intent is bound to the exact candidate before approval and Event submission.",
      "x-arkret-name-role": "response_body"
    },
    "response_body": {
      "type": "object",
      "required": [
        "request_id",
        "intent_digest",
        "admission_status"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "intent_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "source_response_body": {
          "$ref": "#/$defs/execution_response_body"
        },
        "admission_status": {
          "enum": [
            "not_started",
            "pending",
            "accepted",
            "denied",
            "cancelled"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-configuration-operations.schema.json#/$defs/response_body/properties/admission_status",
            "owner": "applet-configuration-operations.schema.json#/$defs/response_body/properties/admission_status",
            "values": [
              "not_started",
              "pending",
              "accepted",
              "denied",
              "cancelled"
            ]
          }
        },
        "review_request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 262144,
      "x-arkret-name-role": "response_body"
    },
    "signature": {
      "type": "object",
      "required": [
        "verification_method",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "peer_applet_configuration_request_body": {
      "type": "object",
      "required": [
        "requester_account_id",
        "request"
      ],
      "properties": {
        "requester_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "request": {
          "$ref": "#/$defs/applet_configuration_request_body"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 262144,
      "x-arkret-name-role": "request_body"
    }
  }
}
