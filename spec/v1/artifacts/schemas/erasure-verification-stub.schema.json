{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/erasure-verification-stub.schema.json",
  "title": "Arkret Erasure Verification Stub",
  "description": "Minimal retained verification stub bound by erasure-receipt.retained_stub_digest. It preserves event graph, proof, seal, redaction, legal-hold and receipt linkage evidence without retaining erased plaintext.",
  "type": "object",
  "required": [
    "stub_schema",
    "subject",
    "scope",
    "receipt_id",
    "trigger",
    "completed_at"
  ],
  "properties": {
    "stub_schema": {
      "const": "ak.schema.erasure_verification_stub.v1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "event_digest": {
      "$ref": "#/$defs/digest",
      "description": "Optional redundant digest for an Event subject; it is permitted only when subject.kind is event and MUST be absent for every other subject kind. Its suite and all 32 digest octets MUST exactly match the suite wire code and digest carried by subject.subject_ref. If omitted, the suite and digest are recovered from the Event ID. This field and the Event ID preserve consistency evidence; neither independently verifies erased canonical Event bytes."
    },
    "retained_digests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/digest"
      },
      "uniqueItems": true
    },
    "seal_inclusion": {
      "type": "object",
      "properties": {
        "seal_ref": {
          "$ref": "#/$defs/subject_ref"
        },
        "frontier_digest": {
          "$ref": "#/$defs/digest"
        },
        "state_root": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "redaction_authorization_ref": {
      "$ref": "#/$defs/subject_ref"
    },
    "legal_hold_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/policy_id"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "trigger": {
      "$ref": "#/$defs/trigger",
      "description": "Exact closed trigger copied byte-for-byte from the receipt."
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "subject": {
              "properties": {
                "kind": {
                  "const": "event"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "required": [
            "subject"
          ]
        }
      },
      "then": {
        "not": {
          "required": [
            "event_digest"
          ]
        }
      }
    }
  ],
  "$defs": {
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "event_id"
          ],
          "properties": {
            "kind": {
              "const": "event"
            },
            "event_id": {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "account_status_record_id"
          ],
          "properties": {
            "kind": {
              "const": "account_status_record"
            },
            "account_status_record_id": {
              "$ref": "./common-ids.schema.json#/$defs/account_status_record_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "subject": {
      "oneOf": [
        {
          "$ref": "#/$defs/principal_subject"
        },
        {
          "$ref": "#/$defs/realm_subject"
        },
        {
          "$ref": "#/$defs/event_subject"
        },
        {
          "$ref": "#/$defs/blob_subject"
        },
        {
          "$ref": "#/$defs/device_subject"
        },
        {
          "$ref": "#/$defs/account_private_state_subject"
        }
      ]
    },
    "principal_subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "const": "principal"
        },
        "subject_ref": {
          "$ref": "#/$defs/did_core_id"
        }
      },
      "additionalProperties": false
    },
    "realm_subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "const": "realm"
        },
        "subject_ref": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        }
      },
      "additionalProperties": false
    },
    "event_subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "subject_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "blob_subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "const": "blob"
        },
        "subject_ref": {
          "$ref": "./common-ids.schema.json#/$defs/blob_ref"
        }
      },
      "additionalProperties": false
    },
    "device_subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "const": "device"
        },
        "subject_ref": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        }
      },
      "additionalProperties": false
    },
    "account_private_state_subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "const": "account_private_state"
        },
        "subject_ref": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "storage_boundary"
      ],
      "properties": {
        "storage_boundary": {
          "type": "string",
          "enum": [
            "canonical_log_minimization",
            "blob_store",
            "projection_store",
            "account_private_store",
            "search_index",
            "push_routes",
            "device_secret_store",
            "media_derivatives",
            "service_defined"
          ]
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject_ref"
          },
          "uniqueItems": true
        },
        "retention_policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "service_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "policy_id": {
      "$ref": "./call-recording-artifact.schema.json#/$defs/policy_id"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^(did:[^\\s]+|(?:ak:(realm|event|message|strand|morph|relation|view):[A-Za-z0-9_-]{44}|ak:(blob|device|policy|snapshot|receipt):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})|ak:seal:(?:sha256|blake3):[0-9a-f]{64}|ak:blob:(?:sha256|blake3):[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
    }
  }
}
