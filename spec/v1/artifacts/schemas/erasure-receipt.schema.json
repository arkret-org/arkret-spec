{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/erasure-receipt.schema.json",
  "title": "Contrix Erasure Receipt",
  "description": "Signed attestation that an issuer completed, partially completed, or blocked a hard-erasure request within a declared storage boundary. It proves the issuer's deletion action and retained verification stub, not disappearance of independent third-party copies.",
  "type": "object",
  "required": [
    "receipt_id",
    "schema",
    "issuer",
    "subject",
    "scope",
    "outcome",
    "erased_classes",
    "retained_stub_hash",
    "completed_at",
    "proofs"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^cx:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.erasure_receipt.v1"
    },
    "issuer": {
      "$ref": "#/$defs/did"
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "principal",
            "realm",
            "event",
            "blob",
            "device",
            "account_private_state"
          ]
        },
        "ref": {
          "$ref": "#/$defs/subject_ref"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "description": "Boundary in which deletion was attempted. This MUST be narrow enough for an auditor to tell which service/storage class made the claim.",
      "required": [
        "storage_boundary"
      ],
      "properties": {
        "storage_boundary": {
          "type": "string",
          "enum": [
            "canonical_log_minimization",
            "blob_store",
            "projection_store",
            "account_private_store",
            "search_index",
            "push_routes",
            "device_secret_store",
            "media_derivatives",
            "service_defined"
          ]
        },
        "realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject_ref"
          },
          "uniqueItems": true
        },
        "retention_policy_ref": {
          "$ref": "#/$defs/policy_ref"
        },
        "service_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "partially_completed",
        "blocked_by_legal_hold"
      ]
    },
    "erased_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "canonical_payload_bytes",
          "blob_bytes",
          "projection_rows",
          "account_private_state",
          "push_routes",
          "device_secrets",
          "search_index_entries",
          "derived_plaintext",
          "media_derivatives"
        ]
      },
      "uniqueItems": true
    },
    "retained_stub_hash": {
      "$ref": "#/$defs/hash",
      "description": "Hash of the retained verification stub after erasure. The stub must be sufficient to verify event id/digest, proof payload_hash, redaction authorization, anchor inclusion, target id, legal-hold state, and receipt linkage without retaining erased plaintext."
    },
    "legal_hold_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/policy_ref"
        },
        {
          "$ref": "#/$defs/hash"
        }
      ]
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "verification_method",
          "payload_hash",
          "signature"
        ],
        "properties": {
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "payload_hash": {
            "$ref": "#/$defs/hash"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked_by_legal_hold"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "legal_hold_ref"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^(did:[^\\s]+|cx:(realm|event|blob|device|policy|message|flow|morph|relation|view|snapshot):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|cx:blob:sha256:[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
    }
  }
}
