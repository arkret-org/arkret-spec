{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/erasure-receipt.schema.json",
  "title": "Arkret Erasure Receipt",
  "description": "Signed attestation that an issuer completed, partially completed, or blocked a hard-erasure request within a declared storage boundary. It proves the issuer's deletion action and retained verification stub, not disappearance of independent third-party copies.",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "issuer",
    "subject",
    "scope",
    "outcome",
    "erased_classes",
    "retained_stub_digest",
    "completed_at",
    "proofs"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.erasure_receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer": {
      "$ref": "#/$defs/did"
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "subject_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "principal",
            "realm",
            "event",
            "blob",
            "device",
            "account_private_state"
          ]
        },
        "subject_ref": {
          "$ref": "#/$defs/subject_ref"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "description": "Boundary in which deletion was attempted. This MUST be narrow enough for an auditor to tell which service/storage class made the claim.",
      "required": [
        "storage_boundary"
      ],
      "properties": {
        "storage_boundary": {
          "type": "string",
          "enum": [
            "canonical_log_minimization",
            "blob_store",
            "projection_store",
            "account_private_store",
            "search_index",
            "push_routes",
            "device_secret_store",
            "media_derivatives",
            "service_defined"
          ]
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject_ref"
          },
          "uniqueItems": true
        },
        "retention_policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "service_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "partially_completed",
        "blocked_by_legal_hold"
      ]
    },
    "erased_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "canonical_payload_bytes",
          "blob_bytes",
          "projection_rows",
          "account_private_state",
          "push_routes",
          "device_secrets",
          "search_index_entries",
          "derived_plaintext",
          "media_derivatives"
        ]
      },
      "uniqueItems": true
    },
    "retained_stub_digest": {
      "$ref": "#/$defs/hash",
      "description": "Hash of the retained verification stub after erasure: hash(canonical_json(retained_stub)). The stub must be sufficient to verify event id/digest, proof event_digest, redaction authorization, seal inclusion, target id, legal-hold state, and receipt linkage without retaining erased plaintext."
    },
    "retained_stub": {
      "$ref": "#/$defs/verification_stub",
      "description": "Optional in-band verification stub. When omitted, the issuer MUST expose the same canonical stub via its erasure receipt endpoint; retained_stub_digest still binds the exact bytes."
    },
    "legal_hold_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/policy_id"
        },
        {
          "$ref": "#/$defs/hash"
        }
      ]
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "verification_method",
          "payload_digest",
          "signature"
        ],
        "properties": {
          "verification_method": {
            "$ref": "./common-ids.schema.json#/$defs/did_url"
          },
          "payload_digest": {
            "$ref": "#/$defs/hash"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "fanout_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "incomplete"
      ],
      "description": "Cross-Principal-Server erasure receipt fanout aggregate status tracked by the issuing server (models/realm-and-space.md §2.6.2). 'pending' = peers still within erasure_propagation_window_ms and not all acknowledged; 'complete' = every peer that ever held this Realm's content returned a receipt; 'incomplete' = at least one peer failed to acknowledge within erasure_propagation_window_ms. The issuing server MUST surface 'incomplete' to audit/UI and MUST NOT silently swallow it. Absent on receipts that do not drive fanout tracking."
    },
    "peer_receipts": {
      "type": "array",
      "description": "Per-peer fanout acknowledgement records maintained by the issuing server: one entry per peer Principal Server that ever held this Realm's content. Each entry records that peer's acknowledgement status and time, backing the aggregate fanout_status.",
      "items": {
        "type": "object",
        "required": [
          "peer",
          "status"
        ],
        "properties": {
          "peer": {
            "$ref": "#/$defs/did"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "acknowledged",
              "failed",
              "timed_out"
            ],
            "description": "'pending' = awaiting this peer's feedback receipt; 'acknowledged' = peer returned a receipt (regardless of its outcome); 'failed' = peer reported a non-completed feedback outcome (partially_completed / blocked_by_legal_hold); 'timed_out' = no feedback within erasure_propagation_window_ms."
          },
          "receipt_id": {
            "type": "string",
            "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "The peer's own feedback receipt id, when received."
          },
          "acknowledged_at": {
            "$ref": "#/$defs/timestamp"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked_by_legal_hold"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "legal_hold_ref"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^(did:[^\\s]+|ak:(realm|event|message|strand|morph|relation|view):[A-Za-z0-9_-]{44}|ak:(seal|blob|device|policy|snapshot|receipt):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|ak:blob:sha256:[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
    },
    "verification_stub": {
      "type": "object",
      "required": [
        "stub_schema",
        "subject",
        "scope",
        "receipt_id",
        "completed_at"
      ],
      "properties": {
        "stub_schema": {
          "const": "ak.schema.erasure_verification_stub.v1"
        },
        "subject": {
          "type": "object",
          "required": [
            "kind",
            "subject_ref"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "principal",
                "realm",
                "event",
                "blob",
                "device",
                "account_private_state"
              ]
            },
            "subject_ref": {
              "$ref": "#/$defs/subject_ref"
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "required": [
            "storage_boundary"
          ],
          "properties": {
            "storage_boundary": {
              "type": "string",
              "enum": [
                "canonical_log_minimization",
                "blob_store",
                "projection_store",
                "account_private_store",
                "search_index",
                "push_routes",
                "device_secret_store",
                "media_derivatives",
                "service_defined"
              ]
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "target_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/subject_ref"
              },
              "uniqueItems": true
            },
            "retention_policy_id": {
              "$ref": "#/$defs/policy_id"
            },
            "service_scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "event_digest": {
          "$ref": "#/$defs/hash",
          "description": "Optional redundant digest of the original Event envelope or durable object metadata. For subject.kind=event, subject_ref already carries the suite wire_code and complete 32-octet digest; when event_digest is retained, its suite and all digest bytes MUST exactly match subject_ref. Neither form can re-prove erased canonical bytes."
        },
        "retained_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "uniqueItems": true,
          "description": "Event digest / object payload digests retained for signature verification. MUST NOT be a bare digest of erased low-entropy plaintext."
        },
        "seal_inclusion": {
          "type": "object",
          "properties": {
            "seal_ref": {
              "$ref": "#/$defs/subject_ref"
            },
            "frontier_digest": {
              "$ref": "#/$defs/hash"
            },
            "state_root": {
              "$ref": "#/$defs/hash"
            }
          },
          "additionalProperties": false
        },
        "redaction_authorization_ref": {
          "$ref": "#/$defs/subject_ref"
        },
        "legal_hold_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/policy_id"
            },
            {
              "$ref": "#/$defs/hash"
            }
          ]
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  }
}
