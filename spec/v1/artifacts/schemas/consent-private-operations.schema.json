{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/consent-private-operations.schema.json",
  "title": "Arkret Consent private authority proxy",
  "description": "Only for verified transferable non-Human PCRs with a separated governor under the PCR profile pcr_governance_policy. Human uses owning-Station native acceptance/read/notification and rejects these cross-Station operations without effects. This schema grants no new holder-session eligibility. Closed holder-hosting-Station proxy to the current PCR authority. Never a generic RPC, arbitrary account-data write or cached permission. Every command preserves its original authorization and atomically executes its private effects at the PCR authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/proxy_request_body"
    },
    {
      "$ref": "#/$defs/proxy_response_body"
    },
    {
      "$ref": "#/$defs/effects_publish_request_body"
    },
    {
      "$ref": "#/$defs/effects_publish_response_body"
    }
  ],
  "$defs": {
    "holder_session_context": {
      "type": "object",
      "required": [
        "kind",
        "actor_id",
        "device_id"
      ],
      "properties": {
        "kind": {
          "const": "holder_session",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/holder_session_context/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/holder_session_context/properties/kind",
            "values": [
              "holder_session"
            ]
          }
        },
        "actor_id": {
          "allOf": [
            {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            },
            {
              "properties": {
                "kind": {
                  "const": "account",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "consent-private-operations.schema.json#/$defs/holder_session_context/properties/actor_id/allOf/1/properties/kind",
                    "owner": "consent-private-operations.schema.json#/$defs/holder_session_context/properties/actor_id/allOf/1/properties/kind",
                    "values": [
                      "account"
                    ]
                  }
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        }
      },
      "additionalProperties": false
    },
    "station_context": {
      "type": "object",
      "required": [
        "kind",
        "actor_id"
      ],
      "properties": {
        "kind": {
          "const": "station",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/station_context/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/station_context/properties/kind",
            "values": [
              "station"
            ]
          }
        },
        "actor_id": {
          "allOf": [
            {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            },
            {
              "properties": {
                "kind": {
                  "const": "service",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "consent-private-operations.schema.json#/$defs/station_context/properties/actor_id/allOf/1/properties/kind",
                    "owner": "consent-private-operations.schema.json#/$defs/station_context/properties/actor_id/allOf/1/properties/kind",
                    "values": [
                      "service"
                    ]
                  }
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/list_command"
        },
        {
          "$ref": "#/$defs/version_command"
        },
        {
          "$ref": "#/$defs/effects_command"
        },
        {
          "$ref": "#/$defs/invite_policy_command"
        },
        {
          "$ref": "#/$defs/invite_delivery_command"
        },
        {
          "$ref": "#/$defs/request_command"
        }
      ]
    },
    "command_response_body": {
      "oneOf": [
        {
          "$ref": "#/$defs/list_response_body"
        },
        {
          "$ref": "#/$defs/version_response_body"
        },
        {
          "$ref": "#/$defs/effects_response_body"
        },
        {
          "$ref": "#/$defs/invite_policy_response_body"
        },
        {
          "$ref": "#/$defs/invite_delivery_response_body"
        },
        {
          "$ref": "#/$defs/request_response_body"
        }
      ],
      "x-arkret-name-role": "response_body"
    },
    "list_command": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "list",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/list_command/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/list_command/properties/kind",
            "values": [
              "list"
            ]
          }
        },
        "body": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "version_command": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "version",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/version_command/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/version_command/properties/kind",
            "values": [
              "version"
            ]
          }
        },
        "body": {
          "type": "object",
          "description": "Exact original accepted replacement source for historical retry; never a native consent_id lookup or current authorization.",
          "required": [
            "peer",
            "event_id",
            "commit_id"
          ],
          "properties": {
            "peer": {
              "$ref": "./consent-operations.schema.json#/$defs/consent_peer"
            },
            "event_id": {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            },
            "commit_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "effects_command": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "effects",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/effects_command/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/effects_command/properties/kind",
            "values": [
              "effects"
            ]
          }
        },
        "body": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "invite_policy_command": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "invite_policy",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/invite_policy_command/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/invite_policy_command/properties/kind",
            "values": [
              "invite_policy"
            ]
          }
        },
        "body": {
          "$ref": "./invite-receive-policy.schema.json"
        }
      },
      "additionalProperties": false
    },
    "invite_delivery_command": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "invite_delivery",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/invite_delivery_command/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/invite_delivery_command/properties/kind",
            "values": [
              "invite_delivery"
            ]
          }
        },
        "body": {
          "type": "object",
          "required": [
            "notification_source_service_id",
            "delivery"
          ],
          "properties": {
            "notification_source_service_id": {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            },
            "delivery": {
              "$ref": "./invite-delivery-request.schema.json"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "request_command": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "request",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/request_command/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/request_command/properties/kind",
            "values": [
              "request"
            ]
          }
        },
        "body": {
          "type": "object",
          "required": [
            "requester_actor_id",
            "request"
          ],
          "properties": {
            "requester_actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            },
            "request": {
              "$ref": "./consent-operations.schema.json#/$defs/consent_request_request_body"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "list_response_body": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "list",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/list_response_body/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/list_response_body/properties/kind",
            "values": [
              "list"
            ]
          }
        },
        "body": {
          "$ref": "./consent-operations.schema.json#/$defs/consent_list"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "version_response_body": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "version",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/version_response_body/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/version_response_body/properties/kind",
            "values": [
              "version"
            ]
          }
        },
        "body": {
          "$ref": "./consent-operations.schema.json#/$defs/consent_view"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "effects_response_body": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "effects",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/kind",
            "values": [
              "effects"
            ]
          }
        },
        "body": {
          "type": "object",
          "required": [
            "holder_quarantine",
            "invite_delivery",
            "invite_receive_policy"
          ],
          "properties": {
            "holder_quarantine": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "revision",
                    "content"
                  ],
                  "properties": {
                    "revision": {
                      "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
                      "not": {
                        "enum": [
                          "0"
                        ],
                        "x-arkret-value-ownership": {
                          "class": "decimal_text",
                          "authority": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/body/properties/holder_quarantine/oneOf/0/properties/revision/not",
                          "owner": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/body/properties/holder_quarantine/oneOf/0/properties/revision/not",
                          "values": [
                            "0"
                          ]
                        }
                      }
                    },
                    "content": {
                      "$ref": "./holder-quarantine.schema.json"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "invite_delivery": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "revision",
                    "content"
                  ],
                  "properties": {
                    "revision": {
                      "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
                      "not": {
                        "enum": [
                          "0"
                        ],
                        "x-arkret-value-ownership": {
                          "class": "decimal_text",
                          "authority": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/body/properties/invite_delivery/oneOf/0/properties/revision/not",
                          "owner": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/body/properties/invite_delivery/oneOf/0/properties/revision/not",
                          "values": [
                            "0"
                          ]
                        }
                      }
                    },
                    "content": {
                      "$ref": "./invite-delivery.schema.json"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "invite_receive_policy": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "revision",
                    "content"
                  ],
                  "properties": {
                    "revision": {
                      "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
                      "not": {
                        "enum": [
                          "0"
                        ],
                        "x-arkret-value-ownership": {
                          "class": "decimal_text",
                          "authority": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/body/properties/invite_receive_policy/oneOf/0/properties/revision/not",
                          "owner": "consent-private-operations.schema.json#/$defs/effects_response_body/properties/body/properties/invite_receive_policy/oneOf/0/properties/revision/not",
                          "values": [
                            "0"
                          ]
                        }
                      }
                    },
                    "content": {
                      "$ref": "./invite-receive-policy.schema.json"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "invite_policy_response_body": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "invite_policy",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/invite_policy_response_body/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/invite_policy_response_body/properties/kind",
            "values": [
              "invite_policy"
            ]
          }
        },
        "body": {
          "type": "object",
          "required": [
            "revision",
            "content"
          ],
          "properties": {
            "revision": {
              "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal",
              "not": {
                "enum": [
                  "0"
                ],
                "x-arkret-value-ownership": {
                  "class": "decimal_text",
                  "authority": "consent-private-operations.schema.json#/$defs/invite_policy_response_body/properties/body/properties/revision/not",
                  "owner": "consent-private-operations.schema.json#/$defs/invite_policy_response_body/properties/body/properties/revision/not",
                  "values": [
                    "0"
                  ]
                }
              }
            },
            "content": {
              "$ref": "./invite-receive-policy.schema.json"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "invite_delivery_response_body": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "invite_delivery",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/invite_delivery_response_body/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/invite_delivery_response_body/properties/kind",
            "values": [
              "invite_delivery"
            ]
          }
        },
        "body": {
          "$ref": "./invite-delivery-request.schema.json#/$defs/invite_delivery_response_body"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "request_response_body": {
      "type": "object",
      "required": [
        "kind",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "request",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "consent-private-operations.schema.json#/$defs/request_response_body/properties/kind",
            "owner": "consent-private-operations.schema.json#/$defs/request_response_body/properties/kind",
            "values": [
              "request"
            ]
          }
        },
        "body": {
          "$ref": "./consent-operations.schema.json#/$defs/consent_request_response_body"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "proxy_request_body": {
      "type": "object",
      "required": [
        "holder_account_id",
        "realm_id",
        "governance_generation",
        "nonce",
        "expires_at",
        "context",
        "command"
      ],
      "properties": {
        "holder_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "context": {
          "oneOf": [
            {
              "$ref": "#/$defs/holder_session_context"
            },
            {
              "$ref": "#/$defs/station_context"
            }
          ]
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "properties": {
                  "kind": {
                    "enum": [
                      "list",
                      "version",
                      "effects",
                      "invite_policy"
                    ],
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "consent-private-operations.schema.json#/$defs/proxy_request_body/allOf/0/if/properties/command/properties/kind",
                      "owner": "consent-private-operations.schema.json#/$defs/proxy_request_body/allOf/0/if/properties/command/properties/kind",
                      "values": [
                        "list",
                        "version",
                        "effects",
                        "invite_policy"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "properties": {
                  "kind": {
                    "const": "holder_session",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "consent-private-operations.schema.json#/$defs/proxy_request_body/allOf/0/then/properties/context/properties/kind",
                      "owner": "consent-private-operations.schema.json#/$defs/proxy_request_body/allOf/0/then/properties/context/properties/kind",
                      "values": [
                        "holder_session"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "context": {
                "properties": {
                  "kind": {
                    "const": "station",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "consent-private-operations.schema.json#/$defs/proxy_request_body/allOf/0/else/properties/context/properties/kind",
                      "owner": "consent-private-operations.schema.json#/$defs/proxy_request_body/allOf/0/else/properties/context/properties/kind",
                      "values": [
                        "station"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      ],
      "x-arkret-name-role": "request_body"
    },
    "proxy_response_body": {
      "type": "object",
      "required": [
        "request_digest",
        "realm_id",
        "governance_generation",
        "effective_stream_head",
        "evaluated_at",
        "expires_at",
        "response_body"
      ],
      "properties": {
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "effective_stream_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        },
        "evaluated_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "response_body": {
          "$ref": "#/$defs/command_response_body"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "effects_publish_request_body": {
      "type": "object",
      "required": [
        "holder_account_id",
        "realm_id",
        "governance_generation",
        "nonce",
        "effective_stream_head",
        "evaluated_at",
        "expires_at",
        "effects"
      ],
      "properties": {
        "holder_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
