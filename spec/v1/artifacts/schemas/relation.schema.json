{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/relation.schema.json",
  "title": "Contrix Relation",
  "type": "object",
  "required": [
    "id",
    "schema",
    "space_id",
    "relation_kind",
    "from_ref",
    "to_ref",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.relation.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "relation_kind": {
      "type": "string"
    },
    "from_ref": {
      "$ref": "#/$defs/ref"
    },
    "to_ref": {
      "$ref": "#/$defs/ref"
    },
    "rank": {
      "type": "string",
      "description": "Top-level rank string for ordered relations (e.g. contains-list-flow position). Encoding follows conformance/encoding.md §9. Aligned with Place.rank so all rank-bearing canonical objects expose rank at the top level instead of fields.rank."
    },
    "fields": {
      "type": "object",
      "description": "Edge metadata. MUST NOT contain a 'rank' key — rank moved to the top level in v1 to align with Place.rank.",
      "not": {
        "required": [
          "rank"
        ]
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "tombstone"
      ],
      "description": "Relation state. 'tombstone' covers both deletion and redaction; the originating reason is preserved on the cx.relation.delete / cx.redaction event, not on the materialized object."
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^(cx:(space|actor_profile|flow|space|message|morph|relation|event|view):[0-9a-hjkmnp-z]{26}|did:.+)$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
