    "directory_resolve_handle_request_body": {
      "type": "object",
      "description": "Resolve a canonical handle. For restricted handle claims, requester / proofs / claim_presentations / audience / realm_id are authorization inputs; services MUST use indistinguishable denial for anonymous or unauthorized restricted, revoked, rate-limited, and not-found cases.",
      "x-arkret-proof-context": "ak.directory_resolve_handle_request_proof.v1",
      "required": [
        "handle"
      ],
      "properties": {
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "expected_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_presentations": {
          "$ref": "#/$defs/directory_restricted_claim_presentations"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "audience": {
          "$ref": "#/$defs/non_empty_string"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "directory_handle_resolution_outcome": {
      "type": "object",
      "required": [
        "principal_id",
        "subject_id",
        "handle",
