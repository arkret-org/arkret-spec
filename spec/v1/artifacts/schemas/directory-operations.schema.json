{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/directory-operations.schema.json",
  "title": "Arkret Directory Operation DTOs",
  "description": "Closed request/response DTOs for Directory discovery search, resolve, private contact discovery, handle lookup, agent selector lookup, and push webhook registration operations.",
  "anyOf": [
    {
      "$ref": "#/$defs/directory_search_realms_request_body"
    },
    {
      "$ref": "#/$defs/directory_realm_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_realm_request_body"
    },
    {
      "$ref": "#/$defs/directory_realm_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_target_request_body"
    },
    {
      "$ref": "#/$defs/directory_target_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_search_organizations_request_body"
    },
    {
      "$ref": "#/$defs/directory_organization_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_organization_request_body"
    },
    {
      "$ref": "#/$defs/directory_organization_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_search_actors_request_body"
    },
    {
      "$ref": "#/$defs/directory_actor_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_search_users_request_body"
    },
    {
      "$ref": "#/$defs/directory_user_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_handle_request_body"
    },
    {
      "$ref": "#/$defs/directory_handle_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_agent_selector_request_body"
    },
    {
      "$ref": "#/$defs/directory_agent_selector_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_list_handles_for_subject_request_body"
    },
    {
      "$ref": "#/$defs/directory_private_contact_discovery_request_body"
    },
    {
      "$ref": "#/$defs/directory_private_contact_discovery_outcome"
    },
    {
      "$ref": "#/$defs/directory_push_register_request_body"
    },
    {
      "$ref": "#/$defs/directory_push_register_outcome"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "strand_id": {
      "$ref": "./agent-operations.schema.json#/$defs/strand_id"
    },
    "message_id": {
      "$ref": "./agent-operations.schema.json#/$defs/message_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "subscription_id": {
      "type": "string",
      "pattern": "^ak:subscription:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cursor": {
      "$ref": "./authz-operations.schema.json#/$defs/cursor"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "handle": {
      "$ref": "string-profiles.schema.json#/$defs/canonical_handle"
    },
    "agent_slug": {
      "$ref": "string-profiles.schema.json#/$defs/agent_slug"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "proof": {
      "$ref": "./event-envelope.schema.json#/$defs/proof",
      "required": [
        "audience_id"
      ],
      "properties": {
        "audience_id": {
          "$ref": "#/$defs/did_core_id"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "domain"
            ]
          },
          {
            "required": [
              "proof_purpose"
            ]
          }
        ]
      },
      "description": "Directory requester proof leaf. Reuses the generic non-Event detached-JWS wire shape while closing the audience, domain, and purpose choices for the directory read surface: audience MUST be the target Directory service_id returned by ak.find.directory.read.describe.v1, in single-valued did_core_id form (the did:<method>:<msi> form and array audiences are invalid for this object family), and domain / proof_purpose MUST be absent. Canonical binding, signer authority, and freshness rules are defined in discovery-directory.md section 9.0.1.",
      "$comment": "Every request family that carries requester proofs declares its own proofs array inline so that each object family owns a distinct detached-proof node with its own registered context (discovery-directory.md section 9.0.1); a single shared proofs alias would put unrelated operations under one domain separation. The audience narrowing lives on this shared leaf so that all five directory request families are gated by one mechanical constraint."
    },
    "directory_presented_claim": {
      "type": "object",
      "required": [
        "claim_id",
        "subject_id",
        "issuer_id",
        "claim_kind",
        "value",
        "issued_at"
      ],
      "properties": {
        "claim_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "issuer_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "claim_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "value": {
          "type": "object"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "refreshed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "disclosed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "directory_restricted_claim_presentation": {
      "type": "object",
      "required": [
        "kind",
        "issuer_id",
        "verification_method",
        "audience_id",
        "nonce",
        "claim",
        "created_at",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "ak.directory.restricted_claim_presentation.v1"
        },
        "issuer_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "DID URL of the issuer key that signed this presentation; its controller MUST equal iss."
        },
        "audience_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "nonce": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim": {
          "$ref": "#/$defs/directory_presented_claim"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "directory_restricted_claim_presentations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directory_restricted_claim_presentation"
      },
      "minItems": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_id"
      },
      "uniqueItems": true,
      "minItems": 1,
      "description": "Event ids this entry was derived from, so a consumer can go back to the truth source and verify it. Omit the member entirely when the entry has no Event provenance: an implementation MUST NOT synthesize an id for an Event it never authored, and MUST NOT send an empty array to stand in for one. minItems stays 1 so a present array cannot fake compliance."
    },
    "intent": {
      "type": "string",
      "enum": [
        "lookup",
        "mention",
        "contact_request",
        "invite",
        "member_add"
      ]
    },
    "realm_preview": {
      "type": "object",
      "required": [
        "realm_id",
        "as_of",
        "policy_revision"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "alias": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "organization_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "join_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "member_count_bucket": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "1-10",
                "11-50",
                "51-100",
                "101-500",
                "501-2000",
                "2000+"
              ]
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "summary": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        },
        "owning_organization_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did_core_id"
          },
          "uniqueItems": true
        },
        "preview_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "discoverability": {
          "$ref": "#/$defs/non_empty_string"
        },
        "history_access": {
          "$ref": "#/$defs/non_empty_string"
        },
        "join_candidates": {
          "type": "array",
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          }
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "organization_preview": {
      "type": "object",
      "required": [
        "organization_principal_id",
        "as_of",
        "policy_revision"
      ],
      "properties": {
        "organization_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "handle": {
          "$ref": "#/$defs/non_empty_string"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "verified_badge": {
          "type": "boolean",
          "description": "Public organization verification badge suitable for directory preview rendering."
        },
        "member_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Public exact organization member count when the organization directory policy permits exact counts."
        },
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          },
          "uniqueItems": true,
          "description": "Public Realm ids linked to this organization when the organization directory policy permits Realm fan-out preview."
        },
        "realm_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of public Realm ids linked to this organization."
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "actor_preview": {
      "type": "object",
      "required": [
        "actor_id",
        "as_of",
        "policy_revision"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "organization_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "object_preview": {
      "type": "object",
      "required": [
        "object_id",
        "object_kind",
        "as_of",
        "policy_revision"
      ],
      "properties": {
        "object_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/strand_id"
            },
            {
              "$ref": "#/$defs/message_id"
            },
            {
              "$ref": "#/$defs/event_id"
            }
          ]
        },
        "object_kind": {
          "type": "string",
          "enum": [
            "strand",
            "message",
            "event"
          ]
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "summary": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_search_realms_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "source_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_presentations": {
          "$ref": "#/$defs/directory_restricted_claim_presentations"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "directory_realm_search_outcome": {
      "type": "object",
      "required": [
        "realm_ids",
        "has_more"
      ],
      "properties": {
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/realm_preview"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_realm_request_body": {
      "type": "object",
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "alias": {
          "$ref": "#/$defs/non_empty_string"
        },
        "invite_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signed_link": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_presentations": {
          "$ref": "#/$defs/directory_restricted_claim_presentations"
        }
      },
      "anyOf": [
        {
          "required": [
            "realm_id"
          ]
        },
        {
          "required": [
            "alias"
          ]
        },
        {
          "required": [
            "invite_token"
          ]
        },
        {
          "required": [
            "signed_link"
          ]
        }
      ],
      "additionalProperties": false
    },
    "directory_realm_resolution_outcome": {
      "type": "object",
      "required": [
        "realm_preview"
      ],
      "properties": {
        "realm_preview": {
          "$ref": "#/$defs/realm_preview"
        },
        "stripped_state": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "join_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "join_candidates": {
          "type": "array",
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_target_request_body": {
      "type": "object",
      "x-arkret-proof-context": "ak.directory_resolve_target_request_proof.v1",
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_presentations": {
          "$ref": "#/$defs/directory_restricted_claim_presentations"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        },
        "token": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "directory_target_resolution_outcome": {
      "type": "object",
      "required": [
        "target_kind",
        "as_of",
        "policy_revision"
      ],
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": [
            "realm",
            "strand",
            "message"
          ]
        },
        "realm_preview": {
          "$ref": "#/$defs/realm_preview"
        },
        "object_preview": {
          "$ref": "#/$defs/object_preview"
        },
        "join_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "join_candidates": {
          "type": "array",
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "directory_search_organizations_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claims": {
          "type": "object"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "directory_organization_search_outcome": {
      "type": "object",
      "required": [
        "organizations",
        "has_more"
      ],
      "properties": {
        "organizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/organization_preview"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_organization_request_body": {
      "type": "object",
      "x-arkret-proof-context": "ak.directory_resolve_organization_request_proof.v1",
      "properties": {
        "organization_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "handle": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "organization_principal_id"
          ]
        },
        {
          "required": [
            "handle"
          ]
        }
      ],
      "additionalProperties": false
    },
    "directory_organization_resolution_outcome": {
      "type": "object",
      "required": [
        "organization_preview"
      ],
      "properties": {
        "organization_preview": {
          "$ref": "#/$defs/organization_preview"
        },
        "did_document_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "endorsements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "directory_search_actors_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "organization_principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "directory_actor_search_outcome": {
      "type": "object",
      "required": [
        "actor_ids",
        "has_more"
      ],
      "properties": {
        "actor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor_preview"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_search_users_request_body": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "additionalProperties": false
    },
    "user_search_outcome": {
      "type": "object",
