{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/directory-operations.schema.json",
  "title": "Cokret Directory Operation DTOs",
  "description": "Closed request/response DTOs for Directory discovery search, resolve, private contact discovery, handle lookup, agent selector lookup, and push webhook registration operations.",
  "anyOf": [
    {
      "$ref": "#/$defs/directory_search_realms_request_body"
    },
    {
      "$ref": "#/$defs/directory_realm_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_realm_request_body"
    },
    {
      "$ref": "#/$defs/directory_realm_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_target_request_body"
    },
    {
      "$ref": "#/$defs/directory_target_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_search_organizations_request_body"
    },
    {
      "$ref": "#/$defs/directory_organization_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_organization_request_body"
    },
    {
      "$ref": "#/$defs/directory_organization_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_search_actors_request_body"
    },
    {
      "$ref": "#/$defs/directory_actor_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_search_users_request_body"
    },
    {
      "$ref": "#/$defs/directory_user_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_handle_request_body"
    },
    {
      "$ref": "#/$defs/directory_handle_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_agent_selector_request_body"
    },
    {
      "$ref": "#/$defs/directory_agent_selector_resolution_outcome"
    },
    {
      "$ref": "#/$defs/directory_list_handles_for_subject_request_body"
    },
    {
      "$ref": "#/$defs/directory_private_contact_discovery_request_body"
    },
    {
      "$ref": "#/$defs/directory_private_contact_discovery_outcome"
    },
    {
      "$ref": "#/$defs/directory_push_register_request_body"
    },
    {
      "$ref": "#/$defs/directory_push_register_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ck:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^ck:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subscription_id": {
      "type": "string",
      "pattern": "^ck:subscription:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^ck:cursor:[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9._+~-]{1,128}:[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "agent_slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "$ref": "./event-envelope.schema.json#/$defs/proof"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      },
      "minItems": 1
    },
    "directory_presented_claim": {
      "type": "object",
      "required": [
        "claim_id",
        "subject",
        "issuer",
        "claim_kind",
        "value",
        "issued_at"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "subject": {
          "$ref": "#/$defs/did"
        },
        "issuer": {
          "$ref": "#/$defs/did"
        },
        "claim_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "value": {
          "type": "object"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "refreshed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "disclosed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "directory_restricted_claim_presentation": {
      "type": "object",
      "required": [
        "kind",
        "iss",
        "verification_method",
        "audience",
        "nonce",
        "claim",
        "created_at",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "ck.directory.restricted_claim_presentation.v1"
        },
        "iss": {
          "$ref": "#/$defs/did"
        },
        "verification_method": {
          "$ref": "#/$defs/non_empty_string"
        },
        "audience": {
          "$ref": "#/$defs/did"
        },
        "nonce": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim": {
          "$ref": "#/$defs/directory_presented_claim"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "directory_restricted_claim_presentations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directory_restricted_claim_presentation"
      },
      "minItems": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "intent": {
      "type": "string",
      "enum": [
        "lookup",
        "mention",
        "contact_request",
        "invite",
        "member_add"
      ]
    },
    "pagination_request": {
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "freshness_fields": {
      "type": "object",
      "required": [
        "as_of",
        "source_refs",
        "policy_revision"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "realm_preview": {
      "type": "object",
      "required": [
        "realm_id",
        "as_of",
        "source_refs",
        "policy_revision"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "alias": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "organization_did": {
          "$ref": "#/$defs/did"
        },
        "join_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "member_count_bucket": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "1-10",
                "11-50",
                "51-100",
                "101-500",
                "501-2000",
                "2000+"
              ]
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owning_organizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "uniqueItems": true
        },
        "preview_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "discoverability": {
          "$ref": "#/$defs/non_empty_string"
        },
        "history_visibility": {
          "$ref": "#/$defs/non_empty_string"
        },
        "join_candidates": {
          "type": "array",
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          }
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "organization_preview": {
      "type": "object",
      "required": [
        "organization_did",
        "as_of",
        "source_refs",
        "policy_revision"
      ],
      "properties": {
        "organization_did": {
          "$ref": "#/$defs/did"
        },
        "handle": {
          "$ref": "#/$defs/non_empty_string"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "actor_preview": {
      "type": "object",
      "required": [
        "actor_id",
        "as_of",
        "source_refs",
        "policy_revision"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization_did": {
          "$ref": "#/$defs/did"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "object_preview": {
      "type": "object",
      "required": [
        "object_id",
        "object_kind",
        "as_of",
        "source_refs",
        "policy_revision"
      ],
      "properties": {
        "object_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/strand_id"
            },
            {
              "$ref": "#/$defs/message_id"
            },
            {
              "$ref": "#/$defs/event_id"
            }
          ]
        },
        "object_kind": {
          "type": "string",
          "enum": [
            "strand",
            "message",
            "event"
          ]
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stale": {
          "type": "boolean"
        },
        "divergent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_search_realms_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "organization_did": {
          "$ref": "#/$defs/did"
        },
        "source_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_presentations": {
          "$ref": "#/$defs/directory_restricted_claim_presentations"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "directory_realm_search_outcome": {
      "type": "object",
      "required": [
        "realms",
        "has_more"
      ],
      "properties": {
        "realms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/realm_preview"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_realm_request_body": {
      "type": "object",
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "alias": {
          "$ref": "#/$defs/non_empty_string"
        },
        "invite_token": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signed_link": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_presentations": {
          "$ref": "#/$defs/directory_restricted_claim_presentations"
        }
      },
      "anyOf": [
        {
          "required": [
            "realm_id"
          ]
        },
        {
          "required": [
            "alias"
          ]
        },
        {
          "required": [
            "invite_token"
          ]
        },
        {
          "required": [
            "signed_link"
          ]
        }
      ],
      "additionalProperties": false
    },
    "directory_realm_resolution_outcome": {
      "type": "object",
      "required": [
        "realm_preview"
      ],
      "properties": {
        "realm_preview": {
          "$ref": "#/$defs/realm_preview"
        },
        "stripped_state": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "join_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "join_candidates": {
          "type": "array",
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_target_request_body": {
      "type": "object",
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/non_empty_string"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        },
        "token": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "directory_target_resolution_outcome": {
      "type": "object",
      "required": [
        "target_kind",
        "as_of",
        "source_refs",
        "policy_revision"
      ],
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": [
            "realm",
            "strand",
            "message"
          ]
        },
        "realm_preview": {
          "$ref": "#/$defs/realm_preview"
        },
        "object_preview": {
          "$ref": "#/$defs/object_preview"
        },
        "join_rule": {
          "$ref": "#/$defs/non_empty_string"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "policy_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "join_candidates": {
          "type": "array",
          "items": {
            "$ref": "./realm-join-candidate.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "directory_search_organizations_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claims": {
          "type": "object"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "directory_organization_search_outcome": {
      "type": "object",
      "required": [
        "organizations",
        "has_more"
      ],
      "properties": {
        "organizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/organization_preview"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_organization_request_body": {
      "type": "object",
      "properties": {
        "organization_did": {
          "$ref": "#/$defs/did"
        },
        "handle": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proofs": {
          "$ref": "#/$defs/proofs"
        }
      },
      "anyOf": [
        {
          "required": [
            "organization_did"
          ]
        },
        {
          "required": [
            "handle"
          ]
        }
      ],
      "additionalProperties": false
    },
    "directory_organization_resolution_outcome": {
      "type": "object",
      "required": [
        "organization_preview"
      ],
      "properties": {
        "organization_preview": {
          "$ref": "#/$defs/organization_preview"
        },
        "did_document_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "endorsements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "directory_search_actors_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "organization_did": {
          "$ref": "#/$defs/did"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "directory_actor_search_outcome": {
      "type": "object",
      "required": [
        "actors",
        "has_more"
      ],
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor_preview"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_search_users_request_body": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/non_empty_string"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "additionalProperties": false
    },
    "user_search_outcome": {
      "type": "object",
      "required": [],
      "properties": {
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "did": {
          "$ref": "#/$defs/did"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "avatar_blob_ref": {
          "$ref": "./blob.schema.json#/properties/blob_ref"
        },
        "membership": {
          "type": "string",
          "enum": [
            "joined",
            "invited",
            "knocked",
            "left",
            "unknown"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "member_delivery_binding": {
          "$ref": "./handle-claim.schema.json#/properties/member_delivery_binding"
        }
      },
      "additionalProperties": false
    },
    "directory_user_search_outcome": {
      "type": "object",
      "required": [
        "users",
        "has_more"
      ],
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user_search_outcome"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_handle_request_body": {
      "type": "object",
      "required": [
