                "type": "string",
                "enum": [
                  "realm",
                  "organization",
                  "actor",
                  "applet",
                  "handle"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "resource_ids": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/non_empty_string"
                  },
                  {
                    "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
                  }
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "webhook_uri": {
          "type": "string",
          "format": "uri"
        },
        "secret": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "directory_push_register_outcome": {
      "type": "object",
      "required": [
        "subscription_id",
        "effective_at"
      ],
      "properties": {
        "subscription_id": {
          "$ref": "#/$defs/subscription_id"
        },
        "effective_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  }
}
