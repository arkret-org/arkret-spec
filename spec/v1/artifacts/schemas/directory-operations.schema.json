{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/directory-operations.schema.json",
  "title": "Arkret Public Realm Directory Operations",
  "description": "Closed public-Realm metadata query DTOs. Directory results are not authority, membership, join or history evidence.",
  "oneOf": [
    {
      "$ref": "#/$defs/directory_search_realms_request_body"
    },
    {
      "$ref": "#/$defs/directory_realm_search_outcome"
    },
    {
      "$ref": "#/$defs/directory_resolve_realm_request_body"
    },
    {
      "$ref": "#/$defs/directory_realm_resolution_outcome"
    }
  ],
  "$defs": {
    "public_realm_directory_entry": {
      "type": "object",
      "required": [
        "realm_id",
        "public_metadata",
        "indexed_at",
        "expires_at"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "public_metadata": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/PublicRealmMetadata"
        },
        "indexed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "directory_search_realms_request_body": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "directory_realm_search_outcome": {
      "type": "object",
      "required": [
        "realms",
        "has_more"
      ],
      "properties": {
        "realms": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/public_realm_directory_entry"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_realm_request_body": {
      "type": "object",
      "required": [
        "realm_id"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        }
      },
      "additionalProperties": false
    },
    "directory_realm_resolution_outcome": {
      "$ref": "#/$defs/public_realm_directory_entry"
    }
  }
}
