          "$ref": "#/$defs/did_core_id"
        },
        "subject_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "verified": {
          "type": "boolean"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "./handle-claim.schema.json"
          }
        },
        "member_delivery_binding": {
          "$ref": "./handle-claim.schema.json#/properties/member_delivery_binding"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "directory_resolve_agent_selector_request_body": {
      "type": "object",
      "x-arkret-proof-context": "ak.directory_resolve_agent_selector_request_proof.v1",
      "required": [
        "controller_handle",
        "agent_slug",
        "intent",
        "requester_id"
      ],
      "properties": {
        "controller_handle": {
          "$ref": "#/$defs/handle",
          "description": "Canonical controller handle string without the @ sigil."
        },
        "agent_slug": {
          "$ref": "#/$defs/agent_slug"
        },
        "expected_actor_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "directory_agent_selector_resolution_outcome": {
      "type": "object",
      "required": [
        "controller_subject_id",
        "subject_id",
        "agent_slug",
        "verified",
        "selector_claim"
      ],
      "properties": {
        "controller_subject_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Controller principal DID resolved from controller_handle and verified against the selector claim."
        },
        "subject_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Native personal agent principal DID selected by (controller_subject, agent_slug)."
        },
        "agent_slug": {
          "$ref": "#/$defs/agent_slug"
        },
        "verified": {
          "type": "boolean",
          "const": true
        },
        "selector_claim": {
          "$ref": "./agent-selector-claim.schema.json"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "directory_list_handles_for_subject_request_body": {
      "type": "object",
      "description": "List currently visible handle claims for a subject. The service MUST apply the same visibility, audience, requester proof, rate-limit, and indistinguishable-denial rules as resolve_handle; absence of a returned handle is not proof the subject has none.",
      "x-arkret-proof-context": "ak.directory_list_handles_for_subject_request_proof.v1",
      "required": [
        "subject_id"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "proof_challenge": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "psi_ristretto255_element": {
      "type": "string",
      "description": "Canonical unpadded base64url encoding of one 32-byte RFC 9497 ristretto255 element. Decoders MUST additionally reject non-canonical group encodings and the identity element.",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "psi_voprf_proof": {
      "type": "string",
      "description": "Canonical unpadded base64url encoding of one 64-byte RFC 9497 batched DLEQ proof (two 32-byte scalars).",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    },
    "psi_derived_prefix_16": {
      "type": "string",
      "description": "Canonical unpadded base64url encoding of the v1 fixed 16-byte derived digest prefix.",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "psi_response_padding": {
      "type": "string",
      "description": "ASCII SP padding. The origin serializes the complete response with RFC 8785 JCS as UTF-8, omits Content-Encoding and applies no content coding, and chooses this value so the HTTP entity body Content-Length exactly equals the phase bucket declared by ServiceDescribe.private_contact_discovery.",
      "pattern": "^ *$",
      "maxLength": 262144
    },
    "psi_batch_id": {
      "type": "string",
      "description": "Client-generated UUIDv7 typed batch id correlating the blind and match rounds of one logical PSI query. It is unique within the authenticated device credential and is bound to canonical request digests for replay-safe quota charging.",
      "pattern": "^ak:batch:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "psi_profile": {
      "const": "ak.private_contact_discovery.v1"
    },
    "psi_blind_request_body": {
      "type": "object",
      "description": "Round 1 of the §6.2 two-round OPRF set-membership PSI: the client submits blinded connection identifiers. PSI window quota is enforced here; denial is HTTP 429 psi_quota_exhausted in the standard RFC 9457 Problem Details, never a 200 outcome.",
      "required": [
        "profile",
        "phase",
        "batch_id",
        "ciphersuite",
        "key_epoch",
        "blinded_elements"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/psi_profile"
        },
        "phase": {
          "const": "blind"
        },
        "batch_id": {
          "$ref": "#/$defs/psi_batch_id"
        },
        "ciphersuite": {
          "type": "string",
          "description": "Exact RFC 9497 ciphersuite identifier. The ak.private_contact_discovery.v1 profile fixes the separate RFC protocol mode to modeVOPRF (0x01).",
          "enum": [
            "ristretto255-SHA512"
          ]
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "blinded_elements": {
          "type": "array",
          "description": "Client-padded batch. Cardinality MUST equal ServiceDescribe.private_contact_discovery.batch_item_count; real and dummy elements are indistinguishable to the provider.",
          "items": {
            "$ref": "#/$defs/psi_ristretto255_element"
          },
          "minItems": 1,
          "maxItems": 1024
        }
      },
      "additionalProperties": false
    },
    "psi_match_request_body": {
      "type": "object",
      "description": "Round 2 of the §6.2 two-round PSI: the client submits one fixed 16-byte derived digest prefix for every element of the admitted blind batch, preserving cardinality and order. An admitted batch_id MUST NOT be quota-denied at this phase.",
      "required": [
        "profile",
        "phase",
        "batch_id",
        "key_epoch",
        "derived_prefixes"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/psi_profile"
        },
        "phase": {
          "const": "match"
        },
        "batch_id": {
          "$ref": "#/$defs/psi_batch_id"
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "derived_prefixes": {
          "type": "array",
          "description": "Each entry is the fixed 16-byte prefix of the corresponding unblinded VOPRF output digest. Cardinality and order MUST equal the admitted blind request.",
          "items": {
            "$ref": "#/$defs/psi_derived_prefix_16"
          },
          "minItems": 1,
          "maxItems": 1024
        }
      },
      "additionalProperties": false
    },
    "directory_private_contact_discovery_request_body": {
      "description": "Two-round OPRF set-membership PSI request (zh/discovery/discovery-directory.md §6.2/§6.3); the phase field discriminates the round.",
      "oneOf": [
        {
          "$ref": "#/$defs/psi_blind_request_body"
        },
        {
          "$ref": "#/$defs/psi_match_request_body"
        }
      ]
    },
    "invite_consent_handoff_stub": {
      "type": "object",
      "description": "Minimal invite/consent handoff stub allowed beside PSI match bits. It declares state or next-step guidance only; it MUST NOT carry a contact request token, reachability proof, profile, membership, or read grant.",
      "required": [
        "kind",
        "state"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "invite",
            "consent"
          ]
        },
        "consent_scope": {
          "type": "string",
          "enum": [
            "invite",
            "direct_message",
            "voice_call",
            "video_call",
            "presence",
            "any"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "grant_active",
            "revoked",
            "no_consent",
            "unknown"
          ]
        },
        "state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "If present, MUST be salted per requester/session or replaced by an audience-bound opaque token per consent-model.md §6.2."
        },
        "next_step": {
          "type": "string",
          "enum": [
            "request_consent",
            "open_invite_strand",
            "no_action",
            "try_later"
          ]
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "psi_blind_outcome": {
      "type": "object",
      "description": "Round 1 success outcome: VOPRF evaluations over the fixed-size submitted batch plus one RFC 9497 batched proof. evaluated_elements MUST be same-length and same-order as the request's blinded_elements.",
      "required": [
        "profile",
        "phase",
        "batch_id",
        "ciphersuite",
        "key_epoch",
        "evaluated_elements",
        "evaluation_proofs",
        "derived_prefix_bytes",
        "padding"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/psi_profile"
        },
        "phase": {
          "const": "blind"
        },
        "batch_id": {
          "$ref": "#/$defs/psi_batch_id"
        },
        "ciphersuite": {
          "type": "string",
          "enum": [
            "ristretto255-SHA512"
          ]
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated_elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/psi_ristretto255_element"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "evaluation_proofs": {
          "type": "array",
          "description": "Exactly one RFC 9497 batched VOPRF DLEQ proof covering the entire fixed-size evaluated_elements array. The client verifies it with the public key for this key_epoch from ServiceDescribe.private_contact_discovery.",
          "items": {
            "$ref": "#/$defs/psi_voprf_proof"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "derived_prefix_bytes": {
          "type": "integer",
          "description": "Fixed byte length of every round-2 derived_prefixes entry in the v1 profile.",
          "const": 16
        },
        "padding": {
          "$ref": "#/$defs/psi_response_padding"
        }
      },
      "additionalProperties": false
    },
    "psi_match_outcome": {
      "type": "object",
      "description": "Round 2 success outcome: fixed-cardinality hit bitmap (dummy-padded to the provider-enforced batch_item_count). Per-target conditions (nonexistent, undiscoverable, per-target policy-denied, OPRF mismatch) are encoded as unmatched bits and MUST NOT surface as distinct fields, codes, or timing (§6.4 Class A).",
      "required": [
        "profile",
        "phase",
        "batch_id",
        "key_epoch",
        "hit_bitmap",
        "padding"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/psi_profile"
        },
        "phase": {
          "const": "match"
        },
        "batch_id": {
          "$ref": "#/$defs/psi_batch_id"
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "hit_bitmap": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "handoff_stubs": {
          "type": "array",
          "description": "Optional minimal invite/consent handoff stubs. If present, MUST have the same cardinality as hit_bitmap, with dummy stubs (e.g. state=\"unknown\") at unmatched positions so the field shape does not reveal hits.",
          "items": {
            "$ref": "#/$defs/invite_consent_handoff_stub"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "padding": {
          "$ref": "#/$defs/psi_response_padding"
        }
      },
      "additionalProperties": false
    },
    "directory_private_contact_discovery_outcome": {
      "description": "Two-round PSI success outcomes, discriminated by phase. PSI quota denial is NOT an outcome shape: it is HTTP 429 psi_quota_exhausted in the standard RFC 9457 Problem Details at the blind phase, padded to the success-path size bucket and delay class (§6.4 Class B).",
      "oneOf": [
        {
          "$ref": "#/$defs/psi_blind_outcome"
        },
        {
          "$ref": "#/$defs/psi_match_outcome"
        }
      ]
    },
    "directory_push_register_request_body": {
      "type": "object",
      "required": [
        "subscriber_principal_id",
