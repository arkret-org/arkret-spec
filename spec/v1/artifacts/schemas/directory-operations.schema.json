        "consent_scope": {
          "type": "string",
          "enum": [
            "invite",
            "direct_message",
            "voice_call",
            "video_call",
            "presence",
            "any"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "grant_active",
            "revoked",
            "no_consent",
            "unknown"
          ]
        },
        "state_digest": {
          "$ref": "#/$defs/non_empty_string",
          "description": "If present, MUST be salted per requester/session or replaced by an audience-bound opaque token per consent-model.md §6.2."
        },
