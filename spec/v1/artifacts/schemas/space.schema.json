{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/space.schema.json",
  "title": "Contrix Space",
  "type": "object",
  "required": [
    "id",
    "schema",
    "title",
    "kind",
    "created_by_principal",
    "schema_refs",
    "default_discoverability",
    "default_join_rule",
    "history_visibility",
    "encryption_profile",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.space.v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "kind": {
      "type": "string",
      "enum": [
        "collaboration"
      ],
      "description": "v1 Space kind. Always 'collaboration'. A Space is always a security/sync/auth/E2EE boundary; structural groupings (board, list, swimlane, calendar bucket, etc.) are separate Place objects (cx:place:) — see place.schema.json. Product-level distinctions encoded via Space.fields / schema_refs / labels / security_class."
    },
    "security_class": {
      "type": "string",
      "enum": [
        "standard",
        "high_assurance"
      ],
      "description": "Optional security class. 'high_assurance' forbids federation_policy=open and SHOULD use stricter resolver/E2EE/audit defaults. Omitted = 'standard'."
    },
    "created_by_principal": {
      "$ref": "#/$defs/did"
    },
    "owning_organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/did"
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relation_profiles": {
      "type": "array",
      "description": "Optional Relation cardinality and conflict profiles declared by this Space schema/profile.",
      "items": {
        "type": "object",
        "required": [
          "relation_kind",
          "cardinality"
        ],
        "properties": {
          "relation_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "from_type": {
            "type": "string"
          },
          "to_type": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "space",
              "security_boundary",
              "board",
              "global"
            ],
            "default": "space"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one_to_one",
              "one_to_many",
              "many_to_one",
              "many_to_many"
            ]
          },
          "dedupe_key": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "max_to_per_from": {
            "type": "integer",
            "minimum": 1
          },
          "max_from_per_to": {
            "type": "integer",
            "minimum": 1
          },
          "multi_edge": {
            "type": "boolean"
          },
          "rank_field": {
            "type": "string"
          },
          "on_conflict": {
            "type": "string",
            "enum": [
              "reject",
              "close_previous",
              "deterministic_winner",
              "require_review"
            ],
            "default": "deterministic_winner"
          }
        },
        "additionalProperties": true
      }
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "default_discoverability": {
      "type": "string",
      "enum": [
        "public",
        "listed",
        "restricted",
        "unlisted",
        "invite_only",
        "secret"
      ]
    },
    "default_join_rule": {
      "type": "string",
      "enum": [
        "public",
        "invite",
        "knock",
        "restricted",
        "knock_restricted",
        "closed"
      ]
    },
    "history_visibility": {
      "type": "string",
      "enum": [
        "world_readable",
        "shared",
        "invited",
        "joined",
        "restricted"
      ]
    },
    "encryption_profile": {
      "type": "string",
      "enum": [
        "none",
        "mls_rfc9420",
        "external"
      ]
    },
    "federation_policy": {
      "type": "string",
      "enum": [
        "open",
        "restricted",
        "closed",
        "quarantine"
      ]
    },
    "anchor_profile": {
      "type": "string",
      "enum": [
        "single_did",
        "threshold",
        "open_set",
        "mixed"
      ],
      "description": "Create-locked Anchor finality profile. single_did and threshold deployments may require signed Anchor single-chain uniqueness; open_set deployments allow multiple Anchor leaves and deterministic joined views; mixed deployments use a primary anchorer plus fallback recovery anchorer."
    },
    "hash_profile": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512",
        "sha3_256",
        "blake3"
      ],
      "default": "sha256",
      "description": "Create-locked hash algorithm used for Move/Anchor ids, state_root, and Merkle leaves within this Space. Defaults to sha256. Migration via hash-transition Anchor; see event-auth-state-resolution.md §4.2.5."
    },
    "anchorer": {
      "type": "object",
      "description": "Genesis value for the Space anchorer cell. Subsequent changes are ordinary Moves finalized by the previous anchorer.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "single_did",
            "threshold",
            "open_set",
            "mixed"
          ]
        },
        "did": {
          "$ref": "#/$defs/did"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "max_anchor_staleness_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 86400000,
      "description": "Maximum age of a Move.anchor_ref relative to the current Anchor view. Offline clients exceeding this window must rebase and re-sign."
    },
    "bottom_escalation_after_ms": {
      "type": "integer",
      "minimum": 60000,
      "description": "Optional timeout after which unresolved bottom diagnostics should be escalated to recovery governance. Expiry does not choose a winner automatically."
    },
    "cell_lattices": {
      "type": "array",
      "description": "Optional Space-specific lattice declarations for extension cell families.",
      "items": {
        "$ref": "#/$defs/cell_lattice"
      },
      "uniqueItems": true
    },
    "co_write_policy": {
      "type": "array",
      "description": "Optional whitelist constraining which cell families may be written by the same Move.",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^cx\\.component\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "retention_policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "avatar_blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "security_class": {
            "const": "high_assurance"
          }
        },
        "required": [
          "security_class"
        ]
      },
      "then": {
        "properties": {
          "federation_policy": {
            "enum": [
              "closed",
              "restricted",
              "quarantine"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cell_lattice": {
      "type": "object",
      "required": [
        "cell_family",
        "type",
        "bottom",
        "cell_role"
      ],
      "properties": {
        "cell_family": {
          "type": "string",
          "pattern": "^cx\\.component\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "or-set",
            "mv-register",
            "cas-register",
            "fsm",
            "counter",
            "ordered-log",
            "lww-register",
            "rga"
          ]
        },
        "bottom": {
          "type": "string",
          "enum": [
            "reject",
            "expose"
          ]
        },
        "cell_role": {
          "type": "string",
          "enum": [
            "authorization_root",
            "policy_root",
            "anchorer_root",
            "membership",
            "lifecycle",
            "ui_affordance",
            "content",
            "draft",
            "cosmetic",
            "audit",
            "telemetry"
          ],
          "description": "Semantic role declared by Space schema. authorization_root / policy_root / anchorer_root / membership / lifecycle MUST NOT use lattice types lww-register or rga (enforced by allOf below). ui_affordance / content / draft / cosmetic MAY use lww-register or rga."
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "lww-register",
                  "rga"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "cell_role": {
                "enum": [
                  "ui_affordance",
                  "content",
                  "draft",
                  "cosmetic"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
