{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/query.schema.json",
  "title": "Arkret Query / Search Request Shapes",
  "description": "Canonical wire schema for client query / projection and search request bodies and their reusable building blocks (filters, sort, relation query). The OpenAPI document references these $defs so there is a single source of truth. Human-readable semantics: zh/conformance/query-schema.md. facet_name / view_renderer are copies of the shared OpenAPI enums (kept local so this file is self-contained); the authoritative facet / renderer enums also live in the OpenAPI components and MUST stay in lockstep.",
  "$defs": {
    "facet_name": {
      "type": "string",
      "enum": [
        "container",
        "replyable",
        "schedulable",
        "assignable",
        "stateful",
        "rankable",
        "reviewable",
        "notifiable",
        "documentable",
        "renderable"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "query.schema.json#/$defs/facet_name",
        "owner": "query.schema.json#/$defs/facet_name",
        "values": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      }
    },
    "view_renderer": {
      "type": "string",
      "enum": [
        "board",
        "list",
        "table",
        "calendar",
        "gantt",
        "timeline",
        "thread",
        "chat",
        "forum",
        "graph",
        "tree",
        "document",
        "dashboard",
        "custom"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "query.schema.json#/$defs/view_renderer",
        "owner": "query.schema.json#/$defs/view_renderer",
        "values": [
          "board",
          "list",
          "table",
          "calendar",
          "gantt",
          "timeline",
          "thread",
          "chat",
          "forum",
          "graph",
          "tree",
          "document",
          "dashboard",
          "custom"
        ]
      }
    },
    "field_filter": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains",
            "exists",
            "prefix",
            "full_text"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "query.schema.json#/$defs/field_filter/properties/op",
            "owner": "query.schema.json#/$defs/field_filter/properties/op",
            "values": [
              "eq",
              "neq",
              "in",
              "not_in",
              "lt",
              "lte",
              "gt",
              "gte",
              "contains",
              "exists",
              "prefix",
              "full_text"
            ]
          }
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "boolean_filter": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "and": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/query_filter"
          }
        },
        "or": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/query_filter"
          }
        },
        "not": {
          "$ref": "#/$defs/query_filter"
        }
      },
      "additionalProperties": false
    },
    "query_filter": {
      "oneOf": [
        {
          "$ref": "#/$defs/field_filter"
        },
        {
          "$ref": "#/$defs/boolean_filter"
        }
      ]
    },
    "sort_specification": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "query.schema.json#/$defs/sort_specification/properties/direction",
            "owner": "query.schema.json#/$defs/sort_specification/properties/direction",
            "values": [
              "asc",
              "desc"
            ]
          }
        },
        "nulls": {
          "type": "string",
          "enum": [
            "first",
            "last"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "query.schema.json#/$defs/sort_specification/properties/nulls",
            "owner": "query.schema.json#/$defs/sort_specification/properties/nulls",
            "values": [
              "first",
              "last"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "relation_query": {
      "type": "object",
      "required": [
        "kind",
        "direction"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "out",
            "in",
            "both"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "query.schema.json#/$defs/relation_query/properties/direction",
            "owner": "query.schema.json#/$defs/relation_query/properties/direction",
            "values": [
              "out",
              "in",
              "both"
            ]
          }
        },
        "source_ref": {
          "$ref": "./relation.schema.json#/$defs/relation_endpoint"
        },
        "target_ref": {
          "$ref": "./relation.schema.json#/$defs/relation_endpoint"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "query_request_body": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "view_id": {
          "type": "string",
          "pattern": "^ak:view:[A-Za-z0-9_-]{44}$"
        },
        "context_ref": {
          "type": "string",
          "pattern": "^(ak:(realm|space|strand|message|morph|relation|view):[A-Za-z0-9_-]{44}|did:.+)$",
          "description": "Optional timeline / renderer context object reference. This is not a RealmCommit."
        },
        "projection": {
          "type": "string",
          "enum": [
            "raw",
            "collection",
            "timeline",
            "graph",
            "document",
            "composite"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "query.schema.json#/$defs/query_request_body/properties/projection",
            "owner": "query.schema.json#/$defs/query_request_body/properties/projection",
            "values": [
              "raw",
              "collection",
              "timeline",
              "graph",
              "document",
              "composite"
            ]
          }
        },
        "renderer": {
          "$ref": "#/$defs/view_renderer"
        },
        "object_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "morph_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/facet_name"
          }
        },
        "relation": {
          "oneOf": [
            {
              "$ref": "#/$defs/relation_query"
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/query_filter"
          }
        },
        "order_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort_specification"
          }
        },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^ak:cursor:[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "wait_for": {
          "type": "string",
          "pattern": "^ak:cursor:[A-Za-z0-9_-]+$",
          "description": "Unique body wait carrier only for an operation/binding explicitly registered in operation-registry.wait_for_bindings. No current generic query operation is registered. Header or consistency aliases are forbidden."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "projection": {
                "const": "raw",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "query.schema.json#/$defs/query_request_body/allOf/0/if/properties/projection",
                  "owner": "query.schema.json#/$defs/query_request_body/allOf/0/if/properties/projection",
                  "values": [
                    "raw"
                  ]
                }
              }
            },
            "required": [
              "projection"
            ]
          },
          "then": {
            "not": {
              "required": [
                "renderer"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "projection": {
                "enum": [
                  "collection",
                  "graph",
                  "timeline",
                  "document",
                  "composite"
                ],
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "query.schema.json#/$defs/query_request_body/allOf/1/if/properties/projection",
                  "owner": "query.schema.json#/$defs/query_request_body/allOf/1/if/properties/projection",
                  "values": [
                    "collection",
                    "graph",
                    "timeline",
                    "document",
                    "composite"
                  ]
                }
              }
            },
            "required": [
              "projection"
            ]
          },
          "then": {
            "required": [
              "view_id"
            ]
          }
        }
      ]
    },
    "search_request_body": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "object_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "morph_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_range": {
          "type": "object"
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    }
  }
}
