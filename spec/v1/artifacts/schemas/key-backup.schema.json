{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/key-backup.schema.json",
  "title": "Cokret Encrypted Key Backup",
  "type": "object",
  "required": [
    "backup_id",
    "actor_id",
    "backup_class",
    "backup_version",
    "series_id",
    "series_seq",
    "created_at",
    "encryption",
    "contents",
    "ciphertext",
    "ciphertext_digest",
    "auth_data"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "pattern": "^ck:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_class": {
      "type": "string",
      "enum": [
        "did_recovery",
        "secret_storage",
        "mls_history"
      ]
    },
    "mixed_secret_storage": {
      "type": "boolean",
      "default": false,
      "description": "True only for the personal_node exception where one encrypted backup envelope contains both identity-signing material and E2EE / MLS history material. Non-personal deployment profiles MUST reject this flag. When true and recipient_method=passphrase_kdf, the stricter Argon2id floor below applies."
    },
    "backup_version": {
      "type": "string",
      "pattern": "^kb_[A-Za-z0-9_-]+$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^ck:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable identifier for one immutable chain of backup envelopes belonging to a single (actor_id, backup_class). A pair MAY have multiple series during compromise rotation or migration; active series selection is outside this envelope and MUST come from the signed active-series record in identity/key-management.md §7.6. Receivers use (actor_id, backup_class, series_id) to detect server-side rollback / withholding within the selected series."
    },
    "series_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based, strictly monotonically increasing sequence number within (actor_id, series_id). Genesis envelope of a series MUST set 0. Receivers MUST reject envelopes whose sequence does not strictly exceed the previously accepted sequence in the same series."
    },
    "supersedes": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^ck:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ],
      "description": "backup_id of the immediate predecessor in the same series_id. MUST be null for series_seq=0; MUST be non-null and reference an existing predecessor for series_seq>0."
    },
    "supersedes_digest": {
      "$ref": "#/$defs/hash",
      "description": "Required when supersedes is non-null. Hash of the canonical_json of the predecessor envelope (excluding auth_data.signature). Receivers MUST recompute and reject mismatches as `series_chain_broken`."
    },
    "frontier_ref": {
      "type": "object",
      "description": "Optional reference to the principal control stream frontier at envelope creation time. Improves rollback detection by anchoring the envelope to a verifiable control-stream position.",
      "required": [
        "frontier_digest"
      ],
      "properties": {
        "frontier_digest": {
          "$ref": "#/$defs/hash"
        },
        "anchor_ref": {
          "type": "string",
          "pattern": "^ck:anchor:sha256:[0-9a-f]{64}$"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "recovery_policy_ref": {
      "type": "object",
      "description": "Required for backup_class=did_recovery and optional as a signed recovery-flow hint for other backup classes. Binds the backup envelope to the active recovery policy version under which it was produced. Receivers MUST compare this tuple to the currently accepted recovery policy before using a did_recovery envelope; when present on other classes, mismatch fails as recovery_policy_mismatch but the field does not replace active-series, frontier, Realm/MLS authorization, or device-state checks. This is intentionally separate from frontier_ref and ssk_generation: it binds the recovery authorization surface, not only the device trust generation or control-stream position.",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^ck:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "encryption": {
      "type": "object",
      "required": [
        "recipient_method",
        "aead"
      ],
      "properties": {
        "recipient_method": {
          "type": "string",
          "enum": [
            "passphrase_kdf",
            "recovery_public_key",
            "secret_storage_key"
          ]
        },
        "recipient_key_ref": {
          "type": "string"
        },
        "kdf": {
          "type": "object",
          "required": [
            "name",
            "salt"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "argon2id",
                "pbkdf2"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "params": {
              "type": "object",
              "properties": {
                "memory_kib": {
                  "type": "integer",
                  "minimum": 65536
                },
                "iterations": {
                  "type": "integer",
                  "minimum": 3
                },
                "parallelism": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest_algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256",
                    "sha384",
                    "sha512"
                  ]
                }
              },
              "not": {
                "required": [
                  "hash"
                ]
              },
              "patternProperties": {
                "^x_[a-z][a-z0-9_]{0,63}$": true
              },
              "additionalProperties": false
            },
            "degraded_profile_reason": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  }
                },
                "required": ["name"]
              },
              "then": {
                "required": [
                  "params"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 65536
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 3
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "pbkdf2"
                  }
                },
                "required": ["name"]
              },
              "then": {
                "required": [
                  "params",
                  "degraded_profile_reason"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "iterations",
                      "digest_algorithm"
                    ],
                    "properties": {
                      "iterations": {
                        "type": "integer",
                        "minimum": 600000
                      },
                      "digest_algorithm": {
                        "type": "string",
                        "enum": [
                          "sha256",
                          "sha384",
                          "sha512"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ],
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        },
        "aead": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "xchacha20_poly1305",
                "aes_256_gcm",
                "chacha20_poly1305"
              ]
            },
            "aead_profile": {
              "type": "string",
              "pattern": "^ck\\.aead\\.[a-z0-9_]+\\.v[0-9]+$",
              "description": "Optional AEAD profile id that binds algorithm version, nonce length, tag length, key length, and AAD construction. Receivers that do not support the profile MUST fail closed instead of inferring semantics from name alone."
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url AEAD nonce. Required for the symmetric methods (passphrase_kdf / secret_storage_key). For recipient_method=passphrase_kdf this MUST equal HMAC-SHA256(HKDF(derived_key, info='cokret-key-backup-aead-nonce-v1'), canonical_json({backup_id, actor_id, device_id, backup_class, backup_version, created_at, aead.name, aead.aead_profile?, aead.nonce_salt}))[0:N_AEAD]; receivers recompute and reject mismatches. Absent for recovery_public_key (HPKE derives its nonce internally)."
            },
            "nonce_salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$",
              "description": "Producer-generated base64url random salt (at least 128 bits before encoding) included in the passphrase_kdf nonce derivation transcript. Required when recipient_method=passphrase_kdf; not secret, signed as envelope metadata, and prevents nonce reuse from duplicate business metadata tuples."
            },
            "enc": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url HPKE KEM encapsulated key. Required for recipient_method=recovery_public_key (HPKE base mode, DHKEM(X25519,HKDF-SHA256)); absent for the symmetric methods."
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        },
        "key_commitment": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            }
          },
          "then": {
            "required": [
              "kdf"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce",
                  "nonce_salt"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "secret_storage_key"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kdf"
              ]
            },
            "required": [
              "recipient_key_ref"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "recovery_public_key"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kdf"
              ]
            },
            "required": [
              "recipient_key_ref"
            ],
            "properties": {
              "aead": {
                "required": [
                  "enc"
                ]
              }
            }
          }
        }
      ],
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_type"
        ],
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "recovery_key_share",
              "self_signing_key",
              "user_signing_key",
              "recovery_secret",
              "mls_group_secrets_backup_key",
              "mls_group_state",
              "mls_epoch_secret",
              "pending_welcome",
              "private_account_state"
            ]
          },
          "realm_id": {
            "type": "string",
            "pattern": "^ck:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "mls_group_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "first_event_id": {
            "type": "string",
            "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "last_event_id": {
            "type": "string",
            "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "secret_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "patternProperties": {
          "^x_[a-z][a-z0-9_]{0,63}$": true
        },
        "additionalProperties": false
      }
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "plaintext_commitment": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "device_id",
        "verification_method",
        "signature_algorithm",
        "signature",
        "signed_fields"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verification_method": {
          "type": "string",
          "description": "DID URL identifying the device signing key."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ES256",
            "ML-DSA-65"
          ],
          "description": "Raw signature algorithm name; MUST be a value generated from an active signature-alg-registry row (Ed25519 / ES256 / ML-DSA-65). EdDSA is the proof_alg label, not a raw signature_algorithm value. ML-DSA-65 is gated behind the PQ migration profile."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url-encoded signature over canonical_json(envelope without auth_data.signature)."
        },
        "signed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "backup_id" } },
            { "contains": { "const": "actor_id" } },
            { "contains": { "const": "backup_class" } },
            { "contains": { "const": "backup_version" } },
            { "contains": { "const": "series_id" } },
            { "contains": { "const": "series_seq" } },
            { "contains": { "const": "supersedes" } },
            { "contains": { "const": "encryption" } },
          { "contains": { "const": "contents" } },
          { "contains": { "const": "ciphertext_digest" } }
        ],
          "description": "Names of envelope fields covered by the signature; MUST include backup_id, actor_id, backup_class, backup_version, series_id, series_seq, supersedes, encryption, contents, ciphertext_digest, and when present supersedes_digest, frontier_ref, recovery_policy_ref, and (hardening profile) ssk_generation."
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Accepted ck.cross_signing.publish.generation of the self-signing key generation that authorized the device signing this backup. This field replaces the temporary auth_data.x_ssk_generation extension for v1 final; hardening profiles require receivers to reject envelopes whose generation is below the current accepted generation outside the rotation grace window."
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "delete_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "legal_hold": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backup_class": {
            "const": "mls_history"
          }
        },
        "required": ["backup_class"]
      },
      "then": {
        "properties": {
          "encryption": {
            "properties": {
              "recipient_method": {
                "enum": [
                  "secret_storage_key",
                  "recovery_public_key"
                ]
              }
            }
          }
        },
        "description": "mls_history backups MUST use secret_storage_key or recovery_public_key (key-management.md §7.5.2 / §7.5.3 and device-lifecycle.md §12); passphrase_kdf, threshold_recovery, hardware_wrapped_key, and the removed device_snapshot_secret are rejected. recovery_policy_ref MAY appear as a signed hint, but is not required for mls_history."
      }
    },
    {
      "if": {
        "properties": {
          "backup_class": {
            "const": "did_recovery"
          }
        },
        "required": ["backup_class"]
      },
      "then": {
        "required": [
          "recovery_policy_ref"
        ],
        "properties": {
          "encryption": {
            "properties": {
              "recipient_method": {
                "enum": [
                  "recovery_public_key"
                ]
              }
            }
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  { "contains": { "const": "recovery_policy_ref" } }
                ]
              }
            }
          }
        },
        "description": "did_recovery backups MUST use recovery_public_key (key-management.md §5.0.1 first-backup gate), MUST carry recovery_policy_ref matching the active recovery policy, and MUST cover that field in auth_data.signed_fields. passphrase_kdf and secret_storage_key are forbidden for did_recovery; threshold_recovery and hardware_wrapped_key are recovery policy / proof-layer factors, not key-backup recipient methods."
      }
    },
    {
      "if": {
        "properties": {
          "mixed_secret_storage": {
            "const": true
          },
          "encryption": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            },
            "required": ["recipient_method"]
          }
        },
        "required": [
          "mixed_secret_storage",
          "encryption"
        ]
      },
      "then": {
        "properties": {
          "encryption": {
            "properties": {
              "kdf": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  },
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 262144
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 4
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "required": [
                  "name",
                  "params"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": { "const": 0 }
        },
        "required": [ "series_seq" ]
      },
      "then": {
        "properties": {
          "supersedes": { "type": "null" }
        },
        "required": [ "supersedes" ],
        "not": {
          "required": [ "supersedes_digest" ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": { "type": "integer", "minimum": 1 }
        },
        "required": [ "series_seq" ]
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "string",
            "pattern": "^ck:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  { "contains": { "const": "supersedes_digest" } }
                ]
              }
            }
          }
        },
        "required": [
          "supersedes",
          "supersedes_digest"
        ]
      }
    },
    {
      "if": {
        "required": [ "frontier_ref" ]
      },
      "then": {
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  { "contains": { "const": "frontier_ref" } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [ "recovery_policy_ref" ]
      },
      "then": {
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  { "contains": { "const": "recovery_policy_ref" } }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    }
  }
}
