{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup.schema.json",
  "title": "Arkret Encrypted Key Backup",
  "type": "object",
  "required": [
    "backup_id",
    "actor_id",
    "backup_kind",
    "backup_version",
    "series_id",
    "series_seq",
    "created_at",
    "encryption",
    "domain_separation",
    "ciphertext",
    "ciphertext_digest",
    "auth_data"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_kind": {
      "type": "string",
      "enum": [
        "secret_storage"
      ]
    },
    "mixed_secret_storage": {
      "type": "boolean",
      "default": false,
      "description": "True only for the personal_node exception where one encrypted backup envelope contains both identity-signing material and E2EE / MLS history material. Non-personal deployment profiles MUST reject this flag. When true and recipient_method=passphrase_kdf, the stricter Argon2id floor below applies."
    },
    "backup_version": {
      "type": "string",
      "pattern": "^kb_[A-Za-z0-9_-]+$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable identifier for one immutable chain of backup envelopes belonging to a single (actor_id, backup_kind). A pair MAY have multiple series during compromise rotation or migration; active series selection is outside this envelope and MUST come from the signed active-series record in identity/key-management.md §7.6. Receivers use (actor_id, backup_kind, series_id) to detect server-side rollback / withholding within the selected series."
    },
    "series_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based, strictly monotonically increasing sequence number within (actor_id, series_id). Genesis envelope of a series MUST set 0. Receivers MUST reject envelopes whose sequence does not strictly exceed the previously accepted sequence in the same series."
    },
    "supersedes_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ],
      "description": "backup_id of the immediate predecessor in the same series_id. MUST be absent for series_seq=0; MUST be present, non-null, and reference an existing predecessor for series_seq>0."
    },
    "supersedes_digest": {
      "$ref": "#/$defs/digest",
      "description": "Required when supersedes_id is non-null. Hash of the canonical_json of the predecessor envelope (excluding auth_data.signature). Receivers MUST recompute and reject mismatches as `series_chain_broken`."
    },
    "source_commit_ref": {
      "type": "object",
      "description": "Optional reference to the Principal Control Realm source RealmCommit and identity-root device generation at envelope creation time.",
      "required": [
        "realm_commit_id",
        "device_generation_ref"
      ],
      "properties": {
        "realm_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "device_generation_ref": {
          "$ref": "./recovery-session.schema.json#/$defs/pcr_generation_ref",
          "description": "PCR-local monotonic device generation. This is not a DID versionId and MUST equal the accepted current_device_generation_ref at the referenced checkpoint."
        }
      },
      "additionalProperties": false
    },
    "recovery_policy_ref": {
      "type": "object",
      "description": "Required whenever encryption.recipient_method is recovery_public_key, and optional as a signed recovery-strand hint otherwise. Binds the backup envelope to the active recovery policy version under which it was produced. Receivers MUST compare this tuple to the currently accepted recovery policy before using such an envelope; mismatch fails as recovery_policy_mismatch, but the field does not replace active-series, checkpoint, Realm/MLS authorization, or device-state checks. This is intentionally separate from source_commit_ref: it binds the recovery authorization surface, not only the device trust generation or control-stream position.",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/nullable_timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "encryption": {
      "type": "object",
      "required": [
        "recipient_method",
        "aead"
      ],
      "properties": {
        "recipient_method": {
          "type": "string",
          "enum": [
            "passphrase_kdf",
            "recovery_public_key",
            "secret_storage_key"
          ]
        },
        "recipient_key_ref": {
          "type": "string",
          "description": "For recipient_method=recovery_public_key, this MUST resolve to the inline backup_hpke.key_agreement_ref of a non-revoked method signing entry in the envelope's referenced accepted recovery policy, and the selected hpke_suite MUST appear in that entry's hpke_suites. DID Document-only key agreements are not an authorization source. A method signing entry's verification_method is a signing-key ref and MUST be rejected here."
        },
        "hpke_suite": {
          "type": "string",
          "enum": [
            "ak.hpke_x25519_aead_chacha20poly1305.v1",
            "ak.hpke_x25519_aead_aes256gcm.v1",
            "ak.hpke_p256_aead_aes256gcm.v1"
          ],
          "description": "Registered active HPKE suite (KEM x KDF x AEAD per RFC 9180) selector; the value space is the active rows of artifacts/registry/hpke-suite-registry.json. Applies only to recipient_method=recovery_public_key. When absent it denotes the default-MUST row ak.hpke_x25519_aead_chacha20poly1305.v1. aead.name MUST equal the selected suite's AEAD. An unregistered or inactive suite MUST be rejected (unsupported_hpke_suite). Absent / ignored for the symmetric methods (passphrase_kdf / secret_storage_key)."
        },
        "kdf": {
          "type": "object",
          "required": [
            "name",
            "salt"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "argon2id",
                "pbkdf2"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "params": {
              "type": "object",
              "properties": {
                "memory_kib": {
                  "type": "integer",
                  "minimum": 65536
                },
                "iterations": {
                  "type": "integer",
                  "minimum": 3
                },
                "parallelism": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest_algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256",
                    "sha384",
                    "sha512"
                  ]
                }
              },
              "not": {
                "required": [
                  "hash"
                ]
              },
              "patternProperties": {
                "^x_[a-z][a-z0-9_]{0,63}$": true
              },
              "additionalProperties": false
            },
            "degraded_profile_reason": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "then": {
                "required": [
                  "params"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 65536
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 3
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "pbkdf2"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "then": {
                "required": [
                  "params",
                  "degraded_profile_reason"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "iterations",
                      "digest_algorithm"
                    ],
                    "properties": {
                      "iterations": {
                        "type": "integer",
                        "minimum": 600000
                      },
                      "digest_algorithm": {
                        "type": "string",
                        "enum": [
                          "sha256",
                          "sha384",
                          "sha512"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ],
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        },
        "aead": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "xchacha20_poly1305",
                "aes_256_gcm",
                "chacha20_poly1305"
              ]
            },
            "aead_profile": {
              "type": "string",
              "pattern": "^ak\\.aead\\.[a-z0-9_]+\\.v[0-9]+$",
              "description": "Optional AEAD profile id that binds algorithm version, nonce length, tag length, key length, and AAD construction. Receivers that do not support the profile MUST fail closed instead of inferring semantics from name alone.",
              "$comment": "A receiver that does not recognise the profile (including reserved-but-unpublished ak.aead.hybrid_kem.* rows) MUST fail closed with reason unsupported_aead_profile; inferring parameters from aead.name alone is forbidden. See zh/identity/key-management.md §7.9."
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url AEAD nonce. Required for the symmetric methods (passphrase_kdf / secret_storage_key). For recipient_method=passphrase_kdf this MUST equal HMAC-SHA256(HKDF(derived_key, info='arkret-key-backup-aead-nonce-v1'), canonical_json({backup_id, actor_id, device_id, backup_kind, backup_version, created_at, aead.name, aead.aead_profile?, aead.nonce_salt}))[0:N_AEAD]; receivers recompute and reject mismatches. Absent for recovery_public_key (HPKE derives its nonce internally)."
            },
            "nonce_salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$",
              "description": "Producer-generated base64url random salt (at least 128 bits before encoding) included in the passphrase_kdf nonce derivation transcript. Required when recipient_method=passphrase_kdf; not secret, signed as envelope metadata, and prevents nonce reuse from duplicate business metadata tuples."
            },
            "enc": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url HPKE KEM encapsulated key. Required for recipient_method=recovery_public_key; the KEM/KDF/AEAD are pinned by encryption.hpke_suite (default ak.hpke_x25519_aead_chacha20poly1305.v1) per artifacts/registry/hpke-suite-registry.json. Absent for the symmetric methods."
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        },
        "key_commitment": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            }
          },
          "then": {
            "required": [
              "kdf"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce",
                  "nonce_salt"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "secret_storage_key"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kdf"
              ]
            },
            "required": [
              "recipient_key_ref"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "recovery_public_key"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kdf"
              ]
            },
            "required": [
              "recipient_key_ref"
            ],
            "properties": {
              "aead": {
                "required": [
                  "enc"
                ]
              }
            }
          }
        }
      ],
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "domain_separation": {
      "type": "object",
      "description": "Signed key-backup domain separation inputs. The HKDF info and fixed AEAD/HPKE AAD base are derived exactly from the envelope by key-management.md §7.2; only the subdomain and genuine x_* AAD extensions are carried on the wire.",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "aead_aad_extensions": {
          "type": "object",
          "description": "Optional producer-chosen AEAD/HPKE AAD extensions. Every member name MUST be x_*; implementations merge these members into the fixed derived AAD base before RFC 8785 canonicalization and MUST reject collisions.",
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "plaintext_commitment": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "device_id",
        "verification_method",
        "signature_algorithm",
        "signature",
        "device_authorize_event_id"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "DID URL identifying the device signing key."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ],
          "description": "Raw signature algorithm name; MUST be an active signature-alg-registry alg whose proof_kinds includes raw_detached_signature. Ed25519 is the v1 default; ML-DSA-65 is gated behind the PQ migration profile."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url-encoded signature over RFC 8785 JCS(envelope without auth_data.signature). Every present closed envelope member, including optional and x_* members, is authenticated; no wire field list selects the projection."
        },
        "device_authorize_event_id": {
          "type": "string",
          "pattern": "^ak:event:[A-Za-z0-9_-]{44}$",
          "description": "Accepted current-generation ak.device.authorize Event anchoring the device signing this backup."
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "delete_after": {
          "$ref": "./time.schema.json#/$defs/nullable_timestamp"
        },
        "legal_hold": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mixed_secret_storage": {
            "const": true
          },
          "encryption": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            },
            "required": [
              "recipient_method"
            ]
          }
        },
        "required": [
          "mixed_secret_storage",
          "encryption"
        ]
      },
      "then": {
        "properties": {
          "encryption": {
            "properties": {
              "kdf": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  },
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 262144
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 4
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "required": [
                  "name",
                  "params"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": {
            "const": 0
          }
        },
        "required": [
          "series_seq"
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "supersedes_id"
              ]
            }
          },
          {
            "not": {
              "required": [
                "supersedes_digest"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "series_seq"
        ]
      },
      "then": {
        "properties": {
          "supersedes_id": {
            "type": "string",
            "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "supersedes_id",
          "supersedes_digest"
        ]
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    }
  }
}
