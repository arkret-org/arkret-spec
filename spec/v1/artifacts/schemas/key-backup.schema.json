{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/key-backup.schema.json",
  "title": "Contrix Encrypted Key Backup",
  "type": "object",
  "required": [
    "backup_id",
    "actor_id",
    "backup_class",
    "backup_version",
    "series_id",
    "series_seq",
    "created_at",
    "encryption",
    "contents",
    "ciphertext",
    "ciphertext_digest",
    "auth_data"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "pattern": "^cx:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^cx:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_class": {
      "type": "string",
      "enum": [
        "did_recovery",
        "secret_storage",
        "mls_history",
        "external"
      ]
    },
    "mixed_secret_storage": {
      "type": "boolean",
      "default": false,
      "description": "True only for the personal_node exception where one encrypted backup envelope contains both identity-signing material and E2EE / MLS history material. Non-personal deployment profiles MUST reject this flag. When true and recipient_method=passphrase_kdf, the stricter Argon2id floor below applies."
    },
    "backup_version": {
      "type": "string",
      "pattern": "^kb_[A-Za-z0-9_-]+$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^cx:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable identifier for the chain of envelopes belonging to the same (actor_id, backup_class). MUST be constant across rotations within a series. Receivers use (actor_id, backup_class, series_id) to detect server-side rollback / withholding (see identity/key-management.md §7.6)."
    },
    "series_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based, strictly monotonically increasing sequence number within (actor_id, series_id). Genesis envelope of a series MUST set 0. Receivers MUST reject envelopes whose sequence does not strictly exceed the previously accepted sequence in the same series."
    },
    "supersedes": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^cx:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ],
      "description": "backup_id of the immediate predecessor in the same series_id. MUST be null for series_seq=0; MUST be non-null and reference an existing predecessor for series_seq>0."
    },
    "supersedes_digest": {
      "$ref": "#/$defs/hash",
      "description": "Required when supersedes is non-null. Hash of the canonical_json of the predecessor envelope (excluding auth_data.signature). Receivers MUST recompute and reject mismatches as `series_chain_broken`."
    },
    "frontier_ref": {
      "type": "object",
      "description": "Optional reference to the principal control stream frontier at envelope creation time. Improves rollback detection by anchoring the envelope to a verifiable control-stream position.",
      "required": [
        "frontier_digest"
      ],
      "properties": {
        "frontier_digest": {
          "$ref": "#/$defs/hash"
        },
        "anchor_ref": {
          "type": "string",
          "pattern": "^cx:anchor:sha256:[0-9a-f]{64}$"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "encryption": {
      "type": "object",
      "required": [
        "recipient_method",
        "aead"
      ],
      "properties": {
        "recipient_method": {
          "type": "string",
          "enum": [
            "passphrase_kdf",
            "recovery_public_key",
            "secret_storage_key",
            "threshold_recovery",
            "hardware_wrapped_key"
          ]
        },
        "recipient_key_ref": {
          "type": "string"
        },
        "kdf": {
          "type": "object",
          "required": [
            "name",
            "salt"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "argon2id",
                "pbkdf2"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "params": {
              "type": "object",
              "properties": {
                "memory_kib": {
                  "type": "integer",
                  "minimum": 65536
                },
                "iterations": {
                  "type": "integer",
                  "minimum": 3
                },
                "parallelism": {
                  "type": "integer",
                  "minimum": 1
                },
                "hash": {
                  "type": "string",
                  "enum": [
                    "sha256",
                    "sha384",
                    "sha512"
                  ]
                }
              },
              "additionalProperties": true
            },
            "degraded_profile_reason": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  }
                },
                "required": ["name"]
              },
              "then": {
                "required": [
                  "params"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 65536
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 3
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "pbkdf2"
                  }
                },
                "required": ["name"]
              },
              "then": {
                "required": [
                  "params",
                  "degraded_profile_reason"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "iterations",
                      "hash"
                    ],
                    "properties": {
                      "iterations": {
                        "type": "integer",
                        "minimum": 600000
                      },
                      "hash": {
                        "type": "string",
                        "enum": [
                          "sha256",
                          "sha384",
                          "sha512"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        },
        "aead": {
          "type": "object",
          "required": [
            "name",
            "nonce"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "xchacha20_poly1305",
                "aes_256_gcm"
              ]
            },
            "aead_profile": {
              "type": "string",
              "pattern": "^cx\\.aead\\.[a-z0-9_]+\\.v[0-9]+$",
              "description": "Optional AEAD profile id that binds algorithm version, nonce length, tag length, key length, and AAD construction. Receivers that do not support the profile MUST fail closed instead of inferring semantics from name alone."
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url AEAD nonce. For recipient_method=passphrase_kdf this MUST equal HMAC-SHA256(HKDF(derived_key, info='contrix-key-backup-aead-nonce-v1'), canonical_json({backup_id, actor_id, device_id, backup_class, backup_version, created_at, aead.name, aead.aead_profile?, aead.nonce_salt}))[0:N_AEAD]; receivers recompute and reject mismatches."
            },
            "nonce_salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$",
              "description": "Producer-generated base64url random salt (at least 128 bits before encoding) included in the passphrase_kdf nonce derivation transcript. Required when recipient_method=passphrase_kdf; not secret, signed as envelope metadata, and prevents nonce reuse from duplicate business metadata tuples."
            }
          },
          "additionalProperties": true
        },
        "key_commitment": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            }
          },
          "then": {
            "required": [
              "kdf"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce_salt"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_type"
        ],
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "recovery_key_share",
              "self_signing_key",
              "user_signing_key",
              "recovery_secret",
              "mls_group_secrets_backup_key",
              "mls_group_state",
              "mls_epoch_secret",
              "pending_welcome",
              "private_account_state"
            ]
          },
          "realm_id": {
            "type": "string",
            "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "mls_group_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "first_event_id": {
            "type": "string",
            "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "last_event_id": {
            "type": "string",
            "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "secret_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "additionalProperties": true
      }
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "plaintext_commitment": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "device_id",
        "verification_method",
        "signature_alg",
        "signature",
        "signed_fields"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^cx:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verification_method": {
          "type": "string",
          "description": "DID URL identifying the device signing key."
        },
        "signature_alg": {
          "type": "string",
          "enum": [
            "EdDSA",
            "ES256"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url-encoded signature over canonical_json(envelope without auth_data.signature)."
        },
        "signed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "backup_id" } },
            { "contains": { "const": "actor_id" } },
            { "contains": { "const": "backup_class" } },
            { "contains": { "const": "backup_version" } },
            { "contains": { "const": "series_id" } },
            { "contains": { "const": "series_seq" } },
            { "contains": { "const": "supersedes" } },
            { "contains": { "const": "encryption" } },
            { "contains": { "const": "contents" } },
            { "contains": { "const": "ciphertext_digest" } }
          ],
          "description": "Names of envelope fields covered by the signature; MUST include backup_id, actor_id, backup_class, backup_version, series_id, series_seq, supersedes, encryption, contents, ciphertext_digest, and when present supersedes_digest and frontier_ref."
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "delete_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "legal_hold": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mixed_secret_storage": {
            "const": true
          },
          "encryption": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            },
            "required": ["recipient_method"]
          }
        },
        "required": [
          "mixed_secret_storage",
          "encryption"
        ]
      },
      "then": {
        "properties": {
          "encryption": {
            "properties": {
              "kdf": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  },
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 262144
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 4
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "required": [
                  "name",
                  "params"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": { "const": 0 }
        },
        "required": [ "series_seq" ]
      },
      "then": {
        "properties": {
          "supersedes": { "type": "null" }
        },
        "required": [ "supersedes" ],
        "not": {
          "required": [ "supersedes_digest" ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": { "type": "integer", "minimum": 1 }
        },
        "required": [ "series_seq" ]
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "string",
            "pattern": "^cx:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  { "contains": { "const": "supersedes_digest" } }
                ]
              }
            }
          }
        },
        "required": [
          "supersedes",
          "supersedes_digest"
        ]
      }
    },
    {
      "if": {
        "required": [ "frontier_ref" ]
      },
      "then": {
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  { "contains": { "const": "frontier_ref" } }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    }
  }
}
