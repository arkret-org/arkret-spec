{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/key-backup.schema.json",
  "title": "Arkret Encrypted Key Backup",
  "type": "object",
  "required": [
    "backup_id",
    "actor_id",
    "backup_class",
    "backup_version",
    "series_id",
    "series_seq",
    "created_at",
    "encryption",
    "domain_separation",
    "contents",
    "ciphertext",
    "ciphertext_digest",
    "auth_data"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_class": {
      "type": "string",
      "enum": [
        "did_recovery",
        "secret_storage",
        "mls_history"
      ]
    },
    "mixed_secret_storage": {
      "type": "boolean",
      "default": false,
      "description": "True only for the personal_node exception where one encrypted backup envelope contains both identity-signing material and E2EE / MLS history material. Non-personal deployment profiles MUST reject this flag. When true and recipient_method=passphrase_kdf, the stricter Argon2id floor below applies."
    },
    "backup_version": {
      "type": "string",
      "pattern": "^kb_[A-Za-z0-9_-]+$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable identifier for one immutable chain of backup envelopes belonging to a single (actor_id, backup_class). A pair MAY have multiple series during compromise rotation or migration; active series selection is outside this envelope and MUST come from the signed active-series record in identity/key-management.md §7.6. Receivers use (actor_id, backup_class, series_id) to detect server-side rollback / withholding within the selected series."
    },
    "series_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based, strictly monotonically increasing sequence number within (actor_id, series_id). Genesis envelope of a series MUST set 0. Receivers MUST reject envelopes whose sequence does not strictly exceed the previously accepted sequence in the same series."
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ],
      "description": "backup_id of the immediate predecessor in the same series_id. MUST be absent for series_seq=0; MUST be present, non-null, and reference an existing predecessor for series_seq>0."
    },
    "supersedes_digest": {
      "$ref": "#/$defs/hash",
      "description": "Required when supersedes is non-null. Hash of the canonical_json of the predecessor envelope (excluding auth_data.signature). Receivers MUST recompute and reject mismatches as `series_chain_broken`."
    },
    "frontier_ref": {
      "type": "object",
      "description": "Optional reference to the principal control stream frontier at envelope creation time. Improves rollback detection by sealing the envelope to a verifiable control-stream position.",
      "required": [
        "frontier_digest"
      ],
      "properties": {
        "frontier_digest": {
          "$ref": "#/$defs/hash"
        },
        "seal_ref": {
          "type": "string",
          "pattern": "^ak:seal:(?:(?:sha256|blake3):[0-9a-f]{64})$"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "recovery_policy_ref": {
      "type": "object",
      "description": "Required for backup_class=did_recovery and optional as a signed recovery-strand hint for other backup classes. Binds the backup envelope to the active recovery policy version under which it was produced. Receivers MUST compare this tuple to the currently accepted recovery policy before using a did_recovery envelope; when present on other classes, mismatch fails as recovery_policy_mismatch but the field does not replace active-series, frontier, Realm/MLS authorization, or device-state checks. This is intentionally separate from frontier_ref and ssk_generation: it binds the recovery authorization surface, not only the device trust generation or control-stream position.",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "encryption": {
      "type": "object",
      "required": [
        "recipient_method",
        "aead"
      ],
      "properties": {
        "recipient_method": {
          "type": "string",
          "enum": [
            "passphrase_kdf",
            "recovery_public_key",
            "secret_storage_key"
          ]
        },
        "recipient_key_ref": {
          "type": "string"
        },
        "hpke_suite": {
          "type": "string",
          "enum": [
            "ak.hpke_x25519_aead_chacha20poly1305.v1",
            "ak.hpke_x25519_aead_aes256gcm.v1",
            "ak.hpke_p256_aead_aes256gcm.v1"
          ],
          "description": "Registered active HPKE suite (KEM x KDF x AEAD per RFC 9180) selector; the value space is the active rows of artifacts/registry/hpke-suite-registry.json. Applies only to recipient_method=recovery_public_key. When absent it denotes the default-MUST row ak.hpke_x25519_aead_chacha20poly1305.v1. aead.name MUST equal the selected suite's AEAD. An unregistered or inactive suite MUST be rejected (unsupported_hpke_suite). Absent / ignored for the symmetric methods (passphrase_kdf / secret_storage_key)."
        },
        "kdf": {
          "type": "object",
          "required": [
            "name",
            "salt"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "argon2id",
                "pbkdf2"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "params": {
              "type": "object",
              "properties": {
                "memory_kib": {
                  "type": "integer",
                  "minimum": 65536
                },
                "iterations": {
                  "type": "integer",
                  "minimum": 3
                },
                "parallelism": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest_algorithm": {
                  "type": "string",
                  "enum": [
                    "sha256",
                    "sha384",
                    "sha512"
                  ]
                }
              },
              "not": {
                "required": [
                  "hash"
                ]
              },
              "patternProperties": {
                "^x_[a-z][a-z0-9_]{0,63}$": true
              },
              "additionalProperties": false
            },
            "degraded_profile_reason": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "then": {
                "required": [
                  "params"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 65536
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 3
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "name": {
                    "const": "pbkdf2"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "then": {
                "required": [
                  "params",
                  "degraded_profile_reason"
                ],
                "properties": {
                  "params": {
                    "required": [
                      "iterations",
                      "digest_algorithm"
                    ],
                    "properties": {
                      "iterations": {
                        "type": "integer",
                        "minimum": 600000
                      },
                      "digest_algorithm": {
                        "type": "string",
                        "enum": [
                          "sha256",
                          "sha384",
                          "sha512"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ],
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        },
        "aead": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "xchacha20_poly1305",
                "aes_256_gcm",
                "chacha20_poly1305"
              ]
            },
            "aead_profile": {
              "type": "string",
              "pattern": "^ak\\.aead\\.[a-z0-9_]+\\.v[0-9]+$",
              "description": "Optional AEAD profile id that binds algorithm version, nonce length, tag length, key length, and AAD construction. Receivers that do not support the profile MUST fail closed instead of inferring semantics from name alone."
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url AEAD nonce. Required for the symmetric methods (passphrase_kdf / secret_storage_key). For recipient_method=passphrase_kdf this MUST equal HMAC-SHA256(HKDF(derived_key, info='arkret-key-backup-aead-nonce-v1'), canonical_json({backup_id, actor_id, device_id, backup_class, backup_version, created_at, aead.name, aead.aead_profile?, aead.nonce_salt}))[0:N_AEAD]; receivers recompute and reject mismatches. Absent for recovery_public_key (HPKE derives its nonce internally)."
            },
            "nonce_salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$",
              "description": "Producer-generated base64url random salt (at least 128 bits before encoding) included in the passphrase_kdf nonce derivation transcript. Required when recipient_method=passphrase_kdf; not secret, signed as envelope metadata, and prevents nonce reuse from duplicate business metadata tuples."
            },
            "enc": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url HPKE KEM encapsulated key. Required for recipient_method=recovery_public_key; the KEM/KDF/AEAD are pinned by encryption.hpke_suite (default ak.hpke_x25519_aead_chacha20poly1305.v1) per artifacts/registry/hpke-suite-registry.json. Absent for the symmetric methods."
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        },
        "key_commitment": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            }
          },
          "then": {
            "required": [
              "kdf"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce",
                  "nonce_salt"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "secret_storage_key"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kdf"
              ]
            },
            "required": [
              "recipient_key_ref"
            ],
            "properties": {
              "aead": {
                "required": [
                  "nonce"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient_method": {
                "const": "recovery_public_key"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kdf"
              ]
            },
            "required": [
              "recipient_key_ref"
            ],
            "properties": {
              "aead": {
                "required": [
                  "enc"
                ]
              }
            }
          }
        }
      ],
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "domain_separation": {
      "type": "object",
      "description": "Signed key-backup domain separation transcript. Binds HKDF info and AEAD/HPKE AAD to the envelope fields used by key-management.md §7.1 / §7.5 so implementations do not infer subdomain semantics from ciphertext or local state.",
      "required": [
        "hkdf_info",
        "subdomain",
        "aead_aad"
      ],
      "properties": {
        "hkdf_info": {
          "type": "string",
          "pattern": "^arkret-key-backup/(did_recovery|secret_storage|mls_history)/[a-z][a-z0-9_]{0,63}/v1$"
        },
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "aead_aad": {
          "type": "object",
          "required": [
            "schema",
            "actor_id",
            "device_id",
            "backup_class",
            "backup_version",
            "created_at",
            "item_types"
          ],
          "properties": {
            "schema": {
              "const": "ak.schema.key_backup.v1"
            },
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/did"
            },
            "device_id": {
              "type": "string",
              "minLength": 1
            },
            "backup_class": {
              "type": "string",
              "enum": [
                "did_recovery",
                "secret_storage",
                "mls_history"
              ]
            },
            "backup_version": {
              "type": "string",
              "pattern": "^kb_[A-Za-z0-9_-]+$"
            },
            "created_at": {
              "$ref": "#/$defs/timestamp"
            },
            "item_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "managed_principal_bindings": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/managed_principal_binding"
              },
              "description": "Canonical sorted set of every distinct managed_principal_binding carried by contents[] and by the decrypted plaintext keybag. Required when any managed Agent PCR item is present; otherwise it MUST be absent. This binds managed-principal custody to the AEAD/HPKE ciphertext and prevents cross-Agent or cross-PCR transplant."
            },
            "recipient_method": {
              "type": "string",
              "enum": [
                "passphrase_kdf",
                "recovery_public_key",
                "secret_storage_key"
              ],
              "description": "SEC-04: the envelope's encryption.recipient_method bound into the AEAD AAD so a ciphertext can never be cross-opened under the wrong recipient interpretation. Sealer and opener reconstruct it byte-identically from the stored envelope; receivers MUST fail closed on a method/AAD mismatch."
            },
            "recipient_key_ref": {
              "type": "string",
              "description": "SEC-04: the envelope's encryption.recipient_key_ref (recipient key / verification method) bound into the AEAD AAD so the recipient identity is part of the authenticated context."
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]{0,63}$": true
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_type"
        ],
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "recovery_key_share",
              "self_signing_key",
              "user_signing_key",
              "recovery_secret",
              "mls_account_secret",
              "mls_private_plaintext",
              "mls_group_secrets_backup_key",
              "mls_group_state",
              "mls_epoch_secret",
              "pending_welcome",
              "private_account_state"
            ]
          },
          "realm_id": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          },
          "managed_principal_binding": {
            "$ref": "#/$defs/managed_principal_binding",
            "description": "Required only for controller-custodied Native Personal Agent PCR MLS material. The outer backup actor remains the controller; this binding does not change backup ownership."
          },
          "mls_group_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "first_event_id": {
            "type": "string",
            "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "last_event_id": {
            "type": "string",
            "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "secret_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "secret_version": {
            "type": "integer",
            "minimum": 1,
            "description": "Monotonic version of the backed-up secret (e.g. mls_account_secret). Used by clients for deterministic preferred-backup selection and anti-rollback ordering (key-management.md §9.1). Present on versioned secret items; absent on share-style items such as recovery_key_share."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "managed_principal_binding"
              ]
            },
            "then": {
              "required": [
                "realm_id"
              ],
              "properties": {
                "item_type": {
                  "enum": [
                    "mls_group_state",
                    "mls_epoch_secret",
                    "pending_welcome"
                  ]
                }
              }
            }
          }
        ],
        "patternProperties": {
          "^x_[a-z][a-z0-9_]{0,63}$": true
        },
        "additionalProperties": false
      }
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "plaintext_commitment": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "auth_data": {
      "type": "object",
      "required": [
        "device_id",
        "verification_method",
        "signature_algorithm",
        "signature",
        "signed_fields"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verification_method": {
          "type": "string",
          "description": "DID URL identifying the device signing key."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ES256",
            "ML-DSA-65"
          ],
          "description": "Raw signature algorithm name; MUST be a value generated from an active signature-alg-registry row (Ed25519 / ES256 / ML-DSA-65). EdDSA is the proof_alg label, not a raw signature_algorithm value. ML-DSA-65 is gated behind the PQ migration profile."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "base64url-encoded signature over canonical_json(envelope without auth_data.signature)."
        },
        "signed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "backup_id"
              }
            },
            {
              "contains": {
                "const": "actor_id"
              }
            },
            {
              "contains": {
                "const": "backup_class"
              }
            },
            {
              "contains": {
                "const": "backup_version"
              }
            },
            {
              "contains": {
                "const": "series_id"
              }
            },
            {
              "contains": {
                "const": "series_seq"
              }
            },
            {
              "contains": {
                "const": "encryption"
              }
            },
            {
              "contains": {
                "const": "domain_separation"
              }
            },
            {
              "contains": {
                "const": "contents"
              }
            },
            {
              "contains": {
                "const": "ciphertext_digest"
              }
            }
          ],
          "description": "Names of envelope fields covered by the signature; MUST include backup_id, actor_id, backup_class, backup_version, series_id, series_seq, encryption, domain_separation, contents, ciphertext_digest, and when present supersedes, supersedes_digest, frontier_ref, and recovery_policy_ref."
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Accepted ak.cross_signing.publish.generation of the self-signing key generation that authorized the device signing this backup. Exactly one of auth_data.ssk_generation and auth_data.device_authorize_event_id identifies the device trust root."
        },
        "device_authorize_event_id": {
          "type": "string",
          "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Accepted ak.device.authorize event id anchoring the service_attested/enrollment-authority device signing this backup. Exactly one of auth_data.ssk_generation and auth_data.device_authorize_event_id identifies the device trust root."
        }
      },
      "oneOf": [
        {
          "required": [
            "ssk_generation"
          ],
          "not": {
            "required": [
              "device_authorize_event_id"
            ]
          }
        },
        {
          "required": [
            "device_authorize_event_id"
          ],
          "not": {
            "required": [
              "ssk_generation"
            ]
          }
        }
      ],
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "delete_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "legal_hold": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contents": {
            "contains": {
              "type": "object",
              "required": [
                "managed_principal_binding"
              ]
            }
          }
        },
        "required": [
          "contents"
        ]
      },
      "then": {
        "required": [
          "frontier_ref",
          "recovery_policy_ref"
        ],
        "properties": {
          "backup_class": {
            "const": "mls_history"
          },
          "encryption": {
            "properties": {
              "recipient_method": {
                "const": "recovery_public_key"
              }
            },
            "required": [
              "recipient_key_ref"
            ]
          },
          "domain_separation": {
            "properties": {
              "hkdf_info": {
                "const": "arkret-key-backup/mls_history/managed_agent_pcr/v1"
              },
              "subdomain": {
                "const": "managed_agent_pcr"
              },
              "aead_aad": {
                "required": [
                  "managed_principal_bindings",
                  "recipient_method",
                  "recipient_key_ref"
                ]
              }
            }
          },
          "contents": {
            "contains": {
              "type": "object",
              "required": [
                "item_type",
                "realm_id",
                "managed_principal_binding"
              ],
              "properties": {
                "item_type": {
                  "const": "mls_group_state"
                }
              }
            }
          }
        },
        "description": "A controller-owned mls_history envelope carrying managed Agent PCR material MUST be recoverable by the controller recovery public key, bind the controller policy and both controller/Agent PCR frontiers, use the managed_agent_pcr domain, and contain a current mls_group_state item. Semantic validation requires the AAD binding set to equal the distinct bindings in public contents and decrypted plaintext."
      }
    },
    {
      "if": {
        "properties": {
          "contents": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "managed_principal_binding"
                ]
              }
            }
          }
        },
        "required": [
          "contents"
        ]
      },
      "then": {
        "properties": {
          "domain_separation": {
            "properties": {
              "aead_aad": {
                "not": {
                  "required": [
                    "managed_principal_bindings"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backup_class": {
            "const": "mls_history"
          }
        },
        "required": [
          "backup_class"
        ]
      },
      "then": {
        "properties": {
          "encryption": {
            "properties": {
              "recipient_method": {
                "enum": [
                  "secret_storage_key",
                  "recovery_public_key"
                ]
              }
            }
          }
        },
        "description": "mls_history backups MUST use secret_storage_key or recovery_public_key (key-management.md §7.5.2 / §7.5.3 and device-lifecycle.md §12); passphrase_kdf, threshold_recovery, hardware_wrapped_key, and the removed device_snapshot_secret are rejected. recovery_policy_ref MAY appear as a signed hint, but is not required for mls_history."
      }
    },
    {
      "if": {
        "properties": {
          "backup_class": {
            "const": "did_recovery"
          }
        },
        "required": [
          "backup_class"
        ]
      },
      "then": {
        "required": [
          "recovery_policy_ref"
        ],
        "properties": {
          "encryption": {
            "properties": {
              "recipient_method": {
                "enum": [
                  "recovery_public_key"
                ]
              }
            }
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "recovery_policy_ref"
                    }
                  }
                ]
              }
            }
          }
        },
        "description": "did_recovery backups MUST use recovery_public_key (key-management.md §5.0.1 first-backup gate), MUST carry recovery_policy_ref matching the active recovery policy, and MUST cover that field in auth_data.signed_fields. passphrase_kdf and secret_storage_key are forbidden for did_recovery; threshold_recovery and hardware_wrapped_key are recovery policy / proof-layer factors, not key-backup recipient methods."
      }
    },
    {
      "if": {
        "properties": {
          "mixed_secret_storage": {
            "const": true
          },
          "encryption": {
            "properties": {
              "recipient_method": {
                "const": "passphrase_kdf"
              }
            },
            "required": [
              "recipient_method"
            ]
          }
        },
        "required": [
          "mixed_secret_storage",
          "encryption"
        ]
      },
      "then": {
        "properties": {
          "encryption": {
            "properties": {
              "kdf": {
                "properties": {
                  "name": {
                    "const": "argon2id"
                  },
                  "params": {
                    "required": [
                      "memory_kib",
                      "iterations",
                      "parallelism"
                    ],
                    "properties": {
                      "memory_kib": {
                        "type": "integer",
                        "minimum": 262144
                      },
                      "iterations": {
                        "type": "integer",
                        "minimum": 4
                      },
                      "parallelism": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "required": [
                  "name",
                  "params"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": {
            "const": 0
          }
        },
        "required": [
          "series_seq"
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "supersedes"
              ]
            }
          },
          {
            "not": {
              "required": [
                "supersedes_digest"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "series_seq": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "series_seq"
        ]
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "string",
            "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "supersedes"
                    }
                  },
                  {
                    "contains": {
                      "const": "supersedes_digest"
                    }
                  }
                ]
              }
            }
          }
        },
        "required": [
          "supersedes",
          "supersedes_digest"
        ]
      }
    },
    {
      "if": {
        "required": [
          "frontier_ref"
        ]
      },
      "then": {
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "frontier_ref"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "recovery_policy_ref"
        ]
      },
      "then": {
        "properties": {
          "auth_data": {
            "properties": {
              "signed_fields": {
                "allOf": [
                  {
                    "contains": {
                      "const": "recovery_policy_ref"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "$defs": {
    "managed_frontier_ref": {
      "type": "object",
      "description": "Accepted and sealed Agent Principal Control Realm frontier covered by a controller-owned managed-PCR backup item.",
      "required": [
        "frontier_digest",
        "seal_ref",
        "mls_epoch"
      ],
      "properties": {
        "frontier_digest": {
          "$ref": "#/$defs/hash"
        },
        "seal_ref": {
          "type": "string",
          "pattern": "^ak:seal:(?:(?:sha256|blake3):[0-9a-f]{64})$"
        },
        "mls_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "managed_principal_binding": {
      "type": "object",
      "description": "Binds controller-custodied MLS recovery material to one managed Native Personal Agent and its Principal Control Realm. controller_id MUST equal the outer backup actor_id; authorization_ref is resolved from the Agent DID history at envelope created_at and MUST authorize principal_control_realm_recovery.",
      "required": [
        "managed_principal_id",
        "controller_id",
        "principal_control_realm_id",
        "authorization_ref",
        "managed_frontier_ref"
      ],
      "properties": {
        "managed_principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "controller_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "managed_frontier_ref": {
          "$ref": "#/$defs/managed_frontier_ref"
        }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    }
  }
}
