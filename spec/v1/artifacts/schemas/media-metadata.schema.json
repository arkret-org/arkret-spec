{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/media-metadata.schema.json",
  "title": "Cokret Media Metadata",
  "type": "object",
  "required": [
    "blob_ref",
    "media_type",
    "size_bytes",
    "access"
  ],
  "not": {
    "required": ["size"],
    "$comment": "byte counts use size_bytes"
  },
  "properties": {
    "blob_ref": {
      "type": "string",
      "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "width": {
      "type": "integer",
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "preview_blob_ref": {
      "type": "string",
      "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "thumbnails": {
      "type": "array",
      "description": "Bound thumbnail / preview descriptors. Producers SHOULD prefer this over legacy preview_blob_ref for private or E2EE media.",
      "items": {
        "type": "object",
        "required": [
          "source_blob_ref",
          "thumbnail_blob_ref",
          "width",
          "height",
          "media_type",
          "visibility",
          "derivation_profile"
        ],
        "properties": {
          "source_blob_ref": {
            "$ref": "#/$defs/blob_ref"
          },
          "source_ciphertext_digest": {
            "$ref": "#/$defs/hash"
          },
          "thumbnail_blob_ref": {
            "$ref": "#/$defs/blob_ref"
          },
          "thumbnail_ciphertext_digest": {
            "$ref": "#/$defs/hash"
          },
          "width": {
            "type": "integer",
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "generated_by_service_did": {
            "$ref": "#/$defs/did"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "realm_bound",
              "actor_private",
              "device_bound"
            ]
          },
          "derivation_profile": {
            "type": "string",
            "pattern": "^ck\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
          }
        },
        "additionalProperties": true
      },
      "uniqueItems": true
    },
    "access": {
      "type": "object",
      "required": [
        "visibility"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "realm_bound",
            "actor_private",
            "device_bound"
          ]
        },
        "range_supported": {
          "type": "boolean"
        },
        "cache_control": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "blob_ref": {
      "type": "string",
      "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    }
  }
}
