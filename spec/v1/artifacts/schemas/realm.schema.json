{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/realm.schema.json",
  "title": "Contrix Realm",
  "type": "object",
  "required": [
    "id",
    "schema",
    "title",
    "created_by_principal",
    "trust_domain",
    "schema_refs",
    "default_discoverability",
    "default_join_rule",
    "history_visibility",
    "encryption_profile",
    "anchor_profile",
    "anchorer",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.realm.v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "security_class": {
      "type": "string",
      "enum": [
        "standard",
        "high_assurance"
      ],
      "description": "Optional security class. 'high_assurance' forbids federation_policy=open and SHOULD use stricter resolver/E2EE/audit defaults. Omitted = 'standard'."
    },
    "created_by_principal": {
      "$ref": "#/$defs/did"
    },
    "trust_domain": {
      "$ref": "#/$defs/trust_domain",
      "description": "Immutable deployment trust domain captured by cx.realm.create. Receivers MUST require this to match the current Realm trust domain before accepting cross-domain replay-sensitive proofs."
    },
    "owning_organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/did"
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "fields": {
      "type": "object",
      "description": "Product/profile fields. Security-relevant discriminators such as purpose=principal_control are schema constrained below; other product fields remain extension-defined.",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "principal_control"
          ]
        }
      },
      "additionalProperties": true
    },
    "relation_profiles": {
      "type": "array",
      "description": "Optional Relation cardinality and conflict profiles declared by this Realm schema/profile.",
      "items": {
        "type": "object",
        "required": [
          "relation_kind",
          "cardinality"
        ],
        "properties": {
          "relation_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "from_type": {
            "type": "string"
          },
          "to_type": {
            "type": "string"
          },
          "relation_scope": {
            "type": "string",
            "enum": [
              "realm",
              "security_boundary",
              "board",
              "global"
            ],
            "default": "realm"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one_to_one",
              "one_to_many",
              "many_to_one",
              "many_to_many"
            ]
          },
          "dedupe_key": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "max_to_per_from": {
            "type": "integer",
            "minimum": 1
          },
          "max_from_per_to": {
            "type": "integer",
            "minimum": 1
          },
          "multi_edge": {
            "type": "boolean"
          },
          "rank_field": {
            "type": "string"
          },
          "on_conflict": {
            "type": "string",
            "enum": [
              "reject",
              "close_previous",
              "deterministic_winner",
              "require_review"
            ],
            "default": "deterministic_winner"
          }
        },
        "additionalProperties": true
      }
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "default_discoverability": {
      "type": "string",
      "enum": [
        "public",
        "listed",
        "restricted",
        "unlisted",
        "invite_only",
        "secret"
      ]
    },
    "default_join_rule": {
      "type": "string",
      "enum": [
        "public",
        "invite",
        "knock",
        "restricted",
        "knock_restricted",
        "closed"
      ]
    },
    "history_visibility": {
      "type": "string",
      "enum": [
        "world_readable",
        "shared",
        "invited",
        "joined",
        "restricted"
      ]
    },
    "encryption_profile": {
      "type": "string",
      "enum": [
        "none",
        "mls_rfc9420",
        "external"
      ]
    },
    "federation_policy": {
      "type": "string",
      "enum": [
        "open",
        "restricted",
        "closed",
        "quarantine"
      ]
    },
    "sync_endpoints": {
      "type": "array",
      "description": "Realm-level service binding list for shared anchorer / sync / mirror / federation peer surfaces. Member-level delivery_binding remains on cx.member.state and MUST NOT be inferred from this list.",
      "items": {
        "$ref": "#/$defs/sync_endpoint"
      },
      "uniqueItems": true
    },
    "anchor_profile": {
      "type": "string",
      "enum": [
        "single_did",
        "threshold",
        "open_set",
        "mixed"
      ],
      "description": "Create-locked Anchor finality profile. single_did and threshold deployments may require signed Anchor single-chain uniqueness; open_set deployments allow multiple Anchor leaves and deterministic joined views; mixed deployments use a primary anchorer plus fallback recovery anchorer."
    },
    "digest_algorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512",
        "sha3_256",
        "blake3"
      ],
      "default": "sha256",
      "description": "Create-locked hash algorithm used for Move/Anchor ids, state_root, and Merkle leaves within this Realm. Defaults to sha256. Migration via hash-transition Anchor; see event-auth-state-resolution.md §4.2.5."
    },
    "anchorer": {
      "type": "object",
      "description": "Genesis value for the Realm anchorer cell. Subsequent changes are ordinary Moves finalized by the previous anchorer. For single_did profiles, recovery_members and controller organization evidence are required so reducer/authz can reject single-organization recovery setups.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "single_did",
            "threshold",
            "open_set",
            "mixed"
          ]
        },
        "did": {
          "$ref": "#/$defs/did"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "controller_organization": {
          "$ref": "#/$defs/did",
          "description": "DID of the organization controlling the primary anchorer, when the resolver or deployment policy can derive it. Required for single_did profile so recovery diversity can be verified."
        },
        "recovery_controller_organizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Organization DIDs controlling recovery_members. Reducer MUST verify at least one differs from controller_organization for single_did profile."
        }
      },
      "additionalProperties": false
    },
    "max_anchor_staleness_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 86400000,
      "description": "Maximum age of a Move.anchor_ref relative to the current Anchor view. Offline clients exceeding this window must rebase and re-sign."
    },
    "bottom_escalation_after_ms": {
      "type": "integer",
      "minimum": 60000,
      "description": "Optional timeout after which unresolved bottom diagnostics should be escalated to recovery governance. Expiry does not choose a winner automatically."
    },
    "cell_lattices": {
      "type": "array",
      "description": "Optional Realm-specific lattice declarations for extension cell families.",
      "items": {
        "$ref": "#/$defs/cell_lattice"
      },
      "uniqueItems": true
    },
    "co_write_policy": {
      "type": "array",
      "description": "Optional whitelist constraining which cell families may be written by the same Move.",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^cx\\.component\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "retention_policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "avatar_blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "security_class": {
            "const": "high_assurance"
          }
        },
        "required": [
          "security_class"
        ]
      },
      "then": {
        "properties": {
          "federation_policy": {
            "enum": [
              "closed",
              "restricted",
              "quarantine"
            ]
          }
        }
      }
    },
    {
      "$comment": "single_did anchor profiles must declare an explicit recovery anchorer path at Realm create time. Distinct controlling organization is semantic/reducer validation because JSON Schema cannot compare DID-controller derivations across resolver evidence.",
      "if": {
        "properties": {
          "anchor_profile": {
            "const": "single_did"
          }
        },
        "required": [
          "anchor_profile"
        ]
      },
      "then": {
        "properties": {
          "anchorer": {
            "required": [
              "type",
              "did",
              "recovery_members",
              "controller_organization",
              "recovery_controller_organizations"
            ],
            "properties": {
              "type": {
                "const": "single_did"
              },
              "recovery_members": {
                "minItems": 1
              },
              "recovery_controller_organizations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "Principal control Realms are ordinary collaboration Realms, but the profile discriminator must be closed at schema level: fields.purpose and schema_refs must appear together.",
      "if": {
        "properties": {
          "fields": {
            "properties": {
              "purpose": {
                "const": "principal_control"
              }
            },
            "required": [
              "purpose"
            ]
          }
        },
        "required": [
          "fields"
        ]
      },
      "then": {
        "properties": {
          "schema_refs": {
            "contains": {
              "const": "cx.profile.principal_control_realm.v1"
            }
          }
        }
      }
    },
    {
      "$comment": "The inverse guard prevents a profile-tagged Realm from omitting the machine-readable purpose discriminator.",
      "if": {
        "properties": {
          "schema_refs": {
            "contains": {
              "const": "cx.profile.principal_control_realm.v1"
            }
          }
        },
        "required": [
          "schema_refs"
        ]
      },
      "then": {
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "properties": {
              "purpose": {
                "const": "principal_control"
              }
            },
            "required": [
              "purpose"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "trust_domain": {
      "type": "string",
      "pattern": "^cx:trust_domain:[a-z0-9][a-z0-9._\\-:]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sync_endpoint": {
      "type": "object",
      "required": [
        "did",
        "endpoint",
        "role",
        "service_type",
        "plaintext_visible"
      ],
      "properties": {
        "did": {
          "$ref": "#/$defs/did"
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "mirror",
            "anchorer",
            "sync",
            "search_projection",
            "federation_peer"
          ]
        },
        "service_type": {
          "type": "string",
          "enum": [
            "principal_server",
            "sync_node",
            "anchorer",
            "search_service",
            "archive_node",
            "key_recovery_service",
            "recovery_service"
          ]
        },
        "plaintext_visible": {
          "type": "boolean"
        },
        "visibility_scope": {
          "type": "string",
          "enum": [
            "metadata_only",
            "encrypted_events",
            "plaintext_events"
          ]
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^cx:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "cell_lattice": {
      "type": "object",
      "required": [
        "cell_family",
        "lattice",
        "bottom",
        "cell_role"
      ],
      "properties": {
        "cell_family": {
          "type": "string",
          "pattern": "^cx\\.component\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[0-9]+$"
        },
        "lattice": {
          "type": "string",
          "enum": [
            "or_set",
            "mv_register",
            "cas_register",
            "fsm",
            "counter",
            "ordered_log",
            "lww_register",
            "rga"
          ]
        },
        "bottom": {
          "type": "string",
          "enum": [
            "reject",
            "expose"
          ]
        },
        "cell_role": {
          "type": "string",
          "enum": [
            "authorization_root",
            "policy_root",
            "anchorer_root",
            "membership",
            "lifecycle",
            "ui_affordance",
            "content",
            "draft",
            "cosmetic",
            "audit",
            "telemetry"
          ],
          "description": "Semantic role declared by Realm schema. authorization_root / policy_root / anchorer_root / membership / lifecycle MUST NOT use lattice types lww_register or rga (enforced by allOf below). ui_affordance / content / draft / cosmetic MAY use lww_register or rga."
        },
        "parameters": {
          "type": "object"
        },
        "initial_value": {
          "description": "Optional cell schema initial value (cas_register only). When defined, the cas_register `join` algorithm initialises `current` to this value (rather than null) before applying any Move. Combined with a `head_eq: <initial_value>` predicate on the first set Move, this implements singleton-once-set cells via the empty sentinel pattern. See event-auth-state-resolution.md §5.3.3."
        },
        "sentinel_writers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "uniqueItems": true,
          "description": "Optional companion to `initial_value` (cas_register only). When `initial_value` is declared, set ops whose effect equals the sentinel are rejected by default (initial_value_reserved). Listing event_kinds here permits those event_kinds to write the sentinel back — typically the cleanup event_kind in a singleton-once-set / explicit-reset workflow. Capability authorization remains a separate independent check. See event-auth-state-resolution.md §5.3.3."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lattice": {
                "enum": [
                  "lww_register",
                  "rga"
                ]
              }
            },
            "required": [
              "lattice"
            ]
          },
          "then": {
            "properties": {
              "cell_role": {
                "enum": [
                  "ui_affordance",
                  "content",
                  "draft",
                  "cosmetic"
                ]
              }
            }
          }
        },
        {
          "$comment": "initial_value is only defined for cas_register (see event-auth-state-resolution.md §5.3.3). Other lattices reject the field.",
          "if": {
            "required": ["initial_value"]
          },
          "then": {
            "properties": {
              "lattice": { "const": "cas_register" }
            },
            "required": ["lattice"]
          }
        },
        {
          "$comment": "sentinel_writers is the companion of initial_value; it only makes sense on a cas_register cell that has declared initial_value. Reject declarations on other lattices, and reject declarations on cas_register cells that lack initial_value (since there is no sentinel to authorise writing back).",
          "if": {
            "required": ["sentinel_writers"]
          },
          "then": {
            "properties": {
              "lattice": { "const": "cas_register" }
            },
            "required": ["lattice", "initial_value"]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
