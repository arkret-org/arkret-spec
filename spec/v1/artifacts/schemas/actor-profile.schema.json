{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/actor-profile.schema.json",
  "title": "Contrix Actor Profile",
  "type": "object",
  "required": [
    "id",
    "schema",
    "principal_id",
    "actor_kind",
    "display_name",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:actor_profile:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.actor_profile.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "principal_id": {
      "$ref": "#/$defs/did"
    },
    "actor_kind": {
      "type": "string",
      "enum": [
        "user",
        "org",
        "team",
        "agent",
        "service",
        "device",
        "integration"
      ],
      "description": "Directory / UX classification only. MUST NOT participate in authorization, reducer acceptance, capability resolution, or any wire-protocol decision: those MUST consult DID + Grant + Constraint exclusively. Implementations are free to use actor_kind for icon selection, directory filtering and presentation, but a wrong value MUST NOT widen or narrow what a principal can do. See zh/models/actor.md."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9._+~-]{1,128}:[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "description": "Contrix canonical handle string: <localpart>:<domain>. The @ mention sigil is not part of the handle."
    },
    "avatar_blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "soft_logged_out",
        "locked",
        "suspended",
        "deactivated",
        "erasure_pending"
      ],
      "description": "Public projection of the account lifecycle status values defined in zh/identity/account-lifecycle.md §3. Implementations MAY hide or coarsen this field in projection views, but the wire enum mirrors cx.account.status."
    },
    "accountable_principal_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/did"
      }
    },
    "profile_fields": {
      "type": "object"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
