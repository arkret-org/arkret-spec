{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-link-operations.schema.json",
  "title": "Arkret Realm Link Read Operation DTOs",
  "description": "Closed response DTOs for the self-surface cross-Realm link read operations (ak.self.realm_link.*). Writes use caller-signed ak.realm.link Events submitted through the ordinary Event admission surface. General link-graph cycles are legal; traversal uses a visited set and does not reject a write merely for forming a cycle. The durable link payload is the canonical ak.realm.link; see spec/v1/zh/models/realm-links.md.",
  "anyOf": [
    {
      "$ref": "#/$defs/realm_link_list"
    },
    {
      "$ref": "#/$defs/realm_effective_policy_outcome"
    }
  ],
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "link_kind": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "governed_by",
            "discoverable_from",
            "join_gate_from",
            "inherits_policy_from",
            "confidential_extension_of",
            "mirror_of",
            "split_from",
            "replaces"
          ]
        },
        {
          "pattern": "^x\\.[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?\\.[a-z][a-z0-9_]{0,63}$"
        }
      ],
      "description": "Core value or machine-registered extension kind using x.<reverse-dns>.<name>; unregistered extension values fail closed."
    },
    "link_status": {
      "$ref": "./event-payload.schema.json#/$defs/hierarchy_link_status"
    },
    "realm_link_entry": {
      "type": "object",
      "required": [
        "realm_id",
        "target_realm_id",
        "link_kind",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "target_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "link_kind": {
          "$ref": "#/$defs/link_kind"
        },
        "status": {
          "$ref": "#/$defs/link_status"
        },
        "label": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "commitment": {
          "type": "string",
          "description": "Optional opaque commitment / proof reference linking this edge to an external attestation."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "realm_link_list": {
      "type": "object",
      "required": [
        "realm_id",
        "direction",
        "links"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "direction": {
          "type": "string",
          "enum": [
            "outbound",
            "inbound",
            "both"
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/realm_link_entry"
          }
        }
      },
      "additionalProperties": false
    },
    "realm_effective_policy_outcome": {
      "type": "object",
      "description": "Merged effective policy after walking governed_by / inherits_policy_from ancestors per the Realm's ak.realm.inheritance_policy declaration.",
      "required": [
        "realm_id",
        "effective_policy",
        "inheritance_chain_ids",
        "inheritance_mode"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_policy": {
          "type": "object",
          "description": "Merged policy view (e.g. allowed_policies[], allowed_capability_bundles[])."
        },
        "inheritance_chain_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "inheritance_mode": {
          "type": "string",
          "enum": [
            "explicit",
            "none"
          ],
          "description": "explicit when the Realm has projected a ak.realm.inheritance_policy; none otherwise (implicit inheritance is forbidden)."
        }
      },
      "additionalProperties": false
    }
  }
}
