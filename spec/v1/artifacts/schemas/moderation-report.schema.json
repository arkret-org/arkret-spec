{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/moderation-report.schema.json",
  "title": "Contrix Moderation Report",
  "type": "object",
  "required": [
    "space_id",
    "target_ref",
    "reason",
    "reporter"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^cx:report:[0-9a-hjkmnp-z]{26}$"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "target_ref": {
      "type": "string",
      "pattern": "^(cx:(event|flow|space|message|morph|relation|view|blob):[0-9a-hjkmnp-z]{26}|cx:blob:sha256:[0-9a-f]{64})$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harassment",
        "hate_speech",
        "nsfw",
        "illegal",
        "misinformation",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "reporter": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(cx:(event|message|blob|frank|morph|relation):[0-9a-hjkmnp-z]{26}|cx:blob:sha256:[0-9a-f]{64})$"
      },
      "uniqueItems": true
    },
    "evidence_package": {
      "type": "object",
      "properties": {
        "encryption": {
          "type": "string"
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ciphertext_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "plaintext_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        }
      },
      "additionalProperties": true
    },
    "frank": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "triaged",
        "reviewing",
        "actioned",
        "dismissed",
        "appealed",
        "closed"
      ]
    },
    "routed_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "other"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "required": [
          "description"
        ]
      }
    }
  ],
  "additionalProperties": false
}
