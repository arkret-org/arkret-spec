{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/moderation-report.schema.json",
  "title": "Contrix Moderation Report",
  "type": "object",
  "required": [
    "realm_id",
    "target_ref",
    "reason",
    "reporter"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^cx:report:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_ref": {
      "type": "string",
      "pattern": "^(cx:(event|flow|realm|message|morph|relation|view|blob):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|cx:blob:sha256:[0-9a-f]{64})$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harassment",
        "hate_speech",
        "nsfw",
        "illegal",
        "misinformation",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "reporter": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(cx:(event|message|blob|franking_proof|morph|relation):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|cx:blob:sha256:[0-9a-f]{64})$"
      },
      "uniqueItems": true
    },
    "evidence_package": {
      "type": "object",
      "properties": {
        "encryption": {
          "type": "string"
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ciphertext_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        },
        "plaintext_digest": {
          "type": "string",
          "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
        }
      },
      "additionalProperties": true
    },
    "franking_proof": {
      "$ref": "#/$defs/franking_proof",
      "description": "Optional franking proof metadata block. Mirrors the franking_proof object spec'd in zh/governance/content-moderation.md §3.4. It proves service receipt of ciphertext metadata; it does not prove plaintext authorship unless a separate sender-commitment profile is enabled."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "triaged",
        "reviewing",
        "actioned",
        "dismissed",
        "appealed",
        "closed"
      ],
      "description": "Non-authoritative status mirror for client / UI convenience. The authoritative moderation lifecycle lives on the moderation-queue-item produced by the reducer (see schemas/moderation-queue-item.schema.json + governance/content-moderation.md §3.3). Reducers MUST NOT read this field for routing or state-machine decisions; if present on submit it MUST be either absent or 'submitted'."
    },
    "routed_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "other"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "required": [
          "description"
        ]
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "event_ref": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "franking_proof": {
      "type": "object",
      "required": [
        "kind",
        "franking_proof_id",
        "realm_id",
        "event_id",
        "ciphertext_digest",
        "aad_digest",
        "sender_claim",
        "received_by",
        "received_at",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "cx.moderation.franking_proof"
        },
        "franking_proof_id": {
          "type": "string",
          "pattern": "^cx:franking_proof:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "realm_id": {
          "type": "string",
          "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "event_id": {
          "$ref": "#/$defs/event_ref"
        },
        "routing_metadata_digest": {
          "$ref": "#/$defs/hash",
          "description": "Digest of canonical event routing metadata covered by the receiving service."
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/hash"
        },
        "aad_digest": {
          "$ref": "#/$defs/hash"
        },
        "sender_claim": {
          "type": "object",
          "required": [
            "actor_id",
            "device_id",
            "mls_group_id",
            "epoch"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/did"
            },
            "device_id": {
              "type": "string",
              "pattern": "^cx:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "mls_group_id": {
              "type": "string",
              "minLength": 1
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "received_by": {
          "$ref": "#/$defs/did"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Receiving service signature over the canonical franking proof transcript."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
