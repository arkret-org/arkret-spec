{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/moderation-report.schema.json",
  "title": "Arkret Moderation Report Operation",
  "description": "Closed signed-request DTO for ak.self.moderation.command.report.v1. Canonical evidence and franking-proof objects live in moderation-evidence.schema.json so Event payload validation does not depend back on an operation request schema.",
  "$ref": "#/$defs/moderation_report_request_body",
  "$defs": {
    "moderation_report_event_submission": {
      "allOf": [
        {
          "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
        },
        {
          "properties": {
            "event": {
              "properties": {
                "kind": {
                  "const": "ak.self.moderation.report",
                  "x-arkret-value-ownership": {
                    "class": "namespaced_symbol",
                    "authority": "moderation-report.schema.json#/$defs/moderation_report_event_submission/allOf/1/properties/event/properties/kind",
                    "owner": "moderation-report.schema.json#/$defs/moderation_report_event_submission/allOf/1/properties/event/properties/kind",
                    "values": [
                      "ak.self.moderation.report"
                    ]
                  }
                },
                "payload": {
                  "properties": {
                    "provenance": {
                      "const": "self",
                      "x-arkret-value-ownership": {
                        "class": "owned_symbol",
                        "authority": "moderation-report.schema.json#/$defs/moderation_report_event_submission/allOf/1/properties/event/properties/payload/properties/provenance",
                        "owner": "moderation-report.schema.json#/$defs/moderation_report_event_submission/allOf/1/properties/event/properties/payload/properties/provenance",
                        "values": [
                          "self"
                        ]
                      }
                    }
                  },
                  "not": {
                    "required": [
                      "source_provider"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "payload",
                "realm_id",
                "scope_ref",
                "actor_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "executed_by"
                    ]
                  },
                  {
                    "required": [
                      "authorization_ref"
                    ]
                  },
                  {
                    "required": [
                      "applet_id"
                    ]
                  },
                  {
                    "required": [
                      "preconditions"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "event"
          ]
        }
      ],
      "description": "Direct-holder signed ak.self.moderation.report Event. The current governance Station resolves current authorization and scope, then commits the exact Event or rejects it; the request carries no RealmCommit, current state, predecessor or caller-selected authorization basis."
    },
    "moderation_report_request_body": {
      "type": "object",
      "required": [
        "report_event"
      ],
      "properties": {
        "report_event": {
          "$ref": "#/$defs/moderation_report_event_submission"
        }
      },
      "additionalProperties": false,
      "description": "Carries exactly one direct-holder signed moderation report Event and no unsigned report projection."
    }
  }
}
