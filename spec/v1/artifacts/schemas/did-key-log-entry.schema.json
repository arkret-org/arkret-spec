{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/did-key-log-entry.schema.json",
  "title": "Cokret DID Key Log Entry",
  "type": "object",
  "required": [
    "did",
    "seq",
    "operation",
    "head_event_digest",
    "operation_body",
    "created_at",
    "proofs"
  ],
  "properties": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic DID method log sequence for this DID. seq=0 is the inception entry and MUST NOT carry prev_event_digest; every seq>0 entry MUST carry prev_event_digest equal to the previous accepted entry's head_event_digest."
    },
    "operation": {
      "type": "string",
      "description": "Normalized operation kind. The DID method-specific raw operation object is carried in operation_body; this field is the reducer/verifier discriminator.",
      "enum": [
        "inception",
        "rotate",
        "recover",
        "deactivate",
        "service_update"
      ]
    },
    "prev_event_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$",
      "description": "Hash of the previous accepted key-log entry. Required for seq>0 and forbidden for seq=0."
    },
    "head_event_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "operation_body": {
      "type": "object",
      "minProperties": 1,
      "description": "DID method-specific raw operation object. This is not a generic JSON Patch; validation dispatches by DID method and operation kind."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-envelope.schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "seq": {
            "const": 0
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "not": {
          "required": [
            "prev_event_digest"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "minimum": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "required": [
          "prev_event_digest"
        ]
      }
    }
  ],
  "additionalProperties": false
}
