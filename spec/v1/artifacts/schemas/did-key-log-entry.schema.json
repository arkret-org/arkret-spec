{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/did-key-log-entry.schema.json",
  "title": "Contrix DID Key Log Entry",
  "type": "object",
  "required": [
    "did",
    "seq",
    "operation",
    "head_event_hash",
    "created_at",
    "proofs"
  ],
  "properties": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "type": "string",
      "enum": [
        "inception",
        "rotate",
        "recover",
        "deactivate",
        "service_update"
      ]
    },
    "prev_event_hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "head_event_hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "patch": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
