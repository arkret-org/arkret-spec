{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/read-cursor.schema.json",
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "read_scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "circle",
            "space",
            "strand",
            "thread"
          ],
          "description": "Read-scope object kind per zh/models/private-objects.md §2.2. Track-scoped read cursors use kind='strand' plus track_name. Thread cursors use kind='thread' with container_ref = the thread root message id (zh/discovery/read-receipts.md §5); thread is a projection selector over the reply sub-timeline, not a first-class protocol object. Shares the read-scope discriminator family with read-receipt.schema.json; each schema declares its own supported subset."
        },
        "container_ref": {
          "type": "string",
          "pattern": "^ak:(circle|space|strand|message):[A-Za-z0-9_-]{44}$",
          "description": "Required when kind is circle, space, strand, or thread; omitted for kind='realm'. Thread read scopes reference the root message."
        },
        "track_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Required when kind='strand' AND the cursor scopes a single track (e.g. 'discussion', 'synthesis', or any profile-registered track name). Track names MUST match the Strand's registered tracks; unknown tracks MUST be rejected with schema_violation."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "realm"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "container_ref"
                  ]
                },
                {
                  "required": [
                    "track_name"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "container_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "container_ref": {
                "pattern": "^ak:circle:[A-Za-z0-9_-]{44}$"
              }
            },
            "not": {
              "required": [
                "track_name"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "space"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "container_ref": {
                "pattern": "^ak:space:[A-Za-z0-9_-]{44}$"
              }
            },
            "not": {
              "required": [
                "track_name"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "strand"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "container_ref": {
                "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "thread"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "container_ref": {
                "pattern": "^ak:message:[A-Za-z0-9_-]{44}$"
              }
            },
            "not": {
              "required": [
                "track_name"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": [
        "event_id",
        "hlc"
      ],
      "properties": {
        "event_id": {
          "type": "string",
"pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "additionalProperties": false
    }
  },
  "title": "Arkret Read Cursor",
  "description": "Actor-private multi-device read cursor. Stored in encrypted account data or actor-private stream; NEVER published into a shared Realm Event history. Bound to (actor_id, realm_id, read_scope, position, HLC, device_id) per zh/discovery/read-receipts.md §6.6. Multi-device merge is causal-first per §6.5: the position that causally dominates wins regardless of HLC; HLC max decides only causally concurrent positions, and device_id only breaks equal HLCs.",
  "type": "object",
  "required": [
    "id",
    "schema",
    "actor_id",
    "device_id",
    "realm_id",
    "read_scope",
    "position",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:read_cursor:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ak.schema.read_cursor.v1"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/core_id"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Originating device. Required for multi-device convergence: when two devices race on the same (actor_id, realm_id, read_scope) the receiver first picks the causally dominating position; only for causally concurrent positions does it pick the greater HLC, and device_id provides a deterministic actor_id-scoped tiebreaker when those HLCs are equal. device_id MUST NOT be used to select a position that another position causally dominates."
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "read_scope": {
      "$ref": "#/$defs/read_scope"
    },
    "position": {
      "$ref": "#/$defs/position"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
