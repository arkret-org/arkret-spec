{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/read-cursor.schema.json",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "title": "Cokret Read Cursor",
  "description": "Actor-private multi-device read cursor. Stored in encrypted account data or actor-private stream; NEVER published into a shared Realm Event history. Bound to (actor_id, realm_id, read_scope, position, HLC, device_id) per zh/discovery/read-receipts.md §6.6 so that concurrent updates from multiple devices converge by HLC max.",
  "type": "object",
  "required": [
    "id",
    "schema",
    "actor_id",
    "device_id",
    "realm_id",
    "read_scope",
    "position",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ck:read_cursor:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ck.schema.read_cursor.v1"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Originating device. Required for multi-device convergence: when two devices race on the same (actor_id, realm_id, read_scope) the receiver picks the entry with greater HLC; device_id provides a deterministic actor_id-scoped tiebreaker when HLCs are equal."
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "read_scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "circle",
            "space",
            "flow"
          ],
          "description": "Read-scope object kind per zh/models/private-objects.md ?2.2. Track-scoped read cursors use kind='flow' plus track_name."
        },
        "ref": {
          "type": "string",
          "pattern": "^ck:(circle|space|flow):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Required when kind is circle, space, or flow; omitted for kind='realm'."
        },
        "track_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Required when kind='flow' AND the cursor scopes a single track (e.g. 'discussion', 'synthesis', or any profile-registered track name). Track names MUST match the Flow's registered tracks; unknown tracks MUST be rejected with schema_violation."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "realm"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ref"
                  ]
                },
                {
                  "required": [
                    "track_name"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:circle:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "not": {
              "required": [
                "track_name"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "space"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:space:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "not": {
              "required": [
                "track_name"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "flow"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": [
        "event_id",
        "hlc"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
