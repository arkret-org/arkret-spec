{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/read-cursor.schema.json",
  "title": "Contrix Read Cursor",
  "description": "Actor-private multi-device read cursor. Stored in encrypted account data or actor-private stream; NEVER published into a shared Realm Event history. Bound to (actor_id, realm_id, read_scope, position, HLC, device_id) per zh/discovery/read-receipts.md §6.6 so that concurrent updates from multiple devices converge by HLC max.",
  "type": "object",
  "required": [
    "id",
    "schema",
    "actor_id",
    "device_id",
    "realm_id",
    "read_scope",
    "position",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:read_cursor:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.read_cursor.v1"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^cx:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Originating device. Required for multi-device convergence: when two devices race on the same (actor_id, realm_id, read_scope) the receiver picks the entry with greater HLC; device_id provides a deterministic actor_id-scoped tiebreaker when HLCs are equal."
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "read_scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "flow",
            "thread",
            "view",
            "message",
            "morph"
          ],
          "description": "Read-scope object kind. Track-scoped read cursors (e.g. discussion vs synthesis) use kind='flow' plus an explicit 'track' field, not a kind variant — the standard track set is profile-extensible and MUST NOT be hardcoded into this enum."
        },
        "ref": {
          "type": "string",
          "pattern": "^cx:(realm|flow|message|morph|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Required when kind is anything other than 'realm'. Identifies the target object whose timeline this read cursor tracks."
        },
        "track": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Required when kind='flow' AND the cursor scopes a single track (e.g. 'discussion', 'synthesis', or any profile-registered track name). Track names MUST match the Flow's registered tracks; unknown tracks MUST be rejected with schema_violation."
        },
        "track_scope": {
          "type": "string",
          "enum": ["all"],
          "description": "Only valid when kind='flow'. Use track_scope='all' instead of omitting track when the cursor covers the entire Flow regardless of track."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "realm" }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["ref"] },
                { "required": ["track"] },
                { "required": ["track_scope"] }
              ]
            }
          },
          "else": {
            "required": ["ref"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "flow" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^cx:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "oneOf": [
              {
                "required": ["track"],
                "not": { "required": ["track_scope"] }
              },
              {
                "required": ["track_scope"],
                "properties": {
                  "track_scope": { "const": "all" }
                },
                "not": { "required": ["track"] }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["track"] },
                { "required": ["track_scope"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "thread" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^cx:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "description": "Thread read scopes reference the root message of the thread."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "message" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^cx:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "morph" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^cx:morph:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "view" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^cx:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": ["event_id", "hlc"],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": false
}
