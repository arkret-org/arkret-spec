          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object"
          },
          "description": "Exact ordered native did:webvh entry objects from inception through the containing recovery.begin payload.next_resolution.version_id. Apply registered native parameter/proof rules and reject gaps, duplicates, surplus entries after that exact target, or a first entry other than inception. The separately supplied next_resolution commitments must independently recompute from this target."
        },
        "witness_records": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          },
          "description": "Available native witness records, unique by versionId. Accepted prefix must satisfy its witness policy; successor records may be absent until finish. Any supplied record must verify; no surplus or invalid records."
        }
