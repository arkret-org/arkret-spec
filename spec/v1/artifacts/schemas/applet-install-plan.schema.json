{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-install-plan.schema.json",
  "title": "Arkret Applet InstallPlan",
  "description": "Canonical plan returned by ak.self.applet.install.command.preview and recomputed by ak.self.applet.command.install before commit. plan_digest is calculated over the canonical InstallPlan object with plan_digest omitted.",
  "type": "object",
  "required": [
    "schema",
    "plan_id",
    "applet_id",
    "package_digest",
    "registration_epoch",
    "effective_scope",
    "requested_scopes",
    "approved_scopes",
    "denied_scopes",
    "events_to_submit",
    "capability_constraints",
    "namespace_conflicts",
    "e2ee_effect",
    "widget_effect",
    "warnings",
    "plan_digest"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.applet_install_plan.v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^ak:plan:[A-Za-z0-9_-]+$"
    },
    "applet_id": {
      "$ref": "#/$defs/applet_id"
    },
    "package_digest": {
      "$ref": "#/$defs/digest"
    },
    "registration_epoch": {
      "$ref": "#/$defs/digest"
    },
    "effective_scope": {
      "$ref": "#/$defs/effective_scope"
    },
    "requested_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "approved_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope_grant"
      }
    },
    "denied_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/denied_scope"
      }
    },
    "events_to_submit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_submission"
      }
    },
    "capability_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability_constraint"
      }
    },
    "namespace_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namespace_conflict"
      }
    },
    "e2ee_effect": {
      "$ref": "#/$defs/e2ee_effect"
    },
    "widget_effect": {
      "$ref": "#/$defs/widget_effect"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "applet_id": {
      "$ref": "./common-ids.schema.json#/$defs/applet_id"
    },
    "event_ref": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "grant_id": {
      "$ref": "./agent-operations.schema.json#/$defs/grant_id"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "effective_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm"
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            },
            "realm_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "./common-ids.schema.json#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scope_grant": {
      "type": "object",
      "required": [
        "actions",
        "realm_ids",
        "constraints"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "realm_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "circle_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/circle_id"
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "denied_scope": {
      "type": "object",
      "required": [
        "requested_scope",
        "reason_code"
      ],
      "properties": {
        "requested_scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "event_submission": {
      "type": "object",
      "required": [
        "event_kind",
        "payload"
      ],
      "properties": {
        "event_kind": {
          "type": "string",
          "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "capability_constraint": {
      "type": "object",
      "required": [
        "constraint_kind"
      ],
      "properties": {
        "constraint_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "namespace_conflict": {
      "type": "object",
      "required": [
        "namespace",
        "resolution"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/non_empty_string"
        },
        "existing_owner": {
          "$ref": "#/$defs/non_empty_string"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "deny",
            "require_admin_approval",
            "override"
          ]
        }
      },
      "additionalProperties": false
    },
    "e2ee_effect": {
      "type": "object",
      "required": [
        "mls_join_required",
        "plaintext_access"
      ],
      "properties": {
        "mls_join_required": {
          "type": "boolean"
        },
        "plaintext_access": {
          "type": "string",
          "enum": [
            "none",
            "metadata_only",
            "policy_declared"
          ]
        },
        "authorization_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "widget_effect": {
      "type": "object",
      "required": [
        "widget_allowed"
      ],
      "properties": {
        "widget_allowed": {
          "type": "boolean"
        },
        "policy_event_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/event_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
