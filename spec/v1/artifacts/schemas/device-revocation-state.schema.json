{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/device-revocation-state.schema.json",
  "title": "Arkret Durable Device Revocation State",
  "description": "Durable exact-device revocation fence. A receiver that knows this authenticated pending/revoked state blocks affected new live actions locally. Unknown remote revocation can have a propagation window for ordinary data. Fresh proof issue is not a separate Event admission action. Terminal safety outcomes preserve exact transaction, authorization and generation binding.",
  "oneOf": [
    {
      "$ref": "#/$defs/device_revocation_record"
    }
  ],
  "$defs": {
    "device_revocation_record": {
      "oneOf": [
        {
          "$ref": "#/$defs/account_device_revocation_record"
        },
        {
          "allOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/device_revocation_gate_record"
                },
                {
                  "$ref": "#/$defs/device_revocation_rejected_state"
                }
              ]
            },
            {
              "required": [
                "actor_id"
              ],
              "not": {
                "required": [
                  "account_id"
                ]
              }
            }
          ]
        }
      ]
    },
    "device_revocation_gate_record": {
      "description": "Gate-relevant durable state for an exact device generation. Rejected records are audit history and are excluded; pending and revoked records remain visible together so committing one transaction cannot hide another surviving pending transaction.",
      "oneOf": [
        {
          "$ref": "#/$defs/device_revocation_pending_state"
        },
        {
          "$ref": "#/$defs/device_revoked_state"
        }
      ]
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "device_generation_ref": {
      "$ref": "./recovery-session.schema.json#/$defs/pcr_generation_ref",
      "description": "Reducer-derived monotonic generation local to the exact Account PCR or Realm actor; never a DID version."
    },
    "denied_actions": {
      "type": "array",
      "description": "Closed canonical action-class list blocked by revocation_pending on every deployment.",
      "prefixItems": [
        {
          "const": "session_grant_issue_or_refresh",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/0",
            "owner": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/0",
            "values": [
              "session_grant_issue_or_refresh"
            ]
          }
        },
        {
          "const": "device_pairing_code_claim",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/1",
            "owner": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/1",
            "values": [
              "device_pairing_code_claim"
            ]
          }
        },
        {
          "const": "keypackage_claim",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/2",
            "owner": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/2",
            "values": [
              "keypackage_claim"
            ]
          }
        },
        {
          "const": "to_device_write",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/3",
            "owner": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/3",
            "values": [
              "to_device_write"
            ]
          }
        },
        {
          "const": "event_write",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/4",
            "owner": "device-revocation-state.schema.json#/$defs/denied_actions/prefixItems/4",
            "values": [
              "event_write"
            ]
          }
        }
      ],
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "device_revocation_fields": {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "target_device_authorize_event_id",
        "target_device_generation_ref",
        "proposal_event_id",
        "accepted_at",
        "acceptance_sequence"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.device_revocation_state.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "device-revocation-state.schema.json#/$defs/device_revocation_fields/properties/schema",
            "owner": "device-revocation-state.schema.json#/$defs/device_revocation_fields/properties/schema",
            "values": [
              "ak.schema.device_revocation_state.v1"
            ]
          }
        },
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "target_device_authorize_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "description": "Reducer-derived accepted ak.device.authorize Event targeted by this proposal."
        },
        "target_device_generation_ref": {
          "$ref": "#/$defs/device_generation_ref"
        },
        "proposal_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "description": "The complete accepted revoke Event identifier and the sole wire source of that Event digest. Consumers recover the digest from this identifier when validating a terminal decision; this record MUST NOT duplicate it as a sibling field."
        },
        "accepted_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Actual durable atomic-commit time assigned when the Event, derived selectors and pending index commit. It is assigned by the authority transaction and MUST NOT be producer supplied."
        },
        "acceptance_sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonic sequence assigned by the origin Station in the same atomic commit as accepted_at and the pending index."
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        }
      },
      "oneOf": [
        {
          "required": [
            "account_id"
          ],
          "not": {
            "required": [
              "actor_id"
            ]
          }
        },
        {
          "required": [
            "actor_id"
          ],
          "not": {
            "required": [
              "account_id"
            ]
          }
        }
      ],
      "x-arkret-name-role": "shared_fields"
    },
    "device_revocation_pending_state": {
      "allOf": [
        {
          "$ref": "#/$defs/device_revocation_fields"
        },
        {
          "type": "object",
          "required": [
            "status",
            "denied_actions"
          ],
          "properties": {
            "status": {
              "const": "revocation_pending",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "device-revocation-state.schema.json#/$defs/device_revocation_pending_state/allOf/1/properties/status",
                "owner": "device-revocation-state.schema.json#/$defs/device_revocation_pending_state/allOf/1/properties/status",
                "values": [
                  "revocation_pending"
                ]
              }
            },
            "denied_actions": {
              "$ref": "#/$defs/denied_actions"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "device_revocation_rejected_state": {
      "allOf": [
        {
          "$ref": "#/$defs/device_revocation_fields"
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "revocation_rejected",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "device-revocation-state.schema.json#/$defs/device_revocation_rejected_state/allOf/1/properties/status",
                "owner": "device-revocation-state.schema.json#/$defs/device_revocation_rejected_state/allOf/1/properties/status",
                "values": [
                  "revocation_rejected"
                ]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "device_revoked_state": {
      "allOf": [
        {
          "$ref": "#/$defs/device_revocation_fields"
        },
        {
          "type": "object",
          "required": [
            "status",
            "committed_at"
          ],
          "properties": {
            "status": {
              "const": "revoked",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "device-revocation-state.schema.json#/$defs/device_revoked_state/allOf/1/properties/status",
                "owner": "device-revocation-state.schema.json#/$defs/device_revoked_state/allOf/1/properties/status",
                "values": [
                  "revoked"
                ]
              }
            },
            "committed_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "account_device_revocation_pending_state": {
      "description": "Account-only device revocation state. Realm-actor state belongs to the generic parent; this projection cannot silently accept it.",
      "allOf": [
        {
          "$ref": "#/$defs/device_revocation_pending_state"
        },
        {
          "required": [
            "account_id"
          ],
          "not": {
            "required": [
              "actor_id"
            ]
          }
        }
      ]
    },
    "account_device_revocation_rejected_state": {
      "description": "Account-only device revocation state. Realm-actor state belongs to the generic parent; this projection cannot silently accept it.",
      "allOf": [
        {
          "$ref": "#/$defs/device_revocation_rejected_state"
        },
        {
          "required": [
            "account_id"
          ],
          "not": {
            "required": [
              "actor_id"
            ]
          }
        }
      ]
    },
    "account_device_revoked_state": {
      "description": "Account-only device revocation state. Realm-actor state belongs to the generic parent; this projection cannot silently accept it.",
      "allOf": [
        {
          "$ref": "#/$defs/device_revoked_state"
        },
        {
          "required": [
            "account_id"
          ],
          "not": {
            "required": [
              "actor_id"
            ]
          }
        }
      ]
    },
    "account_device_revocation_gate_record": {
      "description": "Account-only retained pending/revoked gate facts; rejected records remain audit history.",
      "allOf": [
        {
          "$ref": "#/$defs/device_revocation_gate_record"
        },
        {
          "required": [
            "account_id"
          ],
          "not": {
            "required": [
              "actor_id"
            ]
          }
        }
      ]
    },
    "account_device_revocation_record": {
      "description": "Account-only retained revocation fact; rejects the distinct Realm actor subject branch.",
      "oneOf": [
        {
          "$ref": "#/$defs/account_device_revocation_pending_state"
        },
        {
          "$ref": "#/$defs/account_device_revocation_rejected_state"
        },
        {
          "$ref": "#/$defs/account_device_revoked_state"
        }
      ]
    }
  }
}
