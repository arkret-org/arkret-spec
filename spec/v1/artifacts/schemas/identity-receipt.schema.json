{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/identity-receipt.schema.json",
  "title": "Contrix Identity Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "did",
    "seq",
    "head_event_hash",
    "registry_service_did",
    "created_at",
    "signature"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^cx:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "head_event_hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "registry_service_did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "witness_role": {
      "type": "string",
      "enum": [
        "writer",
        "witness",
        "replica"
      ]
    },
    "audience": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "signature": {
      "$ref": "./event-schema.json#/$defs/proof"
    }
  },
  "additionalProperties": true
}
