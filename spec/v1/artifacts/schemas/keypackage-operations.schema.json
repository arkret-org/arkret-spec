{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/keypackage-operations.schema.json",
  "title": "Cokret MLS KeyPackage Operation DTOs",
  "description": "Closed request and response DTOs for ck.keys.keypackages.{upload,claim,consume,revoke}. Individual OpenAPI components reference the $defs entries in this bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/key_packages_upload_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_upload_outcome"
    },
    {
      "$ref": "#/$defs/key_packages_claim_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_claim_outcome"
    },
    {
      "$ref": "#/$defs/key_packages_consume_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_consume_outcome"
    },
    {
      "$ref": "#/$defs/key_packages_revoke_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_revoke_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^ck:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque content-addressed or service-scoped reference. Hash-shaped refs MUST use keypackage_digest for digest bytes."
    },
    "string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "signature": {
      "type": "object",
      "required": [
        "kid",
        "sig"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/non_empty_string"
        },
        "alg": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sig": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "keypackage_ref_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "keypackage_upload_entry": {
      "type": "object",
      "required": [
        "keypackage_id",
        "keypackage_ref",
        "keypackage_digest",
        "key_package",
        "cipher_suites",
        "capabilities",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "keypackage_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "keypackage_digest": {
          "$ref": "#/$defs/hash"
        },
        "key_package": {
          "$ref": "#/$defs/base64url",
          "description": "Base64url encoding of the canonical MLS KeyPackage bytes."
        },
        "cipher_suites": {
          "$ref": "#/$defs/string_list"
        },
        "capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "device_signature": {
          "$ref": "#/$defs/signature"
        },
        "last_resort": {
          "type": "boolean",
          "description": "When true, this entry is a reusable last-resort KeyPackage (RFC 9420 Section 10). It is not consumed single-use; it cycles between published and claimed until rotated, expired, or revoked. Optional capability gated by ck.feature.mls_last_resort_keypackage.v1. See encryption-and-audit.md section 2.6.2."
        }
      },
      "additionalProperties": false
    },
    "keypackage_claim_record": {
      "type": "object",
      "required": [
        "claim_id",
        "keypackage_ref",
        "keypackage_digest",
        "principal_id",
        "device_id",
        "key_package",
        "capabilities",
        "capabilities_digest",
        "ssk_generation",
        "expires_at",
        "device_signature"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "keypackage_digest": {
          "$ref": "#/$defs/hash"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "key_package": {
          "$ref": "#/$defs/base64url"
        },
        "capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "capabilities_digest": {
          "$ref": "#/$defs/hash"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "device_signature": {
          "$ref": "#/$defs/signature"
        },
        "revocation_status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "revoked",
            "principal_deactivated",
            "device_revoked"
          ]
        },
        "last_resort": {
          "type": "boolean",
          "description": "When true, this claim record returns a reusable last-resort KeyPackage (RFC 9420 Section 10) because the single-use pool was empty. The package may be reused within the same intended_realm_id and is not transitioned to consumed; the holder MUST rotate it and trigger group updates on next online. Optional capability gated by ck.feature.mls_last_resort_keypackage.v1. See encryption-and-audit.md section 2.6.2."
        }
      },
      "additionalProperties": false
    },
    "key_packages_upload_request_body": {
      "type": "object",
      "required": [
        "principal_id",
        "device_id",
        "key_packages",
        "device_signature"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "key_packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_upload_entry"
          },
          "minItems": 1
        },
        "device_signature": {
          "$ref": "#/$defs/signature"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "key_packages_upload_outcome": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "available_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "key_packages_claim_request_body": {
      "type": "object",
      "required": [
        "target_principal_id",
        "intended_realm_id",
        "requester",
        "required_capabilities",
        "claim_nonce",
        "expires_at"
      ],
      "properties": {
        "target_principal_id": {
          "$ref": "#/$defs/did"
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "required_capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "claim_nonce": {
          "$ref": "#/$defs/base64url"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_device_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimal_metadata_allowed": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "key_packages_claim_outcome": {
      "type": "object",
      "required": [
        "claims"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_claim_record"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "available_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "key_packages_consume_request_body": {
      "type": "object",
      "required": [
        "key_package_refs",
        "consumer_device_id",
        "signature"
      ],
      "properties": {
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "consumer_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "welcome_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "key_packages_consume_outcome": {
      "type": "object",
      "required": [
        "consumed"
      ],
      "properties": {
        "consumed": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    },
    "key_packages_revoke_request_body": {
      "type": "object",
      "required": [
        "key_package_refs",
        "device_id",
        "signature"
      ],
      "properties": {
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "key_packages_revoke_outcome": {
      "type": "object",
      "required": [
        "revoked"
      ],
      "properties": {
        "revoked": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
