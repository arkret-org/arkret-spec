{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/keypackage-operations.schema.json",
  "title": "Arkret MLS KeyPackage Operation DTOs",
  "description": "Closed request and response DTOs for self and peer MLS KeyPackage upload, claim, claim-status query, consume, and revoke operations. Individual OpenAPI components reference the $defs entries in this bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/keypackages_upload_request_body"
    },
    {
      "$ref": "#/$defs/keypackages_upload_outcome"
    },
    {
      "$ref": "#/$defs/keypackages_claim_request_body"
    },
    {
      "$ref": "#/$defs/keypackages_claim_outcome"
    },
    {
      "$ref": "#/$defs/peer_keypackages_claim_query_request_body"
    },
    {
      "$ref": "#/$defs/peer_keypackages_claim_query_outcome"
    },
    {
      "$ref": "#/$defs/keypackages_consume_request_body"
    },
    {
      "$ref": "#/$defs/keypackages_consume_outcome"
    },
    {
      "$ref": "#/$defs/keypackages_revoke_request_body"
    },
    {
      "$ref": "#/$defs/keypackages_revoke_outcome"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "strand_id": {
      "$ref": "./agent-operations.schema.json#/$defs/strand_id"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "base64url": {
      "$ref": "./agent-operations.schema.json#/$defs/base64url"
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque content-addressed or service-scoped reference. Hash-shaped refs MUST use keypackage_digest for digest bytes."
    },
    "keypackage_capability_id": {
      "type": "string",
      "pattern": "^(?:ak|[a-z][a-z0-9-]{0,31})(?:\\.[a-z][a-z0-9_-]{0,63})+\\.v1$",
      "maxLength": 128,
      "description": "Open registered identifier from keypackage-capability-registry.json. Unknown well-formed values are preserved but treated as unsupported."
    },
    "keypackage_capability_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keypackage_capability_id"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "description": "UTF-8 byte-lexicographically sorted unique KeyPackage capability identifiers. Semantic registry membership and ordering are enforced after structural schema validation."
    },
    "signature": {
      "type": "object",
      "required": [
        "kid",
        "sig"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ]
        },
        "sig": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "keypackage_ref_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "keypackage_upload_entry": {
      "type": "object",
      "required": [
        "keypackage_id",
        "keypackage_ref",
        "keypackage",
        "cipher_suites",
        "capabilities",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "keypackage_id": {
          "type": "string",
          "pattern": "^ak:mls:kp:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Arkret MLS-profile KeyPackage identity. This is the registered ak:mls:kp:<uuidv7> special form, not an opaque external identifier."
        },
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "keypackage": {
          "$ref": "#/$defs/base64url",
          "description": "Base64url encoding of the canonical MLS KeyPackage bytes."
        },
        "cipher_suites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519"
            ]
          },
          "description": "Generated from active canonical_id rows in mls-ciphersuite-registry.json."
        },
        "capabilities": {
          "$ref": "#/$defs/keypackage_capability_list"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "last_resort": {
          "type": "boolean",
          "description": "When true, this entry is a reusable last-resort KeyPackage (RFC 9420 Section 10). It remains published across claims and never enters the single-use claimed or consumed states; rotation, expiry, or explicit revocation transitions it to revoked with a registered revocation_reason. This application-layer flag is covered by the required upload batch endpoint_signature. Optional capability gated by ak.feature.mls_last_resort_keypackage.v1. See encryption-and-audit.md section 2.6.2."
        }
      },
      "additionalProperties": false
    },
    "keypackage_claim_record": {
      "type": "object",
      "required": [
        "claim_id",
        "keypackage_ref",
        "principal_id",
        "keypackage",
        "capabilities",
        "expires_at"
      ],
      "oneOf": [
        {
          "required": [
            "device_id",
            "device_authorize_event_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "agent_key_authorize_event_id"
                ]
              },
              {
                "required": [
                  "agent_id"
                ]
              },
              {
                "required": [
                  "agent_verification_method"
                ]
              },
              {
                "required": [
                  "pairwise_verification_method"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "agent_id",
            "agent_verification_method",
            "agent_key_authorize_event_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "device_authorize_event_id"
                ]
              },
              {
                "required": [
                  "device_id"
                ]
              },
              {
                "required": [
                  "pairwise_verification_method"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "pairwise_verification_method"
          ],
          "not": {
            "anyOf": [
              { "required": ["device_id"] },
              { "required": ["device_authorize_event_id"] },
              { "required": ["agent_id"] },
              { "required": ["agent_verification_method"] },
              { "required": ["agent_key_authorize_event_id"] }
            ]
          }
        }
      ],
      "properties": {
        "claim_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "agent_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Native-Agent KeyPackage branch only. MUST equal principal_id and the current AgentSignerEvidence agent identity. It is never encoded as an ak:device identifier."
        },
        "agent_verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "Native-Agent runtime method that signed the exact KeyPackage; MUST match agent_key_authorize_event_id and the KeyPackage signature byte for byte."
        },
        "pairwise_verification_method": {
          "type": "string",
          "pattern": "^did:key:([^#]+)#\\1$"
        },
        "keypackage": {
          "$ref": "#/$defs/base64url"
        },
        "capabilities": {
          "$ref": "#/$defs/keypackage_capability_list"
        },
        "device_authorize_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "agent_key_authorize_event_id": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Accepted active ak.agent.key.authorize Event that binds a Native Agent runtime verification method to this KeyPackage. Mutually exclusive with device_authorize_event_id."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revocation_status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "revoked",
            "principal_deactivated",
            "device_revoked"
          ]
        },
        "last_resort": {
          "type": "boolean",
          "description": "When true, this claim record returns a reusable last-resort KeyPackage (RFC 9420 Section 10) because the single-use pool was empty. The package may be reused within the same intended_realm_id and is not transitioned to consumed; the holder MUST rotate it and trigger group updates on next online. Optional capability gated by ak.feature.mls_last_resort_keypackage.v1. See encryption-and-audit.md section 2.6.2."
        }
      },
      "additionalProperties": false,
      "description": "Closed KeyPackage claim record. Human-device, Native-Agent, and Realm-local minimal-metadata pairwise branches are an exact XOR. In the pairwise branch principal_id is the Realm-local actor projected from the exact did:key method; no account, Device, PCR, Agent evidence, or mirrored actor field is carried."
    },
    "keypackages_upload_request_body": {
      "type": "object",
      "required": [
        "principal_id",
        "keypackages",
        "endpoint_signature"
      ],
      "oneOf": [
        {
          "required": ["device_id"],
          "not": {
            "anyOf": [
              {"required": ["pairwise_verification_method"]},
              {"required": ["intended_realm_id"]},
              {"required": ["agent_verification_method"]},
              {"required": ["agent_key_authorize_event_id"]}
            ]
          }
        },
        {
          "required": ["pairwise_verification_method", "intended_realm_id"],
          "not": {"anyOf": [
            {"required": ["device_id"]},
            {"required": ["agent_verification_method"]},
            {"required": ["agent_key_authorize_event_id"]}
          ]}
        },
        {
          "required": ["agent_verification_method", "agent_key_authorize_event_id"],
          "not": {"anyOf": [
            {"required": ["device_id"]},
            {"required": ["pairwise_verification_method"]},
            {"required": ["intended_realm_id"]}
          ]}
        }
      ],
      "properties": {
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "pairwise_verification_method": {
          "type": "string",
          "pattern": "^did:key:([^#]+)#\\1$",
          "description": "Minimal-metadata branch only. principal_id MUST equal ak:did_core:key:<same multibase>; no durable Device or account identity is created."
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "agent_verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "agent_key_authorize_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "keypackages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_upload_entry"
          },
          "minItems": 1
        },
        "endpoint_signature": {
          "$ref": "#/$defs/signature",
        "description": "Required authoritative batch signature over the complete typed upload request with only this top-level signature omitted, using the ak.self.keys.keypackages.upload.create.v1 domain. The selected human device, Native Agent runtime, or minimal-metadata pairwise did:key endpoint signs the same transcript."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "mls_group_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "keypackages_upload_outcome": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "keypackage_refs": {
          "$ref": "#/$defs/keypackage_ref_array",
          "description": "Accepted KeyPackage refs in request order; batch upload may accept more than one entry."
        }
      },
      "additionalProperties": false
    },
    "requester_authorization": {
      "description": "Closed human-device, Native-Agent, or Realm-local minimal-metadata pairwise detached authorization by the requesting participant. The pairwise branch signs with the exact did:key method projected by requester and carries no account-local authorization Event.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "verification_method",
            "requester_device_id",
            "device_authorize_event_id",
            "signed_at",
            "signature"
          ],
          "properties": {
            "kind": {
              "const": "device"
            },
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "requester_device_id": {
              "$ref": "#/$defs/device_id"
            },
            "device_authorize_event_id": {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            },
            "signed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "signature": {
              "$ref": "#/$defs/signature"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "verification_method",
            "requester_agent_id",
            "agent_key_authorize_event_id",
            "signed_at",
            "signature"
          ],
          "properties": {
            "kind": {
              "const": "native_agent"
            },
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "requester_agent_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "agent_key_authorize_event_id": {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            },
            "signed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "signature": {
              "$ref": "#/$defs/signature"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "verification_method",
            "signed_at",
            "signature"
          ],
          "properties": {
            "kind": {
              "const": "minimal_metadata_pairwise"
            },
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "signed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "signature": {
              "$ref": "#/$defs/signature"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "peer_keypackages_claim_unsigned_request": {
      "type": "object",
      "required": [
        "claim_request_id",
        "target_principal_id",
        "requester_id",
        "intended_realm_id",
        "mls_group_id",
        "claim_purpose",
        "required_capabilities",
        "expires_at"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "target_principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "claim_purpose": {
          "type": "string",
          "enum": [
            "realm_membership",
            "direct_conversation"
          ]
        },
        "required_capabilities": {
          "$ref": "#/$defs/keypackage_capability_list"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_device_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_keypackage_ref": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Optional exact ordinary KeyPackage selector for a normal same-group Direct Conversation Add/Welcome after accepted member rejoin. When present, the owner authority atomically claims exactly this current, unconsumed package or returns the same opaque claim_failed result as every other target-side failure; it is never a best-effort hint."
        },
        "target_agent_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Native-Agent exact-target branch only. MUST equal target_principal_id and the Agent identity in the returned claim record and current AgentSignerEvidence."
        },
        "target_agent_verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "Native-Agent exact-target branch current runtime verification method."
        },
        "target_agent_key_authorize_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "description": "Native-Agent exact-target branch current accepted ak.agent.key.authorize Event."
        },
        "target_pairwise_verification_method": {
          "type": "string",
          "pattern": "^did:key:([^#]+)#\\1$",
          "description": "Minimal-metadata exact-target branch. target_principal_id MUST be the Realm-local ak:did_core:key actor projected from this method."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "pair_key": {
          "$ref": "#/$defs/digest"
        },
        "last_resort_allowed": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_purpose": {
                "const": "direct_conversation"
              }
            },
            "required": [
              "claim_purpose"
            ]
          },
          "then": {
            "required": [
              "strand_id",
              "pair_key"
            ],
            "properties": {
              "last_resort_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "oneOf": [
              {
                "required": [
                  "target_device_ids"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "target_agent_id"
                      ]
                    },
                    {
                      "required": [
                        "target_agent_verification_method"
                      ]
                    },
                    {
                      "required": [
                        "target_agent_key_authorize_event_id"
                      ]
                    },
                    {
                      "required": [
                        "target_pairwise_verification_method"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "target_agent_id",
                  "target_agent_verification_method",
                  "target_agent_key_authorize_event_id"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["target_device_ids"] },
                    { "required": ["target_pairwise_verification_method"] }
                  ]
                }
              },
              {
                "required": [
                  "target_pairwise_verification_method"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["target_device_ids"] },
                    { "required": ["target_agent_id"] },
                    { "required": ["target_agent_verification_method"] },
                    { "required": ["target_agent_key_authorize_event_id"] }
                  ]
                }
              }
            ]
        },
        {
          "if": {
            "required": ["target_keypackage_ref"]
          },
          "then": {
            "properties": {
              "target_device_ids": {
                "maxItems": 1
              },
              "last_resort_allowed": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "description": "Server-prepared immutable peer claim request fields before requester_authorization is attached. claim_request_id carries at least 128 bits of entropy and equals the Idempotency-Key value on the peer command."
    },
    "keypackages_claim_service_binding": {
      "type": "object",
      "required": [
        "source_id",
        "destination_id"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "destination_id": {
          "$ref": "#/$defs/did_core_id"
        }
      },
      "additionalProperties": false
    },
    "keypackages_claim_request_body": {
      "type": "object",
      "required": [
        "claim_request_id",
        "target_principal_id",
        "requester_id",
        "intended_realm_id",
        "mls_group_id",
        "claim_purpose",
        "required_capabilities",
        "expires_at",
        "service_binding",
        "requester_authorization"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "target_principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "requester_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "claim_purpose": {
          "type": "string",
          "enum": [
            "realm_membership",
            "direct_conversation"
          ]
        },
        "required_capabilities": {
          "$ref": "#/$defs/keypackage_capability_list"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_device_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_keypackage_ref": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Optional exact ordinary KeyPackage selector for a normal same-group Direct Conversation Add/Welcome after accepted member rejoin. When present, the owner authority atomically claims exactly this current, unconsumed package or returns the same opaque claim_failed result as every other target-side failure; it is never a best-effort hint."
        },
        "target_agent_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Native-Agent exact-target branch only. MUST equal target_principal_id and the Agent identity in the returned claim record and current AgentSignerEvidence."
        },
        "target_agent_verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "Native-Agent exact-target branch current runtime verification method."
        },
        "target_agent_key_authorize_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "description": "Native-Agent exact-target branch current accepted ak.agent.key.authorize Event."
        },
        "target_pairwise_verification_method": {
          "type": "string",
          "pattern": "^did:key:([^#]+)#\\1$",
          "description": "Minimal-metadata exact-target branch. target_principal_id MUST be the Realm-local ak:did_core:key actor projected from this method."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "pair_key": {
          "$ref": "#/$defs/digest"
        },
        "last_resort_allowed": {
          "type": "boolean",
          "default": false
        },
        "service_binding": {
          "$ref": "#/$defs/keypackages_claim_service_binding"
        },
        "requester_authorization": {
          "$ref": "#/$defs/requester_authorization"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_purpose": {
                "const": "direct_conversation"
              }
            },
            "required": [
              "claim_purpose"
            ]
          },
          "then": {
            "required": [
              "strand_id",
              "pair_key"
            ],
            "properties": {
              "last_resort_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "oneOf": [
              {
                "required": [
                  "target_device_ids"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "target_agent_id"
                      ]
                    },
                    {
                      "required": [
                        "target_agent_verification_method"
                      ]
                    },
                    {
                      "required": [
                        "target_agent_key_authorize_event_id"
                      ]
                    },
                    {
                      "required": [
                        "target_pairwise_verification_method"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "target_agent_id",
                  "target_agent_verification_method",
                  "target_agent_key_authorize_event_id"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["target_device_ids"] },
                    { "required": ["target_pairwise_verification_method"] }
                  ]
                }
              },
              {
                "required": [
                  "target_pairwise_verification_method"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["target_device_ids"] },
                    { "required": ["target_agent_id"] },
                    { "required": ["target_agent_verification_method"] },
                    { "required": ["target_agent_key_authorize_event_id"] }
                  ]
                }
              }
            ]
        },
        {
          "if": {
            "required": ["target_keypackage_ref"]
          },
          "then": {
            "properties": {
              "target_device_ids": {
                "maxItems": 1
              },
              "last_resort_allowed": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "peer_keypackage_claim_receipt": {
      "type": "object",
      "required": [
        "claim_request_id",
        "request_digest",
        "claims_digest",
        "source_id",
        "destination_id",
        "request",
        "claimed_at",
        "expires_at",
        "signature"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "claims_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "destination_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "request": {
          "$ref": "#/$defs/peer_keypackages_claim_unsigned_request",
          "description": "The exact participant-authorized unsigned request fields. Together with request_digest, this lets the destination bind a later Welcome and Direct Conversation binding to the durable claim without trusting source-service assertions."
        },
        "claimed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "Destination-service-signed durable receipt. source_id and request are covered by the receipt signature; request_digest additionally binds the complete transport command, including participant authorization and portable signer evidence."
    },
    "keypackage_claim_terminal_receipt": {
      "type": "object",
      "required": [
        "domain",
        "claim_request_id",
        "request_digest",
        "terminal_state",
        "source_id",
        "destination_id",
        "terminal_at",
        "signature"
      ],
      "properties": {
        "domain": {
          "const": "ak.keypackage.claim_terminal_receipt.v1"
        },
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "terminal_state": {
          "type": "string",
          "enum": [
            "never_claimed",
            "expired",
            "revoked"
          ]
        },
        "keypackage_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "source_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "destination_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "terminal_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_state": {
                "const": "never_claimed"
              }
            },
            "required": [
              "terminal_state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "keypackage_refs"
              ]
            }
          },
          "else": {
            "required": [
              "keypackage_refs"
            ]
          }
        }
      ],
      "additionalProperties": false,
      "description": "The KeyPackage owner service signs an immutable terminal ledger fact. never_claimed is issued only after the request can no longer succeed; expired/revoked identify every formerly claimed ordinary KeyPackage. This is the portable cleanup authority for a failed Direct Conversation attempt."
    },
    "keypackages_claim_outcome": {
      "type": "object",
      "x-arkret-pcr-outward-event-kinds": [
        "ak.mls.keypackage"
      ],
      "required": [
        "claim_request_id",
        "claims",
        "claim_receipt"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_claim_record"
          },
          "minItems": 1
        },
        "claim_receipt": {
          "$ref": "#/$defs/peer_keypackage_claim_receipt"
        }
      },
      "additionalProperties": false,
      "description": "Privacy-preserving peer success response. It intentionally omits inventory counts and per-device failure information."
    },
    "peer_keypackages_claim_query_request_body": {
      "type": "object",
      "required": [
        "claim_request_id",
        "request_digest"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "peer_keypackages_claim_query_outcome": {
      "type": "object",
      "required": [
        "claim_request_id",
        "state"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "pending",
            "claimed",
            "consumed",
            "claim_failed",
            "expired",
            "revoked"
          ]
        },
        "claim_outcome": {
          "$ref": "#/$defs/keypackages_claim_outcome"
        },
        "consume_receipt": {
          "$ref": "#/$defs/keypackage_consume_receipt"
        },
        "terminal_receipt": {
          "$ref": "#/$defs/keypackage_claim_terminal_receipt"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "error_code": {
          "const": "claim_failed"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "claimed",
                  "consumed",
                  "expired",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "claim_outcome"
            ]
          },
          "else": {
            "not": {
              "required": [
                "claim_outcome"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "consumed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "consume_receipt"
            ]
          },
          "else": {
            "not": {
              "required": [
                "consume_receipt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "claim_failed",
                  "expired",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "terminal_receipt"
            ]
          },
          "else": {
            "not": {
              "required": [
                "terminal_receipt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "claim_failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "error_code"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "retry_after_ms"
            ]
          },
          "else": {
            "not": {
              "required": [
                "retry_after_ms"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "recipient_mls_durable_receipt": {
      "type": "object",
      "required": [
        "domain",
        "claim_request_id",
        "keypackage_ref",
        "recipient_principal_id",
        "recipient_id",
        "realm_id",
        "mls_group_id",
        "mls_epoch",
        "welcome_ref",
        "welcome_digest",
        "durable_at",
        "signature"
      ],
      "oneOf": [
        {
          "required": [
            "recipient_device_id",
            "device_verification_method"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "recipient_agent_id"
                ]
              },
              {
                "required": [
                  "recipient_agent_verification_method"
                ]
              },
              {
                "required": [
                  "agent_key_authorize_event_id"
                ]
              },
              {
                "required": [
                  "recipient_pairwise_verification_method"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "recipient_agent_id",
            "recipient_agent_verification_method",
            "agent_key_authorize_event_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "recipient_device_id"
                ]
              },
              {
                "required": [
                  "device_verification_method"
                ]
              },
              {
                "required": [
                  "recipient_pairwise_verification_method"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "recipient_pairwise_verification_method"
          ],
          "not": {
            "anyOf": [
              { "required": ["recipient_device_id"] },
              { "required": ["device_verification_method"] },
              { "required": ["recipient_agent_id"] },
              { "required": ["recipient_agent_verification_method"] },
              { "required": ["agent_key_authorize_event_id"] }
            ]
          }
        }
      ],
      "properties": {
        "domain": {
          "const": "ak.mls.recipient_durable_receipt.v1"
        },
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "keypackage_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recipient_principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "recipient_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "recipient_agent_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "recipient_agent_verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "agent_key_authorize_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "recipient_pairwise_verification_method": {
          "type": "string",
          "pattern": "^did:key:([^#]+)#\\1$"
        },
        "recipient_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "mls_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "welcome_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "description": "Exact accepted ak.mls.welcome Event referenced by this durable receipt; this is not a Welcome byte carrier."
        },
        "welcome_digest": {
          "$ref": "#/$defs/digest"
        },
        "durable_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "The exact recipient signer signs every field except signature only after durably storing and opening the Welcome. Closed XOR: human device, Native Agent, or Realm-local minimal-metadata pairwise did:key. In the pairwise branch recipient_principal_id is the pairwise actor and no account, Device, or Agent evidence appears."
    },
    "keypackage_consume_receipt": {
      "type": "object",
      "required": [
        "domain",
        "request_digest",
        "claim_id",
        "recipient_durable_receipt",
        "consumed_at",
        "signature"
      ],
      "properties": {
        "domain": {
          "const": "ak.keypackage.consume_receipt.v1"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "claim_id": {
          "allOf": [
            { "$ref": "#/$defs/non_empty_string" },
            { "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor" }
          ]
        },
        "recipient_durable_receipt": {
          "$ref": "#/$defs/recipient_mls_durable_receipt"
        },
        "consumed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "Recipient Principal Server signed durable consume acknowledgement. recipient_durable_receipt is the sole carrier of claim request, KeyPackage, Welcome, Realm, MLS group, epoch, and recipient service coordinates. The service-generated request_digest, claim_id, and consumed_at plus the complete nested durable receipt are covered by signature. For an ordinary KeyPackage it is issued only after the exact single-use claim transitions to consumed. For a reusable last-resort KeyPackage it terminally acknowledges only that exact claim audit while the KeyPackage row remains published. Same exact consume replays this receipt; any claim, coordinate, signer-branch or evidence mismatch conflicts."
    },
    "keypackages_consume_request_body": {
      "type": "object",
      "required": [
        "claim_id",
        "recipient_durable_receipt",
        "signature"
      ],
      "properties": {
        "claim_id": {
          "allOf": [
            { "$ref": "#/$defs/non_empty_string" },
            { "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor" }
          ]
        },
        "recipient_durable_receipt": {
          "$ref": "#/$defs/recipient_mls_durable_receipt",
          "description": "Sole consume authority and coordinate carrier. Its closed device, Native-Agent, or minimal-metadata pairwise signer branch authorizes the command and binds the owner, KeyPackage, Welcome, Realm, MLS group, epoch, and recipient service."
        },
        "signature": {
          "$ref": "#/$defs/signature",
          "description": "Signature over the typed consume request with this field omitted, using the ak.self.keys.keypackages.command.consume.v1 domain."
        }
      },
      "additionalProperties": false
    },
    "keypackages_consume_outcome": {
      "type": "object",
      "required": [
        "consume_receipt"
      ],
      "properties": {
        "consume_receipt": {
          "$ref": "#/$defs/keypackage_consume_receipt"
        }
      },
      "additionalProperties": false
    },
    "keypackages_revoke_request_body": {
      "type": "object",
      "required": [
        "owner_account_id",
        "keypackage_refs",
        "device_id",
        "signature"
      ],
      "properties": {
        "owner_account_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "keypackage_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "signature": {
          "$ref": "#/$defs/signature",
          "description": "Signature over the typed revoke request with this field omitted, using the ak.self.keys.keypackages.command.revoke.v1 domain."
        },
        "reason": {
          "$ref": "string-profiles.schema.json#/$defs/audit_reason_text"
        }
      },
      "additionalProperties": false
    },
    "keypackages_revoke_outcome": {
      "type": "object",
      "required": [
        "revoked"
      ],
      "properties": {
        "revoked": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
