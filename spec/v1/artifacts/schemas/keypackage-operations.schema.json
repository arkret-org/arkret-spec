{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/keypackage-operations.schema.json",
  "title": "Arkret MLS KeyPackage Operation DTOs",
  "description": "Closed request and response DTOs for self and peer MLS KeyPackage upload, claim, claim-status query, consume, and revoke operations. Individual OpenAPI components reference the $defs entries in this bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/key_packages_upload_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_upload_outcome"
    },
    {
      "$ref": "#/$defs/key_packages_claim_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_claim_outcome"
    },
    {
      "$ref": "#/$defs/peer_key_packages_claim_request_body"
    },
    {
      "$ref": "#/$defs/peer_key_packages_claim_outcome"
    },
    {
      "$ref": "#/$defs/peer_key_packages_claim_query_request_body"
    },
    {
      "$ref": "#/$defs/peer_key_packages_claim_query_outcome"
    },
    {
      "$ref": "#/$defs/key_packages_consume_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_consume_outcome"
    },
    {
      "$ref": "#/$defs/key_packages_revoke_request_body"
    },
    {
      "$ref": "#/$defs/key_packages_revoke_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque content-addressed or service-scoped reference. Hash-shaped refs MUST use keypackage_digest for digest bytes."
    },
    "string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "signature": {
      "type": "object",
      "required": [
        "kid",
        "sig"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ]
        },
        "sig": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "keypackage_claim_proof": {
      "description": "Exactly one requester authorization proof is required by a v1 self KeyPackage claim. It reuses the generic non-Event detached-JWS wire leaf while closing audience, purpose, and domain choices for this object family; canonical binding and signer-authority rules are defined in device-lifecycle.md section 9.0.1.",
      "allOf": [
        {
          "$ref": "./event-envelope.schema.json#/$defs/proof"
        },
        {
          "type": "object",
          "required": [
            "audience",
            "proof_purpose"
          ],
          "properties": {
            "audience": {
              "$ref": "#/$defs/did"
            },
            "proof_purpose": {
              "type": "string",
              "const": "holder_acceptance"
            }
          },
          "not": {
            "required": [
              "domain"
            ]
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "keypackage_ref_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "keypackage_upload_entry": {
      "type": "object",
      "required": [
        "keypackage_id",
        "keypackage_ref",
        "keypackage_digest",
        "key_package",
        "cipher_suites",
        "capabilities",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "keypackage_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "keypackage_digest": {
          "$ref": "#/$defs/hash"
        },
        "key_package": {
          "$ref": "#/$defs/base64url",
          "description": "Base64url encoding of the canonical MLS KeyPackage bytes."
        },
        "cipher_suites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519"
            ]
          },
          "description": "Generated from active canonical_id rows in mls-ciphersuite-registry.json."
        },
        "capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "device_signature": {
          "$ref": "#/$defs/signature",
          "description": "Optional defense-in-depth entry signature over the upload entry transcript registered by device-lifecycle.md section 9.0. It never replaces the required request-level batch signature."
        },
        "last_resort": {
          "type": "boolean",
          "description": "When true, this entry is a reusable last-resort KeyPackage (RFC 9420 Section 10). It remains published across claims and never enters the single-use claimed or consumed states; rotation, expiry, or explicit revocation transitions it to revoked with a registered revocation_reason. This application-layer flag is covered by the upload entry's device_signature. Optional capability gated by ak.feature.mls_last_resort_keypackage.v1. See encryption-and-audit.md section 2.6.2."
        }
      },
      "additionalProperties": false
    },
    "keypackage_claim_record": {
      "type": "object",
      "required": [
        "claim_id",
        "keypackage_ref",
        "keypackage_digest",
        "principal_id",
        "device_id",
        "key_package",
        "capabilities",
        "capabilities_digest",
        "expires_at",
        "device_signature"
      ],
      "oneOf": [
        {
          "required": [
            "ssk_generation"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "device_authorize_event_id"
                ]
              },
              {
                "required": [
                  "agent_key_authorize_event_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "device_authorize_event_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ssk_generation"
                ]
              },
              {
                "required": [
                  "agent_key_authorize_event_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "agent_key_authorize_event_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ssk_generation"
                ]
              },
              {
                "required": [
                  "device_authorize_event_id"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "keypackage_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "keypackage_digest": {
          "$ref": "#/$defs/hash"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "key_package": {
          "$ref": "#/$defs/base64url"
        },
        "capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "capabilities_digest": {
          "$ref": "#/$defs/hash"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1
        },
        "device_authorize_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "agent_key_authorize_event_id": {
          "$ref": "#/$defs/non_empty_string",
          "description": "Accepted active ak.agent.key.authorize Event that binds a Native Agent runtime verification method to this KeyPackage. This branch is mutually exclusive with ssk_generation and device_authorize_event_id."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "device_signature": {
          "$ref": "#/$defs/signature"
        },
        "revocation_status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "revoked",
            "principal_deactivated",
            "device_revoked"
          ]
        },
        "last_resort": {
          "type": "boolean",
          "description": "When true, this claim record returns a reusable last-resort KeyPackage (RFC 9420 Section 10) because the single-use pool was empty. The package may be reused within the same intended_realm_id and is not transitioned to consumed; the holder MUST rotate it and trigger group updates on next online. Optional capability gated by ak.feature.mls_last_resort_keypackage.v1. See encryption-and-audit.md section 2.6.2."
        }
      },
      "additionalProperties": false
    },
    "key_packages_upload_request_body": {
      "type": "object",
      "required": [
        "principal_id",
        "device_id",
        "key_packages",
        "device_signature"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "key_packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_upload_entry"
          },
          "minItems": 1
        },
        "device_signature": {
          "$ref": "#/$defs/signature",
          "description": "Required authoritative batch signature over the typed upload request with the top-level signature and all entry signatures omitted, using the ak.self.keys.keypackages.upload.create domain. Ordinary devices and Native Agent runtimes share the same transcript."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "key_packages_upload_outcome": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "available_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "key_packages_claim_request_body": {
      "type": "object",
      "required": [
        "target_principal_id",
        "intended_realm_id",
        "requester",
        "required_capabilities",
        "claim_nonce",
        "expires_at",
        "holder_acceptance_proof"
      ],
      "properties": {
        "target_principal_id": {
          "$ref": "#/$defs/did"
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "required_capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "claim_nonce": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128,
          "description": "Requester-generated object identity carrying at least 128 bits of CSPRNG entropy. Together with requester it keys the atomic self-claim idempotency ledger."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_device_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimal_metadata_allowed": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "holder_acceptance_proof": {
          "$ref": "#/$defs/keypackage_claim_proof",
          "description": "The single requester holder_acceptance proof for this claim. Quorum or hybrid authorization requires a separately defined future request schema and MUST NOT be inferred from this field."
        }
      },
      "additionalProperties": false
    },
    "key_packages_claim_outcome": {
      "type": "object",
      "required": [
        "claims"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_claim_record"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "available_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "requester_authorization": {
      "type": "object",
      "required": [
        "verification_method",
        "signed_at",
        "signature"
      ],
      "oneOf": [
        {
          "required": [
            "ssk_generation"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "requester_device_id"
                ]
              },
              {
                "required": [
                  "device_authorize_event_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "requester_device_id",
            "device_authorize_event_id"
          ],
          "not": {
            "required": [
              "ssk_generation"
            ]
          }
        }
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url",
          "description": "DID URL of the requesting participant's signing key; ownership, freshness, and exact request binding are normative in device-lifecycle.md section 9.2."
        },
        "requester_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1
        },
        "device_authorize_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "Detached authorization by the requesting participant. The signature transcript, verification-method ownership, freshness, and exact request binding are normative in device-lifecycle.md section 9.2."
    },
    "peer_key_packages_claim_unsigned_request": {
      "type": "object",
      "required": [
        "claim_request_id",
        "target_principal_id",
        "requester",
        "intended_realm_id",
        "mls_group_id",
        "claim_purpose",
        "required_capabilities",
        "claim_nonce",
        "expires_at"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "target_principal_id": {
          "$ref": "#/$defs/did"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_purpose": {
          "type": "string",
          "enum": [
            "realm_membership",
            "direct_conversation"
          ]
        },
        "required_capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "claim_nonce": {
          "$ref": "#/$defs/base64url",
          "minLength": 22
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_device_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimal_metadata_allowed": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "pair_key": {
          "$ref": "#/$defs/hash"
        },
        "last_resort_allowed": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_purpose": {
                "const": "direct_conversation"
              }
            },
            "required": [
              "claim_purpose"
            ]
          },
          "then": {
            "required": [
              "strand_id",
              "pair_key"
            ],
            "properties": {
              "last_resort_allowed": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "description": "Server-prepared immutable peer claim request fields before requester_authorization is attached. claim_request_id carries at least 128 bits of entropy and equals the Idempotency-Key value on the peer command."
    },
    "peer_key_packages_claim_transport_binding": {
      "type": "object",
      "required": [
        "source_service_id",
        "destination_service_id",
        "source_trust_domain",
        "destination_trust_domain"
      ],
      "properties": {
        "source_service_id": {
          "$ref": "#/$defs/did"
        },
        "destination_service_id": {
          "$ref": "#/$defs/did"
        },
        "source_trust_domain": {
          "$ref": "./common-ids.schema.json#/$defs/trust_domain"
        },
        "destination_trust_domain": {
          "$ref": "./common-ids.schema.json#/$defs/trust_domain"
        }
      },
      "additionalProperties": false
    },
    "peer_key_packages_claim_authorization_draft": {
      "type": "object",
      "required": [
        "request",
        "transport_binding"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/peer_key_packages_claim_unsigned_request"
        },
        "transport_binding": {
          "$ref": "#/$defs/peer_key_packages_claim_transport_binding"
        }
      },
      "additionalProperties": false,
      "description": "Complete server-reserved object shown to the participant before signing. The signature transcript binds both the immutable request fields and the explicit service/trust-domain transport destination; the client MUST NOT infer transport_binding from local configuration."
    },
    "peer_key_packages_claim_request_body": {
      "type": "object",
      "required": [
        "claim_request_id",
        "target_principal_id",
        "requester",
        "intended_realm_id",
        "mls_group_id",
        "claim_purpose",
        "required_capabilities",
        "claim_nonce",
        "expires_at",
        "requester_authorization"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "target_principal_id": {
          "$ref": "#/$defs/did"
        },
        "requester": {
          "$ref": "#/$defs/did"
        },
        "intended_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim_purpose": {
          "type": "string",
          "enum": [
            "realm_membership",
            "direct_conversation"
          ]
        },
        "required_capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "claim_nonce": {
          "$ref": "#/$defs/base64url",
          "minLength": 22
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_device_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimal_metadata_allowed": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "pair_key": {
          "$ref": "#/$defs/hash"
        },
        "last_resort_allowed": {
          "type": "boolean",
          "default": false
        },
        "requester_authorization": {
          "$ref": "#/$defs/requester_authorization"
        },
        "requester_signing_key_evidence": {
          "$ref": "./federated-device-signing-key-evidence.schema.json",
          "description": "Transport-only portable authorization evidence appended by the authenticated source Principal Server for the requester_device_id model. It is excluded from the participant authorization transcript. The peer command receiver requires it unless the same accepted device authorization is already present in a locally verified requester projection."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_purpose": {
                "const": "direct_conversation"
              }
            },
            "required": [
              "claim_purpose"
            ]
          },
          "then": {
            "required": [
              "strand_id",
              "pair_key"
            ],
            "properties": {
              "last_resort_allowed": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "peer_keypackage_claim_receipt": {
      "type": "object",
      "required": [
        "claim_request_id",
        "request_digest",
        "claims_digest",
        "source_service_id",
        "destination_service_id",
        "request",
        "claimed_at",
        "expires_at",
        "signature"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        },
        "claims_digest": {
          "$ref": "#/$defs/hash"
        },
        "source_service_id": {
          "$ref": "#/$defs/did"
        },
        "destination_service_id": {
          "$ref": "#/$defs/did"
        },
        "request": {
          "$ref": "#/$defs/peer_key_packages_claim_unsigned_request",
          "description": "The exact participant-authorized unsigned request fields. Together with request_digest, this lets the destination bind a later Welcome and Direct Conversation binding to the durable claim without trusting source-service assertions."
        },
        "claimed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "Destination-service-signed durable receipt. source_service_id and request are covered by the receipt signature; request_digest additionally binds the complete transport command, including participant authorization and portable signer evidence."
    },
    "keypackage_claim_terminal_receipt": {
      "type": "object",
      "required": [
        "domain",
        "claim_request_id",
        "request_digest",
        "terminal_state",
        "source_service_id",
        "destination_service_id",
        "terminal_at",
        "signature"
      ],
      "properties": {
        "domain": {
          "const": "ak.keypackage.claim-terminal-receipt.v1"
        },
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        },
        "terminal_state": {
          "type": "string",
          "enum": [
            "never_claimed",
            "expired",
            "revoked"
          ]
        },
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "source_service_id": {
          "$ref": "#/$defs/did"
        },
        "destination_service_id": {
          "$ref": "#/$defs/did"
        },
        "terminal_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_state": {
                "const": "never_claimed"
              }
            },
            "required": [
              "terminal_state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "key_package_refs"
              ]
            }
          },
          "else": {
            "required": [
              "key_package_refs"
            ]
          }
        }
      ],
      "additionalProperties": false,
      "description": "The KeyPackage owner service signs an immutable terminal ledger fact. never_claimed is issued only after the request can no longer succeed; expired/revoked identify every formerly claimed ordinary KeyPackage. This is the portable cleanup authority for a failed Direct Conversation attempt."
    },
    "peer_key_packages_claim_outcome": {
      "type": "object",
      "required": [
        "claim_request_id",
        "claims",
        "claim_receipt"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keypackage_claim_record"
          },
          "minItems": 1
        },
        "claim_receipt": {
          "$ref": "#/$defs/peer_keypackage_claim_receipt"
        }
      },
      "additionalProperties": false,
      "description": "Privacy-preserving peer success response. It intentionally omits inventory counts and per-device failure information."
    },
    "peer_key_packages_claim_query_request_body": {
      "type": "object",
      "required": [
        "claim_request_id",
        "request_digest"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "peer_key_packages_claim_query_outcome": {
      "type": "object",
      "required": [
        "claim_request_id",
        "state"
      ],
      "properties": {
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "pending",
            "claimed",
            "consumed",
            "claim_failed",
            "expired",
            "revoked"
          ]
        },
        "claim_outcome": {
          "$ref": "#/$defs/peer_key_packages_claim_outcome"
        },
        "consume_receipt": {
          "$ref": "#/$defs/keypackage_consume_receipt"
        },
        "terminal_receipt": {
          "$ref": "#/$defs/keypackage_claim_terminal_receipt"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "error_code": {
          "const": "claim_failed"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "claimed",
                  "consumed",
                  "expired",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "claim_outcome"
            ]
          },
          "else": {
            "not": {
              "required": [
                "claim_outcome"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "consumed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "consume_receipt"
            ]
          },
          "else": {
            "not": {
              "required": [
                "consume_receipt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "claim_failed",
                  "expired",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "terminal_receipt"
            ]
          },
          "else": {
            "not": {
              "required": [
                "terminal_receipt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "claim_failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "error_code"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "retry_after_ms"
            ]
          },
          "else": {
            "not": {
              "required": [
                "retry_after_ms"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "recipient_mls_durable_receipt": {
      "type": "object",
      "required": [
        "domain",
        "claim_request_id",
        "key_package_ref",
        "recipient_principal_id",
        "recipient_device_id",
        "recipient_service_id",
        "realm_id",
        "mls_group_id",
        "mls_epoch",
        "welcome_ref",
        "welcome_digest",
        "durable_at",
        "device_verification_method",
        "signature"
      ],
      "properties": {
        "domain": {
          "const": "ak.mls.recipient-durable-receipt.v1"
        },
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "key_package_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "recipient_principal_id": {
          "$ref": "#/$defs/did"
        },
        "recipient_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "recipient_service_id": {
          "$ref": "#/$defs/did"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mls_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "welcome_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "welcome_digest": {
          "$ref": "#/$defs/hash"
        },
        "durable_at": {
          "$ref": "#/$defs/timestamp"
        },
        "device_verification_method": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "The exact recipient device signs every field except signature only after durably storing and opening the Welcome and matching it to the claimed KeyPackage, Realm, group and epoch. recipient_principal_id must control recipient_device_id/device_verification_method and the claim must target the same participant and device."
    },
    "keypackage_consume_receipt": {
      "type": "object",
      "required": [
        "domain",
        "claim_request_id",
        "claim_ids",
        "key_package_refs",
        "recipient_durable_receipt",
        "welcome_ref",
        "realm_id",
        "mls_group_id",
        "mls_epoch",
        "source_service_id",
        "consumed_at",
        "signature"
      ],
      "properties": {
        "domain": {
          "const": "ak.keypackage.consume-receipt.v1"
        },
        "claim_request_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "recipient_durable_receipt": {
          "$ref": "#/$defs/recipient_mls_durable_receipt"
        },
        "welcome_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "mls_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "source_service_id": {
          "$ref": "#/$defs/did"
        },
        "consumed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "Owner Principal Server signed single-use CAS receipt. It embeds the exact device-signed recipient_mls_durable_receipt so the authorized original peer claim source can recover and verify the complete durable proof through the consumed claim query. It is issued only after atomically transitioning every listed ordinary KeyPackage claim to consumed. Same exact consume replays this receipt; any coordinate mismatch conflicts."
    },
    "key_packages_consume_request_body": {
      "type": "object",
      "required": [
        "owner_account_id",
        "key_package_refs",
        "consumer_device_id",
        "claim_ids",
        "welcome_ref",
        "recipient_durable_receipt",
        "signature"
      ],
      "properties": {
        "owner_account_id": {
          "$ref": "#/$defs/did"
        },
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "consumer_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "signature": {
          "$ref": "#/$defs/signature",
          "description": "Signature over the typed consume request with this field omitted, using the ak.self.keys.keypackages.command.consume domain."
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "welcome_ref": {
          "$ref": "#/$defs/object_ref"
        },
        "recipient_durable_receipt": {
          "$ref": "#/$defs/recipient_mls_durable_receipt",
          "description": "Device-signed proof that the exact Welcome is durable. Consume MUST NOT run before this proof exists."
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "mls_group_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "key_packages_consume_outcome": {
      "type": "object",
      "required": [
        "consumed",
        "consume_receipt"
      ],
      "properties": {
        "consumed": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "consume_receipt": {
          "$ref": "#/$defs/keypackage_consume_receipt"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    },
    "key_packages_revoke_request_body": {
      "type": "object",
      "required": [
        "owner_account_id",
        "key_package_refs",
        "device_id",
        "signature"
      ],
      "properties": {
        "owner_account_id": {
          "$ref": "#/$defs/did"
        },
        "key_package_refs": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "signature": {
          "$ref": "#/$defs/signature",
          "description": "Signature over the typed revoke request with this field omitted, using the ak.self.keys.keypackages.command.revoke domain."
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "key_packages_revoke_outcome": {
      "type": "object",
      "required": [
        "revoked"
      ],
      "properties": {
        "revoked": {
          "$ref": "#/$defs/keypackage_ref_array"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
