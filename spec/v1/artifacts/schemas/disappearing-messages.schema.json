{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.org/v1/schemas/disappearing-messages.schema.json",
  "title": "Cokret Disappearing Message Expiry",
  "oneOf": [
    {
      "$ref": "#/$defs/message_expiry"
    },
    {
      "$ref": "#/$defs/disappearing_policy"
    }
  ],
  "$defs": {
    "message_expiry": {
      "type": "object",
      "required": [
        "ttl_ms",
        "trigger"
      ],
      "properties": {
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "trigger": {
          "type": "string",
          "enum": [
            "on_send",
            "on_first_read",
            "on_last_read"
          ],
          "description": "Expiry anchor trigger. on_first_read / on_last_read are driven by private read cursor or policy-allowed receipt inputs through anonymous aggregate trigger contributions; expiry metadata MUST NOT expose reader identity."
        },
        "grace_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Additional local projection / key-drop grace. Does not extend the Realm policy maximum lifetime."
        }
      },
      "additionalProperties": false
    },
    "disappearing_policy": {
      "type": "object",
      "required": [
        "enabled",
        "max_ttl_ms",
        "allowed_triggers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "on_send",
              "on_first_read",
              "on_last_read"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "read_trigger_window_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum wait window for on_last_read aggregate contributions. If omitted, implementations MUST use max_ttl_ms. This window is metadata-only and MUST NOT expose reader identity or unread reader count."
        },
        "default_grace_ms": {
          "type": "integer",
          "minimum": 0
        },
        "allow_plaintext_realms": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
