{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/account-subscribe-frame.schema.json",
  "title": "Arkret Account Subscribe Frame",
  "description": "Single NDJSON frame on the ak.self.account.stream.subscribe.v1 streaming channel (GET /_arkret/self/account/subscribe, Content-Type: application/x-ndjson). Each newline-delimited line is one frame object. Discriminated by the `kind` field: `delta` carries account-aggregate data (per-Realm stream heads, to_device, account_data, device_lists, notifications, unread counts); the other kinds are control frames that mirror ak.self.events.stream.subscribe.v1 (`catchup_complete`, `checkpoint`, `heartbeat`, `dropped`, `resync_required`, `unauthorized`). Encrypted broadcast signals use the optional Signal Extension rail and never appear in this durable/account aggregate stream. `dropped` and `resync_required` MAY carry `reconnect_after_ms` as a server-directed minimum delay before opening another account subscribe stream for the same principal/device/filter scope.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "delta",
        "catchup_complete",
        "checkpoint",
        "heartbeat",
        "dropped",
        "resync_required",
        "unauthorized"
      ]
    },
    "cursor": {
      "$ref": "#/$defs/cursor_value",
      "description": "Stream cursor (purpose='stream'). On `delta` / `catchup_complete` / `checkpoint` frames it points to the position covered by this frame; pass back as `after=` on the next subscribe call to resume. REQUIRED on `dropped` frames as the account-aggregate catch-up start for `GET /account/subscribe?after=<cursor>&catchup=true`. MUST be present on `delta` / `catchup_complete` / `checkpoint` / `dropped`; absent on `heartbeat` / `resync_required` / `unauthorized`."
    },
    "realms": {
      "type": "object",
      "description": "Per-Realm map on `delta` frames. Keys are `ak:realm:*`; values are that Realm's aggregate timeline/state/account-data entry. Membership state (`join` / `knock` / `leave` / `ban`) is carried by the events inside the Realm entry; pending Invite lifecycle remains a caller-private inbox projection and is not membership.",
      "patternProperties": {
        "^ak:realm:[A-Za-z0-9_-]{44}$": {
          "$ref": "#/$defs/realm_sync_entry"
        }
      },
      "additionalProperties": false,
      "maxProperties": 16
    },
    "to_device": {
      "$ref": "#/$defs/device_message_container",
      "description": "To-device message batch on `delta` frames."
    },
    "device_lists": {
      "$ref": "#/$defs/device_list_changes",
      "description": "Principal DID sets whose authoritative device list changed or left the caller's visibility scope on `delta` frames."
    },
    "account_data": {
      "$ref": "#/$defs/account_data_container",
      "description": "Account-scoped private data on `delta` frames, split by authority: holder-authored durable Events remain in events[], while registry-declared station_cas registers use the closed station_cas branch."
    },
    "notifications": {
      "$ref": "#/$defs/notification_container",
      "description": "Account-private notification projection deltas on `delta` frames. They are not Realm Events: the channel is authorized by the authenticated account context and is never filtered by the detail Realm window. Ordinary source-Event rows are additionally re-evaluated against the recipient's current read authorization on every frame, frozen baseline pages included."
    },
    "partial": {
      "type": "boolean",
      "description": "This frame contains a limited timeline window. Missing older history is loaded on user demand; partial does not describe account baseline completion."
    },
    "priority": {
      "type": "string",
      "description": "Optional server-side priority hint for the frame (UX scheduling)."
    },
    "reconnect_after_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional server-directed minimum delay, in milliseconds, before opening another `ak.self.account.stream.subscribe.v1` stream for the same principal/device/filter scope. MAY appear only on `dropped` and `resync_required` frames. This is a stream reconnect hint, not a generic error retry field; it does not apply to unrelated API calls. Clients MUST wait at least this delay before reconnecting, and servers MUST reject earlier reconnect attempts with `429 rate_limited` plus `Retry-After`."
    },
    "realm_list": {
      "$ref": "#/$defs/realm_list_page"
    },
    "realm_list_changes": {
      "$ref": "#/$defs/realm_list_changes"
    },
    "baseline": {
      "$ref": "#/$defs/account_baseline_segment"
    },
    "realm_invalidations": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/realm_invalidation"
      }
    }
  },
  "$defs": {
    "cursor_value": {
      "type": "string",
      "pattern": "^ak:cursor:[A-Za-z0-9_-]{1,2028}$",
      "maxLength": 2048
    },
    "event_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json#/$defs/authority_committed_event"
          },
          "maxItems": 100
        }
      },
      "additionalProperties": true
    },
    "account_data_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "description": "Holder-authored ak.account_data.set Events only. Station-CAS rows MUST NOT be synthesized as Events.",
          "items": {
            "$ref": "./event-envelope.schema.json"
          },
          "maxItems": 100
        },
        "station_cas": {
          "$ref": "#/$defs/station_cas_account_data_container"
        }
      },
      "additionalProperties": false
    },
    "station_cas_account_data_container": {
      "type": "object",
      "description": "Bounded holder-readable Station-CAS upserts/removals. Initial completeness is carried only by baseline.channels/completed_channels; never clear absent keys on an intermediate page.",
      "required": [
        "upserts",
        "removals"
      ],
      "properties": {
        "upserts": {
          "type": "array",
          "items": {
            "$ref": "./account-data-operations.schema.json#/$defs/account_data_entry"
          },
          "maxItems": 100
        },
        "removals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/station_cas_account_data_removal"
          },
          "maxItems": 100
        }
      },
      "additionalProperties": false
    },
    "station_cas_account_data_removal": {
      "type": "object",
      "description": "Explicit physical-delete delta. The revision is the per-key tombstone high-water revision; updated_at is diagnostic only and never selects a winner.",
      "required": [
        "account_data_key",
        "revision",
        "updated_at"
      ],
      "properties": {
        "account_data_key": {
          "$ref": "./account-data-operations.schema.json#/$defs/account_data_key"
        },
        "revision": {
          "$ref": "./account-data-operations.schema.json#/$defs/revision"
        },
        "updated_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "notification_container": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notification_delta"
          },
          "maxItems": 100
        }
      },
      "additionalProperties": false
    },
    "notification_delta": {
      "type": "object",
      "description": "One account-private notification projection delta. The `id` form is the only branch discriminator: `ak:notification:<uuidv7>` selects the Agent runtime approval branch, `ak:notification_projection:<44-char token>` selects the ordinary source-Event current-row branch. Both branches share one projector, one channel position and the section 2.3 per-frame budget; there is no second notification list operation. See spec/v1/zh/sync/client-sync.md#31.",
      "required": [
        "id",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^ak:notification:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "Agent runtime approval branch."
            },
            {
              "type": "string",
              "pattern": "^ak:notification_projection:[A-Za-z0-9_-]{44}$",
              "description": "Ordinary source-Event branch. The recipient recomputes it from its own complete AccountId plus data.realm_id, data.source_event_id and data.notification_kind."
            }
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "upsert",
            "remove"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/agent_runtime_approval_notification_data"
            },
            {
              "$ref": "#/$defs/agent_runtime_approval_notification_removal_data"
            },
            {
              "$ref": "./notification.schema.json#/$defs/ordinary_projection_content"
            },
            {
              "$ref": "#/$defs/ordinary_notification_removal_data"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ak:notification:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "action": {
                "const": "upsert"
              }
            },
            "required": [
              "id",
              "action"
            ]
          },
          "then": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/$defs/agent_runtime_approval_notification_data"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ak:notification:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "action": {
                "const": "remove"
              }
            },
            "required": [
              "id",
              "action"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/agent_runtime_approval_notification_removal_data"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ak:notification_projection:[A-Za-z0-9_-]{44}$"
              },
              "action": {
                "const": "upsert"
              }
            },
            "required": [
              "id",
              "action"
            ]
          },
          "then": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "./notification.schema.json#/$defs/ordinary_projection_content"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ak:notification_projection:[A-Za-z0-9_-]{44}$"
              },
              "action": {
                "const": "remove"
              }
            },
            "required": [
              "id",
              "action"
            ]
          },
          "then": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/$defs/ordinary_notification_removal_data"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "agent_runtime_approval_notification_data": {
      "type": "object",
      "required": [
        "approval_request_id",
        "agent_id",
        "requested_at",
        "expires_at"
      ],
      "properties": {
        "approval_request_id": {
          "type": "string",
          "pattern": "^(?!ak:)[A-Za-z0-9._:-]{1,128}$"
        },
        "agent_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "requested_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_notification_removal_data": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "approved",
            "expired",
            "renewed",
            "deactivated",
            "superseded"
          ]
        }
      },
      "additionalProperties": false
    },
    "ordinary_notification_removal_data": {
      "type": "object",
      "description": "Why one ordinary source-Event notification projection left the recipient's current set. It is a server-observable cause only: inbox disposition (read / dismissed / archived) stays in holder-private account data and never removes a current row.",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "source_removed",
            "access_revoked",
            "expired",
            "superseded"
          ]
        }
      },
      "additionalProperties": false
    },
    "device_list_changes": {
      "type": "object",
      "required": [
        "changed_ids",
        "left_ids"
      ],
      "properties": {
        "changed_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "left_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      },
      "additionalProperties": false
    },
    "device_message_container": {
      "type": "object",
      "required": [
        "messages"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "./device-message.schema.json"
          }
        },
        "ack_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Server-issued opaque acknowledgement token, REQUIRED whenever messages[] is non-empty. Bound server-side to (principal_id, device_id, queue high-water position of this batch) and covering this batch plus all previously delivered messages. NOT a cursor: no ak:cursor: wire form, no cursor schema/TTL/purpose. The client passes it verbatim to ak.self.device_messages.command.ack.v1 AFTER durably persisting the batch payloads; queue deletion happens only through that explicit ack, never through stream cursor advancement (client-sync.md §10.1)."
        },
        "lost": {
          "type": "boolean",
          "description": "SHOULD be set true when the server has dropped unacknowledged messages for this device (expiry or capacity) since the device's last acknowledged position. Clients SHOULD trigger key recovery paths (key backup / key re-request) and MUST NOT silently assume the queue was complete."
        },
        "limited": {
          "type": "boolean",
          "description": "True when this account subscribe to_device batch is truncated because the device queue exceeds the stream frame budget. When true, `next_cursor` is REQUIRED and the client MUST continue with ak.self.device_messages.read.list.v1?after=<next_cursor>; the top-level account stream cursor MUST NOT be used as the to-device queue pagination cursor."
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor_value",
          "description": "Read-only to-device queue continuation cursor for ak.self.device_messages.read.list.v1?after=... . It is not an acknowledgement and MUST NOT delete queued messages; queue deletion happens only through `ack_token` passed to ak.self.device_messages.command.ack.v1."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "messages": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": [
              "ack_token"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "limited": {
                "const": true
              }
            },
            "required": [
              "limited"
            ]
          },
          "then": {
            "required": [
              "next_cursor"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "timeline": {
      "type": "object",
      "required": [
        "commits",
        "limited"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "$ref": "./authority-commit-operations.schema.json#/$defs/stream_row"
          },
          "maxItems": 100
        },
        "limited": {
          "type": "boolean",
          "description": "Window-level gap marker: earlier history exists beyond this window. Within one frozen baseline window every segment repeats the same value; it must not change because the current segment could not fit the remaining items."
        },
        "prev_cursor": {
          "$ref": "#/$defs/cursor_value",
          "description": "Stream cursor pointing backward in the timeline for backfilling history before this batch. Within a frozen baseline window it points before the whole window, not before the current segment, and is repeated identically in every segment of that window."
        },
        "preview_only": {
          "type": "boolean",
          "description": "Fallback path of client-sync.md §5.2: when timeline.limited=true and the server does not return realm_sync_entry.state_at_window_start, it MUST set preview_only=true. Clients then render window-start events as preview only. Window-level: repeated identically in every segment of a frozen baseline window; the server must not switch between the two §5.2 paths because one segment ran out of budget."
        }
      },
      "additionalProperties": true
    },
    "realm_timeline_baseline": {
      "type": "object",
      "properties": {
        "snapshot_cursor": {
          "$ref": "#/$defs/cursor_value",
          "description": "Identifies and binds the frozen timeline window generation for this Realm. Repeated identically in every segment of that window. Never used as the account `after` parameter and never parsed or compared as an ordered token."
        },
        "window_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Cumulative item ceiling of the frozen window for this Realm after merging the request targets, not the count emitted in one frame. Constant within a window; byte budgets only decide segmentation and must never lower it."
        },
        "complete": {
          "type": "boolean",
          "description": "The server has delivered every segment of this frozen window. Independent of realm_detail_baseline.complete, account baseline completed_channels and catchup_complete. Completion proves delivery only: not per-event authentication, decryption, display dependencies, full history or any read/write permission."
        }
      },
      "required": [
        "snapshot_cursor",
        "window_limit",
        "complete"
      ],
      "additionalProperties": false
    },
    "realm_sync_entry": {
      "type": "object",
      "properties": {
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "timeline_baseline": {
          "$ref": "#/$defs/realm_timeline_baseline"
        },
        "state_at_window_start": {
          "$ref": "#/$defs/state_at_window_start"
        },
        "current": {
          "$ref": "./account-current-result.schema.json#/$defs/current"
        },
        "account_data": {
          "$ref": "#/$defs/event_container"
        },
        "summary": {
          "$ref": "#/$defs/realm_summary"
        },
        "member_roster": {
          "$ref": "#/$defs/member_roster"
        },
        "unread_notifications": {
          "$ref": "#/$defs/unread_notification_counts"
        },
        "event_states": {
          "type": "array",
          "description": "Per-event protocol-state views (event_id + event_state) for reducer-input events carried by this entry. Ordinary current-value projection concurrency is resolved by the fixed (depth, EventId) order. See zh/sync/service-surface.md §5.3.",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "event_state"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
              },
              "event_state": {
                "type": "string",
                "enum": [
                  "data_local",
                  "data_observed",
                  "control_pending",
                  "control_committed",
                  "failed_precondition",
                  "failed_plane",
                  "rejected_commit",
                  "fork_quarantine"
                ]
              },
              "event_state_reason_code": {
                "type": "string",
                "description": "Optional registered reason code for failure detail beyond the enum."
              }
            },
            "additionalProperties": false
          }
        },
        "baseline": {
          "$ref": "#/$defs/realm_detail_baseline"
        },
        "unavailable": {
          "type": "object",
          "properties": {
            "error_code": {
              "type": "string",
              "enum": [
                "revision_unavailable",
                "limit_exceeded",
                "temporarily_unavailable",
                "not_found"
              ]
            }
          },
          "required": [
            "error_code"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "unavailable"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "timeline"
                  ]
                },
                {
                  "required": [
                    "timeline_baseline"
                  ]
                },
                {
                  "required": [
                    "state_at_window_start"
                  ]
                },
                {
                  "required": [
                    "current"
                  ]
                },
                {
                  "required": [
                    "account_data"
                  ]
                },
                {
                  "required": [
                    "summary"
                  ]
                },
                {
                  "required": [
                    "member_roster"
                  ]
                },
                {
                  "required": [
                    "unread_notifications"
                  ]
                },
                {
                  "required": [
                    "event_states"
                  ]
                },
                {
                  "required": [
                    "baseline"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "timeline_baseline"
            ]
          },
          "then": {
            "required": [
              "timeline"
            ]
          }
        }
      ]
    },
    "state_at_window_start": {
      "type": "object",
      "description": "Derived projection-only state at the timeline window start. NOT part of state hash, checkpoint, or causal graph.",
      "required": [
        "actor_profiles",
        "realm_metadata",
        "e2ee_epoch"
      ],
      "properties": {
        "actor_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "actor_id"
            ],
            "properties": {
              "actor_id": {
                "$ref": "./common-ids.schema.json#/$defs/actor_id"
              },
              "display_name": {
                "$ref": "string-profiles.schema.json#/$defs/display_text_256"
              },
              "avatar_blob_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "additionalProperties": false
          },
          "description": "Window-start profile rows keyed semantically by the complete ActorId. Entries MUST be sorted by unsigned UTF-8 bytes of RFC 8785 JCS(actor_id), and duplicate ActorIds MUST be rejected even if display fields differ. A principal DID alone is not a key: accounts on distinct Stations remain distinct rows with their own display projections."
        },
        "realm_metadata": {
          "type": "object",
          "properties": {
            "title": {
              "$ref": "string-profiles.schema.json#/$defs/display_text_256"
            },
            "summary": {
              "$ref": "string-profiles.schema.json#/$defs/short_text",
              "maxLength": 4096
            },
            "join_rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "collaboration_role": {
              "type": "string",
              "enum": [
                "direct_conversation"
              ],
              "description": "Projection-only strong Realm role, emitted only after the server validates the registered Realm profile and discriminator."
            }
          },
          "additionalProperties": false
        },
        "e2ee_epoch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "epoch",
                "key_ref"
              ],
              "properties": {
                "epoch": {
                  "type": "integer",
                  "minimum": 0
                },
                "key_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "realm_summary": {
      "type": "object",
      "properties": {
        "joined_member_count": {
          "type": "integer",
          "minimum": 0
        },
        "invited_member_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of caller-private pending Invite inbox entries associated with this Realm. This is not derived from ak.member.state, does not imply membership, and MUST NOT create roster rows."
        },
        "hero_ids": {
          "type": "array",
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/actor_id"
          },
          "uniqueItems": true,
          "maxItems": 20
        }
      },
      "additionalProperties": false
    },
    "unread_notification_counts": {
      "type": "object",
      "properties": {
        "notification_count": {
          "type": "integer",
          "minimum": 0
        },
        "highlight_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "member_roster": {
      "type": "object",
      "description": "Lightweight roster page derived from effective ak.member.state, effective ak.member.identity.update references, and currently visible handle-claim evidence. Entries MUST NOT carry display fields or naked handle strings directly; handle strings may appear only inside signed ak.schema.handle_claim.v1 objects.",
      "required": [
        "entries",
        "limited"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member_roster_entry"
          },
          "maxItems": 100
        },
        "limited": {
          "type": "boolean",
          "description": "True when entries[] is truncated and MUST NOT be treated as the complete Realm roster."
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor_value",
          "description": "Optional pagination cursor for continuing member roster retrieval."
        }
      },
      "additionalProperties": false
    },
    "member_roster_entry": {
      "type": "object",
      "required": [
        "actor_id",
        "membership"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "membership": {
          "type": "string",
          "enum": [
            "join",
            "knock"
          ],
          "description": "Effective membership rows visible in the roster. Invite lifecycle records are not membership and MUST NOT appear here."
        },
        "subject_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id",
          "description": "Optional exact account identity disclosed for this member. Omit when subject disclosure is only available inside encrypted MemberIdentity or not authorized for the caller. Required whenever handle claim evidence or digest hints are included."
        },
        "identity_event_ids": {
          "type": "array",
          "description": "Effective ak.member.identity.update event ids for this actor after replacement refs are applied.",
          "items": {
            "type": "string",
            "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
          },
          "uniqueItems": true
        },
        "member_display_state_digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$",
          "description": "Digest over the effective identity event references plus the current visible handle claim digest set for this roster entry."
        },
        "identity_events": {
          "type": "array",
          "description": "Optional inline effective ak.member.identity.update Event envelopes. When present these are the original events, not query-time re-encryption or projection rewrites. MUST be omitted unless subject_account_id is disclosed, because plaintext or decryptable identity events can disclose the same member subject.",
          "items": {
            "$ref": "./event-envelope.schema.json#/$defs/authority_committed_event"
          }
        },
        "handle_claim_digests": {
          "type": "array",
          "description": "Digests of currently visible effective ak.schema.handle_claim.v1 objects for this member in the current Realm context. MUST be omitted unless subject_account_id is disclosed, because stable claim digests are linkable across contexts. Absence is not proof that the member has no handle.",
          "items": {
            "type": "string",
            "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "handle_claims": {
          "type": "array",
          "description": "Optional inline signed handle claim status evidence. MUST be omitted unless subject_account_id is disclosed, and every included status view MUST have claim.subject_account_id byte-for-byte equal to the entry subject_account_id across both components. Services may omit this for privacy, size, or freshness. A client backfills through ak.find.directory.read.list_handles_for_subject.v1 using that exact AccountId; a claim whose principal_id matches but whose station_id differs MUST be discarded.",
          "items": {
            "$ref": "./handle-claim.schema.json"
          }
        },
        "handle_claims_limited": {
          "type": "boolean",
          "description": "True when handle_claims[] is truncated or replaced by digest-only hints. Clients MUST NOT interpret missing claims as no handle."
        }
      },
      "dependentRequired": {
        "identity_events": [
          "subject_account_id"
        ],
        "handle_claim_digests": [
          "subject_account_id"
        ],
        "handle_claims": [
          "subject_account_id"
        ],
        "handle_claims_limited": [
          "subject_account_id"
        ]
      },
      "additionalProperties": false
    },
    "data_or_control_payload_present": {
      "anyOf": [
        {
          "required": [
            "realms"
          ]
        },
        {
          "required": [
            "to_device"
          ]
        },
        {
          "required": [
            "device_lists"
          ]
        },
        {
          "required": [
            "account_data"
          ]
        },
        {
          "required": [
            "notifications"
          ]
        },
        {
          "required": [
            "partial"
          ]
        },
        {
          "required": [
            "priority"
          ]
        },
        {
          "required": [
            "realm_list"
          ]
        },
        {
          "required": [
            "realm_list_changes"
          ]
        },
        {
          "required": [
            "baseline"
          ]
        },
        {
          "required": [
            "realm_invalidations"
          ]
        }
      ]
    },
    "reconnect_after_present": {
      "required": [
        "reconnect_after_ms"
      ]
    },
    "cursor_or_data_payload_present": {
      "anyOf": [
        {
          "required": [
            "cursor"
          ]
        },
        {
          "$ref": "#/$defs/data_or_control_payload_present"
        }
      ]
    },
    "cursor_or_data_or_control_payload_present": {
      "anyOf": [
        {
          "required": [
            "cursor"
          ]
        },
        {
          "$ref": "#/$defs/data_or_control_payload_present"
        },
        {
          "$ref": "#/$defs/reconnect_after_present"
        }
      ]
    },
    "account_filter": {
      "type": "object",
      "properties": {
        "realm_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "./common-ids.schema.json#/$defs/realm_id"
          }
        },
        "strand_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
          }
        },
        "timeline_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "description": "Per-Realm item ceiling after merging the request targets. For a frozen baseline window it is the cumulative ceiling across every segment of that window (surfaced as realm_timeline_baseline.window_limit); for live delta it applies per frame. Byte budgets only decide segmentation and never lower it."
        },
        "lazy_load_members": {
          "type": "boolean",
          "default": true
        },
        "include_redundant_members": {
          "type": "boolean",
          "default": false
        },
        "event_kinds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./websocket-frame.schema.json#/$defs/event_kind"
          }
        },
        "not_event_kinds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./websocket-frame.schema.json#/$defs/event_kind"
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "An absent or empty realm_ids collection selects no Realm detail. Global account and Realm-summary changes remain subscribed. Strands belong to the selected Realms; absent strand_ids selects their current default Strands. Current security results are not filtered by Event kind."
    },
    "realm_list_request": {
      "type": "object",
      "properties": {
        "after": {
          "$ref": "#/$defs/cursor_value"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "account_subscribe_request": {
      "type": "object",
      "properties": {
        "after": {
          "$ref": "#/$defs/cursor_value"
        },
        "catchup": {
          "type": "boolean",
          "default": false
        },
        "filter": {
          "$ref": "#/$defs/account_filter"
        },
        "realm_list": {
          "$ref": "#/$defs/realm_list_request"
        },
        "replace_filter": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "replace_filter": {
                "const": true
              }
            },
            "required": [
              "replace_filter"
            ]
          },
          "then": {
            "required": [
              "after",
              "filter"
            ]
          }
        }
      ]
    },
    "realm_list_row": {
      "type": "object",
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activity_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "membership": {
          "type": "string",
          "enum": [
            "join",
            "knock"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "default_strand_id": {
          "type": "string",
          "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
        }
      },
      "required": [
        "realm_id",
        "revision",
        "activity_position",
        "membership"
      ],
      "additionalProperties": false
    },
    "realm_list_page": {
      "type": "object",
      "properties": {
        "snapshot_cursor": {
          "$ref": "#/$defs/cursor_value"
        },
        "snapshot_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/realm_list_row"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor_value"
        }
      },
      "required": [
        "snapshot_cursor",
        "snapshot_revision",
        "items"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "next_cursor"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "Only next_cursor presence indicates another page. A nonterminal page MUST contain at least one item; no duplicated terminal flag is carried."
    },
    "realm_list_removal": {
      "type": "object",
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "realm_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "realm_list_changes": {
      "type": "object",
      "properties": {
        "upserts": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/realm_list_row"
          }
        },
        "removals": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/realm_list_removal"
          }
        }
      },
      "required": [
        "upserts",
        "removals"
      ],
      "additionalProperties": false
    },
    "account_baseline_segment": {
      "type": "object",
      "properties": {
        "snapshot_cursor": {
          "$ref": "#/$defs/cursor_value"
        },
        "channels": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "account_data_events",
              "station_cas",
              "device_lists",
              "notifications"
            ]
          },
          "minItems": 1
        },
        "completed_channels": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "account_data_events",
              "station_cas",
              "device_lists",
              "notifications"
            ]
          }
        }
      },
      "required": [
        "snapshot_cursor",
        "channels",
        "completed_channels"
      ],
      "additionalProperties": false
    },
    "realm_detail_baseline": {
      "type": "object",
      "properties": {
        "snapshot_cursor": {
          "$ref": "#/$defs/cursor_value"
        },
        "cut_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage": {
          "$ref": "./account-current-result.schema.json#/$defs/coverage"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_cursor",
        "cut_revision",
        "coverage",
        "complete"
      ],
      "additionalProperties": false
    },
    "realm_invalidation": {
      "type": "object",
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "realm_id",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "description": "Account aggregate data frame.",
      "properties": {
        "kind": {
          "const": "delta"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "$ref": "#/$defs/reconnect_after_present"
      }
    },
    {
      "description": "This bounded catchup round completed. Per-channel and Realm baseline completion is declared separately.",
      "properties": {
        "kind": {
          "const": "catchup_complete"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "anyOf": [
          {
            "$ref": "#/$defs/data_or_control_payload_present"
          },
          {
            "$ref": "#/$defs/reconnect_after_present"
          }
        ]
      }
    },
    {
      "description": "Cursor-only checkpoint advancement; no data fields are allowed.",
      "properties": {
        "kind": {
          "const": "checkpoint"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "anyOf": [
          {
            "$ref": "#/$defs/data_or_control_payload_present"
          },
          {
            "$ref": "#/$defs/reconnect_after_present"
          }
        ]
      }
    },
    {
      "description": "Account stream gap signal; cursor is the account catch-up start. No data fields are allowed. `reconnect_after_ms` MAY be present to enforce a server-directed reconnect holdoff.",
      "properties": {
        "kind": {
          "const": "dropped"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "$ref": "#/$defs/data_or_control_payload_present"
      }
    },
    {
      "description": "Keepalive frame; cursor and data fields are forbidden.",
      "properties": {
        "kind": {
          "const": "heartbeat"
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "$ref": "#/$defs/cursor_or_data_or_control_payload_present"
      }
    },
    {
      "description": "Hard reset signal; cursor and data fields are forbidden. `reconnect_after_ms` MAY be present to enforce a server-directed reconnect holdoff.",
      "properties": {
        "kind": {
          "const": "resync_required"
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "$ref": "#/$defs/cursor_or_data_payload_present"
      }
    },
    {
      "description": "Authorization-loss signal; cursor and data fields are forbidden.",
      "properties": {
        "kind": {
          "const": "unauthorized"
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "$ref": "#/$defs/cursor_or_data_or_control_payload_present"
      }
    }
  ],
  "additionalProperties": false
}
