{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/account-subscribe-frame.schema.json",
  "title": "Contrix Account Subscribe Frame",
  "description": "Single NDJSON frame on the cx.account.subscribe streaming channel (GET /api/v1/account/subscribe, Content-Type: application/x-ndjson). Each newline-delimited line is one frame object. Discriminated by the `kind` field: `delta` carries account-aggregate data (cross-Realm frontier, to_device, account_data, device_lists, presence, notifications, unread counts); the other kinds are control frames that mirror cx.events.subscribe (`catchup_complete`, `frontier`, `heartbeat`, `dropped`, `resync_required`, `unauthorized`).",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "delta",
        "catchup_complete",
        "frontier",
        "heartbeat",
        "dropped",
        "resync_required",
        "unauthorized"
      ]
    },
    "cursor": {
      "$ref": "#/$defs/cursor_value",
      "description": "Stream cursor (purpose='stream'). On `delta` / `catchup_complete` / `frontier` frames it points to the position covered by this frame; pass back as `after=` on the next subscribe call to resume. REQUIRED on `dropped` frames as the account-aggregate catch-up start for `GET /account/subscribe?after=<cursor>&catchup=true`. MUST be present on `delta` / `catchup_complete` / `frontier` / `dropped`; absent on `heartbeat` / `resync_required` / `unauthorized`."
    },
    "realms": {
      "type": "object",
      "description": "Per-Realm map on `delta` frames. Keys are `cx:realm:*`; values are that Realm's aggregate timeline/state/account-data entry. Membership lifecycle (`join` / `invite` / `knock` / `leave`) is carried by the events inside the Realm entry, not by legacy outer buckets.",
      "patternProperties": {
        "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "$ref": "#/$defs/realm_sync_entry"
        }
      },
      "additionalProperties": false
    },
    "to_device": {
      "$ref": "#/$defs/device_message_container",
      "description": "To-device message batch on `delta` frames."
    },
    "device_lists": {
      "type": "object",
      "description": "Device list changes on `delta` frames."
    },
    "account_data": {
      "$ref": "#/$defs/event_container",
      "description": "Account-scoped private data updates on `delta` frames."
    },
    "presence": {
      "$ref": "#/$defs/event_container",
      "description": "Presence updates on `delta` frames."
    },
    "notifications": {
      "$ref": "#/$defs/event_container",
      "description": "Notification deliveries on `delta` frames."
    },
    "partial": {
      "type": "boolean",
      "description": "When true on a `delta` frame, the per-Realm timelines are limited (truncated); client SHOULD backfill via cx.events.query for any Realm whose timeline carries `limited=true`."
    },
    "priority": {
      "type": "string",
      "description": "Optional server-side priority hint for the frame (UX scheduling)."
    }
  },
  "$defs": {
    "cursor_value": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cx:cursor:.+$"
        },
        {
          "$ref": "./cursor.schema.json"
        }
      ]
    },
    "event_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "device_message_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./device-message.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "type": "object",
      "required": [
        "events",
        "limited"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        },
        "limited": {
          "type": "boolean"
        },
        "prev_cursor": {
          "$ref": "#/$defs/cursor_value",
          "description": "Stream cursor pointing backward in the timeline for backfilling history before this batch."
        }
      },
      "additionalProperties": true
    },
    "realm_sync_entry": {
      "type": "object",
      "properties": {
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "state": {
          "$ref": "#/$defs/event_container"
        },
        "state_after": {
          "$ref": "#/$defs/event_container"
        },
        "ephemeral": {
          "$ref": "#/$defs/event_container"
        },
        "account_data": {
          "$ref": "#/$defs/event_container"
        },
        "summary": {
          "type": "object"
        },
        "unread_notifications": {
          "type": "object"
        },
        "event_states": {
          "type": "array",
          "description": "Per-event protocol-state views (event_id + event_state) for reducer-input events carried by this entry. The 'bottom' detail object lives separately in 'bottoms' below — keyed by cell, not duplicated per event — so wire body is not doubled. Receivers correlate event_state=failed_bottom with the cell-level bottom diagnostic via the cells listed in bottom.cells[]. See zh/sync/service-surface.md §5.3.",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "event_state"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "event_state": {
                "type": "string",
                "enum": [
                  "pending_anchor",
                  "effective",
                  "failed_precondition",
                  "failed_bottom",
                  "rejected_anchor",
                  "anchorer_paused"
                ]
              },
              "reason": {
                "type": "string",
                "description": "Optional short reason code (e.g., 'recovery_witness_missing'). For failure detail beyond the enum."
              }
            },
            "additionalProperties": false
          }
        },
        "bottoms": {
          "type": "array",
          "description": "Structured Bottom diagnostics for cells whose effective Lattice join resolved to ⊥ under the current Anchor view. Each entry pins (cell, status, bottom). See zh/sync/service-surface.md §5.3.",
          "items": {
            "type": "object",
            "required": [
              "cell",
              "status",
              "bottom"
            ],
            "properties": {
              "cell": {
                "type": "string",
                "pattern": "^cx:cell:[A-Za-z0-9._~=-]+(?::[A-Za-z0-9._~=-]+)*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "bottom",
                  "conflict"
                ]
              },
              "bottom": {
                "$ref": "./bottom.schema.json"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "data_or_control_payload_present": {
      "anyOf": [
        { "required": ["realms"] },
        { "required": ["to_device"] },
        { "required": ["device_lists"] },
        { "required": ["account_data"] },
        { "required": ["presence"] },
        { "required": ["notifications"] },
        { "required": ["partial"] },
        { "required": ["priority"] }
      ]
    },
    "cursor_or_data_or_control_payload_present": {
      "anyOf": [
        { "required": ["cursor"] },
        { "$ref": "#/$defs/data_or_control_payload_present" }
      ]
    }
  },
  "oneOf": [
    {
      "description": "Account aggregate data frame.",
      "properties": {
        "kind": {
          "const": "delta"
        }
      },
      "required": [
        "kind",
        "cursor"
      ]
    },
    {
      "description": "Catch-up replay or initial baseline completed; no data fields are allowed.",
      "properties": {
        "kind": {
          "const": "catchup_complete"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "$ref": "#/$defs/data_or_control_payload_present"
      }
    },
    {
      "description": "Cursor-only frontier advancement; no data fields are allowed.",
      "properties": {
        "kind": {
          "const": "frontier"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "$ref": "#/$defs/data_or_control_payload_present"
      }
    },
    {
      "description": "Account stream gap signal; cursor is the account catch-up start. No data fields are allowed.",
      "properties": {
        "kind": {
          "const": "dropped"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "not": {
        "$ref": "#/$defs/data_or_control_payload_present"
      }
    },
    {
      "description": "Keepalive frame; cursor and data fields are forbidden.",
      "properties": {
        "kind": {
          "const": "heartbeat"
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "$ref": "#/$defs/cursor_or_data_or_control_payload_present"
      }
    },
    {
      "description": "Hard reset signal; cursor and data fields are forbidden.",
      "properties": {
        "kind": {
          "const": "resync_required"
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "$ref": "#/$defs/cursor_or_data_or_control_payload_present"
      }
    },
    {
      "description": "Authorization-loss signal; cursor and data fields are forbidden.",
      "properties": {
        "kind": {
          "const": "unauthorized"
        }
      },
      "required": [
        "kind"
      ],
      "not": {
        "$ref": "#/$defs/cursor_or_data_or_control_payload_present"
      }
    }
  ],
  "additionalProperties": false
}
