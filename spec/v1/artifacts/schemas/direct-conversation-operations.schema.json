{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/direct-conversation-operations.schema.json",
  "title": "Arkret Direct Conversation Operations",
  "description": "Closed carriers for the Direct Conversation resolver and single-sided founding. Creation is never carried here: a Direct Conversation Realm is created only by the founder derived from the pair's root Contact basis through the direct_conversation_genesis admission variant of ak.realm.create.",
  "oneOf": [
    {
      "$ref": "#/$defs/direct_conversation_coordinates"
    },
    {
      "$ref": "#/$defs/direct_conversation_founding_acceptance_receipt"
    },
    {
      "$ref": "#/$defs/direct_conversation_resolve_outcome"
    },
    {
      "$ref": "#/$defs/direct_conversation_resolve_request"
    },
    {
      "$ref": "#/$defs/direct_conversation_send_blocker"
    }
  ],
  "$defs": {
    "direct_conversation_coordinates": {
      "type": "object",
      "description": "Permanent Direct Conversation coordinates. binding_event_ref appears only from found or suspended onward; it is absent while the pair is still provisional.",
      "required": [
        "pair_key",
        "realm_id",
        "main_strand_id"
      ],
      "properties": {
        "pair_key": {
          "$ref": "./principal-operations.schema.json#/$defs/hash"
        },
        "realm_id": {
          "$ref": "./principal-operations.schema.json#/$defs/realm_id"
        },
        "main_strand_id": {
          "$ref": "./principal-operations.schema.json#/$defs/strand_id"
        },
        "binding_event_ref": {
          "$ref": "./principal-operations.schema.json#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "direct_conversation_founding_acceptance_receipt": {
      "type": "object",
      "description": "Source-signed evidence that the founder current Principal Server atomically accepted exactly one Direct Conversation founding unit and closed its local unique slot. It creates no Realm, authorizes no Message and is not a global slot; a second receipt for the same pair and founder but a different unit is direct_conversation_pair_materialization_conflict evidence.",
      "required": [
        "pair_key",
        "founder_id",
        "realm_id",
        "main_strand_id",
        "founding_unit_digest",
        "authorization_core",
        "slot_committed",
        "issuer_service_id",
        "issuer_service_binding_digest",
        "accepted_at",
        "proof"
      ],
      "properties": {
        "pair_key": {
          "$ref": "./principal-operations.schema.json#/$defs/hash"
        },
        "founder_id": {
          "$ref": "./principal-operations.schema.json#/$defs/did"
        },
        "realm_id": {
          "$ref": "./principal-operations.schema.json#/$defs/realm_id"
        },
        "main_strand_id": {
          "$ref": "./principal-operations.schema.json#/$defs/strand_id"
        },
        "founding_unit_digest": {
          "$ref": "./principal-operations.schema.json#/$defs/hash"
        },
        "authorization_core": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "current_contact_basis_id",
                "founder_basis_id",
                "accepted_contact_evidence_digest"
              ],
              "properties": {
                "kind": {
                  "const": "human"
                },
                "current_contact_basis_id": {
                  "$ref": "./principal-operations.schema.json#/$defs/opaque_id"
                },
                "founder_basis_id": {
                  "$ref": "./principal-operations.schema.json#/$defs/opaque_id"
                },
                "accepted_contact_evidence_digest": {
                  "$ref": "./principal-operations.schema.json#/$defs/hash"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "agent_provision_ref",
                "agent_provision_digest",
                "controller_binding_digest"
              ],
              "properties": {
                "kind": {
                  "const": "controller_agent"
                },
                "agent_provision_ref": {
                  "$ref": "./principal-operations.schema.json#/$defs/event_id"
                },
                "agent_provision_digest": {
                  "$ref": "./principal-operations.schema.json#/$defs/hash"
                },
                "controller_binding_digest": {
                  "$ref": "./principal-operations.schema.json#/$defs/hash"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "slot_committed": {
          "const": true
        },
        "issuer_service_id": {
          "$ref": "./principal-operations.schema.json#/$defs/did"
        },
        "issuer_service_binding_digest": {
          "$ref": "./principal-operations.schema.json#/$defs/hash"
        },
        "accepted_at": {
          "$ref": "./principal-operations.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "./principal-operations.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "direct_conversation_resolve_outcome": {
      "type": "object",
      "description": "Closed tagged outcome of ak.self.direct_conversation.query.resolve. Evaluation order is fixed: temporarily_unavailable when the current basis or founder cannot be verified; then creation_blocked, creation_required or awaiting_founder while no Realm exists; then suspended for identity, materialization, terminal or gate conflicts; then provisional while no binding endorsement exists; found last.",
      "required": [
        "state"
      ],
      "oneOf": [
        {
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "creation_required"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "state",
            "blockers"
          ],
          "properties": {
            "state": {
              "const": "creation_blocked"
            },
            "blockers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/direct_conversation_send_blocker"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "awaiting_founder"
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "state",
            "coordinates"
          ],
          "properties": {
            "state": {
              "const": "provisional"
            },
            "coordinates": {
              "$ref": "#/$defs/direct_conversation_coordinates"
            },
            "active_mls_generation_ref": {
              "$ref": "./principal-operations.schema.json#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "state",
            "coordinates",
            "active_mls_generation_ref",
            "send_blockers"
          ],
          "properties": {
            "state": {
              "const": "found"
            },
            "coordinates": {
              "$ref": "#/$defs/direct_conversation_coordinates"
            },
            "active_mls_generation_ref": {
              "$ref": "./principal-operations.schema.json#/$defs/event_id"
            },
            "send_blockers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/direct_conversation_send_blocker"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "state",
            "coordinates",
            "blockers"
          ],
          "properties": {
            "state": {
              "const": "suspended"
            },
            "coordinates": {
              "$ref": "#/$defs/direct_conversation_coordinates"
            },
            "blockers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/direct_conversation_send_blocker"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "temporarily_unavailable"
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "direct_conversation_resolve_request": {
      "type": "object",
      "description": "Closed query body for ak.self.direct_conversation.query.resolve. Creation is never carried here: a Direct Conversation Realm is created only by the derived founder through the direct_conversation_genesis admission variant of ak.realm.create.",
      "required": [
        "peer"
      ],
      "properties": {
        "peer": {
          "$ref": "./contact-operations.schema.json#/$defs/contact_peer"
        }
      },
      "additionalProperties": false
    },
    "direct_conversation_send_blocker": {
      "type": "string",
      "description": "Closed machine-readable blocker set surfaced by the Direct Conversation resolver. Values never disclose peer presence to non-participants.",
      "enum": [
        "session_missing",
        "presence_offline",
        "keypackage_empty",
        "grant_missing",
        "policy_stale",
        "contact_scope_stale",
        "mls_reconcile_required",
        "personal_blocked",
        "agent_runtime_unavailable",
        "peer_not_joined_mls",
        "history_key_unavailable",
        "pair_materialization_conflict",
        "realm_terminal_fault",
        "notary_unavailable",
        "profile_unsupported"
      ]
    }
  }
}
