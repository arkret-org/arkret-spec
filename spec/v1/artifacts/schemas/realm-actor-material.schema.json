{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-actor-material.schema.json",
  "title": "Arkret Exact Realm Actor Material",
  "oneOf": [
    {
      "$ref": "#/$defs/realm_actor_material_request_body"
    },
    {
      "$ref": "#/$defs/realm_actor_material_response_body"
    },
    {
      "$ref": "#/$defs/peer_realm_actor_material_request_body"
    }
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_identity_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_control_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_manager_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_status_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_device_generation_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_device_authorization_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_device_revocation_proposals_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_profile_selector"
        },
        {
          "$ref": "./current-state.schema.json#/$defs/realm_actor_recovery_selector"
        }
      ]
    },
    "realm_actor_material_request_body": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "actor_id",
            "purpose",
            "request_nonce",
            "selectors"
          ],
          "properties": {
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_actor"
            },
            "purpose": {
              "const": "current",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_request_body/oneOf/0/properties/purpose",
                "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_request_body/oneOf/0/properties/purpose",
                "values": [
                  "current"
                ]
              }
            },
            "request_nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,128}$"
            },
            "selectors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/selector"
              },
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor_id",
            "purpose",
            "request_nonce",
            "target"
          ],
          "properties": {
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_actor"
            },
            "purpose": {
              "const": "event",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_request_body/oneOf/1/properties/purpose",
                "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_request_body/oneOf/1/properties/purpose",
                "values": [
                  "event"
                ]
              }
            },
            "request_nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,128}$"
            },
            "target": {
              "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor_id",
            "purpose",
            "request_nonce",
            "target_request_digest"
          ],
          "properties": {
            "actor_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_actor"
            },
            "purpose": {
              "const": "request_status",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_request_body/oneOf/2/properties/purpose",
                "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_request_body/oneOf/2/properties/purpose",
                "values": [
                  "request_status"
                ]
              }
            },
            "request_nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,128}$"
            },
            "target_request_digest": {
              "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
            }
          },
          "additionalProperties": false
        }
      ],
      "x-arkret-max-canonical-bytes": 4194304,
      "x-arkret-name-role": "request_body"
    },
    "current_entry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "current_state",
            "source_ref"
          ],
          "properties": {
            "status": {
              "const": "present",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-actor-material.schema.json#/$defs/current_entry/oneOf/0/properties/status",
                "owner": "realm-actor-material.schema.json#/$defs/current_entry/oneOf/0/properties/status",
                "values": [
                  "present"
                ]
              }
            },
            "current_state": {
              "oneOf": [
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_identity"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_control"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_manager"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_status"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_device_generation"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_device_authorization"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_device_revocation_proposals"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_profile"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/current_realm_actor_recovery"
                }
              ]
            },
            "source_ref": {
              "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref",
              "description": "Original accepted source of this selector at the same private read cut; stream and revision equal current_state."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "selector"
          ],
          "properties": {
            "status": {
              "const": "never_written",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "realm-actor-material.schema.json#/$defs/current_entry/oneOf/1/properties/status",
                "owner": "realm-actor-material.schema.json#/$defs/current_entry/oneOf/1/properties/status",
                "values": [
                  "never_written"
                ]
              }
            },
            "selector": {
              "oneOf": [
                {
                  "$ref": "./current-state.schema.json#/$defs/realm_actor_device_authorization_selector"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/realm_actor_device_revocation_proposals_selector"
                },
                {
                  "$ref": "./current-state.schema.json#/$defs/realm_actor_profile_selector"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "current_material": {
      "type": "object",
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/current_entry"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "event_material": {
      "type": "object",
      "required": [
        "event",
        "commit",
        "producer_signer_fact"
      ],
      "properties": {
        "event": {
          "$ref": "./event-envelope.schema.json#/$defs/shared_event_envelope"
        },
        "commit": {
          "$ref": "./realm-commit.schema.json"
        },
        "producer_signer_fact": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/historical_producer_signer_fact"
        }
      },
      "additionalProperties": false
    },
    "device_revocation_status_view": {
      "type": "object",
      "required": [
        "status",
        "proposal_ref",
        "device_id",
        "authorization_ref",
        "authorized_generation_ref",
        "state",
        "decided_at"
      ],
      "properties": {
        "status": {
          "const": "device_revoke",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "realm-actor-material.schema.json#/$defs/device_revocation_status_view/properties/status",
            "owner": "realm-actor-material.schema.json#/$defs/device_revocation_status_view/properties/status",
            "values": [
              "device_revoke"
            ]
          }
        },
        "proposal_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "authorization_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
        },
        "authorized_generation_ref": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "realm-actor-material.schema.json#/$defs/device_revocation_status_view/properties/state",
            "owner": "realm-actor-material.schema.json#/$defs/device_revocation_status_view/properties/state",
            "values": [
              "pending",
              "accepted",
              "rejected"
            ]
          }
        },
        "decided_at": {
          "oneOf": [
            {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "realm-actor-material.schema.json#/$defs/device_revocation_status_view/allOf/0/if/properties/state",
                  "owner": "realm-actor-material.schema.json#/$defs/device_revocation_status_view/allOf/0/if/properties/state",
                  "values": [
                    "pending"
                  ]
                }
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "decided_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "decided_at": {
                "$ref": "./time.schema.json#/$defs/timestamp"
              }
            }
          }
        }
      ],
      "x-arkret-name-role": "status_view"
    },
    "request_status_view": {
      "type": "object",
      "required": [
        "target_request_digest",
        "request_status"
      ],
      "properties": {
        "target_request_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "request_status": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_revocation_status_view"
            },
            {
              "$ref": "./authority-commit-operations.schema.json#/$defs/submit_response_body"
            },
            {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "unknown",
                    "denied",
                    "cancelled"
                  ],
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/2/properties/status",
                    "owner": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/2/properties/status",
                    "values": [
                      "pending",
                      "unknown",
                      "denied",
                      "cancelled"
                    ]
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "status",
                "begin_ref",
                "state",
                "terminal_ref"
              ],
              "properties": {
                "status": {
                  "const": "recovery",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/3/properties/status",
                    "owner": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/3/properties/status",
                    "values": [
                      "recovery"
                    ]
                  }
                },
                "begin_ref": {
                  "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
                },
                "state": {
                  "enum": [
                    "pending",
                    "completed",
                    "cancelled",
                    "superseded"
                  ],
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/3/properties/state",
                    "owner": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/3/properties/state",
                    "values": [
                      "pending",
                      "completed",
                      "cancelled",
                      "superseded"
                    ]
                  }
                },
                "terminal_ref": {
                  "oneOf": [
                    {
                      "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "pending",
                        "x-arkret-value-ownership": {
                          "class": "owned_symbol",
                          "authority": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/3/allOf/0/if/properties/state",
                          "owner": "realm-actor-material.schema.json#/$defs/request_status_view/properties/request_status/oneOf/3/allOf/0/if/properties/state",
                          "values": [
                            "pending"
                          ]
                        }
                      }
                    },
                    "required": [
                      "state"
                    ]
                  },
                  "then": {
                    "properties": {
                      "terminal_ref": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "terminal_ref": {
                        "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "status_view"
    },
    "realm_actor_material_response_body": {
      "type": "object",
      "required": [
        "realm_id",
        "actor_id",
        "purpose",
        "request_digest",
        "request_nonce",
        "requester_actor_id",
        "governance_generation",
        "authority_ref",
        "control_stream_head",
        "issued_at",
        "expires_at",
        "material",
        "signature"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        },
        "purpose": {
          "enum": [
            "current",
            "event",
            "request_status"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/properties/purpose",
            "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/properties/purpose",
            "values": [
              "current",
              "event",
              "request_status"
            ]
          }
        },
        "request_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "request_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,128}$"
        },
        "requester_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "authority_ref": {
          "oneOf": [
            {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            },
            {
              "$ref": "./common-ids.schema.json#/$defs/realm_authority_handoff_id"
            }
          ]
        },
        "control_stream_head": {
          "oneOf": [
            {
              "$ref": "./realm-commit.schema.json#/$defs/stream_head"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "material": {
          "oneOf": [
            {
              "$ref": "#/$defs/current_material"
            },
            {
              "$ref": "#/$defs/event_material"
            },
            {
              "$ref": "#/$defs/request_status_view"
            }
          ]
        },
        "signature": {
          "$ref": "./detached-object-signature.schema.json#/$defs/realm_actor_material_signature"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 4194304,
      "x-arkret-signature-domain": "ak.realm_actor_material_signature.v1",
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "current",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/allOf/0/if/properties/purpose",
                  "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/allOf/0/if/properties/purpose",
                  "values": [
                    "current"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "material": {
                "$ref": "#/$defs/current_material"
              },
              "control_stream_head": {
                "$ref": "./realm-commit.schema.json#/$defs/stream_head"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "event",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/allOf/1/if/properties/purpose",
                  "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/allOf/1/if/properties/purpose",
                  "values": [
                    "event"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "material": {
                "$ref": "#/$defs/event_material"
              },
              "control_stream_head": {
                "$ref": "./realm-commit.schema.json#/$defs/stream_head"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "request_status",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/allOf/2/if/properties/purpose",
                  "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_response_body/allOf/2/if/properties/purpose",
                  "values": [
                    "request_status"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "material": {
                "$ref": "#/$defs/request_status_view"
              }
            }
          }
        }
      ],
      "x-arkret-name-role": "response_body"
    },
    "realm_actor_material_signature_input": {
      "type": "object",
      "required": [
        "realm_id",
        "actor_id",
        "purpose",
        "request_digest",
        "request_nonce",
        "requester_actor_id",
        "governance_generation",
        "authority_ref",
        "control_stream_head",
        "issued_at",
        "expires_at",
        "material"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        },
        "purpose": {
          "enum": [
            "current",
            "event",
            "request_status"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "realm-actor-material.schema.json#/$defs/realm_actor_material_signature_input/properties/purpose",
            "owner": "realm-actor-material.schema.json#/$defs/realm_actor_material_signature_input/properties/purpose",
            "values": [
              "current",
              "event",
              "request_status"
            ]
          }
        },
        "request_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "request_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,128}$"
        },
        "requester_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "governance_generation": {
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        },
        "authority_ref": {
          "oneOf": [
            {
              "$ref": "./common-ids.schema.json#/$defs/event_id"
            },
            {
              "$ref": "./common-ids.schema.json#/$defs/realm_authority_handoff_id"
            }
          ]
        },
        "control_stream_head": {
          "oneOf": [
            {
              "$ref": "./realm-commit.schema.json#/$defs/stream_head"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "material": {
          "oneOf": [
            {
              "$ref": "#/$defs/current_material"
