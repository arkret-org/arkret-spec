{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/agent-signer-evidence.schema.json",
  "title": "Arkret Agent Signer Evidence",
  "description": "Closed reusable Agent authority state and independent controller gate. Historical acceptance uses the original same-Station admission or a distinct receiver receipt; it never reconstructs past authority from current state.",
  "oneOf": [
    {
      "$ref": "#/$defs/current_admission_evidence"
    },
    {
      "$ref": "#/$defs/historical_event_evidence"
    }
  ],
  "$defs": {
    "current_admission_evidence": {
      "type": "object",
      "required": [
        "schema",
        "verification_mode",
        "admission_evidence"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.agent_signer_evidence.v1"
        },
        "verification_mode": {
          "const": "current_admission"
        },
        "admission_evidence": {
          "$ref": "#/$defs/admission_evidence"
        },
        "transparency": {
          "$ref": "#/$defs/transparency"
        }
      },
      "additionalProperties": false
    },
    "historical_event_evidence": {
      "type": "object",
      "required": [
        "schema",
        "verification_mode",
        "admission_evidence",
        "event_admission"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.agent_signer_evidence.v1"
        },
        "verification_mode": {
          "const": "historical_event"
        },
        "admission_evidence": {
          "$ref": "#/$defs/admission_evidence"
        },
        "event_admission": {
          "$ref": "#/$defs/event_admission"
        },
        "transparency": {
          "$ref": "#/$defs/transparency"
        }
      },
      "additionalProperties": false
    },
    "admission_evidence": {
      "type": "object",
      "required": [
        "agent_authority_state_evidence",
        "controller_account_gate_attestation",
        "admission_evidence_digest"
      ],
      "properties": {
        "agent_authority_state_evidence": {
          "$ref": "#/$defs/agent_authority_state_evidence"
        },
        "controller_account_gate_attestation": {
          "$ref": "#/$defs/controller_account_gate_attestation"
        },
        "admission_evidence_digest": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 over RFC 8785 JCS of exactly {agent_authority_state_evidence, controller_account_gate_attestation}. It never includes itself, a receipt or an outer attestation."
        }
      },
      "additionalProperties": false
    },
    "agent_authority_state_evidence": {
      "type": "object",
      "required": [
        "state",
        "state_digest",
        "lease"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/agent_authority_state"
        },
        "state_digest": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 over RFC 8785 JCS of state only."
        },
        "lease": {
          "$ref": "#/$defs/agent_authority_state_lease"
        }
      },
      "additionalProperties": false
    },
    "agent_authority_state": {
      "type": "object",
      "required": [
        "authority_id",
        "principal_control_realm_id",
        "pcr_genesis_event",
        "key_authorization_event",
        "frontier_seal_id",
        "frontier_state_root",
        "signing_key_binding",
        "authorization",
        "key_state_witness",
        "agent_lifecycle_witness",
        "seal_lineages",
        "accepted_delegated_notary_signers"
      ],
      "properties": {
        "authority_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "pcr_genesis_event": {
          "$ref": "./event-envelope.schema.json",
          "description": "Original accepted Agent PCR ak.realm.create with producer proof and Station admission. Its event-derived Realm and complete Agent/controller Account actors bind immutable genesis notary and delegation. Required after pause/resume; never inferred from the current lifecycle Event."
        },
        "key_authorization_event": {
          "$ref": "./event-envelope.schema.json",
          "description": "Exact accepted ak.agent.key.authorize named by signing_key_binding.agent_key_authorize_event_id and authorization.authorized_event_id. Its Station-admitted producer method and signing key authenticate controller_proof; no separate controller DID assertion-method evidence is used."
        },
        "frontier_seal_id": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "frontier_state_root": {
          "$ref": "#/$defs/digest"
        },
        "signing_key_binding": {
          "$ref": "./agent-signing-key-binding.schema.json"
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "key_state_witness": {
          "$ref": "#/$defs/key_state_witness"
        },
        "key_transition_witness": {
          "$ref": "#/$defs/key_transition_witness"
        },
        "agent_lifecycle_witness": {
          "$ref": "#/$defs/agent_lifecycle_witness"
        },
        "seal_lineages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "./seal.schema.json"
          },
          "description": "Complete duplicate-free predecessor closure needed to connect the key and Agent-status witness Seals to frontier_seal_id. Every Seal is in principal_control_realm_id."
        },
        "accepted_delegated_notary_signers": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "./realm.schema.json#/$defs/notary_signer_descriptor"
          },
          "description": "Exactly the unique controller delegated notary descriptors used by signatures of Seals in this state, sorted by verification_method bytes. Empty for genesis-root-only signatures. Each complete actor is the genesis delegated controller Account; only keys independently verified and retained at the original Seal admission may be emitted. The existing state lease authenticates this accepted key-source fact together with the exact Seal set; no new signature exists. Never a generic device or DID key source, never reconstructed from current device state."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorization": {
                "properties": {
                  "status": {
                    "enum": [
                      "revoked",
                      "superseded"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "authorization"
            ]
          },
          "then": {
            "required": [
              "key_transition_witness"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "authorization": {
                "properties": {
                  "status": {
                    "enum": [
                      "active",
                      "expired",
                      "conflicted"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "authorization"
            ]
          },
          "then": {
            "not": {
              "required": [
                "key_transition_witness"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "agent_authority_state_lease": {
      "type": "object",
      "required": [
        "authority_kind",
        "authority_id",
        "verification_method",
        "state_digest",
        "issued_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "authority_kind": {
          "const": "agent_authority"
        },
        "authority_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/detached_jws"
        }
      },
      "additionalProperties": false,
      "description": "The sole Agent Authority signature covers domain ak.agent_authority_state_evidence.v1 and every sibling field except proof.jws. issued_at is the actual authoritative state observation, expires_at-issued_at is positive and at most 300 seconds. The effective current deadline is the minimum of lease expiry, independent controller gate expiry, signing-key binding expiry and key authorization expiry. Copying, repackaging or restoring material cannot renew its observation. Historical verification evaluates it at original producer acceptance.",
      "x-arkret-signature-domain": "ak.agent_authority_state_evidence.v1"
    },
    "controller_account_gate_attestation": {
      "type": "object",
      "required": [
        "schema",
        "principal_id",
        "eligibility",
        "status",
        "basis",
        "basis_digest",
        "authority_id",
        "verification_method",
        "issued_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.controller_account_gate_attestation.v1"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "eligibility": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "soft_logged_out",
            "locked",
            "suspended",
            "deactivated",
            "erasure_pending"
          ]
        },
        "basis": {
          "oneOf": [
            {
              "$ref": "#/$defs/account_binding_default_basis"
            },
            {
              "$ref": "#/$defs/account_status_event_basis"
            }
          ]
        },
        "basis_digest": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the Account Authority-private binding/status projection selected by basis. The portable object never carries a service-local account_id or raw account cell."
        },
        "authority_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/detached_jws"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "eligibility": {
                "const": "active"
              }
            }
          },
          "else": {
            "properties": {
              "eligibility": {
                "const": "inactive"
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "description": "Privacy-minimal Account Authority gate. The authority signs domain ak.controller_account_gate.v1 and every field except proof.jws. account_id and raw account cell material are forbidden by the closed schema."
    },
    "account_binding_default_basis": {
      "type": "object",
      "required": [
        "kind",
        "binding_version",
        "binding_frontier_digest"
      ],
      "properties": {
        "kind": {
          "const": "account_binding_default"
        },
        "binding_version": {
          "type": "integer",
          "minimum": 1
        },
        "binding_frontier_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "account_status_event_basis": {
      "type": "object",
      "required": [
        "kind",
        "status_event_id",
        "status_frontier_digest"
      ],
      "properties": {
        "kind": {
          "const": "account_status_event"
        },
        "status_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "status_frontier_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "event_admission_receipt": {
      "type": "object",
      "required": [
        "schema",
        "event_id",
        "realm_id",
        "producer_accepted_at",
        "accepted_at",
        "agent_id",
        "verification_method",
        "producer_signer_resolution_evidence_ref",
        "receiver_id",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.agent_signer_admission_receipt.v1"
        },
        "event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "producer_accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "agent_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "producer_signer_resolution_evidence_ref": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref",
          "description": "Origin-frozen producer signer evidence root copied from the verified station_admission proof; its embedded digest is the sole wire copy (encoding.md 4.0.1)."
        },
        "receiver_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "proof": {
          "$ref": "#/$defs/detached_jws"
        }
      },
      "additionalProperties": false,
      "description": "Receiver-signed immutable record that the exact Event and the origin-frozen producer signer-evidence root were durably accepted. producer_accepted_at is copied from the verified station_admission proof. Event digest already commits to seal_ref or seal_basis, so no ambiguous receipt Seal id is repeated. The proof domain is ak.agent_signer_admission_receipt.v1 and covers every field except proof.jws."
    },
    "authorization": {
      "type": "object",
      "required": [
        "status",
        "authorized_event_id",
        "accepted_seal_id",
        "accepted_at",
        "not_before"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked",
            "superseded",
            "expired",
            "conflicted"
          ]
        },
        "authorized_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "accepted_seal_id": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp",
          "description": "The sealed activation instant: exactly key_state_witness.seal.sealed_at for authorization.accepted_seal_id, which equals key_state_witness.seal_id. This is distinct from key_authorization_event StationAdmissionProof.accepted_at; the Event may have been durably admitted earlier."
        },
        "not_before": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "transition_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "transition_seal_id": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "revoked",
                  "superseded"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "transition_event_id",
              "transition_seal_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "expired"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "expires_at"
            ]
          }
        }
      ],
      "additionalProperties": false,
      "description": "Key authorization only. Parent Agent/account gates never rewrite this interval and no cross-Realm valid-until scalar exists."
    },
    "key_state_witness": {
      "type": "object",
      "required": [
        "component",
        "agent_id",
        "authorization_event_id",
        "seal_id",
        "state_root",
        "seal",
        "cell_ref",
        "cell_value",
        "leaf_digest",
        "leaf_index",
        "leaf_count",
        "inclusion_proof"
      ],
      "properties": {
        "component": {
          "const": "ak.component.agent.key.v1"
        },
        "agent_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "authorization_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "seal_id": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "state_root": {
          "$ref": "#/$defs/digest"
        },
        "seal": {
          "$ref": "./seal.schema.json"
        },
        "cell_ref": {
          "type": "string",
          "pattern": "^ak:cell:ak\\.component\\.agent\\.key\\.v1:(?:[A-Za-z0-9._~=-]|%[0-9A-Fa-f]{2})*(?::(?:[A-Za-z0-9._~=-]|%[0-9A-Fa-f]{2})+)*$"
        },
        "cell_value": {
          "$ref": "#/$defs/key_cell_value"
        },
        "leaf_digest": {
          "$ref": "#/$defs/digest"
        },
        "leaf_index": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "inclusion_proof": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "additionalProperties": false
    },
    "key_transition_witness": {
      "type": "object",
      "required": [
        "component",
        "agent_id",
        "authorization_event_id",
        "transition_event_id",
        "transition_key_id",
        "seal_id",
        "state_root",
        "seal",
        "cell_ref",
        "cell_value",
        "leaf_digest",
        "leaf_index",
        "leaf_count",
        "inclusion_proof"
      ],
      "properties": {
        "component": {
          "const": "ak.component.agent.key.v1"
        },
        "agent_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "authorization_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "transition_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "transition_key_id": {
          "type": "string",
          "pattern": "^(?!ak:)",
          "minLength": 1,
          "maxLength": 512
        },
        "seal_id": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "state_root": {
          "$ref": "#/$defs/digest"
        },
        "seal": {
          "$ref": "./seal.schema.json"
        },
        "cell_ref": {
          "type": "string",
          "pattern": "^ak:cell:ak\\.component\\.agent\\.key\\.v1:(?:[A-Za-z0-9._~=-]|%[0-9A-Fa-f]{2})*(?::(?:[A-Za-z0-9._~=-]|%[0-9A-Fa-f]{2})+)*$"
        },
        "cell_value": {
          "$ref": "#/$defs/key_cell_value"
        },
        "leaf_digest": {
          "$ref": "#/$defs/digest"
        },
        "leaf_index": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "inclusion_proof": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "additionalProperties": false
    },
    "key_cell_value": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "tag_id",
          "value"
        ],
        "properties": {
          "tag_id": {
            "$ref": "./event-payload.schema.json#/$defs/or_set_dot"
          },
          "value": {
            "oneOf": [
              {
                "$ref": "./event-payload.schema.json#/$defs/agent_key_authorize_payload"
              },
              {
                "$ref": "./event-payload.schema.json#/$defs/agent_key_revoke_payload"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "Canonical resolved OR-set entries sorted by tag bytes. Raw or implementation-private JSON is not a valid state value."
    },
    "agent_lifecycle_witness": {
      "type": "object",
      "required": [
        "component",
        "agent_id",
        "provenance",
        "accepted_status_event",
        "seal_id",
        "state_root",
        "seal",
        "cell_ref",
        "cell_value",
        "cell_heads",
        "leaf_digest",
        "leaf_index",
        "leaf_count",
        "inclusion_proof"
      ],
      "properties": {
        "component": {
          "const": "ak.component.agent.status.v1"
        },
        "agent_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/agent_genesis_provenance"
            },
            {
              "$ref": "#/$defs/agent_pause_provenance"
            },
            {
              "$ref": "#/$defs/agent_resume_provenance"
            },
            {
              "$ref": "#/$defs/agent_deactivate_provenance"
            }
          ]
        },
        "accepted_status_event": {
          "$ref": "./event-envelope.schema.json"
        },
        "seal_id": {
          "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
        },
        "state_root": {
          "$ref": "#/$defs/digest"
        },
        "seal": {
          "$ref": "./seal.schema.json"
        },
        "cell_ref": {
          "type": "string",
          "pattern": "^ak:cell:ak\\.component\\.agent\\.status\\.v1:(?:[A-Za-z0-9._~=-]|%[0-9A-Fa-f]{2})*(?::(?:[A-Za-z0-9._~=-]|%[0-9A-Fa-f]{2})+)*$"
        },
        "cell_value": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "deactivated"
          ]
        },
        "cell_heads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "description": "The cell's complete active head set, in the `event-auth-state-resolution.md` section 6.2.1 order. `ak.component.agent.status.v1` is an `fsm` and therefore a causal register (section 9.3.1.5), so its `state_root` leaf hashes `{\"heads\":[...]}` rather than the settled value: a verifier cannot rebuild `leaf_digest` from `cell_value` alone. `cell_value` stays required and MUST equal the state these heads settle to, so the two cannot disagree.",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "$ref": "./common-ids.schema.json#/$defs/event_id"
              },
              "value": {
                "type": "string",
                "enum": [
                  "active",
                  "paused",
                  "deactivated"
                ]
              }
            }
          }
        },
        "leaf_digest": {
          "$ref": "#/$defs/digest"
        },
        "leaf_index": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "inclusion_proof": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "kind": {
                    "const": "delegated_pcr_genesis"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cell_value": {
                "const": "active"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "kind": {
                    "const": "pause_accepted"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cell_value": {
                "const": "paused"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "kind": {
                    "const": "resume_accepted"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cell_value": {
                "const": "active"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "kind": {
                    "const": "deactivate_accepted"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cell_value": {
                "const": "deactivated"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "agent_genesis_provenance": {
      "type": "object",
      "required": [
        "kind",
        "realm_create_event_id"
      ],
      "properties": {
        "kind": {
          "const": "delegated_pcr_genesis"
        },
        "realm_create_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref",
          "description": "Accepted Agent PCR genesis ak.realm.create that materialized the first active status. This evidence object is assembled after both Events are accepted and never enters either digest preimage."
        }
      },
      "additionalProperties": false
    },
    "agent_pause_provenance": {
      "type": "object",
      "required": [
        "kind",
        "pause_event_id"
      ],
      "properties": {
        "kind": {
          "const": "pause_accepted"
        },
        "pause_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        }
      },
      "additionalProperties": false
    },
    "agent_resume_provenance": {
      "type": "object",
      "required": [
        "kind",
        "resume_event_id"
      ],
      "properties": {
        "kind": {
          "const": "resume_accepted"
        },
        "resume_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        }
      },
      "additionalProperties": false
    },
    "agent_deactivate_provenance": {
      "type": "object",
      "required": [
        "kind",
        "deactivate_event_id"
      ],
      "properties": {
        "kind": {
          "const": "deactivate_accepted"
        },
        "deactivate_event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        }
      },
      "additionalProperties": false
    },
    "detached_jws": {
      "type": "object",
      "required": [
        "kind",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "detached_jws"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "transparency": {
      "type": "object",
      "required": [
        "profile",
        "log_id",
        "leaf_count",
        "tree_root",
        "inclusion_proof",
        "consistency_proof",
        "witness_signatures"
      ],
      "properties": {
        "profile": {
          "const": "ak.profile.key_transparency.v1"
        },
        "log_id": {
          "type": "string",
          "pattern": "^(?!ak:)",
          "minLength": 1
        },
        "leaf_count": {
          "type": "integer",
          "minimum": 1
        },
        "tree_root": {
          "$ref": "#/$defs/digest"
        },
        "inclusion_proof": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "consistency_proof": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "witness_signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[0-9a-f]{64}$"
    },
    "event_admission": {
      "oneOf": [
        {
          "$ref": "#/$defs/station_event_admission"
        },
        {
          "$ref": "#/$defs/receiver_event_admission"
        }
      ]
    },
    "station_event_admission": {
      "type": "object",
      "required": [
        "kind",
        "accepted_event"
      ],
      "properties": {
        "kind": {
          "const": "station_admission"
        },
        "accepted_event": {
          "$ref": "./event-envelope.schema.json"
        }
      },
      "additionalProperties": false,
      "description": "Mandatory for the same Station authority role and the original durable acceptance. Verify the unique station_admission proof from accepted_event; a second receiver receipt is forbidden."
    },
    "receiver_event_admission": {
      "type": "object",
      "required": [
        "kind",
        "receipt"
      ],
      "properties": {
        "kind": {
          "const": "receiver_receipt"
        },
        "receipt": {
          "$ref": "#/$defs/event_admission_receipt"
        }
      },
      "additionalProperties": false,
      "description": "Only a different receiver authority or a different durable acceptance uses this branch."
    }
  }
}
