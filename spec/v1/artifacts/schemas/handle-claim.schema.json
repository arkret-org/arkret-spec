{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/handle-claim.schema.json",
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  },
  "title": "Arkret Handle Claim",
  "type": "object",
  "required": [
    "schema",
    "handle",
    "subject",
    "issuer",
    "binding_state",
    "created_at",
    "proofs"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.handle_claim.v1",
      "description": "Canonical schema discriminator. Aligned with schema-registry.json; lets validators / contract-registry consumers disambiguate this claim from other DID-bearing envelopes."
    },
    "handle": {
      "$ref": "string-profiles.schema.json#/$defs/canonical_handle"
    },
    "handle_aliases": {
      "type": "array",
      "items": {
        "$ref": "string-profiles.schema.json#/$defs/acct_uri"
      },
      "uniqueItems": true,
      "description": "Interop aliases such as RFC 7565 acct:. Aliases are never canonical; verifiers MUST normalize to handle before cache lookup, proof comparison, or delivery_binding construction."
    },
    "subject": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$",
      "description": "Holder/principal DID for a user/principal handle. This is the stable DID the handle resolves to; it is not a Realm actor_id, server-local account_id, administrative identifier, service DID, or generic resource id."
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$",
      "description": "DID of the handle authority. Bare hostnames are discovery inputs, never proof issuers."
    },
    "issuer_service_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$",
      "description": "Service DID that signed, served, or vouched for this handle claim when distinct from issuer."
    },
    "binding_state": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "revoked",
        "expired"
      ]
    },
    "claim_kind": {
      "type": "string",
      "description": "Protocol-level kind of holder/principal handle claim. v1 intentionally does not allow the earlier draft service_handle value: service-readable names or resource labels need their own service/resource schema, while organization-assigned user/principal handles use organization_handle.",
      "enum": [
        "handle_binding",
        "organization_handle"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "private"
      ],
      "description": "Default disclosure boundary for this handle claim."
    },
    "audience": {
      "type": "string",
      "description": "Audience binding for the claim. For handle claims used to build a Realm delivery_binding, audience is the target Realm ID, the inviting service DID, or another verifier domain the proofs explicitly bind to. Verifier MUST reject claims whose audience does not match the current invocation context."
    },
    "challenge": {
      "type": "string"
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional claim_scope such as organization_id, realm_id, purpose, or allowed operations."
    },
    "member_delivery_binding": {
      "type": "object",
      "description": "Single source for the Principal Server service DID and delivery parameters this handle claim offers to the membership builder. Top-level delivery shortcuts are forbidden; use member_delivery_binding.recipient_service_id, member_delivery_binding.service_acceptance_ref, and member_delivery_binding.policy_event_ref.",
      "required": [
        "recipient_service_id",
        "binding_source"
      ],
      "properties": {
        "recipient_service_id": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
        },
        "recipient_service_kind": {
          "const": "principal_server"
        },
        "binding_source": {
          "type": "string",
          "enum": [
            "explicit",
            "invite",
            "join_policy",
            "organization_policy",
            "realm_policy"
          ]
        },
        "delivery_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "events",
              "sync",
              "to_device",
              "push",
              "key_packages"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "service_acceptance_ref": {
          "type": "string",
          "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policy_event_ref": {
          "type": "string",
          "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "verified_at": {
      "$ref": "#/$defs/timestamp"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-envelope.schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "unevaluatedProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "recipient_service_id"
        ]
      },
      {
        "required": [
          "service_acceptance_ref"
        ]
      },
      {
        "required": [
          "policy_event_ref"
        ]
      }
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding_state": {
            "const": "verified"
          }
        },
        "required": [
          "binding_state"
        ]
      },
      "then": {
        "required": [
          "handle",
          "expires_at"
        ],
        "properties": {
          "proofs": {
            "contains": {
              "type": "object",
              "properties": {
                "proof_purpose": {
                  "const": "holder_acceptance"
                }
              },
              "required": [
                "proof_purpose"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "member_delivery_binding"
        ]
      },
      "then": {
        "required": [
          "handle",
          "audience",
          "expires_at"
        ]
      }
    }
  ]
}
