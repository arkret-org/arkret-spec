{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/handle-claim.schema.json",
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "nullable_timestamp": {
      "$ref": "./time.schema.json#/$defs/nullable_timestamp"
    },
    "claim_variant": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "handle_binding",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "handle-claim.schema.json#/$defs/claim_variant/oneOf/0/properties/kind",
                "owner": "handle-claim.schema.json#/$defs/claim_variant/oneOf/0/properties/kind",
                "values": [
                  "handle_binding"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "organization_id"
          ],
          "properties": {
            "kind": {
              "const": "organization_handle",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "handle-claim.schema.json#/$defs/claim_variant/oneOf/1/properties/kind",
                "owner": "handle-claim.schema.json#/$defs/claim_variant/oneOf/1/properties/kind",
                "values": [
                  "organization_handle"
                ]
              }
            },
            "organization_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "handle_claim_core": {
      "type": "object",
      "required": [
        "schema",
        "handle",
        "handle_aliases",
        "subject_account_id",
        "issuer_id",
        "claim",
        "visibility",
        "audience",
        "issued_at",
        "expires_at",
        "source_refs",
        "proofs"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.handle_claim_core.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "handle-claim.schema.json#/$defs/handle_claim_core/properties/schema",
            "owner": "handle-claim.schema.json#/$defs/handle_claim_core/properties/schema",
            "values": [
              "ak.schema.handle_claim_core.v1"
            ]
          }
        },
        "handle": {
          "$ref": "string-profiles.schema.json#/$defs/canonical_handle"
        },
        "handle_aliases": {
          "type": "array",
          "items": {
            "$ref": "string-profiles.schema.json#/$defs/acct_uri"
          },
          "uniqueItems": true
        },
        "subject_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "issuer_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "claim": {
          "$ref": "#/$defs/claim_variant"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "restricted",
            "private"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "handle-claim.schema.json#/$defs/handle_claim_core/properties/visibility",
            "owner": "handle-claim.schema.json#/$defs/handle_claim_core/properties/visibility",
            "values": [
              "public",
              "restricted",
              "private"
            ]
          }
        },
        "audience": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
          },
          "uniqueItems": true
        },
        "proofs": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json#/$defs/proof"
                },
                {
                  "required": [
                    "domain",
                    "proof_purpose"
                  ],
                  "properties": {
                    "domain": {
                      "const": "ak.handle_claim_proof.v1",
                      "x-arkret-value-ownership": {
                        "class": "namespaced_symbol",
                        "authority": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/0/allOf/1/properties/domain",
                        "owner": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/0/allOf/1/properties/domain",
                        "values": [
                          "ak.handle_claim_proof.v1"
                        ]
                      }
                    },
                    "proof_purpose": {
                      "const": "issuer_attestation",
                      "x-arkret-value-ownership": {
                        "class": "owned_symbol",
                        "authority": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/0/allOf/1/properties/proof_purpose",
                        "owner": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/0/allOf/1/properties/proof_purpose",
                        "values": [
                          "issuer_attestation"
                        ]
                      }
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json#/$defs/proof"
                },
                {
                  "required": [
                    "domain",
                    "proof_purpose"
                  ],
                  "properties": {
                    "domain": {
                      "const": "ak.handle_claim_proof.v1",
                      "x-arkret-value-ownership": {
                        "class": "namespaced_symbol",
                        "authority": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/1/allOf/1/properties/domain",
                        "owner": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/1/allOf/1/properties/domain",
                        "values": [
                          "ak.handle_claim_proof.v1"
                        ]
                      }
                    },
                    "proof_purpose": {
                      "const": "holder_acceptance",
                      "x-arkret-value-ownership": {
                        "class": "owned_symbol",
                        "authority": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/1/allOf/1/properties/proof_purpose",
                        "owner": "handle-claim.schema.json#/$defs/handle_claim_core/properties/proofs/prefixItems/1/allOf/1/properties/proof_purpose",
                        "values": [
                          "holder_acceptance"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "public",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "handle-claim.schema.json#/$defs/handle_claim_core/allOf/0/if/properties/visibility",
                  "owner": "handle-claim.schema.json#/$defs/handle_claim_core/allOf/0/if/properties/visibility",
                  "values": [
                    "public"
                  ]
                }
              }
            },
            "required": [
              "visibility"
            ]
          },
          "then": {
            "properties": {
              "audience": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "audience": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "revoker": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "role",
            "issuer_id"
          ],
          "properties": {
            "role": {
              "const": "issuer",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "handle-claim.schema.json#/$defs/revoker/oneOf/0/properties/role",
                "owner": "handle-claim.schema.json#/$defs/revoker/oneOf/0/properties/role",
                "values": [
                  "issuer"
                ]
              }
            },
            "issuer_id": {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "role",
            "subject_account_id"
          ],
          "properties": {
            "role": {
              "const": "holder",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "handle-claim.schema.json#/$defs/revoker/oneOf/1/properties/role",
                "owner": "handle-claim.schema.json#/$defs/revoker/oneOf/1/properties/role",
                "values": [
                  "holder"
                ]
              }
            },
            "subject_account_id": {
              "$ref": "./common-ids.schema.json#/$defs/account_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "handle_claim_revocation": {
      "type": "object",
      "required": [
        "schema",
        "claim_digest",
        "revoked_at",
        "revoker",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.handle_claim_revocation.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "handle-claim.schema.json#/$defs/handle_claim_revocation/properties/schema",
            "owner": "handle-claim.schema.json#/$defs/handle_claim_revocation/properties/schema",
            "values": [
              "ak.schema.handle_claim_revocation.v1"
            ]
          }
        },
        "claim_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/digest"
        },
        "revoked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revoker": {
          "$ref": "#/$defs/revoker"
        },
        "proof": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json#/$defs/proof"
            },
            {
              "required": [
                "domain",
                "proof_purpose"
              ],
              "properties": {
                "domain": {
                  "const": "ak.handle_claim_revocation.v1",
                  "x-arkret-value-ownership": {
                    "class": "namespaced_symbol",
                    "authority": "handle-claim.schema.json#/$defs/handle_claim_revocation/properties/proof/allOf/1/properties/domain",
                    "owner": "handle-claim.schema.json#/$defs/handle_claim_revocation/properties/proof/allOf/1/properties/domain",
                    "values": [
                      "ak.handle_claim_revocation.v1"
                    ]
                  }
                },
                "proof_purpose": {
                  "const": "revocation_authorization",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "handle-claim.schema.json#/$defs/handle_claim_revocation/properties/proof/allOf/1/properties/proof_purpose",
                    "owner": "handle-claim.schema.json#/$defs/handle_claim_revocation/properties/proof/allOf/1/properties/proof_purpose",
                    "values": [
                      "revocation_authorization"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "handle_claim_status_view": {
      "type": "object",
      "required": [
        "schema",
        "claim",
        "status",
        "evaluated_at",
        "verifier_id",
        "verified_at",
        "revocation",
        "cache_expires_at",
        "status_proof"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.handle_claim.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/schema",
            "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/schema",
            "values": [
              "ak.schema.handle_claim.v1"
            ]
          }
        },
        "claim": {
          "$ref": "#/$defs/handle_claim_core"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "revoked"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/status",
            "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/status",
            "values": [
              "pending",
              "verified",
              "revoked"
            ]
          }
        },
        "evaluated_at": {
          "$ref": "#/$defs/timestamp",
          "x-arkret-member-role": "instant"
        },
        "verifier_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verified_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "revocation": {
          "oneOf": [
            {
              "$ref": "#/$defs/handle_claim_revocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_expires_at": {
          "$ref": "#/$defs/timestamp",
          "x-arkret-member-role": "instant"
        },
        "status_proof": {
          "allOf": [
            {
              "$ref": "./event-envelope.schema.json#/$defs/proof"
            },
            {
              "required": [
                "domain",
                "proof_purpose"
              ],
              "properties": {
                "domain": {
                  "const": "ak.handle_claim_status.v1",
                  "x-arkret-value-ownership": {
                    "class": "namespaced_symbol",
                    "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/status_proof/allOf/1/properties/domain",
                    "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/status_proof/allOf/1/properties/domain",
                    "values": [
                      "ak.handle_claim_status.v1"
                    ]
                  }
                },
                "proof_purpose": {
                  "const": "status_attestation",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/status_proof/allOf/1/properties/proof_purpose",
                    "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/properties/status_proof/allOf/1/properties/proof_purpose",
                    "values": [
                      "status_attestation"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/allOf/0/if/properties/status",
                  "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/allOf/0/if/properties/status",
                  "values": [
                    "verified"
                  ]
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "verified_at": {
                "$ref": "#/$defs/timestamp"
              },
              "revocation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "revoked",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/allOf/1/if/properties/status",
                  "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/allOf/1/if/properties/status",
                  "values": [
                    "revoked"
                  ]
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "revocation": {
                "$ref": "#/$defs/handle_claim_revocation"
              }
            }
          },
          "else": {
            "properties": {
              "revocation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "handle-claim.schema.json#/$defs/handle_claim_status_view/allOf/2/if/properties/status",
                  "owner": "handle-claim.schema.json#/$defs/handle_claim_status_view/allOf/2/if/properties/status",
                  "values": [
                    "pending"
                  ]
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "verified_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/handle_claim_status_view"
}
