{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/blob-operations.schema.json",
  "title": "Arkret Blob Operation DTOs",
  "description": "Closed request/response DTOs for blob service operations whose wire shape is not the full blob metadata resource.",
  "anyOf": [
    {
      "$ref": "#/$defs/blob_upload_request_body"
    },
    {
      "$ref": "#/$defs/blob_upload_outcome"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "blob_ref": {
      "$ref": "./agent-operations.schema.json#/$defs/blob_ref"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "signature": {
      "type": "object",
      "required": [
        "kid",
        "signature_algorithm",
        "sig"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/did_url",
          "description": "DID URL of the concrete issuer verification method. Bare DID is not accepted because the receipt must pin one already accepted service key binding."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ML-DSA-65"
          ]
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+={0,2}$"
        }
      },
      "additionalProperties": false
    },
    "upload_receipt": {
      "type": "object",
      "required": [
        "blob_ref",
        "size_bytes",
        "received_at",
        "issuer_id",
        "signature"
      ],
      "properties": {
        "blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "blob_upload_request_body": {
      "type": "object",
      "required": [
        "content",
        "size_bytes"
      ],
      "properties": {
        "content": {
          "type": "string",
          "format": "binary",
          "description": "The binary blob content part in multipart/form-data. This field is not JCS-canonicalized as JSON; content_digest covers the bytes."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "blob_upload_outcome": {
      "type": "object",
      "required": [
        "blob_ref",
        "size_bytes"
      ],
      "properties": {
        "blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        },
        "upload_receipt": {
          "$ref": "#/$defs/upload_receipt"
        }
      },
      "additionalProperties": false
    }
  }
}
