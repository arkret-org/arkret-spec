{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/blob-operations.schema.json",
  "title": "Arkret Blob Operation DTOs",
  "description": "Closed request/response DTOs for blob service operations whose wire shape is not the full blob metadata resource.",
  "anyOf": [
    {
      "$ref": "#/$defs/blob_upload_request_body"
    },
    {
      "$ref": "#/$defs/blob_upload_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "signature": {
      "type": "object",
      "required": [
        "kid",
        "alg",
        "sig"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/did_url",
          "description": "DID URL of the concrete issuer verification method. Bare DID is not accepted because the receipt must pin one already accepted service key binding."
        },
        "alg": {
          "type": "string",
          "enum": [
            "EdDSA",
            "ES256",
            "ML-DSA-65"
          ]
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+={0,2}$"
        }
      },
      "additionalProperties": false
    },
    "upload_receipt": {
      "type": "object",
      "required": [
        "blob_ref",
        "content_digest",
        "size_bytes",
        "received_at",
        "issuer_service_id",
        "signature"
      ],
      "properties": {
        "blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "content_digest": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer_service_id": {
          "$ref": "#/$defs/did"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "blob_upload_request_body": {
      "type": "object",
      "required": [
        "content",
        "size_bytes"
      ],
      "properties": {
        "content": {
          "type": "string",
          "format": "binary",
          "description": "The binary blob content part in multipart/form-data. This field is not JCS-canonicalized as JSON; content_digest covers the bytes."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "content_digest": {
          "$ref": "#/$defs/hash"
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "blob_upload_outcome": {
      "type": "object",
      "required": [
        "blob_ref",
        "size_bytes",
        "content_digest"
      ],
      "properties": {
        "blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        },
        "content_digest": {
          "$ref": "#/$defs/hash"
        },
        "upload_receipt": {
          "$ref": "#/$defs/upload_receipt"
        }
      },
      "additionalProperties": false
    }
  }
}
