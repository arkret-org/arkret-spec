{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/signal-stream-frame.schema.json",
  "title": "SignalStreamFrame",
  "description": "One frame emitted by ak.self.signal.stream.subscribe.v1. Signal data is encrypted-only and ephemeral. Control frames never create a cursor, replay position, delivery receipt, or durable acceptance.",
  "oneOf": [
    {
      "$ref": "#/$defs/signal"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/drain"
    },
    {
      "$ref": "#/$defs/unauthorized"
    }
  ],
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "kind",
        "envelope",
        "delivery_authority"
      ],
      "properties": {
        "kind": {
          "const": "signal"
        },
        "envelope": {
          "$ref": "./signal-envelope.schema.json"
        },
        "delivery_authority": {
          "$ref": "#/$defs/delivery_authority"
        }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "heartbeat"
        }
      },
      "additionalProperties": false
    },
    "drain": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "drain"
        },
        "reconnect_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "unauthorized": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unauthorized"
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "delivery_authority": {
      "type": "object",
      "description": "Own-Station current admission for only the exact envelope in this authenticated stream frame. Bound to the receiving account and live connection generation; never a transferable or reusable current grant. The client independently binds key and exact authorization_ref to its verified MLS leaf.",
      "required": [
        "recipient_account_id",
        "key"
      ],
      "properties": {
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "key": {
          "$ref": "./signer-key-operations.schema.json#/$defs/station_signing_key"
        },
        "product_authority": {
          "$ref": "#/$defs/product_authority"
        },
        "call_invitation": {
          "$ref": "./call-invitation-operations.schema.json#/$defs/delivery_view"
        }
      },
      "additionalProperties": false
    },
    "product_authority": {
      "type": "object",
      "description": "Own-Station complete authority-qualified Typing and MessageStream evidence for this exact envelope, maximum 32768 canonical JSON bytes. Original basis and sent_at equal the envelope. Historical and current grants are independently complete for all three registered product actions, including negative constraints. Absence disables these product projections without disabling authenticated decryption of other profiles.",
      "required": [
        "authority_commit_id",
        "current_realm_head",
        "current_scope_head",
        "sent_at",
        "grants",
        "current_grants",
        "historical_product_policies",
        "current_product_policies",
        "owner_actions",
        "profile_actions"
      ],
      "properties": {
        "authority_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "parent_realm_authority_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "current_realm_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        },
        "current_scope_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        },
        "sent_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "./capability-grant.schema.json"
          },
          "maxItems": 64
        },
        "current_grants": {
          "type": "array",
          "items": {
            "$ref": "./capability-grant.schema.json"
          },
          "maxItems": 64
        },
        "historical_product_policies": {
          "type": "array",
          "items": {
            "$ref": "./policy.schema.json"
          },
          "maxItems": 64,
          "description": "Complete applicable access/moderation policies at this cut, including parent Realm and Circle restrictions; no narrower allow overrides a parent denial."
        },
        "current_product_policies": {
          "type": "array",
          "items": {
            "$ref": "./policy.schema.json"
          },
          "maxItems": 64,
          "description": "Complete applicable access/moderation policies at this cut, including parent Realm and Circle restrictions; no narrower allow overrides a parent denial."
        },
        "owner_actions": {
          "type": "array",
          "items": {
            "const": "ak.message.create"
          },
          "maxItems": 1,
          "uniqueItems": true
        },
        "profile_actions": {
          "type": "array",
          "items": {
            "enum": [
              "ak.message.create",
              "ak.typing.broadcast"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "agent": {
          "$ref": "#/$defs/agent_product_authority"
        }
      },
      "additionalProperties": false
    },
    "agent_product_authority": {
      "type": "object",
      "description": "Accepted exact controller and live owned-Agent join source, ordinary controller authority, historical/current public management bounds and the accepted signing key ceiling projected into this Realm. Private participation preferences remain producer intent gates.",
      "required": [
        "controller_account_id",
        "controller_grants",
        "current_controller_grants",
        "historical_controller_owner_actions",
        "current_controller_owner_actions",
        "historical_management_policies",
        "current_management_policies",
        "key_scope"
      ],
      "properties": {
        "controller_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "controller_grants": {
          "type": "array",
          "items": {
            "$ref": "./capability-grant.schema.json"
          },
          "maxItems": 64
        },
        "current_controller_grants": {
          "type": "array",
          "items": {
            "$ref": "./capability-grant.schema.json"
          },
          "maxItems": 64
        },
        "historical_controller_owner_actions": {
          "type": "array",
          "items": {
            "const": "ak.message.create"
          },
          "maxItems": 1,
          "uniqueItems": true
        },
        "current_controller_owner_actions": {
          "type": "array",
          "items": {
            "const": "ak.message.create"
          },
          "maxItems": 1,
          "uniqueItems": true
        },
        "historical_management_policies": {
          "type": "array",
          "items": {
            "$ref": "./policy.schema.json"
          },
          "maxItems": 64
        },
        "current_management_policies": {
          "type": "array",
          "items": {
            "$ref": "./policy.schema.json"
          },
          "maxItems": 64
        },
        "key_scope": {
          "$ref": "./event-payload.schema.json#/$defs/agent_key_scope"
        }
      },
      "additionalProperties": false
    }
  }
}
