{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/signal-stream-frame.schema.json",
  "title": "SignalStreamFrame",
  "description": "One frame emitted by ak.self.signal.stream.subscribe. Signal data is encrypted-only and ephemeral. Control frames never create a cursor, replay position, delivery receipt, or durable acceptance.",
  "oneOf": [
    {
      "$ref": "#/$defs/signal"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/drain"
    },
    {
      "$ref": "#/$defs/unauthorized"
    }
  ],
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "kind",
        "envelope"
      ],
      "properties": {
        "kind": {
          "const": "signal"
        },
        "envelope": {
          "$ref": "./signal-envelope.schema.json"
        }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "heartbeat"
        }
      },
      "additionalProperties": false
    },
    "drain": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "drain"
        },
        "reconnect_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "unauthorized": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unauthorized"
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  }
}
