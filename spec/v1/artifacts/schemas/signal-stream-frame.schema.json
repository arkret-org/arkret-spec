{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/signal-stream-frame.schema.json",
  "title": "SignalStreamFrame",
  "description": "One frame emitted by ak.self.signal.stream.subscribe.v1. Signal data is encrypted-only and ephemeral. Control frames never create a cursor, replay position, delivery receipt, or durable acceptance.",
  "oneOf": [
    {
      "$ref": "#/$defs/signal"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/drain"
    },
    {
      "$ref": "#/$defs/unauthorized"
    }
  ],
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "kind",
        "envelope",
        "delivery_authority"
      ],
      "properties": {
        "kind": {
          "const": "signal"
        },
        "envelope": {
          "$ref": "./signal-envelope.schema.json"
        },
        "delivery_authority": {
          "$ref": "#/$defs/delivery_authority"
        }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "heartbeat"
        }
      },
      "additionalProperties": false
    },
    "drain": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "drain"
        },
        "reconnect_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "unauthorized": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unauthorized"
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "delivery_authority": {
      "type": "object",
      "description": "Own-Station current admission for only the exact envelope in this authenticated stream frame. Bound to the receiving account and live connection generation; never a transferable or reusable current grant. The client independently binds key and exact authorization_ref to its verified MLS leaf.",
      "required": [
        "recipient_account_id",
        "key"
      ],
      "properties": {
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "key": {
          "$ref": "./signer-key-operations.schema.json#/$defs/station_signing_key"
        }
      },
      "additionalProperties": false
    }
  }
}
