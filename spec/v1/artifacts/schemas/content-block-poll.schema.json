{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/content-block-poll.schema.json",
  "title": "Arkret Poll Content Block",
  "description": "Canonical content-block schema for ak.content.poll and ak.content.poll.response.",
  "oneOf": [
    {
      "$ref": "#/$defs/poll_block"
    },
    {
      "$ref": "#/$defs/poll_response_block"
    }
  ],
  "$defs": {
    "message_id": {
      "$ref": "./agent-operations.schema.json#/$defs/message_id"
    },
    "answer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "content_block": {
      "$ref": "./message.schema.json#/$defs/content_block"
    },
    "format": {
      "type": "string",
      "enum": [
        "plain",
        "markdown",
        "prosemirror_json"
      ]
    },
    "formatted_body": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "reply_context": {
      "type": "object",
      "properties": {
        "message_ref": {
          "type": "string",
          "pattern": "^ak:(message|event):[A-Za-z0-9_-]{44}$"
        },
        "sender_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "not": {
        "required": [
          "type"
        ]
      }
    },
    "poll_answer": {
      "type": "object",
      "description": "One visible answer option. answer.id values MUST be unique within a poll; reducers and conformance vectors enforce that cross-item constraint.",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/answer_id"
        },
        "text": {
          "$ref": "#/$defs/content_block"
        }
      },
      "additionalProperties": false
    },
    "poll_body": {
      "type": "object",
      "description": "Poll configuration. max_selections is validated against responses by reducers because JSON Schema cannot compare a response to its referenced poll message.",
      "required": [
        "kind",
        "max_selections",
        "answers"
      ],
      "properties": {
        "kind": {
          "const": "disclosed"
        },
        "max_selections": {
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "$ref": "#/$defs/content_block"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/poll_answer"
          }
        }
      },
      "additionalProperties": false
    },
    "poll_response_body": {
      "type": "object",
      "required": [
        "poll_ref",
        "selections"
      ],
      "properties": {
        "poll_ref": {
          "$ref": "#/$defs/message_id"
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/answer_id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "poll_block": {
      "type": "object",
      "required": [
        "kind",
        "body",
        "poll"
      ],
      "properties": {
        "kind": {
          "const": "ak.content.poll"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "formatted_body": {
          "$ref": "#/$defs/formatted_body"
        },
        "reply_context": {
          "$ref": "#/$defs/reply_context"
        },
        "poll": {
          "$ref": "#/$defs/poll_body"
        }
      },
      "additionalProperties": false
    },
    "poll_response_block": {
      "type": "object",
      "required": [
        "kind",
        "body",
        "poll_response"
      ],
      "properties": {
        "kind": {
          "const": "ak.content.poll.response"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "formatted_body": {
          "$ref": "#/$defs/formatted_body"
        },
        "reply_context": {
          "$ref": "#/$defs/reply_context"
        },
        "poll_response": {
          "$ref": "#/$defs/poll_response_body"
        }
      },
      "additionalProperties": false
    }
  }
}
