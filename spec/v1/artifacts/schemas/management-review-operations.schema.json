{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/management-review-operations.schema.json",
  "title": "Arkret Management Review Operations",
  "oneOf": [
    {
      "$ref": "#/$defs/management_review_request_body"
    },
    {
      "$ref": "#/$defs/management_review_decision_request_body"
    },
    {
      "$ref": "#/$defs/management_review_status_request_body"
    },
    {
      "$ref": "#/$defs/response_body"
    }
  ],
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "event"
          ],
          "properties": {
            "kind": {
              "const": "event",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "management-review-operations.schema.json#/$defs/target/oneOf/0/properties/kind",
                "owner": "management-review-operations.schema.json#/$defs/target/oneOf/0/properties/kind",
                "values": [
                  "event"
                ]
              }
            },
            "event": {
              "$ref": "./event-envelope.schema.json"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "management_review_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "effective_scope",
        "management_operation",
        "requester_actor_id",
        "target"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "management_operation": {
          "enum": [
            "join",
            "publish",
            "create_bot",
            "map_ghost"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/properties/management_operation",
            "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/properties/management_operation",
            "values": [
              "join",
              "publish",
              "create_bot",
              "map_ghost"
            ]
          }
        },
        "requester_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "configuration_ref": {
          "type": "object",
          "required": [
            "request_id",
            "intent_digest"
          ],
          "properties": {
            "request_id": {
              "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
            },
            "intent_digest": {
              "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 4194304,
      "allOf": [
        {
          "if": {
            "properties": {
              "management_operation": {
                "const": "join",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/if/properties/management_operation",
                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/if/properties/management_operation",
                  "values": [
                    "join"
                  ]
                }
              }
            },
            "required": [
              "management_operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "event",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/kind",
                      "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/kind",
                      "values": [
                        "event"
                      ]
                    }
                  },
                  "event": {
                    "anyOf": [
                      {
                        "properties": {
                          "kind": {
                            "enum": [
                              "ak.member.state"
                            ],
                            "x-arkret-value-ownership": {
                              "class": "namespaced_symbol",
                              "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/0/properties/kind",
                              "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/0/properties/kind",
                              "values": [
                                "ak.member.state"
                              ]
                            }
                          }
                        }
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "ak.circle.member.state",
                            "x-arkret-value-ownership": {
                              "class": "namespaced_symbol",
                              "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/kind",
                              "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/kind",
                              "values": [
                                "ak.circle.member.state"
                              ]
                            }
                          },
                          "scope_ref": {
                            "properties": {
                              "kind": {
                                "const": "circle",
                                "x-arkret-value-ownership": {
                                  "class": "owned_symbol",
                                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/scope_ref/properties/kind",
                                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/scope_ref/properties/kind",
                                  "values": [
                                    "circle"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          },
                          "actor_id": {
                            "$ref": "./common-ids.schema.json#/$defs/actor_id",
                            "properties": {
                              "kind": {
                                "const": "realm",
                                "x-arkret-value-ownership": {
                                  "class": "owned_symbol",
                                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/actor_id/properties/kind",
                                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/actor_id/properties/kind",
                                  "values": [
                                    "realm"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          },
                          "applet_id": {
                            "$ref": "./common-ids.schema.json#/$defs/applet_id"
                          },
                          "payload": {
                            "properties": {
                              "membership": {
                                "const": "join",
                                "x-arkret-value-ownership": {
                                  "class": "owned_symbol",
                                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/payload/properties/membership",
                                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/0/then/properties/target/properties/event/anyOf/1/properties/payload/properties/membership",
                                  "values": [
                                    "join"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "membership"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "scope_ref",
                          "actor_id",
                          "applet_id",
                          "payload"
                        ],
                        "not": {
                          "required": [
                            "executed_by"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "management_operation": {
                "const": "publish",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/1/if/properties/management_operation",
                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/1/if/properties/management_operation",
                  "values": [
                    "publish"
                  ]
                }
              }
            },
            "required": [
              "management_operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "event",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/1/then/properties/target/properties/kind",
                      "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/1/then/properties/target/properties/kind",
                      "values": [
                        "event"
                      ]
                    }
                  },
                  "event": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "ak.agent.interaction.set",
                          "ak.profile.create",
                          "ak.profile.update"
                        ],
                        "x-arkret-value-ownership": {
                          "class": "namespaced_symbol",
                          "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/1/then/properties/target/properties/event/properties/kind",
                          "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/1/then/properties/target/properties/event/properties/kind",
                          "values": [
                            "ak.agent.interaction.set",
                            "ak.profile.create",
                            "ak.profile.update"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "management_operation": {
                "const": "create_bot",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/2/if/properties/management_operation",
                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/2/if/properties/management_operation",
                  "values": [
                    "create_bot"
                  ]
                }
              }
            },
            "required": [
              "management_operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "event": {
                    "properties": {
                      "kind": {
                        "const": "ak.realm.actor.create",
                        "x-arkret-value-ownership": {
                          "class": "namespaced_symbol",
                          "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/2/then/properties/target/properties/event/properties/kind",
                          "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/2/then/properties/target/properties/event/properties/kind",
                          "values": [
                            "ak.realm.actor.create"
                          ]
                        }
                      },
                      "payload": {
                        "properties": {
                          "actor_role": {
                            "const": "bot",
                            "x-arkret-value-ownership": {
                              "class": "owned_symbol",
                              "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/2/then/properties/target/properties/event/properties/payload/properties/actor_role",
                              "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/2/then/properties/target/properties/event/properties/payload/properties/actor_role",
                              "values": [
                                "bot"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "management_operation": {
                "const": "map_ghost",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/3/if/properties/management_operation",
                  "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/3/if/properties/management_operation",
                  "values": [
                    "map_ghost"
                  ]
                }
              }
            },
            "required": [
              "management_operation"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "event": {
                    "properties": {
                      "kind": {
                        "const": "ak.realm.actor.create",
                        "x-arkret-value-ownership": {
                          "class": "namespaced_symbol",
                          "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/3/then/properties/target/properties/event/properties/kind",
                          "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/3/then/properties/target/properties/event/properties/kind",
                          "values": [
                            "ak.realm.actor.create"
                          ]
                        }
                      },
                      "payload": {
                        "properties": {
                          "actor_role": {
                            "const": "ghost",
                            "x-arkret-value-ownership": {
                              "class": "owned_symbol",
                              "authority": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/3/then/properties/target/properties/event/properties/payload/properties/actor_role",
                              "owner": "management-review-operations.schema.json#/$defs/management_review_request_body/allOf/3/then/properties/target/properties/event/properties/payload/properties/actor_role",
                              "values": [
                                "ghost"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "x-arkret-name-role": "request_body"
    },
    "management_review_status_request_body": {
      "type": "object",
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "management_review_decision_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "expected_status",
        "decision"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "expected_status": {
          "const": "pending",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "management-review-operations.schema.json#/$defs/management_review_decision_request_body/properties/expected_status",
            "owner": "management-review-operations.schema.json#/$defs/management_review_decision_request_body/properties/expected_status",
            "values": [
              "pending"
            ]
          }
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "cancel"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "management-review-operations.schema.json#/$defs/management_review_decision_request_body/properties/decision",
            "owner": "management-review-operations.schema.json#/$defs/management_review_decision_request_body/properties/decision",
            "values": [
              "approve",
              "reject",
              "cancel"
            ]
          }
        },
        "approval_signatures": {
          "type": "array",
          "items": {
            "$ref": "./approval-signature.schema.json"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approve",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "management-review-operations.schema.json#/$defs/management_review_decision_request_body/allOf/0/if/properties/decision",
                  "owner": "management-review-operations.schema.json#/$defs/management_review_decision_request_body/allOf/0/if/properties/decision",
                  "values": [
                    "approve"
                  ]
                }
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "approval_signatures"
            ]
          },
          "else": {
            "not": {
              "required": [
                "approval_signatures"
              ]
            }
          }
        }
      ],
      "x-arkret-name-role": "request_body"
    },
    "response_body": {
      "type": "object",
      "required": [
        "request_id",
        "status",
        "target_digest",
        "expires_at"
      ],
      "properties": {
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "cancelled",
            "expired",
            "consumed",
            "superseded"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "management-review-operations.schema.json#/$defs/response_body/properties/status",
            "owner": "management-review-operations.schema.json#/$defs/response_body/properties/status",
            "values": [
              "pending",
              "approved",
              "rejected",
              "cancelled",
              "expired",
              "consumed",
              "superseded"
            ]
          }
        },
        "target_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
        },
        "expires_at": {
          "$ref": "./account-operations.schema.json#/$defs/timestamp"
        },
        "approval_signatures": {
          "type": "array",
          "items": {
            "$ref": "./approval-signature.schema.json"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    }
  }
}
