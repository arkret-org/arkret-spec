{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/notification.schema.json",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "title": "Cokret Notification",
  "type": "object",
  "required": [
    "id",
    "schema",
    "actor_id",
    "source_event_id",
    "notification_type",
    "priority",
    "state",
    "created_at"
  ],
  "not": {
    "required": ["track"],
    "$comment": "Flow track keys use track_name on current wire."
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ck:notification:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "ck.schema.notification.v1"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^ck:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^(ck:(message|flow|morph|relation|view|blob):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|ck:blob:(sha256|sha3_256|blake3):[0-9a-f]{64}|ck:blob:sha512:[0-9a-f]{128})$",
      "description": "Optional canonical-object reference for clients that want to render the notification target without resolving source_event_id. Reducers MUST treat source_event_id as authoritative; source_ref is a render-only hint."
    },
    "flow_id": {
      "type": "string",
      "pattern": "^ck:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Optional Flow context for routing the notification."
    },
    "track_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Optional Flow track key on the source Flow."
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "mention",
        "reply",
        "assignment",
        "invite",
        "reaction",
        "policy",
        "call",
        "applet",
        "agent",
        "moderation",
        "system"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "dismissed",
        "archived"
      ]
    },
    "preview": {
      "type": "object",
      "description": "Render summary. Under E2EE / redaction / history-limited scopes this MUST be empty or an authorized redacted digest; sender/reducer-enforced. A notification projection MUST NOT widen the plaintext visibility of the source Message. See models/private-objects.md §3.4."
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false
}
