{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/notification.schema.json",
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "ordinary_notification_kind": {
      "type": "string",
      "enum": [
        "message",
        "mention",
        "reply",
        "assignment",
        "schedule",
        "reaction",
        "policy",
        "call",
        "applet",
        "moderation",
        "system"
      ],
      "description": "Closed notification_kind subset of the ordinary source-Event branch. invite has its own private Invite delivery carrier and agent belongs to the account-artifact branch, so neither participates in the deterministic projection preimage."
    },
    "projection_preimage": {
      "type": "object",
      "required": [
        "recipient_account_id",
        "realm_id",
        "source_event_id",
        "notification_kind"
      ],
      "properties": {
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "source_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "notification_kind": {
          "$ref": "#/$defs/ordinary_notification_kind"
        }
      },
      "additionalProperties": false
    },
    "ordinary_projection_content": {
      "type": "object",
      "description": "Server-materialized current content of one ordinary source-Event notification projection, as delivered on the account subscribe notifications channel (account-subscribe-frame.schema.json#/$defs/notification_delta). It reuses the ak.schema.notification.v1 field shapes and carries only what the recipient's own Station can state authoritatively: the projection identity is the delta id, the recipient is the authenticated account, and the inbox state (unread / read / dismissed / archived) stays in holder-private account data. See spec/v1/zh/sync/client-sync.md#312.",
      "required": [
        "realm_id",
        "source_event_id",
        "notification_kind",
        "priority",
        "created_at"
      ],
      "properties": {
        "realm_id": {
          "$ref": "#/properties/realm_id"
        },
        "source_event_id": {
          "$ref": "#/properties/source_event_id"
        },
        "source_ref": {
          "$ref": "#/properties/source_ref"
        },
        "strand_id": {
          "$ref": "#/properties/strand_id"
        },
        "track_name": {
          "$ref": "#/properties/track_name"
        },
        "notification_kind": {
          "$ref": "#/$defs/ordinary_notification_kind"
        },
        "priority": {
          "$ref": "#/properties/priority"
        },
        "preview": {
          "$ref": "#/properties/preview"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  },
  "title": "Arkret Notification",
  "type": "object",
  "required": [
    "id",
    "schema",
    "actor_id",
    "notification_kind",
    "priority",
    "state",
    "created_at"
  ],
  "not": {
    "required": [
      "track"
    ],
    "$comment": "Strand track keys use track_name; track is forbidden."
  },
  "properties": {
    "id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ak:notification_projection:[A-Za-z0-9_-]{44}$",
          "description": "SHA-256 suite byte 0x01 followed by the complete digest of the registered notification projection preimage. Recompute against recipient AccountId, RealmId, source EventId and notification_kind."
        },
        {
          "type": "string",
          "pattern": "^ak:notification:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "schema": {
      "const": "ak.schema.notification.v1"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "source_account_artifact": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "agent_runtime_approval"
        },
        "id": {
          "type": "string",
          "pattern": "^(?!ak:)[A-Za-z0-9._:-]{1,128}$",
          "description": "Profile-local approval_request_id. It is an opaque_correlation value, so its lexical space is disjoint from the ak: typed-ID namespace: a value MUST NOT begin with ak:."
        }
      },
      "additionalProperties": false,
      "description": "Closed account-private artifact source for notifications that are not derived from a durable Realm Event."
    },
    "source_ref": {
      "type": "string",
      "pattern": "^((?:ak:(message|strand|morph|relation|view):[A-Za-z0-9_-]{44}|ak:(blob):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})|ak:blob:(sha256|blake3):[0-9a-f]{64})$",
      "description": "Optional canonical-object reference for clients that want to render the notification target without resolving source_event_id. Reducers MUST treat source_event_id as authoritative; source_ref is a render-only hint."
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$",
      "description": "Optional Strand context for routing the notification."
    },
    "track_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Optional Strand track key on the source Strand."
    },
    "notification_kind": {
      "type": "string",
      "enum": [
        "message",
        "mention",
        "reply",
        "assignment",
        "schedule",
        "invite",
        "reaction",
        "policy",
        "call",
        "applet",
        "agent",
        "moderation",
        "system"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "dismissed",
        "archived"
      ]
    },
    "preview": {
      "type": "object",
      "description": "Render summary. Under E2EE / redaction / history-limited scopes this MUST be empty or an authorized redacted digest; sender/reducer-enforced. A notification projection MUST NOT widen the plaintext visibility of the source Message. See models/private-objects.md §3.4."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "oneOf": [
    {
      "required": [
        "source_event_id",
        "realm_id"
      ],
      "not": {
        "required": [
          "source_account_artifact"
        ]
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ak:notification_projection:[A-Za-z0-9_-]{44}$",
          "description": "SHA-256 suite byte 0x01 followed by the complete digest of the registered notification projection preimage. Recompute against recipient AccountId, RealmId, source EventId and notification_kind."
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "not": {
            "required": [
              "service_id"
            ]
          }
        },
        "notification_kind": {
          "$ref": "#/$defs/ordinary_notification_kind"
        }
      }
    },
    {
      "required": [
        "source_account_artifact"
      ],
      "properties": {
        "notification_kind": {
          "const": "agent"
        },
        "id": {
          "type": "string",
          "pattern": "^ak:notification:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "source_event_id"
            ]
          },
          {
            "required": [
              "realm_id"
            ]
          },
          {
            "required": [
              "source_ref"
            ]
          },
          {
            "required": [
              "strand_id"
            ]
          },
          {
            "required": [
              "track_name"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
