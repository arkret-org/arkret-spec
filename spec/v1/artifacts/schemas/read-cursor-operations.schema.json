{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/read-cursor-operations.schema.json",
  "title": "Arkret Read Cursor Self-Management Operation DTOs",
  "description": "Closed request/response DTOs for the self-surface read cursor operations (ak.self.read_cursor.*). Advance carries the authenticated holder's exact signed ak.read_cursor.advance actor-private Event; the service validates and forwards it without rebuilding or co-signing. The durable cursor object model and read_scope / position field shapes are read-cursor.schema.json. See spec/v1/zh/discovery/read-receipts.md.",
  "anyOf": [
    {
      "$ref": "#/$defs/read_cursor_advance_request_body"
    },
    {
      "$ref": "#/$defs/read_marker_outcome"
    },
    {
      "$ref": "#/$defs/read_cursor_list"
    }
  ],
  "$defs": {
    "did": {
      "$ref": "./common-ids.schema.json#/$defs/core_id"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "read_cursor_advance_request_body": {
      "type": "object",
      "description": "Carries one caller-signed ak.read_cursor.advance Event and nothing else. The Event payload is the complete ak.schema.read_cursor.v1 object; actor_id is both envelope ownership and payload ownership, while payload device_id must equal the authenticated session device. The service MUST submit these exact bytes through ordinary Event admission and MUST NOT mint the cursor id, choose updated_at, rebuild the payload, or sign under a service identity.",
      "required": [
        "advance_event"
      ],
      "properties": {
        "advance_event": {
          "allOf": [
            {
              "$ref": "./service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
            },
            {
              "type": "object",
              "required": [
                "event"
              ],
              "properties": {
                "event": {
                  "type": "object",
                  "required": [
                    "kind",
                    "payload"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ak.read_cursor.advance"
                    },
                    "payload": {
                      "$ref": "./read-cursor.schema.json"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "read_marker_outcome": {
      "type": "object",
      "required": [
        "realm_id",
        "actor_id",
        "device_id",
        "read_scope",
        "position",
        "updated_at"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/core_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "read_scope": {
          "$ref": "./read-cursor.schema.json#/$defs/read_scope"
        },
        "position": {
          "$ref": "./read-cursor.schema.json#/$defs/position"
        },
        "updated_at": {
          "$ref": "./read-cursor.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "read_cursor_list": {
      "type": "object",
      "required": [
        "markers"
      ],
      "properties": {
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/read_marker_outcome"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
