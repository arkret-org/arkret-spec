{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/offline-publication.schema.json",
  "title": "Arkret Offline Publication Proofs",
  "$defs": {
    "authorization_lease": {
      "type": "object",
      "required": [
        "authorization_lease_id",
        "basis_ref",
        "actor_id",
        "device_id",
        "scope_ref",
        "action",
        "authorization_rule_id",
        "risk_tier",
        "issued_at",
        "expires_at",
        "authority_set_ref",
        "authority_set_policy",
        "proofs"
      ],
      "properties": {
        "authorization_lease_id": {
          "type": "string",
          "pattern": "^ak:authorization_lease:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "basis_ref": {
          "oneOf": [
            {
              "$ref": "./event-envelope.schema.json#/$defs/seal_ref"
            },
            {
              "$ref": "./event-envelope.schema.json#/properties/seal_basis"
            }
          ],
          "description": "Accepted authorization basis. Single-chain profiles use one Seal ref; open_set uses the signed multi-leaf seal_basis object including control_event_set_root and state_root."
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "scope_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
        },
        "action": {
          "type": "string",
          "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
        },
        "authorization_rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Exact authorization_rules[].rule_id selected for this lease. The selected rule MUST allow action and only proofs from that rule may satisfy its threshold."
        },
        "risk_tier": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "authority_set_ref": {
          "$ref": "#/$defs/authority_set_ref"
        },
        "authority_set_policy": {
          "$ref": "#/$defs/authority_set_policy",
          "description": "Portable concrete policy bytes. authority_set_id MUST equal authority_set_ref.authority_set_id and SHA-256(JCS(this object)) MUST equal authority_set_ref.authority_set_digest. Verifiers MUST additionally rederive this policy from basis_ref and the submitted CBA closure."
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "./event-envelope.schema.json#/$defs/proof"
          }
        }
      },
      "additionalProperties": false
    },
    "ingress_receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "event_digest",
        "authorization_lease_id",
        "received_at",
        "service_id",
        "authority_set_ref",
        "proofs"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "event_digest": {
          "$ref": "#/$defs/hash"
        },
        "authorization_lease_id": {
          "type": "string",
          "pattern": "^ak:authorization_lease:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "received_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "authority_set_ref": {
          "$ref": "#/$defs/authority_set_ref"
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "./event-envelope.schema.json#/$defs/proof"
          }
        }
      },
      "additionalProperties": false
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "authority_set_ref": {
      "type": "object",
      "required": [
        "authority_set_id",
        "authority_set_digest"
      ],
      "properties": {
        "authority_set_id": {
          "type": "string",
          "pattern": "^ak\\.authority_set\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
        },
        "authority_set_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false,
      "description": "Immutable reference to the CBA authority-set policy resolved at basis_ref. authority_set_digest binds the canonical policy bytes so a mutable registry lookup cannot change quorum, delegation, or revocation semantics."
    },
    "authority_set_policy": {
      "type": "object",
      "required": [
        "schema",
        "authority_set_id",
        "policy_kind",
        "scope_ref",
        "source",
        "authorization_rules"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.authority_set_policy.v1"
        },
        "authority_set_id": {
          "type": "string",
          "pattern": "^ak\\.authority_set\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v1$"
        },
        "policy_kind": {
          "type": "string",
          "enum": [
            "principal_control",
            "realm_admission"
          ]
        },
        "scope_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
        },
        "source": {
          "type": "object",
          "required": [
            "source_kind",
            "source_ref",
            "source_digest",
            "generation_ref"
          ],
          "properties": {
            "source_kind": {
              "type": "string",
              "enum": [
                "cross_signing_publish",
                "did_document",
                "recovery_policy",
                "realm_control"
              ]
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            },
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "generation_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "authorization_rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "issuer_role",
              "allowed_actions",
              "issuers",
              "threshold"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "issuer_role": {
                "type": "string",
                "enum": [
                  "cross_signing_self_signing",
                  "identity_recovery",
                  "account_enrollment_authority",
                  "realm_admission"
                ]
              },
              "allowed_actions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^ak\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
                }
              },
              "issuers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "verification_method"
                  ],
                  "properties": {
                    "verification_method": {
                      "$ref": "./common-ids.schema.json#/$defs/did_url"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "threshold": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Canonical concrete policy. authority_set_digest is SHA-256(JCS(the complete object))."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/authorization_lease"
    },
    {
      "$ref": "#/$defs/ingress_receipt"
    }
  ]
}
