{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/read-marker.schema.json",
  "title": "Contrix Read Marker",
  "description": "Actor-private multi-device read cursor. Stored in encrypted account data or actor-private stream; NEVER published into a shared Realm Event history. Bound to (actor_id, realm_id, scope, position, HLC, device_id) per zh/discovery/read-receipts.md §6.6 so that concurrent updates from multiple devices converge by HLC max.",
  "type": "object",
  "required": [
    "id",
    "schema",
    "actor_id",
    "realm_id",
    "scope",
    "position",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:read_marker:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.read_marker.v1"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^cx:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Originating device. Required for multi-device convergence: when two devices race on the same (actor_id, realm_id, scope) the receiver picks the entry with greater HLC; device_id provides a deterministic actor_id-scoped tiebreaker when HLCs are equal."
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "flow",
            "flow_discussion",
            "flow_synthesis",
            "thread",
            "view",
            "message",
            "morph"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^cx:(realm|flow|message|morph|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Required when kind is anything other than 'realm'. Identifies the target object whose timeline this marker tracks."
        },
        "track": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Optional active track when kind references a Flow. 'flow_discussion' / 'flow_synthesis' implicitly fix the track; explicit track overrides default."
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": ["event_id", "hlc"],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
