{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-bot-operations.schema.json",
  "title": "Arkret Applet Bot Provision Operations",
  "description": "Closed preview, commit, and outcome DTOs for receiver-side Applet-managed Bot provisioning. The commit carrier is exactly the signed authoring request plus its role-neutral managed-actor bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/bot_preview_request_body"
    },
    {
      "$ref": "#/$defs/bot_preview_outcome"
    }
  ],
  "$defs": {
    "bot_preview_request_body": {
      "type": "object",
      "required": [
        "effective_scope",
        "request_id"
      ],
      "properties": {
        "effective_scope": {
          "$ref": "./applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "request_id": {
          "$ref": "./realm-join-intake.schema.json#/$defs/request_id"
        },
        "display_name": {
          "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "bot_preview_outcome": {
      "type": "object",
      "required": [
        "authoring_request"
      ],
      "properties": {
        "authoring_request": {
          "allOf": [
            {
              "$ref": "./applet-install-authoring.schema.json#/$defs/authoring_request"
            },
            {
              "properties": {
                "purpose": {
                  "const": "provision_bot"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
