{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/applet-package.schema.json",
  "title": "Cokret Applet Package",
  "description": "Controller-signed package used to install an Applet. The package is a distribution object, not Realm history truth and not a grant. Principal Server / authz service derives ck.applet.registration and capability grants during ck.applet.install.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "applet_id",
    "service_did",
    "controller_did",
    "base_url",
    "bot_actor_id",
    "claimed_profiles",
    "protocols",
    "namespaces",
    "requested_scopes",
    "endpoint_set",
    "webhook_auth",
    "receive_events",
    "receive_ephemeral",
    "rate_limited",
    "limits",
    "ghost_policy",
    "delegation_policy",
    "e2ee_policy",
    "package_digest",
    "registration_epoch",
    "created_at",
    "proof"
  ],
  "properties": {
    "schema": {
      "const": "ck.schema.applet_package.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "description": "Distribution identifier only. Not a grant subject."
    },
    "applet_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/did"
        },
        {
          "$ref": "#/$defs/applet_id"
        }
      ]
    },
    "service_did": {
      "$ref": "#/$defs/did"
    },
    "controller_did": {
      "$ref": "#/$defs/did"
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "bot_actor_id": {
      "$ref": "#/$defs/did"
    },
    "claimed_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile_id"
      },
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "ck.profile.applet_service.v1"
      }
    },
    "protocols": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "namespaces": {
      "$ref": "#/$defs/applet_namespaces"
    },
    "requested_scopes": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "endpoint_set": {
      "type": "object",
      "additionalProperties": true
    },
    "webhook_auth": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "receive_events": {
      "type": "boolean"
    },
    "receive_ephemeral": {
      "type": "boolean"
    },
    "rate_limited": {
      "type": "boolean"
    },
    "limits": {
      "type": "object",
      "additionalProperties": true
    },
    "ghost_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "delegation_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "e2ee_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "widget": {
      "type": "object",
      "additionalProperties": true
    },
    "package_digest": {
      "$ref": "#/$defs/hash"
    },
    "registration_epoch": {
      "$ref": "#/$defs/hash"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "proof": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "description": "Controller DID detached proof over the canonical package or derived registration object. Empty object is invalid."
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "applet_id": {
      "type": "string",
      "pattern": "^ck:applet:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^ck\\.profile\\.[a-z0-9_.-]+\\.v1$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "namespace_entry": {
      "type": "object",
      "required": [
        "exclusive",
        "pattern"
      ],
      "properties": {
        "exclusive": {
          "type": "boolean"
        },
        "pattern": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "applet_namespaces": {
      "type": "object",
      "required": [
        "actors",
        "realms",
        "handles"
      ],
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace_entry"
          }
        },
        "realms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace_entry"
          }
        },
        "handles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace_entry"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false
}
