{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/mls-native-scope-source.schema.json",
  "title": "Arkret restricted native MLS scope source",
  "description": "Finite current-G to owning-H native qualification only. Pure signature/transcript/source binding does not establish G RFC acceptance, actual private retention, disclosure authority or global H/G simultaneity.",
  "$defs": {
    "sidecar_member_join": {
      "type": "object",
      "required": [
        "agent_actor_id",
        "join_event_ref"
      ],
      "properties": {
        "agent_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "description": "Must be the genuine complete Account Actor of an owned Agent, fixed at destination H; service/realm variants are semantically refused by the native-source owner."
        },
        "join_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        }
      },
      "additionalProperties": false,
      "description": "One actual current joined Agent bound by its original join to the exact complete controller and current controller join generation. Includes native-negative candidates, never just desired positives."
    },
    "sidecar_membership_basis": {
      "type": "object",
      "required": [
        "sidecar_id",
        "controller_account_id",
        "sidecar_create_event_ref",
        "controller_join_event_ref",
        "candidate_joins"
      ],
      "properties": {
        "sidecar_id": {
          "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
        },
        "controller_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "sidecar_create_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "controller_join_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "candidate_joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sidecar_member_join"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Complete exact G membership input. candidate_joins is sorted by RFC8785 ActorId UTF-8; one current join per Actor. Raw complete basis is checked against native G state, not accepted merely because a supplied digest agrees."
    },
    "covered_authorization": {
      "type": "object",
      "required": [
        "actor_id",
        "endpoint",
        "authorization_event_ref"
      ],
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id",
          "description": "Exact native subject from independently verified installed source; applicable new H qualification is limited to complete Account Actors, never a controller/RealmActor reinterpretation."
        },
        "endpoint": {
          "$ref": "./mls-welcome-delivery.schema.json#/properties/recipient_endpoint"
        },
        "authorization_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        }
      },
      "additionalProperties": false,
      "description": "Private permanent fence predicate identity; MLS raw leaf key is deliberately absent. Same Actor/key under another authorization Event is another native instance."
    },
    "fence_basis_entry": {
      "type": "object",
      "required": [
        "intent_digest",
        "covered_authorizations"
      ],
      "properties": {
        "intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "covered_authorizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/covered_authorization"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Private projection of one genuinely installed permanent fence. intent_digest is recomputed using the existing SDK I formula from its canonical first_source. Covered authorizations are the complete verified permanent coverage union, JCS-byte sorted and unique. An installed empty coverage list remains present; a reservation/FailedPrecondition without a fence is absent. SQL IDs/times/challenges/source digests/leaf keys never enter this projection."
    },
    "g_basis_preimage": {
      "type": "object",
      "required": [
        "domain",
        "realm_id",
        "effective_scope",
        "governance_authority_ref",
        "endpoint_fences"
      ],
      "properties": {
        "domain": {
          "const": "ak.mls.native_scope_basis.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "mls-native-scope-source.schema.json#/$defs/g_basis_preimage/properties/domain",
            "owner": "mls-native-scope-source.schema.json#/$defs/g_basis_preimage/properties/domain",
            "values": [
              "ak.mls.native_scope_basis.v1"
            ]
          }
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "governance_authority_ref": {
          "$ref": "./realm-commit.schema.json#/properties/authority_ref"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "sidecar_membership_basis": {
          "$ref": "#/$defs/sidecar_membership_basis"
        },
        "endpoint_fences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fence_basis_entry"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Private native preimage only, never sent to H. Exactly the actual target Realm/scope/current tenure, accepted Genesis when one exists, raw complete Sidecar membership basis iff Sidecar, and every installed permanent fence for the source-required complete Actors. Entries are sorted by intent_digest UTF-8. SHA256(JCS(this object)) is the sole g_basis_digest. Missing native originals/import or an unknown fence set is unavailable, not an empty projection. No whole-Realm head or H PCR source is included."
    },
    "source_purpose": {
      "type": "string",
      "enum": [
        "mls_admission",
        "sidecar_view",
        "group_state_material",
        "roster_authority",
        "welcome_bootstrap",
        "payload_delivery"
      ],
      "x-arkret-value-ownership": {
        "class": "owned_symbol",
        "authority": "mls-native-scope-source.schema.json#/$defs/source_purpose",
        "owner": "mls-native-scope-source.schema.json#/$defs/source_purpose",
        "values": [
          "mls_admission",
          "sidecar_view",
          "group_state_material",
          "roster_authority",
          "welcome_bootstrap",
          "payload_delivery"
        ]
      }
    },
    "native_scope_source_request_body": {
      "type": "object",
      "required": [
        "source_id",
        "destination_id",
        "query_nonce_base64url",
        "realm_id",
        "effective_scope",
        "governance_authority_ref",
        "purpose",
        "original_request_digest",
        "g_basis_digest",
        "endpoint_sources"
      ],
      "properties": {
        "source_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "destination_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "query_nonce_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "x-arkret-member-role": "binary_encoding"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "effective_scope": {
          "$ref": "./event-payload.schema.json#/$defs/effective_scope"
        },
        "governance_authority_ref": {
          "$ref": "./realm-commit.schema.json#/properties/authority_ref"
        },
        "genesis_event_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id",
          "x-arkret-preimage-commitment": "fixed_event"
        },
        "purpose": {
          "$ref": "#/$defs/source_purpose"
        },
        "original_request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "g_basis_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sidecar_membership_basis": {
          "$ref": "#/$defs/sidecar_membership_basis"
        },
        "endpoint_sources": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "authorization_event_ref"
                ],
                "properties": {
                  "authorization_event_ref": {
                    "$ref": "./common-ids.schema.json#/$defs/event_id",
                    "x-arkret-preimage-commitment": "fixed_event"
                  }
                },
                "additionalProperties": false
              },
              {
                "$ref": "./keypackage-operations.schema.json#/$defs/keypackages_claim_query_request_body"
              }
            ]
          },
          "uniqueItems": true,
          "description": "Each item is either the sole authorization_event_ref of a genuine accepted native original (creator/retained), or the existing closed claim_id query body shape (first Add only). Reusing that shape does not inherit the older claim-query ACL or operation role. H derives exact Actor/endpoint only from its real accepted original; EventId alone is never authority."
        }
      },
      "additionalProperties": false,
      "description": "Current actual G to one fixed owning H. Source_id is G, destination_id is H. The complete native business hash is reused without exposing the complete unit; no user session secret, unrelated package/Welcome, prejoin roster or H private PCR is sent. Source-required Actors are determined before H positives from genuine origins plus all Sidecar candidates/controller. Network occurs outside PG locks. Dynamic source is excluded from immutable native business identity; frozen ContentRecoverySource is not excluded.",
      "x-arkret-name-role": "request_body",
      "allOf": [
        {
          "if": {
            "properties": {
              "effective_scope": {
                "properties": {
                  "kind": {
                    "const": "sidecar",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_source_request_body/allOf/0/if/properties/effective_scope/properties/kind",
                      "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_source_request_body/allOf/0/if/properties/effective_scope/properties/kind",
                      "values": [
                        "sidecar"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "effective_scope"
            ]
          },
          "then": {
            "required": [
              "sidecar_membership_basis"
            ]
          },
          "else": {
            "not": {
              "required": [
                "sidecar_membership_basis"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "not": {
                  "const": "mls_admission",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_source_request_body/allOf/1/if/properties/purpose/not",
                    "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_source_request_body/allOf/1/if/properties/purpose/not",
                    "values": [
                      "mls_admission"
                    ]
                  }
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "effective_scope": {
                "properties": {
                  "kind": {
                    "const": "sidecar",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_source_request_body/allOf/1/then/properties/effective_scope/properties/kind",
                      "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_source_request_body/allOf/1/then/properties/effective_scope/properties/kind",
                      "values": [
                        "sidecar"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      ]
    },
    "endpoint_qualified": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "qualified",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mls-native-scope-source.schema.json#/$defs/endpoint_qualified/properties/state",
            "owner": "mls-native-scope-source.schema.json#/$defs/endpoint_qualified/properties/state",
            "values": [
              "qualified"
            ]
          }
        },
        "endpoint": {
          "$ref": "./content-encryption.schema.json#/$defs/endpoint"
        },
        "keypackage_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Existing SHA256 over the exact selected TLS KeyPackage bytes, recomputed by the sole MLS KeyPackage owner. Not the UUID keypackage_id, a caller label, or a parallel record digest."
        }
      },
      "additionalProperties": false,
      "description": "Same input position. A claim selector requires endpoint plus keypackage_ref from the actual selected record. An authorization EventId requires exactly state=qualified; H qualifies its real accepted native original and G retains the exact historical tuple/RFC key mapping. No endpoint/common-field echo. The pair verifier enforces this distinction."
    },
    "endpoint_ineligible": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "ineligible",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mls-native-scope-source.schema.json#/$defs/endpoint_ineligible/properties/state",
            "owner": "mls-native-scope-source.schema.json#/$defs/endpoint_ineligible/properties/state",
            "values": [
              "ineligible"
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "Known native negative for this exact instance only. Missing/corrupt/unknown source returns revision_unavailable for the whole request, never a fabricated negative."
    },
    "qualification": {
      "type": "object",
      "required": [
        "endpoint_qualifications",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "endpoint_qualifications": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/endpoint_qualified"
              },
              {
                "$ref": "#/$defs/endpoint_ineligible"
              }
            ]
          }
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "desired_qualifications": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "description": "Present iff Sidecar. Exactly candidate_joins length and order. G extracts true positions from the exact signed raw B, then projects their principals into the unchanged five-member participant authority digest. false means a genuinely determined native negative; unknown fails the entire request. No copied Agent IDs."
        }
      },
      "additionalProperties": false,
      "description": "endpoint_qualifications is exactly endpoint_sources length/order. desired_qualifications exists iff Sidecar and is exactly the complete raw B candidate_joins length/order. Current controller authority is independently mandatory; an invalid controller is never represented as an empty desired set. No source field is echoed."
    },
    "native_scope_source_response_body": {
      "type": "object",
      "required": [
        "qualification",
        "signature"
      ],
      "properties": {
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "signature": {
          "$ref": "./keypackage-operations.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false,
      "description": "H service Ed25519 signature over UTF8(ak.mls.native_scope_source.v1 + LF) followed by JCS({request:exact query,qualification:this qualification}). The request is an external verifier input; it is neither mirrored in the response nor replaced by a same-image hash. Full owning-H method-native Service history is resolved and retained independently. No worker/recovery/ready effect is implied."
    },
    "native_scope_source_signature_input": {
      "type": "object",
      "required": [
        "request",
        "qualification"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/native_scope_source_request_body"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        }
      },
      "additionalProperties": false,
      "description": "Private unsigned signing projection only; the request is the exact external verifier input, not a response mirror."
    },
    "native_scope_use_binding": {
      "type": "object",
      "required": [
        "domain",
        "purpose",
        "caller_actor_id",
        "existing_operation_request",
        "target_originals",
        "query_nonce_base64url"
      ],
      "properties": {
        "domain": {
          "const": "ak.mls.native_scope_use.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/properties/domain",
            "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/properties/domain",
            "values": [
              "ak.mls.native_scope_use.v1"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "enum": [
            "sidecar_view",
            "group_state_material",
            "roster_authority",
            "welcome_bootstrap",
            "payload_delivery"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/properties/purpose",
            "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/properties/purpose",
            "values": [
              "sidecar_view",
              "group_state_material",
              "roster_authority",
              "welcome_bootstrap",
              "payload_delivery"
            ]
          }
        },
        "caller_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "existing_operation_request": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "sidecar_id"
                  ],
                  "properties": {
                    "sidecar_id": {
                      "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "$ref": "./event-payload.schema.json#/$defs/mls_genesis_binding_proposal_carrier"
                }
              ]
            },
            {
              "$ref": "./mls-roster-authority.schema.json#/$defs/mls_member_group_state_material_read_request_body"
            },
            {
              "$ref": "./mls-roster-authority.schema.json#/$defs/mls_member_roster_authority_read_request_body"
            },
            {
              "$ref": "./mls-welcome-delivery.schema.json"
            },
            {
              "$ref": "./authority-commit-operations.schema.json#/$defs/peer_submit_request_body"
            }
          ]
        },
        "target_originals": {
          "type": "array",
          "items": {
            "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
          }
        },
        "query_nonce_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "x-arkret-member-role": "binary_encoding"
        }
      },
      "additionalProperties": false,
      "description": "Private closed source-use preimage, not a new network body or permission. Exact request comes from the original named owner. Sidecar View uses its exact path selector or original closed local proposal carrier; material/roster use the existing typed requests, Welcome its exact original delivery, and payload its complete existing peer committed-delivery request body, preserving the exact per-Sidecar committed batch in original order. target_originals are independently qualified actual accepted refs for that use (Sidecar create for pre-Genesis view/planning). No user token/header, unregistered operation, whole-Realm catalog or future current-selector lease. SHA256(JCS(this object)) supplies original_request_digest only where no existing equivalent business digest exists.",
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "sidecar_view",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/0/if/properties/purpose",
                  "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/0/if/properties/purpose",
                  "values": [
                    "sidecar_view"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "existing_operation_request": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "sidecar_id"
                    ],
                    "properties": {
                      "sidecar_id": {
                        "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "$ref": "./event-payload.schema.json#/$defs/mls_genesis_binding_proposal_carrier"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "group_state_material",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/1/if/properties/purpose",
                  "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/1/if/properties/purpose",
                  "values": [
                    "group_state_material"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "existing_operation_request": {
                "$ref": "./mls-roster-authority.schema.json#/$defs/mls_member_group_state_material_read_request_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "roster_authority",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/2/if/properties/purpose",
                  "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/2/if/properties/purpose",
                  "values": [
                    "roster_authority"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "existing_operation_request": {
                "$ref": "./mls-roster-authority.schema.json#/$defs/mls_member_roster_authority_read_request_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "welcome_bootstrap",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/3/if/properties/purpose",
                  "owner": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/3/if/properties/purpose",
                  "values": [
                    "welcome_bootstrap"
                  ]
                }
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "existing_operation_request": {
                "$ref": "./mls-welcome-delivery.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "payload_delivery",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "mls-native-scope-source.schema.json#/$defs/native_scope_use_binding/allOf/4/if/properties/purpose",
