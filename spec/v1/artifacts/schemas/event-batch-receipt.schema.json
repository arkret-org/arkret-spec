{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/event-batch-receipt.schema.json",
  "title": "Cokret Event Batch Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "schema",
    "issuer",
    "receipt_scope",
    "frontier",
    "events",
    "created_at",
    "proofs"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^ck:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema": {
      "const": "cx.schema.event_batch_receipt.v1"
    },
    "issuer": {
      "$ref": "./event-envelope.schema.json#/$defs/did"
    },
    "receipt_scope": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "./event-envelope.schema.json#/$defs/did"
        },
        "realm_id": {
          "type": "string",
          "pattern": "^ck:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "query_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "frontier": {
      "type": "object",
      "properties": {
        "actor_seq": {
          "type": "integer",
          "minimum": 0
        },
        "event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "event_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "./event-envelope.schema.json#/$defs/event_ref"
          },
          {
            "$ref": "./event-envelope.schema.json#/$defs/hash"
          }
        ]
      },
      "minItems": 1
    },
    "created_at": {
      "$ref": "./event-envelope.schema.json#/$defs/timestamp"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-envelope.schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
