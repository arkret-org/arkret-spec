{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/event-batch-receipt.schema.json",
  "title": "Arkret Event Batch Receipt",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "issuer",
    "scope",
    "frontier",
    "events",
    "created_at",
    "proofs"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.event_batch_receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer": {
      "$ref": "./event-envelope.schema.json#/$defs/did"
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/ordinary_scope"
        },
        {
          "$ref": "#/$defs/device_reanchor_scope"
        }
      ]
    },
    "frontier": {
      "type": "object",
      "properties": {
        "actor_seq": {
          "type": "integer",
          "minimum": 0
        },
        "event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "event_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        },
        "hlc": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "./event-envelope.schema.json#/$defs/event_ref"
          },
          {
            "$ref": "./event-envelope.schema.json#/$defs/hash"
          },
          {
            "$ref": "#/$defs/event_receipt_item"
          }
        ]
      },
      "minItems": 1
    },
    "created_at": {
      "$ref": "./event-envelope.schema.json#/$defs/timestamp"
    },
    "proofs": {
      "type": "array",
      "description": "Detached receipt proofs sign canonical_json({context:'ak.receipt-proof-v1', payload_digest: receipt_digest, issuer, verification_method, created_at, domain?, audience?}); context is a fixed signing-context domain tag, not a wire field.",
      "items": {
        "$ref": "./event-envelope.schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "$comment": "A device re-anchor receipt is closed over exactly [reanchor, replacement authorize] in that order. The issuer MUST additionally compare scope.reanchor_digest and scope.replacement_authorize_digest byte-for-byte with events[0].event_digest and events[1].event_digest before signing; this relational equality is semantic because JSON Schema cannot compare sibling values.",
      "if": {
        "properties": {
          "scope": {
            "$ref": "#/$defs/device_reanchor_scope"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "events": {
            "type": "array",
            "prefixItems": [
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/event_receipt_item"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "ak.device.reanchor"
                      }
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/event_receipt_item"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "ak.device.authorize"
                      }
                    }
                  }
                ]
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": false
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ordinary_scope": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "query_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "device_reanchor_scope": {
      "type": "object",
      "required": [
        "kind",
        "principal_id",
        "realm_id",
        "did_version_id",
        "registry_head",
        "reanchor_digest",
        "replacement_authorize_digest"
      ],
      "properties": {
        "kind": {
          "const": "device_reanchor_unit"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "did_version_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*-[^\\s]+$"
        },
        "registry_head": {
          "$ref": "./event-envelope.schema.json#/$defs/hash",
          "description": "Digest of the accepted-at identity registry head snapshot."
        },
        "reanchor_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash",
          "description": "MUST equal events[0].event_digest."
        },
        "replacement_authorize_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash",
          "description": "MUST equal events[1].event_digest."
        }
      },
      "additionalProperties": false
    },
    "event_receipt_item": {
      "type": "object",
      "required": [
        "event_id",
        "event_digest",
        "kind"
      ],
      "properties": {
        "event_id": {
          "$ref": "./event-envelope.schema.json#/$defs/event_ref"
        },
        "event_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
