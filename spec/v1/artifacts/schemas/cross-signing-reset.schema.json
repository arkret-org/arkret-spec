{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/cross-signing-reset.schema.json",
  "title": "Contrix Cross-Signing Reset",
  "description": "Payload content for cx.cross_signing.reset (schema_id cx.schema.cross_signing_reset.v1). High-risk operation that retires the current (SSK, USK) generation and requires one of four kinds of proof — see device-lifecycle.md §14. A successor cx.cross_signing.publish MUST follow within 24h.",
  "type": "object",
  "required": [
    "principal_id",
    "previous_generation",
    "new_generation",
    "reset_reason",
    "proof",
    "issued_at"
  ],
  "properties": {
    "principal_id": { "$ref": "#/$defs/did" },
    "previous_generation": {
      "type": "integer",
      "minimum": 1,
      "description": "The generation being retired; MUST equal the currently accepted publish generation."
    },
    "new_generation": {
      "type": "integer",
      "minimum": 2,
      "description": "Generation that the successor cx.cross_signing.publish will use; MUST equal previous_generation + 1."
    },
    "reset_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Free string; SHOULD come from {rotation, compromise, device_loss, policy_required}."
    },
    "proof": {
      "oneOf": [
        { "$ref": "#/$defs/principal_signing_proof" },
        { "$ref": "#/$defs/recovery_unlock_proof" },
        { "$ref": "#/$defs/device_quorum_proof" },
        { "$ref": "#/$defs/trusted_recovery_service_proof" }
      ]
    },
    "issued_at": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[^\\s#]+#[A-Za-z0-9._:-]+$"
    },
    "signature_b64u": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "principal_signing_proof": {
      "type": "object",
      "required": ["kind", "signed_by", "alg", "signature"],
      "properties": {
        "kind": { "const": "principal_signing" },
        "signed_by": { "$ref": "#/$defs/did_url" },
        "alg": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "#/$defs/signature_b64u" }
      },
      "additionalProperties": false
    },
    "recovery_unlock_proof": {
      "type": "object",
      "required": ["kind", "recovery_secret_ref", "unlock_commitment", "alg", "signature"],
      "properties": {
        "kind": { "const": "recovery_unlock" },
        "recovery_secret_ref": { "type": "string", "minLength": 1 },
        "unlock_commitment": { "$ref": "#/$defs/hash" },
        "alg": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "#/$defs/signature_b64u" }
      },
      "additionalProperties": false
    },
    "device_quorum_signature": {
      "type": "object",
      "required": ["device_id", "signed_by", "alg", "signature"],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^cx:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "signed_by": { "$ref": "#/$defs/did_url" },
        "alg": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "#/$defs/signature_b64u" }
      },
      "additionalProperties": false
    },
    "device_quorum_proof": {
      "type": "object",
      "required": ["kind", "threshold", "signatures"],
      "properties": {
        "kind": { "const": "device_quorum" },
        "threshold": { "type": "integer", "minimum": 1 },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/device_quorum_signature" }
        }
      },
      "additionalProperties": false
    },
    "trusted_recovery_service_proof": {
      "type": "object",
      "required": ["kind", "service_did", "signed_by", "alg", "signature"],
      "properties": {
        "kind": { "const": "trusted_recovery_service" },
        "service_did": { "$ref": "#/$defs/did" },
        "signed_by": { "$ref": "#/$defs/did_url" },
        "alg": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "#/$defs/signature_b64u" },
        "attestation_ref": {
          "type": "string",
          "pattern": "^cx:attestation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    }
  }
}
