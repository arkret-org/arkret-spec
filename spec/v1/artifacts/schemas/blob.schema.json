{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/blob.schema.json",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "encrypted_attachment": {
      "type": "object",
      "required": [
        "blob_ref",
        "encrypted",
        "alg",
        "key_ref",
        "epoch",
        "ciphertext_digest",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "blob_ref": {
          "type": "string",
          "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
        },
        "encrypted": {
          "const": true
        },
        "scheme": {
          "type": "string",
          "enum": [
            "ck.blob.whole_file_aead.v1",
            "ck.blob.stream_aead.v1"
          ]
        },
        "alg": {
          "type": "string",
          "enum": [
            "mls_exporter_aead_xchacha20poly1305",
            "mls_exporter_aead_aes_256_gcm",
            "mls_exporter_aead_xchacha20poly1305_stream",
            "mls_exporter_aead_aes_256_gcm_stream"
          ]
        },
        "key_ref": {
          "$comment": "MUST stay identical to encrypted-envelope.schema.json#/properties/key_ref and encryption-and-audit.md §2.3.1. Closed MLS group-binding object; not an opaque string.",
          "type": "object",
          "required": [
            "algorithm",
            "group_state_ref"
          ],
          "properties": {
            "algorithm": {
              "const": "MLS"
            },
            "group_state_ref": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "description": "Reference to accepted ck.mls.genesis / winning ck.mls.commit event."
                },
                {
                  "type": "string",
                  "pattern": "^(sha256|blake3):[0-9a-f]{64}$",
                  "description": "Equivalent group state proof hash."
                }
              ],
              "description": "v1 MLS group state lookup hint. MUST point to accepted ck.mls.genesis / winning ck.mls.commit / equivalent group state proof. Does NOT replace MLS transcript verification."
            }
          },
          "additionalProperties": false
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "ciphertext_digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        }
      },
      "oneOf": [
        {
          "$comment": "whole-file AEAD form: single nonce, single ciphertext_digest",
          "properties": {
            "scheme": {
              "const": "ck.blob.whole_file_aead.v1"
            },
            "alg": {
              "enum": [
                "mls_exporter_aead_xchacha20poly1305",
                "mls_exporter_aead_aes_256_gcm"
              ]
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,64}$"
            }
          },
          "required": [
            "nonce"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "nonce_prefix"
                ]
              },
              {
                "required": [
                  "segment_size"
                ]
              },
              {
                "required": [
                  "segment_count"
                ]
              }
            ]
          }
        },
        {
          "$comment": "streaming chunked AEAD form (STREAM / OAE2): per-segment AEAD, per-object random nonce_prefix",
          "properties": {
            "scheme": {
              "const": "ck.blob.stream_aead.v1"
            },
            "alg": {
              "enum": [
                "mls_exporter_aead_xchacha20poly1305_stream",
                "mls_exporter_aead_aes_256_gcm_stream"
              ]
            },
            "nonce_prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,64}$"
            },
            "segment_size": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 8388608
            },
            "segment_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "scheme",
            "nonce_prefix",
            "segment_size",
            "segment_count"
          ],
          "not": {
            "required": [
              "nonce"
            ]
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "title": "Arkret Blob Metadata",
  "type": "object",
  "required": [
    "blob_ref",
    "schema",
    "content_digest",
    "size_bytes",
    "media_type",
    "created_by",
    "created_at"
  ],
  "allOf": [
    {
      "not": {
        "required": [
          "size"
        ],
        "$comment": "byte counts use size_bytes"
      }
    },
    {
      "not": {
        "required": [
          "sha256"
        ],
        "$comment": "content hashes use content_digest with an algorithm prefix"
      }
    }
  ],
  "properties": {
    "blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "schema": {
      "const": "ck.schema.blob.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id",
      "description": "Owning Realm for authorization, asset privacy policy enforcement, retention and GC. MAY be omitted only for global / cross-Realm service blobs (e.g. avatar previews) explicitly authorized by the Blob Service deployment policy."
    },
    "content_digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "filename": {
      "type": "string"
    },
    "encryption": {
      "oneOf": [
        {
          "$ref": "#/$defs/encrypted_attachment"
        },
        {
          "type": "null"
        }
      ]
    },
    "thumbnail_blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "unevaluatedProperties": false
}
