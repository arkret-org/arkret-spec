{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/blob.schema.json",
  "title": "Cokret Blob Metadata",
  "type": "object",
  "required": [
    "blob_ref",
    "schema",
    "content_digest",
    "size_bytes",
    "media_type",
    "created_by",
    "created_at"
  ],
  "allOf": [
    {
      "not": {
        "required": ["size"],
        "$comment": "byte counts use size_bytes"
      }
    },
    {
      "not": {
        "required": ["sha256"],
        "$comment": "content hashes use content_digest with an algorithm prefix"
      }
    }
  ],
  "properties": {
    "blob_ref": {
      "type": "string",
      "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "schema": {
      "const": "cx.schema.blob.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^ck:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Owning Realm for authorization, asset privacy policy enforcement, retention and GC. MAY be omitted only for global / cross-Realm service blobs (e.g. avatar previews) explicitly authorized by the Blob Service deployment policy."
    },
    "content_digest": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "filename": {
      "type": "string"
    },
    "encryption": {
      "$ref": "./encrypted-envelope.schema.json"
    },
    "thumbnail_blob_ref": {
      "type": "string",
      "pattern": "^ck:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "unevaluatedProperties": false
}
