{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/blob.schema.json",
  "title": "Contrix Blob Metadata",
  "type": "object",
  "required": [
    "blob_ref",
    "schema",
    "sha256",
    "size_bytes",
    "media_type",
    "created_by",
    "created_at"
  ],
  "not": {
    "required": ["size"],
    "$comment": "byte counts use size_bytes"
  },
  "properties": {
    "blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "schema": {
      "const": "cx.schema.blob.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^cx:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Owning Realm for authorization, asset privacy policy enforcement, retention and GC. MAY be omitted only for global / cross-Realm service blobs (e.g. avatar previews) explicitly authorized by the Blob Service deployment policy."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "filename": {
      "type": "string"
    },
    "encryption": {
      "$ref": "./encrypted-envelope.schema.json"
    },
    "thumbnail_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|sha3_256|blake3):[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
