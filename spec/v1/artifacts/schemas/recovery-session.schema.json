{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/recovery-session.schema.json",
  "title": "Arkret Recovery Session",
  "description": "Wire contract for the device recovery session state machine. The root object is the recovery session state shape; request body/result helper shapes and kind-specific recovery proof transcripts live in $defs. See zh/crypto-media/device-lifecycle.md §15.",
  "$ref": "#/$defs/recovery_session_state",
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#]+#[A-Za-z0-9._:-]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url(no padding) encoding of 256 bits from a CSPRNG. The value is single-use and bound to one recovery_session_id."
    },
    "identity_model": {
      "type": "string",
      "enum": [
        "cross_signing",
        "enrollment_authority"
      ],
      "description": "A-model cross-signing or B-model external enrollment authority. Server derives and verifies this value from accepted DID/control state."
    },
    "did_version_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*-[^\\s]+$"
    },
    "recovery_policy_ref": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "session_state": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "completed",
        "rejected",
        "expired"
      ]
    },
    "proof_kind": {
      "type": "string",
      "enum": [
        "principal_signing",
        "recovery_unlock",
        "device_quorum",
        "trusted_recovery_service",
        "threshold_recovery"
      ]
    },
    "proof_summary": {
      "type": "object",
      "required": [
        "kind",
        "proof_digest"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/proof_kind"
        },
        "proof_digest": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the canonical recovery proof transcript that satisfied this session."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        }
      },
      "additionalProperties": false
    },
    "recovery_session_state": {
      "type": "object",
      "required": [
        "schema",
        "recovery_session_id",
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "policy_id",
        "policy_version",
        "identity_model",
        "challenge",
        "state",
        "expires_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.recovery_session.v1"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id",
          "description": "New device being recovered/authorized."
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "identity_model": {
          "$ref": "#/$defs/identity_model"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Accepted cross-signing generation snapshotted when the session is created. Reducers MUST reject completion if the current accepted generation no longer equals this value."
        },
        "current_device_generation_ref": {
          "$ref": "#/$defs/did_version_id",
          "description": "B-model reducer-managed generation snapshotted at session creation."
        },
        "device_generation_status": {
          "type": "string",
          "enum": [
            "active",
            "conflicted"
          ]
        },
        "registry_head": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the B-model accepted identity-registry head snapshot."
        },
        "accepted_seal_frontier": {
          "$ref": "./event-payload.schema.json#/$defs/device_reanchor_payload/properties/pre_fence_basis"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "state": {
          "$ref": "#/$defs/session_state"
        },
        "proof_summary": {
          "$ref": "#/$defs/proof_summary"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id",
          "description": "Unique durable RecoveryTransaction bound by CAS after verification. Absent until transaction create succeeds."
        },
        "rejection_reason_code": {
          "type": "string",
          "enum": [
            "proof_failed",
            "operator_rejected",
            "risk_policy",
            "superseded"
          ],
          "description": "Closed enum. proof_failed: proof verification failures reached the server policy limit; operator_rejected: explicit operator/admin rejection; risk_policy: server risk policy rejection; superseded: replaced by a newer recovery session for the same principal/device."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Session expiration. Default TTL is 900 seconds; deployments MAY shorten it and MUST NOT lengthen it unless a future recovery_policy field explicitly permits the override."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Recovery session creation/signing time. This is the created_at value used in the recovery proof transcript."
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_model": {
                "const": "cross_signing"
              }
            },
            "required": [
              "identity_model"
            ]
          },
          "then": {
            "required": [
              "ssk_generation"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "current_device_generation_ref"
                  ]
                },
                {
                  "required": [
                    "device_generation_status"
                  ]
                },
                {
                  "required": [
                    "registry_head"
                  ]
                },
                {
                  "required": [
                    "accepted_seal_frontier"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "current_device_generation_ref",
              "device_generation_status",
              "registry_head",
              "accepted_seal_frontier"
            ],
            "not": {
              "required": [
                "ssk_generation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "verified",
                  "completed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "proof_summary"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "rejection_reason_code"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "recovery_session_create_request_body": {
      "type": "object",
      "required": [
        "principal_id",
        "requesting_device_id",
        "trust_domain"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "expected_recovery_policy_ref": {
          "$ref": "#/$defs/recovery_policy_ref",
          "description": "Optional client CAS hint. Servers MUST snapshot the currently accepted policy; if this hint is present and differs, the request fails with recovery_policy_mismatch."
        }
      },
      "additionalProperties": false
    },
    "principal_signing_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "verification_method",
        "alg",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "principal_signing"
        },
        "challenge": {
          "$ref": "#/$defs/challenge",
          "description": "Echo of the server-issued session challenge. Mismatch fails as recovery_session_challenge_mismatch."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "Principal-grade DID control verification method authorized by the active recovery policy."
        },
        "alg": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "recovery_unlock_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "recovery_secret_ref",
        "verification_method",
        "alg",
        "unlock_commitment",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "recovery_unlock"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "recovery_secret_ref": {
          "type": "string",
          "minLength": 1,
          "description": "DID URL or recovery-policy key ref for the recovery key entry authorized at the session's created_at."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "alg": {
          "type": "string",
          "minLength": 1
        },
        "unlock_commitment": {
          "$ref": "#/$defs/hash",
          "description": "Public binding hash over the session transcript and recovery_secret_ref. Possession is proven by signature; this commitment prevents proof-shell substitution."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "device_quorum_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "threshold",
        "signatures"
      ],
      "properties": {
        "kind": {
          "const": "device_quorum"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "signatures": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "device_id",
              "verification_method",
              "alg",
              "signature"
            ],
            "properties": {
              "device_id": {
                "$ref": "#/$defs/device_id"
              },
              "verification_method": {
                "$ref": "#/$defs/did_url"
              },
              "alg": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trusted_recovery_service_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "service_id",
        "audience",
        "verification_method",
        "alg",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "trusted_recovery_service"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "service_id": {
          "$ref": "#/$defs/did"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "alg": {
          "type": "string",
          "minLength": 1
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to service attestation evidence when required by the active recovery policy."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "threshold_recovery_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "threshold",
        "share_releases"
      ],
      "properties": {
        "kind": {
          "const": "threshold_recovery"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "share_releases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "share_id",
              "holder",
              "transcript_digest",
              "verification_method",
              "alg",
              "signature"
            ],
            "properties": {
              "share_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "holder": {
                "$ref": "#/$defs/did"
              },
              "transcript_digest": {
                "$ref": "#/$defs/hash",
                "description": "Digest of the holder's share release transcript bound to share_id, holder, recovery_session_id, requesting_device_id, audience, and issued_at. For threshold_recovery / recovery_unlock the requesting device may be a not-yet-authorized new device; holder validation binds proof-of-possession and the recovery session instead of requiring an existing device record."
              },
              "verification_method": {
                "$ref": "#/$defs/did_url"
              },
              "alg": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "recovery_session_proof_submit_request_body": {
      "type": "object",
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "oneOf": [
            {
              "$ref": "#/$defs/principal_signing_proof"
            },
            {
              "$ref": "#/$defs/recovery_unlock_proof"
            },
            {
              "$ref": "#/$defs/device_quorum_proof"
            },
            {
              "$ref": "#/$defs/trusted_recovery_service_proof"
            },
            {
              "$ref": "#/$defs/threshold_recovery_proof"
            }
          ],
          "description": "Kind-specific recovery proof. Receivers reconstruct the canonical transcript from stored session state and the proof body, then verify that the active recovery policy allows this proof kind and its threshold/service/share constraints."
        }
      },
      "additionalProperties": false
    },
    "recovery_session_proof_submit_outcome": {
      "type": "object",
      "required": [
        "recovery_session_id",
        "state",
        "verification"
      ],
      "properties": {
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "state": {
          "const": "verified"
        },
        "verification": {
          "const": "verified"
        },
        "proof_summary": {
          "$ref": "#/$defs/proof_summary"
        }
      },
      "additionalProperties": false
    },
    "principal_signing_transcript": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "policy_id",
        "policy_version",
        "recovery_session_id",
        "identity_model",
        "model_generation_ref",
        "challenge",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "kind": {
          "const": "principal_signing"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "identity_model": {
          "$ref": "#/$defs/identity_model"
        },
        "model_generation_ref": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/did_version_id"
            }
          ],
          "description": "SSK generation for cross_signing; DID versionId for enrollment_authority."
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Session creation/signing time, not client proof creation time."
        },
        "schema": {
          "const": "ak.identity.recovery_proof.v1"
        }
      },
      "additionalProperties": false
    },
    "generic_recovery_transcript": {
      "type": "object",
      "description": "Canonical transcript field set shared by recovery_unlock, device_quorum, trusted_recovery_service, and threshold_recovery proofs before adding kind-specific proof_body. Producers and receivers MUST bind exactly this session tuple.",
      "required": [
        "schema",
        "kind",
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "policy_id",
        "policy_version",
        "recovery_session_id",
        "identity_model",
        "model_generation_ref",
        "challenge",
        "expires_at",
        "created_at",
        "proof_body"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/proof_kind"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "identity_model": {
          "$ref": "#/$defs/identity_model"
        },
        "model_generation_ref": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/did_version_id"
            }
          ]
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proof_body": {
          "type": "object",
          "description": "The selected proof object with signature bytes omitted where the kind-specific verification rule says so."
        },
        "schema": {
          "const": "ak.identity.recovery_proof.v1"
        }
      },
      "additionalProperties": false
    }
  }
}
