{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/recovery-session.schema.json",
  "title": "Arkret Recovery Session",
  "description": "Wire contract for the device recovery session state machine. The root object is the recovery session state shape; request body/result helper shapes and kind-specific recovery proof transcripts live in $defs. Completion is owned by the bound RecoveryTransaction; see zh/identity/security-transactions.md §2 and zh/crypto-media/device-lifecycle.md §14.",
  "$ref": "#/$defs/recovery_session_state",
  "$defs": {
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "policy_id": {
      "$ref": "./call-recording-artifact.schema.json#/$defs/policy_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "request_id": {
      "$ref": "./account-operations.schema.json#/$defs/request_id"
    },
    "recovery_session_id": {
      "$ref": "./key-backup-unlock-proof.schema.json#/$defs/recovery_session_id"
    },
    "transaction_id": {
      "$ref": "./recovery-authority.schema.json#/$defs/transaction_id"
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url(no padding) encoding of 256 bits from a CSPRNG. The value is single-use and bound to one recovery_session_id."
    },
    "identity_model": {
      "const": "pcr_policy",
      "description": "The v1 base recovery model: an accepted PCR recovery policy directly authorizes the next device generation. Current DID control is not implicit."
    },
    "pcr_generation_ref": {
      "$ref": "./recovery-authority.schema.json#/$defs/pcr_generation_ref"
    },
    "recovery_policy_ref": {
      "$ref": "./recovery-policy.schema.json#/$defs/recovery_policy_ref"
    },
    "session_state": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "completed",
        "rejected",
        "expired"
      ]
    },
    "proof_kind": {
      "type": "string",
      "enum": [
        "did_root",
        "recovery_unlock",
        "device_quorum",
        "trusted_recovery_service"
      ]
    },
    "proof_summary": {
      "type": "object",
      "required": [
        "kind",
        "proof_digest"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/proof_kind"
        },
        "proof_digest": {
          "$ref": "#/$defs/digest",
          "description": "Digest of the canonical recovery proof transcript that satisfied this session."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        }
      },
      "additionalProperties": false
    },
    "publication_authority_context": {
      "type": "object",
      "description": "Server-snapshotted PCR recovery authority evaluated by the current governance Station.",
      "required": [
        "authority_commit_id",
        "scope_ref",
        "authority_set_policy",
        "allowed_actions"
      ],
      "properties": {
        "authority_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "scope_ref": {
          "$ref": "./event-envelope.schema.json#/$defs/scope_ref"
        },
        "authority_set_policy": {
          "$ref": "./authority-set-policy.schema.json"
        },
        "allowed_actions": {
          "type": "array",
          "const": [
            "ak.device.reanchor"
          ]
        }
      },
      "additionalProperties": false
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "recovery_session_state": {
      "type": "object",
      "required": [
        "schema",
        "request_id",
        "recovery_session_id",
        "session_grant_id",
        "session_grant_cnf_jkt",
        "account_id",
        "requesting_device_id",
        "requesting_device_public_key_did",
        "trust_domain",
        "policy_id",
        "policy_version",
        "identity_model",
        "current_device_generation_ref",
        "device_generation_status",
        "realm_stream_head",
        "publication_authority_context",
        "publication_authority_context_digest",
        "challenge",
        "state",
        "expires_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.recovery_session.v1"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "session_grant_id": {
          "$ref": "./common-ids.schema.json#/$defs/session_grant_id",
          "description": "Exact recovery_session grant that created and owns this session."
        },
        "session_grant_cnf_jkt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Exact cnf.jkt of session_grant_id. All subsequent recovery requests and proof transcripts must use the same DPoP key."
        },
        "account_id": {
          "$ref": "#/$defs/account_id",
          "description": "Exact account authority pair frozen for the session lifetime. station_id MUST equal the authenticated server serving this recovery session."
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id",
          "description": "New device being recovered/authorized."
        },
        "requesting_device_public_key_did": {
          "$ref": "#/$defs/requesting_device_public_key_did"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "identity_model": {
          "$ref": "#/$defs/identity_model"
        },
        "current_device_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref",
          "description": "Reducer-managed PCR device generation snapshotted at session creation."
        },
        "device_generation_status": {
          "type": "string",
          "enum": [
            "active",
            "conflicted"
          ]
        },
        "realm_stream_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        },
        "publication_authority_context": {
          "$ref": "#/$defs/publication_authority_context"
        },
        "publication_authority_context_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 of JCS(publication_authority_context). Recovery proof transcripts and RecoveryTransaction session snapshots bind this exact digest."
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "state": {
          "$ref": "#/$defs/session_state"
        },
        "proof_summary": {
          "$ref": "#/$defs/proof_summary"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id",
          "description": "Unique durable RecoveryTransaction bound by CAS after verification. Absent until transaction create succeeds."
        },
        "rejection_reason_code": {
          "type": "string",
          "enum": [
            "proof_failed",
            "operator_rejected",
            "risk_policy",
            "superseded"
          ],
          "description": "Closed enum. proof_failed: proof verification failures reached the server policy limit; operator_rejected: explicit operator/admin rejection; risk_policy: server risk policy rejection; superseded: replaced by a newer recovery session for the same principal/device."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Session expiration. Default TTL is 900 seconds; deployments MAY shorten it and MUST NOT lengthen it unless a future recovery_policy field explicitly permits the override."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Recovery session creation/signing time. This is the created_at value used in the recovery proof transcript."
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "verified",
                  "completed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "proof_summary"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "rejection_reason_code"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "recovery_session_create_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "account_id",
        "requesting_device_id",
        "requesting_device_public_key_did",
        "requesting_device_signature",
        "trust_domain"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id",
          "description": "Client-stable idempotency identity. The server binds it to the presented recovery_session grant id, cnf.jkt and canonical create intent; same identity with different intent fails duplicate_conflict."
        },
        "account_id": {
          "$ref": "#/$defs/account_id",
          "description": "Required exact authority selector. The receiving server MUST require station_id to equal its own service DID and select the single lifetime PCR lineage by the complete pair; an unknown or mismatched pair fails closed."
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "requesting_device_public_key_did": {
          "$ref": "#/$defs/requesting_device_public_key_did"
        },
        "requesting_device_signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "Ed25519 proof of possession, base64url without padding. Signs UTF8(ak.identity.recovery_device_possession.v1 plus LF) concatenated with JCS(recovery_device_possession_transcript); the authenticated grant supplies session_grant_id and session_grant_cnf_jkt."
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "expected_recovery_policy_ref": {
          "$ref": "#/$defs/recovery_policy_ref",
          "description": "Optional client CAS hint. Servers MUST snapshot the currently accepted policy; if this hint is present and differs, the request fails with recovery_policy_mismatch."
        }
      },
      "additionalProperties": false
    },
    "did_root_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "did_root"
        },
        "challenge": {
          "$ref": "#/$defs/challenge",
          "description": "Echo of the server-issued session challenge. Mismatch fails as recovery_session_challenge_mismatch."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "Current DID-root verification method, accepted only when the frozen PCR recovery policy explicitly enables this revocable factor."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "recovery_unlock_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "recovery_unlock"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "Sole recovery signing-key selector. It MUST uniquely and exactly match one in-window, non-revoked recovery_unlock key entry in the session's frozen accepted policy/version."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "device_quorum_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "threshold",
        "signatures"
      ],
      "properties": {
        "kind": {
          "const": "device_quorum"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "signatures": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "device_id",
              "verification_method",
              "signature_algorithm",
              "signature"
            ],
            "properties": {
              "device_id": {
                "$ref": "#/$defs/device_id"
              },
              "verification_method": {
                "$ref": "#/$defs/did_url"
              },
              "signature_algorithm": {
                "type": "string",
                "enum": [
                  "Ed25519"
                ]
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trusted_recovery_service_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "service_id",
        "audience",
        "verification_method",
        "signature_algorithm",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "trusted_recovery_service"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "recovery_session_proof_submit_request_body": {
      "type": "object",
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "oneOf": [
            {
              "$ref": "#/$defs/did_root_proof"
            },
            {
              "$ref": "#/$defs/recovery_unlock_proof"
            },
            {
              "$ref": "#/$defs/device_quorum_proof"
            },
            {
              "$ref": "#/$defs/trusted_recovery_service_proof"
            }
          ],
          "description": "Kind-specific recovery proof. Receivers reconstruct the canonical transcript from stored session state and the proof body, then verify that the active recovery policy allows this proof kind and that the proof satisfies that entry exactly."
        }
      },
      "additionalProperties": false
    },
    "recovery_session_proof_submit_outcome": {
      "type": "object",
      "description": "Success outcome of ak.root.identity.recovery_session.command.submit_proof.v1. A 2xx reply means the proof verified and the session entered state=verified; a proof that does not verify is an error reply, so no state member is echoed.",
      "required": [
        "recovery_session_id"
      ],
      "properties": {
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "proof_summary": {
          "$ref": "#/$defs/proof_summary"
        }
      },
      "additionalProperties": false
    },
    "did_root_transcript": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "request_id",
        "session_grant_id",
        "session_grant_cnf_jkt",
        "account_id",
        "requesting_device_id",
        "requesting_device_public_key_did",
        "trust_domain",
        "policy_id",
        "policy_version",
        "recovery_session_id",
        "identity_model",
        "model_generation_ref",
        "publication_authority_context_digest",
        "challenge",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.identity.recovery_proof.v1"
        },
        "kind": {
          "const": "did_root"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "session_grant_id": {
          "$ref": "./common-ids.schema.json#/$defs/session_grant_id"
        },
        "session_grant_cnf_jkt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "requesting_device_public_key_did": {
          "$ref": "#/$defs/requesting_device_public_key_did"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "identity_model": {
          "$ref": "#/$defs/identity_model"
        },
        "model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref",
          "description": "Accepted PCR generation fenced by this recovery. DID method versioning is orthogonal."
        },
        "publication_authority_context_digest": {
          "$ref": "#/$defs/digest"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Session creation/signing time, not client proof creation time."
        }
      },
      "additionalProperties": false
    },
    "recovery_unlock_proof_body": {
      "type": "object",
      "description": "Signature-independent recovery_unlock projection. Only signature is deleted, never replaced by null, before transcript canonicalization; verification_method remains the exact frozen-policy key selector.",
      "required": [
        "kind",
        "challenge",
        "verification_method",
        "signature_algorithm"
      ],
      "properties": {
        "kind": {
          "const": "recovery_unlock"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "Sole recovery signing-key selector, bound by the transcript signature and resolved only in the session's frozen accepted policy/version."
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        }
      },
      "additionalProperties": false
    },
    "device_quorum_proof_body": {
      "type": "object",
      "description": "Signature-independent device_quorum projection. Each nested signature member is deleted while its device, key and algorithm coordinates remain bound.",
      "required": [
        "kind",
        "challenge",
        "threshold",
        "signatures"
      ],
      "properties": {
        "kind": {
          "const": "device_quorum"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "signatures": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "device_id",
              "verification_method",
              "signature_algorithm"
            ],
            "properties": {
              "device_id": {
                "$ref": "#/$defs/device_id"
              },
              "verification_method": {
                "$ref": "#/$defs/did_url"
              },
              "signature_algorithm": {
                "type": "string",
                "enum": [
                  "Ed25519"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trusted_recovery_service_proof_body": {
      "type": "object",
      "description": "Signature-independent trusted_recovery_service projection. Only the carrier signature is deleted.",
      "required": [
        "kind",
        "challenge",
        "service_id",
        "audience",
        "verification_method",
        "signature_algorithm"
      ],
      "properties": {
        "kind": {
          "const": "trusted_recovery_service"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "signature_algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        }
      },
      "additionalProperties": false
    },
    "generic_recovery_transcript": {
      "type": "object",
      "description": "Canonical transcript field set shared by recovery_unlock, device_quorum and trusted_recovery_service proofs before adding kind-specific proof_body. Producers and receivers MUST bind exactly this session tuple.",
      "required": [
        "schema",
        "kind",
        "request_id",
        "session_grant_id",
        "session_grant_cnf_jkt",
        "account_id",
        "requesting_device_id",
        "requesting_device_public_key_did",
        "trust_domain",
        "policy_id",
        "policy_version",
        "recovery_session_id",
        "identity_model",
        "model_generation_ref",
        "publication_authority_context_digest",
        "challenge",
        "expires_at",
        "created_at",
        "proof_body"
      ],
      "properties": {
        "schema": {
          "const": "ak.identity.recovery_proof.v1"
        },
        "kind": {
          "type": "string",
          "enum": [
            "recovery_unlock",
            "device_quorum",
            "trusted_recovery_service"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "session_grant_id": {
          "$ref": "./common-ids.schema.json#/$defs/session_grant_id"
        },
        "session_grant_cnf_jkt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "requesting_device_public_key_did": {
          "$ref": "#/$defs/requesting_device_public_key_did"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "identity_model": {
          "$ref": "#/$defs/identity_model"
        },
        "model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref",
          "description": "PCR-local monotonic device generation accepted for this recovery session; it is never a DID method versionId."
        },
        "publication_authority_context_digest": {
          "$ref": "#/$defs/digest"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proof_body": {
          "oneOf": [
            {
              "$ref": "#/$defs/recovery_unlock_proof_body"
            },
            {
              "$ref": "#/$defs/device_quorum_proof_body"
            },
            {
              "$ref": "#/$defs/trusted_recovery_service_proof_body"
            }
          ],
          "description": "Closed signature-independent projection selected by kind. Carrier signatures and commitments identified by the selected branch are deleted before canonicalization."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "recovery_unlock"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "proof_body": {
                "$ref": "#/$defs/recovery_unlock_proof_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "device_quorum"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "proof_body": {
                "$ref": "#/$defs/device_quorum_proof_body"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "trusted_recovery_service"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "proof_body": {
                "$ref": "#/$defs/trusted_recovery_service_proof_body"
              }
            }
          }
        }
      ]
    },
    "requesting_device_public_key_did": {
      "description": "Canonical fragmentless did:key carrying the replacement Ed25519 device identity public key. This exact value, not the DPoP grant-binding key, is frozen before factor verification and must equal replacement authorize device_public_key_did. The multicodec and 32-byte key must validate; other key kinds fail closed.",
      "$ref": "./keys-operations.schema.json#/$defs/did_key"
    },
    "recovery_device_possession_transcript": {
      "type": "object",
      "description": "Closed create-time replacement identity-key PoP transcript. Grant id/JKT come from authenticated recovery_session credentials. expected_recovery_policy_ref is included exactly when the create request includes it; absent is not null. No signature, recovery_session_id or server-issued challenge is present because this proof precedes session creation.",
      "required": [
        "schema",
        "request_id",
        "session_grant_id",
        "session_grant_cnf_jkt",
        "account_id",
        "requesting_device_id",
        "requesting_device_public_key_did",
        "trust_domain"
      ],
      "properties": {
        "schema": {
          "const": "ak.identity.recovery_device_possession.v1"
        },
        "request_id": {
          "$ref": "#/$defs/request_id",
          "description": "Client-stable idempotency identity. The server binds it to the presented recovery_session grant id, cnf.jkt and canonical create intent; same identity with different intent fails duplicate_conflict."
        },
        "session_grant_id": {
          "$ref": "./common-ids.schema.json#/$defs/session_grant_id"
        },
        "session_grant_cnf_jkt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "account_id": {
          "$ref": "#/$defs/account_id",
          "description": "Required exact authority selector. The receiving server MUST require station_id to equal its own service DID and select the single lifetime PCR lineage by the complete pair; an unknown or mismatched pair fails closed."
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "requesting_device_public_key_did": {
          "$ref": "#/$defs/requesting_device_public_key_did"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "expected_recovery_policy_ref": {
          "$ref": "#/$defs/recovery_policy_ref",
          "description": "Optional client CAS hint. Servers MUST snapshot the currently accepted policy; if this hint is present and differs, the request fails with recovery_policy_mismatch."
        }
      },
      "additionalProperties": false,
      "x-arkret-signature-domain": "ak.identity.recovery_device_possession.v1"
    }
  }
}
