{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/recovery-session.schema.json",
  "title": "Arkret Recovery Session",
  "description": "Wire contract for the device recovery session state machine. The root object is the recovery session state shape; request body/result helper shapes and kind-specific recovery proof transcripts live in $defs. See zh/crypto-media/device-lifecycle.md §15.",
  "$ref": "#/$defs/recovery_session_state",
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#]+#[A-Za-z0-9._:-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^ak:policy:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "trust_domain": {
      "$ref": "./common-ids.schema.json#/$defs/trust_domain"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url(no padding) encoding of 256 bits from a CSPRNG. The value is single-use and bound to one recovery_session_id."
    },
    "recovery_policy_ref": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "session_state": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "completed",
        "rejected",
        "expired"
      ]
    },
    "proof_kind": {
      "type": "string",
      "enum": [
        "principal_signing",
        "recovery_unlock",
        "device_quorum",
        "trusted_recovery_service",
        "threshold_recovery"
      ]
    },
    "proof_summary": {
      "type": "object",
      "required": [
        "kind",
        "proof_digest"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/proof_kind"
        },
        "proof_digest": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the canonical recovery proof transcript that satisfied this session."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        }
      },
      "additionalProperties": false
    },
    "recovery_session_state": {
      "type": "object",
      "required": [
        "schema",
        "recovery_session_id",
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "policy_id",
        "policy_version",
        "ssk_generation",
        "challenge",
        "state",
        "expires_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.recovery_session.v1"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id",
          "description": "New device being recovered/authorized."
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Accepted cross-signing generation snapshotted when the session is created. Reducers MUST reject completion if the current accepted generation no longer equals this value."
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "state": {
          "$ref": "#/$defs/session_state"
        },
        "proof_summary": {
          "$ref": "#/$defs/proof_summary"
        },
        "rejection_reason_code": {
          "type": "string",
          "enum": [
            "proof_failed",
            "operator_rejected",
            "risk_policy",
            "superseded"
          ],
          "description": "Closed enum. proof_failed: proof verification failures reached the server policy limit; operator_rejected: explicit operator/admin rejection; risk_policy: server risk policy rejection; superseded: replaced by a newer recovery session for the same principal/device."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Session expiration. Default TTL is 900 seconds; deployments MAY shorten it and MUST NOT lengthen it unless a future recovery_policy field explicitly permits the override."
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Recovery session creation/signing time. This is the created_at value used in the recovery proof transcript."
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "verified",
                  "completed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "proof_summary"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "rejection_reason_code"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "recovery_session_create_request_body": {
      "type": "object",
      "required": [
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "ssk_generation"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1
        },
        "expected_recovery_policy_ref": {
          "$ref": "#/$defs/recovery_policy_ref",
          "description": "Optional client CAS hint. Servers MUST snapshot the currently accepted policy; if this hint is present and differs, the request fails with recovery_policy_mismatch."
        }
      },
      "additionalProperties": false
    },
    "principal_signing_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "verification_method",
        "alg",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "principal_signing"
        },
        "challenge": {
          "$ref": "#/$defs/challenge",
          "description": "Echo of the server-issued session challenge. Mismatch fails as recovery_session_challenge_mismatch."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url",
          "description": "Principal-grade DID control verification method authorized by the active recovery policy."
        },
        "alg": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "recovery_unlock_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "recovery_secret_ref",
        "verification_method",
        "alg",
        "unlock_commitment",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "recovery_unlock"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "recovery_secret_ref": {
          "type": "string",
          "minLength": 1,
          "description": "DID URL or recovery-policy key ref for the recovery key entry authorized at the session's created_at."
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "alg": {
          "type": "string",
          "minLength": 1
        },
        "unlock_commitment": {
          "$ref": "#/$defs/hash",
          "description": "Public binding hash over the session transcript and recovery_secret_ref. Possession is proven by signature; this commitment prevents proof-shell substitution."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "device_quorum_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "threshold",
        "signatures"
      ],
      "properties": {
        "kind": {
          "const": "device_quorum"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "signatures": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "device_id",
              "verification_method",
              "alg",
              "signature"
            ],
            "properties": {
              "device_id": {
                "$ref": "#/$defs/device_id"
              },
              "verification_method": {
                "$ref": "#/$defs/did_url"
              },
              "alg": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trusted_recovery_service_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "service_did",
        "audience",
        "verification_method",
        "alg",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "trusted_recovery_service"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "service_did": {
          "$ref": "#/$defs/did"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "alg": {
          "type": "string",
          "minLength": 1
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to service attestation evidence when required by the active recovery policy."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "threshold_recovery_proof": {
      "type": "object",
      "required": [
        "kind",
        "challenge",
        "threshold",
        "share_releases"
      ],
      "properties": {
        "kind": {
          "const": "threshold_recovery"
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "share_releases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "share_id",
              "holder",
              "transcript_digest",
              "verification_method",
              "alg",
              "signature"
            ],
            "properties": {
              "share_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "holder": {
                "$ref": "#/$defs/did"
              },
              "transcript_digest": {
                "$ref": "#/$defs/hash",
                "description": "Digest of the holder's share release transcript bound to share_id, holder, recovery_session_id, requesting_device_id, audience, and issued_at. For threshold_recovery / recovery_unlock the requesting device may be a not-yet-authorized new device; holder validation binds proof-of-possession and the recovery session instead of requiring an existing device record."
              },
              "verification_method": {
                "$ref": "#/$defs/did_url"
              },
              "alg": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "recovery_session_proof_submit_request_body": {
      "type": "object",
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "oneOf": [
            {
              "$ref": "#/$defs/principal_signing_proof"
            },
            {
              "$ref": "#/$defs/recovery_unlock_proof"
            },
            {
              "$ref": "#/$defs/device_quorum_proof"
            },
            {
              "$ref": "#/$defs/trusted_recovery_service_proof"
            },
            {
              "$ref": "#/$defs/threshold_recovery_proof"
            }
          ],
          "description": "Kind-specific recovery proof. Receivers reconstruct the canonical transcript from stored session state and the proof body, then verify that the active recovery policy allows this proof kind and its threshold/service/share constraints."
        }
      },
      "additionalProperties": false
    },
    "recovery_session_proof_submit_outcome": {
      "type": "object",
      "required": [
        "recovery_session_id",
        "state",
        "verification"
      ],
      "properties": {
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "state": {
          "const": "verified"
        },
        "verification": {
          "const": "verified"
        },
        "proof_summary": {
          "$ref": "#/$defs/proof_summary"
        }
      },
      "additionalProperties": false
    },
    "device_authorize_material": {
      "type": "object",
      "description": "A complete, client-signed ak.device.authorize payload used by the recovery strand. It MUST also validate against event-payload.schema.json#/$defs/device_authorize_payload. The recovering client unlocks the self-signing key (SSK) from the did_recovery backup during the proof/verify phase, signs the new device's cross_signing_binding with that SSK, signs device_signature with the new device identity private key over the ck-device-authorize-possession-v1 canonical input, submits the resulting ordinary Event Envelope to the principal control stream, and passes only the accepted authorization_event_id to recovery_session_complete_request_body. The server MUST verify before completing the recovery session: (a) device_id == session.requesting_device_id; (b) recovery_session_id == this session's id; (c) principal_id == session.principal_id; (d) cross_signing_binding.ssk_generation == session.ssk_generation (else device_recovery_ssk_generation_mismatch); (e) device_signature verifies with device_public_key. Recovery is never a bootstrap-first-device case, so cross_signing_binding (not bootstrap_binding) is required.",
      "required": [
        "principal_id",
        "device_id",
        "device_public_key",
        "authorized_by",
        "not_before",
        "recovery_session_id",
        "cross_signing_binding",
        "device_signature"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_public_key": {
          "type": "string",
          "minLength": 1
        },
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "device_signature": {
          "type": "string",
          "minLength": 1,
          "description": "New-device Ed25519/EdDSA signature proving possession of the private key corresponding to device_public_key. The signing input is ck-device-authorize-possession-v1, defined in crypto-media/device-lifecycle.md §5.2. Satisfies event-payload.schema.json device_authorize_payload's proof/device_signature anyOf."
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "cross_signing_binding": {
          "type": "object",
          "required": [
            "verification_method",
            "alg",
            "ssk_generation",
            "signature"
          ],
          "properties": {
            "verification_method": {
              "$ref": "#/$defs/did_url"
            },
            "alg": {
              "type": "string",
              "minLength": 1
            },
            "ssk_generation": {
              "type": "integer",
              "minimum": 1
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_session_complete_request_body": {
      "type": "object",
      "description": "The recovering client first submits, to POST /events on the principal control realm, (1) a `ak.device.authorize` (shape per $defs/device_authorize_material, also event-payload.schema.json device_authorize_payload) whose cross_signing_binding is signed with the SSK unlocked from the did_recovery backup and whose device_signature is signed with the new device identity private key, and (2) a `ak.device.list_update` for the new device — both as ordinary signed Event Envelopes carrying the next actor_seq on the principal control stream. Completion then REFERENCES the resulting durable event ids; the server resolves each from the event store and verifies it is the right kind, bound to this recovery_session_id + requesting_device_id, that its cross_signing_binding verifies against the accepted SSK, and that its device_signature verifies against device_public_key. The server does not author/sign control events on the principal's behalf.",
      "required": [
        "authorization_event_id",
        "device_list_update_event_id"
      ],
      "properties": {
        "authorization_event_id": {
          "$ref": "#/$defs/event_id",
          "description": "event_id of the client-submitted, accepted ak.device.authorize."
        },
        "device_list_update_event_id": {
          "$ref": "#/$defs/event_id",
          "description": "event_id of the client-submitted, accepted ak.device.list_update."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "recovery_session_complete_outcome": {
      "type": "object",
      "required": [
        "ok",
        "recovery_session_id",
        "state",
        "device_id",
        "authorization_event_id",
        "device_list_update_event_id"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "state": {
          "const": "completed"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "authorization_event_id": {
          "type": "string",
          "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Accepted ak.device.authorize event emitted to the principal control stream."
        },
        "device_list_update_event_id": {
          "type": "string",
          "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Accepted ak.device.list_update event emitted to the principal control stream."
        }
      },
      "additionalProperties": false
    },
    "principal_signing_transcript": {
      "type": "object",
      "required": [
        "type",
        "kind",
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "policy_id",
        "policy_version",
        "recovery_session_id",
        "ssk_generation",
        "challenge",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "type": {
          "const": "ak.identity.recovery_proof.v1"
        },
        "kind": {
          "const": "principal_signing"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Session creation/signing time, not client proof creation time."
        }
      },
      "additionalProperties": false
    },
    "generic_recovery_transcript": {
      "type": "object",
      "description": "Canonical transcript field set shared by recovery_unlock, device_quorum, trusted_recovery_service, and threshold_recovery proofs before adding kind-specific proof_body. Producers and receivers MUST bind exactly this session tuple.",
      "required": [
        "type",
        "kind",
        "principal_id",
        "requesting_device_id",
        "trust_domain",
        "policy_id",
        "policy_version",
        "recovery_session_id",
        "ssk_generation",
        "challenge",
        "expires_at",
        "created_at",
        "proof_body"
      ],
      "properties": {
        "type": {
          "const": "ak.identity.recovery_proof.v1"
        },
        "kind": {
          "$ref": "#/$defs/proof_kind"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "requesting_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "trust_domain": {
          "$ref": "#/$defs/trust_domain"
        },
        "policy_id": {
          "$ref": "#/$defs/policy_id"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 1
        },
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "proof_body": {
          "type": "object",
          "description": "The selected proof object with signature bytes omitted where the kind-specific verification rule says so."
        }
      },
      "additionalProperties": false
    }
  }
}
