{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/read-receipt.schema.json",
  "title": "Cokret Read Receipt",
  "description": "Public/shared read receipt for Flow timeline UI hint. NOT canonical truth, NOT a multi-device cursor (see read-cursor.schema.json for that). MUST NOT generate push notifications. Privacy is governed by Realm policy: Realms MAY allow public, members-only, or actor-private receipt sharing.",
  "type": "object",
  "required": [
    "receipt_type",
    "schema",
    "realm_id",
    "actor_id",
    "read_scope",
    "event_id",
    "created_at"
  ],
  "properties": {
    "receipt_type": {
      "const": "read"
    },
    "schema": {
      "const": "cx.schema.read_receipt.v1"
    },
    "realm_id": {
      "type": "string",
      "pattern": "^ck:realm:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$",
      "description": "DID of the reader. Aligned with the rest of the spec; older drafts used 'reader' / 'actor'."
    },
    "event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the most recent Event the actor has read. Causality implies all causal predecessors are also read."
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$",
      "description": "Optional. HLC of the read position; required when Sync Service must compare receipts under merge / debounce rules across devices for the same actor."
    },
    "read_scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "flow",
            "thread",
            "view",
            "message",
            "morph"
          ],
          "description": "Same read-scope discriminator used by read-cursor.schema.json."
        },
        "ref": {
          "type": "string",
          "pattern": "^ck:(realm|flow|message|morph|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Required when kind is anything other than 'realm'. Thread read scopes reference the root message."
        },
        "track_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Required when kind='flow' and the receipt scopes a single track."
        },
        "track_scope": {
          "type": "string",
          "enum": ["all"],
          "description": "Only valid when kind='flow'. Use track_scope='all' for an entire Flow regardless of track."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "realm" }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["ref"] },
                { "required": ["track_name"] },
                { "required": ["track_scope"] }
              ]
            }
          },
          "else": {
            "required": ["ref"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "flow" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:flow:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "oneOf": [
              {
                "required": ["track_name"],
                "not": { "required": ["track_scope"] }
              },
              {
                "required": ["track_scope"],
                "properties": {
                  "track_scope": { "const": "all" }
                },
                "not": { "required": ["track_name"] }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["track_name"] },
                { "required": ["track_scope"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "thread" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "message" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "morph" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:morph:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "view" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^ck:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": false
}
