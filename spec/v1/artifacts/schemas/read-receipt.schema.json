{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/read-receipt.schema.json",
  "title": "Arkret Read Receipt Signal Plaintext",
  "description": "Closed decrypted Signal plaintext payload profile for ak.receipt.read, carried only inside ak.schema.signal_envelope.v1 with signal_class=session. It is a Strand timeline UI hint, NOT canonical truth, NOT a durable Event, and NOT a multi-device cursor (see read-cursor.schema.json for that). MUST NOT generate push notifications. Realm scope, sender identity and send time come from the enclosing signed envelope and are not duplicated here. Privacy is governed by Realm policy: Realms MAY allow public, members-only, or actor-private receipt sharing. See zh/discovery/read-receipts.md sections 2.1 / 6.2 and zh/sync/signal.md section 1.1.",
  "type": "object",
  "required": [
    "kind",
    "payload_sequence",
    "actor_id",
    "event_id",
    "read_scope"
  ],
  "properties": {
    "kind": {
      "const": "ak.receipt.read",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "read-receipt.schema.json#/properties/kind",
        "owner": "read-receipt.schema.json#/properties/kind",
        "values": [
          "ak.receipt.read"
        ]
      }
    },
    "payload_sequence": {
      "description": "Strictly increasing but non-contiguous u64 within (sender_actor_id, sender_device_id, canonical scope_ref), including the complete ActorId. Arbitrary forward gaps are accepted; a repeated or lower value is stale.",
      "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/actor_id",
      "description": "Stable did_core_id of the reader."
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$",
      "description": "ID of the most recent Event the actor has read. Causality implies all causal predecessors are also read."
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$",
      "description": "Optional. HLC of the read position; required when the Station sync surface compares receipts under merge / debounce rules across devices for the same actor."
    },
    "read_scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "strand",
            "thread",
            "view",
            "message",
            "morph"
          ],
          "description": "Read-scope discriminator from the same family as read-cursor.schema.json; each schema declares its own supported subset (receipt additionally supports view/message/morph; cursor additionally supports circle/space). kind='thread' selects the reply sub-timeline rooted at a message (zh/discovery/read-receipts.md §5); thread is a projection selector, not a first-class protocol object.",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "read-receipt.schema.json#/properties/read_scope/properties/kind",
            "owner": "read-receipt.schema.json#/properties/read_scope/properties/kind",
            "values": [
              "realm",
              "strand",
              "thread",
              "view",
              "message",
              "morph"
            ]
          }
        },
        "object_ref": {
          "type": "string",
          "pattern": "^ak:(realm|strand|message|morph|view):[A-Za-z0-9_-]{44}$",
          "description": "Required when kind is anything other than 'realm'. Thread read scopes reference the root message."
        },
        "track_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Required when kind='strand' and the receipt scopes a single track."
        },
        "track_scope": {
          "type": "string",
          "enum": [
            "all"
          ],
          "description": "Only valid when kind='strand'. Use track_scope='all' for an entire Strand regardless of track.",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "read-receipt.schema.json#/properties/read_scope/properties/track_scope",
            "owner": "read-receipt.schema.json#/properties/read_scope/properties/track_scope",
            "values": [
              "all"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "realm",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "read-receipt.schema.json#/properties/read_scope/allOf/0/if/properties/kind",
                  "owner": "read-receipt.schema.json#/properties/read_scope/allOf/0/if/properties/kind",
                  "values": [
                    "realm"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "object_ref"
                  ]
                },
                {
                  "required": [
                    "track_name"
                  ]
                },
                {
                  "required": [
                    "track_scope"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "object_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "strand",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "read-receipt.schema.json#/properties/read_scope/allOf/1/if/properties/kind",
                  "owner": "read-receipt.schema.json#/properties/read_scope/allOf/1/if/properties/kind",
                  "values": [
                    "strand"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
              }
            },
            "oneOf": [
              {
                "required": [
                  "track_name"
                ],
                "not": {
                  "required": [
                    "track_scope"
                  ]
                }
              },
              {
                "required": [
                  "track_scope"
                ],
                "properties": {
                  "track_scope": {
                    "const": "all",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "read-receipt.schema.json#/properties/read_scope/allOf/1/then/oneOf/1/properties/track_scope",
                      "owner": "read-receipt.schema.json#/properties/read_scope/allOf/1/then/oneOf/1/properties/track_scope",
                      "values": [
                        "all"
                      ]
                    }
                  }
                },
                "not": {
                  "required": [
                    "track_name"
                  ]
                }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "track_name"
                  ]
                },
                {
                  "required": [
                    "track_scope"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "thread",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "read-receipt.schema.json#/properties/read_scope/allOf/2/if/properties/kind",
                  "owner": "read-receipt.schema.json#/properties/read_scope/allOf/2/if/properties/kind",
                  "values": [
                    "thread"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:message:[A-Za-z0-9_-]{44}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "message",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "read-receipt.schema.json#/properties/read_scope/allOf/3/if/properties/kind",
                  "owner": "read-receipt.schema.json#/properties/read_scope/allOf/3/if/properties/kind",
                  "values": [
                    "message"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:message:[A-Za-z0-9_-]{44}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "morph",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "read-receipt.schema.json#/properties/read_scope/allOf/4/if/properties/kind",
                  "owner": "read-receipt.schema.json#/properties/read_scope/allOf/4/if/properties/kind",
                  "values": [
                    "morph"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:morph:[A-Za-z0-9_-]{44}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "view",
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "read-receipt.schema.json#/properties/read_scope/allOf/5/if/properties/kind",
                  "owner": "read-receipt.schema.json#/properties/read_scope/allOf/5/if/properties/kind",
                  "values": [
                    "view"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:view:[A-Za-z0-9_-]{44}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
