{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/read-receipt.schema.json",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "title": "Arkret Read Receipt",
  "description": "Public/shared read receipt for Strand timeline UI hint. NOT canonical truth, NOT a multi-device cursor (see read-cursor.schema.json for that). MUST NOT generate push notifications. Privacy is governed by Realm policy: Realms MAY allow public, members-only, or actor-private receipt sharing.",
  "type": "object",
  "required": [
    "receipt_type",
    "schema",
    "realm_id",
    "actor_id",
    "read_scope",
    "event_id",
    "created_at"
  ],
  "properties": {
    "receipt_type": {
      "const": "read"
    },
    "schema": {
      "const": "ak.schema.read_receipt.v1"
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "actor_id": {
      "$ref": "./common-ids.schema.json#/$defs/did",
      "description": "DID of the reader."
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the most recent Event the actor has read. Causality implies all causal predecessors are also read."
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$",
      "description": "Optional. HLC of the read position; required when Sync Service must compare receipts under merge / debounce rules across devices for the same actor."
    },
    "read_scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "strand",
            "thread",
            "view",
            "message",
            "morph"
          ],
          "description": "Read-scope discriminator from the same family as read-cursor.schema.json; each schema declares its own supported subset (receipt additionally supports view/message/morph; cursor additionally supports circle/space). kind='thread' selects the reply sub-timeline rooted at a message (zh/discovery/read-receipts.md §5); thread is a projection selector, not a first-class protocol object."
        },
        "object_ref": {
          "type": "string",
          "pattern": "^ak:(realm|strand|message|morph|view):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Required when kind is anything other than 'realm'. Thread read scopes reference the root message."
        },
        "track_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Required when kind='strand' and the receipt scopes a single track."
        },
        "track_scope": {
          "type": "string",
          "enum": [
            "all"
          ],
          "description": "Only valid when kind='strand'. Use track_scope='all' for an entire Strand regardless of track."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "realm"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "object_ref"
                  ]
                },
                {
                  "required": [
                    "track_name"
                  ]
                },
                {
                  "required": [
                    "track_scope"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "object_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "strand"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "oneOf": [
              {
                "required": [
                  "track_name"
                ],
                "not": {
                  "required": [
                    "track_scope"
                  ]
                }
              },
              {
                "required": [
                  "track_scope"
                ],
                "properties": {
                  "track_scope": {
                    "const": "all"
                  }
                },
                "not": {
                  "required": [
                    "track_name"
                  ]
                }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "track_name"
                  ]
                },
                {
                  "required": [
                    "track_scope"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "thread"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "message"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "morph"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:morph:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "view"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "object_ref": {
                "pattern": "^ak:view:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
