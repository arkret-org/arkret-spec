{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/service-describe.schema.json",
  "title": "Cokret Service Describe",
  "description": "Canonical service describe response returned by ck.server.query.describe and per-surface describe operations. It combines stable service metadata (service_did, service_type, protocol_version, profiles, bindings, auth, limits, plaintext visibility and rate-limit policy) with claim-level partitions: implemented_features, claimed_profiles, verified_profiles, experimental_features and compat_surfaces. The `supported_operations` field MUST list endpoint-callable operation_ids. Constraint: when `development_mode=true`, the service MUST NOT advertise any `verified_profiles` entry, and clients MUST verify the referenced verification artifacts before treating verified_profiles as production conformance. See service-surface.md §3.0.",
  "type": "object",
  "patternProperties": {
    "^x_[a-z][a-z0-9_]{0,63}$": true
  },
  "additionalProperties": false,
  "required": [
    "service_did",
    "trust_domain",
    "service_type",
    "protocol_version",
    "supported_profiles",
    "supported_operations",
    "supported_bindings",
    "supported_features",
    "auth_metadata",
    "limits",
    "plaintext_visibility",
    "implemented_features",
    "claimed_profiles",
    "verified_profiles",
    "experimental_features",
    "compat_surfaces",
    "development_mode"
  ],
  "properties": {
    "service_did": {
      "$ref": "#/$defs/did",
      "description": "DID of the service endpoint making this describe claim."
    },
    "trust_domain": {
      "$ref": "#/$defs/trust_domain",
      "description": "Deployment-scope trust domain for this service. Receivers use it as the canonical receive-context replay boundary for cross-deployment proofs and federation transactions."
    },
    "service_type": {
      "type": "string",
      "minLength": 1,
      "description": "Registered lowercase service_type such as principal_server, sync_node, directory_service, push_gateway, applet_service, archive_node, key_recovery_service or recovery_service."
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "supported_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ck\\.profile\\.[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
      },
      "uniqueItems": true
    },
    "supported_operations": {
      "type": "array",
      "description": "operation_ids that this endpoint can actually be invoked with. Element format SHOULD match the canonical operation_registry ids (e.g. `ck.self.events.command.submit`).",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "supported_bindings": {
      "type": "array",
      "description": "Transport binding declarations for this service.",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "base_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "uniqueItems": true
    },
    "supported_features": {
      "type": "array",
      "description": "Feature identifiers (`ck.feature.*`) the service supports. Distinct from profile claims.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "auth_metadata": {
      "type": "object",
      "description": "Authentication and session metadata needed by clients before calling protected operations.",
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "properties": {
        "account_authority": {
          "$ref": "#/$defs/account_authority"
        },
        "methods": {
          "type": "array",
          "description": "Authentication methods offered for this principal/account surface. Methods describe proof providers, standard discovery, and the proof kind accepted by the Account Authority. Cokret gate/account routing is always derived from account_authority.",
          "items": {
            "$ref": "#/$defs/auth_method"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "did_binding_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "oauth_issuer": {
          "type": "string",
          "format": "uri",
          "description": "Compatibility alias for legacy clients. New clients MUST use methods[].issuer."
        },
        "openid_configuration": {
          "type": "string",
          "format": "uri",
          "description": "Compatibility alias for legacy clients. New clients MUST use methods[].openid_configuration."
        },
        "supported_auth_methods": {
          "type": "array",
          "description": "Compatibility alias for legacy clients. New clients MUST use methods[].method.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "description": "Operational limits such as body size, batch size, TTL, pagination or retention bounds.",
      "properties": {
        "max_get_query_selectors": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum total selector count (`realms[]` + `actors[]`) that this service accepts on GET /_cokret/self/events. Clients SHOULD use POST /_cokret/self/events/query when the selector count exceeds this value or filters are sensitive enough to avoid URL logging. If omitted, clients use the v1 default of 8."
        }
      },
      "additionalProperties": true
    },
    "plaintext_visibility": {
      "type": "object",
      "description": "Plaintext boundary declaration. Omission is not allowed: callers use this object to decide whether the service may be registered as plaintext-visible. An empty object means the service claims no plaintext classes; Realm plaintext_visible_services entries MUST match non-empty data_classes here.",
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "additionalProperties": false,
      "properties": {
        "data_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plaintext_data_class"
          },
          "uniqueItems": true,
          "description": "Closed machine-checkable classes of plaintext or reversible derived content this service is implemented to receive."
        },
        "max_visibility": {
          "type": "string",
          "enum": [
            "none",
            "derived_plaintext",
            "private_plaintext"
          ],
          "description": "Maximum plaintext visibility class the service claims it can receive. Omitted is treated as none unless data_classes is non-empty."
        },
        "event_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "payload_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blob_purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "projection_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "privacy_derivation": {
      "type": "object",
      "description": "Machine-readable privacy-preserving identifier derivation claims. Secret material is never published here; only profile and epoch metadata needed for audit and rotation checks.",
      "properties": {
        "push_target_id": {
          "type": "object",
          "required": [
            "derivation_profile",
            "secret_scope",
            "salt_epoch_id",
            "salt_rotation_seconds"
          ],
          "properties": {
            "derivation_profile": {
              "const": "ck.push_target_id.hmac_sha256.v1"
            },
            "secret_scope": {
              "const": "per_service",
              "description": "The HMAC salt/pepper is unique to this service context and MUST NOT be shared across Principal Servers, organizations, or push routes."
            },
            "salt_epoch_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Opaque public epoch label for the active secret. This is not the secret salt value."
            },
            "salt_rotation_seconds": {
              "type": "integer",
              "minimum": 3600,
              "maximum": 2592000
            },
            "input_binding": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "recipient_service_did",
                  "principal_id",
                  "device_id",
                  "push_route_id",
                  "salt_epoch_id"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rate_limit_policy_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for a cacheable, verifiable rate-limit policy object with the same minimum fields as rate_limit_policy. See zh/sync/api-conventions.md §8."
    },
    "rate_limit_policy": {
      "type": "object",
      "description": "Inline rate-limit policy. If the service can return rate_limited, entries[] MUST expose at least endpoint or operation_id, rate_limit_scope, a window/limit tuple or a retry hint; an empty entries[] explicitly means no predictable endpoint-level rate limit beyond generic abuse protection.",
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "endpoint": {
                "type": "string",
                "minLength": 1
              },
              "operation_id": {
                "type": "string",
                "pattern": "^ck\\.[a-z0-9][a-z0-9_.-]*$"
              },
              "rate_limit_scope": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                ]
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "max_requests": {
                "type": "integer",
                "minimum": 1
              },
              "burst": {
                "type": "integer",
                "minimum": 0
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_events_per_batch": {
                "type": "integer",
                "minimum": 1
              },
              "max_body_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "retry_after_ms": {
                "type": "integer",
                "minimum": 0
              },
              "backoff_hint": {
                "type": "string",
                "minLength": 1
              },
              "next_retry_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": true
          }
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "egress_network_policy": {
      "type": "object",
      "description": "Coarse outbound-network policy for SSRF protection. Public describe MAY omit sensitive allowlist entries; authenticated operator describe MAY return the complete policy. Normative semantics are defined in zh/sync/api-conventions.md §11.2.",
      "required": [
        "version",
        "private_network_default",
        "protected_purposes",
        "dns_rebind_protection",
        "redirect_recheck"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "private_network_default": {
          "type": "string",
          "enum": [
            "deny",
            "deny_unless_explicit_exception"
          ]
        },
        "protected_purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "did_resolution",
              "federation",
              "media_fetch",
              "policy_server",
              "snapshot_fetch",
              "webhook",
              "applet",
              "agent",
              "directory",
              "push"
            ]
          },
          "uniqueItems": true
        },
        "denied_cidrs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cidr"
          },
          "uniqueItems": true
        },
        "allowed_cidrs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cidr"
          },
          "uniqueItems": true
        },
        "allowed_private_exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "purpose",
              "cidrs",
              "expires_at"
            ],
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "service_did": {
                "$ref": "#/$defs/did"
              },
              "trust_domain": {
                "$ref": "#/$defs/trust_domain"
              },
              "cidrs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/cidr"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "uniqueItems": true
              },
              "development_mode_only": {
                "type": "boolean"
              },
              "expires_at": {
                "$ref": "#/$defs/timestamp"
              }
            },
            "additionalProperties": false
          }
        },
        "dns_rebind_protection": {
          "type": "boolean"
        },
        "redirect_recheck": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "implemented_features": {
      "type": "array",
      "description": "feature_ids the service has implementation code for but does NOT necessarily claim conformance for. Tooling that builds a conformance matrix MUST treat this strictly weaker than `claimed_profiles`.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claimed_profiles": {
      "type": "array",
      "description": "Profiles the service self-claims membership in. `claim_kind` MUST be `self_claimed`; verified-only assertions belong under `verified_profiles` and MUST NOT appear here.",
      "items": {
        "type": "object",
        "required": ["profile_id", "claim_kind"],
        "additionalProperties": true,
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^ck\\.profile\\.[a-z0-9._-]+\\.v[0-9]+$"
          },
          "claim_kind": {
            "type": "string",
            "enum": ["self_claimed"]
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    },
    "verified_profiles": {
      "type": "array",
      "description": "Profiles for which a Conformance Verifier run (conformance-suite.md §6.2) has produced a passing verification artifact. Each entry MUST identify the verification run, artifact hash, artifact retrieval reference, verifier DID, verifier signature, and verification timestamp. When the service is in `development_mode=true` this array MUST be empty.",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "claim_kind",
          "verification_run_id",
          "artifact_digest",
          "artifact_ref",
          "verifier_did",
          "signature",
          "timestamp"
        ],
        "additionalProperties": true,
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^ck\\.profile\\.[a-z0-9._-]+\\.v[0-9]+$"
          },
          "claim_kind": {
            "type": "string",
            "enum": ["conformance_verified"]
          },
          "verification_run_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1,
            "description": "URI or transparency-log reference from which the verification artifact can be fetched."
          },
          "verifier_did": {
            "type": "string",
            "pattern": "^did:",
            "description": "DID of the Conformance Verifier that signed the artifact statement."
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "description": "Signature over profile_id, verification_run_id, artifact_digest, artifact_ref, verifier and timestamp."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "uniqueItems": true
    },
    "experimental_features": {
      "type": "array",
      "description": "feature_ids that the service exposes but explicitly does NOT promise stable interop for. Clients MUST treat these as non-load-bearing for protocol-level decisions.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "compat_surfaces": {
      "type": "array",
      "description": "External-interop surfaces this service exposes outside its claimed Cokret v1 conformance.",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "matrix_passthrough",
              "mimi_passthrough",
              "external_interop"
            ]
          },
          "since": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    },
    "development_mode": {
      "type": "boolean",
      "description": "Mirror of the service's development_mode flag. When true, `verified_profiles` MUST be empty."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "development_mode": { "const": true }
        },
        "required": ["development_mode"]
      },
      "then": {
        "properties": {
          "verified_profiles": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_type": {
            "const": "push_gateway"
          }
        },
        "required": [
          "service_type"
        ]
      },
      "then": {
        "required": [
          "privacy_derivation"
        ],
        "properties": {
          "privacy_derivation": {
            "required": [
              "push_target_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service_type": {
            "const": "principal_server"
          }
        },
        "required": [
          "service_type"
        ]
      },
      "then": {
        "properties": {
          "auth_metadata": {
            "required": [
              "account_authority",
              "methods"
            ]
          }
        }
      }
    }
  ],
  "anyOf": [
    {
      "required": ["rate_limit_policy"]
    },
    {
      "required": ["rate_limit_policy_id"]
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "trust_domain": {
      "type": "string",
      "pattern": "^ck:trust_domain:[a-z0-9][a-z0-9._\\-:]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cidr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "IPv4 or IPv6 CIDR string. Parsability and address-family semantics are enforced by the egress policy evaluator."
    },
    "account_authority": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "required": [
        "origin",
        "gate_account_base"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri",
          "description": "Absolute origin of the client-visible Account Authority."
        },
        "gate_account_base": {
          "type": "string",
          "format": "uri",
          "pattern": "/_cokret/gate/account/?$",
          "description": "Absolute base URL from which all client-visible /_cokret/gate/account/* endpoints MUST be derived."
        }
      }
    },
    "auth_method": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method",
        "grant_exchange"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "oidc",
            "passkey",
            "device_pairing",
            "recovery_challenge",
            "gnap"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "provider": {
          "type": "string",
          "format": "uri"
        },
        "openid_configuration": {
          "type": "string",
          "format": "uri"
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "grant_exchange": {
          "$ref": "#/$defs/auth_grant_exchange"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "oidc"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "issuer",
              "openid_configuration",
              "client_id"
            ],
            "properties": {
              "grant_exchange": {
                "properties": {
                  "proof_kind": {
                    "const": "oidc_code_exchange"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "passkey"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "grant_exchange": {
                "properties": {
                  "proof_kind": {
                    "const": "passkey_assertion"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "auth_grant_exchange": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[a-z][a-z0-9_]{0,63}$": true
      },
      "required": [
        "proof_kind"
      ],
      "properties": {
        "proof_kind": {
          "type": "string",
          "enum": [
            "did_bound_signature",
            "paired_device_proof",
            "passkey_assertion",
            "oidc_code_exchange",
            "agent_key_proof"
          ]
        }
      }
    },
    "plaintext_data_class": {
      "type": "string",
      "enum": [
        "message_content",
        "strand_content",
        "attachment_plaintext",
        "attachment_preview",
        "thumbnail",
        "full_text_index",
        "search_snippet",
        "embedding",
        "notification_summary",
        "inbox_preview",
        "media_plaintext",
        "derived_plaintext",
        "account_private_state",
        "profile_private_field"
      ]
    }
  }
}
