          "$ref": "#/$defs/agent_participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/agent_participation"
        },
        "ceiling": {
          "$ref": "#/$defs/agent_participation"
        },
        "effective": {
          "$ref": "#/$defs/agent_participation"
        }
      },
