        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "track_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message_id": {
          "$ref": "#/$defs/message_id"
        },
        "relation_id": {
          "$ref": "#/$defs/relation_id"
        }
