{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/agent-operations.schema.json",
  "title": "Arkret Account Pairing and Agent Operation DTOs",
  "description": "Closed request and response DTOs for account pairing and native personal agent management operations.",
  "oneOf": [
    {
      "$ref": "#/$defs/account_device_pair_request_body"
    },
    {
      "$ref": "#/$defs/account_device_pair_outcome"
    },
    {
      "$ref": "#/$defs/agent_key_pair_request_body"
    },
    {
      "$ref": "#/$defs/agent_key_pair_outcome"
    },
    {
      "$ref": "#/$defs/agent_runtime_approval_request_body"
    },
    {
      "$ref": "#/$defs/agent_runtime_approval_outcome"
    },
    {
      "$ref": "#/$defs/agent_runtime_approval_status_request_body"
    },
    {
      "$ref": "#/$defs/agent_runtime_approval_status_outcome"
    },
    {
      "$ref": "#/$defs/agent_provision_request_body"
    },
    {
      "$ref": "#/$defs/agent_provision_outcome"
    },
    {
      "$ref": "#/$defs/agent_renew_pairing_outcome"
    },
    {
      "$ref": "#/$defs/agent_pairing_bootstrap"
    },
    {
      "$ref": "#/$defs/agent_pairing_resolve_request_body"
    },
    {
      "$ref": "#/$defs/agent_list"
    },
    {
      "$ref": "#/$defs/agent_view"
    },
    {
      "$ref": "#/$defs/agent_pause_request_body"
    },
    {
      "$ref": "#/$defs/agent_lifecycle_state"
    },
    {
      "$ref": "#/$defs/agent_resume_request_body"
    },
    {
      "$ref": "#/$defs/agent_deactivate_request_body"
    },
    {
      "$ref": "#/$defs/agent_grant_attach_request_body"
    },
    {
      "$ref": "#/$defs/agent_grant_attach_outcome"
    },
    {
      "$ref": "#/$defs/agent_grant_detach_outcome"
    },
    {
      "$ref": "#/$defs/agent_sidecar_thread_ensure_request_body"
    },
    {
      "$ref": "#/$defs/agent_sidecar_thread_ensure_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^ak:blob:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:sha256|blake3):[0-9a-f]{64})$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_id": {
      "type": "string",
      "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^ak:grant:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^ak:relation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^ak:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "agent_slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "description": "Required controller-scoped native personal agent selector slug. Used only as the right-hand component of @<controller-handle>/<agent_slug>; not a global handle or authorization subject. Provisioning services MUST issue or update a ak.schema.agent_selector_claim.v1."
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "opaque_local_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Deployment-local short-lived account/auth artifact id. It is not a ak:<kind> protocol object id."
    },
    "proof": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "public_key": {
      "type": "object",
      "required": [
        "kty",
        "kid",
        "alg",
        "key"
      ],
      "properties": {
        "kty": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kid": {
          "$ref": "#/$defs/non_empty_string"
        },
        "alg": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key": {
          "$ref": "#/$defs/base64url"
        },
        "key_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "device_metadata": {
      "type": "object",
      "properties": {
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "platform": {
          "$ref": "#/$defs/non_empty_string"
        },
        "app_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "app_version": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_status": {
      "type": "string",
      "enum": [
        "pending_runtime_key",
        "active",
        "pairing_expired",
        "paused",
        "deactivated"
      ]
    },
    "agent_projection": {
      "type": "object",
      "required": [
        "agent_id",
        "slug",
        "status"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "slug": {
          "$ref": "#/$defs/agent_slug"
        },
        "avatar_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "grant_snapshot": {
      "type": "object",
      "required": [
        "grant_id"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/grant_id"
        },
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "grant_digest": {
          "$ref": "#/$defs/hash"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "key_state": {
      "type": "object",
      "required": [
        "agent_id",
        "controller_id",
        "principal_control_realm_id",
        "controller_authorization_ref",
        "status",
        "pcr_recovery",
        "requested_scope",
        "requested_scope_digest"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "controller_id": {
          "$ref": "#/$defs/did"
        },
        "principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "controller_authorization_ref": {
          "$ref": "#/$defs/did_url"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        },
        "pcr_recovery": {
          "$ref": "#/$defs/agent_pcr_recovery_state"
        },
        "requested_scope": {
          "$ref": "#/$defs/agent_key_scope",
          "description": "Controller-private projection of the required immutable global Agent key/session ceiling captured at provision time, not a grant. Content actions are the maximum actions that later key scopes, Realm-scoped grants, participation or sessions may allow; an omitted action cannot be added later. Provisioning never materializes content grants from this field. Operation/service resources constrain the service surface; explicit content resource selectors only further narrow later grants. Receiver authority comes from a valid agent-requested-scope-disclosure whose digest matches the accepted-at Agent DID commitment, not this service projection."
        },
        "requested_scope_digest": {
          "$ref": "#/$defs/hash",
          "description": "sha256 digest of the domain-separated Agent requested_scope commitment fixed in the accepted Agent DID ArkretPrincipalControlRealm service entry; the public entry does not contain the complete scope."
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pairing_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approval_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pending_runtime_key_request": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "approval_requested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "active_authorizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent_key_authorization_state"
          }
        }
      },
      "additionalProperties": false
    },
    "agent_pcr_recovery_state": {
      "type": "object",
      "description": "Controller-visible recovery readiness for the managed Agent Principal Control Realm. pending means no accepted controller-owned managed-PCR backup exists; ready means the current controller recovery policy and Agent PCR sealed MLS frontier are covered by the active mls_history series tail; stale means an older backup exists but no longer covers the current policy, delegation, Seal frontier, or MLS epoch. Runtime pairing commits require ready at the pre-commit frontier; the accepted key-authorization Event then advances the frontier and makes this projection stale until a post-commit backup tail is accepted.",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "stale"
          ]
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "series_seq": {
          "type": "integer",
          "minimum": 0
        },
        "managed_frontier_ref": {
          "$ref": "./key-backup.schema.json#/$defs/managed_frontier_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ready",
                  "stale"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "backup_id",
              "series_id",
              "series_seq",
              "managed_frontier_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "backup_id"
                  ]
                },
                {
                  "required": [
                    "series_id"
                  ]
                },
                {
                  "required": [
                    "series_seq"
                  ]
                },
                {
                  "required": [
                    "managed_frontier_ref"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "agent_key_authorization_state": {
      "type": "object",
      "required": [
        "key_id",
        "verification_method",
        "authorized_event_ref"
      ],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "runtime_attestation": {
      "$ref": "./event-payload.schema.json#/$defs/agent_key_authorize_payload/properties/runtime_attestation"
    },
    "agent_key_scope": {
      "$ref": "./event-payload.schema.json#/$defs/agent_key_scope"
    },
    "sidecar_exposure_ack": {
      "$ref": "./event-payload.schema.json#/$defs/agent_sidecar_exposure_ack"
    },
    "operation_status_outcome": {
      "type": "object",
      "required": [
        "ok",
        "status"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        }
      },
      "additionalProperties": false
    },
    "account_device_pair_request_body": {
      "type": "object",
      "required": [
        "pairing_code",
        "new_device_pubkey",
        "challenge_signature"
      ],
      "properties": {
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "new_device_pubkey": {
          "$ref": "#/$defs/public_key"
        },
        "challenge_signature": {
          "$ref": "#/$defs/base64url"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "device_metadata": {
          "$ref": "#/$defs/device_metadata"
        }
      },
      "additionalProperties": false
    },
    "account_device_pair_outcome": {
      "type": "object",
      "required": [
        "device_id",
        "authorized_event_ref"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "device_grant": {
          "$ref": "#/$defs/grant_snapshot"
        },
        "key_backup_hint": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "account_device_enroll_request_body": {
      "type": "object",
      "description": "Request to the account-authority enrollment service to mint a `service_attested` ak.device.authorize for the calling session's own device (device-lifecycle.md §5.4, key-management.md §5.0.6). Used for the bootstrap / first-device path under the managed-DID model, where no existing device can approve via device-pair.",
      "required": [
        "device_id",
        "device_public_key",
        "hpke_key",
        "algorithms",
        "actor_seq"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_public_key": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            }
          ],
          "description": "This session's device public key as a did:key multibase string (z6Mk…) or base64."
        },
        "hpke_key": {
          "$ref": "#/$defs/non_empty_string",
          "description": "This device’s HPKE sealing public key (multibase). Enters ak.device.authorize.payload.hpke_key verbatim and is covered by the enrollment-authority Event proof (device-lifecycle.md §5.4)."
        },
        "algorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "description": "Canonical (UTF-8 bytewise sorted, deduplicated) algorithm ids the device supports. Enters ak.device.authorize.payload.algorithms verbatim (device-lifecycle.md §5.2/§5.4)."
        },
        "actor_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Next actor_seq on the principal control stream (highest accepted + 1), observed by the client."
        },
        "bootstrap_create_event_id": {
          "$ref": "#/$defs/event_id",
          "description": "Event id of the root-signed ak.realm.create that immediately precedes the authority-signed authorize in the atomic first-device bootstrap unit. REQUIRED when actor_seq is 1 and MUST be omitted otherwise; the authority copies it as the authorize Event's sole prev_refs entry."
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor_seq": {
                "const": 1
              }
            },
            "required": [
              "actor_seq"
            ]
          },
          "then": {
            "required": [
              "bootstrap_create_event_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "bootstrap_create_event_id"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "account_device_enroll_outcome": {
      "type": "object",
      "description": "The signed `service_attested` ak.device.authorize Event for the requested device. The account authority does not contact the Principal Server; the caller submits `authorized_event` verbatim to POST /_arkret/self/events.",
      "required": [
        "principal_id",
        "device_id",
        "authority_did",
        "authorized_event"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "authority_did": {
          "$ref": "#/$defs/did",
          "description": "Enrollment authority DID (= executed_by / enrollment_authority_binding.authority_did)."
        },
        "authorized_event": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Fully-signed ak.device.authorize Event envelope, carrying enrollment_authority_binding {kind: service_attested}."
        }
      },
      "additionalProperties": false
    },
    "agent_key_pair_request_body": {
      "type": "object",
      "required": [
        "pairing_request_id",
        "agent_id",
        "verification_method",
        "public_key",
        "proof_of_possession",
        "requested_scope_disclosure",
        "authorize_event"
      ],
      "properties": {
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id",
          "description": "Single-use pairing artifact id returned by agent_provision_outcome. Profile-local, short-lived and not a durable protocol object ref."
        },
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "public_key": {
          "$ref": "#/$defs/public_key"
        },
        "proof_of_possession": {
          "$ref": "#/$defs/proof"
        },
        "requested_scope_disclosure": {
          "$ref": "./agent-requested-scope-disclosure.schema.json",
          "description": "Controller-signed private disclosure addressed to the authoritative pairing verifier. The endpoint MUST consume its presentation challenge once, match agent/controller/audience, recompute the public DID commitment digest, and use the disclosed scope for the subset check. It MUST NOT copy the disclosure into authorize_event or any durable/public history."
        },
        "runtime_attestation": {
          "$ref": "#/$defs/runtime_attestation"
        },
        "authorize_event": {
          "$ref": "./event-envelope.schema.json",
          "description": "Fully-signed ak.agent.key.authorize Event envelope approved by the controller or policy engine. It MUST target the Agent Principal Control Realm, carry actor_id equal to agent_id, executed_by equal to the controller DID, authorization_ref equal to the controller delegation DID URL bound by the Agent DID Document, and a proof verification method belonging to the controller or one of its currently authorized devices. Its payload.agent_key_scope MAY be narrower than, but MUST be an actions/resources/constraints subset of, the immutable provision requested_scope; every provision constraint remains mandatory. Required so key activation never depends on an unaudited pairing side effect. authorize_event.event_id is the pair operation idempotency identity."
        }
      },
      "additionalProperties": false
    },
    "agent_key_pair_outcome": {
      "type": "object",
      "required": [
        "ok",
        "authorized_event_ref"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_request_body": {
      "type": "object",
      "description": "Runtime-to-controller pending approval request for native personal-agent key pairing. The runtime proves possession of the local key and the short pairing code; the controller still must approve by signing ak.agent.key.authorize and submitting agent_key_pair_request_body. The service computes ak.agent.runtime_key_binding.v1 from agent_id, pairing_request_id, verification_method, public-key digest and attestation digest. One open pairing_request_id has at most one pending stable binding: same-binding retry is idempotent and refreshes the full request while retaining approval/notification ids; a different binding fails with HTTP 409 agent_runtime_request_conflict without replacement.",
      "required": [
        "pairing_code",
        "pairing_request_id",
        "agent_id",
        "verification_method",
        "public_key",
        "proof_of_possession"
      ],
      "properties": {
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id",
          "description": "Single-use pairing artifact id returned by agent_provision_outcome. Profile-local, short-lived and not a durable protocol object ref."
        },
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "public_key": {
          "$ref": "#/$defs/public_key"
        },
        "proof_of_possession": {
          "$ref": "#/$defs/proof"
        },
        "runtime_attestation": {
          "$ref": "#/$defs/runtime_attestation"
        }
      },
      "additionalProperties": false
    },
    "agent_human_approval_error_details": {
      "type": "object",
      "description": "Closed error.details shape returned by ak.gate.account.command.issue_session_grant when an agent_key_proof request needs out-of-band controller approval. The enclosing ErrorEnvelope.error.code MUST be claim_required. The agent runtime MUST NOT be given CAPTCHA, OTP, browser-login, or other interactive human challenge material.",
      "required": [
        "reason_code",
        "approval_request_id"
      ],
      "properties": {
        "reason_code": {
          "const": "human_approval_required"
        },
        "approval_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_outcome": {
      "type": "object",
      "required": [
        "ok",
        "approval_request_id",
        "status"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "approval_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_status_request_body": {
      "type": "object",
      "description": "Runtime-side poll for the controller decision on a previously submitted runtime key request. The pairing_request_id, pairing_code, and agent_id triple is the query credential and MUST be sent in the JSON body, never in URL path or query string. A record miss and a pairing_code or agent_id mismatch MUST be indistinguishable (both not_found). HTTP responses MUST carry Retry-After; clients wait at least that interval and stop polling after pairing expiry.",
      "required": [
        "pairing_request_id",
        "pairing_code",
        "agent_id"
      ],
      "properties": {
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id",
          "description": "Single-use pairing artifact id returned by agent_provision_outcome. Profile-local, short-lived and not a durable protocol object ref."
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "agent_id": {
          "$ref": "#/$defs/did"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_status_outcome": {
      "type": "object",
      "description": "Controller-decision status for an agent runtime key pairing request. While the pairing is still open, status is pending_runtime_key and approval_request_id echoes the pending request, if any. Once the controller has approved, status reflects the agent lifecycle state and authorized_event_ref plus the authorized key binding fields are present; the runtime MUST compare authorized_public_key_digest against its own key and treat a mismatch as paired-by-another-runtime, not as its own approval. An open pairing whose pairing_expires_at has passed is reported as pairing_expired.",
      "required": [
        "ok",
        "status"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        },
        "approval_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "authorized_verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "authorized_public_key_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "agent_provision_request_body": {
      "type": "object",
      "description": "Creates an Agent principal with a required immutable requested_scope global ceiling. Provisioning emits only controller-owned accountability and selector facts; it never creates an Agent profile, key authorization or Realm capability grant.",
      "required": [
        "slug",
        "requested_scope"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "slug": {
          "$ref": "#/$defs/agent_slug"
        },
        "avatar_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "requested_scope": {
          "$ref": "#/$defs/agent_key_scope",
          "description": "Required immutable global Agent key/session ceiling, not a grant. Later key scopes, Realm grants, participation selections and session requests MAY narrow it but MUST NOT exceed its actions, resource selectors or mandatory constraints. An omitted action can never be added later. Provisioning never materializes content grants from this field. Operation/service resources constrain the service surface; explicit content resource selectors only further narrow later grants."
        },
        "accountability": {
          "type": "object",
          "additionalProperties": true
        },
        "pairing_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200000
        }
      },
      "additionalProperties": false
    },
    "agent_provision_outcome": {
      "type": "object",
      "required": [
        "agent_id",
        "principal_control_realm_id",
        "controller_authorization_ref",
        "requested_scope_digest",
        "pcr_recovery",
        "pairing_request_id",
        "expires_at"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "controller_authorization_ref": {
          "$ref": "#/$defs/did_url"
        },
        "requested_scope_digest": {
          "$ref": "#/$defs/hash",
          "description": "Digest of the complete immutable requested_scope commitment in the Agent DID accepted inception history; only this digest, not the complete scope, is public. The client MUST recompute it from its submitted scope, returned agent_id and authenticated controller DID."
        },
        "pcr_recovery": {
          "allOf": [
            {
              "$ref": "#/$defs/agent_pcr_recovery_state"
            },
            {
              "properties": {
                "status": {
                  "const": "pending"
                }
              }
            }
          ]
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_renew_pairing_request_body": {
      "type": "object",
      "description": "Re-open pairing on any non-terminal agent. The service issues a fresh one-time pairing_request_id + pairing_code; every previously issued pairing handle for the agent becomes permanently unresolvable. pending_runtime_key / pairing_expired re-open bootstrap pairing; active / paused perform runtime replacement re-pairing (existing keys stay valid until the new controller-signed authorization with an exact supersedes set is accepted atomically). deactivated rejects.",
      "properties": {
        "pairing_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200000
        }
      },
      "additionalProperties": false
    },
    "agent_renew_pairing_outcome": {
      "type": "object",
      "description": "Fresh pairing handle plus the current managed Agent PCR recovery projection. Unlike initial provisioning, pcr_recovery can already be ready or stale; pair commit still requires ready.",
      "required": [
        "agent_id",
        "principal_control_realm_id",
        "controller_authorization_ref",
        "requested_scope_digest",
        "pcr_recovery",
        "pairing_mode",
        "pairing_request_id",
        "expires_at"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "principal_control_realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "controller_authorization_ref": {
          "$ref": "#/$defs/did_url"
        },
        "requested_scope_digest": {
          "$ref": "#/$defs/hash",
          "description": "Unchanged digest of the immutable requested_scope commitment in the Agent DID binding; the complete scope remains controller-private."
        },
        "pcr_recovery": {
          "$ref": "#/$defs/agent_pcr_recovery_state"
        },
        "pairing_mode": {
          "type": "string",
          "enum": [
            "bootstrap",
            "replacement"
          ]
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_pairing_bootstrap": {
      "type": "object",
      "description": "One-time bootstrap material handed to a personal agent runtime after provisioning. This is not a session grant, capability grant or long-term secret.",
      "required": [
        "arkret_base_url",
        "service_id",
        "agent_id",
        "pairing_request_id",
        "pairing_code",
        "pairing_expires_at"
      ],
      "properties": {
        "arkret_base_url": {
          "type": "string",
          "format": "uri"
        },
        "service_id": {
          "$ref": "#/$defs/did"
        },
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pairing_expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_pairing_resolve_request_body": {
      "type": "object",
      "description": "Body-only resolver input for short agent pairing handoff links. The token is obtained from a URL fragment or equivalent out-of-band channel and MUST NOT be sent in URL path or query.",
      "required": [
        "pairing_token"
      ],
      "properties": {
        "pairing_token": {
          "type": "string",
          "minLength": 22,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "agent_list": {
      "type": "object",
      "required": [
        "agents",
        "has_more"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent_projection"
          }
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^ak:cursor:[A-Za-z0-9_-]+$"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "agent_view": {
      "type": "object",
      "required": [
        "agent",
        "status"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/agent_projection"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant_snapshot"
          }
        },
        "key_state": {
          "$ref": "#/$defs/key_state"
        }
      },
      "additionalProperties": false
    },
    "agent_pause_request_body": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_resume_request_body": {
      "type": "object",
      "properties": {
        "sidecar_exposure_ack": {
          "$ref": "#/$defs/sidecar_exposure_ack"
        }
      },
      "additionalProperties": false
    },
    "agent_deactivate_request_body": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_lifecycle_state": {
      "$ref": "#/$defs/operation_status_outcome"
    },
    "agent_grant_attach_request_body": {
      "type": "object",
      "required": [
        "grant",
        "requested_scope_disclosure"
      ],
      "properties": {
        "grant": {
          "$ref": "./capability-grant.schema.json",
          "description": "Complete signed Realm-scoped grant. In addition to JSON Schema validation, admission MUST verify its subject/issuer/Realm bindings and that every action and resource is covered by the requested_scope disclosed in the verifier-bound private sidecar; provision constraints remain mandatory. A violation fails with agent_grant_exceeds_requested_scope."
        },
        "requested_scope_disclosure": {
          "$ref": "./agent-requested-scope-disclosure.schema.json",
          "description": "Fresh, controller-signed private ceiling disclosure addressed to the grant admission verifier. It is transaction evidence only and MUST NOT be copied into the Realm-scoped grant or Event history."
        }
      },
      "additionalProperties": false
    },
    "agent_grant_attach_outcome": {
      "type": "object",
      "required": [
        "ok",
        "grant_id"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "grant_id": {
          "$ref": "#/$defs/grant_id"
        }
      },
      "additionalProperties": false
    },
    "agent_grant_detach_outcome": {
      "type": "object",
      "required": [
        "ok",
        "revoked_at"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "revoked_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_sidecar_context_ref": {
      "type": "object",
      "required": [
        "realm_id"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "track_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message_id": {
          "$ref": "#/$defs/message_id"
        },
        "relation_id": {
          "$ref": "#/$defs/relation_id"
        }
      },
      "oneOf": [
        {
          "required": [
            "strand_id"
          ],
          "not": {
            "required": [
              "relation_id"
            ]
          }
        },
        {
          "required": [
            "relation_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "strand_id"
                ]
              },
              {
                "required": [
                  "message_id"
                ]
              },
              {
                "required": [
                  "track_name"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "agent_sidecar_thread_ensure_request_body": {
      "type": "object",
      "required": [
        "controller_id",
        "context_ref"
      ],
      "properties": {
        "controller_id": {
          "$ref": "#/$defs/did"
        },
        "addressed_agent_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          },
          "uniqueItems": true
        },
        "context_ref": {
          "$ref": "#/$defs/agent_sidecar_context_ref"
        }
      },
      "additionalProperties": false
    },
    "pending_member_reconciliation_item": {
      "type": "object",
      "required": [
        "agent_id",
        "reason"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_sidecar_thread_ensure_outcome": {
      "type": "object",
      "required": [
        "ok",
        "private_circle_id",
        "private_strand_id",
        "private_relation_id"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "private_circle_id": {
          "$ref": "./common-ids.schema.json#/$defs/circle_id"
        },
        "private_strand_id": {
          "$ref": "#/$defs/strand_id"
        },
        "private_relation_id": {
          "$ref": "#/$defs/relation_id"
        },
        "pending_member_reconciliations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pending_member_reconciliation_item"
          }
        }
      },
      "additionalProperties": false
    },
    "agent_participation": {
      "type": "object",
      "description": "Native Agent participation bits. The provision-derived ceiling maps reply to ak.message.create plus ak.reaction.add, accept_third_party_mention to ak.event.read, and act_on_behalf to ak.message.create plus applicable controller-approval/accountability constraints.",
      "properties": {
        "reply": {
          "type": "boolean"
        },
        "accept_third_party_mention": {
          "type": "boolean"
        },
        "act_on_behalf": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "agent_participation_scope": {
      "type": "object",
      "required": [
        "kind",
        "realm_id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "realm",
            "circle",
            "strand"
          ]
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "circle_id": {
          "$ref": "./common-ids.schema.json#/$defs/circle_id"
        },
        "strand_id": {
          "$ref": "#/$defs/strand_id"
        }
      },
      "additionalProperties": false
    },
    "agent_participation_replace_request_body": {
      "type": "object",
      "required": [
        "participation_scope",
        "selection"
      ],
      "properties": {
        "participation_scope": {
          "$ref": "#/$defs/agent_participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/agent_participation",
          "description": "Controller selection. Every true bit MUST be allowed by both the immutable provision-derived ceiling and the deployment/Realm/Circle/Strand governance ceiling."
        }
      },
      "additionalProperties": false
    },
    "agent_participation_entry": {
      "type": "object",
      "required": [
        "participation_scope",
        "selection",
        "ceiling",
        "effective"
      ],
      "properties": {
        "participation_scope": {
          "$ref": "#/$defs/agent_participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/agent_participation"
        },
        "ceiling": {
          "$ref": "#/$defs/agent_participation",
          "description": "Effective admission ceiling after intersecting the immutable provision-derived ceiling with the deployment/Realm/Circle/Strand governance ceiling."
        },
        "effective": {
          "$ref": "#/$defs/agent_participation",
          "description": "Final participation after intersecting ceiling with controller selection."
        }
      },
      "additionalProperties": false
    },
    "agent_participation_outcome": {
      "type": "object",
      "required": [
        "ok",
        "agent_id",
        "entries"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "agent_id": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent_participation_entry"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
