{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/agent-operations.schema.json",
  "title": "Arkret Account Pairing and Agent Operation DTOs",
  "description": "Closed request and response DTOs for account pairing and native personal agent management operations.",
  "oneOf": [
    {
      "$ref": "#/$defs/account_device_pair_request_body"
    },
    {
      "$ref": "#/$defs/account_device_pair_outcome"
    },
    {
      "$ref": "#/$defs/agent_key_pair_request_body"
    },
    {
      "$ref": "#/$defs/agent_key_pair_outcome"
    },
    {
      "$ref": "#/$defs/agent_runtime_approval_request_body"
    },
    {
      "$ref": "#/$defs/agent_runtime_approval_outcome"
    },
    {
      "$ref": "#/$defs/agent_provision_request_body"
    },
    {
      "$ref": "#/$defs/agent_provision_outcome"
    },
    {
      "$ref": "#/$defs/agent_pairing_bootstrap"
    },
    {
      "$ref": "#/$defs/agent_pairing_resolve_request_body"
    },
    {
      "$ref": "#/$defs/agent_list"
    },
    {
      "$ref": "#/$defs/agent_view"
    },
    {
      "$ref": "#/$defs/agent_pause_request_body"
    },
    {
      "$ref": "#/$defs/agent_lifecycle_state"
    },
    {
      "$ref": "#/$defs/agent_resume_request_body"
    },
    {
      "$ref": "#/$defs/agent_deactivate_request_body"
    },
    {
      "$ref": "#/$defs/agent_rotate_key_request_body"
    },
    {
      "$ref": "#/$defs/agent_rotate_key_outcome"
    },
    {
      "$ref": "#/$defs/agent_grant_attach_request_body"
    },
    {
      "$ref": "#/$defs/agent_grant_attach_outcome"
    },
    {
      "$ref": "#/$defs/agent_grant_detach_outcome"
    },
    {
      "$ref": "#/$defs/agent_sidecar_thread_ensure_request_body"
    },
    {
      "$ref": "#/$defs/agent_sidecar_thread_ensure_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^ak:grant:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^ak:relation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^ak:message:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "agent_slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "description": "Controller-scoped native personal agent selector slug. Used only as the right-hand component of @<controller-handle>/<agent_slug>; not a global handle or authorization subject. Provisioning services that accept this field MUST issue or update a ck.schema.agent_selector_claim.v1."
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "opaque_local_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Deployment-local short-lived account/auth artifact id. It is not a ak:<kind> protocol object id."
    },
    "proof": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "public_key": {
      "type": "object",
      "required": [
        "kty",
        "kid",
        "alg",
        "key"
      ],
      "properties": {
        "kty": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kid": {
          "$ref": "#/$defs/non_empty_string"
        },
        "alg": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key": {
          "$ref": "#/$defs/base64url"
        },
        "key_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "device_metadata": {
      "type": "object",
      "properties": {
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "platform": {
          "$ref": "#/$defs/non_empty_string"
        },
        "app_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "app_version": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_status": {
      "type": "string",
      "enum": [
        "pending_runtime_key",
        "active",
        "pairing_expired",
        "paused",
        "deactivated"
      ]
    },
    "agent_projection": {
      "type": "object",
      "required": [
        "agent_principal_id",
        "status"
      ],
      "properties": {
        "agent_principal_id": {
          "$ref": "#/$defs/did"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "agent_slug": {
          "$ref": "#/$defs/agent_slug"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "grant_snapshot": {
      "type": "object",
      "required": [
        "grant_id"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/grant_id"
        },
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "grant_digest": {
          "$ref": "#/$defs/hash"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "key_state": {
      "type": "object",
      "required": [
        "verification_method",
        "status"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "runtime_attestation": {
      "$ref": "./event-payload.schema.json#/$defs/agent_key_authorize_payload/properties/runtime_attestation"
    },
    "agent_key_scope": {
      "$ref": "./event-payload.schema.json#/$defs/agent_key_scope"
    },
    "sidecar_exposure_ack": {
      "$ref": "./event-payload.schema.json#/$defs/agent_sidecar_exposure_ack"
    },
    "operation_status_outcome": {
      "type": "object",
      "required": [
        "ok",
        "status"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        }
      },
      "additionalProperties": false
    },
    "account_device_pair_request_body": {
      "type": "object",
      "required": [
        "pairing_code",
        "new_device_pubkey",
        "challenge_signature"
      ],
      "properties": {
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "new_device_pubkey": {
          "$ref": "#/$defs/public_key"
        },
        "challenge_signature": {
          "$ref": "#/$defs/base64url"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "device_metadata": {
          "$ref": "#/$defs/device_metadata"
        }
      },
      "additionalProperties": false
    },
    "account_device_pair_outcome": {
      "type": "object",
      "required": [
        "device_id",
        "authorized_event_ref"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "device_grant": {
          "$ref": "#/$defs/grant_snapshot"
        },
        "key_backup_hint": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "account_device_enroll_request_body": {
      "type": "object",
      "description": "Request to the account-authority enrollment service to mint a `service_attested` ck.device.authorize for the calling session's own device (device-lifecycle.md §5.4, key-management.md §5.0.6). Used for the bootstrap / first-device path under the managed-DID model, where no existing device can approve via device-pair.",
      "required": [
        "device_id",
        "device_public_key",
        "hpke_key",
        "algorithms",
        "actor_seq"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_public_key": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            }
          ],
          "description": "This session's device public key as a did:key multibase string (z6Mk…) or base64."
        },
        "hpke_key": {
          "$ref": "#/$defs/non_empty_string",
          "description": "This device’s HPKE sealing public key (multibase). Enters ck.device.authorize.payload.hpke_key verbatim and is covered by the enrollment-authority Event proof (device-lifecycle.md §5.4)."
        },
        "algorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "description": "Canonical (UTF-8 bytewise sorted, deduplicated) algorithm ids the device supports. Enters ck.device.authorize.payload.algorithms verbatim (device-lifecycle.md §5.2/§5.4)."
        },
        "actor_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Next actor_seq on the principal control stream (highest accepted + 1), observed by the client."
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "account_device_enroll_outcome": {
      "type": "object",
      "description": "The signed `service_attested` ck.device.authorize Event for the requested device. The account authority does not contact the Principal Server; the caller submits `authorized_event` verbatim to POST /_arkret/self/events.",
      "required": [
        "principal_id",
        "device_id",
        "authority_did",
        "authorized_event"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "authority_did": {
          "$ref": "#/$defs/did",
          "description": "Enrollment authority DID (= executed_by / enrollment_authority_binding.authority_did)."
        },
        "authorized_event": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Fully-signed ck.device.authorize Event envelope, carrying enrollment_authority_binding {kind: service_attested}."
        }
      },
      "additionalProperties": false
    },
    "agent_key_pair_request_body": {
      "type": "object",
      "required": [
        "pairing_request_id",
        "agent_principal_id",
        "verification_method",
        "public_key",
        "proof_of_possession",
        "authorize_event"
      ],
      "properties": {
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id",
          "description": "Single-use pairing artifact id returned by agent_provision_outcome. Profile-local, short-lived and not a durable protocol object ref."
        },
        "agent_principal_id": {
          "$ref": "#/$defs/did"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "public_key": {
          "$ref": "#/$defs/public_key"
        },
        "proof_of_possession": {
          "$ref": "#/$defs/proof"
        },
        "runtime_attestation": {
          "$ref": "#/$defs/runtime_attestation"
        },
        "authorize_event": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Fully-signed ck.agent.key.authorize Event envelope approved by the controller or policy engine. Required so key activation never depends on an unaudited pairing side effect."
        }
      },
      "additionalProperties": false
    },
    "agent_key_pair_outcome": {
      "type": "object",
      "required": [
        "ok",
        "authorized_event_ref"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_request_body": {
      "type": "object",
      "description": "Runtime-to-controller pending approval request for native personal-agent key pairing. The runtime proves possession of the local key and the short pairing code; the controller still must approve by signing ck.agent.key.authorize and submitting agent_key_pair_request_body.",
      "required": [
        "pairing_code",
        "pairing_request_id",
        "agent_principal_id",
        "verification_method",
        "public_key",
        "proof_of_possession"
      ],
      "properties": {
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id",
          "description": "Single-use pairing artifact id returned by agent_provision_outcome. Profile-local, short-lived and not a durable protocol object ref."
        },
        "agent_principal_id": {
          "$ref": "#/$defs/did"
        },
        "verification_method": {
          "$ref": "#/$defs/did_url"
        },
        "public_key": {
          "$ref": "#/$defs/public_key"
        },
        "proof_of_possession": {
          "$ref": "#/$defs/proof"
        },
        "runtime_attestation": {
          "$ref": "#/$defs/runtime_attestation"
        }
      },
      "additionalProperties": false
    },
    "agent_runtime_approval_outcome": {
      "type": "object",
      "required": [
        "ok",
        "approval_request_id",
        "status"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "approval_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        }
      },
      "additionalProperties": false
    },
    "agent_provision_request_body": {
      "type": "object",
      "properties": {
        "display_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "agent_slug": {
          "$ref": "#/$defs/agent_slug"
        },
        "requested_scope": {
          "$ref": "#/$defs/agent_key_scope"
        },
        "accountability": {
          "type": "object",
          "additionalProperties": true
        },
        "pairing_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200000
        }
      },
      "additionalProperties": false
    },
    "agent_provision_outcome": {
      "type": "object",
      "required": [
        "agent_principal_id",
        "pairing_request_id",
        "expires_at"
      ],
      "properties": {
        "agent_principal_id": {
          "$ref": "#/$defs/did"
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_pairing_bootstrap": {
      "type": "object",
      "description": "One-time bootstrap material handed to a personal agent runtime after provisioning. This is not a session grant, capability grant or long-term secret.",
      "required": [
        "arkret_base_url",
        "service_did",
        "agent_principal_id",
        "pairing_request_id",
        "pairing_code",
        "pairing_expires_at"
      ],
      "properties": {
        "arkret_base_url": {
          "type": "string",
          "format": "uri"
        },
        "service_did": {
          "$ref": "#/$defs/did"
        },
        "agent_principal_id": {
          "$ref": "#/$defs/did"
        },
        "pairing_request_id": {
          "$ref": "#/$defs/opaque_local_id"
        },
        "pairing_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pairing_expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "agent_pairing_resolve_request_body": {
      "type": "object",
      "description": "Body-only resolver input for short agent pairing handoff links. The token is obtained from a URL fragment or equivalent out-of-band channel and MUST NOT be sent in URL path or query.",
      "required": [
        "pairing_token"
      ],
      "properties": {
        "pairing_token": {
          "type": "string",
          "minLength": 22,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "agent_protocol_discover_request_body": {
      "type": "object",
      "description": "Probe the public ck.agent.endpoint registry for an agent's declared external protocol endpoints.",
      "required": [
        "agent_id"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        }
      },
      "additionalProperties": false
    },
    "agent_protocol_discover_outcome": {
      "type": "object",
      "description": "Projection of an accepted ck.agent.endpoint event (agent-protocol-interop.md §5.1); controller-private fields are not surfaced. supported_protocols is constrained to the §11 adapter registry.",
      "required": [
        "agent_id",
        "supported_protocols"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/did"
        },
        "supported_protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "a2a",
              "acp",
              "mcp_bridge",
              "http_custom"
            ]
          }
        },
        "agent_card_url": {
          "type": "string",
          "format": "uri"
        },
        "metadata_url": {
          "type": "string",
          "format": "uri"
        },
        "endpoint_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "agent_list": {
      "type": "object",
      "required": [
        "agents",
        "has_more"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent_projection"
          }
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^ak:cursor:[A-Za-z0-9_-]+$"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "agent_view": {
      "type": "object",
      "required": [
        "agent",
        "status"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/agent_projection"
        },
        "status": {
          "$ref": "#/$defs/agent_status"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant_snapshot"
          }
        },
        "key_state": {
          "$ref": "#/$defs/key_state"
        }
      },
      "additionalProperties": false
    },
    "agent_pause_request_body": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_resume_request_body": {
      "type": "object",
      "properties": {
        "sidecar_exposure_ack": {
          "$ref": "#/$defs/sidecar_exposure_ack"
        }
      },
      "additionalProperties": false
    },
    "agent_deactivate_request_body": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "agent_lifecycle_state": {
      "$ref": "#/$defs/operation_status_outcome"
    },
    "agent_rotate_key_request_body": {
      "type": "object",
      "required": [
        "replacement_key",
        "proof_of_possession"
      ],
      "properties": {
        "replacement_key": {
          "$ref": "#/$defs/public_key"
        },
        "proof_of_possession": {
          "$ref": "#/$defs/proof"
        }
      },
      "additionalProperties": false
    },
    "agent_rotate_key_outcome": {
      "type": "object",
      "required": [
        "ok",
        "authorized_event_ref"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "authorized_event_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "agent_grant_attach_request_body": {
      "type": "object",
      "required": [
        "grant"
      ],
      "properties": {
        "grant": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "agent_grant_attach_outcome": {
      "type": "object",
      "required": [
        "ok",
        "grant_id"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "grant_id": {
