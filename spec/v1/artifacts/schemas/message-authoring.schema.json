{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/message-authoring.schema.json",
  "title": "Arkret Message Authoring",
  "description": "Local SDK message intent, content and encryption binding. Ordinary messages are constructed and signed locally, then use the unified Event submission; no remote draft preparation operation exists.",
  "$defs": {
    "message_encryption_context": {
      "type": "object",
      "required": [
        "scheme",
        "effective_scope",
        "sender_domain"
      ],
      "properties": {
        "scheme": {
          "const": "mls_rfc9420",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "message-authoring.schema.json#/$defs/message_encryption_context/properties/scheme",
            "owner": "message-authoring.schema.json#/$defs/message_encryption_context/properties/scheme",
            "values": [
              "mls_rfc9420"
            ]
          }
        },
        "effective_scope": {
          "$ref": "./event-envelope.schema.json#/properties/scope_ref"
        },
        "sender_domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "message_authoring_content": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "plaintext",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "message-authoring.schema.json#/$defs/message_authoring_content/oneOf/0/properties/kind",
                "owner": "message-authoring.schema.json#/$defs/message_authoring_content/oneOf/0/properties/kind",
                "values": [
                  "plaintext"
                ]
              }
            },
            "content": {
              "$ref": "./event-payload.schema.json#/$defs/content_block"
            },
            "metadata": {
              "$ref": "./event-payload.schema.json#/$defs/message_metadata"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "encrypted_content",
            "encryption_context"
          ],
          "properties": {
            "kind": {
              "const": "mls",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "message-authoring.schema.json#/$defs/message_authoring_content/oneOf/1/properties/kind",
                "owner": "message-authoring.schema.json#/$defs/message_authoring_content/oneOf/1/properties/kind",
                "values": [
                  "mls"
                ]
              }
            },
            "encrypted_content": {
              "$ref": "./encrypted-envelope.schema.json"
            },
            "encrypted_metadata": {
              "$ref": "./encrypted-envelope.schema.json"
            },
            "encryption_context": {
              "$ref": "#/$defs/message_encryption_context"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "message_authoring_intent": {
      "type": "object",
      "required": [
        "strand_id",
        "track_name",
        "content"
      ],
      "properties": {
        "strand_id": {
          "$ref": "./event-payload.schema.json#/$defs/message_create_payload/properties/strand_id"
        },
        "track_name": {
          "const": "discussion",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "message-authoring.schema.json#/$defs/message_authoring_intent/properties/track_name",
            "owner": "message-authoring.schema.json#/$defs/message_authoring_intent/properties/track_name",
            "values": [
              "discussion"
            ]
          }
        },
        "content": {
          "$ref": "#/$defs/message_authoring_content"
        },
        "blob_refs": {
          "$ref": "./event-payload.schema.json#/$defs/message_create_payload/properties/blob_refs"
        },
        "reply_to_id": {
          "$ref": "./event-payload.schema.json#/$defs/message_create_payload/properties/reply_to_id"
        }
      },
      "additionalProperties": false
    }
  }
}
