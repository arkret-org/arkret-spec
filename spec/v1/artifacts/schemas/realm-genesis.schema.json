{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-genesis.schema.json",
  "title": "Arkret Realm Genesis",
  "type": "object",
  "required": [
    "schema",
    "purpose",
    "trust_domain",
    "schema_refs",
    "reducer_profile",
    "digest_algorithm",
    "security_class",
    "encryption_profile",
    "notary_profile",
    "notary",
    "capability_action_registry_digest"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.realm_genesis.v1"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "collaboration",
        "direct_conversation",
        "principal_control"
      ]
    },
    "genesis_salt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Canonical unpadded Base64URL encoding of exactly 32 CSPRNG octets. It distinguishes event-derived creation intents and has no replay, ordering, authorization, freshness, or winner semantics."
    },
    "founding_device_descriptor": {
      "$ref": "#/$defs/founding_device_descriptor",
      "description": "Principal Control Realm only. The identity root commits to the exact founding device material and the canonical founding authorize payload digest."
    },
    "trust_domain": {
      "$ref": "./realm.schema.json#/$defs/trust_domain"
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reducer_profile": {
      "$ref": "./realm.schema.json#/properties/reducer_profile"
    },
    "digest_algorithm": {
      "$ref": "./realm.schema.json#/properties/digest_algorithm"
    },
    "security_class": {
      "$ref": "./realm.schema.json#/properties/security_class"
    },
    "encryption_profile": {
      "$ref": "./realm.schema.json#/properties/encryption_profile"
    },
    "notary_profile": {
      "$ref": "./realm.schema.json#/properties/notary_profile"
    },
    "notary": {
      "$ref": "./realm.schema.json#/properties/notary"
    },
    "capability_action_registry_digest": {
      "$ref": "./realm.schema.json#/properties/capability_action_registry_digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "principal_control"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "not": {
          "required": [
            "genesis_salt"
          ]
        }
      },
      "else": {
        "required": [
          "genesis_salt"
        ],
        "not": {
          "required": [
            "founding_device_descriptor"
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "founding_device_descriptor": {
      "type": "object",
      "description": "Closed founding-device commitment embedded in the root-signed human Principal Control Realm genesis payload and required by pcr_genesis_unit. It is not an independent signed object. Managed Agent PCR creation uses its existing controller-authorized branch and omits this human-device descriptor.",
      "required": [
        "descriptor_version",
        "device_id",
        "device_public_key",
        "device_key_digest",
        "device_key_algorithm",
        "device_key_purpose",
        "hpke_key",
        "hpke_key_digest",
        "hpke_key_algorithm",
        "algorithms",
        "founding_authorize_payload_digest"
      ],
      "properties": {
        "descriptor_version": {
          "const": 1
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "device_public_key": {
          "type": "string",
          "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "device_key_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        },
        "device_key_algorithm": {
          "const": "Ed25519"
        },
        "device_key_purpose": {
          "const": "event_signing_and_mls_identity"
        },
        "hpke_key": {
          "type": "string",
          "minLength": 1
        },
        "hpke_key_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash"
        },
        "hpke_key_algorithm": {
          "const": "X25519"
        },
        "algorithms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "founding_authorize_payload_digest": {
          "$ref": "./event-envelope.schema.json#/$defs/hash",
          "description": "Canonical digest of the proof-free founding ak.device.authorize payload. It MUST NOT be an Event id or envelope digest."
        }
      },
      "additionalProperties": false
    }
  }
}
