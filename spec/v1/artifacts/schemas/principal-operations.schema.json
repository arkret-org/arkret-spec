          "$ref": "#/$defs/receiver_eligibility_basis"
        },
        "commit_prefixes": {
          "type": "object",
          "required": [
            "share"
          ],
          "properties": {
            "invite": {
              "$ref": "#/$defs/event_id"
            },
            "join": {
              "$ref": "#/$defs/event_id"
            },
            "remove": {
              "$ref": "#/$defs/event_id"
            },
            "share": {
              "$ref": "#/$defs/event_id"
            }
          },
