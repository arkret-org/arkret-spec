{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/principal-operations.schema.json",
  "title": "Arkret Principal Operation Carriers",
  "description": "Closed wire carriers scoped to a single principal: device bootstrap, participation replacement, history ingress contracts, KeyPackage terminal handling, Sidecar staging and the shared identifier, signature and receipt primitives those carriers reuse.",
  "oneOf": [
    {
      "$ref": "#/$defs/device_bootstrap_credential"
    },
    {
      "$ref": "#/$defs/cancel_device_bootstrap_request"
    },
    {
      "$ref": "#/$defs/cancel_device_bootstrap_outcome"
    },
    {
      "$ref": "#/$defs/standard_holder_binding"
    },
    {
      "$ref": "#/$defs/participation_replace_request"
    },
    {
      "$ref": "#/$defs/history_share_contract"
    },
    {
      "$ref": "#/$defs/causal_ingress_receipt"
    },
    {
      "$ref": "#/$defs/keypackage_terminal_command"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_request"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_outcome"
    }
  ],
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "jwk_thumbprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Unpadded base64url RFC 7638 SHA-256 JWK Thumbprint."
    },
    "bootstrap_mode": {
      "type": "string",
      "enum": [
        "founding",
        "sibling_pairing"
      ]
    },
    "device_bootstrap_transaction_state": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "cancelled",
        "expired"
      ],
      "description": "Closed durable bootstrap transaction state. No failed or implementation-private fifth state is permitted."
    },
    "device_bootstrap_transaction": {
      "type": "object",
      "description": "Durable device bootstrap transaction identity and lifecycle projection. Bearer expiry does not alter state. cancelled and expired permit exact replay only; standard promotion requires accepted.",
      "required": [
        "transaction_id",
        "mode",
        "state",
        "principal_id",
        "device_id",
        "holder_jkt",
        "canonical_request_digest",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "mode": {
          "$ref": "#/$defs/bootstrap_mode"
        },
        "state": {
          "$ref": "#/$defs/device_bootstrap_transaction_state"
        },
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "holder_jkt": {
          "$ref": "#/$defs/jwk_thumbprint"
        },
        "canonical_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "accepted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "cancelled_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expired_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "accepted"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "accepted_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "cancelled_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "expired"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "expired_at"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "bootstrap_transaction_cancelled_error_details": {
      "type": "object",
      "required": [
        "transaction_id",
        "state"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "state": {
          "const": "cancelled"
        }
      },
      "additionalProperties": false
    },
    "bootstrap_transaction_expired_error_details": {
      "type": "object",
      "required": [
        "transaction_id",
        "state"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "state": {
          "const": "expired"
        }
      },
      "additionalProperties": false
    },
    "cancel_device_bootstrap_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "transaction_id",
            "outcome_digest"
          ],
          "properties": {
            "status": {
              "const": "cancelled"
            },
            "transaction_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "outcome_digest": {
              "$ref": "#/$defs/hash"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "transaction_id",
            "expired_at",
            "outcome_digest"
          ],
          "properties": {
            "status": {
              "const": "expired"
            },
            "transaction_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "expired_at": {
              "$ref": "#/$defs/timestamp"
            },
            "outcome_digest": {
              "$ref": "#/$defs/hash"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "transaction_id",
            "retryable_error",
            "outcome_digest"
          ],
          "properties": {
            "status": {
              "const": "pending"
            },
            "transaction_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "retryable_error": {
              "type": "string",
              "enum": [
                "temporarily_unavailable",
                "proof_refresh_required",
                "dependency_pending"
              ]
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            },
            "outcome_digest": {
              "$ref": "#/$defs/hash"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cancel_device_bootstrap_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "mode",
        "canonical_request_digest",
        "idempotency_key"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "mode": {
          "$ref": "#/$defs/bootstrap_mode"
        },
        "canonical_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "additionalProperties": false
    },
    "causal_ingress_receipt": {
      "type": "object",
      "required": [
        "lease_basis",
        "event_digest",
        "qualified_ingress_id",
        "received_at",
        "ingress_frontier",
        "issuer",
        "signature"
      ],
      "properties": {
        "lease_basis": {
          "$ref": "#/$defs/hash"
        },
        "event_digest": {
          "$ref": "#/$defs/hash"
        },
        "qualified_ingress_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ingress_frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issuer": {
          "$ref": "#/$defs/did"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "circle_id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id"
    },
    "device_bootstrap_credential": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "credential_kind",
            "mode",
            "principal_id",
            "device_id",
            "device_key_digest",
            "transaction_id",
            "holder_jkt",
            "canonical_request_digest",
            "founding_batch_digest",
            "founding_event_ids",
            "allowed_operation_ids",
            "credential_expires_at",
            "bootstrap_transaction_expires_at"
          ],
          "properties": {
            "credential_kind": {
              "const": "device_bootstrap"
            },
            "mode": {
              "const": "founding"
            },
            "principal_id": {
              "$ref": "#/$defs/did"
            },
            "device_id": {
              "$ref": "#/$defs/device_id"
            },
        "device_key_digest": {
          "$ref": "#/$defs/hash",
          "description": "SHA-256 typed digest over the decoded raw 32-byte Ed25519 device public key. Hashing multibase/base64/JWK/DTO text is forbidden."
            },
            "transaction_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "holder_jkt": {
              "$ref": "#/$defs/jwk_thumbprint",
              "description": "RFC 7638 SHA-256 thumbprint of the holder public JWK. MUST equal the enclosing SessionGrant cnf.jkt byte-for-byte."
            },
        "canonical_request_digest": {
          "$ref": "#/$defs/hash",
          "description": "SHA-256 typed digest over RFC 8785/JCS of the exact closed enroll_device request after removing derived digest fields. The v1 enroll body contains no such digest fields, so the projection is the entire closed body."
            },
            "founding_batch_digest": {
              "$ref": "#/$defs/hash",
              "description": "H(ak.device-bootstrap.founding-batch.v1, {event_ids: founding_event_ids}); a pure function recomputed by issuer and verifier."
            },
            "founding_event_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/event_id"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Exact ordered founding unit Event IDs: root-signed ak.realm.create first, authority-proof-pending ak.device.authorize second. Sorting, deduplication or digest substitution is forbidden.",
              "uniqueItems": true
            },
            "allowed_operation_ids": {
              "$ref": "#/$defs/founding_allowed_operations"
            },
            "credential_expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "bootstrap_transaction_expires_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "credential_kind",
            "mode",
            "principal_id",
            "device_id",
            "device_key_digest",
            "transaction_id",
            "holder_jkt",
            "canonical_request_digest",
            "source_device_id",
            "target_device_id",
            "verification_content_kinds",
            "allowed_operation_ids",
            "credential_expires_at",
            "bootstrap_transaction_expires_at"
          ],
          "properties": {
            "credential_kind": {
              "const": "device_bootstrap"
            },
            "mode": {
              "const": "sibling_pairing"
            },
            "principal_id": {
              "$ref": "#/$defs/did"
            },
            "device_id": {
              "$ref": "#/$defs/device_id"
            },
            "device_key_digest": {
              "$ref": "#/$defs/hash"
            },
            "transaction_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "holder_jkt": {
              "$ref": "#/$defs/jwk_thumbprint",
              "description": "RFC 7638 SHA-256 thumbprint of the holder public JWK. MUST equal the enclosing SessionGrant cnf.jkt byte-for-byte."
            },
            "canonical_request_digest": {
              "$ref": "#/$defs/hash"
            },
            "source_device_id": {
              "$ref": "#/$defs/device_id"
            },
            "target_device_id": {
              "$ref": "#/$defs/device_id"
            },
            "verification_content_kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ak\\.key\\.verification\\.[a-z0-9_.-]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "allowed_operation_ids": {
              "$ref": "#/$defs/sibling_allowed_operations"
            },
            "credential_expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "bootstrap_transaction_expires_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "device_id": {
      "$ref": "./common-ids.schema.json#/$defs/device_id"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "event_id": {
      "type": "string",
"pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "founding_allowed_operations": {
      "type": "array",
      "prefixItems": [
        {
          "const": "ak.gate.account.command.enroll_device"
        },
        {
          "const": "ak.gate.account.command.cancel_device_bootstrap"
        },
        {
          "const": "ak.self.events.command.submit"
        },
        {
          "const": "ak.self.events.read.resolve"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "history_share_contract": {
      "type": "object",
      "required": [
        "t0",
        "t1",
        "t2"
      ],
      "properties": {
        "t0": {
          "$ref": "#/$defs/history_t0"
        },
        "t1": {
          "$ref": "#/$defs/history_t1"
        },
        "t2": {
          "$ref": "#/$defs/history_t2"
        }
      },
      "additionalProperties": false
    },
    "history_t0": {
      "type": "object",
      "required": [
        "visibility",
        "history_policy_ref",
        "scope_ref",
        "event_range"
      ],
      "properties": {
        "visibility": {
          "$ref": "#/$defs/history_visibility"
        },
        "history_policy_ref": {
          "$ref": "#/$defs/event_id"
        },
        "scope_ref": {
          "$ref": "#/$defs/opaque_id"
        },
        "event_range": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "to": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "history_t1": {
      "type": "object",
      "required": [
        "receiver_eligibility_basis",
        "causal_frontiers",
        "share_authority_ref"
      ],
      "properties": {
        "receiver_eligibility_basis": {
          "$ref": "#/$defs/receiver_eligibility_basis"
        },
        "causal_frontiers": {
          "type": "object",
          "required": [
            "share"
          ],
          "properties": {
            "invite": {
              "$ref": "#/$defs/event_id"
            },
            "join": {
              "$ref": "#/$defs/event_id"
            },
            "remove": {
              "$ref": "#/$defs/event_id"
            },
            "share": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        "share_authority_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "history_t2": {
      "type": "object",
      "required": [
        "verified_display_allowed",
        "controlled_cache_allowed",
        "subsequent_share_allowed",
        "current_policy_frontier"
      ],
      "properties": {
        "verified_display_allowed": {
          "type": "boolean"
        },
        "controlled_cache_allowed": {
          "type": "boolean"
        },
        "subsequent_share_allowed": {
          "type": "boolean"
        },
        "current_policy_frontier": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "history_visibility": {
      "type": "string",
      "enum": [
        "world_readable",
        "shared",
        "invited",
        "joined",
        "restricted"
      ]
    },
    "keypackage_terminal_command": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "owner_account_id",
            "keypackage_ref",
            "expected_state",
            "action",
            "idempotency_key"
          ],
          "properties": {
            "owner_account_id": {
              "$ref": "#/$defs/did"
            },
            "keypackage_ref": {
              "$ref": "#/$defs/opaque_id"
            },
            "expected_state": {
              "const": "published_unused"
            },
            "action": {
              "const": "retire"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "owner_account_id",
            "keypackage_ref",
            "expected_state",
            "claim_id",
            "action",
            "idempotency_key"
          ],
          "properties": {
            "owner_account_id": {
              "$ref": "#/$defs/did"
            },
            "keypackage_ref": {
              "$ref": "#/$defs/opaque_id"
            },
            "expected_state": {
              "const": "claimed_unconsumed"
            },
            "claim_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "action": {
              "const": "revoke"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "owner_account_id",
            "keypackage_ref",
            "expected_state",
            "action"
          ],
          "properties": {
            "owner_account_id": {
              "$ref": "#/$defs/did"
            },
            "keypackage_ref": {
              "$ref": "#/$defs/opaque_id"
            },
            "expected_state": {
              "const": "consumed"
            },
            "action": {
              "const": "no_write"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "pattern": "^ak:operation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "participation_bits": {
      "type": "object",
      "required": [
        "reply_message",
        "reaction_add",
        "reaction_remove",
        "accept_third_party_mention",
        "act_on_behalf"
      ],
      "properties": {
        "reply_message": {
          "type": "boolean"
        },
        "reaction_add": {
          "type": "boolean"
        },
        "reaction_remove": {
          "type": "boolean"
        },
        "accept_third_party_mention": {
          "type": "boolean"
        },
        "act_on_behalf": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "participation_replace_request": {
      "type": "object",
      "description": "Controller-owned full replacement of one per-scope participation selection. The authenticated Account Authority is the sole selection authority; first write uses expected_version=0 and each accepted write increments by one.",
      "required": [
        "target_scope",
        "selection",
        "expected_version"
      ],
      "properties": {
        "target_scope": {
          "$ref": "#/$defs/participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/participation_bits"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        }
      },
      "additionalProperties": false
    },
    "participation_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "receiver_eligibility_basis": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "member_ref"
          ],
          "properties": {
            "kind": {
              "const": "active_member"
            },
            "member_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "invite_ref"
          ],
          "properties": {
            "kind": {
              "const": "invited"
            },
            "invite_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "remove_ref"
          ],
          "properties": {
            "kind": {
              "const": "removed_t0_visible"
            },
            "remove_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requester_id"
          ],
          "properties": {
            "kind": {
              "const": "world_readable_requester"
            },
            "requester_id": {
              "$ref": "#/$defs/did"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "share_authority_ref"
          ],
          "properties": {
