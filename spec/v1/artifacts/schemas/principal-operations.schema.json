    "pcr_genesis_submit_response_body": {
      "type": "object",
      "required": [
        "principal_id",
        "pcr_realm_id",
        "accepted_device_id",
        "resolution",
        "commits"
      ],
      "properties": {
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "pcr_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "accepted_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/resolution_projection"
        },
        "commits": {
          "type": "array",
          "description": "Exactly two consecutive RealmCommit objects in registered unit order: realm.create then device.authorize.",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "./realm-commit.schema.json"
            },
            {
              "$ref": "./realm-commit.schema.json"
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "pcr_genesis_submit_request_body": {
      "type": "object",
      "description": "Account-Authority-to-Station relay. The outer service signature authenticates transport only; content authorization is exclusively the frozen registration anchor, the identity-root control proof and the two Event proofs. The designated method fact owner verifies the primary anchor and historical evidence; the Station admits the exact frozen unit. Within one authenticated TCB, exact verified method facts are carried through the registered channel without repeating the same method history; independent trust boundaries verify independently. Historical genesis verification never substitutes current DID resolution. Exactly one registration control proof is carried: identity_creation_control_proof with accepted_at evidence, or account_registration_control_proof with validated_at evidence. For the latter the authenticated exact owner must separately validate proof.request_canonical_digest recomputed by the fact owner from the original register body with only proof.request_canonical_digest and proof.signature omitted; the original body remains durable owner material. Both proof variants authorize the same complete ordered PCR unit and initial session, not a DID publication or a second lineage.",
      "required": [
        "account_authority_id",
        "principal_id",
        "did",
        "pcr_realm_id",
        "did_version_id",
        "control_key_digest",
        "idempotency_key",
        "registration_request_digest",
        "principal_registration_anchor",
        "registration_did_evidence",
        "genesis_unit"
      ],
      "properties": {
        "account_authority_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "did": {
          "$ref": "./common-ids.schema.json#/$defs/human_principal_did",
          "description": "Complete registration DID. The Station independently validates method evidence and requires project(did)=principal_id before accepting genesis."
        },
        "pcr_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "did_version_id": {
          "type": "string",
          "pattern": "^(?!ak:)",
          "minLength": 1,
          "description": "Adapter-derived registration versionId: the exact accepted did:webvh entry versionId. It MUST equal the value the Station re-derives from principal_registration_anchor and the same field in identity_creation_control_proof."
        },
        "control_key_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 digest of the registration root control key committed by the identity root proof: the accepted did:webvh entry's active update key."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "registration_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "principal_registration_anchor": {
          "$ref": "./principal-registration-anchor.schema.json",
          "description": "Exact frozen closed registration anchor. Its canonical digest MUST equal the selected control proof registration_anchor_digest. The responsible verifier derives did, version, history head and active root key from this primary material; same-TCB consumers carry the authenticated exact result and independently compare their own account, operation, unit and state bindings. It is historical input and MUST NOT be replaced with current resolver output."
        },
        "registration_did_evidence": {
          "$ref": "./registration-did-evidence.schema.json#/$defs/accepted_registration_did_evidence",
          "description": "Complete Account-Authority-accepted historical evidence. Its canonical digest is reverse-bound by the pcr_genesis_unit receipt."
        },
        "identity_creation_control_proof": {
          "$ref": "./account-operations.schema.json#/$defs/identity_creation_control_proof"
        },
        "genesis_unit": {
          "$ref": "#/$defs/pcr_genesis_unit"
        },
        "account_registration_control_proof": {
          "$ref": "./account-operations.schema.json#/$defs/account_registration_control_proof"
        }
      },
      "allOf": [
        {
          "$ref": "./account-operations.schema.json#/$defs/registration_anchor_control_proof_pairing"
        }
      ],
      "additionalProperties": false,
      "$comment": "The method adapter derives the canonical pinned version/entry commitment. control_key_digest serves bounded evidence consumers, and signed method transcript positions are reconstructed from the pinned entry; caller-supplied digest mirrors are rejected.",
      "oneOf": [
        {
          "required": [
            "identity_creation_control_proof"
          ],
          "not": {
            "required": [
              "account_registration_control_proof"
            ]
          },
          "properties": {
            "registration_did_evidence": {
              "$ref": "./registration-did-evidence.schema.json#/$defs/registration_did_evidence"
            }
          }
        },
        {
          "required": [
            "account_registration_control_proof"
          ],
          "not": {
            "required": [
              "identity_creation_control_proof"
            ]
          },
          "properties": {
            "registration_did_evidence": {
              "$ref": "./registration-did-evidence.schema.json#/$defs/published_registration_did_evidence"
            }
          }
        }
      ],
      "x-arkret-name-role": "request_body"
    },
    "pcr_genesis_unit": {
      "type": "object",
      "description": "Exact ordered, atomic PCR genesis unit. The first Event is identity-root signed ak.realm.create; the second is founding-device signed ak.device.authorize. Neither signer has an accepted Arkret signer projection before this unit, so neither producer proof is resolved through the ordinary device directory. The first key is resolved only from principal_registration_anchor, registration_did_evidence and the selected registration control proof; the second key is resolved only from the root-signed founding descriptor, authorize payload and unit-local candidate overlay. For the second Event proof.verification_method, the verifier parses the DID URL, requires the registered adapter to project its bare DID component to principal_id, and requires its fragment to equal device_id (the complete ak:device UUID string); constructing a DID URL by appending to did_core_id is forbidden, and did:key is not accepted for this slot. The verifier MUST NOT consult or mutate the durable device directory until every check succeeds. These Events are replayable only inside this complete unit and its accepted receipt closure, never as standalone shared-history Events. No partial acceptance is permitted.",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "ak.realm.create",
                      "x-arkret-value-ownership": {
                        "class": "namespaced_symbol",
                        "authority": "principal-operations.schema.json#/$defs/pcr_genesis_unit/properties/events/prefixItems/0/allOf/1/properties/kind",
                        "owner": "principal-operations.schema.json#/$defs/pcr_genesis_unit/properties/events/prefixItems/0/allOf/1/properties/kind",
                        "values": [
                          "ak.realm.create"
                        ]
                      }
                    },
                    "payload": {
                      "type": "object",
                      "properties": {
                        "object": {
                          "type": "object",
                          "required": [
                            "founding_device_descriptor"
                          ]
                        }
                      },
                      "required": [
                        "object"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "ak.device.authorize",
                      "x-arkret-value-ownership": {
                        "class": "namespaced_symbol",
                        "authority": "principal-operations.schema.json#/$defs/pcr_genesis_unit/properties/events/prefixItems/1/allOf/1/properties/kind",
                        "owner": "principal-operations.schema.json#/$defs/pcr_genesis_unit/properties/events/prefixItems/1/allOf/1/properties/kind",
                        "values": [
                          "ak.device.authorize"
                        ]
                      }
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "receiver_eligibility_basis": {
      "oneOf": [
        {
          "type": "object",
          "required": [
