        "acting_on_behalf_allowed"
      ],
      "properties": {
        "message_creation_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        },
        "reaction_addition_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        },
        "reaction_removal_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        },
        "third_party_mention_delivery_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        },
        "acting_on_behalf_allowed": {
          "type": "boolean",
          "x-arkret-member-role": "permission"
        }
      },
      "additionalProperties": false
    },
    "agent_participation_replace_request_body": {
      "type": "object",
      "description": "Controller-owned full replacement of one per-scope participation selection. The authenticated Account Authority is the sole selection authority; first write uses expected_version=0 and each accepted write increments by one.",
      "required": [
        "target_scope",
        "selection",
        "expected_version"
      ],
      "properties": {
        "target_scope": {
          "$ref": "#/$defs/participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/participation_bits"
        },
        "expected_version": {
          "$ref": "./decimal-integers.schema.json#/$defs/nonnegative_int64_decimal",
          "not": {
            "const": "9223372036854775807",
            "x-arkret-value-ownership": {
              "class": "decimal_text",
              "authority": "principal-operations.schema.json#/$defs/agent_participation_replace_request_body/properties/expected_version/not",
              "owner": "principal-operations.schema.json#/$defs/agent_participation_replace_request_body/properties/expected_version/not",
              "values": [
                "9223372036854775807"
              ]
            }
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "participation_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/participation_scope/oneOf/0/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/participation_scope/oneOf/0/properties/kind",
                "values": [
                  "realm"
                ]
              }
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/participation_scope/oneOf/1/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/participation_scope/oneOf/1/properties/kind",
                "values": [
                  "circle"
                ]
              }
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/participation_scope/oneOf/2/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/participation_scope/oneOf/2/properties/kind",
                "values": [
                  "strand"
                ]
              }
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            }
          },
          "additionalProperties": false
