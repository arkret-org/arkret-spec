    },
    {
      "$ref": "#/$defs/agent_sidecar_ensure_request_body"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_response_body"
    }
  ],
  "$defs": {
    "base64url": {
      "$ref": "./file-transfer.schema.json#/$defs/base64url"
    },
    "circle_id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id"
