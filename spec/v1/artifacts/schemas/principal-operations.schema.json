{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/principal-operations.schema.json",
  "title": "Arkret Principal Operation Carriers",
  "description": "Closed wire carriers scoped to a single principal: PCR genesis, participation replacement, history ingress contracts, KeyPackage terminal handling, Sidecar staging and shared primitives.",
  "oneOf": [
    {
      "$ref": "#/$defs/pcr_genesis_unit"
    },
    {
      "$ref": "#/$defs/pcr_genesis_submit_request"
    },
    {
      "$ref": "#/$defs/pcr_genesis_submit_outcome"
    },
    {
      "$ref": "#/$defs/standard_holder_binding"
    },
    {
      "$ref": "#/$defs/participation_replace_request"
    },
    {
      "$ref": "#/$defs/history_share_contract"
    },
    {
      "$ref": "#/$defs/causal_ingress_receipt"
    },
    {
      "$ref": "#/$defs/keypackage_terminal_command"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_request"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_outcome"
    }
  ],
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "causal_ingress_receipt": {
      "type": "object",
      "required": [
        "lease_basis",
        "event_digest",
        "qualified_ingress_id",
        "received_at",
        "ingress_frontier",
        "issuer",
        "signature"
      ],
      "properties": {
        "lease_basis": {
          "$ref": "#/$defs/digest"
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        },
        "qualified_ingress_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ingress_frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issuer": {
          "$ref": "#/$defs/did_core_id"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "circle_id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id"
    },
    "device_id": {
      "$ref": "./common-ids.schema.json#/$defs/device_id"
    },
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "history_share_contract": {
      "type": "object",
      "required": [
        "t0",
        "t1",
        "t2"
      ],
      "properties": {
        "t0": {
          "$ref": "#/$defs/history_t0"
        },
        "t1": {
          "$ref": "#/$defs/history_t1"
        },
        "t2": {
          "$ref": "#/$defs/history_t2"
        }
      },
      "additionalProperties": false
    },
    "history_t0": {
      "type": "object",
      "required": [
        "visibility",
        "history_policy_ref",
        "scope_ref",
        "event_range"
      ],
      "properties": {
        "visibility": {
          "$ref": "#/$defs/history_visibility"
        },
        "history_policy_ref": {
          "$ref": "#/$defs/event_id"
        },
        "scope_ref": {
          "$ref": "#/$defs/opaque_id"
        },
        "event_range": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "to": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "history_t1": {
      "type": "object",
      "required": [
        "receiver_eligibility_basis",
        "causal_frontiers",
        "share_authority_ref"
      ],
      "properties": {
        "receiver_eligibility_basis": {
          "$ref": "#/$defs/receiver_eligibility_basis"
        },
        "causal_frontiers": {
          "type": "object",
          "required": [
            "share"
          ],
          "properties": {
            "invite": {
              "$ref": "#/$defs/event_id"
            },
            "join": {
              "$ref": "#/$defs/event_id"
            },
            "remove": {
              "$ref": "#/$defs/event_id"
            },
            "share": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        "share_authority_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "history_t2": {
      "type": "object",
      "required": [
        "verified_display_allowed",
        "controlled_cache_allowed",
        "subsequent_share_allowed",
        "current_policy_frontier"
      ],
      "properties": {
        "verified_display_allowed": {
          "type": "boolean"
        },
        "controlled_cache_allowed": {
          "type": "boolean"
        },
        "subsequent_share_allowed": {
          "type": "boolean"
        },
        "current_policy_frontier": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "history_visibility": {
      "type": "string",
      "enum": [
        "world_readable",
        "shared",
        "invited",
        "joined",
        "restricted"
      ]
    },
    "keypackage_terminal_command": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "owner_account_id",
            "keypackage_ref",
            "expected_state",
            "action",
            "idempotency_key"
          ],
          "properties": {
            "owner_account_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "keypackage_ref": {
              "$ref": "#/$defs/opaque_id"
            },
            "expected_state": {
              "const": "published_unused"
            },
            "action": {
              "const": "retire"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "owner_account_id",
            "keypackage_ref",
            "expected_state",
            "claim_id",
            "action",
            "idempotency_key"
          ],
          "properties": {
            "owner_account_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "keypackage_ref": {
              "$ref": "#/$defs/opaque_id"
            },
            "expected_state": {
              "const": "claimed_unconsumed"
            },
            "claim_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "action": {
              "const": "revoke"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "owner_account_id",
            "keypackage_ref",
            "expected_state",
            "action"
          ],
          "properties": {
            "owner_account_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "keypackage_ref": {
              "$ref": "#/$defs/opaque_id"
            },
            "expected_state": {
              "const": "consumed"
            },
            "action": {
              "const": "no_write"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "pattern": "^ak:operation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "participation_bits": {
      "type": "object",
      "required": [
        "reply_message",
        "reaction_add",
        "reaction_remove",
        "accept_third_party_mention",
        "act_on_behalf"
      ],
      "properties": {
        "reply_message": {
          "type": "boolean"
        },
        "reaction_add": {
          "type": "boolean"
        },
        "reaction_remove": {
          "type": "boolean"
        },
        "accept_third_party_mention": {
          "type": "boolean"
        },
        "act_on_behalf": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "participation_replace_request": {
      "type": "object",
      "description": "Controller-owned full replacement of one per-scope participation selection. The authenticated Account Authority is the sole selection authority; first write uses expected_version=0 and each accepted write increments by one.",
      "required": [
        "target_scope",
        "selection",
        "expected_version"
      ],
      "properties": {
        "target_scope": {
          "$ref": "#/$defs/participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/participation_bits"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        }
      },
      "additionalProperties": false
    },
    "participation_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "pcr_genesis_submit_outcome": {
      "type": "object",
      "required": [
        "principal_id",
        "pcr_realm_id",
        "accepted_device_id",
        "resolution",
        "receipt"
      ],
      "properties": {
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "pcr_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "accepted_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/resolution_projection"
        },
        "receipt": {
          "$ref": "./event-batch-receipt.schema.json"
        }
      },
      "additionalProperties": false
    },
    "pcr_genesis_submit_request": {
      "type": "object",
      "description": "Account-Authority-to-Principal-Server relay. The outer service signature authenticates transport only; content authorization is exclusively the frozen registration evidence, the identity-root control proof and the two Event proofs. The Principal Server verifies registration_did_operation and registration_did_evidence without consulting current DID resolution.",
      "required": [
        "account_authority_id",
        "principal_id",
        "full_id",
        "pcr_realm_id",
        "did_version_id",
        "log_head_digest",
        "control_key_digest",
        "idempotency_key",
        "registration_request_digest",
        "registration_did_operation",
        "registration_did_evidence",
        "identity_creation_control_proof",
        "genesis_unit"
      ],
      "properties": {
        "account_authority_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "full_id": {
          "$ref": "./common-ids.schema.json#/$defs/human_principal_full_id",
          "description": "Complete registration DID. The Principal Server independently validates method evidence and requires project(full_id)=principal_id before accepting genesis."
        },
        "pcr_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "did_version_id": {
          "type": "string",
          "minLength": 1,
          "description": "Validated did:webvh inception versionId. It MUST match the same fields in identity_creation_control_proof and the accepted registry log."
        },
        "log_head_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 digest of the exact method-native DID inception log entry seen by the Account Authority and committed by the identity root proof."
        },
        "control_key_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 digest of the active inception update key committed by the identity root proof."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "registration_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "registration_did_operation": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/DidOperationSubmitRequestBody",
          "description": "Exact method-native operation accepted during registration. Its canonical digest MUST equal identity_creation_control_proof.operation_digest; it is historical verifier input and MUST NOT be replaced with current resolver output."
        },
        "registration_did_evidence": {
          "$ref": "./registration-did-evidence.schema.json#/$defs/registration_did_evidence",
          "description": "Complete Account-Authority-accepted historical evidence. Its canonical digest is reverse-bound by the pcr_genesis_unit receipt."
        },
        "identity_creation_control_proof": {
          "$ref": "./account-operations.schema.json#/$defs/identity_creation_control_proof"
        },
        "genesis_unit": {
          "$ref": "#/$defs/pcr_genesis_unit"
        }
      },
      "additionalProperties": false
    },
    "pcr_genesis_unit": {
      "type": "object",
      "description": "Exact ordered, atomic PCR genesis unit. The first Event is identity-root signed ak.realm.create; the second is founding-device signed ak.device.authorize. For the second Event proof.verification_method, the verifier parses the DID URL, requires the registered adapter to project its bare full DID component to principal_id, and requires its fragment to equal device_id (the complete ak:device UUID string); constructing a DID URL by appending to did_core_id is forbidden, and did:key is not accepted for this slot. Before the accepted device directory exists, the verifier resolves that one canonical method through a unit-local candidate overlay to the descriptor/payload device_public_key; it MUST NOT consult or mutate the durable directory until every check succeeds. No partial acceptance is permitted.",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "ak.realm.create"
                    },
                    "payload": {
                      "type": "object",
                      "properties": {
                        "object": {
                          "type": "object",
                          "required": [
                            "founding_device_descriptor"
                          ]
                        }
                      },
                      "required": [
                        "object"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "ak.device.authorize"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "receiver_eligibility_basis": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "member_ref"
          ],
          "properties": {
            "kind": {
              "const": "active_member"
            },
            "member_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "invite_ref"
          ],
          "properties": {
            "kind": {
              "const": "invited"
            },
            "invite_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "remove_ref"
          ],
          "properties": {
            "kind": {
              "const": "removed_t0_visible"
            },
            "remove_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requester_id"
          ],
          "properties": {
            "kind": {
              "const": "world_readable_requester"
            },
            "requester_id": {
              "$ref": "#/$defs/did_core_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "share_authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "shared_authorized"
            },
            "share_authority_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "policy_authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "restricted_authorized"
            },
            "policy_authority_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_context_attach_event": {
      "allOf": [
        {
          "$ref": "#/$defs/signed_event"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.sidecar.context.attach"
            }
          }
        }
      ]
    },
    "sidecar_context_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "relation_id"
          ],
          "properties": {
            "kind": {
              "const": "relation"
            },
            "relation_id": {
              "$ref": "./event-payload.schema.json#/$defs/relation_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_control_frontier": {
      "type": "object",
      "required": [
        "create_event_ref",
        "authority_refs"
      ],
      "properties": {
        "create_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          },
          "uniqueItems": true,
          "description": "Sorted ownership, Agent lifecycle, authorization, Realm participation and key-readiness refs. Circle membership and Sidecar selection refs are forbidden."
        }
      },
      "additionalProperties": false
    },
    "sidecar_create_event": {
      "allOf": [
        {
          "$ref": "#/$defs/signed_event"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.sidecar.create"
            }
          }
        }
      ]
    },
    "sidecar_ensure_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "branch",
            "operation_id",
            "reservation_handle",
            "expires_at",
            "sidecar_id",
            "create_event_id",
            "context_attach_event_id",
            "create_event_draft",
            "context_attach_event_draft"
          ],
          "properties": {
            "status": {
              "const": "prepared"
            },
            "branch": {
              "const": "new"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "sidecar_id": {
              "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
            },
            "create_event_id": {
              "$ref": "#/$defs/event_id"
            },
            "context_attach_event_id": {
              "$ref": "#/$defs/event_id"
            },
            "create_event_draft": {
              "allOf": [
                {
                  "$ref": "#/$defs/sidecar_prepared_event_draft"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "ak.sidecar.create"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            },
            "context_attach_event_draft": {
              "allOf": [
                {
                  "$ref": "#/$defs/sidecar_prepared_event_draft"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "ak.sidecar.context.attach"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "branch",
            "operation_id",
            "reservation_handle",
            "expires_at",
            "sidecar_id",
            "context_attach_event_id",
            "context_attach_event_draft"
          ],
          "properties": {
            "status": {
              "const": "prepared"
            },
            "branch": {
              "const": "existing"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "sidecar_id": {
              "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
            },
            "context_attach_event_id": {
              "$ref": "#/$defs/event_id"
            },
            "context_attach_event_draft": {
              "allOf": [
                {
                  "$ref": "#/$defs/sidecar_prepared_event_draft"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "ak.sidecar.context.attach"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "operation_id",
            "accepted_phase",
            "ok",
            "sidecar_id",
            "source_context_ref",
            "access_readiness",
            "pending_access_reconciliations"
          ],
          "properties": {
            "status": {
              "const": "accepted"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "accepted_phase": {
              "type": "string",
              "enum": [
                "commit",
                "attach"
              ]
            },
            "ok": {
              "const": true
            },
            "sidecar_id": {
              "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
            },
            "source_context_ref": {
              "$ref": "#/$defs/sidecar_context_ref"
            },
            "access_readiness": {
              "$ref": "./agent-operations.schema.json#/$defs/agent_sidecar_access_readiness"
            },
            "pending_access_reconciliations": {
              "type": "array",
              "items": {
                "$ref": "./agent-operations.schema.json#/$defs/pending_sidecar_access_reconciliation_item"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_ensure_request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "phase",
            "operation_id",
            "idempotency_key",
            "source_realm_id",
            "controller_id",
            "context_ref"
          ],
          "properties": {
            "phase": {
              "const": "prepare"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            },
            "source_realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "controller_id": {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            },
            "context_ref": {
              "$ref": "#/$defs/sidecar_context_ref"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "phase",
            "operation_id",
            "idempotency_key",
            "reservation_handle",
            "create_event",
            "context_attach_event"
          ],
          "properties": {
            "phase": {
              "const": "commit"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "create_event": {
              "$ref": "#/$defs/sidecar_create_event"
            },
            "context_attach_event": {
              "$ref": "#/$defs/sidecar_context_attach_event"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "phase",
            "operation_id",
            "idempotency_key",
            "reservation_handle",
            "context_attach_event"
          ],
          "properties": {
            "phase": {
              "const": "attach"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "context_attach_event": {
              "$ref": "#/$defs/sidecar_context_attach_event"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_prepared_event_draft": {
      "type": "object",
      "description": "Service-built canonical producer Event bytes with proofs and reducer-managed fields absent. The client MUST decode these exact bytes, add only a controller proof over event_digest, and return the resulting signed Event. The service MUST reject any other unsigned bytes or digest.",
      "required": [
        "event_id",
        "kind",
        "unsigned_event_bytes",
        "event_digest"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ak.sidecar.create",
            "ak.sidecar.context.attach"
          ]
        },
        "unsigned_event_bytes": {
          "$ref": "#/$defs/base64url"
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "sidecar_scope_ref": {
      "type": "object",
      "required": [
        "kind",
        "realm_id",
        "sidecar_id"
      ],
      "properties": {
        "kind": {
          "const": "sidecar"
        },
        "realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "sidecar_id": {
          "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "verification_method",
        "created_at",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "signed_event": {
      "$ref": "./event-envelope.schema.json"
    },
    "standard_holder_binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "device_binding"
          ],
          "properties": {
            "kind": {
              "const": "human_device"
            },
            "device_binding": {
              "$ref": "#/$defs/opaque_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "agent_id",
            "device_id",
            "agent_key_authorization_ref",
            "verification_method"
          ],
          "properties": {
            "kind": {
              "const": "agent_runtime"
            },
            "agent_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "device_id": {
              "$ref": "#/$defs/device_id"
            },
            "agent_key_authorization_ref": {
              "$ref": "#/$defs/event_id"
            },
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "strand_id": {
      "type": "string",
      "pattern": "^ak:strand:[A-Za-z0-9_-]{44}$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  }
}
