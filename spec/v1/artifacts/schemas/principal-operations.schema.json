            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "share_authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "shared_authorized",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/4/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/4/properties/kind",
                "values": [
                  "shared_authorized"
                ]
              }
            },
            "share_authority_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "policy_authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "restricted_authorized",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/5/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/5/properties/kind",
                "values": [
                  "restricted_authorized"
                ]
              }
            },
            "policy_authority_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_context_attach_event": {
      "allOf": [
        {
          "$ref": "#/$defs/signed_event"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.sidecar.context.attach",
              "x-arkret-value-ownership": {
                "class": "namespaced_symbol",
                "authority": "principal-operations.schema.json#/$defs/sidecar_context_attach_event/allOf/1/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/sidecar_context_attach_event/allOf/1/properties/kind",
                "values": [
                  "ak.sidecar.context.attach"
                ]
              }
            }
          }
        }
      ]
    },
    "sidecar_context_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "relation_id"
          ],
          "properties": {
            "kind": {
              "const": "relation",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/sidecar_context_ref/oneOf/0/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/sidecar_context_ref/oneOf/0/properties/kind",
                "values": [
