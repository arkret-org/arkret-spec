                    "kind": {
                      "const": "ak.sidecar.context.attach"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "operation_id",
            "accepted_phase",
