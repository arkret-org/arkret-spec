{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/principal-operations.schema.json",
  "title": "Arkret Principal Operation Carriers",
  "description": "Closed wire carriers scoped to a single principal: PCR genesis, participation replacement, history ingress contracts, Sidecar staging and shared primitives.",
  "oneOf": [
    {
      "$ref": "#/$defs/pcr_genesis_unit"
    },
    {
      "$ref": "#/$defs/pcr_genesis_submit_request"
    },
    {
      "$ref": "#/$defs/pcr_genesis_submit_outcome"
    },
    {
      "$ref": "#/$defs/session_grant_holder_binding"
    },
    {
      "$ref": "#/$defs/participation_replace_request"
    },
    {
      "$ref": "#/$defs/history_share_contract"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_request"
    },
    {
      "$ref": "#/$defs/sidecar_ensure_outcome"
    }
  ],
  "$defs": {
    "base64url": {
      "$ref": "./file-transfer.schema.json#/$defs/base64url"
    },
    "circle_id": {
      "$ref": "./common-ids.schema.json#/$defs/circle_id"
    },
    "device_id": {
      "$ref": "./common-ids.schema.json#/$defs/device_id"
    },
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "history_share_contract": {
      "type": "object",
      "required": [
        "t0",
        "t1",
        "t2"
      ],
      "properties": {
        "t0": {
          "$ref": "#/$defs/history_t0"
        },
        "t1": {
          "$ref": "#/$defs/history_t1"
        },
        "t2": {
          "$ref": "#/$defs/history_t2"
        }
      },
      "additionalProperties": false
    },
    "history_t0": {
      "type": "object",
      "required": [
        "visibility",
        "history_policy_ref",
        "scope_ref",
        "event_range"
      ],
      "properties": {
        "visibility": {
          "$ref": "#/$defs/history_access"
        },
        "history_policy_ref": {
          "$ref": "#/$defs/event_id"
        },
        "scope_ref": {
          "$ref": "#/$defs/opaque_id"
        },
        "event_range": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "to": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "history_t1": {
      "type": "object",
      "required": [
        "receiver_eligibility_basis",
        "commit_prefixes",
        "share_authority_ref"
      ],
      "properties": {
        "receiver_eligibility_basis": {
          "$ref": "#/$defs/receiver_eligibility_basis"
        },
        "commit_prefixes": {
          "type": "object",
          "required": [
            "share"
          ],
          "properties": {
            "invite": {
              "$ref": "#/$defs/event_id"
            },
            "join": {
              "$ref": "#/$defs/event_id"
            },
            "remove": {
              "$ref": "#/$defs/event_id"
            },
            "share": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        "share_authority_ref": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "history_t2": {
      "type": "object",
      "required": [
        "verified_display_allowed",
        "controlled_cache_allowed",
        "subsequent_share_allowed",
        "current_policy_commit_event_id"
      ],
      "properties": {
        "verified_display_allowed": {
          "type": "boolean"
        },
        "controlled_cache_allowed": {
          "type": "boolean"
        },
        "subsequent_share_allowed": {
          "type": "boolean"
        },
        "current_policy_commit_event_id": {
          "$ref": "#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "history_access": {
      "$ref": "./event-payload.schema.json#/$defs/history_access_value"
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "pattern": "^ak:operation:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "participation_bits": {
      "type": "object",
      "required": [
        "reply_message",
        "reaction_add",
        "reaction_remove",
        "accept_third_party_mention",
        "act_on_behalf"
      ],
      "properties": {
        "reply_message": {
          "type": "boolean"
        },
        "reaction_add": {
          "type": "boolean"
        },
        "reaction_remove": {
          "type": "boolean"
        },
        "accept_third_party_mention": {
          "type": "boolean"
        },
        "act_on_behalf": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "participation_replace_request": {
      "type": "object",
      "description": "Controller-owned full replacement of one per-scope participation selection. The authenticated Account Authority is the sole selection authority; first write uses expected_version=0 and each accepted write increments by one.",
      "required": [
        "target_scope",
        "selection",
        "expected_version"
      ],
      "properties": {
        "target_scope": {
          "$ref": "#/$defs/participation_scope"
        },
        "selection": {
          "$ref": "#/$defs/participation_bits"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        }
      },
      "additionalProperties": false
    },
    "participation_scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id"
          ],
          "properties": {
            "kind": {
              "const": "realm"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "circle_id"
          ],
          "properties": {
            "kind": {
              "const": "circle"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "circle_id": {
              "$ref": "#/$defs/circle_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "realm_id",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand"
            },
            "realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "pcr_genesis_submit_outcome": {
      "type": "object",
      "required": [
        "principal_id",
        "pcr_realm_id",
        "accepted_device_id",
        "resolution",
        "receipt"
      ],
      "properties": {
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "pcr_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "accepted_device_id": {
          "$ref": "#/$defs/device_id"
        },
        "resolution": {
          "$ref": "./identity-resolution.schema.json#/$defs/resolution_projection"
        },
        "receipt": {
          "$ref": "./event-batch-receipt.schema.json"
        }
      },
      "additionalProperties": false
    },
    "pcr_genesis_submit_request": {
      "type": "object",
      "x-arkret-pcr-outward-event-kinds": [
        "ak.realm.create"
      ],
      "description": "Account-Authority-to-Station relay. The outer service signature authenticates transport only; content authorization is exclusively the frozen registration anchor, the identity-root control proof and the two Event proofs. The Station verifies principal_registration_anchor and registration_did_evidence without consulting current DID resolution.",
      "required": [
        "account_authority_id",
        "principal_id",
        "did",
        "pcr_realm_id",
        "did_version_id",
        "control_key_digest",
        "idempotency_key",
        "registration_request_digest",
        "principal_registration_anchor",
        "registration_did_evidence",
        "identity_creation_control_proof",
        "genesis_unit"
      ],
      "properties": {
        "account_authority_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "did": {
          "$ref": "./common-ids.schema.json#/$defs/human_principal_did",
          "description": "Complete registration DID. The Station independently validates method evidence and requires project(did)=principal_id before accepting genesis."
        },
        "pcr_realm_id": {
          "$ref": "#/$defs/realm_id"
        },
        "did_version_id": {
          "type": "string",
          "pattern": "^(?!ak:)",
          "minLength": 1,
          "description": "Adapter-derived registration versionId: the exact accepted did:webvh entry versionId. It MUST equal the value the Station re-derives from principal_registration_anchor and the same field in identity_creation_control_proof."
        },
        "control_key_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 digest of the registration root control key committed by the identity root proof: the accepted did:webvh entry's active update key."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "registration_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "principal_registration_anchor": {
          "$ref": "./principal-registration-anchor.schema.json",
          "description": "Exact closed registration anchor accepted during registration. Its canonical digest MUST equal identity_creation_control_proof.registration_anchor_digest, the Station MUST re-derive did, did_version_id, method_history_head and the root control key from it alone, and it is historical verifier input that MUST NOT be replaced with current resolver output."
        },
        "registration_did_evidence": {
          "$ref": "./registration-did-evidence.schema.json#/$defs/registration_did_evidence",
          "description": "Complete Account-Authority-accepted historical evidence. Its canonical digest is reverse-bound by the pcr_genesis_unit receipt."
        },
        "identity_creation_control_proof": {
          "$ref": "./account-operations.schema.json#/$defs/identity_creation_control_proof"
        },
        "genesis_unit": {
          "$ref": "#/$defs/pcr_genesis_unit"
        }
      },
      "allOf": [
        {
          "$ref": "./account-operations.schema.json#/$defs/registration_anchor_control_proof_pairing"
        }
      ],
      "additionalProperties": false,
      "$comment": "The method adapter derives the canonical pinned version/entry commitment. control_key_digest serves bounded evidence consumers, and signed method transcript positions are reconstructed from the pinned entry; caller-supplied digest mirrors are rejected."
    },
    "pcr_genesis_unit": {
      "type": "object",
      "description": "Exact ordered, atomic PCR genesis unit. The first Event is identity-root signed ak.realm.create; the second is founding-device signed ak.device.authorize. Both producer proofs MUST omit signer_resolution_evidence_ref because neither signer has an accepted Arkret signer projection before this unit. The first key is resolved only from principal_registration_anchor, registration_did_evidence and identity_creation_control_proof; the second key is resolved only from the root-signed founding descriptor, authorize payload and unit-local candidate overlay. For the second Event proof.verification_method, the verifier parses the DID URL, requires the registered adapter to project its bare DID component to principal_id, and requires its fragment to equal device_id (the complete ak:device UUID string); constructing a DID URL by appending to did_core_id is forbidden, and did:key is not accepted for this slot. The verifier MUST NOT consult or mutate the durable device directory until every check succeeds. These Events are replayable only inside this complete unit and its accepted receipt closure, never as standalone shared-history Events. No partial acceptance is permitted.",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "ak.realm.create"
                    },
                    "payload": {
                      "type": "object",
                      "properties": {
                        "object": {
                          "type": "object",
                          "required": [
                            "founding_device_descriptor"
                          ]
                        }
                      },
                      "required": [
                        "object"
                      ]
                    },
                    "producer_proof": {
                      "not": {
                        "required": [
                          "signer_resolution_evidence_ref"
                        ]
                      }
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "./event-envelope.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "ak.device.authorize"
                    },
                    "producer_proof": {
                      "not": {
                        "required": [
                          "signer_resolution_evidence_ref"
                        ]
                      }
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "realm_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_id"
    },
    "receiver_eligibility_basis": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "member_ref"
          ],
          "properties": {
            "kind": {
              "const": "active_member"
            },
            "member_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "invite_ref"
          ],
          "properties": {
            "kind": {
              "const": "invited"
            },
            "invite_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "remove_ref"
          ],
          "properties": {
            "kind": {
              "const": "removed_t0_visible"
            },
            "remove_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requester_id"
          ],
          "properties": {
            "kind": {
              "const": "world_readable_requester"
            },
            "requester_id": {
              "$ref": "#/$defs/did_core_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "share_authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "shared_authorized"
            },
            "share_authority_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "policy_authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "restricted_authorized"
            },
            "policy_authority_ref": {
              "$ref": "#/$defs/event_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_context_attach_event": {
      "allOf": [
        {
          "$ref": "#/$defs/signed_event"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.sidecar.context.attach"
            }
          }
        }
      ]
    },
    "sidecar_context_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "relation_id"
          ],
          "properties": {
            "kind": {
              "const": "relation"
            },
            "relation_id": {
              "$ref": "./event-payload.schema.json#/$defs/relation_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "strand_id"
          ],
          "properties": {
            "kind": {
              "const": "strand"
            },
            "strand_id": {
              "$ref": "#/$defs/strand_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_stream_head": {
      "type": "object",
      "required": [
        "create_event_ref",
        "authority_refs"
      ],
      "properties": {
        "create_event_ref": {
          "$ref": "#/$defs/event_id"
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          },
          "uniqueItems": true,
          "description": "Sorted ownership, Agent lifecycle, authorization, Realm participation and key-readiness refs. Circle membership and Sidecar selection refs are forbidden."
        }
      },
      "additionalProperties": false
    },
    "sidecar_create_event": {
      "allOf": [
        {
          "$ref": "#/$defs/signed_event"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ak.sidecar.create"
            }
          }
        }
      ]
    },
    "sidecar_ensure_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "branch",
            "operation_id",
            "reservation_handle",
            "expires_at",
            "create_event_draft",
            "context_attach_event_draft"
          ],
          "properties": {
            "status": {
              "const": "prepared"
            },
            "branch": {
              "const": "new"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "create_event_draft": {
              "$ref": "#/$defs/prepared_event_draft"
            },
            "context_attach_event_draft": {
              "$ref": "#/$defs/prepared_event_draft"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "branch",
            "operation_id",
            "reservation_handle",
            "expires_at",
            "sidecar_id",
            "context_attach_event_draft"
          ],
          "properties": {
            "status": {
              "const": "prepared"
            },
            "branch": {
              "const": "existing"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "expires_at": {
              "$ref": "#/$defs/timestamp"
            },
            "sidecar_id": {
              "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
            },
            "context_attach_event_draft": {
              "$ref": "#/$defs/prepared_event_draft"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "operation_id",
            "accepted_phase",
            "sidecar_id",
            "source_context_ref",
            "access_readiness",
            "pending_access_reconciliations"
          ],
          "properties": {
            "status": {
              "const": "accepted"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "accepted_phase": {
              "type": "string",
              "enum": [
                "commit",
                "attach"
              ]
            },
            "sidecar_id": {
              "$ref": "./common-ids.schema.json#/$defs/sidecar_id"
            },
            "source_context_ref": {
              "$ref": "#/$defs/sidecar_context_ref"
            },
            "access_readiness": {
              "$ref": "./agent-operations.schema.json#/$defs/agent_sidecar_access_readiness"
            },
            "pending_access_reconciliations": {
              "type": "array",
              "items": {
                "$ref": "./agent-operations.schema.json#/$defs/pending_sidecar_access_reconciliation_row"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sidecar_ensure_request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "phase",
            "operation_id",
            "idempotency_key",
            "source_realm_id",
            "controller_account_id",
            "context_ref"
          ],
          "properties": {
            "phase": {
              "const": "prepare"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            },
            "source_realm_id": {
              "$ref": "#/$defs/realm_id"
            },
            "controller_account_id": {
              "$ref": "./common-ids.schema.json#/$defs/account_id"
            },
            "context_ref": {
              "$ref": "#/$defs/sidecar_context_ref"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "phase",
            "operation_id",
            "idempotency_key",
            "reservation_handle",
            "create_event",
            "context_attach_event"
          ],
          "properties": {
            "phase": {
              "const": "commit"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "create_event": {
              "$ref": "#/$defs/sidecar_create_event"
            },
            "context_attach_event": {
              "$ref": "#/$defs/sidecar_context_attach_event"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "phase",
            "operation_id",
            "idempotency_key",
            "reservation_handle",
            "context_attach_event"
          ],
          "properties": {
            "phase": {
              "const": "attach"
            },
            "operation_id": {
              "$ref": "#/$defs/operation_id"
            },
            "idempotency_key": {
              "$ref": "#/$defs/opaque_id"
            },
            "reservation_handle": {
              "$ref": "#/$defs/opaque_id"
            },
            "context_attach_event": {
              "$ref": "#/$defs/sidecar_context_attach_event"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "prepared_event_draft": {
      "type": "object",
      "description": "Service-built canonical producer Event digest-payload bytes with producer_proof and reducer-managed fields absent. The client MUST decode these exact bytes under the suite carried by event_digest, add only the required producer proof, and return the resulting signed Event. Event id and kind are derived views, never parallel wire inputs.",
      "required": [
        "unsigned_event_bytes",
        "event_digest"
      ],
      "properties": {
        "unsigned_event_bytes": {
          "$ref": "#/$defs/base64url"
        },
        "event_digest": {
          "$ref": "./account-operations.schema.json#/$defs/sha256_digest",
          "description": "SHA-256 digest of unsigned_event_bytes under the fixed current-v1 Event identity suite. The value MUST use the sha256 prefix; no Realm state selects or changes it."
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "verification_method",
        "created_at",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "signed_event": {
      "$ref": "./event-envelope.schema.json"
    },
    "session_grant_holder_binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "device_binding"
          ],
          "properties": {
            "kind": {
              "const": "human_device"
            },
            "device_binding": {
              "$ref": "#/$defs/opaque_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "agent_id",
            "device_id",
            "agent_key_authorization_ref",
            "verification_method"
          ],
          "properties": {
            "kind": {
              "const": "agent_runtime"
            },
            "agent_id": {
              "$ref": "#/$defs/did_core_id"
            },
            "device_id": {
              "$ref": "#/$defs/device_id"
            },
            "agent_key_authorization_ref": {
              "$ref": "#/$defs/event_id"
            },
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "device_id"
          ],
          "properties": {
            "kind": {
              "const": "recovery_candidate_device"
            },
            "device_id": {
              "$ref": "#/$defs/device_id"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "strand_id": {
      "$ref": "./agent-operations.schema.json#/$defs/strand_id"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  }
}
