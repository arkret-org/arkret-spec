            "kind",
            "remove_ref"
          ],
          "properties": {
            "kind": {
              "const": "removed_t0_visible",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/2/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/2/properties/kind",
                "values": [
