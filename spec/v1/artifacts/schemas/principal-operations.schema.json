    },
    "history_share_contract": {
      "type": "object",
      "required": [
        "t0",
        "t1",
        "t2"
      ],
      "properties": {
        "t0": {
          "$ref": "#/$defs/history_t0"
        },
        "t1": {
          "$ref": "#/$defs/history_t1"
        },
        "t2": {
