                      "const": "ak.sidecar.context.attach"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "branch",
            "operation_id",
            "reservation_handle",
            "expires_at",
            "sidecar_id",
            "context_attach_event_id",
            "context_attach_event_draft"
          ],
          "properties": {
