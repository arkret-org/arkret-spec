                "authority": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/3/properties/kind",
                "owner": "principal-operations.schema.json#/$defs/receiver_eligibility_basis/oneOf/3/properties/kind",
                "values": [
                  "world_readable_requester"
                ]
              }
            },
            "requester_id": {
