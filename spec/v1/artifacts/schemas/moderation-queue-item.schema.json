{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/moderation-queue-item.schema.json",
  "$defs": {
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    }
  },
  "title": "Arkret Moderation Queue Item",
  "type": "object",
  "required": [
    "id",
    "report",
    "status",
    "visibility",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ak:moderation_queue_item:[A-Za-z0-9_-]{44}$"
    },
    "report": {
      "$ref": "./moderation-report.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "resolved"
      ],
      "description": "Authoritative moderation queue-item lifecycle. v1 is intentionally minimal: 'submitted' = report accepted and awaiting handling; 'resolved' = handling complete (terminal). The disposition (action taken vs no violation) lives on the separate ak.moderation.decision event; the appeal loop lives in the independent ak.moderation.appeal.* subsystem (§5.5). Additional intermediate states MAY be introduced in a later revision if a workflow phase needs them. See governance/content-moderation.md §3.3."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "metadata_only",
        "encrypted_evidence",
        "plaintext_evidence",
        "franking_proof_only"
      ]
    },
    "assigned_to": {
      "type": "array",
        "items": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        }
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "plaintext_allowed",
        "franking_proof_verification_required"
      ],
      "properties": {
        "plaintext_allowed": {
          "type": "boolean"
        },
        "franking_proof_verification_required": {
          "type": "boolean"
        },
        "retention_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "legal_hold": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "audit_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
