{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/moderation-queue-item.schema.json",
  "title": "Contrix Moderation Queue Item",
  "type": "object",
  "required": [
    "id",
    "report",
    "status",
    "visibility",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:moderation_queue_item:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "report": {
      "$ref": "./moderation-report.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "triaged",
        "reviewing",
        "actioned",
        "dismissed",
        "appealed",
        "closed"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "metadata_only",
        "encrypted_evidence",
        "plaintext_evidence",
        "franking_proof_only"
      ]
    },
    "assigned_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^\\s]+$"
      }
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "plaintext_allowed",
        "requires_franking_proof_verification"
      ],
      "properties": {
        "plaintext_allowed": {
          "type": "boolean"
        },
        "requires_franking_proof_verification": {
          "type": "boolean"
        },
        "retention_expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "legal_hold": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "audit_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": false
}
