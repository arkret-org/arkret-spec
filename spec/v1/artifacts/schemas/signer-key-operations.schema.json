{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/signer-key-operations.schema.json",
  "title": "Arkret Signer Key Operations",
  "description": "Closed own-Station signing-key results for one current invocation or one exact authority-committed historical Event. Historical coordinates come only from a verified committed_event_view delivered by account subscribe or per-stream scan. Receiver is the authenticated recipient Station, never a caller-selected remote service. No portable evidence or reusable current grant.",
  "$defs": {
    "signing_account_actor_id": {
      "type": "object",
      "description": "Complete account ActorId of the exact verified signer, preserving its Station for either an ordinary device or Agent.",
      "required": [
        "kind",
        "account_id"
      ],
      "properties": {
        "kind": {
          "const": "account",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/signing_account_actor_id/properties/kind",
            "owner": "signer-key-operations.schema.json#/$defs/signing_account_actor_id/properties/kind",
            "values": [
              "account"
            ]
          }
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        }
      },
      "additionalProperties": false
    },
    "station_signing_key": {
      "type": "object",
      "required": [
        "actor",
        "verification_method",
        "public_key_base64url",
        "authorization_ref"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/signing_account_actor_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "public_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "Canonical unpadded base64url of exactly 32 Ed25519 public-key bytes; this is public material, not reusable current authorization.",
          "x-arkret-member-role": "binary_encoding"
        },
        "authorization_ref": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        }
      },
      "additionalProperties": false
    },
    "query_signing_key": {
      "type": "object",
      "required": [
        "public_key_base64url",
        "authorization_ref",
        "revision",
        "governance_generation"
      ],
      "properties": {
        "public_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "Canonical unpadded base64url of exactly 32 Ed25519 public-key bytes; this is public material, not reusable current authorization.",
          "x-arkret-member-role": "binary_encoding"
        },
        "authorization_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref",
          "description": "Exact accepted authorization Event for this key. For a historical query this is independent of the selector's target committed_event_ref: the two MAY be equal but equality is not required."
        },
        "revision": {
          "type": "object",
          "required": [
            "commit_id",
            "stream_position"
          ],
          "properties": {
            "commit_id": {
              "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
            },
            "stream_position": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Verified current revision of the authorization stream at resolution. The revision belongs to authorization_ref.stream_ref, is not older than authorization_ref.stream_position, and is never inferred from arrival order, a cursor or a current projection."
        },
        "governance_generation": {
          "description": "Verified governance generation of revision.commit_id.",
          "$ref": "./decimal-integers.schema.json#/$defs/uint64_decimal"
        }
      },
      "additionalProperties": false,
      "description": "Shared resolved key shape for existing current Agent and historical Agent/Account Device roles; each enclosing selector/outcome retains its own authority and source rules. Only new ordinary Human and accepted Applet-managed Device historical delivery uses original governance Commit-bound immutable facts. Independent original authorization coordinates/revision/PCR governance generation remain mandatory where the enclosing role requires them; no current fallback or new target source."
    },
    "current_account_device_selector": {
      "type": "object",
      "required": [
        "verification_mode",
        "sender_kind",
        "actor",
        "device_id",
        "verification_method"
      ],
      "properties": {
        "verification_mode": {
          "const": "current_admission",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/current_account_device_selector/properties/verification_mode",
            "owner": "signer-key-operations.schema.json#/$defs/current_account_device_selector/properties/verification_mode",
            "values": [
              "current_admission"
            ]
          }
        },
        "sender_kind": {
          "const": "account_device",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/current_account_device_selector/properties/sender_kind",
            "owner": "signer-key-operations.schema.json#/$defs/current_account_device_selector/properties/sender_kind",
            "values": [
              "account_device"
            ]
          }
        },
        "actor": {
          "$ref": "#/$defs/signing_account_actor_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        }
      },
      "additionalProperties": false
    },
    "current_agent_selector": {
      "type": "object",
      "required": [
        "verification_mode",
        "sender_kind",
        "actor",
        "verification_method"
      ],
      "properties": {
        "verification_mode": {
          "const": "current_admission",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/current_agent_selector/properties/verification_mode",
            "owner": "signer-key-operations.schema.json#/$defs/current_agent_selector/properties/verification_mode",
            "values": [
              "current_admission"
            ]
          }
        },
        "sender_kind": {
          "const": "agent",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/current_agent_selector/properties/sender_kind",
            "owner": "signer-key-operations.schema.json#/$defs/current_agent_selector/properties/sender_kind",
            "values": [
              "agent"
            ]
          }
        },
        "actor": {
          "$ref": "#/$defs/signing_account_actor_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        }
      },
      "additionalProperties": false
    },
    "historical_account_device_selector": {
      "type": "object",
      "required": [
        "verification_mode",
        "sender_kind",
        "actor",
        "device_id",
        "verification_method",
        "committed_event_ref"
      ],
      "properties": {
        "verification_mode": {
          "const": "historical_event",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_account_device_selector/properties/verification_mode",
            "owner": "signer-key-operations.schema.json#/$defs/historical_account_device_selector/properties/verification_mode",
            "values": [
              "historical_event"
            ]
          }
        },
        "sender_kind": {
          "const": "account_device",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_account_device_selector/properties/sender_kind",
            "owner": "signer-key-operations.schema.json#/$defs/historical_account_device_selector/properties/sender_kind",
            "values": [
              "account_device"
            ]
          }
        },
        "actor": {
          "$ref": "#/$defs/signing_account_actor_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "committed_event_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref",
          "description": "Exact committed coordinate of the historical Event being verified. Its stream_ref.realm_id MUST equal the enclosing request realm_id. It is constructed only from a verified committed_event_view, never from a bare Event, current projection, cursor, time or cache order."
        }
      },
      "additionalProperties": false
    },
    "historical_agent_selector": {
      "type": "object",
      "required": [
        "verification_mode",
        "sender_kind",
        "actor",
        "verification_method",
        "committed_event_ref"
      ],
      "properties": {
        "verification_mode": {
          "const": "historical_event",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_agent_selector/properties/verification_mode",
            "owner": "signer-key-operations.schema.json#/$defs/historical_agent_selector/properties/verification_mode",
            "values": [
              "historical_event"
            ]
          }
        },
        "sender_kind": {
          "const": "agent",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_agent_selector/properties/sender_kind",
            "owner": "signer-key-operations.schema.json#/$defs/historical_agent_selector/properties/sender_kind",
            "values": [
              "agent"
            ]
          }
        },
        "actor": {
          "$ref": "#/$defs/signing_account_actor_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "committed_event_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref",
          "description": "Exact committed coordinate of the historical Event being verified. Its stream_ref.realm_id MUST equal the enclosing request realm_id. It is constructed only from a verified committed_event_view, never from a bare Event, current projection, cursor, time or cache order."
        }
      },
      "additionalProperties": false
    },
    "current_selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/current_account_device_selector"
        },
        {
          "$ref": "#/$defs/current_agent_selector"
        },
        {
          "$ref": "#/$defs/current_realm_device_selector"
        }
      ]
    },
    "historical_selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/historical_account_device_selector"
        },
        {
          "$ref": "#/$defs/historical_agent_selector"
        },
        {
          "$ref": "#/$defs/historical_service_selector"
        },
        {
          "$ref": "#/$defs/historical_realm_device_selector"
        }
      ]
    },
    "query_selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/current_selector"
        },
        {
          "$ref": "#/$defs/historical_selector"
        }
      ]
    },
    "query_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "queries"
      ],
      "properties": {
        "request_id": {
          "$ref": "./account-operations.schema.json#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/query_selector"
          }
        },
        "recipient_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 65536,
      "oneOf": [
        {
          "required": [
            "recipient_account_id"
          ],
          "not": {
            "required": [
              "recipient_actor_id"
            ]
          }
        },
        {
          "required": [
            "recipient_actor_id"
          ],
          "not": {
            "required": [
              "recipient_account_id"
            ]
          }
        }
      ]
    },
    "current_signer_key_resolution": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "selector",
            "status",
            "key"
          ],
          "properties": {
            "selector": {
              "$ref": "#/$defs/current_agent_selector"
            },
            "status": {
              "const": "resolved",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signer-key-operations.schema.json#/$defs/current_signer_key_resolution/oneOf/0/properties/status",
                "owner": "signer-key-operations.schema.json#/$defs/current_signer_key_resolution/oneOf/0/properties/status",
                "values": [
                  "resolved"
                ]
              }
            },
            "key": {
              "$ref": "#/$defs/query_signing_key"
            }
          },
          "additionalProperties": false,
          "x-arkret-max-canonical-bytes": 16384
        },
        {
          "type": "object",
          "required": [
            "selector",
            "status",
            "key"
          ],
          "properties": {
            "selector": {
              "$ref": "#/$defs/current_account_device_selector"
            },
            "status": {
              "const": "resolved",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signer-key-operations.schema.json#/$defs/current_signer_key_resolution/oneOf/1/properties/status",
                "owner": "signer-key-operations.schema.json#/$defs/current_signer_key_resolution/oneOf/1/properties/status",
                "values": [
                  "resolved"
                ]
              }
            },
            "key": {
              "$ref": "#/$defs/current_device_signing_key"
            }
          },
          "additionalProperties": false,
          "x-arkret-max-canonical-bytes": 16384
        },
        {
          "type": "object",
          "required": [
            "selector",
            "status",
            "key"
          ],
          "properties": {
            "selector": {
              "$ref": "#/$defs/current_realm_device_selector"
            },
            "status": {
              "const": "resolved",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "signer-key-operations.schema.json#/$defs/current_signer_key_resolution/oneOf/2/properties/status",
                "owner": "signer-key-operations.schema.json#/$defs/current_signer_key_resolution/oneOf/2/properties/status",
                "values": [
                  "resolved"
                ]
              }
            },
            "key": {
              "$ref": "#/$defs/current_device_signing_key"
            }
          },
          "additionalProperties": false
        }
      ],
      "x-arkret-name-role": "key_resolution"
    },
    "historical_account_device_signer_key_resolution": {
      "type": "object",
      "required": [
        "selector",
        "status",
        "key",
        "accepted_at"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/historical_account_device_selector"
        },
        "status": {
          "const": "resolved",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_account_device_signer_key_resolution/properties/status",
            "owner": "signer-key-operations.schema.json#/$defs/historical_account_device_signer_key_resolution/properties/status",
            "values": [
              "resolved"
            ]
          }
        },
        "key": {
          "$ref": "#/$defs/query_signing_key"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp",
          "description": "Effective time of the referenced historical authorization fact; not an Event arrival or permanent-history acceptance timestamp."
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 16384,
      "x-arkret-name-role": "key_resolution"
    },
    "historical_agent_signer_key_resolution": {
      "type": "object",
      "required": [
        "selector",
        "status",
        "key",
        "accepted_at"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/historical_agent_selector"
        },
        "status": {
          "const": "resolved",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_agent_signer_key_resolution/properties/status",
            "owner": "signer-key-operations.schema.json#/$defs/historical_agent_signer_key_resolution/properties/status",
            "values": [
              "resolved"
            ]
          }
        },
        "key": {
          "$ref": "#/$defs/query_signing_key"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp",
          "description": "Effective time of the referenced historical authorization fact; not an Event arrival or permanent-history acceptance timestamp."
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 16384,
      "x-arkret-name-role": "key_resolution"
    },
    "unavailable_signer_key_resolution": {
      "type": "object",
      "required": [
        "selector",
        "status"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/query_selector"
        },
        "status": {
          "const": "unavailable",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/unavailable_signer_key_resolution/properties/status",
            "owner": "signer-key-operations.schema.json#/$defs/unavailable_signer_key_resolution/properties/status",
            "values": [
              "unavailable"
            ]
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 16384,
      "x-arkret-name-role": "key_resolution"
    },
    "query_response_body": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "resolutions"
      ],
      "properties": {
        "request_id": {
          "$ref": "./account-operations.schema.json#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/current_signer_key_resolution"
              },
              {
                "$ref": "#/$defs/historical_account_device_signer_key_resolution"
              },
              {
                "$ref": "#/$defs/historical_agent_signer_key_resolution"
              },
              {
                "$ref": "#/$defs/unavailable_signer_key_resolution"
              },
              {
                "$ref": "#/$defs/historical_service_signer_key_resolution"
              },
              {
                "$ref": "#/$defs/historical_realm_device_signer_key_resolution"
              }
            ]
          }
        },
        "recipient_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 1048576,
      "oneOf": [
        {
          "required": [
            "recipient_account_id"
          ],
          "not": {
            "required": [
              "recipient_actor_id"
            ]
          }
        },
        {
          "required": [
            "recipient_actor_id"
          ],
          "not": {
            "required": [
              "recipient_account_id"
            ]
          }
        }
      ],
      "x-arkret-name-role": "response_body"
    },
    "current_device_signing_key": {
      "type": "object",
      "required": [
        "public_key_base64url"
      ],
      "properties": {
        "public_key_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "Canonical unpadded base64url of exactly 32 Ed25519 public-key bytes; this is public material, not reusable current authorization.",
          "x-arkret-member-role": "binary_encoding"
        }
      },
      "additionalProperties": false,
      "description": "Own-Station verified ordinary human current key, valid only for the frozen invocation and exact enclosing selector. No PCR coordinates or portable evidence are disclosed."
    },
    "signing_service_actor_id": {
      "type": "object",
      "required": [
        "kind",
        "service_id"
      ],
      "properties": {
        "kind": {
          "const": "service",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/signing_service_actor_id/properties/kind",
            "owner": "signer-key-operations.schema.json#/$defs/signing_service_actor_id/properties/kind",
            "values": [
              "service"
            ]
          }
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        }
      },
      "additionalProperties": false
    },
    "historical_service_selector": {
      "type": "object",
      "required": [
        "verification_mode",
        "sender_kind",
        "actor",
        "verification_method",
        "committed_event_ref"
      ],
      "properties": {
        "verification_mode": {
          "const": "historical_event",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_service_selector/properties/verification_mode",
            "owner": "signer-key-operations.schema.json#/$defs/historical_service_selector/properties/verification_mode",
            "values": [
              "historical_event"
            ]
          }
        },
        "sender_kind": {
          "const": "service",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "signer-key-operations.schema.json#/$defs/historical_service_selector/properties/sender_kind",
            "owner": "signer-key-operations.schema.json#/$defs/historical_service_selector/properties/sender_kind",
            "values": [
              "service"
            ]
          }
        },
        "actor": {
          "$ref": "#/$defs/signing_service_actor_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "committed_event_ref": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref",
          "description": "Exact committed coordinate of the historical Event being verified. Its stream_ref.realm_id MUST equal the enclosing request realm_id. It is constructed only from a verified committed_event_view, never from a bare Event, current projection, cursor, time or cache order."
        }
      },
      "additionalProperties": false
    },
