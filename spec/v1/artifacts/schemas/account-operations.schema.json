{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/account-operations.schema.json",
  "title": "Arkret Account Operation DTOs",
  "description": "Closed request and response DTOs for account self-service operations, service-authenticated Account Authority PCR authoring basis discovery, and Account Authority to Principal Server account-status publication.",
  "anyOf": [
    { "$ref": "#/$defs/account_view" },
    { "$ref": "#/$defs/account_handoff_request_body" },
    { "$ref": "#/$defs/account_handoff_outcome" },
    { "$ref": "#/$defs/identity_binding_challenge_request_body" },
    { "$ref": "#/$defs/identity_binding_challenge_outcome" },
    { "$ref": "#/$defs/account_register_request_body" },
    { "$ref": "#/$defs/account_register_outcome" },
    { "$ref": "#/$defs/account_update_profile_request_body" },
    { "$ref": "#/$defs/account_update_profile_outcome" },
    { "$ref": "#/$defs/account_status_authority_evidence" },
    { "$ref": "#/$defs/account_status_receipt" },
    { "$ref": "#/$defs/account_status_authoring_basis_request_body" },
    { "$ref": "#/$defs/account_status_authoring_basis_outcome" },
    { "$ref": "#/$defs/account_status_publication_request_body" },
    { "$ref": "#/$defs/account_status_publication_outcome" },
    { "$ref": "#/$defs/session_revoke_request_body" },
    { "$ref": "#/$defs/session_revoke_outcome" }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^ak:grant:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "applet_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ak:applet:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "$ref": "#/$defs/did"
        }
      ]
    },
    "typed_ref": {
      "type": "string",
      "pattern": "^ak:[a-z][a-z0-9_]*:[A-Za-z0-9._:-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^ak:request:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "opaque_registration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "dpop_jkt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "RFC 7638 SHA-256 JWK thumbprint of the holder key, encoded base64url without padding."
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "$ref": "string-profiles.schema.json#/$defs/single_line_display_text",
      "maxLength": 128
    },
    "account_state": {
      "type": "string",
      "enum": [
        "active",
        "soft_logged_out",
        "locked",
        "suspended",
        "deactivated",
        "erasure_pending"
      ],
      "description": "Account lifecycle projection; mirrors zh/identity/account-lifecycle.md §3."
    },
    "device_summary": {
      "type": "object",
      "required": [
        "device_id",
        "status"
      ],
      "properties": {
        "device_id": { "$ref": "#/$defs/device_id" },
        "display_name": { "$ref": "#/$defs/display_name" },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked",
            "unknown"
          ]
        },
        "authorized_event_ref": { "$ref": "#/$defs/event_id" },
        "authorized_at": { "$ref": "#/$defs/timestamp" },
        "last_seen_at": { "$ref": "#/$defs/timestamp" },
        "revoked_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "device_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/device_summary" },
      "uniqueItems": true
    },
    "handle_claim_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference to a signed ak.schema.handle_claim.v1 claim, such as an event ref, issuer-local receipt ref, or content-addressed artifact ref."
    },
    "handle_claim_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" },
      "uniqueItems": true
    },
    "account_lifecycle_proof": {
      "type": "object",
      "required": [
        "proof_kind",
        "challenge",
        "request_canonical_digest",
        "audience",
        "issued_at",
        "expires_at",
        "signature"
      ],
      "properties": {
        "proof_kind": {
          "type": "string",
          "enum": [
            "did_bound_signature",
            "paired_device_proof",
            "passkey_assertion",
            "oidc_code_exchange",
            "agent_key_proof"
          ]
        },
        "challenge": {
          "type": "string",
          "minLength": 16
        },
        "request_canonical_digest": { "$ref": "#/$defs/sha256_digest" },
        "audience": { "$ref": "#/$defs/non_empty_string" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Lease expiry. Issued lifetime MUST be no greater than 15 minutes; 15 minutes is also the v1 default."
        },
        "verification_method": { "$ref": "#/$defs/did_url" },
        "signature": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "account_registration_control_proof": {
      "description": "Control proof for binding an already-published DID through account register. OIDC, passkey, or agent authentication alone is insufficient to establish DID control; account-first inception instead uses identity_creation_control_proof.",
      "allOf": [
        { "$ref": "#/$defs/account_lifecycle_proof" },
        {
          "properties": {
            "proof_kind": {
              "type": "string",
              "enum": [
                "did_bound_signature",
                "paired_device_proof"
              ]
            }
          }
        }
      ]
    },
    "account_handoff_authentication_proof": {
      "type": "object",
      "description": "OIDC authorization-code exchange proof used only to create a DPoP-bound account handoff. The signature is made by the same Ed25519 holder key as the request DPoP proof over utf8('ak.account-handoff-authentication-proof-v1\\n') || RFC8785_JCS(this object with signature omitted).",
      "required": [
        "proof_kind",
        "challenge",
        "request_canonical_digest",
        "audience",
        "issuer",
        "client_id",
        "redirect_uri",
        "state",
        "nonce",
        "authorization_code",
        "code_verifier",
        "signature"
      ],
      "properties": {
        "proof_kind": { "const": "oidc_code_exchange" },
        "challenge": {
          "type": "string",
          "minLength": 16,
          "description": "Account Authority-generated challenge persisted with the OIDC authorization transaction and consumed by this exchange."
        },
        "request_canonical_digest": {
          "$ref": "#/$defs/sha256_digest",
          "description": "sha256:<lowercase-hex> of SHA-256 over RFC 8785 JCS bytes of the complete account_handoff_request_body with proof.request_canonical_digest and proof.signature omitted."
        },
        "audience": { "$ref": "#/$defs/did" },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "client_id": { "$ref": "#/$defs/non_empty_string" },
        "redirect_uri": {
          "type": "string",
          "format": "uri"
        },
        "state": {
          "type": "string",
          "minLength": 16
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "authorization_code": { "$ref": "#/$defs/non_empty_string" },
        "code_verifier": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "64-byte Ed25519 signature encoded base64url without padding."
        }
      },
      "additionalProperties": false
    },
    "reserved_identity_creation": {
      "type": "object",
      "description": "Public, server-persisted identity-creation checkpoint. It contains the exact unpublished or already-published DID operation, never recovery words, seed material, private keys, or an encrypted root export.",
      "required": [
        "principal_id",
        "operation_digest",
        "did_operation"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "operation_digest": {
          "$ref": "#/$defs/sha256_digest",
          "description": "sha256:<lowercase-hex> of SHA-256 over RFC 8785 JCS bytes of the complete did_operation object."
        },
        "did_operation": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/DidOperationSubmitRequestBody"
        }
      },
      "additionalProperties": false
    },
    "identity_creation_lease": {
      "type": "object",
      "required": [
        "identity_creation_lease_id",
        "fence",
        "expires_at"
      ],
      "properties": {
        "identity_creation_lease_id": { "$ref": "#/$defs/opaque_registration_id" },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Handoff expiry. Issued lifetime MUST be no greater than 1 hour; 1 hour is also the v1 default."
        },
        "reserved_identity": { "$ref": "#/$defs/reserved_identity_creation" }
      },
      "additionalProperties": false
    },
    "account_handoff_binding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "identity_creation_lease"
          ],
          "properties": {
            "state": { "const": "identity_creation_active" },
            "identity_creation_lease": { "$ref": "#/$defs/identity_creation_lease" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "retry_after_ms"
          ],
          "properties": {
            "state": { "const": "identity_creation_busy" },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "principal_id"
          ],
          "properties": {
            "state": { "const": "bound" },
            "principal_id": { "$ref": "#/$defs/did" }
          },
          "additionalProperties": false
        }
      ]
    },
    "account_handoff_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "proof"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/request_id" },
        "proof": { "$ref": "#/$defs/account_handoff_authentication_proof" }
      },
      "additionalProperties": false
    },
    "account_handoff_outcome": {
      "type": "object",
      "required": [
        "request_id",
        "account_handle",
        "account_handoff_grant",
        "expires_at",
        "allowed_operations",
        "binding"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/request_id" },
        "account_handle": {
          "$ref": "./handle-claim.schema.json#/properties/handle",
          "description": "Canonical handle of the authenticated service account. This unsigned UX hint is only for display and local artifact naming; it MUST NOT be treated as principal identity evidence, authorization, or a service-account-to-principal binding."
        },
        "preferred_locale": {
          "type": "string",
          "enum": ["en", "zh"],
          "description": "Optional private UI-language preference of the authenticated service account. It is returned only in this DPoP-bound handoff response so the client can continue the just-completed authentication flow in the selected language; it MUST NOT be copied into a public actor profile."
        },
        "account_handoff_grant": {
          "type": "string",
          "minLength": 32,
          "description": "Opaque, short-lived credential bound to the request DPoP key. It is not ak.session.grant and has no refresh-token semantics."
        },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "allowed_operations": {
          "const": [
            "ak.gate.account.command.issue_identity_binding_challenge",
            "ak.gate.account.command.register",
            "ak.gate.account.command.issue_session_grant"
          ]
        },
        "binding": { "$ref": "#/$defs/account_handoff_binding" }
      },
      "additionalProperties": false
    },
    "identity_binding_challenge_request_body": {
      "type": "object",
      "required": [
        "request_id",
        "identity_creation_lease_id",
        "lease_fence",
        "did_operation"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/request_id" },
        "identity_creation_lease_id": { "$ref": "#/$defs/opaque_registration_id" },
        "lease_fence": {
          "type": "integer",
          "minimum": 1
        },
        "did_operation": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/DidOperationSubmitRequestBody"
        }
      },
      "additionalProperties": false
    },
    "identity_binding_challenge_outcome": {
      "type": "object",
      "description": "Persisted, single-use server challenge. The client copies every field from challenge_id through expires_at into identity_creation_control_proof, adds proof_kind and verification_key_multibase, and signs that complete proof object with signature omitted. request_id is idempotency metadata and is not part of the root-control transcript.",
      "required": [
        "request_id",
        "challenge_id",
        "challenge",
        "purpose",
        "principal_id",
        "operation_digest",
        "identity_creation_lease_id",
        "lease_fence",
        "dpop_jkt",
        "audience",
        "origin",
        "trust_domain",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/request_id" },
        "challenge_id": { "$ref": "#/$defs/opaque_registration_id" },
        "challenge": {
          "type": "string",
          "minLength": 22
        },
        "purpose": { "const": "account_binding" },
        "principal_id": { "$ref": "#/$defs/did" },
        "operation_digest": {
          "$ref": "#/$defs/sha256_digest",
          "description": "sha256:<lowercase-hex> of SHA-256 over RFC 8785 JCS bytes of the complete request did_operation object."
        },
        "identity_creation_lease_id": { "$ref": "#/$defs/opaque_registration_id" },
        "lease_fence": {
          "type": "integer",
          "minimum": 1
        },
        "dpop_jkt": { "$ref": "#/$defs/dpop_jkt" },
        "audience": { "$ref": "#/$defs/did" },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "trust_domain": {
          "$ref": "./common-ids.schema.json#/$defs/trust_domain"
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "identity_creation_control_proof": {
      "type": "object",
      "description": "Fresh proof signed by the did:webvh inception operation's parameters.updateKeys[0] identity root. The verifier selects that key from did_operation and MUST NOT treat a request-supplied key or a DID Document verificationMethod as authority. Signature covers every field except signature as canonical JSON with domain separator ak.identity-creation-control-proof-v1.",
      "required": [
        "proof_kind",
        "challenge_id",
        "challenge",
        "purpose",
        "principal_id",
        "operation_digest",
        "identity_creation_lease_id",
        "lease_fence",
        "dpop_jkt",
        "audience",
        "origin",
        "trust_domain",
        "issued_at",
        "expires_at",
        "verification_key_multibase",
        "signature"
      ],
      "properties": {
        "proof_kind": { "const": "did_webvh_inception_update_key" },
        "challenge_id": { "$ref": "#/$defs/opaque_registration_id" },
        "challenge": {
          "type": "string",
          "minLength": 22
        },
        "purpose": { "const": "account_binding" },
        "principal_id": { "$ref": "#/$defs/did" },
        "operation_digest": { "$ref": "#/$defs/sha256_digest" },
        "identity_creation_lease_id": { "$ref": "#/$defs/opaque_registration_id" },
        "lease_fence": {
          "type": "integer",
          "minimum": 1
        },
        "dpop_jkt": { "$ref": "#/$defs/dpop_jkt" },
        "audience": { "$ref": "#/$defs/did" },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "trust_domain": {
          "$ref": "./common-ids.schema.json#/$defs/trust_domain"
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "verification_key_multibase": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "64-byte Ed25519 identity-root signature encoded base64url without padding."
        }
      },
      "additionalProperties": false
    },
    "identity_creation_registration": {
      "type": "object",
      "required": [
        "identity_creation_lease_id",
        "lease_fence",
        "did_operation",
        "control_proof"
      ],
      "properties": {
        "identity_creation_lease_id": { "$ref": "#/$defs/opaque_registration_id" },
        "lease_fence": {
          "type": "integer",
          "minimum": 1
        },
        "did_operation": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/DidOperationSubmitRequestBody"
        },
        "control_proof": { "$ref": "#/$defs/identity_creation_control_proof" }
      },
      "additionalProperties": false
    },
    "account_binding_receipt": {
      "type": "object",
      "required": [
        "binding_state",
        "identity_creation_lease_id",
        "lease_fence",
        "operation_status",
        "operation_digest",
        "head_event_digest"
      ],
      "properties": {
        "binding_state": { "const": "bound" },
        "identity_creation_lease_id": { "$ref": "#/$defs/opaque_registration_id" },
        "lease_fence": {
          "type": "integer",
          "minimum": 1
        },
        "operation_status": {
          "type": "string",
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "operation_digest": { "$ref": "#/$defs/sha256_digest" },
        "head_event_digest": { "$ref": "#/$defs/sha256_digest" }
      },
      "additionalProperties": false
    },
    "account_registration_verification_policy": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "default": false
        },
        "code_digest": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "account_registration_invitation_policy": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "default": false
        },
        "token_digests": {
          "type": "array",
          "items": { "$ref": "#/$defs/hash" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "account_registration_rate_limit_policy": {
      "type": "object",
      "required": [
        "max_attempts",
        "window_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "account_registration_policy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "verification_code": {
          "$ref": "#/$defs/account_registration_verification_policy"
        },
        "organization_allowlist": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "invitation": {
          "$ref": "#/$defs/account_registration_invitation_policy"
        },
        "rate_limit": {
          "$ref": "#/$defs/account_registration_rate_limit_policy"
        }
      },
      "additionalProperties": false
    },
    "account_registration_policy_evidence": {
      "type": "object",
      "properties": {
        "verification_code": { "$ref": "#/$defs/non_empty_string" },
        "organization": { "$ref": "#/$defs/non_empty_string" },
        "invitation_token": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "account_registration_audit_outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "registration_closed",
        "verification_code_required",
        "verification_code_invalid",
        "organization_not_allowed",
        "invitation_required",
        "invitation_invalid",
        "rate_limited",
        "duplicate_conflict"
      ]
    },
    "account_registration_evidence_summary": {
      "type": "object",
      "properties": {
        "verification_code_present": {
          "type": "boolean",
          "default": false
        },
        "invitation_token_present": {
          "type": "boolean",
          "default": false
        },
        "organization": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "account_registration_audit": {
      "type": "object",
      "required": [
        "outcome",
        "policy_digest",
        "evidence"
      ],
      "properties": {
        "outcome": { "$ref": "#/$defs/account_registration_audit_outcome" },
        "policy_digest": { "$ref": "#/$defs/hash" },
        "evidence": { "$ref": "#/$defs/account_registration_evidence_summary" },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "profile_patch": {
      "allOf": [
        { "$ref": "./patch.schema.json" }
      ],
      "propertyNames": {
        "type": "string",
        "pattern": "^(display_name|avatar_blob_ref|profile_fields\\.[a-z][a-z0-9_]{0,63})$",
        "description": "ak.self.account.command.update_profile only accepts display_name, avatar_blob_ref, and profile_fields.<key>. The bio is carried as profile_fields.bio."
      }
    },
    "account_view": {
      "type": "object",
      "required": [
        "principal_id",
        "state",
        "devices"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "primary_handle_claim": { "$ref": "./handle-claim.schema.json" },
        "primary_handle_claim_ref": { "$ref": "#/$defs/handle_claim_ref" },
        "handle_claim_digests": { "$ref": "#/$defs/handle_claim_digests" },
        "state": { "$ref": "#/$defs/account_state" },
        "devices": { "$ref": "#/$defs/device_summaries" },
        "profile": { "$ref": "./actor-profile.schema.json" },
        "is_server_admin": {
          "type": "boolean",
          "description": "True when the authenticated principal is a deployment server administrator (the server's configured admin principal set). Operator-only product surfaces (e.g. organization creation) gate their UI on this. Reducer/config-derived, not a stored account field; absent or false means non-admin."
        }
      },
      "not": {
        "required": [
          "primary_handle_claim",
          "primary_handle_claim_ref"
        ]
      },
      "additionalProperties": false
    },
    "account_register_request_body": {
      "type": "object",
      "required": [
        "principal_id"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "display_name": { "$ref": "#/$defs/display_name" },
        "device_id": { "$ref": "#/$defs/device_id" },
        "proof": { "$ref": "#/$defs/account_registration_control_proof" },
        "identity_creation": { "$ref": "#/$defs/identity_creation_registration" },
        "policy_evidence": { "$ref": "#/$defs/account_registration_policy_evidence" }
      },
      "not": {
        "required": [
          "proof",
          "identity_creation"
        ]
      },
      "additionalProperties": false
    },
    "account_register_outcome": {
      "type": "object",
      "required": [
        "principal_id",
        "state",
        "devices"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "state": { "$ref": "#/$defs/account_state" },
        "devices": { "$ref": "#/$defs/device_summaries" },
        "primary_handle_claim": { "$ref": "./handle-claim.schema.json" },
        "primary_handle_claim_ref": { "$ref": "#/$defs/handle_claim_ref" },
        "handle_claim_digests": { "$ref": "#/$defs/handle_claim_digests" },
        "profile": { "$ref": "./actor-profile.schema.json" },
        "registration_audit": { "$ref": "#/$defs/account_registration_audit" },
        "binding_receipt": { "$ref": "#/$defs/account_binding_receipt" }
      },
      "not": {
        "required": [
          "primary_handle_claim",
          "primary_handle_claim_ref"
        ]
      },
      "additionalProperties": false
    },
    "account_update_profile_request_body": {
      "type": "object",
      "required": [
        "patch"
      ],
      "properties": {
        "patch": { "$ref": "#/$defs/profile_patch" }
      },
      "additionalProperties": false
    },
    "account_update_profile_outcome": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": { "$ref": "./actor-profile.schema.json" }
      },
      "additionalProperties": false
    },
    "account_status_authority_evidence": {
      "type": "object",
      "description": "Account Authority-signed, transport-only evidence binding one service account, principal, Principal Control Realm and authorized Event issuer. It is not a public identity fact and MUST be disclosed only to Principal Servers that already hold or are about to hold state for this account/principal. The proof uses context ak.account_status.authority_evidence.v1 and payload_digest over RFC 8785 JCS of every field except proof.",
      "required": [
        "account_authority_id",
        "issuer_service_id",
        "principal_control_realm_id",
        "account_id",
        "principal_id",
        "binding_version",
        "authority_ref",
        "issued_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "account_authority_id": { "$ref": "#/$defs/did" },
        "issuer_service_id": { "$ref": "#/$defs/did" },
        "principal_control_realm_id": { "$ref": "./common-ids.schema.json#/$defs/realm_id" },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "principal_id": { "$ref": "#/$defs/did" },
        "binding_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonic Account Authority-local binding generation. A receiver MUST reject rollback relative to evidence already accepted for the same (account_authority_id, account_id)."
        },
        "authority_ref": {
          "$ref": "#/$defs/did_url",
          "description": "Account Authority DID service/delegation URL authorizing issuer_service_id to sign ak.account.status for this account. For a direct Account Authority issuer this is its own account-authority service entry; for a delegated Principal Server it is the live delegation entry."
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "proof": { "$ref": "./event-envelope.schema.json#/$defs/proof" }
      },
      "additionalProperties": false
    },
    "account_status_publication": {
      "description": "Constrained carrier for exactly one ak.account.status Event. Initial Account Authority publication carries event only; fanout of an already accepted Event carries the same event plus account_status_receipts. AuthorizationLease and generic IngressReceipt are forbidden because this high-risk status publication is admitted against current authority state.",
      "oneOf": [
        {
          "type": "object",
          "required": ["event"],
          "properties": {
            "event": { "$ref": "./service-operation-dtos.schema.json#/$defs/EventSubmitEnvelope" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["event", "account_status_receipts"],
          "properties": {
            "event": { "$ref": "./service-operation-dtos.schema.json#/$defs/EventSubmitEnvelope" },
            "account_status_receipts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/account_status_receipt" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "account_status_receipt": {
      "type": "object",
      "description": "Principal Server-signed transport receipt proving that one ak.account.status Event was accepted into that receiver's local account-status frontier. It is not an offline-publication IngressReceipt, contains no AuthorizationLease id, and grants no authority. proof uses context ak.account_status.ingress_receipt.v1 and payload_digest over RFC 8785 JCS of every field except proof.",
      "required": [
        "receipt_id",
        "event_id",
        "event_digest",
        "account_id",
        "principal_id",
        "principal_control_realm_id",
        "receiver_service_id",
        "account_status_frontier_digest",
        "accepted_at",
        "proof"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "event_id": { "$ref": "#/$defs/event_id" },
        "event_digest": { "$ref": "#/$defs/hash" },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "principal_id": { "$ref": "#/$defs/did" },
        "principal_control_realm_id": { "$ref": "./common-ids.schema.json#/$defs/realm_id" },
        "receiver_service_id": { "$ref": "#/$defs/did" },
        "account_status_frontier_digest": { "$ref": "#/$defs/hash" },
        "accepted_at": { "$ref": "#/$defs/timestamp" },
        "proof": { "$ref": "./event-envelope.schema.json#/$defs/proof" }
      },
      "additionalProperties": false
    },
    "account_status_publication_request_body": {
      "type": "object",
      "required": [
        "authority_evidence",
        "publication"
      ],
      "properties": {
        "authority_evidence": { "$ref": "#/$defs/account_status_authority_evidence" },
        "publication": { "$ref": "#/$defs/account_status_publication" },
        "cba_proof_bundles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "./cba-proof-bundle.schema.json" },
          "description": "Receiver-relative Principal Control Realm CBA closure for receipted fanout. Initial publication MAY omit it when the destination already has the current PCR dependencies."
        }
      },
      "additionalProperties": false
    },
    "account_status_authoring_basis_request_body": {
      "type": "object",
      "description": "Service-authenticated, read-only request for the exact actor-chain and Principal Control Realm Seal frontiers needed to author one ak.account.status Event. The signed authority evidence is verified before any frontier is disclosed.",
      "required": [
        "authority_evidence",
        "event_kind"
      ],
      "properties": {
        "authority_evidence": { "$ref": "#/$defs/account_status_authority_evidence" },
        "event_kind": { "const": "ak.account.status" }
      },
      "additionalProperties": false
    },
    "account_status_authoring_basis_outcome": {
      "type": "object",
      "description": "PCR-bound authoring coordinates for one authoritative account-status producer. actor_frontier supplies actor_seq and prev_refs; seal_frontier supplies the sole seal_basis leaf. Both variants MUST exactly match authority_evidence and are read-only observations, not authority grants.",
      "required": [
        "account_id",
        "principal_id",
        "principal_control_realm_id",
        "issuer_service_id",
        "actor_frontier",
        "seal_frontier"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "principal_id": { "$ref": "#/$defs/did" },
        "principal_control_realm_id": { "$ref": "./common-ids.schema.json#/$defs/realm_id" },
        "issuer_service_id": { "$ref": "#/$defs/did" },
        "actor_frontier": { "$ref": "./service-operation-dtos.schema.json#/$defs/RealmActorFrontierView" },
        "seal_frontier": {
          "allOf": [
            { "$ref": "./service-operation-dtos.schema.json#/$defs/RealmSealFrontierView" },
            {
              "properties": {
                "governance_health": {
                  "properties": {
                    "status": { "const": "healthy" }
                  },
                  "required": ["status"]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "account_status_publication_outcome": {
      "type": "object",
      "description": "Durable operation state. accepted/duplicate are terminal for this receiver's account-status frontier; pending_seal is retryable with the same Idempotency-Key and byte-identical request until the Event is accepted or rejected. propagation_state reports this receiver's downstream fanout obligation without mutating the signed Event payload.",
      "required": [
        "status",
        "event_id",
        "account_id",
        "principal_id",
        "propagation_state"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending_seal", "accepted", "duplicate"]
        },
        "event_id": { "$ref": "#/$defs/event_id" },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "principal_id": { "$ref": "#/$defs/did" },
        "effective_status_event_id": { "$ref": "#/$defs/event_id" },
        "account_status_frontier_digest": { "$ref": "#/$defs/hash" },
        "barrier_cursor": { "$ref": "./cursor.schema.json" },
        "propagation_state": {
          "type": "string",
          "enum": ["not_required", "scheduled", "complete", "incomplete"]
        },
        "pending_destination_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "session_revoke_request_body": {
      "type": "object",
      "properties": {
        "target_grant_id": { "$ref": "#/$defs/grant_id" },
        "target_device_id": { "$ref": "#/$defs/device_id" },
        "all_sessions": { "const": true },
        "applet_id": { "$ref": "#/$defs/applet_id" },
        "effective_scope": {
          "$ref": "../schemas/applet-install-plan.schema.json#/$defs/effective_scope"
        },
        "registration_epoch": { "$ref": "#/$defs/hash" },
        "service_id": { "$ref": "#/$defs/did" },
        "capability_grant_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/typed_ref" },
          "uniqueItems": true
        },
        "proof": { "$ref": "#/$defs/account_lifecycle_proof" }
      },
      "dependentRequired": {
        "applet_id": [
          "effective_scope",
          "registration_epoch"
        ],
        "effective_scope": [
          "applet_id",
          "registration_epoch"
        ],
        "registration_epoch": [
          "applet_id",
          "effective_scope"
        ],
        "service_id": [
          "applet_id",
          "effective_scope",
          "registration_epoch"
        ],
        "capability_grant_refs": [
          "applet_id",
          "effective_scope",
          "registration_epoch"
        ]
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "target_grant_id",
              "target_device_id"
            ]
          },
          {
            "required": [
              "target_grant_id",
              "all_sessions"
            ]
          },
          {
            "required": [
              "target_device_id",
              "all_sessions"
            ]
          },
          {
            "required": [
              "target_grant_id",
              "applet_id"
            ]
          },
          {
            "required": [
              "target_device_id",
              "applet_id"
            ]
          },
          {
            "required": [
              "all_sessions",
              "applet_id"
            ]
          }
        ]
      },
      "additionalProperties": false
    },
    "session_revoke_outcome": {
      "type": "object",
      "required": [
        "revoked_count"
      ],
      "properties": {
        "revoked_count": {
          "type": "integer",
          "minimum": 0
        },
        "revoked_grant_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/grant_id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
