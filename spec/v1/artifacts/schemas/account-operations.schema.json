{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/account-operations.schema.json",
  "title": "Cokret Account Self-Service Operation DTOs",
  "description": "Closed request and response DTOs for account self-service operations: viewer, register, profile update, and session revocation.",
  "anyOf": [
    { "$ref": "#/$defs/viewer_response" },
    { "$ref": "#/$defs/register_request" },
    { "$ref": "#/$defs/account_response" },
    { "$ref": "#/$defs/update_profile_request" },
    { "$ref": "#/$defs/update_profile_response" },
    { "$ref": "#/$defs/session_revoke_request" },
    { "$ref": "#/$defs/session_revoke_response" }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "did_url": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^ck:grant:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|sha3_256|blake3):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "account_state": {
      "type": "string",
      "enum": [
        "active",
        "soft_logged_out",
        "locked",
        "suspended",
        "deactivated",
        "erasure_pending"
      ],
      "description": "Account lifecycle projection; mirrors zh/identity/account-lifecycle.md §3."
    },
    "device_summary": {
      "type": "object",
      "required": [
        "device_id",
        "status"
      ],
      "properties": {
        "device_id": { "$ref": "#/$defs/device_id" },
        "display_name": { "$ref": "#/$defs/display_name" },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked",
            "unknown"
          ]
        },
        "authorized_event_ref": { "$ref": "#/$defs/event_id" },
        "authorized_at": { "$ref": "#/$defs/timestamp" },
        "last_seen_at": { "$ref": "#/$defs/timestamp" },
        "revoked_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "device_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/device_summary" },
      "uniqueItems": true
    },
    "handle_claim_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference to a signed ck.schema.handle_claim.v1 claim, such as an event ref, issuer-local receipt ref, or content-addressed artifact ref."
    },
    "handle_claim_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" },
      "uniqueItems": true
    },
    "account_lifecycle_proof": {
      "type": "object",
      "required": [
        "proof_kind",
        "challenge",
        "request_canonical_digest",
        "audience",
        "issued_at",
        "expires_at",
        "signature"
      ],
      "properties": {
        "proof_kind": {
          "type": "string",
          "enum": [
            "did_bound_signature",
            "paired_device_proof",
            "passkey_assertion",
            "oidc_code_exchange",
            "agent_key_proof"
          ]
        },
        "challenge": {
          "type": "string",
          "minLength": 16
        },
        "request_canonical_digest": { "$ref": "#/$defs/sha256_digest" },
        "audience": { "$ref": "#/$defs/non_empty_string" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "verification_method": { "$ref": "#/$defs/did_url" },
        "signature": { "$ref": "#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "profile_patch": {
      "allOf": [
        { "$ref": "./patch.schema.json" }
      ],
      "propertyNames": {
        "type": "string",
        "pattern": "^(display_name|avatar_blob_ref|profile_fields\\.[a-z][a-z0-9_]{0,63})$",
        "description": "ck.account.update_profile only accepts display_name, avatar_blob_ref, and profile_fields.<key>. Existing bio fields migrate to profile_fields.bio."
      }
    },
    "viewer_response": {
      "type": "object",
      "required": [
        "principal_id",
        "state",
        "devices"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "primary_handle_claim": { "$ref": "./handle-claim.schema.json" },
        "primary_handle_claim_ref": { "$ref": "#/$defs/handle_claim_ref" },
        "handle_claim_digests": { "$ref": "#/$defs/handle_claim_digests" },
        "state": { "$ref": "#/$defs/account_state" },
        "devices": { "$ref": "#/$defs/device_summaries" },
        "profile": { "$ref": "./actor-profile.schema.json" }
      },
      "not": {
        "required": [
          "primary_handle_claim",
          "primary_handle_claim_ref"
        ]
      },
      "additionalProperties": false
    },
    "register_request": {
      "type": "object",
      "required": [
        "principal_id"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "display_name": { "$ref": "#/$defs/display_name" },
        "device_id": { "$ref": "#/$defs/device_id" },
        "proof": { "$ref": "#/$defs/account_lifecycle_proof" }
      },
      "additionalProperties": false
    },
    "account_response": {
      "type": "object",
      "required": [
        "principal_id",
        "state",
        "devices"
      ],
      "properties": {
        "principal_id": { "$ref": "#/$defs/did" },
        "state": { "$ref": "#/$defs/account_state" },
        "devices": { "$ref": "#/$defs/device_summaries" },
        "primary_handle_claim": { "$ref": "./handle-claim.schema.json" },
        "primary_handle_claim_ref": { "$ref": "#/$defs/handle_claim_ref" },
        "handle_claim_digests": { "$ref": "#/$defs/handle_claim_digests" },
        "profile": { "$ref": "./actor-profile.schema.json" }
      },
      "not": {
        "required": [
          "primary_handle_claim",
          "primary_handle_claim_ref"
        ]
      },
      "additionalProperties": false
    },
    "update_profile_request": {
      "type": "object",
      "required": [
        "patch"
      ],
      "properties": {
        "patch": { "$ref": "#/$defs/profile_patch" }
      },
      "additionalProperties": false
    },
    "update_profile_response": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": { "$ref": "./actor-profile.schema.json" }
      },
      "additionalProperties": false
    },
    "session_revoke_request": {
      "type": "object",
      "properties": {
        "target_grant_id": { "$ref": "#/$defs/grant_id" },
        "target_device_id": { "$ref": "#/$defs/device_id" },
        "all_sessions": { "const": true },
        "proof": { "$ref": "#/$defs/account_lifecycle_proof" }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "target_grant_id",
              "target_device_id"
            ]
          },
          {
            "required": [
              "target_grant_id",
              "all_sessions"
            ]
          },
          {
            "required": [
              "target_device_id",
              "all_sessions"
            ]
          }
        ]
      },
      "additionalProperties": false
    },
    "session_revoke_response": {
      "type": "object",
      "required": [
        "revoked_count"
      ],
      "properties": {
        "revoked_count": {
          "type": "integer",
          "minimum": 0
        },
        "revoked_grant_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/grant_id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
