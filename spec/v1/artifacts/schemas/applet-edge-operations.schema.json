{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-edge-operations.schema.json",
  "title": "Arkret Applet Edge Operation DTOs",
  "description": "Closed request/response DTOs for Applet edge and bridge operations.",
  "anyOf": [
    {
      "$ref": "#/$defs/applet_ping_outcome"
    },
    {
      "$ref": "#/$defs/applet_transaction_request_body"
    },
    {
      "$ref": "#/$defs/applet_transaction_outcome"
    },
    {
      "$ref": "#/$defs/applet_actor_view"
    },
    {
      "$ref": "#/$defs/applet_realm_view"
    },
    {
      "$ref": "#/$defs/applet_protocol_metadata"
    },
    {
      "$ref": "#/$defs/third_party_query"
    },
    {
      "$ref": "#/$defs/applet_third_party_user_list"
    },
    {
      "$ref": "#/$defs/applet_third_party_location_list"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "applet_id": {
      "$ref": "./common-ids.schema.json#/$defs/applet_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "blob_ref": {
      "$ref": "./agent-operations.schema.json#/$defs/blob_ref"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "protocol": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "external_ref": {
      "type": "object",
      "required": [
        "protocol",
        "external_id"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "rejected_item": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "field_definition": {
      "type": "object",
      "required": [
        "value_kind"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "enum_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        },
        "value_kind": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "datetime",
            "external_ref",
            "url",
            "enum"
          ]
        }
      },
      "additionalProperties": false
    },
    "protocol_instance": {
      "type": "object",
      "required": [
        "instance_id",
        "display_name"
      ],
      "properties": {
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_ping_outcome": {
      "type": "object",
      "required": [
        "applet_id",
        "service_id",
        "protocol_version"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "protocol_version": {
          "type": "string",
          "const": "1.0"
        }
      },
      "additionalProperties": false
    },
    "applet_transaction_request_body": {
      "type": "object",
      "description": "Body for ak.edge.applet.command.transaction.v1. Transport-layer requirements are mandatory but not body fields: RFC 9421 Signature/Signature-Input, Source-Service-ID, Destination-Service-ID, Content-Digest, Idempotency-Key, received_at audit metadata, and a persisted delivery_authentication_record. See zh/extensions/applet-integration.md section 7.3.1.",
      "required": [
        "applet_id",
        "source_service_id"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id",
          "description": "Exact active Applet registration selected for signature and epoch verification; service_id alone is not unique."
        },
        "source_service_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Must exactly match the Source-Service-ID header and the signed source-service-id component. It identifies the source service only; each Event still requires independent actor/applet/capability signature verification."
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "description": "Optional encrypted Signal Extension envelopes. Exact applet payload types and targets remain inside ciphertext.",
          "items": {
            "$ref": "./signal-envelope.schema.json"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "events"
          ]
        },
        {
          "required": [
            "signals"
          ]
        }
      ],
      "additionalProperties": false
    },
    "applet_transaction_outcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ],
          "description": "Closed transaction result: all items accepted, a mixed result, or all items rejected."
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_item"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "applet_actor_view": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_realm_view": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "title": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_protocol_metadata": {
      "type": "object",
      "required": [
        "protocol",
        "display_name",
        "field_definitions"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "icon_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "field_definitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/field_definition"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocol_instance"
          }
        }
      },
      "additionalProperties": false
    },
    "third_party_query": {
      "type": "object",
      "required": [
        "protocol",
        "external_id"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "applet_third_party_user_list": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_third_party_location_list": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    }
  }
}
