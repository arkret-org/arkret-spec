{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-edge-operations.schema.json",
  "title": "Arkret Applet Edge Operation DTOs",
  "description": "Closed request/response DTOs for Applet edge and bridge operations.",
  "anyOf": [
    {
      "$ref": "#/$defs/applet_ping_response_body"
    },
    {
      "$ref": "#/$defs/applet_transaction_request_body"
    },
    {
      "$ref": "#/$defs/applet_transaction_response_body"
    },
    {
      "$ref": "#/$defs/applet_actor_view"
    },
    {
      "$ref": "#/$defs/applet_realm_view"
    },
    {
      "$ref": "#/$defs/applet_protocol_metadata"
    },
    {
      "$ref": "#/$defs/third_party_query"
    },
    {
      "$ref": "#/$defs/applet_third_party_user_lookup_response_body"
    },
    {
      "$ref": "#/$defs/applet_third_party_location_lookup_response_body"
    },
    {
      "$ref": "#/$defs/third_party_user_query"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "applet_id": {
      "$ref": "./common-ids.schema.json#/$defs/applet_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "blob_ref": {
      "$ref": "./agent-operations.schema.json#/$defs/blob_ref"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "protocol": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "external_ref": {
      "type": "object",
      "required": [
        "protocol",
        "external_id"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "applet_event_rejection": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "$comment": "Registered error-code-registry reason code for the per-event rejection. Inbound queue saturation (backpressure) uses queue_full; the rejection does not consume the idempotency identity and the push sender MAY re-deliver the rejected events under the same idempotency identity after retry_after_ms. See zh/extensions/applet-integration.md §7.3."
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "field_definition": {
      "type": "object",
      "required": [
        "value_kind"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "enum_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        },
        "value_kind": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "datetime",
            "external_ref",
            "uri",
            "enum"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-edge-operations.schema.json#/$defs/field_definition/properties/value_kind",
            "owner": "applet-edge-operations.schema.json#/$defs/field_definition/properties/value_kind",
            "values": [
              "string",
              "number",
              "boolean",
              "datetime",
              "external_ref",
              "uri",
              "enum"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "protocol_instance": {
      "type": "object",
      "required": [
        "instance_id",
        "display_name"
      ],
      "properties": {
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_ping_response_body": {
      "type": "object",
      "required": [
        "applet_id",
        "service_id",
        "protocol_version"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "protocol_version": {
          "type": "string",
          "const": "1.0",
          "x-arkret-value-ownership": {
            "class": "version_text",
            "authority": "applet-edge-operations.schema.json#/$defs/applet_ping_response_body/properties/protocol_version",
            "owner": "applet-edge-operations.schema.json#/$defs/applet_ping_response_body/properties/protocol_version",
            "values": [
              "1.0"
            ]
          }
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "response_body"
    },
    "applet_transaction_request_body": {
      "description": "Body for ak.edge.applet.command.transaction.v1. Transport-layer requirements are mandatory but not body fields: RFC 9421 Signature/Signature-Input, Source-Service-ID, Destination-Service-ID, Content-Digest, Idempotency-Key, received_at audit metadata, and a persisted delivery_authentication_record. See zh/extensions/applet-integration.md section 7.3.1. Event/Signal delivery and managed-actor completion are mutually exclusive closed branches. Completion is allowed only in the node-to-Applet direction.",
      "oneOf": [
        {
          "$ref": "#/$defs/applet_event_transaction_request_body"
        },
        {
          "$ref": "#/$defs/applet_authoring_transaction_request_body"
        }
      ]
    },
    "applet_transaction_response_body": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ],
          "description": "Closed transaction result: all items accepted, a mixed result, or all items rejected.",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "applet-edge-operations.schema.json#/$defs/applet_transaction_response_body/properties/status",
            "owner": "applet-edge-operations.schema.json#/$defs/applet_transaction_response_body/properties/status",
            "values": [
              "accepted",
              "partial",
              "rejected"
            ]
          }
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applet_event_rejection"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "committed_event_refs": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
          },
          "description": "Exact committed references for every durable Event accepted by this transaction. The array is empty when only Signals were accepted. A successful or partial outcome cannot be represented by status alone."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "partial"
                ],
                "x-arkret-value-ownership": {
                  "class": "owned_symbol",
                  "authority": "applet-edge-operations.schema.json#/$defs/applet_transaction_response_body/allOf/0/if/properties/status",
                  "owner": "applet-edge-operations.schema.json#/$defs/applet_transaction_response_body/allOf/0/if/properties/status",
                  "values": [
                    "accepted",
                    "partial"
                  ]
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "committed_event_refs"
            ]
          },
          "else": {
            "not": {
              "required": [
                "committed_event_refs"
              ]
            }
          }
        }
      ],
      "x-arkret-name-role": "response_body"
    },
    "applet_actor_view": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_realm_view": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "title": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_protocol_metadata": {
      "type": "object",
      "required": [
        "protocol",
        "display_name",
        "field_definitions"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "icon_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "field_definitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/field_definition"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocol_instance"
          }
        }
      },
      "additionalProperties": false
    },
    "third_party_query": {
      "type": "object",
      "required": [
        "protocol",
        "external_id"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "applet_third_party_user_lookup_response_body": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_actor"
        },
        "external_ref": {
          "$ref": "./realm-actor.schema.json#/$defs/ghost_external_tuple"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "exists": {
                "const": true,
                "x-arkret-value-ownership": {
                  "class": "numeric",
                  "authority": "applet-edge-operations.schema.json#/$defs/applet_third_party_user_lookup_response_body/allOf/0/if/properties/exists",
                  "owner": "applet-edge-operations.schema.json#/$defs/applet_third_party_user_lookup_response_body/allOf/0/if/properties/exists",
                  "values": [
                    true
                  ]
                }
              }
            },
            "required": [
              "exists"
            ]
          },
          "then": {
            "required": [
              "actor_id",
              "external_ref"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "actor_id"
                  ]
                },
                {
                  "required": [
                    "external_ref"
                  ]
                }
              ]
            }
          }
        }
      ],
      "x-arkret-name-role": "lookup_response"
    },
    "applet_third_party_location_lookup_response_body": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "lookup_response"
    },
    "applet_event_transaction_request_body": {
      "type": "object",
      "description": "Producer Event submission, committed Event delivery, and/or Signal delivery under the existing per-delivery source authentication rules; at least one non-empty array is required. events is Applet-to-Station only; committed_events is Station-to-Applet only.",
      "required": [
        "applet_id",
        "source_id"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id",
          "description": "Exact active Applet registration selected for signature and epoch verification; service_id alone is not unique."
        },
        "source_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Must exactly match the Source-Service-ID header and the signed source-service-id component. It identifies the source service only; each Event still requires independent actor/applet/capability signature verification."
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./event-envelope.schema.json"
          },
          "description": "Original producer-only business Events; native Realm actor control Events use the registered self submission controller authentication, not Applet Service transport as a substitute."
        },
        "committed_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/applet_committed_event"
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "description": "Optional encrypted Signal Extension envelopes. Exact applet payload types and targets remain inside ciphertext.",
          "items": {
            "$ref": "./signal-envelope.schema.json"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "events"
          ]
        },
        {
          "required": [
            "committed_events"
          ]
        },
        {
          "required": [
            "signals"
          ]
        }
      ],
      "not": {
        "required": [
          "events",
          "committed_events"
        ]
      },
      "additionalProperties": false
    },
    "applet_committed_event": {
      "type": "object",
      "description": "Original committed business Event. Account Device actual producers require producer_device_evidence only; Realm Device actual producers require producer_signer_fact only; all other producers forbid both. Actor, method, EventId and fact digest must match the original covering Commit. Private realm_control delivery uses exact material only.",
      "required": [
        "commit",
        "event"
      ],
      "properties": {
        "commit": {
          "$ref": "./realm-commit.schema.json"
        },
        "event": {
          "$ref": "./event-envelope.schema.json#/$defs/shared_event_envelope"
        },
        "producer_device_evidence": {
          "$ref": "./account-device-signer-evidence.schema.json",
          "description": "Required exactly when the original actual producer is an Account whose proof verification_method fragment is an ak:device: id; forbidden otherwise. The immutable complete origin Station evidence is retained at original admission and its attestation/native Service history and original Event JWS are verified at the covering Commit committed_at, never receiver current time. It conveys no PCR log, current device authority, new read right or SessionGrant."
        },
        "producer_signer_fact": {
          "$ref": "./authority-commit-operations.schema.json#/$defs/realm_device_historical_signer_fact"
        }
      },
      "additionalProperties": false
    },
    "applet_managed_actor_authoring_context": {
      "type": "object",
      "required": [
        "material"
      ],
      "properties": {
        "material": {
          "$ref": "./realm-actor-material.schema.json#/$defs/realm_actor_material_response_body"
        }
      },
      "additionalProperties": false,
      "description": "Current governor signed exact own control material. The runtime verifies request/audience/nonce, original Event/Commit and its retained private keys before using an accepted identity. No PCR or separate source Station."
    },
    "applet_authoring_transaction_request_body": {
      "type": "object",
      "description": "Exclusive node-to-Applet completion delivery. The reverse direction is forbidden. The Applet persists the whole authoring context and exact source binding before returning accepted; partial installation is forbidden.",
      "required": [
        "applet_id",
        "source_id",
        "authoring_context"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "source_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "authoring_context": {
          "$ref": "#/$defs/applet_managed_actor_authoring_context"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 16777216
    },
    "third_party_user_query": {
      "type": "object",
      "required": [
        "applet_id",
        "realm_id",
        "protocol",
        "instance_id",
        "external_id"
      ],
      "properties": {
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
