{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-edge-operations.schema.json",
  "title": "Arkret Applet Edge Operation DTOs",
  "description": "Closed request/response DTOs for Applet edge and bridge operations.",
  "anyOf": [
    {
      "$ref": "#/$defs/applet_ping_outcome"
    },
    {
      "$ref": "#/$defs/applet_transaction_request_body"
    },
    {
      "$ref": "#/$defs/applet_transaction_outcome"
    },
    {
      "$ref": "#/$defs/applet_actor_view"
    },
    {
      "$ref": "#/$defs/applet_realm_view"
    },
    {
      "$ref": "#/$defs/applet_protocol_metadata"
    },
    {
      "$ref": "#/$defs/third_party_query"
    },
    {
      "$ref": "#/$defs/applet_third_party_user_list"
    },
    {
      "$ref": "#/$defs/applet_third_party_location_list"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "applet_id": {
      "$ref": "./common-ids.schema.json#/$defs/applet_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "blob_ref": {
      "$ref": "./agent-operations.schema.json#/$defs/blob_ref"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "protocol": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "external_ref": {
      "type": "object",
      "required": [
        "protocol",
        "external_id"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "rejected_event_row": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "$comment": "Registered error-code-registry reason code for the per-event rejection. Inbound queue saturation (backpressure) uses queue_full; the rejection does not consume the idempotency identity and the push sender MAY re-deliver the rejected events under the same idempotency identity after retry_after_ms. See zh/extensions/applet-integration.md §7.3."
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "field_definition": {
      "type": "object",
      "required": [
        "value_kind"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "enum_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "$ref": "string-profiles.schema.json#/$defs/short_text",
          "maxLength": 2048
        },
        "value_kind": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "datetime",
            "external_ref",
            "uri",
            "enum"
          ]
        }
      },
      "additionalProperties": false
    },
    "protocol_instance": {
      "type": "object",
      "required": [
        "instance_id",
        "display_name"
      ],
      "properties": {
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_ping_outcome": {
      "type": "object",
      "required": [
        "applet_id",
        "service_id",
        "protocol_version"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "protocol_version": {
          "type": "string",
          "const": "1.0"
        }
      },
      "additionalProperties": false
    },
    "applet_transaction_request_body": {
      "description": "Body for ak.edge.applet.command.transaction.v1. Transport-layer requirements are mandatory but not body fields: RFC 9421 Signature/Signature-Input, Source-Service-ID, Destination-Service-ID, Content-Digest, Idempotency-Key, received_at audit metadata, and a persisted delivery_authentication_record. See zh/extensions/applet-integration.md section 7.3.1. Event/Signal delivery and managed-actor completion are mutually exclusive closed branches. Completion is allowed only in the node-to-Applet direction.",
      "oneOf": [
        {
          "$ref": "#/$defs/applet_event_transaction_request_body"
        },
        {
          "$ref": "#/$defs/applet_authoring_transaction_request_body"
        }
      ]
    },
    "applet_transaction_outcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ],
          "description": "Closed transaction result: all items accepted, a mixed result, or all items rejected."
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_event_row"
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "committed_event_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "./authority-commit-operations.schema.json#/$defs/committed_event_ref"
          },
          "description": "Exact committed references for every durable Event accepted by this transaction. A successful or partial outcome cannot be represented by status alone."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "partial"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "committed_event_refs"
            ]
          },
          "else": {
            "not": {
              "required": [
                "committed_event_refs"
              ]
            }
          }
        }
      ]
    },
    "applet_actor_view": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_realm_view": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "title": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_protocol_metadata": {
      "type": "object",
      "required": [
        "protocol",
        "display_name",
        "field_definitions"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "display_name": {
          "$ref": "string-profiles.schema.json#/$defs/display_text_256"
        },
        "icon_blob_ref": {
          "$ref": "#/$defs/blob_ref"
        },
        "field_definitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/field_definition"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocol_instance"
          }
        }
      },
      "additionalProperties": false
    },
    "third_party_query": {
      "type": "object",
      "required": [
        "protocol",
        "external_id"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "external_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "instance_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "applet_third_party_user_list": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_third_party_location_list": {
      "type": "object",
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        }
      },
      "additionalProperties": false
    },
    "applet_event_transaction_request_body": {
      "type": "object",
      "description": "Event and/or Signal delivery under the existing per-delivery source authentication rules; at least one non-empty array is required.",
      "required": [
        "applet_id",
        "source_id"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id",
          "description": "Exact active Applet registration selected for signature and epoch verification; service_id alone is not unique."
        },
        "source_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Must exactly match the Source-Service-ID header and the signed source-service-id component. It identifies the source service only; each Event still requires independent actor/applet/capability signature verification."
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "description": "Optional encrypted Signal Extension envelopes. Exact applet payload types and targets remain inside ciphertext.",
          "items": {
            "$ref": "./signal-envelope.schema.json"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "events"
          ]
        },
        {
          "required": [
            "signals"
          ]
        }
      ],
      "additionalProperties": false
    },
    "applet_managed_actor_committed_request": {
      "description": "The exact original request committed by the installing Station. The install union includes both initial creation and reuse of the existing managed actor; Ghost provisioning retains its original request and bundle.",
      "oneOf": [
        {
          "$ref": "./applet-install-operations.schema.json#/$defs/applet_install_request_body"
        },
        {
          "$ref": "./applet-ghost-operations.schema.json#/$defs/ghost_actor_provision_request_body"
        }
      ]
    },
    "applet_service_signer_evidence": {
      "type": "object",
      "description": "Complete content-addressed Service signer root selected by the accepted registration epoch. signer_resolution_evidence_ref MUST equal SHA-256(RFC8785-JCS(authenticated_signer_evidence)) in the registered ak:signer_evidence form. The Service branch is a leaf and has no recursive dependency array.",
      "required": [
        "signer_resolution_evidence_ref",
        "authenticated_signer_evidence"
      ],
      "properties": {
        "signer_resolution_evidence_ref": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref"
        },
        "authenticated_signer_evidence": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/service_signer_evidence"
        }
      },
      "additionalProperties": false
    },
    "managed_actor_principal_signer_evidence": {
      "type": "object",
      "description": "Complete content-addressed Principal signer root for the accepted managed Actor resolution plus its one exact Station Service attester leaf. Both refs are recomputed from complete RFC 8785 canonical evidence. attester_signer_evidence MUST hash to authenticated_signer_evidence.attester_signer_evidence_ref; omitted, surplus, or mismatched closure is invalid.",
      "required": [
        "signer_resolution_evidence_ref",
        "authenticated_signer_evidence",
        "attester_signer_evidence"
      ],
      "properties": {
        "signer_resolution_evidence_ref": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref"
        },
        "authenticated_signer_evidence": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/principal_signer_evidence"
        },
        "attester_signer_evidence": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/service_signer_evidence"
        }
      },
      "additionalProperties": false
    },
    "applet_managed_actor_authoring_context": {
      "type": "object",
      "description": "Current authority context for an Applet-managed Actor. Authorization is checked again when the governance Station commits the authored Event.",
      "required": [
        "committed_request",
        "realm_stream_head"
      ],
      "properties": {
        "committed_request": {
          "$ref": "#/$defs/applet_managed_actor_committed_request"
        },
        "realm_stream_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        },
        "applet_service_signer_evidence": {
          "$ref": "#/$defs/applet_service_signer_evidence"
        },
        "managed_actor_signer_evidence": {
          "$ref": "#/$defs/managed_actor_principal_signer_evidence"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 16777216
    },
    "applet_authoring_transaction_request_body": {
      "type": "object",
      "description": "Exclusive node-to-Applet completion delivery. The reverse direction is forbidden. The Applet persists the whole authoring context and exact source binding before returning accepted; partial installation is forbidden.",
      "required": [
        "applet_id",
        "source_id",
        "authoring_context"
      ],
      "properties": {
        "applet_id": {
          "$ref": "#/$defs/applet_id"
        },
        "source_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "authoring_context": {
          "$ref": "#/$defs/applet_managed_actor_authoring_context"
        }
      },
      "additionalProperties": false,
      "x-arkret-max-canonical-bytes": 16777216
    }
  }
}
