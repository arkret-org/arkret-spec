{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cokret.io/artifacts/schemas/keys-operations.schema.json",
  "title": "Cokret Device Key Operation DTOs",
  "description": "Closed request and response DTOs for ck.keys.{upload,query,claim} and ck.keys.backups.{put,list,delete}. Individual OpenAPI components reference the $defs entries in this bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/keys_upload_request_body"
    },
    {
      "$ref": "#/$defs/keys_upload_outcome"
    },
    {
      "$ref": "#/$defs/keys_query_request_body"
    },
    {
      "$ref": "#/$defs/keys_query_outcome"
    },
    {
      "$ref": "#/$defs/keys_claim_request_body"
    },
    {
      "$ref": "#/$defs/keys_claim_outcome"
    },
    {
      "$ref": "#/$defs/keys_backups_replace_outcome"
    },
    {
      "$ref": "#/$defs/keys_backups_list"
    },
    {
      "$ref": "#/$defs/keys_backups_delete_request_body"
    },
    {
      "$ref": "#/$defs/keys_backups_delete_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ck:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ck:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_id": {
      "type": "string",
      "pattern": "^ck:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_series_id": {
      "type": "string",
      "pattern": "^ck:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^ck:cursor:[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "signature": {
      "type": "object",
      "required": [
        "kid",
        "sig"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/non_empty_string"
        },
        "alg": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sig": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "algorithm_counts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "algorithm_key_records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/key_record"
      }
    },
    "device_key_records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/device_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/algorithm_key_records"
      }
    },
    "principal_device_key_records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device_key_records"
      }
    },
    "did_key": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$",
      "description": "Authoritative device signing key as an Ed25519 did:key (multibase base58btc, multicodec ed25519-pub). Mirrors ck.device.authorize.payload.device_public_key (device-lifecycle.md §5.2 / §5.4). This is the verify key receivers resolve via verification_method `{actor}#{device_id}` where the fragment is the full ck:device:<uuidv7> id, to check ck.call.signal / ephemeral envelope and durable Event proofs."
    },
    "device_status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "description": "Directory status of the (principal_id, device_id) pair at query time. active = device.authorize present and not revoked; revoked = a ck.device.revoke is in effect. Servers MUST omit device_signing_key for any non-active (revoked / unverified) device."
    },
    "query_device_record": {
      "type": "object",
      "description": "Per-(principal_id, device_id) entry in keys_query_outcome. Carries the prekey bundle under `algorithms` plus the convenience signing-key directory fields `device_signing_key` / `device_status` at the same level as the algorithm dimension (not repeated per algorithm). The directory facet is populated only for verified, non-revoked devices; see device-lifecycle.md §8.",
      "required": [
        "algorithms"
      ],
      "properties": {
        "algorithms": {
          "$ref": "#/$defs/algorithm_key_records"
        },
        "device_signing_key": {
          "$ref": "#/$defs/did_key"
        },
        "device_status": {
          "$ref": "#/$defs/device_status"
        },
        "cross_signing_binding": {
          "$ref": "#/$defs/cross_signing_binding"
        },
        "enrollment_authority_binding": {
          "$ref": "./event-payload.schema.json#/$defs/device_enrollment_authority_binding"
        },
        "device_authorize_event_id": {
          "$ref": "#/$defs/event_id",
          "description": "Accepted ck.device.authorize event id anchoring the current device-set projection. For service_attested / enrollment-authority devices this pairs with enrollment_authority_binding and identifies the accepted authorization event whose payload.device_public_key is exposed as device_signing_key."
        }
      },
      "additionalProperties": false
    },
    "query_device_keys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/device_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/query_device_record"
      }
    },
    "query_principal_device_keys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did"
      },
      "additionalProperties": {
        "$ref": "#/$defs/query_device_keys"
      }
    },
    "device_algorithm_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/device_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "principal_device_algorithm_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device_algorithm_map"
      }
    },
    "query_device_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/device_id"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "key_record": {
      "type": "object",
      "required": [
        "key",
        "algorithm",
        "signature"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/base64url"
        },
        "algorithm": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "key_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "key_digest": {
          "$ref": "#/$defs/hash"
        },
        "fallback": {
          "type": "boolean"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "algorithm": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "backup_class": {
      "type": "string",
      "enum": [
        "did_recovery",
        "secret_storage",
        "mls_history"
      ]
    },
    "backup_metadata": {
      "type": "object",
      "required": [
        "backup_id",
        "actor_id",
        "backup_class",
        "backup_version",
        "series_id",
        "series_seq",
        "created_at",
        "ciphertext_digest",
        "encryption"
      ],
      "properties": {
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "backup_class": {
          "$ref": "#/$defs/backup_class"
        },
        "backup_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "series_seq": {
          "type": "integer",
          "minimum": 0
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/backup_id"
            }
          ]
        },
        "supersedes_digest": {
          "$ref": "#/$defs/hash"
        },
        "frontier_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery_policy_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/hash"
        },
        "encryption": {
          "type": "object",
          "description": "Non-secret recipient metadata so the client can categorize a backup (recovery_public_key vs passphrase_kdf vs secret_storage_key) without downloading the ciphertext. The aead/kdf material is withheld from the list summary.",
          "required": [
            "recipient_method"
          ],
          "properties": {
            "recipient_method": {
              "type": "string",
              "enum": [
                "passphrase_kdf",
                "recovery_public_key",
                "secret_storage_key"
              ]
            },
            "recipient_key_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "keys_upload_request_body": {
      "type": "object",
      "required": [
        "device_id",
        "device_signature"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_signature": {
          "$ref": "#/$defs/signature"
        },
        "one_time_keys": {
          "$ref": "#/$defs/algorithm_key_records"
        },
        "fallback_keys": {
          "$ref": "#/$defs/algorithm_key_records"
        }
      },
      "additionalProperties": false
    },
    "keys_upload_outcome": {
      "type": "object",
      "required": [
        "one_time_key_counts"
      ],
      "properties": {
        "one_time_key_counts": {
          "$ref": "#/$defs/algorithm_counts"
        },
        "fallback_keys": {
          "$ref": "#/$defs/algorithm_key_records"
        }
      },
      "additionalProperties": false
    },
    "keys_query_request_body": {
      "type": "object",
      "required": [
        "device_keys"
      ],
      "properties": {
        "device_keys": {
          "$ref": "#/$defs/query_device_map"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "keys_query_outcome": {
      "type": "object",
      "required": [
        "device_keys"
      ],
      "properties": {
        "device_keys": {
          "$ref": "#/$defs/query_principal_device_keys"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "cross_signing": {
          "type": "object",
          "description": "Tier-2: {principal_id} -> that principal's current accepted-generation ck.cross_signing.publish payload (device-lifecycle.md §5.1). Lets receivers anchor the SSK to the DID control set before trusting cross_signing_binding. See device-lifecycle.md §8.3.",
          "propertyNames": {
            "$ref": "#/$defs/did"
          },
          "additionalProperties": {
            "$ref": "./cross-signing-publish.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "keys_claim_request_body": {
      "type": "object",
      "required": [
        "one_time_keys"
      ],
      "properties": {
        "one_time_keys": {
          "$ref": "#/$defs/principal_device_algorithm_map"
        }
      },
      "additionalProperties": false
    },
    "keys_claim_outcome": {
      "type": "object",
      "required": [
        "one_time_keys"
      ],
      "properties": {
        "one_time_keys": {
          "$ref": "#/$defs/principal_device_key_records"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    },
    "keys_backups_replace_outcome": {
      "type": "object",
      "required": [
        "status",
        "backup_id",
        "ciphertext_digest"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_list": {
      "type": "object",
      "required": [
        "backups",
        "has_more"
      ],
      "properties": {
        "backups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backup_metadata"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_unlock_request_body": {
      "type": "object",
      "description": "Request body for ck.self.keys.backups.command.unlock. The unlock proof MUST validate as ck.schema.key_backup_unlock_proof.v1 and MUST be verified against the recovery session, caller, requesting device key, active-series record, and target envelope before the full ciphertext is returned (key-management.md §7.7.1 / §7.8). The path backup_id and proof.backup_id MUST match.",
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "$ref": "./key-backup-unlock-proof.schema.json"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_delete_request_body": {
      "type": "object",
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "$ref": "#/$defs/proof"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_delete_outcome": {
      "type": "object",
      "required": [
        "deleted"
      ],
      "properties": {
        "deleted": {
          "type": "boolean",
          "const": true
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        }
      },
      "additionalProperties": false
    },
    "cross_signing_binding": {
      "type": "object",
      "description": "Tier-2 device trust binding echoed from ck.device.authorize.payload.cross_signing_binding (device-lifecycle.md §5.2). The accepted-generation SSK signs `\"ck-device-trust-bind-v1\n\" + canonical_json({principal_id, device_id, device_public_key, ssk_generation})`. Absent for inception bootstrap devices (§5.0.1).",
      "required": [
        "verification_method",
        "ssk_generation",
        "signature"
      ],
      "properties": {
        "verification_method": {
          "$ref": "#/$defs/non_empty_string",
          "description": "DID URL of the self-signing key (SSK) that produced the binding signature, e.g. did:webvh:...#ck_self_signing_v1."
        },
        "alg": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ssk_generation": {
          "type": "integer",
          "minimum": 0,
          "description": "cross_signing.publish generation under which the SSK signed this device binding; compared to the principal's accepted generation per device-lifecycle.md §5.2.1."
        },
        "signature": {
          "$ref": "#/$defs/base64url"
        }
      },
      "additionalProperties": false
    }
  }
}
