{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/keys-operations.schema.json",
  "title": "Arkret Device Key Operation DTOs",
  "description": "Closed request and response DTOs for ak.keys.{upload,query,claim} and ak.keys.backups.{put,list,delete}. Individual OpenAPI components reference the $defs entries in this bundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/keys_upload_request_body"
    },
    {
      "$ref": "#/$defs/keys_upload_outcome"
    },
    {
      "$ref": "#/$defs/keys_query_request_body"
    },
    {
      "$ref": "#/$defs/keys_query_outcome"
    },
    {
      "$ref": "#/$defs/keys_claim_request_body"
    },
    {
      "$ref": "#/$defs/keys_claim_outcome"
    },
    {
      "$ref": "#/$defs/keys_backups_replace_outcome"
    },
    {
      "$ref": "#/$defs/keys_backups_list"
    },
    {
      "$ref": "#/$defs/keys_backups_issue_delete_challenge_request_body"
    },
    {
      "$ref": "#/$defs/keys_backups_delete_challenge"
    },
    {
      "$ref": "#/$defs/keys_backups_delete_request_body"
    },
    {
      "$ref": "#/$defs/keys_backups_delete_outcome"
    },
    {
      "$ref": "#/$defs/backup_series_erase_request_body"
    },
    {
      "$ref": "#/$defs/backup_series_erase_outcome"
    }
  ],
  "$defs": {
    "did_core_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "device_id": {
      "$ref": "./account-operations.schema.json#/$defs/device_id"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "backup_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_id"
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "cursor": {
      "$ref": "./authz-operations.schema.json#/$defs/cursor"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "base64url": {
      "$ref": "./agent-operations.schema.json#/$defs/base64url"
    },
    "signature": {
      "$ref": "./keypackage-operations.schema.json#/$defs/signature"
    },
    "request_id": {
      "$ref": "#/$defs/base64url",
      "minLength": 22,
      "maxLength": 128,
      "description": "Client-generated idempotency id. The service keys the canonical request digest and terminal outcome by (principal_id, backup_id, request_id)."
    },
    "keys_backups_delete_proof": {
      "$ref": "./high-risk-authority-proof.schema.json",
      "description": "High-risk authority proof over the canonical delete-intent transcript of key-management.md section 7.8.1. Exactly one of principal_signing, device_quorum or trusted_recovery_service; an ordinary current-device session proof is not accepted for active-series tail deletion."
    },
    "algorithm_counts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "algorithm_key_records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/key_record"
      }
    },
    "device_key_records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/device_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/algorithm_key_records"
      }
    },
    "principal_device_key_records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did_core_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device_key_records"
      }
    },
    "did_key": {
      "type": "string",
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$",
      "description": "Authoritative device signing key as an Ed25519 did:key (multibase base58btc, multicodec ed25519-pub). Mirrors ak.device.authorize.payload.device_public_key (device-lifecycle.md §5.2 / §5.4). To check SignalEnvelope and durable Event proofs, receivers resolve a verification_method DID URL under the verified principal did, validate its bare did through the registered adapter, require project(did) to equal the actor/principal did_core_id, and require its fragment to equal the full ak:device:<uuidv7> id. Constructing a verification method by appending a fragment to did_core_id is forbidden."
    },
    "device_generation_state": {
      "type": "object",
      "description": "Reducer-managed identity-root generation fence for the principal device directory.",
      "required": [
        "current_device_generation_ref",
        "device_generation_status"
      ],
      "properties": {
        "current_device_generation_ref": {
          "$ref": "./recovery-session.schema.json#/$defs/pcr_generation_ref",
          "description": "PCR-local monotonic generation; it is not and MUST NOT be derived from a DID versionId."
        },
        "device_generation_status": {
          "type": "string",
          "enum": [
            "active",
            "conflicted"
          ]
        }
      },
      "additionalProperties": false
    },
    "principal_device_generation_states": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did_core_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device_generation_state"
      }
    },
    "device_projection_attestation_core": {
      "type": "object",
      "description": "Origin Principal Server assertion that this exact device projection is the account's current accepted one. It is the whole verification closure of the cross-principal keys/query surface: the row carries no PCR genesis receipt, no device authorization chain and no accepted Seal, because that material is account-internal governance and is disclosed only through ak.self.identity.read.resolution_audit.v1 under exact current-holder authorization. Required device_authorize_event_id and authorized_generation_ref fields describe the closed shape of a returned usable row; they do not require an unauthorized device to have a partial projection. A device with no current accepted authorization is omitted or reported through the non-enumerating failure shape. attested_at is a monotone freshness marker and, with authorized_generation_ref, is the cache key of device-lifecycle.md section 8.3.",
      "required": [
        "principal_id",
        "principal_server_id",
        "device_id",
        "device_signing_key_did",
        "hpke_key",
        "device_authorize_event_id",
        "authorized_generation_ref",
        "device_status",
        "attested_at",
        "expires_at"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/did_core_id"
        },
        "principal_server_id": {
          "$ref": "#/$defs/did_core_id",
          "description": "Origin Principal Server of the account. The proof controller MUST project exactly onto this value; an attestation that verifies under any other key is not evidence about this device."
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_signing_key_did": {
          "$ref": "#/$defs/did_key"
        },
        "hpke_key": {
          "$ref": "#/$defs/non_empty_string"
        },
        "device_authorize_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "authorized_generation_ref": {
          "$ref": "./recovery-session.schema.json#/$defs/pcr_generation_ref"
        },
        "device_status": {
          "const": "active",
          "description": "This surface attests usable devices only. A revoked, fenced or conflicted device is omitted from device_keys or reported through the non-enumerating failures shape, so the attested status is constant rather than a disclosure channel."
        },
        "attested_at": {
          "$ref": "#/$defs/timestamp",
          "description": "MUST be strictly earlier than expires_at and MUST equal proof.created_at."
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "Hard freshness bound. A consumer performing a security-sensitive action MUST refetch at or after this instant; a cache never extends it."
        }
      },
      "additionalProperties": false
    },
    "device_projection_attestation": {
      "type": "object",
      "description": "Complete origin-Principal-Server-signed device projection attestation. The detached proof signs the ak.device_projection_attestation_proof.v1 transcript; proof.created_at MUST equal attestation.attested_at.",
      "required": [
        "attestation",
        "proof"
      ],
      "properties": {
        "attestation": {
          "$ref": "#/$defs/device_projection_attestation_core"
        },
        "proof": {
          "$ref": "./principal-operations.schema.json#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "query_device_record": {
      "type": "object",
      "description": "Per-(principal_id, device_id) entry in keys_query_outcome. principal_id and device_id are the device_keys map keys, not row fields. Every returned row is complete and attested: the origin Principal Server signs the exact projection, so a relationship-gated third party can verify the row without ever seeing PCR material. A device whose generation is fenced or conflicted, or which is revoked, is not degraded into a partial row -- it is omitted from device_keys or reported through the non-enumerating failures shape, so an incomplete row can never be mistaken for a usable one.",
      "required": [
        "algorithms",
        "trust_algorithms",
        "device_projection_attestation"
      ],
      "properties": {
        "algorithms": {
          "$ref": "#/$defs/algorithm_key_records"
        },
        "trust_algorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "description": "The canonical (UTF-8 bytewise sorted, deduplicated) algorithm ids echoed verbatim from ak.device.authorize.payload.algorithms; together with device_signing_key and hpke_key this is the material the §5.2 ak.device-trust-bind-v1 transcript covers. Distinct from the sibling `algorithms` prekey-bundle map."
        },
        "device_projection_attestation": {
          "$ref": "#/$defs/device_projection_attestation",
          "description": "Origin-Principal-Server signature over the authoritative device projection. Consumers read device_signing_key, hpke_key, device_status, device_authorize_event_id and authorized_generation_ref from the verified attestation. A row whose attestation is missing or whose controller does not project onto principal_server_id MUST NOT be used for E2EE, Signal verification or a KeyPackage claim."
        }
      },
      "additionalProperties": false
    },
    "query_device_keys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/device_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/query_device_record"
      }
    },
    "query_principal_device_keys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did_core_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/query_device_keys"
      }
    },
    "device_algorithm_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/device_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "principal_device_algorithm_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did_core_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device_algorithm_map"
      }
    },
    "query_device_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/did_core_id"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/device_id"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "key_record": {
      "type": "object",
      "required": [
        "key",
        "algorithm",
        "signature"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/base64url"
        },
        "algorithm": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "key_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "key_digest": {
          "$ref": "#/$defs/digest"
        },
        "fallback": {
          "type": "boolean"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "reason_code"
      ],
      "properties": {
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "algorithm": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason_code": {
          "$ref": "#/$defs/non_empty_string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "backup_kind": {
      "$ref": "./key-backup-active-series.schema.json#/$defs/backup_kind"
    },
    "backup_metadata": {
      "type": "object",
      "required": [
        "backup_id",
        "actor_id",
        "backup_kind",
        "backup_version",
        "series_id",
        "series_seq",
        "created_at",
        "ciphertext_digest",
        "encryption"
      ],
      "properties": {
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "backup_kind": {
          "$ref": "#/$defs/backup_kind"
        },
        "backup_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "series_seq": {
          "type": "integer",
          "minimum": 0
        },
        "supersedes_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/backup_id"
            }
          ]
        },
        "supersedes_digest": {
          "$ref": "#/$defs/digest"
        },
        "frontier_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "recovery_policy_ref": {
          "type": "object",
          "additionalProperties": true
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/digest"
        },
        "encryption": {
          "type": "object",
          "description": "Non-secret recipient metadata so the client can categorize a backup (recovery_public_key vs passphrase_kdf vs secret_storage_key) without downloading the ciphertext. The aead/kdf material is withheld from the list summary.",
          "required": [
            "recipient_method"
          ],
          "properties": {
            "recipient_method": {
              "type": "string",
              "enum": [
                "passphrase_kdf",
                "recovery_public_key",
                "secret_storage_key"
              ]
            },
            "recipient_key_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "keys_upload_request_body": {
      "type": "object",
      "required": [
        "device_id",
        "device_signature"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_signature": {
          "$ref": "#/$defs/signature"
        },
        "one_time_keys": {
          "$ref": "#/$defs/algorithm_key_records"
        },
        "fallback_keys": {
          "$ref": "#/$defs/algorithm_key_records"
        }
      },
      "additionalProperties": false
    },
    "keys_upload_outcome": {
      "type": "object",
      "required": [
        "one_time_key_counts"
      ],
      "properties": {
        "one_time_key_counts": {
          "$ref": "#/$defs/algorithm_counts"
        },
        "fallback_keys": {
          "$ref": "#/$defs/algorithm_key_records"
        }
      },
      "additionalProperties": false
    },
    "keys_query_request_body": {
      "type": "object",
      "required": [
        "device_keys"
      ],
      "properties": {
        "device_keys": {
          "$ref": "#/$defs/query_device_map"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "keys_query_outcome": {
      "type": "object",
      "x-arkret-pcr-outward-event-kinds": [
        "ak.device.authorize",
        "ak.device.list_update",
        "ak.device.reanchor",
        "ak.device.revoke"
      ],
      "required": [
        "device_keys"
      ],
      "properties": {
        "device_keys": {
          "$ref": "#/$defs/query_principal_device_keys"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "device_generations": {
          "$ref": "#/$defs/principal_device_generation_states",
          "description": "Current identity-root generation fence by principal. Fenced/conflicted principals or mismatched device generations expose no usable signing/HPKE/prekey material."
        }
      },
      "additionalProperties": false
    },
    "keys_claim_request_body": {
      "type": "object",
      "required": [
        "one_time_keys"
      ],
      "properties": {
        "one_time_keys": {
          "$ref": "#/$defs/principal_device_algorithm_map"
        }
      },
      "additionalProperties": false
    },
    "keys_claim_outcome": {
      "type": "object",
      "required": [
        "one_time_keys"
      ],
      "properties": {
        "one_time_keys": {
          "$ref": "#/$defs/principal_device_key_records"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "additionalProperties": false
    },
    "keys_backups_replace_outcome": {
      "type": "object",
      "required": [
        "status",
        "backup_id",
        "ciphertext_digest"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "duplicate"
          ]
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_list": {
      "type": "object",
      "required": [
        "backups",
        "has_more"
      ],
      "properties": {
        "backups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backup_metadata"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_unlock_request_body": {
      "type": "object",
      "description": "Request body for ak.self.keys.backups.command.unlock.v1. The unlock proof MUST validate as ak.schema.key_backup_unlock_proof.v1 and MUST be verified against the recovery session, caller, requesting device key, active-series record, and target envelope before the full ciphertext is returned (key-management.md §7.7.1 / §7.8). The path backup_id and proof.backup_id MUST match.",
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "$ref": "./key-backup-unlock-proof.schema.json"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_issue_delete_challenge_request_body": {
      "type": "object",
      "description": "Request body for ak.self.keys.backups.command.issue_delete_challenge.v1. While an issued challenge for the same (principal_id, backup_id, request_id) is still valid, the service MUST return the same challenge; a different request_id mints a new challenge.",
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_delete_challenge": {
      "type": "object",
      "description": "Server-issued, durable, single-use delete challenge (TTL <= 300s). Every field is materialized by the service; the client echoes challenge_id in the DELETE body and every proof signs the canonical delete-intent transcript of key-management.md section 7.8.1, which embeds these exact values. Replay, expiry, path mismatch, or audience/service mismatch MUST fail closed.",
      "required": [
        "challenge_id",
        "challenge",
        "nonce",
        "operation",
        "principal_id",
        "backup_id",
        "audience",
        "service_id",
        "request_id",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "challenge_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128,
          "description": "Server-issued unique id of this challenge; echoed verbatim in the DELETE request body."
        },
        "challenge": {
          "$ref": "#/$defs/base64url",
          "description": "Server-issued CSPRNG challenge bytes (base64url, no padding)."
        },
        "nonce": {
          "$ref": "#/$defs/base64url",
          "description": "Server-issued CSPRNG nonce bytes (base64url, no padding); distinct from challenge so the transcript binds two independent freshness values."
        },
        "operation": {
          "const": "ak.self.keys.backups.resource.delete.v1"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "audience": {
          "$ref": "#/$defs/non_empty_string",
          "description": "The service base origin this challenge is valid against; MUST match the origin the DELETE request is sent to."
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "request_id": {
          "$ref": "#/$defs/request_id",
          "description": "Echo of the issuance request_id this challenge was minted for."
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_delete_request_body": {
      "type": "object",
      "description": "Request body for ak.self.keys.backups.resource.delete.v1. The service verifies the referenced challenge against the current caller/path/service, verifies the high-risk proof over the canonical delete-intent transcript, and consumes the challenge in the same transaction as the successful delete. A byte-identical network retry returns the stored terminal outcome without re-admitting the consumed challenge; the same request_id with a different canonical digest is a duplicate conflict.",
      "required": [
        "request_id",
        "challenge_id",
        "proof"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "challenge_id": {
          "$ref": "#/$defs/base64url",
          "minLength": 22,
          "maxLength": 128,
          "description": "Exact echo of the server-issued challenge_id being consumed."
        },
        "proof": {
          "$ref": "#/$defs/keys_backups_delete_proof"
        },
        "reason": {
          "$ref": "string-profiles.schema.json#/$defs/audit_reason_text"
        }
      },
      "additionalProperties": false
    },
    "keys_backups_delete_outcome": {
      "type": "object",
      "required": [
        "deleted"
      ],
      "properties": {
        "deleted": {
          "type": "boolean",
          "const": true
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        }
      },
      "additionalProperties": false
    },
    "backup_series_erase_request_body": {
      "type": "object",
      "description": "Transaction-bound exact request for erasing every old backup object reserved by one SecurityRotationTransaction plan.",
      "required": [
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "erase_confirmation_digest",
        "series",
        "authorization_lease"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "./security-transaction.schema.json#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/digest"
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "./security-transaction.schema.json#/$defs/backup_rotation_binding"
          }
        },
        "authorization_lease": {
          "$ref": "./offline-publication.schema.json#/$defs/authorization_lease"
        },
        "cba_proof_bundles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./cba-proof-bundle.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "backup_series_erase_result": {
      "type": "object",
      "required": [
        "backup_kind",
        "previous_series_id",
        "new_series_id",
        "status",
        "erased_backups",
        "remaining_backups"
      ],
      "properties": {
        "backup_kind": {
          "type": "string",
          "enum": [
            "secret_storage",
            "mls_history"
          ]
        },
        "previous_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "failed_retryable",
            "erased"
          ]
        },
        "erased_backups": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "./security-transaction.schema.json#/$defs/backup_object_ref"
          }
        },
        "remaining_backups": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "./security-transaction.schema.json#/$defs/backup_object_ref"
          }
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "backup_series_erase_confirmation": {
      "type": "object",
      "required": [
        "schema",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "series"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.backup_series_erase_confirmation.v1"
        },
        "transaction_id": {
          "$ref": "./security-transaction.schema.json#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "./security-transaction.schema.json#/$defs/backup_rotation_binding"
          }
        }
      },
      "additionalProperties": false
    },
    "backup_series_erase_outcome": {
      "type": "object",
      "required": [
        "transaction_id",
        "request_digest",
        "status",
        "series_results"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "./security-transaction.schema.json#/$defs/transaction_id"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "partial",
            "complete"
          ]
        },
        "series_results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_series_erase_result"
          }
        },
        "confirmation": {
          "$ref": "#/$defs/backup_series_erase_confirmation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "confirmation"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
