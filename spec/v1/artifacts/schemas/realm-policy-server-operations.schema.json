{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/realm-policy-server-operations.schema.json",
  "title": "Arkret Realm Policy-Server Self-Management Operation DTOs",
  "description": "Closed request/response DTOs for the self-surface Realm policy-server config operations (ak.self.realm_policy_server.*). PUT builds a durable ak.realm.policy_server Move from the request body and uses head_eq when a direct value exists. DELETE of a settled direct declaration builds the same kind with payload {tombstone:true} and head_eq; an existing tombstone is an idempotent empty success, while a never-written or inherited-only direct cell returns not_found. Both mutation operations require ak.policy.manage; see spec/v1/zh/authz/policy-server.md §2.",
  "anyOf": [
    {
      "$ref": "#/$defs/realm_policy_server_replace_request_body"
    },
    {
      "$ref": "#/$defs/realm_policy_server_view"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "on_timeout": {
      "type": "string",
      "enum": [
        "fail_closed",
        "deny"
      ]
    },
    "realm_policy_server_view": {
      "type": "object",
      "required": [
        "realm_id",
        "policy_server_did",
        "policy_server_url",
        "cache_ttl_seconds",
        "timeout_ms",
        "on_timeout",
        "updated_at",
        "from_org_fallback"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "policy_server_did": {
          "$ref": "#/$defs/did"
        },
        "policy_server_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/_arkret/self/policy/check$"
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "on_timeout": {
          "$ref": "#/$defs/on_timeout"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "from_org_fallback": {
          "type": "boolean",
          "description": "True when the config was resolved via the governed_by / org-fallback chain rather than a row on the Realm itself."
        }
      },
      "additionalProperties": false
    },
    "realm_policy_server_replace_request_body": {
      "type": "object",
      "required": [
        "policy_server_did",
        "policy_server_url"
      ],
      "properties": {
        "policy_server_did": {
          "$ref": "#/$defs/did"
        },
        "policy_server_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/_arkret/self/policy/check$"
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "on_timeout": {
          "$ref": "#/$defs/on_timeout",
          "default": "fail_closed"
        }
      },
      "additionalProperties": false
    }
  }
}
