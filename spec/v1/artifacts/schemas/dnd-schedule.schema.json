{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/dnd-schedule.schema.json",
  "title": "Arkret DND Schedule Account Data",
  "description": "Closed decrypted plaintext shape for ak.dnd_schedule. Period ordering, IANA canonical-name validation, overlap/adjacency rejection, and tzdb equality are semantic validation steps in addition to this schema.",
  "$comment": "Conformance vector: ak.vector.dnd.schedule_boundary_validation.v1",
  "type": "object",
  "required": [
    "dnd"
  ],
  "properties": {
    "dnd": {
      "$ref": "#/$defs/dnd_settings"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hhmm": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/hhmm"
        },
        "end": {
          "$ref": "#/$defs/hhmm"
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "timezone",
        "tzdb_version",
        "all_day",
        "periods"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^(?:Etc/UTC|[A-Za-z][A-Za-z0-9._+-]*/[A-Za-z][A-Za-z0-9._+/-]*)$",
          "description": "Canonical case-sensitive IANA zone name; aliases and the token local are forbidden by semantic validation."
        },
        "tzdb_version": {
          "const": "2025b"
        },
        "all_day": {
          "type": "boolean"
        },
        "periods": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/period"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "all_day": {
                "const": true
              }
            },
            "required": [
              "all_day"
            ]
          },
          "then": {
            "properties": {
              "periods": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "dnd_settings": {
      "type": "object",
      "required": [
        "enabled",
        "schedule",
        "exceptions"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "exceptions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    }
  }
}
