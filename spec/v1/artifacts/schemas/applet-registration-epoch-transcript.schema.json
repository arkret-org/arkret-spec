{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-registration-epoch-transcript.schema.json",
  "title": "Arkret Applet Registration Epoch Transcript",
  "description": "Closed security transcript for a single did:webvh Applet subject; transport and exact account projection are security bindings.",
  "type": "object",
  "required": [
    "schema",
    "derived_registration",
    "service_did_document",
    "accepted_signing_keys",
    "endpoint_policy",
    "webhook_auth",
    "security_policy"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.applet_registration_epoch_transcript.v1"
    },
    "derived_registration": {
      "$ref": "#/$defs/derived_registration"
    },
    "service_did_document": {
      "$ref": "#/$defs/service_did_document"
    },
    "accepted_signing_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/accepted_signing_key"
      }
    },
    "endpoint_policy": {
      "$ref": "./applet-package.schema.json#/$defs/endpoint_policy"
    },
    "webhook_auth": {
      "$ref": "./applet-package.schema.json#/$defs/webhook_auth"
    },
    "security_policy": {
      "$ref": "#/$defs/security_policy"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "did": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "string_set": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "derived_registration": {
      "type": "object",
      "required": [
        "kind",
        "applet_id",
        "service_id",
        "controller_principal_id",
        "transport",
        "applet_actor_id",
        "protocols",
        "namespaces",
        "receive_events",
        "receive_signals",
        "rate_limited",
        "requested_scopes",
        "created_at"
      ],
      "properties": {
        "kind": {
          "const": "ak.applet.registration"
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "allOf": [
            {
              "$ref": "./common-ids.schema.json#/$defs/did_core_id"
            },
            {
              "type": "string",
              "pattern": "^ak:did_core:webvh:[^\\s/?#]+$"
            }
          ]
        },
        "controller_principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id",
          "x-arkret-principal-kinds": [
            "human",
            "organization"
          ]
        },
        "transport": {
          "$ref": "./applet-package.schema.json#/$defs/applet_transport"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "applet_actor_id": {
          "allOf": [
            {
              "$ref": "./common-ids.schema.json#/$defs/actor_id"
            },
            {
              "properties": {
                "kind": {
                  "const": "account"
                }
              },
              "required": [
                "kind"
              ]
            }
          ],
          "description": "Applet account projection. Its principal_id MUST equal service_id; Station identity remains exact. This is not a second DID."
        },
        "protocols": {
          "$ref": "#/$defs/string_set"
        },
        "namespaces": {
          "$ref": "./applet-package.schema.json#/$defs/applet_namespaces"
        },
        "receive_events": {
          "type": "boolean"
        },
        "receive_signals": {
          "type": "boolean"
        },
        "rate_limited": {
          "type": "boolean"
        },
        "requested_scopes": {
          "$ref": "#/$defs/string_set"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "properties": {
                  "kind": {
                    "const": "https_push"
                  }
                }
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "required": [
              "base_url"
            ]
          },
          "else": {
            "not": {
              "required": [
                "base_url"
              ]
            }
          }
        }
      ]
    },
    "service_did_document": {
      "type": "object",
      "required": [
        "did",
        "document_digest",
        "method_version"
      ],
      "properties": {
        "did": {
          "$ref": "#/$defs/did",
          "description": "Complete service DID whose adapter projection MUST equal derived_registration.service_id."
        },
        "document_digest": {
          "$ref": "#/$defs/digest"
        },
        "method_version": {
          "$ref": "#/$defs/did_method_version"
        }
      },
      "additionalProperties": false
    },
    "did_method_version": {
      "type": "object",
      "required": [
        "method",
        "unversioned_refetch"
      ],
      "properties": {
        "method": {
          "const": "did:webvh"
        },
        "version_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "version_time": {
          "$ref": "#/$defs/timestamp"
        },
        "unversioned_refetch": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": {
              "enum": [
                "did:webvh",
                "did:key"
              ]
            },
            "unversioned_refetch": {
              "const": false
            }
          },
          "required": [
            "method",
            "version_id",
            "unversioned_refetch"
          ]
        },
        {
          "required": [
            "method",
            "version_time",
            "unversioned_refetch"
          ],
          "properties": {
            "method": {
              "const": "did:webvh"
            },
            "unversioned_refetch": {
              "const": false
            }
          },
          "not": {
            "required": [
              "version_id"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "accepted_signing_key": {
      "type": "object",
      "required": [
        "key_ref",
        "public_key_digest"
      ],
      "properties": {
        "key_ref": {
          "$ref": "#/$defs/did_url"
        },
        "public_key_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "security_policy": {
      "type": "object",
      "required": [
        "claimed_profiles",
        "limits",
        "ghost_policy",
        "delegation_policy",
        "e2ee_policy"
      ],
      "properties": {
        "claimed_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ak\\.profile\\.[a-z0-9_.-]+\\.v1$"
          },
          "uniqueItems": true
        },
        "limits": {
          "$ref": "./applet-package.schema.json#/$defs/limits"
        },
        "ghost_policy": {
          "$ref": "./applet-package.schema.json#/$defs/ghost_policy"
        },
        "delegation_policy": {
          "$ref": "./applet-package.schema.json#/$defs/delegation_policy"
        },
        "e2ee_policy": {
          "$ref": "./applet-package.schema.json#/$defs/e2ee_policy"
        },
        "widget": {
          "$ref": "./applet-widget-declaration.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "derived_registration": {
            "properties": {
              "transport": {
                "properties": {
                  "kind": {
                    "const": "https_push"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "endpoint_policy": {
            "properties": {
              "endpoints": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "endpoint_policy": {
            "properties": {
              "endpoints": {
                "maxItems": 0
              }
            }
          },
          "derived_registration": {
            "properties": {
              "receive_signals": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
