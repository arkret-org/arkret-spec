{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/applet-registration-epoch-transcript.schema.json",
  "title": "Arkret Applet Registration Epoch Transcript",
  "description": "Closed, normalized security transcript hashed to produce an Applet registration_epoch. The hash input is the UTF-8 domain separator arkret-applet-registration-epoch-v1\\n followed by the JCS bytes of this object. Applet producer identity is restricted to versioned did:webvh or stable did:key so the same accepted state can form a historical Service signer root.",
  "type": "object",
  "required": [
    "schema",
    "derived_registration",
    "service_did_document",
    "accepted_signing_keys",
    "endpoint_policy",
    "webhook_signature_policy",
    "security_policy"
  ],
  "properties": {
    "schema": {
      "const": "ak.schema.applet_registration_epoch_transcript.v1",
      "x-arkret-value-ownership": {
        "class": "namespaced_symbol",
        "authority": "applet-registration-epoch-transcript.schema.json#/properties/schema",
        "owner": "applet-registration-epoch-transcript.schema.json#/properties/schema",
        "values": [
          "ak.schema.applet_registration_epoch_transcript.v1"
        ]
      }
    },
    "derived_registration": {
      "$ref": "#/$defs/derived_registration"
    },
    "service_did_document": {
      "$ref": "#/$defs/service_did_document"
    },
    "accepted_signing_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/accepted_signing_key"
      }
    },
    "endpoint_policy": {
      "$ref": "./applet-package.schema.json#/$defs/endpoint_policy"
    },
    "webhook_signature_policy": {
      "$ref": "./applet-package.schema.json#/$defs/webhook_signature_policy"
    },
    "security_policy": {
      "$ref": "#/$defs/security_policy"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "did": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "did_url": {
      "$ref": "./account-operations.schema.json#/$defs/did_url"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "non_empty_string": {
      "$ref": "./account-operations.schema.json#/$defs/non_empty_string"
    },
    "string_set": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true,
      "x-arkret-canonical-order": "Sort by canonical encoded element bytes; elements MUST be unique."
    },
    "derived_registration": {
      "type": "object",
      "required": [
        "kind",
        "applet_id",
        "service_id",
        "controller_principal_id",
        "base_url",
        "protocols",
        "namespaces",
        "receive_events",
        "receive_signals",
        "rate_limited",
        "requested_scopes",
        "created_at"
      ],
      "properties": {
        "kind": {
          "const": "ak.applet.registration",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "applet-registration-epoch-transcript.schema.json#/$defs/derived_registration/properties/kind",
            "owner": "applet-registration-epoch-transcript.schema.json#/$defs/derived_registration/properties/kind",
            "values": [
              "ak.applet.registration"
            ]
          }
        },
        "applet_id": {
          "$ref": "./common-ids.schema.json#/$defs/applet_id"
        },
        "service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "controller_principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id",
          "x-arkret-principal-kinds": [
            "human",
            "organization"
          ]
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "protocols": {
          "$ref": "#/$defs/string_set"
        },
        "namespaces": {
          "$ref": "./applet-package.schema.json#/$defs/applet_namespaces"
        },
        "receive_events": {
          "type": "boolean"
        },
        "receive_signals": {
          "type": "boolean"
        },
        "rate_limited": {
          "type": "boolean"
        },
        "requested_scopes": {
          "$ref": "#/$defs/string_set"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "service_did_document": {
      "type": "object",
      "required": [
        "did",
        "document_digest",
        "method_version"
      ],
      "properties": {
        "did": {
          "$ref": "#/$defs/did",
          "description": "Complete service DID whose adapter projection MUST equal derived_registration.service_id."
        },
        "document_digest": {
          "$ref": "#/$defs/digest"
        },
        "method_version": {
          "$ref": "#/$defs/did_method_version"
        }
      },
      "additionalProperties": false
    },
    "did_method_version": {
      "type": "object",
      "required": [
        "method",
        "unversioned_refetch"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+$"
        },
        "version_id": {
          "allOf": [
            {
              "$ref": "#/$defs/non_empty_string"
            },
            {
              "$ref": "string-profiles.schema.json#/$defs/non_typed_identifier_floor"
            }
          ]
        },
        "version_created_at": {
          "$ref": "#/$defs/timestamp",
          "x-arkret-member-role": "instant"
        },
        "unversioned_refetch": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": {
              "enum": [
                "did:webvh",
                "did:key"
              ],
              "x-arkret-value-ownership": {
                "class": "uri",
                "authority": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/0/properties/method",
                "owner": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/0/properties/method",
                "values": [
                  "did:webvh",
                  "did:key"
                ]
              }
            },
            "unversioned_refetch": {
              "const": false,
              "x-arkret-value-ownership": {
                "class": "numeric",
                "authority": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/0/properties/unversioned_refetch",
                "owner": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/0/properties/unversioned_refetch",
                "values": [
                  false
                ]
              }
            }
          },
          "required": [
            "method",
            "unversioned_refetch",
            "version_id"
          ]
        },
        {
          "required": [
            "method",
            "unversioned_refetch",
            "version_created_at"
          ],
          "properties": {
            "method": {
              "const": "did:webvh",
              "x-arkret-value-ownership": {
                "class": "uri",
                "authority": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/1/properties/method",
                "owner": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/1/properties/method",
                "values": [
                  "did:webvh"
                ]
              }
            },
            "unversioned_refetch": {
              "const": false,
              "x-arkret-value-ownership": {
                "class": "numeric",
                "authority": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/1/properties/unversioned_refetch",
                "owner": "applet-registration-epoch-transcript.schema.json#/$defs/did_method_version/oneOf/1/properties/unversioned_refetch",
                "values": [
                  false
                ]
              }
            }
          },
          "not": {
            "required": [
              "version_id"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "accepted_signing_key": {
      "type": "object",
      "required": [
        "key_ref",
        "public_key_digest"
      ],
      "properties": {
        "key_ref": {
          "$ref": "#/$defs/did_url"
        },
        "public_key_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "security_policy": {
      "type": "object",
      "required": [
        "claimed_profiles",
        "limits",
        "ghost_policy",
        "delegation_policy",
        "e2ee_policy"
      ],
      "properties": {
        "claimed_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ak\\.profile\\.[a-z0-9_.-]+\\.v1$"
          },
          "uniqueItems": true
        },
        "limits": {
          "$ref": "./applet-package.schema.json#/$defs/limits"
        },
        "ghost_policy": {
          "$ref": "./applet-package.schema.json#/$defs/ghost_policy"
        },
        "delegation_policy": {
          "$ref": "./applet-package.schema.json#/$defs/delegation_policy"
        },
        "e2ee_policy": {
          "$ref": "./applet-package.schema.json#/$defs/e2ee_policy"
        },
        "widget": {
          "$ref": "./applet-widget-declaration.schema.json"
        }
      },
      "additionalProperties": false
    }
  }
}
