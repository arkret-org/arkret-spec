{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/account-current-result.schema.json",
  "title": "Arkret Account Current Result",
  "description": "Account Station view of authority-committed typed current results. The legacy typed current result selector surface does not exist.",
  "oneOf": [
    {
      "$ref": "#/$defs/current"
    },
    {
      "$ref": "#/$defs/coverage"
    }
  ],
  "$defs": {
    "entry": {
      "$ref": "./typed-current-result.schema.json"
    },
    "current": {
      "type": "object",
      "required": [
        "realm_id",
        "authority_generation",
        "stream_heads",
        "entries"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "authority_generation": {
          "type": "integer",
          "minimum": 0
        },
        "stream_heads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-commit.schema.json#/$defs/stream_head"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "realm_id",
        "stream_heads",
        "complete_for_authorized_streams"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "stream_heads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./realm-commit.schema.json#/$defs/stream_head"
          }
        },
        "complete_for_authorized_streams": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
