{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/authenticated-signer-resolution-evidence.schema.json",
  "title": "Arkret Authenticated Signer Resolution Evidence",
  "description": "Compact signer-key evidence binding a resolved key to one authority-committed stream revision.",
  "oneOf": [
    {
      "$ref": "#/$defs/principal_signer_evidence"
    },
    {
      "$ref": "#/$defs/service_signer_evidence"
    },
    {
      "$ref": "#/$defs/agent_signer_evidence"
    }
  ],
  "$defs": {
    "signer_evidence_ref": {
      "type": "string",
      "pattern": "^ak:signer_evidence:sha256:[0-9a-f]{64}$"
    },
    "public_key_jwk": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": true
    },
    "base": {
      "type": "object",
      "required": [
        "signer_kind",
        "subject_id",
        "verification_method",
        "public_key_jwk",
        "authority_commit_id",
        "resolved_at"
      ],
      "properties": {
        "signer_kind": {
          "enum": [
            "principal",
            "service",
            "agent"
          ]
        },
        "subject_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "public_key_jwk": {
          "$ref": "#/$defs/public_key_jwk"
        },
        "authority_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "resolved_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "principal_signer_evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "signer_kind": {
              "const": "principal"
            }
          }
        }
      ]
    },
    "service_signer_evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "signer_kind": {
              "const": "service"
            }
          }
        }
      ]
    },
    "agent_signer_evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "signer_kind": {
              "const": "agent"
            }
          }
        }
      ]
    }
  }
}
