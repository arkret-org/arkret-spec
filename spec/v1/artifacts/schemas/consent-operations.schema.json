{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/consent-operations.schema.json",
  "title": "Arkret Consent Cell Self-Management Operation DTOs",
  "description": "Closed request/response DTOs for holder-private consent cells. Only holders/controllers receive consent_cell_view; peer request submission returns an opaque outcome and never exposes cell state.",
  "anyOf": [
    {
      "$ref": "#/$defs/consent_cell_view"
    },
    {
      "$ref": "#/$defs/consent_cell_list"
    },
    {
      "$ref": "#/$defs/consent_update_request_body"
    },
    {
      "$ref": "#/$defs/consent_request_request_body"
    },
    {
      "$ref": "#/$defs/consent_request_outcome"
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^\\s#?]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "consent_scope": {
      "type": "string",
      "enum": [
        "invite",
        "direct_message",
        "voice_call",
        "video_call",
        "presence",
        "any"
      ]
    },
    "consent_state": {
      "type": "string",
      "enum": [
        "active",
        "no_consent"
      ]
    },
    "consent_cell_view": {
      "type": "object",
      "required": [
        "ok",
        "cell_id",
        "holder_did",
        "peer_did",
        "consent_scope",
        "state",
        "active_grant_dots",
        "grant_dots",
        "revoked_dots",
        "updated_at"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "cell_id": {
          "type": "string",
          "pattern": "^ak:cell:ak\\.component\\.consent\\.grant\\.v1:ak:consent:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Consent cell id (ak:cell:ak.component.consent.grant.v1:<consent_id>)."
        },
        "holder_did": {
          "$ref": "#/$defs/did"
        },
        "peer_did": {
          "$ref": "#/$defs/did"
        },
        "consent_scope": {
          "$ref": "#/$defs/consent_scope"
        },
        "state": {
          "$ref": "#/$defs/consent_state"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "requested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "active_grant_dots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Currently-active grant dots (not yet observed/revoked, within validity window)."
        },
        "grant_dots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revoked_dots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "consent_cell_list": {
      "type": "object",
      "required": [
        "ok",
        "cells"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consent_cell_view"
          }
        }
      },
      "additionalProperties": false
    },
    "consent_update_request_body": {
      "type": "object",
      "description": "Body for grant / revoke. The holder is taken from the path; the authenticated actor MUST be authorized to write the holder's consent (holder or an explicitly authorized controller/agent).",
      "required": [
        "peer_did"
      ],
      "properties": {
        "peer_did": {
          "$ref": "#/$defs/did"
        },
        "consent_scope": {
          "$ref": "#/$defs/consent_scope",
          "default": "direct_message"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "consent_request_request_body": {
      "type": "object",
      "description": "Body for opaque contact/consent request submission. peer_did defaults to the authenticated actor and MUST equal it. Holder existence is deliberately not a precondition visible to the caller.",
      "required": [
        "holder_did"
      ],
      "properties": {
        "holder_did": {
          "$ref": "#/$defs/did"
        },
        "peer_did": {
          "$ref": "#/$defs/did"
        },
        "consent_scope": {
          "$ref": "#/$defs/consent_scope",
          "default": "direct_message"
        }
      },
      "additionalProperties": false
    },
    "consent_request_outcome": {
      "type": "object",
      "description": "Constant anti-enumeration response. Missing holder, denial, rate-limit drop and quarantine acceptance all return this exact shape; no cell id, state, dots, timestamps or expiry are exposed.",
      "required": [
        "ok",
        "accepted_for_processing"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "accepted_for_processing": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  }
}
