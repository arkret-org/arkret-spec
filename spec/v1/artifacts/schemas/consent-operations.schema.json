{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/consent-operations.schema.json",
  "title": "Arkret Consent typed current result Self-Management Operation DTOs",
  "description": "Closed request/response DTOs for holder-private consent state serialized by the current governance Station.",
  "anyOf": [
    {
      "$ref": "#/$defs/consent_view"
    },
    {
      "$ref": "#/$defs/consent_list"
    },
    {
      "$ref": "#/$defs/consent_replace_request_body"
    },
    {
      "$ref": "#/$defs/consent_request_request_body"
    },
    {
      "$ref": "#/$defs/consent_request_outcome"
    },
    {
      "$ref": "#/$defs/consent_current_read_request_body"
    },
    {
      "$ref": "#/$defs/consent_current_read_outcome"
    }
  ],
  "$defs": {
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id"
    },
    "consent_peer": {
      "$ref": "./event-payload.schema.json#/$defs/consent_peer"
    },
    "timestamp": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "consent_scope": {
      "type": "string",
      "enum": [
        "invite",
        "voice_call",
        "video_call",
        "presence"
      ]
    },
    "consent_view": {
      "type": "object",
      "description": "Holder-private display summary only. Includes every stored scope regardless of effective window; empty scopes is a present current. Complete editing input requires current read.",
      "required": [
        "peer",
        "permission_scopes",
        "updated_at",
        "revision"
      ],
      "properties": {
        "peer": {
          "$ref": "#/$defs/consent_peer"
        },
        "permission_scopes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/consent_scope"
          }
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revision": {
          "$ref": "./typed-current-result.schema.json#/$defs/revision"
        }
      },
      "additionalProperties": false
    },
    "consent_list": {
      "type": "object",
      "required": [
        "consents"
      ],
      "properties": {
        "consents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consent_view"
          }
        }
      },
      "additionalProperties": false
    },
    "consent_replace_request_body": {
      "type": "object",
      "description": "One caller-signed complete ak.consent.replace Event, submitted unchanged under holder root-control-only authorization and exact expected_current CAS.",
      "required": [
        "consent_event"
      ],
      "properties": {
        "consent_event": {
          "allOf": [
            {
              "$ref": "./service-operation-dtos.schema.json#/$defs/EventAdmissionSubmission"
            },
            {
              "properties": {
                "event": {
                  "properties": {
                    "kind": {
                      "const": "ak.consent.replace"
                    },
                    "payload": {
                      "$ref": "./event-payload.schema.json#/$defs/consent_replace_payload"
                    }
                  },
                  "required": [
                    "kind",
                    "realm_id"
                  ]
                }
              },
              "required": [
                "event"
              ]
            }
          ],
          "description": "One caller-signed complete ak.consent.replace Event, submitted unchanged under holder root-control-only authorization and exact expected_current CAS. Never delegate, merge, rebuild or co-sign."
        }
      },
      "additionalProperties": false
    },
    "consent_request_request_body": {
      "type": "object",
      "description": "Body for opaque contact/consent request submission. The peer is the exact authenticated ActorId and is never caller-supplied. Holder existence is deliberately not a precondition visible to the caller.",
      "required": [
        "holder_account_id",
        "consent_scope"
      ],
      "properties": {
        "holder_account_id": {
          "$ref": "#/$defs/account_id",
          "description": "Exact target AccountId. The same principal hosted by another Station is a different holder and MUST NOT hit this request or its rate-limit/cache key."
        },
        "consent_scope": {
          "$ref": "#/$defs/consent_scope",
          "not": {
            "const": "invite"
          },
          "description": "Requested scope, taken from the section 4 enum minus invite. An invite-scope request has no carrier here: it would have to become a holder_quarantine entry whose surface_kind is consent_request, and that branch pins consent_scope away from invite because an invite belongs to invite delivery. Rejecting it at the request boundary keeps the server from inventing a behaviour for a scope it can never store."
        }
      },
      "additionalProperties": false
    },
    "consent_request_outcome": {
      "type": "object",
      "description": "Constant anti-enumeration response. Missing holder, denial, rate-limit drop and quarantine acceptance all return this exact shape; no typed current result id, state, dots, timestamps or expiry are exposed.",
      "required": [
        "accepted_for_processing"
      ],
      "properties": {
        "accepted_for_processing": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "consent_current_read_request_body": {
      "type": "object",
      "required": [
        "holder_account_id",
        "peer",
        "audience_actor_id",
        "nonce"
      ],
      "properties": {
        "holder_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "peer": {
          "$ref": "#/$defs/consent_peer"
        },
        "audience_actor_id": {
          "$ref": "./common-ids.schema.json#/$defs/actor_id"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        }
      },
      "additionalProperties": false
    },
    "consent_current_read_proof": {
      "type": "object",
      "required": [
        "verification_method",
        "jws"
      ],
      "properties": {
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "consent_current_read_outcome": {
      "type": "object",
      "required": [
        "request_digest",
        "realm_id",
        "governance_generation",
        "effective_stream_head",
        "current",
        "evaluated_at",
        "expires_at",
        "proof"
      ],
      "properties": {
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "governance_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "effective_stream_head": {
          "$ref": "./realm-commit.schema.json#/$defs/stream_head"
        },
        "current": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state",
                "result"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "result": {
                  "$ref": "./typed-current-result.schema.json#/$defs/consent_result"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "never_written"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "evaluated_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "proof": {
          "$ref": "#/$defs/consent_current_read_proof"
        }
      },
      "additionalProperties": false,
      "x-arkret-signature-domain": "ak.consent.current_read.v1",
      "x-arkret-pcr-outward-event-kinds": [
        "ak.consent.replace"
      ],
      "description": "Signed same-cut exact subject assertion: request_digest binds holder/peer/audience/nonce; PCR/generation/head binds the actual authority cut. Present contains complete original value including empty, expired, future and unevaluable entries. Never_written asserts no accepted current ever existed, never position zero or missing scope."
    }
  }
}
