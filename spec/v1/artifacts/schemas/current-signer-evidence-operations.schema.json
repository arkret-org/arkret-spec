{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/current-signer-evidence-operations.schema.json",
  "title": "Arkret Current Signer Evidence Operations",
  "description": "Peer portable current signer authority evidence. Ordinary clients use the separate signer-key operation; peer evidence and compression are verified by the receiving Station.",
  "$defs": {
    "query_request": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "recipient_account_id",
        "queries"
      ],
      "properties": {
        "request_id": {
          "$ref": "./account-operations.schema.json#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id",
          "description": "Exact recipient Account; on this peer operation its station_id equals authenticated Source-Service-ID."
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/query_selector"
          }
        },
        "known_agent_state_digests": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./agent-signer-evidence.schema.json#/$defs/sha256"
          },
          "description": "Only digests of complete locally verified state. An equal state may be omitted in the compact transport root; absence never grants trust."
        },
        "known_signer_evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "query_selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/account_device_selector"
        },
        {
          "$ref": "#/$defs/agent_selector"
        }
      ]
    },
    "account_device_selector": {
      "type": "object",
      "required": [
        "sender_kind",
        "account_id",
        "device_id"
      ],
      "properties": {
        "sender_kind": {
          "const": "account_device"
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        }
      },
      "additionalProperties": false
    },
    "agent_selector": {
      "type": "object",
      "required": [
        "sender_kind",
        "actor",
        "verification_method"
      ],
      "properties": {
        "sender_kind": {
          "const": "agent"
        },
        "actor": {
          "$ref": "#/$defs/agent_account_actor_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        }
      },
      "additionalProperties": false
    },
    "agent_account_actor_id": {
      "type": "object",
      "description": "Complete account ActorId whose principal MUST independently have accepted Agent classification. Agent is not an ActorId wire variant; service ActorId is invalid here.",
      "required": [
        "kind",
        "account_id"
      ],
      "properties": {
        "kind": {
          "const": "account"
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        }
      },
      "additionalProperties": false
    },
    "query_outcome": {
      "type": "object",
      "required": [
        "response"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/response_core"
        }
      },
      "additionalProperties": false
    },
    "response_core": {
      "type": "object",
      "required": [
        "request_id",
        "realm_id",
        "recipient_account_id",
        "evidences"
      ],
      "properties": {
        "request_id": {
          "$ref": "./account-operations.schema.json#/$defs/request_id"
        },
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "recipient_account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id",
          "description": "Exact recipient account echoed from the request. Its station_id is the verifier: the authenticated proxy Station that MUST equal the peer request Source-Service-ID. No separate verifier field exists on wire."
        },
        "evidences": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_item": {
      "oneOf": [
        {
          "$ref": "#/$defs/account_device_evidence"
        },
        {
          "$ref": "#/$defs/agent_evidence"
        }
      ]
    },
    "account_device_evidence": {
      "type": "object",
      "required": [
        "sender_kind",
        "account_id",
        "device_id",
        "device_projection_attestation",
        "signer_evidence_ref"
      ],
      "properties": {
        "sender_kind": {
          "const": "account_device"
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "device_projection_attestation": {
          "$ref": "./keys-operations.schema.json#/$defs/device_projection_attestation"
        },
        "signer_evidence_ref": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref"
        }
      },
      "additionalProperties": false
    },
    "agent_evidence": {
      "type": "object",
      "required": [
        "sender_kind",
        "actor",
        "verification_method",
        "authenticated_signer_evidence",
        "dependencies"
      ],
      "properties": {
        "sender_kind": {
          "const": "agent"
        },
        "actor": {
          "$ref": "#/$defs/agent_account_actor_id"
        },
        "verification_method": {
          "type": "string",
          "format": "uri",
          "pattern": "^did:[a-z0-9]+:[^\\s#?]+#[A-Za-z0-9._:-]+$"
        },
        "authenticated_signer_evidence": {
          "$ref": "#/$defs/compact_agent_signer_resolution_evidence"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/service_signer_evidence"
              },
              {
                "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/principal_signer_evidence"
              },
              {
                "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/agent_signer_evidence"
              }
            ]
          },
          "description": "Recursive closure excluding only exact known_signer_evidence_refs. The consumer verifies received objects plus locally retained authenticated objects; missing or wrong dependencies remain unresolved. Required edges include the original StationAdmission signer_resolution_evidence_ref of genesis, key authorization, lifecycle and applicable historical admission Events. PCR notary keys come from the accepted genesis frozen descriptor or state.accepted_delegated_notary_signers, never a separate controller DID leaf. Unused surplus is rejected."
        }
      },
      "additionalProperties": false
    },
    "compact_agent_signer_resolution_evidence": {
      "type": "object",
      "required": [
        "kind",
        "signer_id",
        "verification_method",
        "agent_signer_evidence",
        "attester_signer_evidence_ref",
        "account_authority_signer_evidence_ref"
      ],
      "properties": {
        "kind": {
          "const": "agent"
        },
        "signer_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "agent_signer_evidence": {
          "$ref": "#/$defs/compact_current_agent_signer_evidence"
        },
        "attester_signer_evidence_ref": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref"
        },
        "account_authority_signer_evidence_ref": {
          "$ref": "./authenticated-signer-resolution-evidence.schema.json#/$defs/signer_evidence_ref"
        }
      },
      "additionalProperties": false,
      "description": "Transport-only current root. Hydrate any omitted state from the exact verified state_digest before computing the canonical complete root digest or validating its closure. The compact bytes are never a canonical signer-evidence object."
    },
    "compact_current_agent_signer_evidence": {
      "type": "object",
      "required": [
        "schema",
        "verification_mode",
        "admission_evidence"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.agent_signer_evidence.v1"
        },
        "verification_mode": {
          "const": "current_admission"
        },
        "admission_evidence": {
          "$ref": "#/$defs/compact_agent_admission_evidence"
        },
        "transparency": {
          "$ref": "./agent-signer-evidence.schema.json#/$defs/transparency"
        }
      },
      "additionalProperties": false
    },
    "compact_agent_admission_evidence": {
      "type": "object",
      "required": [
        "agent_authority_state_evidence",
        "controller_account_gate_attestation",
        "admission_evidence_digest"
      ],
      "properties": {
        "agent_authority_state_evidence": {
          "$ref": "#/$defs/compact_agent_authority_state_evidence"
        },
        "controller_account_gate_attestation": {
          "$ref": "./agent-signer-evidence.schema.json#/$defs/controller_account_gate_attestation"
        },
        "admission_evidence_digest": {
          "$ref": "./agent-signer-evidence.schema.json#/$defs/sha256",
          "description": "SHA-256 over RFC 8785 JCS of exactly {agent_authority_state_evidence, controller_account_gate_attestation}. It never includes itself, a receipt or an outer attestation."
        }
      },
      "additionalProperties": false
    },
    "compact_agent_authority_state_evidence": {
      "type": "object",
      "required": [
        "state_digest",
        "lease"
      ],
      "properties": {
        "state": {
          "$ref": "./agent-signer-evidence.schema.json#/$defs/agent_authority_state"
        },
        "state_digest": {
          "$ref": "./agent-signer-evidence.schema.json#/$defs/sha256",
          "description": "SHA-256 over RFC 8785 JCS of state only."
        },
        "lease": {
          "$ref": "./agent-signer-evidence.schema.json#/$defs/agent_authority_state_lease"
        }
      },
      "additionalProperties": false,
      "description": "state may be absent only when its digest was declared known. Hydration is required before any canonical root/admission digest calculation. State changes always return full state."
    }
  }
}
