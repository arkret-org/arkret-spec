{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/recovery-authority.schema.json",
  "title": "Arkret Recovery Completion Carriers",
  "description": "Closed recovery completion attestation and Standard-grant issuance carriers. Device re-anchor authorization is root-anchored and requires no Account Authority ticket or temporary recovery grant.",
  "$defs": {
    "canonical_public_material": {
      "type": "object",
      "description": "Typed public material plus the exact canonical bytes persisted by the coordinator. canonical_bytes_base64url MUST decode to the canonical JSON/CBOR representation of value and digest MUST recompute over those bytes.",
      "required": [
        "canonical_encoding",
        "value",
        "canonical_bytes_base64url",
        "digest"
      ],
      "properties": {
        "canonical_encoding": {
          "type": "string",
          "enum": [
            "canonical_json",
            "deterministic_cbor"
          ]
        },
        "value": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "canonical_bytes_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "did_generation_ref": {
      "type": "string",
      "pattern": "^[1-9][0-9]*-[^\\s]+$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "issue_recovery_completion_grant_outcome": {
      "type": "object",
      "required": [
        "transaction_id",
        "session_grant_outcome",
        "issued_at"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "session_grant_outcome": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/SessionGrantOutcome"
        },
        "issued_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "issue_recovery_completion_grant_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "transaction_request_digest",
        "terminal_receipt",
        "completion_attestation",
        "device_authorization_event_id",
        "result_model_generation_ref",
        "initial_session",
        "canonical_request_digest"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "terminal_receipt": {
          "$ref": "./recovery-receipt.schema.json"
        },
        "completion_attestation": {
          "$ref": "#/$defs/recovery_completion_attestation"
        },
        "device_authorization_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/did_generation_ref"
        },
        "initial_session": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/InitialSessionGrantRequest",
          "description": "The Standard grant to issue after recovery. device_id MUST equal the attested replacement device and the RFC 7638 thumbprint of session_public_key MUST equal the Bound AccountHandoff and HTTP DPoP key."
        },
        "canonical_request_digest": {
          "$ref": "#/$defs/hash",
          "description": "SHA-256 of JCS(request object with only canonical_request_digest omitted). The Bound AccountHandoff authorization and RFC 9449 HTTP DPoP proof authenticate the account and holder outside this closed business body."
        }
      },
      "additionalProperties": false
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_completion_attestation": {
      "type": "object",
      "description": "Coordinator-signed proof created atomically with the durable completed RecoveryTransaction. It is the only offline completion evidence accepted by the Account Authority when issuing the post-recovery Standard grant.",
      "required": [
        "schema",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "principal_id",
        "coordinator_service_id",
        "recovery_session_id",
        "terminal_receipt_id",
        "terminal_receipt_digest",
        "replacement_device_id",
        "device_authorization_event_id",
        "device_authorization_event_digest",
        "result_model_generation_ref",
        "completed_at",
        "auth_data"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.recovery_completion_attestation.v1"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "coordinator_service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "terminal_receipt_digest": {
          "$ref": "#/$defs/hash"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "device_authorization_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "device_authorization_event_digest": {
          "$ref": "#/$defs/hash"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/did_generation_ref"
        },
        "completed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "auth_data": {
          "type": "object",
          "required": [
            "verification_method",
            "signature_algorithm",
            "signature",
            "signed_fields"
          ],
          "properties": {
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "signature_algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "signed_fields": {
              "type": "array",
              "const": [
                "schema",
                "transaction_id",
                "transaction_request_digest",
                "prepared_plan_digest",
                "principal_id",
                "coordinator_service_id",
                "recovery_session_id",
                "terminal_receipt_id",
                "terminal_receipt_digest",
                "replacement_device_id",
                "device_authorization_event_id",
                "device_authorization_event_digest",
                "result_model_generation_ref",
                "completed_at"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/recovery_completion_attestation"
    },
    {
      "$ref": "#/$defs/issue_recovery_completion_grant_request"
    },
    {
      "$ref": "#/$defs/issue_recovery_completion_grant_outcome"
    }
  ]
}
