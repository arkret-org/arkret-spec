{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/security-transaction.schema.json",
  "title": "Arkret Security Transaction",
  "description": "Closed Station-local durable RecoveryTransaction and SecurityRotationTransaction resource. The prepared plan is the sole canonical intent source; accepted outputs form a durable ordered prefix. account_id is the exact account owner; the coordinator role is account_id.station_id, the service core identity of the executing Station, and no separate coordinator field exists on wire. Every prepared Event and backup ActorId must equal this account actor.",
  "type": "object",
  "required": [
    "transaction_id",
    "kind",
    "account_id",
    "expires_at",
    "created_at",
    "request_digest",
    "prepared_plan",
    "prepared_plan_digest",
    "accepted_steps"
  ],
  "properties": {
    "transaction_id": {
      "$ref": "#/$defs/transaction_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "recovery",
        "security_rotation"
      ]
    },
    "account_id": {
      "$ref": "./common-ids.schema.json#/$defs/account_id",
      "description": "Exact account owner. Its station_id is the coordinator: the service core identity of the executing Station, not an arbitrary external coordinator. Process separation is deployment-private and creates no public coordinator role."
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "prepared_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/pcr_policy_recovery_plan"
        },
        {
          "$ref": "#/$defs/security_rotation_plan"
        }
      ]
    },
    "prepared_plan_digest": {
      "$ref": "#/$defs/sha256_digest",
      "description": "SHA-256(RFC8785_JCS(prepared_plan)). Implementations MUST recompute it and persist both bytes and typed value before the first side effect. This cross-service CAS coordinate never follows a Realm digest_algorithm."
    },
    "accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Durable accepted prefix. Entry i has the step kind at index i of the fixed order selected by kind; entries never carry a duplicate step label."
    },
    "terminal_outcome": {
      "$ref": "#/$defs/terminal_outcome"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "prepared_plan": {
            "$ref": "#/$defs/pcr_policy_recovery_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/pcr_policy_accepted_steps"
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/pcr_policy_progress_contract"
          }
        ]
      },
      "else": {
        "properties": {
          "prepared_plan": {
            "$ref": "#/$defs/security_rotation_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/security_rotation_accepted_steps"
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/security_rotation_progress_contract"
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          },
          "terminal_outcome": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            },
            "required": [
              "outcome"
            ]
          }
        },
        "required": [
          "kind",
          "terminal_outcome"
        ]
      },
      "then": {
        "properties": {
          "terminal_outcome": {
            "required": [
              "receipt_id",
              "completion_attestation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "security_rotation"
          },
          "terminal_outcome": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            },
            "required": [
              "outcome"
            ]
          }
        },
        "required": [
          "kind",
          "terminal_outcome"
        ]
      },
      "then": {
        "properties": {
          "terminal_outcome": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt_id"
                  ]
                },
                {
                  "required": [
                    "completion_attestation"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "accepted_step": {
      "type": "object",
      "required": [
        "prepared_material_digest",
        "acceptor",
        "output_ref",
        "output_digest",
        "accepted_at"
      ],
      "properties": {
        "prepared_material_digest": {
          "$ref": "#/$defs/digest"
        },
        "acceptor": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "principal_id"
              ],
              "properties": {
                "kind": {
                  "const": "principal"
                },
                "principal_id": {
                  "$ref": "./common-ids.schema.json#/$defs/did_core_id"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "device_id"
              ],
              "properties": {
                "kind": {
                  "const": "device"
                },
                "device_id": {
                  "$ref": "./common-ids.schema.json#/$defs/device_id"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "output_digest": {
          "$ref": "#/$defs/digest"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "description": "Evidence accepted at one position in the kind-specific fixed step order. The position, not a duplicated label, determines the step kind."
    },
    "backup_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_id"
    },
    "backup_object_ref": {
      "type": "object",
      "required": [
        "backup_id",
        "ciphertext_digest"
      ],
      "properties": {
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_binding": {
      "type": "object",
      "required": [
        "backup_kind",
        "previous_series_id",
        "new_series_id",
        "new_backups",
        "active_series_event_id",
        "old_backups"
      ],
      "properties": {
        "backup_kind": {
          "type": "string",
          "enum": [
            "secret_storage"
          ]
        },
        "previous_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        },
        "active_series_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "old_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_plan": {
      "type": "object",
      "required": [
        "binding",
        "encrypted_backup_material",
        "active_series_unit"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/backup_rotation_binding"
        },
        "encrypted_backup_material": {
          "$ref": "./recovery-authority.schema.json#/$defs/canonical_public_material"
        },
        "active_series_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    },
    "client_step_attestation": {
      "type": "object",
      "required": [
        "step",
        "output_ref",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "artifact",
        "auth_data"
      ],
      "properties": {
        "step": {
          "allOf": [
            {
              "type": "string",
              "enum": [
                "commit_recovery_unit",
                "local_commit"
              ]
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/pcr_policy_recovery_step"
                },
                {
                  "$ref": "#/$defs/security_rotation_step"
                }
              ]
            }
          ]
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/recovery_terminal_commit"
            },
            {
              "$ref": "#/$defs/security_rotation_local_commit"
            }
          ]
        },
        "auth_data": {
          "type": "object",
          "required": [
            "verification_method",
            "signature_algorithm",
            "signature"
          ],
          "properties": {
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "signature_algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "base64url signature over RFC 8785 JCS of the fixed projection {step,output_ref,transaction_id,transaction_request_digest,prepared_plan_digest,attestation_digest}. attestation_digest is not a wire field: the signer and the verifier each recompute it as SHA-256(JCS(artifact)) from the typed artifact carried in this object and fill it into the projection, so artifact is authenticated transitively and is not duplicated in the outer projection. For commit_recovery_unit the artifact is the complete recovery receipt artifact, so this single outer signature covers the first recovery RealmCommit and the recovery receipt together."
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "step": {
                "const": "commit_recovery_unit"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/recovery_terminal_commit"
              }
            }
          },
          "else": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/security_rotation_local_commit"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "continue_request": {
      "type": "object",
      "description": "Submits the client-attested terminal step only. The resource-aware validator derives the next step from transaction kind and accepted prefix, accepts recovery index 0 or security-rotation index 4 only when that terminal step is ready, and rejects every coordinator-owned prefix with failed_precondition. Coordinator-owned steps are executed and recovered by the durable worker, never driven by this request. Recovery has no coordinator-owned prefix: commit_recovery_unit is its single step and the only wire position that carries the first recovery RealmCommit into the atomic commit.",
      "required": [
        "request_digest",
        "prepared_plan_digest",
        "expected_accepted_step_count",
        "client_attestation"
      ],
      "properties": {
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "expected_accepted_step_count": {
          "type": "integer",
          "minimum": 0,
          "description": "CAS coordinate. It MUST equal the current accepted_steps length. The schema intentionally has no kind-blind maximum or {0,4} coupling; the service resolves the transaction resource, derives the next fixed step, and accepts only a terminal-ready index."
        },
        "client_attestation": {
          "$ref": "#/$defs/client_step_attestation"
        }
      },
      "additionalProperties": false
    },
    "create_request": {
      "oneOf": [
        {
          "$ref": "#/$defs/recovery_create_request"
        },
        {
          "$ref": "#/$defs/security_rotation_create_request"
        }
      ]
    },
    "pcr_generation_ref": {
      "$ref": "./recovery-authority.schema.json#/$defs/pcr_generation_ref"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "sha256_digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "prepared_event_unit": {
      "type": "object",
      "description": "Exact typed Event submit request plus its suite-bearing canonical digest. Operation, request schema, destination and audience are fixed by this unit type and the parent account_id.station_id; canonical request bytes are RFC 8785 JCS(request), not a second wire input. A PCR recovery unit contains exactly reanchor plus replacement authorize for the same account-local lineage/session/sequenced revision guard. Both producer proofs MUST omit signer_resolution_evidence_ref and use the same session-frozen replacement key resolved through the unit-local candidate possession overlay before mutation; they cannot be submitted or replayed outside the complete recovery unit. Current human DID or device-directory resolution cannot authorize either slot.",
      "required": [
        "request",
        "request_digest"
      ],
      "properties": {
        "request": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/EventsSubmitBatchRequestBody",
          "description": "Exact typed Event batch submit request; the unit type fixes this sole schema identity."
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "receipt_id": {
      "$ref": "./erasure-receipt-operations.schema.json#/$defs/receipt_id"
    },
    "realm_commit_id": {
      "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
    },
    "recovery_create_request": {
      "type": "object",
      "description": "Closed typed recovery intent. The caller states what it wants recovered and supplies the two complete signed Events plus the coordinates of the first recovery RealmCommit; it never supplies a finished prepared_plan. The Station derives the snapshots, the exact prepared authority-commit input body and every reserved id inside its own durable prepare transaction, which produces no recovery effect.",
      "required": [
        "transaction_id",
        "kind",
        "account_id",
        "expires_at",
        "recovery_intent"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "recovery"
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "recovery_intent": {
          "$ref": "#/$defs/pcr_policy_recovery_intent"
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_intent": {
      "type": "object",
      "description": "Caller-authored recovery intent fixing the verified recovery session, replacement device, generation CAS, terminal receipt id, two exact signed producer Events, current PCR stream head and their ordered digests. It contains no Station-signed RealmCommit.",
      "required": [
        "recovery_session_id",
        "replacement_device_id",
        "previous_model_generation_ref",
        "result_model_generation_ref",
        "terminal_receipt_id",
        "reanchor_unit",
        "reanchor_commit_intent"
      ],
      "properties": {
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "previous_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "reanchor_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "reanchor_commit_intent": {
          "$ref": "#/$defs/recovery_commit_intent"
        }
      },
      "additionalProperties": false
    },
    "recovery_commit_intent": {
      "type": "object",
      "description": "Closed authority-commit expectation for the PCR stream. predecessor_ref is the exact current stream head and unit_event_digests fixes the two producer Events that the governance Station must commit atomically after all recovery checks succeed.",
      "required": [
        "realm_id",
        "predecessor_ref",
        "unit_event_digests"
      ],
      "properties": {
        "realm_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_id"
        },
        "predecessor_ref": {
          "$ref": "#/$defs/realm_commit_id",
          "description": "Exact current RealmCommit id of the Principal Control Realm stream; genesis-null is invalid."
        },
        "unit_event_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": "Exactly [reanchor_digest, authorize_digest] in RealmCommit event order."
        }
      },
      "additionalProperties": false
    },
    "recovery_terminal_commit": {
      "type": "object",
      "description": "Sole client-attested terminal artifact of a RecoveryTransaction. It carries the exact replacement-device-signed recovery receipt. The governance Station validates it and the prepared producer Events, then atomically issues the PCR-stream RealmCommit; the client artifact never contains or signs that authority record.",
      "required": [
        "recovery_receipt"
      ],
      "properties": {
        "recovery_receipt": {
          "$ref": "./recovery-receipt.schema.json",
          "description": "Complete replacement-device-signed recovery receipt binding the transaction, plan, both producer Event ids, generation CAS and recovery proof snapshot."
        }
      },
      "additionalProperties": false
    },
    "recovery_session_id": {
      "$ref": "./key-backup-unlock-proof.schema.json#/$defs/recovery_session_id"
    },
    "pcr_policy_accepted_steps": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Accepted prefix for the canonical pcr_policy step order declared by pcr_policy_recovery_step. PCR-policy recovery has exactly one accepted step, the client-attested commit_recovery_unit terminal commit. The recovery unit stays transaction-private prepared material until that commit, so no coordinator-owned prefix entry exists."
    },
    "pcr_policy_progress_contract": {
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "terminal_outcome"
              ]
            }
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_outcome": {
                "properties": {
                  "outcome": {
                    "const": "completed"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            },
            "required": [
              "terminal_outcome"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "pcr_policy_recovery_binding": {
      "type": "object",
      "description": "Reserved producer identities of one RecoveryTransaction. The replacement-device-signed Event ids and terminal receipt id are frozen before admission; the resulting RealmCommit is created only by the governance Station during the atomic terminal step.",
      "required": [
        "identity_model",
        "recovery_session_id",
        "replacement_device_id",
        "reanchor_event_id",
        "authorize_event_id",
        "terminal_receipt_id"
      ],
      "properties": {
        "identity_model": {
          "const": "pcr_policy"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "reanchor_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "authorize_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_plan": {
      "type": "object",
      "description": "Station-derived closed plan frozen with the canonical request in a durable prepare transaction that produces no accepted Event, RealmCommit, generation advance, active device, consumed session or terminal result.",
      "required": [
        "binding",
        "recovery_session_snapshot_digest",
        "proof_digest",
        "previous_model_generation_ref",
        "result_model_generation_ref",
        "reanchor_unit",
        "reanchor_commit_intent"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/pcr_policy_recovery_binding"
        },
        "recovery_session_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "proof_digest": {
          "$ref": "#/$defs/digest"
        },
        "previous_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "reanchor_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "reanchor_commit_intent": {
          "$ref": "#/$defs/recovery_commit_intent",
          "description": "Exact caller-stated PCR stream head and ordered Event digests; it MUST equal the create request recovery_intent.reanchor_commit_intent byte for byte."
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_step": {
      "type": "string",
      "description": "The enum array order is the canonical PCR-policy recovery step order addressed by accepted_steps indexes. PCR-policy recovery has a single client-attested step at index 0: the Station prepare transaction that freezes the plan belongs to create, not to the accepted-step ledger, so no coordinator-owned prefix precedes the terminal commit.",
      "enum": [
        "commit_recovery_unit"
      ]
    },
    "security_rotation_accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Accepted prefix for the canonical rotation step order declared by security_rotation_step."
    },
    "security_rotation_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "account_id",
        "expires_at",
        "prepared_plan"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "security_rotation"
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "prepared_plan": {
          "$ref": "#/$defs/security_rotation_plan"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_local_commit": {
      "type": "object",
      "description": "Client-authored terminal artifact. The device copies transaction_id, transaction_request_digest and prepared_plan_digest from the authoritative SecurityTransaction resource, copies local_commit_digest from its closed prepared_plan, and supplies its own device_id and canonical committed_at. No server-issued signed artifact or separate supply operation exists; the enclosing client_step_attestation authenticates this complete object.",
      "required": [
        "schema",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "local_commit_digest",
        "device_id",
        "committed_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.security_rotation_local_commit.v1"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "local_commit_digest": {
          "$ref": "#/$defs/digest"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "committed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_plan": {
      "type": "object",
      "required": [
        "revoke_unit",
        "new_secret_commitment",
        "backup_rotations",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/digest"
        },
        "backup_rotations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_rotation_plan"
          },
          "description": "The single secret_storage entry; its nested binding is the sole source of the reserved series and object references."
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/digest",
          "description": "Must equal the non-circular projection digest over transaction_id and this plan's nested backup rotation bindings."
        },
        "local_commit_digest": {
          "$ref": "#/$defs/digest",
          "description": "Must equal the non-circular projection digest over transaction_id, new_secret_commitment and this plan's nested backup rotation bindings."
        }
      },
      "additionalProperties": false
    },
    "security_rotation_progress_contract": {
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "terminal_outcome"
              ]
            }
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_outcome": {
                "properties": {
                  "outcome": {
                    "const": "completed"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            },
            "required": [
              "terminal_outcome"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
    "security_rotation_step": {
      "type": "string",
      "description": "The enum array order is the canonical security-rotation step order addressed by accepted_steps indexes.",
      "enum": [
        "revoke",
        "upload_new_material",
        "switch_authoritative_pointer",
        "erase_old_material",
        "local_commit"
      ]
    },
    "step_output_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "terminal_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "outcome",
            "completed_at"
          ],
          "properties": {
            "outcome": {
              "const": "completed"
            },
            "completed_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "receipt_id": {
              "$ref": "#/$defs/receipt_id"
            },
            "completion_attestation": {
              "$ref": "./recovery-authority.schema.json#/$defs/recovery_completion_attestation"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "completed_at"
          ],
          "properties": {
            "outcome": {
              "const": "aborted"
            },
            "completed_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "completed_at"
          ],
          "properties": {
            "outcome": {
              "const": "expired"
            },
            "completed_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "transaction_id": {
      "$ref": "./recovery-authority.schema.json#/$defs/transaction_id"
    }
  }
}
