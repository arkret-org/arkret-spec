{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/security-transaction.schema.json",
  "title": "Arkret Security Transaction",
  "description": "Closed durable RecoveryTransaction and SecurityRotationTransaction resource. Binding, prepared plan and accepted outputs are separate protocol states.",
  "type": "object",
  "required": [
    "transaction_id",
    "kind",
    "principal_id",
    "coordinator_service_id",
    "expires_at",
    "created_at",
    "request_digest",
    "binding",
    "prepared_plan",
    "prepared_plan_digest",
    "state",
    "accepted_steps",
    "next_required_step"
  ],
  "properties": {
    "transaction_id": {
      "$ref": "#/$defs/transaction_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "recovery",
        "security_rotation"
      ]
    },
    "principal_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "coordinator_service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "request_digest": {
      "$ref": "#/$defs/hash"
    },
    "binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/pcr_policy_recovery_binding"
        },
        {
          "$ref": "#/$defs/security_rotation_binding"
        }
      ]
    },
    "prepared_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/pcr_policy_recovery_plan"
        },
        {
          "$ref": "#/$defs/security_rotation_plan"
        }
      ]
    },
    "prepared_plan_digest": {
      "$ref": "#/$defs/hash",
      "description": "Digest of canonical prepared_plan bytes. Implementations MUST recompute it and persist both bytes and typed value before the first side effect."
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "awaiting_device_attestation",
        "completed",
        "aborted",
        "expired"
      ]
    },
    "accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      }
    },
    "next_required_step": {
      "oneOf": [
        {
          "$ref": "#/$defs/any_step"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_result": {
      "$ref": "#/$defs/terminal_result"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "binding": {
            "$ref": "#/$defs/pcr_policy_recovery_binding"
          },
          "prepared_plan": {
            "$ref": "#/$defs/pcr_policy_recovery_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/pcr_policy_accepted_steps"
          },
          "next_required_step": {
            "oneOf": [
              {
                "$ref": "#/$defs/pcr_policy_recovery_step"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/pcr_policy_progress_contract"
          }
        ]
      },
      "else": {
        "properties": {
          "binding": {
            "$ref": "#/$defs/security_rotation_binding"
          },
          "prepared_plan": {
            "$ref": "#/$defs/security_rotation_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/security_rotation_accepted_steps"
          },
          "next_required_step": {
            "oneOf": [
              {
                "$ref": "#/$defs/security_rotation_step"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/security_rotation_progress_contract"
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed",
              "aborted",
              "expired"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "terminal_result"
        ],
        "properties": {
          "next_required_step": {
            "type": "null"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "terminal_result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "completed"
              }
            },
            "required": [
              "receipt_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "aborted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "aborted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "expired"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "expired"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          },
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "kind",
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "required": [
              "completion_attestation"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "terminal_result": {
            "not": {
              "required": [
                "completion_attestation"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "accepted_erase_old_material": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "erase_old_material"
            }
          }
        }
      ]
    },
    "accepted_issue_terminal_receipt": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "issue_terminal_receipt"
            }
          }
        }
      ]
    },
    "accepted_local_commit": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "local_commit"
            }
          }
        }
      ]
    },
    "accepted_publish_did_entry": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "publish_did_entry"
            }
          }
        }
      ]
    },
    "accepted_revoke": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "revoke"
            }
          }
        }
      ]
    },
    "accepted_step": {
      "type": "object",
      "required": [
        "step",
        "prepared_material_digest",
        "acceptor_id",
        "output_ref",
        "output_digest",
        "accepted_at"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/any_step"
        },
        "prepared_material_digest": {
          "$ref": "#/$defs/hash"
        },
        "acceptor_id": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:[^\\s#?]+|ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "output_digest": {
          "$ref": "#/$defs/hash"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "accepted_submit_reanchor_unit": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "submit_reanchor_unit"
            }
          }
        }
      ]
    },
    "accepted_switch_authoritative_pointer": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "switch_authoritative_pointer"
            }
          }
        }
      ]
    },
    "accepted_upload_new_material": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "upload_new_material"
            }
          }
        }
      ]
    },
    "any_step": {
      "type": "string",
      "enum": [
        "publish_did_entry",
        "submit_reanchor_unit",
        "issue_terminal_receipt",
        "revoke",
        "upload_new_material",
        "switch_authoritative_pointer",
        "erase_old_material",
        "local_commit"
      ]
    },
    "backup_id": {
      "type": "string",
      "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_object_ref": {
      "type": "object",
      "required": [
        "backup_id",
        "ciphertext_digest"
      ],
      "properties": {
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_binding": {
      "type": "object",
      "required": [
        "backup_kind",
        "previous_series_id",
        "new_series_id",
        "new_backups",
        "active_series_event_id",
        "old_backups"
      ],
      "properties": {
        "backup_kind": {
          "type": "string",
          "enum": [
            "secret_storage",
            "mls_history"
          ]
        },
        "previous_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        },
        "active_series_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "old_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_plan": {
      "type": "object",
      "required": [
        "binding",
        "encrypted_backup_material",
        "active_series_unit"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/backup_rotation_binding"
        },
        "encrypted_backup_material": {
          "$ref": "./recovery-authority.schema.json#/$defs/canonical_public_material"
        },
        "active_series_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "backup_series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "client_step_attestation": {
      "type": "object",
      "required": [
        "step",
        "output_ref",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "attestation_digest",
        "artifact",
        "auth_data"
      ],
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "issue_terminal_receipt",
            "local_commit"
          ]
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "attestation_digest": {
          "$ref": "#/$defs/hash",
          "description": "SHA-256 of JCS(artifact). The coordinator MUST recompute it from the received typed artifact bytes."
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "./recovery-receipt.schema.json"
            },
            {
              "$ref": "#/$defs/security_rotation_local_commit"
            }
          ]
        },
        "auth_data": {
          "type": "object",
          "required": [
            "verification_method",
            "signature_algorithm",
            "signature",
            "signed_fields"
          ],
          "properties": {
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "signature_algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "signed_fields": {
              "type": "array",
              "const": [
                "step",
                "output_ref",
                "transaction_id",
                "transaction_request_digest",
                "prepared_plan_digest",
                "attestation_digest"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "step": {
                "const": "issue_terminal_receipt"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "./recovery-receipt.schema.json"
              }
            }
          },
          "else": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/security_rotation_local_commit"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "continue_request": {
      "type": "object",
      "required": [
        "request_digest",
        "prepared_plan_digest",
        "expected_next_step"
      ],
      "properties": {
        "request_digest": {
          "$ref": "#/$defs/hash"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "expected_next_step": {
          "$ref": "#/$defs/any_step"
        },
        "client_attestation": {
          "$ref": "#/$defs/client_step_attestation"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "client_attestation"
            ]
          },
          "then": {
            "properties": {
              "expected_next_step": {
                "enum": [
                  "issue_terminal_receipt",
                  "local_commit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_next_step": {
                "enum": [
                  "issue_terminal_receipt",
                  "local_commit"
                ]
              }
            },
            "required": [
              "expected_next_step"
            ]
          },
          "then": {
            "required": [
              "client_attestation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "client_attestation"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "create_request": {
      "oneOf": [
        {
          "$ref": "#/$defs/recovery_create_request"
        },
        {
          "$ref": "#/$defs/security_rotation_create_request"
        }
      ]
    },
    "pcr_generation_ref": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "event_initial_submission": {
      "type": "object",
      "required": [
        "event",
        "authorization_lease"
      ],
      "properties": {
        "event": {
          "$ref": "./event-envelope.schema.json"
        },
        "authorization_lease": {
          "$ref": "./offline-publication.schema.json#/$defs/authorization_lease"
        },
        "cba_proof_bundles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "./cba-proof-bundle.schema.json"
          }
        },
        "control_proposal_ack": {
          "$ref": "./control-proposal-decision.schema.json#/$defs/control_proposal_ack"
        }
      },
      "additionalProperties": false
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "prepared_did_publication": {
      "type": "object",
      "required": [
        "registry_service_id",
        "registry_endpoint",
        "previous_entry_ref",
        "expected_entry_ref",
        "canonical_entry_base64url",
        "entry_digest"
      ],
      "properties": {
        "registry_service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "registry_endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#]+/_arkret/root/identity/submit-did-operation$"
        },
        "previous_entry_ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_entry_ref": {
          "type": "string",
          "minLength": 1
        },
        "canonical_entry_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "entry_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "prepared_event_submission_batch": {
      "type": "object",
      "description": "Exact typed account-client Event publication batch and its persisted canonical bytes.",
      "required": [
        "destination_service_id",
        "audience",
        "request",
        "canonical_request_base64url",
        "request_digest"
      ],
      "properties": {
        "destination_service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "audience": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "request": {
          "type": "object",
          "required": [
            "events"
          ],
          "properties": {
            "events": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/event_initial_submission"
              }
            }
          },
          "additionalProperties": false
        },
        "canonical_request_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "prepared_event_unit": {
      "type": "object",
      "description": "Exact typed Event submit request and persisted canonical bytes. A PCR recovery unit contains reanchor plus replacement authorize for the same account-local lineage/session/generation CAS; candidate possession is verified through the unit-local overlay before mutation and never by resolving current human DID.",
      "required": [
        "operation_id",
        "destination_service_id",
        "audience",
        "request_schema",
        "request",
        "canonical_request_base64url",
        "request_digest"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "const": "ak.self.events.command.submit"
        },
        "destination_service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "audience": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "request_schema": {
          "type": "string",
          "const": "https://arkret.org/v1/schemas/service-operation-dtos.schema.json#/$defs/EventsSubmitBatchRequestBody"
        },
        "request": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Typed value that MUST independently validate against request_schema. The indirection keeps the transaction schema acyclic while preserving a closed schema identity."
        },
        "canonical_request_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "principal_id",
        "expires_at",
        "binding",
        "prepared_plan",
        "prepared_plan_digest"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "recovery"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "binding": {
          "$ref": "#/$defs/pcr_policy_recovery_binding"
        },
        "prepared_plan": {
          "$ref": "#/$defs/pcr_policy_recovery_plan"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "pcr_policy_accepted_steps": {
      "type": "array",
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/accepted_submit_reanchor_unit"
        },
        {
          "$ref": "#/$defs/accepted_issue_terminal_receipt"
        }
      ],
      "items": false
    },
    "pcr_policy_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_device_attestation"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 0
                  },
                  "next_required_step": {
                    "const": "submit_reanchor_unit"
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "running"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "next_required_step": {
                    "const": "issue_terminal_receipt"
                  },
                  "state": {
                    "const": "awaiting_device_attestation"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    },
    "pcr_policy_recovery_binding": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_id",
        "replacement_device_id",
        "reanchor_event_id",
        "authorize_event_id",
        "terminal_receipt_id"
      ],
      "properties": {
        "identity_model": {
          "const": "pcr_policy"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "reanchor_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "authorize_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_plan": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_snapshot_digest",
        "proof_digest",
        "previous_model_generation_ref",
        "result_model_generation_ref",
        "reanchor_unit"
      ],
      "properties": {
        "identity_model": {
          "const": "pcr_policy"
        },
        "recovery_session_snapshot_digest": {
          "$ref": "#/$defs/hash"
        },
        "proof_digest": {
          "$ref": "#/$defs/hash"
        },
        "previous_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "reanchor_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_step": {
      "type": "string",
      "enum": [
        "submit_reanchor_unit",
        "issue_terminal_receipt"
      ]
    },
    "security_rotation_accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/accepted_revoke"
        },
        {
          "$ref": "#/$defs/accepted_upload_new_material"
        },
        {
          "$ref": "#/$defs/accepted_switch_authoritative_pointer"
        },
        {
          "$ref": "#/$defs/accepted_erase_old_material"
        },
        {
          "$ref": "#/$defs/accepted_local_commit"
        }
      ],
      "items": false
    },
    "security_rotation_binding": {
      "type": "object",
      "required": [
        "revoke_event_id",
        "new_secret_commitment",
        "backup_rotations",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/hash"
        },
        "backup_rotations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_rotation_binding"
          },
          "description": "Exactly secret_storage then mls_history in canonical backup_kind order."
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/hash",
          "description": "SHA-256 of the non-circular JCS projection {domain=ak.backup_series_erase_confirmation_preimage.v1, transaction_id, series=backup_rotations}."
        },
        "local_commit_digest": {
          "$ref": "#/$defs/hash",
          "description": "SHA-256 of the non-circular JCS projection {domain=ak.security_rotation_local_commit_preimage.v1, transaction_id, new_secret_commitment, backup_rotations}."
        }
      },
      "additionalProperties": false
    },
    "security_rotation_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "principal_id",
        "expires_at",
        "binding",
        "prepared_plan",
        "prepared_plan_digest"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "security_rotation"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "binding": {
          "$ref": "#/$defs/security_rotation_binding"
        },
        "prepared_plan": {
          "$ref": "#/$defs/security_rotation_plan"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_local_commit": {
      "type": "object",
      "required": [
        "schema",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "local_commit_digest",
        "device_id",
        "committed_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.security_rotation_local_commit.v1"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "local_commit_digest": {
          "$ref": "#/$defs/hash"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "committed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_plan": {
      "type": "object",
      "required": [
        "revoke_unit",
        "new_secret_commitment",
        "backup_rotations",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/hash"
        },
        "backup_rotations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_rotation_plan"
          },
          "description": "Prepared material for the same canonical two backup_kind entries as binding.backup_rotations."
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/hash",
          "description": "Must equal the binding's non-circular erase confirmation projection digest."
        },
        "local_commit_digest": {
          "$ref": "#/$defs/hash",
          "description": "Must equal the binding's non-circular local commit projection digest."
        }
      },
      "additionalProperties": false
    },
    "security_rotation_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_device_attestation"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 0
                  },
                  "next_required_step": {
                    "const": "revoke"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "next_required_step": {
                    "const": "upload_new_material"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "next_required_step": {
                    "const": "switch_authoritative_pointer"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "next_required_step": {
                    "const": "erase_old_material"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "next_required_step": {
                    "const": "local_commit"
                  },
                  "state": {
                    "const": "awaiting_device_attestation"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
    "security_rotation_step": {
      "type": "string",
      "enum": [
        "revoke",
        "upload_new_material",
        "switch_authoritative_pointer",
        "erase_old_material",
        "local_commit"
      ]
    },
    "step_output_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "terminal_result": {
      "type": "object",
      "required": [
        "result",
        "completed_at"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "completed",
            "aborted",
            "expired"
          ]
        },
        "completed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "completion_attestation": {
          "$ref": "./recovery-authority.schema.json#/$defs/recovery_completion_attestation"
        }
      },
      "additionalProperties": false
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
