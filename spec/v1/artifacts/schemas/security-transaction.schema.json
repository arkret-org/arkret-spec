{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/security-transaction.schema.json",
  "title": "Arkret Security Transaction",
  "description": "Closed union of immutable successful single-submit Recovery results and durable multi-step SecurityRotation resources. The two workflows share operation routing, not a prepared lifecycle.",
  "oneOf": [
    {
      "$ref": "#/$defs/recovery_transaction_completion"
    },
    {
      "$ref": "#/$defs/security_rotation_transaction"
    }
  ],
  "$defs": {
    "revoke_command_outcome": {
      "type": "object",
      "required": [
        "proposal_event_id",
        "covering_commit_id",
        "outcome",
        "decided_at"
      ],
      "properties": {
        "proposal_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "covering_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "security-transaction.schema.json#/$defs/revoke_command_outcome/properties/outcome",
            "owner": "security-transaction.schema.json#/$defs/revoke_command_outcome/properties/outcome",
            "values": [
              "accepted",
              "rejected"
            ]
          },
          "x-arkret-outcome-scope": "device_revoke_command_admission_attempt"
        },
        "decided_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "terminal_outcome",
      "x-arkret-outcome-scope": "device_revoke_command_admission_attempt"
    },
    "revoke_proposal": {
      "type": "object",
      "required": [
        "proposal_event_id",
        "covering_commit_id"
      ],
      "properties": {
        "proposal_event_id": {
          "$ref": "./common-ids.schema.json#/$defs/event_id"
        },
        "covering_commit_id": {
          "$ref": "./common-ids.schema.json#/$defs/realm_commit_id"
        }
      },
      "additionalProperties": false
    },
    "accepted_step": {
      "type": "object",
      "required": [
        "acceptor",
        "accepted_at"
      ],
      "properties": {
        "acceptor": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "principal_id"
              ],
              "properties": {
                "kind": {
                  "const": "principal",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "security-transaction.schema.json#/$defs/accepted_step/properties/acceptor/oneOf/0/properties/kind",
                    "owner": "security-transaction.schema.json#/$defs/accepted_step/properties/acceptor/oneOf/0/properties/kind",
                    "values": [
                      "principal"
                    ]
                  }
                },
                "principal_id": {
                  "$ref": "./common-ids.schema.json#/$defs/did_core_id"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "device_id"
              ],
              "properties": {
                "kind": {
                  "const": "device",
                  "x-arkret-value-ownership": {
                    "class": "owned_symbol",
                    "authority": "security-transaction.schema.json#/$defs/accepted_step/properties/acceptor/oneOf/1/properties/kind",
                    "owner": "security-transaction.schema.json#/$defs/accepted_step/properties/acceptor/oneOf/1/properties/kind",
                    "values": [
                      "device"
                    ]
                  }
                },
                "device_id": {
                  "$ref": "./common-ids.schema.json#/$defs/device_id"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "description": "Accepted position in the kind-specific fixed step order. The index determines the step; execution evidence is verified against the typed plan and durable outcomes, never inferred from reserved IDs or digests alone."
    },
    "backup_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_id"
    },
    "backup_object_ref": {
      "type": "object",
      "required": [
        "backup_id",
        "ciphertext_digest"
      ],
      "properties": {
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_binding": {
      "type": "object",
      "required": [
        "backup_kind",
        "previous_series_id",
        "new_series_id",
        "new_backups",
        "active_series_event_id",
        "old_backups"
      ],
      "properties": {
        "backup_kind": {
          "type": "string",
          "enum": [
            "secret_storage"
          ],
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "security-transaction.schema.json#/$defs/backup_rotation_binding/properties/backup_kind",
            "owner": "security-transaction.schema.json#/$defs/backup_rotation_binding/properties/backup_kind",
            "values": [
              "secret_storage"
            ]
          }
        },
        "previous_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        },
        "active_series_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "old_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_plan": {
      "type": "object",
      "required": [
        "binding",
        "new_backup_envelopes",
        "active_series_unit"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/backup_rotation_binding"
        },
        "new_backup_envelopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "./key-backup.schema.json"
          },
          "description": "Complete signed KeyBackup envelopes in canonical ascending backup_id order, with distinct IDs. Each envelope's backup_id and ciphertext_digest MUST equal the corresponding binding.new_backups entry; signatures and ciphertext digests MUST be verified."
        },
        "active_series_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "backup_series_id": {
      "$ref": "./agent-operations.schema.json#/$defs/backup_series_id"
    },
    "client_step_attestation": {
      "type": "object",
      "required": [
        "step",
        "output_ref",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "artifact",
        "signature_proof"
      ],
      "properties": {
        "step": {
          "const": "local_commit",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "security-transaction.schema.json#/$defs/client_step_attestation/properties/step",
            "owner": "security-transaction.schema.json#/$defs/client_step_attestation/properties/step",
            "values": [
              "local_commit"
            ]
          }
        },
        "output_ref": {
          "$ref": "#/$defs/sha256_digest",
          "description": "Exact local_commit_digest reserved by the SecurityRotation plan. No receipt or Recovery output is accepted."
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "artifact": {
          "$ref": "#/$defs/security_rotation_local_commit"
        },
        "signature_proof": {
          "type": "object",
          "required": [
            "verification_method",
            "signature_algorithm",
            "signature"
          ],
          "properties": {
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url",
              "description": "Canonical current Account DID URL with fragment #<device_id>. The verifier resolves the device's authorized signing key, generation, revocation and pending state at the same accepted PCR cut and binds the device and artifact exactly."
            },
            "signature_algorithm": {
              "type": "string",
              "const": "Ed25519",
              "x-arkret-value-ownership": {
                "class": "external_literal",
                "authority": "https://www.rfc-editor.org/rfc/rfc8032.html#section-5.1",
                "owner": "security-transaction.schema.json#/$defs/client_step_attestation/properties/signature_proof/properties/signature_algorithm",
                "values": [
                  "Ed25519"
                ]
              }
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "Canonical Base64URL Ed25519 signature over RFC8785_JCS({step,output_ref,transaction_id,transaction_request_digest,prepared_plan_digest,attestation_digest}). attestation_digest is SHA-256(JCS(the same typed SecurityRotation local_commit artifact)); it is reconstructed, not a wire field. Recovery cannot use this wrapper."
            }
          },
          "additionalProperties": false,
          "description": "Current accepted Device Ed25519 proof for the Rotation local_commit only. Its complete account/device/key/generation/revocation state is resolved at the same accepted PCR cut. The signature binds step, output_ref, transaction/request/plan and the exact typed local artifact digest."
        }
      },
      "additionalProperties": false,
      "description": "SecurityRotation-only final local_commit signature. Recovery authenticates its single complete original receipt and never uses this wrapper."
    },
    "security_transaction_continue_request_body": {
      "type": "object",
      "description": "SecurityRotation-only client local_commit terminal step, at the fixed ready prefix. Recovery has no continue or prepared resource. The server resolves the transaction kind and refuses Recovery before any side effect.",
      "required": [
        "request_digest",
        "prepared_plan_digest",
        "expected_accepted_step_count",
        "client_attestation"
      ],
      "properties": {
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "expected_accepted_step_count": {
          "type": "integer",
          "minimum": 0,
          "description": "CAS coordinate. It MUST equal the current accepted_steps length. The schema intentionally has no kind-blind maximum or {0,4} coupling; the service resolves the transaction resource, derives the next fixed step, and accepts only a terminal-ready index.",
          "x-arkret-member-role": "count"
        },
        "client_attestation": {
          "$ref": "#/$defs/client_step_attestation"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "security_transaction_create_request_body": {
      "oneOf": [
        {
          "$ref": "#/$defs/recovery_create_request_body"
        },
        {
          "$ref": "#/$defs/security_rotation_create_request_body"
        }
      ],
      "x-arkret-name-role": "request_body"
    },
    "event_id": {
      "$ref": "./account-operations.schema.json#/$defs/event_id"
    },
    "digest": {
      "$ref": "./account-operations.schema.json#/$defs/digest"
    },
    "sha256_digest": {
      "$ref": "./account-operations.schema.json#/$defs/sha256_digest"
    },
    "prepared_event_unit": {
      "type": "object",
      "description": "SecurityRotation prepared Event unit only. Its exact typed request/canonical digest is frozen in the Rotation plan; caller-controlled operation/route/audience or arbitrary steps are forbidden.",
      "required": [
        "request",
        "request_digest"
      ],
      "properties": {
        "request": {
          "$ref": "./service-operation-dtos.schema.json#/$defs/EventsSubmitBatchRequestBody",
          "description": "Exact nested two-Event recovery unit shape. The parent security transaction fixes its operation, slot order and authority; this array is not an ordinary self Event-submit batch."
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "receipt_id": {
      "$ref": "./erasure-receipt-operations.schema.json#/$defs/receipt_id"
    },
    "recovery_create_request_body": {
      "type": "object",
      "required": [
        "kind",
        "recovery_receipt"
      ],
      "properties": {
        "kind": {
          "const": "recovery",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "security-transaction.schema.json#/$defs/recovery_create_request_body/properties/kind",
            "owner": "security-transaction.schema.json#/$defs/recovery_create_request_body/properties/kind",
            "values": [
              "recovery"
            ]
          }
        },
        "recovery_receipt": {
          "$ref": "./recovery-receipt.schema.json"
        }
      },
      "additionalProperties": false,
      "description": "Single atomic Recovery submission. The full original signed receipt is the sole canonical intent and contains the two exact EventAdmissionSubmission slots plus accepted PCR predecessor. Same account/transaction with different complete canonical signed receipt is a conflict; the original result is byte-exact replayable.",
      "x-arkret-name-role": "request_body"
    },
    "security_rotation_accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Accepted prefix of the fixed Rotation order: revoke, upload_new_material, switch_authoritative_pointer, erase_old_material, local_commit. The prefix length determines the next step; no independent wire step enum exists."
    },
    "security_rotation_create_request_body": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "account_id",
        "authorizing_device_id",
        "expires_at",
        "prepared_plan"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "security_rotation",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "security-transaction.schema.json#/$defs/security_rotation_create_request_body/properties/kind",
            "owner": "security-transaction.schema.json#/$defs/security_rotation_create_request_body/properties/kind",
            "values": [
              "security_rotation"
            ]
          }
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id"
        },
        "authorizing_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id",
          "description": "Must equal the device in the fresh high-risk authenticated create session; caller text alone is not authoritative."
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "prepared_plan": {
          "$ref": "#/$defs/security_rotation_plan"
        }
      },
      "additionalProperties": false,
      "x-arkret-name-role": "request_body"
    },
    "security_rotation_local_commit": {
      "type": "object",
      "description": "Client-authored terminal artifact. The device copies transaction_id, transaction_request_digest and prepared_plan_digest from the authoritative SecurityTransaction resource, copies local_commit_digest from its closed prepared_plan, and supplies its own device_id and canonical committed_at. No server-issued signed artifact or separate supply operation exists; the enclosing client_step_attestation authenticates this complete object.",
      "required": [
        "schema",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "local_commit_digest",
        "device_id",
        "committed_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.security_rotation_local_commit.v1",
          "x-arkret-value-ownership": {
            "class": "namespaced_symbol",
            "authority": "security-transaction.schema.json#/$defs/security_rotation_local_commit/properties/schema",
            "owner": "security-transaction.schema.json#/$defs/security_rotation_local_commit/properties/schema",
            "values": [
              "ak.schema.security_rotation_local_commit.v1"
            ]
          }
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "local_commit_digest": {
          "$ref": "#/$defs/digest"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "committed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_plan": {
      "type": "object",
      "required": [
        "revoke_unit",
        "new_secret_commitment",
        "backup_rotations",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/digest"
        },
        "backup_rotations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_rotation_plan"
          },
          "description": "The single secret_storage entry; its nested binding is the sole source of the reserved series and object references."
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/digest",
          "description": "Must equal the non-circular projection digest over transaction_id and this plan's nested backup rotation bindings."
        },
        "local_commit_digest": {
          "$ref": "#/$defs/digest",
          "description": "Must equal the non-circular projection digest over transaction_id, new_secret_commitment and this plan's nested backup rotation bindings."
        }
      },
      "additionalProperties": false
    },
    "security_rotation_progress_contract": {
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "terminal_outcome"
              ]
            }
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_outcome": {
                "properties": {
                  "outcome": {
                    "const": "completed",
                    "x-arkret-value-ownership": {
                      "class": "owned_symbol",
                      "authority": "security-transaction.schema.json#/$defs/security_rotation_progress_contract/allOf/1/if/properties/terminal_outcome/properties/outcome",
                      "owner": "security-transaction.schema.json#/$defs/security_rotation_progress_contract/allOf/1/if/properties/terminal_outcome/properties/outcome",
                      "values": [
                        "completed"
                      ]
                    },
                    "x-arkret-outcome-scope": "security_transaction_execution"
                  }
                },
                "required": [
                  "outcome"
                ],
                "x-arkret-outcome-scope": "security_transaction_execution"
              }
            },
            "required": [
              "terminal_outcome"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
    "terminal_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "outcome",
            "completed_at"
          ],
          "properties": {
            "outcome": {
              "const": "completed",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "security-transaction.schema.json#/$defs/terminal_outcome/oneOf/0/properties/outcome",
                "owner": "security-transaction.schema.json#/$defs/terminal_outcome/oneOf/0/properties/outcome",
                "values": [
                  "completed"
                ]
              },
              "x-arkret-outcome-scope": "security_transaction_execution"
            },
            "completed_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "receipt_id": {
              "$ref": "#/$defs/receipt_id"
            },
            "completion_attestation": {
              "$ref": "./recovery-authority.schema.json#/$defs/recovery_completion_attestation"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "completed_at"
          ],
          "properties": {
            "outcome": {
              "const": "aborted",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "security-transaction.schema.json#/$defs/terminal_outcome/oneOf/1/properties/outcome",
                "owner": "security-transaction.schema.json#/$defs/terminal_outcome/oneOf/1/properties/outcome",
                "values": [
                  "aborted"
                ]
              },
              "x-arkret-outcome-scope": "security_transaction_execution"
            },
            "completed_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "completed_at"
          ],
          "properties": {
            "outcome": {
              "const": "expired",
              "x-arkret-value-ownership": {
                "class": "owned_symbol",
                "authority": "security-transaction.schema.json#/$defs/terminal_outcome/oneOf/2/properties/outcome",
                "owner": "security-transaction.schema.json#/$defs/terminal_outcome/oneOf/2/properties/outcome",
                "values": [
                  "expired"
                ]
              },
              "x-arkret-outcome-scope": "security_transaction_execution"
            },
            "completed_at": {
              "$ref": "./time.schema.json#/$defs/timestamp"
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "x-arkret-name-role": "terminal_outcome",
      "x-arkret-outcome-scope": "security_transaction_execution"
    },
    "transaction_id": {
      "$ref": "./recovery-authority.schema.json#/$defs/transaction_id"
    },
    "security_rotation_transaction": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "account_id",
        "authorizing_device_id",
        "expires_at",
        "created_at",
        "request_digest",
        "prepared_plan",
        "prepared_plan_digest",
        "accepted_steps"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "const": "security_rotation",
          "x-arkret-value-ownership": {
            "class": "owned_symbol",
            "authority": "security-transaction.schema.json#/$defs/security_rotation_transaction/properties/kind",
            "owner": "security-transaction.schema.json#/$defs/security_rotation_transaction/properties/kind",
            "values": [
              "security_rotation"
            ]
          }
        },
        "account_id": {
          "$ref": "./common-ids.schema.json#/$defs/account_id",
          "description": "Exact account owner. Its station_id is the coordinator: the service core identity of the executing Station, not an arbitrary external coordinator. Process separation is deployment-private and creates no public coordinator role."
        },
        "authorizing_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id",
          "description": "SecurityRotation only. Exact device from the fresh high-risk authenticated create session. The coordinator binds it to that session and persists it before any side effect; the worker rechecks that the account and this device are still active immediately before old-material erasure."
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "created_at": {
