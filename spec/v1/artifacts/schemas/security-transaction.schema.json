        },
        {
          "$ref": "#/$defs/accepted_publish_did_entry"
        },
        {
          "$ref": "#/$defs/accepted_submit_reanchor_unit"
        },
        {
          "$ref": "#/$defs/accepted_issue_terminal_receipt"
        }
      ],
      "items": false
    },
    "security_rotation_accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/accepted_revoke"
        },
        {
          "$ref": "#/$defs/accepted_upload_new_material"
        },
        {
          "$ref": "#/$defs/accepted_switch_authoritative_pointer"
        },
        {
          "$ref": "#/$defs/accepted_erase_old_material"
        },
        {
          "$ref": "#/$defs/accepted_local_commit"
        }
      ],
      "items": false
    },
    "cross_signing_recovery_step": {
      "type": "string",
      "enum": [
        "submit_authorize_unit",
        "issue_terminal_receipt"
      ]
    },
    "enrollment_authority_recovery_step": {
      "type": "string",
      "enum": [
        "issue_authority_ticket",
        "authorize_recovery_device",
        "publish_did_entry",
        "submit_reanchor_unit",
        "issue_terminal_receipt"
      ]
    },
    "security_rotation_step": {
      "type": "string",
      "enum": [
        "revoke",
        "upload_new_material",
        "switch_authoritative_pointer",
        "erase_old_material",
        "local_commit"
      ]
    },
    "any_step": {
      "type": "string",
      "enum": [
        "submit_authorize_unit",
        "issue_authority_ticket",
        "authorize_recovery_device",
        "publish_did_entry",
        "submit_reanchor_unit",
        "issue_terminal_receipt",
        "revoke",
        "upload_new_material",
        "switch_authoritative_pointer",
        "erase_old_material",
        "local_commit"
      ]
    },
    "cross_signing_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_device_attestation"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 0
                  },
                  "next_required_step": {
                    "const": "submit_authorize_unit"
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "running"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "next_required_step": {
                    "const": "issue_terminal_receipt"
                  },
                  "state": {
                    "const": "awaiting_device_attestation"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    },
    "enrollment_authority_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_device_attestation"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 0
                  },
                  "next_required_step": {
                    "const": "issue_authority_ticket"
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "running"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "next_required_step": {
                    "const": "authorize_recovery_device"
                  },
                  "state": {
                    "const": "running"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "next_required_step": {
                    "const": "publish_did_entry"
                  },
                  "state": {
                    "const": "running"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "next_required_step": {
                    "const": "submit_reanchor_unit"
                  },
                  "state": {
                    "const": "running"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "next_required_step": {
                    "const": "issue_terminal_receipt"
                  },
                  "state": {
                    "const": "awaiting_device_attestation"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
    "security_rotation_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "awaiting_device_attestation"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 0
                  },
                  "next_required_step": {
                    "const": "revoke"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "next_required_step": {
                    "const": "upload_new_material"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "next_required_step": {
                    "const": "switch_authoritative_pointer"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "next_required_step": {
                    "const": "erase_old_material"
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "next_required_step": {
                    "const": "local_commit"
                  },
                  "state": {
                    "const": "awaiting_device_attestation"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
    "client_step_attestation": {
      "type": "object",
      "required": [
        "step",
        "output_ref",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "attestation_digest",
        "verification_method",
        "alg",
        "signature"
      ],
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "issue_terminal_receipt",
            "local_commit"
          ]
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "attestation_digest": {
          "$ref": "#/$defs/hash"
        },
        "verification_method": {
          "$ref": "./common-ids.schema.json#/$defs/did_url"
        },
        "alg": {
          "type": "string",
          "const": "EdDSA"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "terminal_result": {
      "type": "object",
      "required": [
        "result",
        "completed_at"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "completed",
            "aborted",
            "expired"
          ]
        },
        "completed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "recovery_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "principal_id",
        "expires_at",
        "binding",
        "prepared_plan",
        "prepared_plan_digest"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "recovery"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "binding": {
          "oneOf": [
            {
              "$ref": "#/$defs/cross_signing_recovery_binding"
            },
            {
              "$ref": "#/$defs/enrollment_authority_recovery_binding"
            }
          ]
        },
        "prepared_plan": {
          "oneOf": [
            {
              "$ref": "#/$defs/cross_signing_recovery_plan"
            },
            {
              "$ref": "#/$defs/enrollment_authority_recovery_plan"
            }
          ]
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "binding": {
                "properties": {
                  "identity_model": {
                    "const": "cross_signing"
                  }
                },
                "required": [
                  "identity_model"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "prepared_plan": {
                "$ref": "#/$defs/cross_signing_recovery_plan"
              }
            }
          },
          "else": {
            "properties": {
              "prepared_plan": {
                "$ref": "#/$defs/enrollment_authority_recovery_plan"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "security_rotation_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "principal_id",
        "expires_at",
        "binding",
        "prepared_plan",
        "prepared_plan_digest"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "security_rotation"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "binding": {
          "$ref": "#/$defs/security_rotation_binding"
        },
        "prepared_plan": {
          "$ref": "#/$defs/security_rotation_plan"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "create_request": {
      "oneOf": [
        {
          "$ref": "#/$defs/recovery_create_request"
        },
        {
          "$ref": "#/$defs/security_rotation_create_request"
        }
      ]
    },
    "continue_request": {
      "type": "object",
      "required": [
        "request_digest",
        "prepared_plan_digest",
        "expected_next_step"
      ],
      "properties": {
        "request_digest": {
          "$ref": "#/$defs/hash"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/hash"
        },
        "expected_next_step": {
          "$ref": "#/$defs/any_step"
        },
        "client_attestation": {
          "$ref": "#/$defs/client_step_attestation"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "client_attestation"
            ]
          },
          "then": {
            "properties": {
              "expected_next_step": {
                "enum": [
                  "issue_terminal_receipt",
                  "local_commit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_next_step": {
                "enum": [
                  "issue_terminal_receipt",
                  "local_commit"
                ]
              }
            },
            "required": [
              "expected_next_step"
            ]
          },
          "then": {
            "required": [
              "client_attestation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "client_attestation"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
