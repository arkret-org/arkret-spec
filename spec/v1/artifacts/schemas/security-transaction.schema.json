{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/security-transaction.schema.json",
  "title": "Arkret Security Transaction",
  "description": "Closed durable RecoveryTransaction and SecurityRotationTransaction resource. The prepared plan is the sole canonical intent source; accepted outputs form a durable ordered prefix.",
  "type": "object",
  "required": [
    "transaction_id",
    "kind",
    "principal_id",
    "coordinator_service_id",
    "expires_at",
    "created_at",
    "request_digest",
    "prepared_plan",
    "prepared_plan_digest",
    "state",
    "accepted_steps"
  ],
  "properties": {
    "transaction_id": {
      "$ref": "#/$defs/transaction_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "recovery",
        "security_rotation"
      ]
    },
    "principal_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "coordinator_service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did_core_id"
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "prepared_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/pcr_policy_recovery_plan"
        },
        {
          "$ref": "#/$defs/security_rotation_plan"
        }
      ]
    },
    "prepared_plan_digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest of canonical prepared_plan bytes. Implementations MUST recompute it and persist both bytes and typed value before the first side effect."
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "aborted",
        "expired"
      ]
    },
    "accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Durable accepted prefix. Entry i has the step kind at index i of the fixed order selected by kind; entries never carry a duplicate step label."
    },
    "terminal_result": {
      "$ref": "#/$defs/terminal_result"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "prepared_plan": {
            "$ref": "#/$defs/pcr_policy_recovery_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/pcr_policy_accepted_steps"
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/pcr_policy_progress_contract"
          }
        ]
      },
      "else": {
        "properties": {
          "prepared_plan": {
            "$ref": "#/$defs/security_rotation_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/security_rotation_accepted_steps"
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/security_rotation_progress_contract"
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed",
              "aborted",
              "expired"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "terminal_result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "terminal_result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "completed"
              }
            },
            "required": [
              "receipt_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "aborted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "aborted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "expired"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "expired"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          },
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "kind",
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "required": [
              "completion_attestation"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "terminal_result": {
            "not": {
              "required": [
                "completion_attestation"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "accepted_step": {
      "type": "object",
      "required": [
        "prepared_material_digest",
        "acceptor_id",
        "output_ref",
        "output_digest",
        "accepted_at"
      ],
      "properties": {
        "prepared_material_digest": {
          "$ref": "#/$defs/digest"
        },
        "acceptor_id": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:[^\\s#?]+|ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "output_digest": {
          "$ref": "#/$defs/digest"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "description": "Evidence accepted at one position in the kind-specific fixed step order. The position, not a duplicated label, determines the step kind."
    },
    "backup_id": {
      "type": "string",
      "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_object_ref": {
      "type": "object",
      "required": [
        "backup_id",
        "ciphertext_digest"
      ],
      "properties": {
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "ciphertext_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_binding": {
      "type": "object",
      "required": [
        "backup_kind",
        "previous_series_id",
        "new_series_id",
        "new_backups",
        "active_series_event_id",
        "old_backups"
      ],
      "properties": {
        "backup_kind": {
          "type": "string",
          "enum": [
            "secret_storage",
            "mls_history"
          ]
        },
        "previous_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "new_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        },
        "active_series_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "old_backups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_object_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "backup_rotation_plan": {
      "type": "object",
      "required": [
        "binding",
        "encrypted_backup_material",
        "active_series_unit"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/backup_rotation_binding"
        },
        "encrypted_backup_material": {
          "$ref": "./recovery-authority.schema.json#/$defs/canonical_public_material"
        },
        "active_series_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "backup_series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "client_step_attestation": {
      "type": "object",
      "required": [
        "step",
        "output_ref",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "attestation_digest",
        "artifact",
        "auth_data"
      ],
      "properties": {
        "step": {
          "allOf": [
            {
              "type": "string",
              "enum": [
                "issue_terminal_receipt",
                "local_commit"
              ]
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/pcr_policy_recovery_step"
                },
                {
                  "$ref": "#/$defs/security_rotation_step"
                }
              ]
            }
          ]
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "attestation_digest": {
          "$ref": "#/$defs/digest",
          "description": "SHA-256 of JCS(artifact). The coordinator MUST recompute it from the received typed artifact bytes."
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "./recovery-receipt.schema.json"
            },
            {
              "$ref": "#/$defs/security_rotation_local_commit"
            }
          ]
        },
        "auth_data": {
          "type": "object",
          "required": [
            "verification_method",
            "signature_algorithm",
            "signature",
            "signed_fields"
          ],
          "properties": {
            "verification_method": {
              "$ref": "./common-ids.schema.json#/$defs/did_url"
            },
            "signature_algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "signed_fields": {
              "type": "array",
              "const": [
                "step",
                "output_ref",
                "transaction_id",
                "transaction_request_digest",
                "prepared_plan_digest",
                "attestation_digest"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "step": {
                "const": "issue_terminal_receipt"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "./recovery-receipt.schema.json"
              }
            }
          },
          "else": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/security_rotation_local_commit"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "continue_request": {
      "type": "object",
      "required": [
        "request_digest",
        "prepared_plan_digest",
        "expected_accepted_step_count"
      ],
      "properties": {
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "expected_accepted_step_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "CAS coordinate. It MUST equal the current accepted_steps length; the coordinator selects the next fixed step from transaction kind and this index."
        },
        "client_attestation": {
          "$ref": "#/$defs/client_step_attestation"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "client_attestation"
            ]
          },
          "then": {
            "properties": {
              "expected_accepted_step_count": {
                "enum": [
                  1,
                  4
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_accepted_step_count": {
                "enum": [
                  1,
                  4
                ]
              }
            },
            "required": [
              "expected_accepted_step_count"
            ]
          },
          "then": {
            "required": [
              "client_attestation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "client_attestation"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "create_request": {
      "oneOf": [
        {
          "$ref": "#/$defs/recovery_create_request"
        },
        {
          "$ref": "#/$defs/security_rotation_create_request"
        }
      ]
    },
    "pcr_generation_ref": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[A-Za-z0-9_-]{44}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "prepared_event_unit": {
      "type": "object",
      "description": "Exact typed Event submit request and persisted canonical bytes. A PCR recovery unit contains reanchor plus replacement authorize for the same account-local lineage/session/generation CAS; candidate possession is verified through the unit-local overlay before mutation and never by resolving current human DID.",
      "required": [
        "operation_id",
        "destination_service_id",
        "audience",
        "request_schema",
        "request",
        "canonical_request_base64url",
        "request_digest"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "const": "ak.self.events.command.submit"
        },
        "destination_service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "audience": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "request_schema": {
          "type": "string",
          "const": "https://arkret.org/v1/schemas/service-operation-dtos.schema.json#/$defs/EventsSubmitBatchRequestBody"
        },
        "request": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Typed value that MUST independently validate against request_schema. The indirection keeps the transaction schema acyclic while preserving a closed schema identity."
        },
        "canonical_request_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "principal_id",
        "expires_at",
        "prepared_plan"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "recovery"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "prepared_plan": {
          "$ref": "#/$defs/pcr_policy_recovery_plan"
        }
      },
      "additionalProperties": false
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "pcr_policy_accepted_steps": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Accepted prefix for the canonical pcr_policy step order declared by pcr_policy_recovery_step."
    },
    "pcr_policy_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 0
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "running"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 1,
                    "maxItems": 1
                  },
                  "state": {
                    "const": "running"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    },
    "pcr_policy_recovery_binding": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_id",
        "replacement_device_id",
        "reanchor_event_id",
        "authorize_event_id",
        "terminal_receipt_id"
      ],
      "properties": {
        "identity_model": {
          "const": "pcr_policy"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "reanchor_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "authorize_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_plan": {
      "type": "object",
      "required": [
        "binding",
        "recovery_session_snapshot_digest",
        "proof_digest",
        "previous_model_generation_ref",
        "result_model_generation_ref",
        "reanchor_unit"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/pcr_policy_recovery_binding"
        },
        "recovery_session_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "proof_digest": {
          "$ref": "#/$defs/digest"
        },
        "previous_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/pcr_generation_ref"
        },
        "reanchor_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "pcr_policy_recovery_step": {
      "type": "string",
      "description": "The enum array order is the canonical PCR-policy recovery step order addressed by accepted_steps indexes.",
      "enum": [
        "submit_reanchor_unit",
        "issue_terminal_receipt"
      ]
    },
    "security_rotation_accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      },
      "description": "Accepted prefix for the canonical rotation step order declared by security_rotation_step."
    },
    "security_rotation_create_request": {
      "type": "object",
      "required": [
        "transaction_id",
        "kind",
        "principal_id",
        "expires_at",
        "prepared_plan"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "kind": {
          "type": "string",
          "const": "security_rotation"
        },
        "principal_id": {
          "$ref": "./common-ids.schema.json#/$defs/did_core_id"
        },
        "expires_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "prepared_plan": {
          "$ref": "#/$defs/security_rotation_plan"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_local_commit": {
      "type": "object",
      "required": [
        "schema",
        "transaction_id",
        "transaction_request_digest",
        "prepared_plan_digest",
        "local_commit_digest",
        "device_id",
        "committed_at"
      ],
      "properties": {
        "schema": {
          "const": "ak.schema.security_rotation_local_commit.v1"
        },
        "transaction_id": {
          "$ref": "#/$defs/transaction_id"
        },
        "transaction_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "local_commit_digest": {
          "$ref": "#/$defs/digest"
        },
        "device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "committed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_plan": {
      "type": "object",
      "required": [
        "revoke_unit",
        "new_secret_commitment",
        "backup_rotations",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/digest"
        },
        "backup_rotations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backup_rotation_plan"
          },
          "description": "The canonical secret_storage then mls_history entries; each nested binding is the sole source of its reserved series and object references."
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/digest",
          "description": "Must equal the non-circular projection digest over transaction_id and this plan's nested backup rotation bindings."
        },
        "local_commit_digest": {
          "$ref": "#/$defs/digest",
          "description": "Must equal the non-circular projection digest over transaction_id, new_secret_commitment and this plan's nested backup rotation bindings."
        }
      },
      "additionalProperties": false
    },
    "security_rotation_progress_contract": {
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "running"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "accepted_steps": {
                    "maxItems": 3
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "running"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "accepted_steps": {
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "state": {
                    "const": "running"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "accepted_steps": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
    "security_rotation_step": {
      "type": "string",
      "description": "The enum array order is the canonical security-rotation step order addressed by accepted_steps indexes.",
      "enum": [
        "revoke",
        "upload_new_material",
        "switch_authoritative_pointer",
        "erase_old_material",
        "local_commit"
      ]
    },
    "step_output_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "terminal_result": {
      "type": "object",
      "required": [
        "result",
        "completed_at"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "completed",
            "aborted",
            "expired"
          ]
        },
        "completed_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        },
        "receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "completion_attestation": {
          "$ref": "./recovery-authority.schema.json#/$defs/recovery_completion_attestation"
        }
      },
      "additionalProperties": false
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
