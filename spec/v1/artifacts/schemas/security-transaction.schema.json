{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkret.org/v1/schemas/security-transaction.schema.json",
  "title": "Arkret Security Transaction",
  "description": "Closed durable RecoveryTransaction and SecurityRotationTransaction resource. Binding, prepared plan and accepted outputs are separate protocol states.",
  "type": "object",
  "required": [
    "transaction_id",
    "kind",
    "principal_id",
    "coordinator_service_id",
    "expires_at",
    "created_at",
    "request_digest",
    "binding",
    "prepared_plan",
    "prepared_plan_digest",
    "state",
    "accepted_steps",
    "next_required_step"
  ],
  "properties": {
    "transaction_id": {
      "$ref": "#/$defs/transaction_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "recovery",
        "security_rotation"
      ]
    },
    "principal_id": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "coordinator_service_id": {
      "$ref": "./common-ids.schema.json#/$defs/did"
    },
    "expires_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "./time.schema.json#/$defs/timestamp"
    },
    "request_digest": {
      "$ref": "#/$defs/hash"
    },
    "binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/cross_signing_recovery_binding"
        },
        {
          "$ref": "#/$defs/enrollment_authority_recovery_binding"
        },
        {
          "$ref": "#/$defs/security_rotation_binding"
        }
      ]
    },
    "prepared_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/cross_signing_recovery_plan"
        },
        {
          "$ref": "#/$defs/enrollment_authority_recovery_plan"
        },
        {
          "$ref": "#/$defs/security_rotation_plan"
        }
      ]
    },
    "prepared_plan_digest": {
      "$ref": "#/$defs/hash",
      "description": "Digest of canonical prepared_plan bytes. Implementations MUST recompute it and persist both bytes and typed value before the first side effect."
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "awaiting_device_attestation",
        "completed",
        "aborted",
        "expired"
      ]
    },
    "accepted_steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/accepted_step"
      }
    },
    "next_required_step": {
      "oneOf": [
        {
          "$ref": "#/$defs/any_step"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_result": {
      "$ref": "#/$defs/terminal_result"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recovery"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "binding": {
                  "properties": {
                    "identity_model": {
                      "const": "cross_signing"
                    }
                  },
                  "required": [
                    "identity_model"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "binding": {
                  "$ref": "#/$defs/cross_signing_recovery_binding"
                },
                "prepared_plan": {
                  "$ref": "#/$defs/cross_signing_recovery_plan"
                },
                "accepted_steps": {
                  "$ref": "#/$defs/cross_signing_accepted_steps"
                },
                "next_required_step": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/cross_signing_recovery_step"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "$ref": "#/$defs/cross_signing_progress_contract"
                }
              ]
            },
            "else": {
              "properties": {
                "binding": {
                  "$ref": "#/$defs/enrollment_authority_recovery_binding"
                },
                "prepared_plan": {
                  "$ref": "#/$defs/enrollment_authority_recovery_plan"
                },
                "accepted_steps": {
                  "$ref": "#/$defs/enrollment_authority_accepted_steps"
                },
                "next_required_step": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/enrollment_authority_recovery_step"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "$ref": "#/$defs/enrollment_authority_progress_contract"
                }
              ]
            }
          }
        ]
      },
      "else": {
        "properties": {
          "binding": {
            "$ref": "#/$defs/security_rotation_binding"
          },
          "prepared_plan": {
            "$ref": "#/$defs/security_rotation_plan"
          },
          "accepted_steps": {
            "$ref": "#/$defs/security_rotation_accepted_steps"
          },
          "next_required_step": {
            "oneOf": [
              {
                "$ref": "#/$defs/security_rotation_step"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/security_rotation_progress_contract"
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed",
              "aborted",
              "expired"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "terminal_result"
        ],
        "properties": {
          "next_required_step": {
            "type": "null"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "terminal_result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "completed"
              }
            },
            "required": [
              "receipt_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "aborted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "aborted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "expired"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "terminal_result": {
            "properties": {
              "result": {
                "const": "expired"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^ak:transaction:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovery_session_id": {
      "type": "string",
      "pattern": "^ak:recovery_session:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authority_ticket_id": {
      "type": "string",
      "pattern": "^ak:recovery_authority_ticket:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ak:event:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ak:receipt:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_series_id": {
      "type": "string",
      "pattern": "^ak:backup_series:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backup_id": {
      "type": "string",
      "pattern": "^ak:backup:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "step_output_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "cross_signing_generation_ref": {
      "type": "integer",
      "minimum": 1
    },
    "did_generation_ref": {
      "type": "string",
      "pattern": "^[1-9][0-9]*-[^\\s]+$"
    },
    "prepared_event_unit": {
      "type": "object",
      "description": "Exact typed Event submit request and its persisted canonical bytes. The request MUST be a batch whose Event ids and kinds equal the enclosing closed plan.",
      "required": [
        "operation_id",
        "destination_service_id",
        "audience",
        "request_schema",
        "request",
        "canonical_request_base64url",
        "request_digest"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "const": "ak.self.events.command.submit"
        },
        "destination_service_id": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "audience": {
          "$ref": "./common-ids.schema.json#/$defs/did"
        },
        "request_schema": {
          "type": "string",
          "const": "https://arkret.org/v1/schemas/service-operation-dtos.schema.json#/$defs/EventsSubmitBatchRequestBody"
        },
        "request": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Typed value that MUST independently validate against request_schema. The indirection keeps the transaction schema acyclic while preserving a closed schema identity."
        },
        "canonical_request_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "prepared_event_publication_material": {
      "type": "object",
      "description": "Publication evidence fixed for an authority-produced Event whose signed Event bytes become an accepted output after create.",
      "required": [
        "event_id",
        "publication_material_schema",
        "publication_material",
        "material_digest"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "publication_material_schema": {
          "type": "string",
          "const": "https://arkret.org/v1/schemas/service-operation-dtos.schema.json#/$defs/EventInitialSubmission"
        },
        "publication_material": {
          "$ref": "./recovery-authority.schema.json#/$defs/canonical_public_material",
          "description": "Canonical typed publication wrapper containing the authorization lease and any CBA proof bundles. The authority-produced Event is inserted only after its accepted output is available."
        },
        "material_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "prepared_did_publication": {
      "type": "object",
      "required": [
        "registry_url",
        "previous_entry_ref",
        "expected_entry_ref",
        "canonical_entry_base64url",
        "entry_digest"
      ],
      "properties": {
        "registry_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "previous_entry_ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_entry_ref": {
          "type": "string",
          "minLength": 1
        },
        "canonical_entry_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "entry_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "cross_signing_recovery_binding": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_id",
        "replacement_device_id",
        "authorize_event_id",
        "device_list_update_event_id",
        "terminal_receipt_id"
      ],
      "properties": {
        "identity_model": {
          "type": "string",
          "const": "cross_signing"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "authorize_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "device_list_update_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        }
      },
      "additionalProperties": false
    },
    "enrollment_authority_recovery_binding": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_id",
        "replacement_device_id",
        "authority_ticket_id",
        "did_entry_ref",
        "reanchor_event_id",
        "authorize_event_id",
        "terminal_receipt_id"
      ],
      "properties": {
        "identity_model": {
          "type": "string",
          "const": "enrollment_authority"
        },
        "recovery_session_id": {
          "$ref": "#/$defs/recovery_session_id"
        },
        "replacement_device_id": {
          "$ref": "./common-ids.schema.json#/$defs/device_id"
        },
        "authority_ticket_id": {
          "$ref": "#/$defs/authority_ticket_id"
        },
        "did_entry_ref": {
          "type": "string",
          "minLength": 1
        },
        "reanchor_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "authorize_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "terminal_receipt_id": {
          "$ref": "#/$defs/receipt_id"
        }
      },
      "additionalProperties": false
    },
    "cross_signing_recovery_plan": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_snapshot_digest",
        "proof_digest",
        "previous_model_generation_ref",
        "result_model_generation_ref",
        "authorize_unit"
      ],
      "properties": {
        "identity_model": {
          "type": "string",
          "const": "cross_signing"
        },
        "recovery_session_snapshot_digest": {
          "$ref": "#/$defs/hash"
        },
        "proof_digest": {
          "$ref": "#/$defs/hash"
        },
        "previous_model_generation_ref": {
          "$ref": "#/$defs/cross_signing_generation_ref"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/cross_signing_generation_ref"
        },
        "authorize_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        }
      },
      "additionalProperties": false
    },
    "enrollment_authority_recovery_plan": {
      "type": "object",
      "required": [
        "identity_model",
        "recovery_session_snapshot_digest",
        "proof_digest",
        "previous_model_generation_ref",
        "result_model_generation_ref",
        "authorization_preimage",
        "authorization_request_digest",
        "did_publication",
        "reanchor_event_submission",
        "reanchor_event_submission_digest",
        "authorize_event_publication_material"
      ],
      "properties": {
        "identity_model": {
          "type": "string",
          "const": "enrollment_authority"
        },
        "recovery_session_snapshot_digest": {
          "$ref": "#/$defs/hash"
        },
        "proof_digest": {
          "$ref": "#/$defs/hash"
        },
        "previous_model_generation_ref": {
          "$ref": "#/$defs/did_generation_ref"
        },
        "result_model_generation_ref": {
          "$ref": "#/$defs/did_generation_ref"
        },
        "authorization_preimage": {
          "$ref": "./recovery-authority.schema.json#/$defs/authorization_preimage"
        },
        "authorization_request_digest": {
          "$ref": "#/$defs/hash"
        },
        "did_publication": {
          "$ref": "#/$defs/prepared_did_publication"
        },
        "reanchor_event_submission": {
          "$ref": "./recovery-authority.schema.json#/$defs/canonical_public_material"
        },
        "reanchor_event_submission_digest": {
          "$ref": "#/$defs/hash"
        },
        "authorize_event_publication_material": {
          "$ref": "#/$defs/prepared_event_publication_material"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_binding": {
      "type": "object",
      "required": [
        "revoke_event_id",
        "new_secret_commitment",
        "series_id",
        "backup_id",
        "active_series_event_id",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/hash"
        },
        "series_id": {
          "$ref": "#/$defs/backup_series_id"
        },
        "backup_id": {
          "$ref": "#/$defs/backup_id"
        },
        "active_series_event_id": {
          "$ref": "#/$defs/event_id"
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/hash"
        },
        "local_commit_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "security_rotation_plan": {
      "type": "object",
      "required": [
        "revoke_unit",
        "new_secret_commitment",
        "encrypted_backup_material",
        "active_series_unit",
        "erase_confirmation_digest",
        "local_commit_digest"
      ],
      "properties": {
        "revoke_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "new_secret_commitment": {
          "$ref": "#/$defs/hash"
        },
        "encrypted_backup_material": {
          "$ref": "./recovery-authority.schema.json#/$defs/canonical_public_material"
        },
        "active_series_unit": {
          "$ref": "#/$defs/prepared_event_unit"
        },
        "erase_confirmation_digest": {
          "$ref": "#/$defs/hash"
        },
        "local_commit_digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "accepted_step": {
      "type": "object",
      "required": [
        "step",
        "prepared_material_digest",
        "acceptor_id",
        "output_ref",
        "output_digest",
        "accepted_at"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/any_step"
        },
        "prepared_material_digest": {
          "$ref": "#/$defs/hash"
        },
        "acceptor_id": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:[^\\s#?]+|ak:device:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
        },
        "output_ref": {
          "$ref": "#/$defs/step_output_ref"
        },
        "output_digest": {
          "$ref": "#/$defs/hash"
        },
        "accepted_at": {
          "$ref": "./time.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "accepted_submit_authorize_unit": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "submit_authorize_unit"
            }
          }
        }
      ]
    },
    "accepted_issue_authority_ticket": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "issue_authority_ticket"
            }
          }
        }
      ]
    },
    "accepted_authorize_recovery_device": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "authorize_recovery_device"
            }
          }
        }
      ]
    },
    "accepted_publish_did_entry": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "publish_did_entry"
            }
          }
        }
      ]
    },
    "accepted_submit_reanchor_unit": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "submit_reanchor_unit"
            }
          }
        }
      ]
    },
    "accepted_issue_terminal_receipt": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "issue_terminal_receipt"
            }
          }
        }
      ]
    },
    "accepted_revoke": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "revoke"
            }
          }
        }
      ]
    },
    "accepted_upload_new_material": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "upload_new_material"
            }
          }
        }
      ]
    },
    "accepted_switch_authoritative_pointer": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "switch_authoritative_pointer"
            }
          }
        }
      ]
    },
    "accepted_erase_old_material": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "erase_old_material"
            }
          }
        }
      ]
    },
    "accepted_local_commit": {
      "allOf": [
        {
          "$ref": "#/$defs/accepted_step"
        },
        {
          "properties": {
            "step": {
              "const": "local_commit"
            }
          }
        }
      ]
    },
    "cross_signing_accepted_steps": {
      "type": "array",
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/accepted_submit_authorize_unit"
        },
        {
          "$ref": "#/$defs/accepted_issue_terminal_receipt"
        }
