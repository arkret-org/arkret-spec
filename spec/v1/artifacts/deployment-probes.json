{
  "version": "2026-06-19",
  "source_of_truth": true,
  "schema": "arkret.deployment_probes.v1",
  "description": "Machine-readable deployment probes for transport- and operator-posture requirements that are not object-model conformance vectors.",
  "probes": [
    {
      "probe_id": "deployment_probe.tls.pq_hybrid_x25519mlkem768.v1",
      "status": "active",
      "scope": "high_security_and_sovereign_profiles",
      "applies_to_profiles": [
        "ak.profile.high_security_organization.v1",
        "ak.profile.sovereign_deployment.v1",
        "ak.profile.sovereign_enclave.v1",
        "ak.profile.isolated_sovereign_network.v1"
      ],
      "applies_to_connections": [
        "client_service",
        "service_to_service",
        "federation_peer"
      ],
      "requirement_level": "MUST",
      "defined_in": [
        "zh/sync/transport-bindings.md §5",
        "zh/security/server-threat-model.md §2.4",
        "zh/sync/sovereign-deployment.md §11"
      ],
      "tls": {
        "protocol": "TLS 1.3",
        "required_named_group": "X25519MLKEM768",
        "iana_supported_group_codepoint": "0x11EC",
        "fail_closed_without_group": true,
        "silent_classical_fallback_allowed": false
      },
      "external_spec": {
        "id": "draft-ietf-tls-ecdhe-mlkem",
        "revision": "05",
        "url": "https://datatracker.ietf.org/doc/html/draft-ietf-tls-ecdhe-mlkem-05"
      },
      "probe": {
        "kind": "tls_negotiated_group",
        "success_condition": "for high-security or sovereign profile claims, the completed handshake negotiated TLS group X25519MLKEM768; a peer that does not offer that group is rejected rather than downgraded",
        "success_values": [
          "verified",
          "x25519mlkem768",
          "tls13+x25519mlkem768"
        ],
        "evidence_env": "ARKRET_PQ_TLS_DEPLOYMENT_PROBE"
      }
    }
  ]
}
