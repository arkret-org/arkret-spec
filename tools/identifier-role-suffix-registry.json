  "generic_grammars": [
    {
      "category": "primary_or_responsibility_id",
      "terminal_categories": ["did_core_id", "typed_object_id"],
      "exact_names": ["id"],
      "suffixes": ["_id", "_ids"]
    },
    {
      "category": "reference_material",
      "terminal_categories": ["did_core_id", "typed_object_id", "did_url"],
      "exact_names": [],
      "suffixes": ["_ref", "_refs"]
    },
    {
      "category": "cursor_coordinate",
      "terminal_categories": ["typed_object_id"],
      "exact_names": ["cursor"],
      "suffixes": ["_cursor"]
    },
    {
      "category": "frontier_coordinate",
      "terminal_categories": ["typed_object_id"],
      "exact_names": ["frontier", "heads", "leaves", "before", "after", "wait_for", "invite", "join", "remove", "share"],
      "suffixes": ["_frontier"]
    },
    {
      "category": "did_material",
      "terminal_categories": ["did"],
      "exact_names": ["did"],
      "suffixes": ["_did", "_dids"]
    },
    {
      "category": "key_selector",
      "terminal_categories": ["did_url"],
      "exact_names": ["kid", "verification_method"],
      "suffixes": ["_kid", "_kids", "_verification_method"]
    },
    {
      "category": "uri_material",
      "terminal_categories": ["uri"],
      "exact_names": ["uri"],
      "suffixes": ["_uri", "_uris"]
    },
    {
      "category": "trust_domain_special_form",
      "terminal_categories": ["typed_object_id"],
      "exact_names": ["trust_domain"],
      "suffixes": []
    }
  ],
  "exact_exceptions": [
    {
      "file": "capability-grant.schema.json",
      "pointer": "/properties/subject",
      "terminal_categories": ["did_core_id"],
      "reason": "closed condition-selector union: did_core_id or discriminator-bearing condition object"
    },
    {
      "file": "event-payload.schema.json",
      "pointer": "/$defs/capability_grant_payload/properties/grant/properties/subject",
      "terminal_categories": ["did_core_id"],
      "reason": "exact projection of CapabilityGrant.subject closed condition-selector union"
    },
    {
      "file": "common-ids.schema.json",
      "pointer": "/$defs/tsp_vid/oneOf/0/properties/value",
      "terminal_categories": ["did"],
      "reason": "value is the payload of the closed tsp_vid union and its sibling kind discriminator selects the DID representation"
    },
    {
      "file": "event-payload.schema.json",
      "pointer": "/$defs/account_blocklist_payload/properties/entries/items/properties/target/anyOf/1/properties/value",
      "terminal_categories": ["did_url"],
      "reason": "value is inside the closed account-block target union whose containing branch determines the representation"
    },
    {
      "file": "event-envelope.schema.json",
      "pointer": "/properties/authorization_ref",
      "terminal_categories": ["mixed[did_url,typed_object_id]"],
      "reason": "closed, lexically disjoint authorization reference union governed by the independent _ref grammar"
    },
    {
      "file": "event-payload.schema.json",
      "pointer": "/$defs/device_authorize_payload/properties/authorized_by",
      "terminal_categories": ["mixed[did_core_id,typed_object_id]"],
      "reason": "closed device-or-principal ID union selected by authorization_binding_kind; the complete authorized_by role retains its bare byline spelling"
    },
    {
      "file": "event-payload.schema.json",
      "pointer": "/$defs/device_revoke_payload/properties/revoked_by",
      "terminal_categories": ["mixed[did_core_id,typed_object_id]"],
      "reason": "closed device-or-principal ID union; the complete revoked_by provenance role retains its bare byline spelling"
    },
    {
      "file": "device-pairing.schema.json",
      "pointer": "/$defs/device_pairing_challenge_proof/properties/kid",
      "terminal_categories": ["typed_object_id"],
      "reason": "registered compact proof key-selector member; the sibling transcript discriminator fixes its device-key meaning"
    },
    {
      "file": "service-operation-dtos.schema.json",
      "pointer": "/$defs/SignedSessionGrantClaims/properties/jti",
      "terminal_categories": ["typed_object_id"],
      "reason": "RFC 7519 registered JWT claim name retained inside the signed claims object"
    },
    {
      "file": "service-describe.schema.json",
      "pointer": "/properties/rate_limit_policy/properties/entries/items/properties/endpoint",
      "terminal_categories": ["uri"],
      "reason": "closed endpoint selector union: absolute service path or absolute HTTP(S) URL"
    }
  ]
