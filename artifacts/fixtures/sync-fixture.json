                "source": {
                  "model": "field_value",
                  "field": "fields.status",
                  "value": "review"
                },
                "cards": [
                  {
                    "entity": {
                      "id": "cx:entity:01js0tv0000000000000000000",
                      "entity_type": "task",
                      "title": "Visible task"
                    },
                    "position": {
                      "model": "field_value",
                      "container_id": "review",
                      "rank": "F"
                    }
                  }
