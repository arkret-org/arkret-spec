          {
            "key": "done",
            "title": "Done",
            "rank": "V",
            "source": {
              "model": "field_value",
              "field": "fields.status",
              "value": "done"
            },
            "cards": [
              {
                "entity": {
                  "id": "cx:entity:01js0tz0000000000000000000",
                  "entity_type": "task",
                  "title": "Task Z"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "done",
                  "rank": "V"
                }
              }
            ],
            "next_cursor": null,
            "limited": false
          }
        ]
      },
      "followup_request": {
        "projection": "kanban",
        "view_id": "cx:view:01js0vw0000000000000000000",
        "cursor": "cx:cursor:kanban_todo_after_task_b",
        "limit": 2
