{
  "suite": "sync",
  "cases": [
    { "name": "initial_sync", "expected": "full_visible_state_with_next_batch" },
    { "name": "incremental_sync", "expected": "only_delta_since_cursor" },
    { "name": "state_after", "expected": "response_carries_post_reducer_frontier" },
    { "name": "limited_timeline_backfill", "expected": "limited_true_with_prev_batch" },
    { "name": "expired_cursor", "expected": "sync_token_expired_or_snapshot_bootstrap" },
    { "name": "filter_mismatch", "expected": "invalid_param_or_describe_guidance" },
    { "name": "to_device_ack", "expected": "acked_message_not_redelivered" },
    { "name": "snapshot_manifest_chunk_frontier", "expected": "state_hash_and_chunks_verify" },
    {
      "name": "kanban_projection_column_pagination",
      "vector": "cx.vector.sync.kanban_projection_column_pagination.v1",
      "schema_refs": {
        "request": "QueryRequest",
        "response": "KanbanProjectionResponse"
      },
      "initial_request": {
        "projection": "kanban",
        "view_id": "cx:view:01js0vw0000000000000000000",
        "entity_types": ["task"],
        "limit": 2
      },
      "initial_response": {
        "projection": "kanban",
        "view_id": "cx:view:01js0vw0000000000000000000",
        "space_id": "cx:space:01js0sp0000000000000000000",
        "frontier": {
          "state_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "operation_ids": ["cx:operation:01js0qp0000000000000000000"]
        },
        "columns": [
          {
            "key": "todo",
            "title": "Todo",
            "rank": "F",
            "source": {
              "model": "field_value",
              "field": "fields.status",
              "value": "todo"
            },
            "cards": [
              {
                "entity": {
                  "id": "cx:entity:01js0ta0000000000000000000",
                  "entity_type": "task",
                  "title": "Task A"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "todo",
                  "rank": "F"
                }
              },
              {
                "entity": {
                  "id": "cx:entity:01js0tb0000000000000000000",
                  "entity_type": "task",
                  "title": "Task B"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "todo",
                  "rank": "V"
                }
              }
            ],
            "next_cursor": "cx:cursor:kanban_todo_after_task_b",
            "limited": true
          },
          {
            "key": "done",
            "title": "Done",
            "rank": "V",
            "source": {
              "model": "field_value",
              "field": "fields.status",
              "value": "done"
            },
            "cards": [
              {
                "entity": {
                  "id": "cx:entity:01js0tz0000000000000000000",
                  "entity_type": "task",
                  "title": "Task Z"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "done",
                  "rank": "V"
                }
              }
            ],
            "next_cursor": null,
            "limited": false
          }
        ]
      },
      "followup_request": {
        "projection": "kanban",
        "view_id": "cx:view:01js0vw0000000000000000000",
        "cursor": "cx:cursor:kanban_todo_after_task_b",
        "limit": 2
      },
      "expected_followup_response": {
        "projection": "kanban",
        "view_id": "cx:view:01js0vw0000000000000000000",
        "frontier": {
          "state_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        },
        "columns": [
          {
            "key": "todo",
            "title": "Todo",
            "source": {
              "model": "field_value",
              "field": "fields.status",
              "value": "todo"
            },
            "cards": [
              {
                "entity": {
                  "id": "cx:entity:01js0tc0000000000000000000",
                  "entity_type": "task",
                  "title": "Task C"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "todo",
                  "rank": "k"
                }
              }
            ],
            "next_cursor": null,
            "limited": false
          }
        ]
      },
      "assertions": [
        "initial_response.columns[todo].limited == true",
        "initial_response.columns[done].limited == false",
        "followup_request.cursor resumes only the todo column",
        "expected_followup_response validates as KanbanProjectionResponse"
      ]
    },
    {
      "name": "kanban_projection_hidden_counts",
      "vector": "cx.vector.sync.kanban_projection_hidden_counts.v1",
      "schema_refs": {
        "view": "view.schema.json",
        "response": "KanbanProjectionResponse"
      },
      "input": {
        "view": {
          "id": "cx:view:01js0vw0000000000000000000",
          "type": "view",
          "space_id": "cx:space:01js0sp0000000000000000000",
          "kind": "kanban",
          "query": {
            "entity_types": ["task"]
          },
          "kanban": {
            "column_model": "field_value",
            "group_by": "fields.status",
            "columns": [
              {
                "key": "review",
                "title": "Review",
                "rank": "F"
              }
            ],
            "card_order_by": [
              {
                "field": "fields.rank",
                "direction": "asc"
              }
            ],
            "hidden_count_policy": "omit"
          },
          "created_by": "did:web:alice.example",
          "created_at": "2026-04-29T00:00:00Z"
        },
        "actor_visibility": {
          "visible_entities": ["cx:entity:01js0tv0000000000000000000"],
          "hidden_entities": ["cx:entity:01js0th0000000000000000000"]
        },
        "canonical_column_membership": {
          "review": [
            "cx:entity:01js0tv0000000000000000000",
            "cx:entity:01js0th0000000000000000000"
          ]
        }
      },
      "allowed_response": {
        "projection": "kanban",
        "view_id": "cx:view:01js0vw0000000000000000000",
        "frontier": {
          "state_hash": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
        },
        "columns": [
          {
            "key": "review",
            "title": "Review",
            "source": {
              "model": "field_value",
              "field": "fields.status",
              "value": "review"
            },
            "cards": [
              {
                "entity": {
                  "id": "cx:entity:01js0tv0000000000000000000",
                  "entity_type": "task",
                  "title": "Visible task"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "review",
                  "rank": "F"
                }
              }
            ],
            "next_cursor": null,
            "limited": false
          }
        ]
      },
      "rejected_response_fragment": {
        "reason": "hidden_count_policy=omit cannot expose canonical hidden membership",
        "column_key": "review",
        "total_estimate": 2
      },
      "assertions": [
        "allowed_response validates as KanbanProjectionResponse",
        "allowed_response.columns[review].cards contains only visible_entities",
        "total_estimate must be omitted unless it is visibility-trimmed and policy-authorized",
        "cursor shape and error behavior must not reveal hidden_entities"
      ]
    }
  ]
}
