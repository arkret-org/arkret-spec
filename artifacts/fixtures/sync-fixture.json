              "value": "todo"
            },
            "cards": [
              {
                "entity": {
                  "id": "cx:entity:01js0ta0000000000000000000",
                  "entity_type": "task",
                  "title": "Task A"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "todo",
                  "rank": "F"
                }
              },
              {
                "entity": {
                  "id": "cx:entity:01js0tb0000000000000000000",
                  "entity_type": "task",
                  "title": "Task B"
                },
                "position": {
                  "model": "field_value",
                  "container_id": "todo",
                  "rank": "V"
                }
              }
            ],
            "next_cursor": "cx:cursor:kanban_todo_after_task_b",
            "limited": true
