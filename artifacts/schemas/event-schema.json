{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/event-schema.json",
  "title": "Contrix Event Schema",
  "type": "object",
  "required": [
    "event_id",
    "kind",
    "space_id",
    "space_version",
    "actor_id",
    "actor_seq",
    "created_at",
    "hlc",
    "prev_refs",
    "auth_refs",
    "payload",
    "proofs"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Standard cx.* kinds MUST appear in artifacts/registry/event-kind-registry.json. Durable Event Envelope history accepts only active entries with wire_scope=durable_event unless a profile defines a private actor channel."
    },
    "state_key": {
      "type": "string",
      "description": "Top-level state key for standard state events. State resolution keys state events by (kind, state_key); payload.state_key is not the canonical wire location."
    },
    "schema": {
      "const": "cx.schema.event.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "space_version": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "actor_id": {
      "$ref": "#/$defs/did"
    },
    "actor_seq": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "prev_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventRef"
      }
    },
    "auth_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventRef"
      }
    },
    "schema_profile_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profileRef"
      },
      "uniqueItems": true
    },
    "reducer_profile_ref": {
      "$ref": "#/$defs/profileRef"
    },
    "required_features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureRef"
      },
      "uniqueItems": true
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criticalExtension"
      },
      "uniqueItems": true
    },
    "redacts": {
      "$ref": "#/$defs/eventRef"
    },
    "payload": {
      "type": "object"
    },
    "unsigned": {
      "type": "object"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "kind": {
            "enum": [
              "cx.account.blocklist",
              "cx.account_data.set",
              "cx.presence",
              "cx.typing",
              "cx.key.verification.request",
              "cx.key.verification.ready",
              "cx.key.verification.start",
              "cx.key.verification.accept",
              "cx.key.verification.key",
              "cx.key.verification.mac",
              "cx.key.verification.done",
              "cx.key.verification.cancel",
              "cx.read.marker",
              "cx.receipt.read",
              "cx.call.signal"
            ]
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cx.flow.move"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/flow_move_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cx.flow.reorder"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
