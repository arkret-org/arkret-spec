{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/event-schema.json",
  "title": "Contrix Event Schema",
  "type": "object",
  "required": [
    "event_id", "kind", "space_id", "space_version", "actor_id", "actor_seq", "created_at",
    "hlc", "prev_refs", "auth_refs", "content", "proofs"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^cx:(evt|event):[0-9a-hjkmnp-z]{26}$" },
    "kind": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "schema": { "const": "cx.schema.event.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "space_version": { "type": "string", "pattern": "^\\d+$" },
    "actor_id": { "$ref": "#/$defs/did" },
    "actor_seq": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "hlc": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{8}-[0-9a-f]{8}$" },
    "prev_refs": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } },
    "auth_refs": { "type": "array", "items": { "type": "string", "pattern": "^cx:(evt|event|grant|policy):[0-9a-hjkmnp-z]{26}$" } },
    "redacts": { "$ref": "#/$defs/eventRef" },
    "content": { "type": "object" },
    "unsigned": { "type": "object" },
    "proofs": { "type": "array", "items": { "$ref": "#/$defs/proof" }, "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "cx.card.move" } }, "required": ["kind"] },
      "then": { "properties": { "content": { "$ref": "#/$defs/card_move_content" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "cx.card.reorder" } }, "required": ["kind"] },
      "then": { "properties": { "content": { "$ref": "#/$defs/card_reorder_content" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "cx.list.reorder" } }, "required": ["kind"] },
      "then": { "properties": { "content": { "$ref": "#/$defs/list_reorder_content" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "cx.card.link_room" } }, "required": ["kind"] },
      "then": { "properties": { "content": { "$ref": "#/$defs/card_room_link_content" } } }
    }
  ],
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rank": { "type": "string", "pattern": "^[0-9A-Za-z]{1,128}$" },
    "card_id": { "type": "string", "pattern": "^cx:card:[0-9a-hjkmnp-z]{26}$" },
    "list_id": { "type": "string", "pattern": "^cx:list:[0-9a-hjkmnp-z]{26}$" },
    "room_id": { "type": "string", "pattern": "^cx:room:[0-9a-hjkmnp-z]{26}$" },
    "eventRef": { "type": "string", "pattern": "^cx:(evt|event|operation):[0-9a-hjkmnp-z]{26}$" },
    "card_move_content": {
      "type": "object",
      "required": ["card_id", "to_list_id", "rank"],
      "properties": {
        "card_id": { "$ref": "#/$defs/card_id" },
        "from_list_id": { "$ref": "#/$defs/list_id" },
        "to_list_id": { "$ref": "#/$defs/list_id" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "list_id": { "$ref": "#/$defs/list_id" },
            "rank": { "$ref": "#/$defs/rank" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "card_reorder_content": {
      "type": "object",
      "required": ["card_id", "list_id", "rank"],
      "properties": {
        "card_id": { "$ref": "#/$defs/card_id" },
        "list_id": { "$ref": "#/$defs/list_id" },
        "rank": { "$ref": "#/$defs/rank" }
      },
      "additionalProperties": false
    },
    "list_reorder_content": {
      "type": "object",
      "required": ["list_id", "rank"],
      "properties": {
        "list_id": { "$ref": "#/$defs/list_id" },
        "rank": { "$ref": "#/$defs/rank" }
      },
      "additionalProperties": false
    },
    "card_room_link_content": {
      "type": "object",
      "required": ["card_id", "room_id"],
      "properties": {
        "card_id": { "$ref": "#/$defs/card_id" },
        "room_id": { "$ref": "#/$defs/room_id" },
        "primary": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["kind", "alg", "verification_method", "payload_hash", "created_at", "jws"],
      "properties": {
        "kind": { "const": "detached_jws" },
        "alg": { "type": "string", "enum": ["EdDSA", "ES256", "ES384", "ES512"] },
        "verification_method": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+(#.+)?$" },
        "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "domain": { "type": "string" },
        "audience": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "jws": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
