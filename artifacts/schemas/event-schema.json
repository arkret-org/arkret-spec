  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*\\.v[0-9]+$"
    },
    "featureRef": {
      "type": "string",
      "pattern": "^(cx|[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+)\\.[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[0-9]+$"
    },
    "criticalExtension": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "fail_closed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/featureRef"
        },
        "scope": {
          "type": "string",
          "enum": [
            "event",
            "payload",
            "proof",
            "authz",
            "reducer",
            "projection",
            "encryption"
          ]
        },
        "schema_ref": {
          "$ref": "#/$defs/profileRef"
        },
        "fail_closed": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "rank": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{1,128}$"
    },
    "board_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "branch_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "list_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$"
    },
    "eventRef": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
    },
    "proof": {
      "type": "object",
      "required": [
        "kind",
        "alg",
        "verification_method",
        "payload_hash",
        "created_at",
        "jws"
      ],
      "properties": {
        "kind": {
          "const": "detached_jws"
        },
        "alg": {
          "type": "string",
          "enum": [
            "EdDSA",
            "ES256",
            "ES384",
            "ES512"
          ]
        },
        "verification_method": {
          "type": "string",
          "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+(#.+)?$"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "domain": {
          "type": "string"
        },
        "audience": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "jws": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.(?:[A-Za-z0-9_-]+)?\\.[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": true
    },
    "flow_move_payload": {
      "type": "object",
      "required": [
        "board_id",
        "flow_id",
        "to_list_id",
        "rank"
      ],
      "properties": {
        "board_id": {
          "$ref": "#/$defs/board_id"
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "from_list_id": {
          "$ref": "#/$defs/list_id"
        },
        "to_list_id": {
          "$ref": "#/$defs/list_id"
        },
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "expected_position": {
          "type": "object",
          "properties": {
            "list_id": {
              "$ref": "#/$defs/list_id"
            },
            "rank": {
              "$ref": "#/$defs/rank"
            },
            "relation_id": {
              "$ref": "#/$defs/relation_id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "flow_reorder_payload": {
      "type": "object",
      "required": [
        "board_id",
        "flow_id",
        "list_id",
        "rank"
      ],
      "properties": {
        "board_id": {
          "$ref": "#/$defs/board_id"
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "list_id": {
          "$ref": "#/$defs/list_id"
        },
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "expected_position": {
          "type": "object",
          "properties": {
            "rank": {
              "$ref": "#/$defs/rank"
            },
            "relation_id": {
              "$ref": "#/$defs/relation_id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "flow_branch_enable_payload": {
      "type": "object",
      "required": [
        "flow_id",
        "branch"
      ],
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "branch": {
          "$ref": "#/$defs/branch_name"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "flow_branch_disable_payload": {
      "type": "object",
      "required": [
        "flow_id",
        "branch"
      ],
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "branch": {
          "$ref": "#/$defs/branch_name"
        },
        "reason": {
          "type": "string"
        },
        "effective_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "flow_branch_set_primary_payload": {
      "type": "object",
      "required": [
        "flow_id",
        "branch"
      ],
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "branch": {
          "$ref": "#/$defs/branch_name"
        }
      },
      "additionalProperties": false
    },
    "flow_convert_payload": {
      "type": "object",
      "required": [
        "flow_id",
        "branch"
      ],
      "properties": {
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "branch": {
          "$ref": "#/$defs/branch_name"
        },
        "ensure_branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch_name"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
