              "cx.space.child",
              "cx.space.parent",
              "cx.space.inheritance_policy",
              "cx.space.join_rule",
              "cx.space.history_visibility",
              "cx.space.discovery",
              "cx.space.policy",
              "cx.space.policy_server",
              "cx.space.policy_components",
              "cx.space.schema",
              "cx.space.history_sharing_policy",
              "cx.space.asset_privacy_policy",
              "cx.space.moderation_policy",
              "cx.space.media_service",
              "cx.space.tombstone",
              "cx.space.archive",
              "cx.space.freeze",
              "cx.space.destroy",
              "cx.organization.discovery",
              "cx.organization.moderation_policy",
              "cx.did.proof",
              "cx.identity.disclosure_policy",
              "cx.identity.disclosure_receipt",
              "cx.identity.presentation_request",
              "cx.identity.presentation_response",
              "cx.schema.define",
              "cx.schema.update",
              "cx.policy.set",
              "cx.policy.rule",
              "cx.policy.action",
              "cx.account.status",
              "cx.flow.branch.history_visibility",
              "cx.flow.branch.policy_components",
              "cx.sovereign.did_policy"
            ]
          }
        },
