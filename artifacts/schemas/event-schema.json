        "properties": {
          "payload": {
            "$ref": "./event-payload.schema.json#/$defs/space_tombstone_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cx.space.destroy"
          }
