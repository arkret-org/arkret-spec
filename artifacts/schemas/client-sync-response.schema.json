{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/client-sync-response.schema.json",
  "title": "Contrix Client Sync Response",
  "type": "object",
  "required": [
    "next_batch"
  ],
  "properties": {
    "next_batch": {
      "$ref": "#/$defs/cursor_value"
    },
    "spaces": {
      "type": "object",
      "properties": {
        "join": {
          "$ref": "#/$defs/space_bucket"
        },
        "invite": {
          "$ref": "#/$defs/space_bucket"
        },
        "knock": {
          "$ref": "#/$defs/space_bucket"
        },
        "leave": {
          "$ref": "#/$defs/space_bucket"
        }
      },
      "additionalProperties": false
    },
    "to_device": {
      "$ref": "#/$defs/event_container"
    },
    "device_lists": {
      "type": "object"
    },
    "account_data": {
      "$ref": "#/$defs/event_container"
    },
    "presence": {
      "$ref": "#/$defs/event_container"
    },
    "notifications": {
      "$ref": "#/$defs/event_container"
    },
    "partial": {
      "type": "boolean"
    },
    "priority": {
      "type": "string"
    }
  },
  "$defs": {
    "cursor_value": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cx:cursor:.+$"
        },
        {
          "$ref": "./cursor.schema.json"
        }
      ]
    },
    "event_container": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "type": "object",
      "required": [
        "events",
        "limited"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "./event-envelope.schema.json"
          }
        },
        "limited": {
          "type": "boolean"
        },
        "prev_batch": {
          "$ref": "#/$defs/cursor_value"
        }
      },
      "additionalProperties": true
    },
    "space_entry": {
      "type": "object",
      "properties": {
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "state": {
          "$ref": "#/$defs/event_container"
        },
        "state_after": {
          "$ref": "#/$defs/event_container"
        },
        "ephemeral": {
          "$ref": "#/$defs/event_container"
        },
        "account_data": {
          "$ref": "#/$defs/event_container"
        },
        "summary": {
          "type": "object"
        },
        "unread_notifications": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "space_bucket": {
      "type": "object",
      "patternProperties": {
        "^cx:space:[0-9a-hjkmnp-z]{26}$": {
          "$ref": "#/$defs/space_entry"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
