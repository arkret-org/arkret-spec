{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/client-sync-response.schema.json",
  "title": "Contrix Client Sync Response",
  "type": "object",
  "required": ["next_batch"],
  "properties": {
    "next_batch": {
      "oneOf": [
        { "type": "string", "pattern": "^cx:cursor:.+$" },
        { "$ref": "./cursor.schema.json" }
      ]
    },
    "spaces": {
      "type": "object",
      "patternProperties": {
        "^cx:space:[0-9a-hjkmnp-z]{26}$": {
          "type": "object",
          "properties": {
            "timeline": {
              "type": "object",
              "required": ["events", "limited"],
              "properties": {
                "events": { "type": "array", "items": { "$ref": "./event-envelope.schema.json" } },
                "limited": { "type": "boolean" },
                "prev_batch": {
                  "oneOf": [
                    { "type": "string", "pattern": "^cx:cursor:.+$" },
                    { "$ref": "./cursor.schema.json" }
                  ]
                }
              },
              "additionalProperties": true
            },
            "state": { "type": "array", "items": { "$ref": "./event-envelope.schema.json" } },
            "summary": { "type": "object" },
            "ephemeral": { "type": "array", "items": { "type": "object" } },
            "unread": { "type": "object" },
            "state_after": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "to_device": { "type": "array", "items": { "type": "object" } },
    "device_lists": { "type": "object" },
    "account_data": { "type": "array", "items": { "type": "object" } },
    "presence": { "type": "array", "items": { "type": "object" } },
    "partial": { "type": "boolean" }
  },
  "additionalProperties": true
}
