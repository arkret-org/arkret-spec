{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/read-receipt.schema.json",
  "title": "Contrix Read Receipt",
  "type": "object",
  "required": ["type", "receipt_type", "space_id", "reader", "event_id", "created_at"],
  "properties": {
    "type": { "const": "receipt" },
    "receipt_type": { "const": "read" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "reader": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "event_id": { "type": "string", "pattern": "^cx:(evt|event):[0-9a-hjkmnp-z]{26}$" },
    "scope": { "type": "string", "enum": ["space", "channel", "topic", "thread"] },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": true
}
