{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/capability-grant.schema.json",
  "title": "Contrix Capability Grant",
  "type": "object",
  "required": [
    "id",
    "issuer",
    "subject",
    "actions",
    "resources",
    "proofs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:grant:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.capability.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requires_claims"
          ],
          "properties": {
            "kind": {
              "const": "condition"
            },
            "requires_claims": {
              "$ref": "./grant-constraint.schema.json#/properties/requires_claims"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
        "description": "Canonical action vocabulary. MUST be of the form cx.<segment>.<segment>... matching capabilities.md §5. Bare names without the cx. prefix are not permitted; consult capabilities.md before introducing new action names. Wildcards within a segment are not permitted in this schema; the resource selector controls scope, not action expansion."
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "./resource-selector.schema.json"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "./grant-constraint.schema.json"
      }
    },
    "delegable": {
      "type": "boolean",
      "default": false
    },
    "parent_grant_id": {
      "type": "string",
      "pattern": "^cx:grant:[0-9a-hjkmnp-z]{26}$"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "revoked_by": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
