{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/actor-profile.schema.json",
  "title": "Contrix Actor Profile",
  "type": "object",
  "required": ["id", "type", "principal_id", "actor_type", "display_name", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^cx:actor_profile:[0-9a-hjkmnp-z]{26}$" },
    "type": { "const": "actor_profile" },
    "schema": { "const": "cx.schema.actor_profile.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "principal_id": { "$ref": "#/$defs/did" },
    "actor_type": {
      "type": "string",
      "enum": ["user", "org", "team", "agent", "service", "device", "integration"]
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "handle": { "type": "string" },
    "avatar_blob_ref": { "type": "string", "pattern": "^cx:blob:[0-9a-hjkmnp-z]{26}$" },
    "status": { "type": "string", "enum": ["active", "suspended", "deactivated", "deleted"] },
    "accountable_to": { "type": "array", "items": { "$ref": "#/$defs/did" } },
    "profile_fields": { "type": "object" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": true
}
