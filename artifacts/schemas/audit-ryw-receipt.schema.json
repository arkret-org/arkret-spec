{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/audit-ryw-receipt.schema.json",
  "title": "Contrix Audit RYW Receipt",
  "description": "Read-Your-Writes receipt issued by an Events API node, witness, or peer Principal Server confirming that a cx.audit.accessed envelope has reached accepted state. Required by cx.profile.attested_audit.e2ee.v1 and cx.profile.disclosed_audit.e2ee.v1 before the Audit Agent is allowed to release plaintext (see zh/crypto-media/encryption-and-audit.md §3.3.1). The audit_assurance_class field MUST match the Space-declared audit_assurance value; mismatch fail closed.",
  "type": "object",
  "required": [
    "receipt_id",
    "schema",
    "issuer",
    "issuer_role",
    "audit_event_id",
    "audit_event_digest",
    "space_id",
    "audit_actor_id",
    "frontier",
    "observed_at",
    "receipt_independence",
    "audit_assurance_class",
    "proofs"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^cx:receipt:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.audit_ryw_receipt.v1"
    },
    "issuer": {
      "$ref": "#/$defs/did"
    },
    "issuer_role": {
      "type": "string",
      "enum": [
        "events_api",
        "witness",
        "peer_node"
      ]
    },
    "audit_event_id": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
    },
    "audit_event_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "audit_actor_id": {
      "$ref": "#/$defs/did"
    },
    "frontier": {
      "type": "object",
      "required": [
        "space_frontier"
      ],
      "properties": {
        "space_frontier": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
          },
          "minItems": 1
        },
        "actor_frontier": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "actor_seq",
              "event_id"
            ],
            "properties": {
              "actor_seq": {
                "type": "integer",
                "minimum": 0
              },
              "event_id": {
                "type": "string",
                "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "receipt_independence": {
      "type": "string",
      "enum": [
        "independent",
        "single_source"
      ]
    },
    "audit_assurance_class": {
      "type": "string",
      "enum": [
        "attested_hardware",
        "disclosed_policy"
      ],
      "description": "Audit assurance class propagated from the Space audit_assurance policy field. attested_hardware = cx.profile.attested_audit.e2ee.v1 (TEE/HSM/enclave attestation required). disclosed_policy = cx.profile.disclosed_audit.e2ee.v1 (process-only disclosure, NOT cryptographically enforced). Audit Agents MUST propagate the Space-declared value verbatim; receivers MUST fail closed when this field disagrees with the Space audit_assurance at the receipt's frontier."
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "./event-schema.json#/$defs/proof"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
