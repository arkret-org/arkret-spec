{
  "version": "2026-05-02",
  "source_of_truth": true,
  "kind_pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
  "wire_scope_definitions": {
    "durable_event": "Valid Event Envelope kind for persisted canonical history and reducer input.",
    "actor_private_event": "Persisted actor-private/account-data event; not shared Space history and not Space reducer input.",
    "ephemeral_event": "Transient sync/federation/app signal; MUST NOT be persisted as durable Event Envelope history.",
    "deprecated_alias": "Historical standard spelling accepted only for migration/read compatibility; producers MUST emit replaced_by."
  },
  "registry_rules": [
    "Standard cx.* Event.kind values MUST appear in this registry.",
    "Events API, Sync durable history, Federation, and canonical reducers MUST accept only active entries with wire_scope=durable_event unless an implementation profile explicitly defines a private channel for actor_private_event.",
    "Entries with wire_scope=ephemeral_event MUST be carried only on ephemeral channels and MUST NOT advance actor_seq, prev_refs, state_hash, or reducer frontier.",
    "Entries with wire_scope=actor_private_event MAY be persisted in encrypted account data or an actor-private stream, but MUST NOT be inserted into a shared Space Event history.",
    "Entries with wire_scope=deprecated_alias MUST NOT be emitted by conforming producers; consumers MAY map them to replaced_by during migration."
  ],
  "payload_schema_contract": {
    "event_envelope_schema": "schemas/event-envelope.schema.json",
    "payload_schema_file": "schemas/event-payload.schema.json",
    "coverage_required": true,
    "validation_rule": "Every active standard cx.* event kind MUST be validated by the Event Envelope schema and one payload class selected by kind. Unknown standard kind, unmatched active kind, or payload class failure is schema_violation before reducer execution.",
    "non_critical_extension_rule": "Unknown non-critical payload fields are preserved in canonical bytes and MAY be ignored by reducers. Unknown critical payload semantics MUST be declared in Event.critical_extensions and fail closed when unsupported."
  },
