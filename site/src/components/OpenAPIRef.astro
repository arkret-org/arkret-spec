---
import { readOpenApiYaml } from "~/lib/artifacts";

interface Props {
  /** Initial layout. `modern` = three-column; `classic` = single column. */
  layout?: "modern" | "classic";
  /** Hide the "client snippets" panel for read-only viewing. */
  hideClientButton?: boolean;
}

const { layout = "modern", hideClientButton = false } = Astro.props;

// Inline the OpenAPI YAML at build time so there is no runtime fetch and
// so the page works on any host (including offline GitHub Pages mirrors).
const yaml = readOpenApiYaml();

// We mount Scalar programmatically via `Scalar.createApiReference(el, config)`
// instead of the declarative `<script id="api-reference">` auto-mount.
//
// Why: the current Scalar standalone bundle treats the body of a
// `#api-reference` script as the *raw OpenAPI document itself*, not as a
// configuration object. Passing `{ spec: { content } }` or `{ content }` as
// the body therefore parses that wrapper JSON as the spec — it has no
// `paths`, so Scalar renders only an empty "Introduction" skeleton with no
// operations. The programmatic API takes the spec via the `content` config
// key explicitly, which is unambiguous.
//
// The spec is stashed in a `type="application/json"` island (a non-triggering
// id, so the bundle does NOT try to auto-mount it) and read back at init.
const baseConfig = {
  layout,
  hideClientButton,
  hideDownloadButton: false,
  theme: "default",
};
---

<div id="scalar-mount"></div>
<script
  is:inline
  id="openapi-spec"
  type="application/json"
  set:html={JSON.stringify(yaml).replace(/<\/script/gi, "<\\/script")}
></script>
<script
  is:inline
  id="scalar-config"
  type="application/json"
  set:html={JSON.stringify(baseConfig).replace(/<\/script/gi, "<\\/script")}
></script>
<script
  is:inline
  type="module"
  src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
<script is:inline>
  (function () {
    function currentTheme() {
      var stored;
      try {
        stored = localStorage.getItem("starlight-theme");
      } catch (e) {
        stored = null;
      }
      if (stored === "dark" || stored === "light") return stored;
      var attr = document.documentElement.dataset.theme;
      if (attr === "dark" || attr === "light") return attr;
      return window.matchMedia("(prefers-color-scheme: light)").matches
        ? "light"
        : "dark";
    }
    function readJson(id) {
      var el = document.getElementById(id);
      try {
        return JSON.parse((el && el.textContent) || "null");
      } catch (e) {
        return null;
      }
    }
    function mount() {
      // The bundle is a deferred module; poll until it exposes the global.
      if (!window.Scalar || typeof window.Scalar.createApiReference !== "function") {
        return window.setTimeout(mount, 30);
      }
      var content = readJson("openapi-spec");
      var config = readJson("scalar-config") || {};
      if (typeof content !== "string") return;
      config.content = content;
      config.darkMode = currentTheme() === "dark";
      window.Scalar.createApiReference("#scalar-mount", config);
    }
    mount();

    // Follow the site-wide dark/light toggle. Scalar reads `darkMode` once at
    // boot, so the simplest correct behaviour is to reload on theme change.
    window.addEventListener("storage", function (e) {
      if (e.key === "starlight-theme") location.reload();
    });
  })();
</script>

<style>
  /* Give Scalar room to lay out its three-column shell. */
  :root {
    --scalar-radius: 0.5rem;
  }
</style>
