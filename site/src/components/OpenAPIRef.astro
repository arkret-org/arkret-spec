---
import { readOpenApiYaml } from "~/lib/artifacts";
import { specFileUrl } from "~/lib/site-meta";
interface Props { layout?: "modern" | "classic"; hideClientButton?: boolean; }
const { layout = "modern", hideClientButton = false } = Astro.props;
const yaml = readOpenApiYaml();
const config = { layout, hideClientButton, hideDownloadButton:false, hideDarkModeToggle:true, theme:"default", persistAuth:false, telemetry:false, agent:{disabled:true} };
---
<section class="ak-openapi-reference">
  <div class="ak-openapi-fallback">
    <a id="openapi-download" href={specFileUrl("artifacts/openapi/arkret-service-api.openapi.yaml")} download="arkret-service-api.openapi.yaml">下载完整 OpenAPI YAML</a>
    <a href={specFileUrl("artifacts/openapi/arkret-service-api.openapi.yaml")}>查看 canonical 原件</a>
    <button id="openapi-retry" type="button" hidden>重试交互式预览</button>
    <p id="openapi-load-status" role="status">正在加载交互式预览；规范文件可独立下载。</p>
  </div>
  <div id="scalar-mount" aria-busy="true"></div>
</section>
<script is:inline id="openapi-spec" type="application/json" set:html={JSON.stringify(yaml).replace(/</g,"\\u003c")}></script>
<script is:inline id="scalar-config" type="application/json" set:html={JSON.stringify(config)}></script>
<script is:inline>
(function () {
  const mount = document.getElementById('scalar-mount');
  const status = document.getElementById('openapi-load-status');
  const retry = document.getElementById('openapi-retry');
  const download = document.getElementById('openapi-download');
  const content = JSON.parse(document.getElementById('openapi-spec').textContent);
  const config = JSON.parse(document.getElementById('scalar-config').textContent);
  const blob = URL.createObjectURL(new Blob([content],{type:'application/yaml;charset=utf-8'}));
  download.href = blob;
  let instance, generation = 0, timer;
  const theme = () => document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  function feedback(message,error) {
    status.textContent = message; status.setAttribute('role',error ? 'alert' : 'status');
    retry.hidden = !error; mount.setAttribute('aria-busy',error ? 'false' : 'true');
  }
  async function load() {
    const serial = ++generation; clearTimeout(timer);
    if (instance) { instance.destroy(); instance = null; }
    mount.replaceChildren();
    feedback('正在加载交互式预览；完整 YAML 已可下载。',false);
    function fail() {
      if (serial !== generation) return;
      generation++; clearTimeout(timer);
      if (instance) { instance.destroy(); instance = null; }
      feedback('交互式资源暂不可用。规范仍在本页，可下载完整 YAML 或重试预览。',true);
    }
    timer = setTimeout(fail,30000);
    try {
      // ESM and updateConfiguration follow Scalar's documented browser API.
      const url = new URL('https://cdn.jsdelivr.net/npm/@scalar/api-reference/esm.js');
      if (serial > 1) url.searchParams.set('retry',String(serial));
      const module = await import(url.href);
      if (serial !== generation) return;
      instance = module.createApiReference(mount,{...config,content,darkMode:theme() === 'dark',forceDarkModeState:theme(),onLoaded:() => {
        if (serial !== generation) return;
        clearTimeout(timer); status.textContent='交互式预览已就绪。';status.setAttribute('role','status');mount.setAttribute('aria-busy','false');retry.hidden=true;
      }});
    } catch { fail(); }
  }
  retry.addEventListener('click',load);
  const observer = new MutationObserver(() => { if (instance) instance.updateConfiguration({...config,content,darkMode:theme() === 'dark',forceDarkModeState:theme()}); });
  observer.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
  function cleanup() { generation++;clearTimeout(timer);observer.disconnect();if(instance) instance.destroy();URL.revokeObjectURL(blob); }
  document.addEventListener('astro:before-swap',cleanup,{once:true});window.addEventListener('pagehide',cleanup,{once:true});
  load();
})();
</script>
<style>.ak-openapi-fallback { display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;padding:1rem;border:1px solid var(--sl-color-gray-5);border-radius:.5rem; }.ak-openapi-fallback p { flex:1 1 100%;margin:0;font-size:.9rem; }.ak-openapi-fallback button { font:inherit;padding:.4rem .6rem;cursor:pointer; }</style>
