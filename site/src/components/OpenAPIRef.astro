---
import { readOpenApiYaml } from "~/lib/artifacts";

interface Props {
  /** Initial layout. `modern` = three-column; `classic` = single column. */
  layout?: "modern" | "classic";
  /** Hide the "client snippets" panel for read-only viewing. */
  hideClientButton?: boolean;
}

const { layout = "modern", hideClientButton = false } = Astro.props;

// Inline the OpenAPI YAML at build time so there is no runtime fetch and
// so the page works on any host (including offline GitHub Pages mirrors).
const yaml = readOpenApiYaml();

// Scalar's stable declarative entry-point: <script id="api-reference"
// type="application/json" data-configuration='{"spec": {"content": "..."}}'>
// followed by the Scalar bundle. This contract has been stable across
// Scalar majors, so we are not coupled to a specific JS API surface.
//
// `darkMode` is set later by the inline script so that the Scalar UI
// follows the site-wide dark/light toggle (Starlight's `data-theme`)
// instead of being permanently locked.
const config = {
  spec: { content: yaml },
  layout,
  hideClientButton,
  hideDownloadButton: false,
  theme: "default",
};
---

<script
  is:inline
  id="api-reference"
  type="application/json"
  set:html={JSON.stringify(config).replace(/<\/script/gi, "<\\/script")}
></script>
<script
  is:inline
  type="module"
  src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
<script is:inline>
  // Sync Scalar's darkMode with the site theme. Scalar reads its
  // configuration once at boot, so we patch the JSON before the
  // bundle initializes, then keep it in sync via storage events.
  (function () {
    function currentTheme() {
      var stored;
      try {
        stored = localStorage.getItem("starlight-theme");
      } catch (e) {
        stored = null;
      }
      if (stored === "dark" || stored === "light") return stored;
      var attr = document.documentElement.dataset.theme;
      if (attr === "dark" || attr === "light") return attr;
      return window.matchMedia("(prefers-color-scheme: light)").matches
        ? "light"
        : "dark";
    }
    function patchConfig(dark) {
      var el = document.getElementById("api-reference");
      if (!el) return;
      try {
        var cfg = JSON.parse(el.textContent || "{}");
        cfg.darkMode = dark;
        el.textContent = JSON.stringify(cfg).replace(/<\/script/gi, "<\\/script");
      } catch (e) {
        /* ignore */
      }
    }
    patchConfig(currentTheme() === "dark");
    window.addEventListener("storage", function (e) {
      if (e.key === "starlight-theme") {
        // Reload so Scalar re-reads its config under the new theme.
        location.reload();
      }
    });
  })();
</script>

<style>
  /* Give Scalar room to lay out its three-column shell. */
  :root {
    --scalar-radius: 0.5rem;
  }
</style>
