---
/**
 * Shared top-level site navigation. Used by both the marketing layout
 * (homepage, future ecosystem/blog) and the Starlight docs Header
 * override so the brand + section links stay consistent everywhere.
 *
 * The right-side slot lets each layout drop in its own tools — the
 * marketing layout supplies a theme toggle + GitHub link, the docs
 * Header supplies Starlight's Search / ThemeSelect / LanguageSelect.
 */

export interface Props {
  /** Variant — `marketing` keeps standalone padding; `docs` aligns with Starlight's nav row height. */
  variant?: "marketing" | "docs";
}

const { variant = "marketing" } = Astro.props;

type NavItem =
  | { label: string; href: string; soon?: undefined }
  | { label: string; href?: undefined; soon: true };

const navItems: NavItem[] = [
  { label: "Docs", href: "/zh/v1/spec-map/" },
  { label: "OpenAPI", href: "/openapi/" },
  { label: "Ecosystem", href: "/ecosystem/" },
  { label: "Blog", soon: true },
];

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href);
}
---

<nav class={`ck-nav ck-nav--${variant}`} aria-label="Site">
  <div class="ck-shell ck-nav-row">
    <a href="/" class="ck-brand">
      <img
        class="ck-brand-mark"
        src="/brand/cokret-logo.svg"
        alt=""
        width="32"
        height="32"
        aria-hidden="true"
        decoding="async"
      />
      <span>Cokret</span>
    </a>
    <ul class="ck-nav-links">
      {
        navItems.map((item) =>
          item.href === undefined ? (
            <li>
              <span aria-disabled="true">
                {item.label}
                <span class="ck-soon">soon</span>
              </span>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
    <div class="ck-nav-tools">
      <slot name="tools" />
    </div>
  </div>
</nav>
