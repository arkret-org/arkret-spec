---
/**
 * Shared top-level site navigation. Used by both the marketing layout
 * (homepage, future ecosystem/blog) and the Starlight docs Header
 * override so the brand + section links stay consistent everywhere.
 *
 * The right-side slot lets each layout drop in its own tools — the
 * marketing layout supplies a theme toggle + GitHub link, the docs
 * Header supplies Starlight's Search / ThemeSelect / LanguageSelect.
 */

export interface Props {
  /** Variant — `marketing` keeps standalone padding; `docs` aligns with Starlight's nav row height. */
  variant?: "marketing" | "docs";
}

const { variant = "marketing" } = Astro.props;

const pathname = Astro.url.pathname;
const english = pathname.startsWith("/en/");
const navItems = [
  { label: english ? "Docs (Chinese)" : "规范", href: "/zh/guide/", section: "docs" },
  { label: english ? "Catalog" : "目录参考", href: "/zh/catalog/operations/", section: "catalog" },
  { label: "OpenAPI", href: "/zh/openapi/", section: "openapi" },
  { label: english ? "Implementations" : "参考实现", href: "/ecosystem/", section: "ecosystem" },
];
function isActive(section: string): boolean {
  if (section === "docs") return /^\/(zh|en)\/(v1|guide)(\/|$)/.test(pathname);
  if (section === "catalog") return pathname.includes("/catalog/");
  if (section === "openapi") return pathname.endsWith("/openapi/");
  return pathname.startsWith("/ecosystem/");
}

---

<nav class={`ak-nav ak-nav--${variant}`} aria-label={english ? "Site sections" : "网站分区"}>
  <div class="ak-shell ak-nav-row">
    <a href="/" class="ak-brand" aria-label={english ? "Arkret home" : "Arkret 首页"}>
      <span class="ak-brand-mark" aria-hidden="true">
        <img
          class="ak-brand-mark-image ak-brand-logo--light"
          src="/brand/arkret-logo.svg"
          alt=""
          width="32"
          height="32"
          decoding="async"
        />
        <img
          class="ak-brand-mark-image ak-brand-logo--dark"
          src="/brand/arkret-logo-dark.svg"
          alt=""
          width="32"
          height="32"
          decoding="async"
        />
      </span>
      <span>Arkret</span>
    </a>
    <ul class="ak-nav-links">
      {
        navItems.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.section) ? "true" : undefined}>{item.label}</a></li>
        ))
      }
    </ul>
    <details class="ak-section-menu">
      <summary>{english ? "Sections" : "网站分区"}</summary>
      <ul>{navItems.map(item => <li><a href={item.href} aria-current={isActive(item.section) ? "true" : undefined}>{item.label}</a></li>)}</ul>
    </details>
    <div class="ak-nav-tools">
      <slot name="tools" />
    </div>
  </div>
</nav>

<script>
function closeSectionMenus(event: KeyboardEvent | MouseEvent) {
  document.querySelectorAll<HTMLDetailsElement>('.ak-section-menu[open]').forEach(menu => {
    if (event instanceof KeyboardEvent && event.key === 'Escape') { menu.open=false;menu.querySelector('summary')?.focus(); }
    else if (event instanceof MouseEvent && !menu.contains(event.target as Node)) menu.open=false;
  });
}
document.addEventListener('keydown',closeSectionMenus);document.addEventListener('click',closeSectionMenus);
</script>
