---
import { errorCodes } from "~/lib/artifacts";

interface Props {
  /** Filter by scope: "service" | "item" | "both". */
  scope?: string;
  /** Filter by HTTP status. */
  status?: number;
}
const { scope, status } = Astro.props;
const rows = errorCodes.filter((row) => {
  if (scope && row.scope !== scope) return false;
  if (status && row.http_status !== status) return false;
  return true;
});
---

<table class="ak.table">
  <thead>
    <tr>
      <th>code</th>
      <th>kind</th>
      <th>HTTP</th>
      <th>scope / applies to</th>
      <th>description</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <td>
            <a href={`/catalog/errors/${encodeURIComponent(row.code)}/`}>
              <code>{row.code}</code>
            </a>
          </td>
          <td>{row.kind}</td>
          <td>{row.http_status ?? "—"}</td>
          <td>{row.scope ?? row.applies_to?.join(", ") ?? "—"}</td>
          <td>{row.description}</td>
        </tr>
      ))
    }
  </tbody>
</table>
