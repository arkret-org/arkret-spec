---
/**
 * Light / dark / auto theme toggle for the marketing layout.
 *
 * Uses the same `localStorage` key (`starlight-theme`) and the same
 * `data-theme` attribute on `<html>` as Starlight's ThemeSelect, so
 * preferences sync between marketing pages and Starlight docs without
 * extra wiring.
 */
---

<button
  class="cx-theme-toggle"
  type="button"
  aria-label="切换主题"
  data-theme-toggle
>
  <svg
    class="cx-theme-icon cx-theme-icon--sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="cx-theme-icon cx-theme-icon--moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const KEY = "starlight-theme";
    const root = document.documentElement;

    function resolve(stored) {
      if (stored === "dark" || stored === "light") return stored;
      return window.matchMedia("(prefers-color-scheme: light)").matches
        ? "light"
        : "dark";
    }

    function apply(theme) {
      root.dataset.theme = theme;
    }

    function next(current) {
      return current === "light" ? "dark" : "light";
    }

    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const stored =
          (typeof localStorage !== "undefined" && localStorage.getItem(KEY)) ||
          "auto";
        const current = resolve(stored);
        const target = next(current);
        try {
          localStorage.setItem(KEY, target);
        } catch (_) {
          /* ignore quota / privacy errors */
        }
        apply(target);
        // Notify Starlight pickers if present (they listen to storage events
        // for cross-tab sync, but on the same page the dropdown still shows
        // the previous value — easiest is to update its select directly).
        document
          .querySelectorAll("starlight-theme-select select")
          .forEach((sel) => {
            sel.value = target;
            sel.dispatchEvent(new Event("change", { bubbles: true }));
          });
      });
    });
  })();
</script>
