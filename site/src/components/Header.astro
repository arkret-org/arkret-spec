---
/**
 * Starlight Header override. Replaces Starlight's default header chrome
 * with the shared SiteNav, while keeping Starlight's tooling (search,
 * social icons, theme select, language select) on the right side. This
 * gives docs pages the same site-level navigation as the marketing
 * landing page without stacking two fixed-height nav bars.
 */
import type { Props } from "@astrojs/starlight/props";
import SiteNav from "./SiteNav.astro";
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

import "../styles/marketing.css";

// Starlight passes the route data as `Astro.props` to overridden header
// components. Forwarding it to the bundled Search/Theme/Lang/Social
// components requires the same type so each child sees its full route data.
const props = Astro.props as Props;

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<SiteNav variant="docs">
  <Fragment slot="tools">
    {shouldRenderSearch && <Search {...props} />}
    <div class="cx-docs-tools">
      <SocialIcons {...props} />
      <ThemeSelect {...props} />
      <LanguageSelect {...props} />
    </div>
  </Fragment>
</SiteNav>

<style is:global>
  /* Starlight wraps the header slot in `<header class="header">` with
   * fixed positioning + grid layout intended for its default 3-cell
   * structure. We're replacing that content with a single SiteNav row,
   * so neutralize the grid and let the nav span the full bar. */
  header.header {
    display: block !important;
  }

  /* Cancel Starlight's nav padding and span the full bar so the SiteNav's
   * brand can align with the left sidebar edge and the tools cluster can
   * align with the right page edge — not float in the middle (which is
   * what happens when the inner `.cx-shell` clamps to 1180px). */
  .cx-nav--docs {
    margin: calc(-1 * var(--sl-nav-pad-y)) calc(-1 * var(--sl-nav-pad-x));
    padding: 0;
    height: var(--sl-nav-height);
  }
  .cx-nav--docs .cx-nav-row {
    /* Override the marketing layout's centered max-width so the docs nav
     * fills the entire header bar above the sidebar + content + TOC grid. */
    max-width: none;
    width: 100%;
    height: 100%;
    /* Match Starlight's own nav padding so the brand left-aligns with the
     * sidebar's left edge and the tools cluster right-aligns with the
     * page padding. */
    padding-left: var(--sl-nav-pad-x);
    padding-right: var(--sl-nav-pad-x);
  }

  /* Make the brand cell occupy exactly one sidebar width on wide screens so
   * the boundary between brand and nav-links is the same vertical line as
   * the boundary between sidebar and main content. */
  @media (min-width: 50rem) {
    .cx-nav--docs .cx-brand {
      width: calc(
        var(--sl-sidebar-width) - var(--sl-nav-pad-x) - var(--sl-sidebar-pad-x)
      );
      flex-shrink: 0;
    }
  }

  /* On wide screens, ensure the right-side tools (search, theme, lang)
   * don't get squeezed by the nav-links list. */
  .cx-nav--docs .cx-nav-tools {
    gap: 0.75rem;
  }

  /* Search input from Starlight has its own styles; make sure it still
   * fits. */
  .cx-nav--docs .cx-nav-tools :global([data-open-modal]) {
    color: var(--cx-fg-muted);
  }

  .cx-docs-tools {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 50rem) {
    .cx-docs-tools {
      display: flex;
    }
  }

  .cx-docs-tools::before {
    content: "";
    width: 1px;
    height: 1.4rem;
    background: var(--cx-border);
  }
</style>
