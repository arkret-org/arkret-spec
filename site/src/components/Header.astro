---
/**
 * Starlight Header override. Replaces Starlight's default header chrome
 * with the shared SiteNav, while keeping Starlight's tooling (search,
 * social icons, theme select, language select) on the right side. This
 * gives docs pages the same site-level navigation as the marketing
 * landing page without stacking two fixed-height nav bars.
 */
import type { Props } from "@astrojs/starlight/props";
import SiteNav from "./SiteNav.astro";
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

import "../styles/marketing.css";

// Starlight passes the route data as `Astro.props` to overridden header
// components. Forwarding it to the bundled Search/Theme/Lang/Social
// components requires the same type so each child sees its full route data.
const props = Astro.props as Props;

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<SiteNav variant="docs">
  <Fragment slot="tools">
    {
      shouldRenderSearch && (
        <div class="cx-docs-search">
          <Search {...props} />
        </div>
      )
    }
    <div class="cx-docs-tools">
      <SocialIcons {...props} />
      <ThemeSelect {...props} />
      <LanguageSelect {...props} />
    </div>
  </Fragment>
</SiteNav>

<style is:global>
  /* Starlight wraps the header slot in `<header class="header">` with
   * fixed positioning + a 3-cell grid intended for its default chrome.
   * We're replacing the grid with a single SiteNav row, so neutralize
   * the grid and let the inner `.cx-shell` re-center to `--cx-max`,
   * matching the marketing layout. */
  header.header {
    display: block !important;
  }

  .cx-nav--docs {
    margin: calc(-1 * var(--sl-nav-pad-y)) calc(-1 * var(--sl-nav-pad-x));
    padding: 0;
    height: var(--sl-nav-height);
  }
  .cx-nav--docs .cx-nav-row {
    height: 100%;
  }

  /* On wide screens, ensure the right-side tools (search, theme, lang)
   * don't get squeezed by the nav-links list. */
  .cx-nav--docs .cx-nav-tools {
    gap: 0.75rem;
  }

  /* Widen Starlight's search trigger so it reads as a real search field,
   * not a tiny icon button. The trigger expands further on hover/focus
   * to reinforce the "field is interactive" cue.
   *
   * Specificity note: Starlight ships its own `site-search button` styles
   * with a base class. To win without `!important`, we double-up the
   * `.cx-docs-search` class on the wrapper selector and reach the button
   * through `site-search`, beating Starlight's component-scoped rules. */
  .cx-docs-search {
    display: flex;
    align-items: center;
  }

  .cx-docs-search.cx-docs-search site-search button[data-open-modal] {
    color: var(--cx-fg-muted);
    background: var(--cx-bg-elevated);
    border: 1px solid var(--cx-border);
    border-radius: 10px;
    padding: 0.42rem 0.7rem 0.42rem 0.85rem;
    min-width: 14rem;
    width: 18rem;
    max-width: 24rem;
    box-shadow: 0 1px 0 0 var(--cx-border) inset;
    transition:
      width 0.22s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .cx-docs-search.cx-docs-search site-search button[data-open-modal]:hover {
    color: var(--cx-fg);
    border-color: var(--cx-border-strong);
    background: var(--cx-bg-overlay-strong, var(--cx-bg-elevated));
  }

  .cx-docs-search.cx-docs-search site-search button[data-open-modal]:focus-visible {
    width: 22rem;
    color: var(--cx-fg);
    border-color: color-mix(in srgb, var(--cx-accent) 55%, transparent);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--cx-accent) 22%, transparent),
      0 1px 0 0 var(--cx-border) inset;
    outline: none;
  }

  .cx-docs-search.cx-docs-search site-search button[data-open-modal] kbd {
    background: var(--cx-bg);
    border: 1px solid var(--cx-border);
    color: var(--cx-fg-muted);
    border-radius: 5px;
    padding: 0.05rem 0.32rem;
    font-family: var(--cx-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 60rem) {
    .cx-docs-search.cx-docs-search site-search button[data-open-modal] {
      min-width: 0;
      width: auto;
    }
  }

  .cx-docs-tools {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 50rem) {
    .cx-docs-tools {
      display: flex;
    }
  }

  .cx-docs-tools::before {
    content: "";
    width: 1px;
    height: 1.4rem;
    background: var(--cx-border);
  }
</style>
