---
import { getOperation, getOperationSurface } from "~/lib/artifacts";

interface Props {
  id: string;
  inline?: boolean;
}
const { id, inline = false } = Astro.props;
const row = getOperation(id);
if (!row) {
  throw new Error(
    `<OperationRef id="${id}"> does not exist in operation-registry.json.`
  );
}
const surface = getOperationSurface(id);
const href = `/catalog/operations/${encodeURIComponent(id)}/`;
---

{
  inline ? (
    <a class="ak.tag" data-kind="operation" href={href}>
      <code>{id}</code>
    </a>
  ) : (
    <article class="ak.card">
      <header>
        <span class="ak.tag" data-kind="operation">op</span>
        <a class="ak.card-title" href={href}>
          <code>{id}</code>
        </a>
        {surface && (
          <>
            <span>· tier {surface.tier}</span>
            <span>· surface {surface.surface}</span>
          </>
        )}
      </header>
      <dl>
        <dt>HTTP</dt>
        <dd><code>{row.http}</code></dd>
        <dt>gRPC</dt>
        <dd><code>{row.grpc}</code></dd>
        <dt>MQ</dt>
        <dd><code>{row.mq}</code></dd>
        {row.bridges_to && (
          <>
            <dt>bridges to</dt>
            <dd>
              <a href={`/catalog/operations/${encodeURIComponent(row.bridges_to)}/`}>
                <code>{row.bridges_to}</code>
              </a>
            </dd>
          </>
        )}
      </dl>
    </article>
  )
}
