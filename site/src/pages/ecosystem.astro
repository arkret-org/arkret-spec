---
import MarketingLayout from "~/layouts/MarketingLayout.astro";

type Status = "stable" | "wip" | "planned";

interface Project {
  name: string;
  tag: string;
  status: Status;
  body: string;
  href?: string;
}

interface Tier {
  id: string;
  title: string;
  blurb: string;
  projects: Project[];
}

const statusLabel: Record<Status, string> = {
  stable: "stable",
  wip: "in development",
  planned: "planned",
};

const tiers: Tier[] = [
  {
    id: "protocol",
    title: "协议与 SDK",
    blurb:
      "把联邦、E2EE、协作对象与 Agent 权限边界变成可互操作的协议，再由 SDK 提供实现这些能力所需的数据结构和算法。",
    projects: [
      {
        name: "arkret-spec",
        tag: "protocol · this site",
        status: "stable",
        body:
          "协议规范本体。定义自托管联邦、MLS 加密边界、人与 Agent 的协作模型，以及语言中立的 registry / schema / profile / OpenAPI。本站点直接由规范和机读构件派生。",
        href: "/zh/v1/spec-map/",
      },
      {
        name: "arkret-rust-sdk",
        tag: "sdk · rust",
        status: "wip",
        body:
          "协议基础 SDK。提供 MLS 与 scope 绑定、联邦 envelope 校验、canonical JSON、HLC、schema 验证和 capability constraint 求值等可复用能力。",
      },
    ],
  },
  {
    id: "principal",
    title: "Station 部署栈",
    blurb:
      "个人或组织自托管的服务端组件：连接其它参与方的 Station，保存本方副本并转发 E2EE 内容，同时接入企业身份、运维与推送系统。",
    projects: [
      {
        name: "soland",
        tag: "server · principal",
        status: "wip",
        body:
          "Station 参考实现。负责 Realm 状态、加密事件接入与 reducer、授权求值、历史补齐，以及与其他 Station 的联邦同步。",
      },
      {
        name: "coauth",
        tag: "server · auth-bridge",
        status: "wip",
        body:
          "组织部署 Station 时的内部账号桥。把企业 OIDC / SSO 与 Arkret DID 绑定，统一管理账号、密钥轮换、内部权限策略。",
      },
      {
        name: "sodmin",
        tag: "ops · admin-ui",
        status: "wip",
        body:
          "服务器管理员控制台。基于 soland + coauth 的接口，提供空间审计、capability 管理、用户绑定与 federation 健康监控。",
      },
      {
        name: "floria",
        tag: "server · push-gateway",
        status: "wip",
        body:
          "Arkret push gateway 的实现。把客户端订阅的事件流分发到 APNs / FCM / WebPush，并保留 audited E2EE 所要求的最小元数据约束。",
      },
    ],
  },
  {
    id: "client",
    title: "客户端栈",
    blurb:
      "在用户端完成解密、验证与投影，把同一协作对象图呈现为消息、任务、文档或 Agent 工作区；服务端不需要掌握产品体验。",
    projects: [
      {
        name: "inkson",
        tag: "client · cross-platform",
        status: "wip",
        body:
          "跨平台参考客户端。在 macOS / Windows / Linux / iOS / Android 上提供同一套联邦、E2EE 和人与 Agent 协作体验。",
      },
      {
        name: "chime",
        tag: "sdk · client-push",
        status: "wip",
        body:
          "客户端使用的 push SDK。负责与 floria 建立长连接、解码通知 envelope、调度本地系统通知。inkson 等客户端通过它接收推送。",
      },
    ],
  },
  {
    id: "identity",
    title: "可选身份与信任服务",
    blurb:
      "v1 的长期 principal 与默认 service DID method 固定为 did:webvh（did.jsonl 历史链 + SCID + witness）。无域名用户的 did.jsonl 默认由自己的 Account Authority 在子域托管；下面这些组件在需要公共托管、独立 witness / mirror 或跨服务商迁移时启用。",
    projects: [
      {
        name: "starid",
        tag: "identity · did:webvh",
        status: "planned",
        body:
          "可选的公共 did:webvh 托管与 high-trust 服务实现。提供 did.jsonl 托管、witness / mirror、handle 绑定与密钥轮换审计。自建 Account Authority 已能承担 did.jsonl 托管，因此 v1 core 不强依赖它。",
      },
    ],
  },
  {
    id: "conformance",
    title: "一致性与测试",
    blurb:
      "把联邦同步、状态收敛、权限边界、Agent 行为与 E2EE 合规性变成可执行用例，让不同实现仍能安全互通。",
    projects: [
      {
        name: "cotest",
        tag: "conformance · test-suite",
        status: "wip",
        body:
          "协议级一致性测试套件。模拟单服务器 / 多服务器场景，对 reducer、federation、authz 求值、E2EE profile 做端到端验证；定位类似 Matrix 的 Complement。",
      },
    ],
  },
];
---

<MarketingLayout
  title="Arkret 生态 · Ecosystem"
  description="从自托管 Station、MLS 端到端加密到人与 Agent 的跨平台协作体验，浏览 Arkret 的完整开源参考栈。"
>
  <section class="ak-hero">
    <div class="ak-shell ak-hero-inner">
      <span class="ak-section-tag">OPEN REFERENCE STACK</span>
      <h1>
        从协议到客户端，<br />
        <span class="ak-h1-accent">把去中心化协作真正跑起来</span>
      </h1>
      <p class="ak-lead">
        Arkret 不只描述消息格式。参考实现覆盖自托管 Station、跨组织联邦、MLS 端到端加密、
        企业身份接入、跨平台客户端与一致性测试，让团队可以从可执行组件开始构建人与 Agent 的协作产品。
      </p>
    </div>
  </section>

  {
    tiers.map((tier) => (
      <section class="ak-section" id={tier.id}>
        <div class="ak-shell">
          <div class="ak-section-head">
            <h2>{tier.title}</h2>
            <p>{tier.blurb}</p>
          </div>
          <div class="ak-eco-grid">
            {tier.projects.map((p) =>
              p.href ? (
                <a class="ak-eco-card ak-eco-card--link" href={p.href}>
                  <header class="ak-eco-card-head">
                    <span class="ak-eco-name">{p.name}</span>
                    <span
                      class={`ak-eco-status ak-eco-status--${p.status}`}
                      title={statusLabel[p.status]}
                    >
                      <span class="ak-eco-status-dot" aria-hidden="true" />
                      {statusLabel[p.status]}
                    </span>
                  </header>
                  <div class="ak-eco-tag">{p.tag}</div>
                  <p class="ak-eco-body">{p.body}</p>
                  <span class="ak-eco-more" aria-hidden="true">
                    浏览 →
                  </span>
                </a>
              ) : (
                <article class="ak-eco-card">
                  <header class="ak-eco-card-head">
                    <span class="ak-eco-name">{p.name}</span>
                    <span
                      class={`ak-eco-status ak-eco-status--${p.status}`}
                      title={statusLabel[p.status]}
                    >
                      <span class="ak-eco-status-dot" aria-hidden="true" />
                      {statusLabel[p.status]}
                    </span>
                  </header>
                  <div class="ak-eco-tag">{p.tag}</div>
                  <p class="ak-eco-body">{p.body}</p>
                </article>
              ),
            )}
          </div>
        </div>
      </section>
    ))
  }

</MarketingLayout>
