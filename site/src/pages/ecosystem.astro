---
import MarketingLayout from "~/layouts/MarketingLayout.astro";

type Status = "stable" | "wip" | "planned";

interface Project {
  name: string;
  tag: string;
  status: Status;
  body: string;
  href?: string;
}

interface Tier {
  id: string;
  title: string;
  blurb: string;
  projects: Project[];
}

const statusLabel: Record<Status, string> = {
  stable: "stable",
  wip: "in development",
  planned: "planned",
};

const tiers: Tier[] = [
  {
    id: "protocol",
    title: "协议与 SDK",
    blurb:
      "互操作的 wire 与对象语义在 arkret-spec 收敛；rust-sdk 把它转成可复用的数据结构与算法，供其他实现直接依赖。",
    projects: [
      {
        name: "arkret-spec",
        tag: "protocol · this site",
        status: "stable",
        body:
          "协议规范本体。spec/v1/zh 下的中文是唯一 normative 文本，spec/v1/artifacts/ 是语言中立的 registry / schema / profile / OpenAPI。本站点直接由 spec 与 artifact 派生。",
        href: "/zh/v1/spec-map/",
      },
      {
        name: "arkret-rust-sdk",
        tag: "sdk · rust",
        status: "wip",
        body:
          "协议基础 SDK。提供 envelope 签名 / 校验、canonical JSON、HLC 时钟、schema 验证、capability constraint 求值等核心数据结构与工具，多数 Rust 端服务都基于它构建。",
      },
    ],
  },
  {
    id: "principal",
    title: "Principal Server 部署栈",
    blurb:
      "组织 / 个人自托管时使用的服务端组件：状态机本体、与企业身份系统的桥接、运维管理面、推送出口。",
    projects: [
      {
        name: "soland",
        tag: "server · principal",
        status: "wip",
        body:
          "Principal server 的参考实现。负责 actor / org / space 状态、event ingestion 与 reducer、authz 求值，以及与其他 principal server 的 federation。",
      },
      {
        name: "coauth",
        tag: "server · auth-bridge",
        status: "wip",
        body:
          "组织部署 principal server 时的内部账号桥。把企业 OIDC / SSO 与 Arkret DID 绑定，统一管理账号、密钥轮换、内部权限策略。",
      },
      {
        name: "sodmin",
        tag: "ops · admin-ui",
        status: "wip",
        body:
          "服务器管理员控制台。基于 soland + coauth 的接口，提供空间审计、capability 管理、用户绑定与 federation 健康监控。",
      },
      {
        name: "floria",
        tag: "server · push-gateway",
        status: "wip",
        body:
          "Arkret push gateway 的实现。把客户端订阅的事件流分发到 APNs / FCM / WebPush，并保留 audited E2EE 所要求的最小元数据约束。",
      },
    ],
  },
  {
    id: "client",
    title: "客户端栈",
    blurb:
      "终端用户体验：跨平台 GUI 客户端，加上配套的推送接收 SDK。客户端只投影协议对象图，不持有协议状态。",
    projects: [
      {
        name: "inkson",
        tag: "client · cross-platform",
        status: "wip",
        body:
          "跨平台参考客户端。同一份 Arkret 协议核心，运行在 macOS / Windows / Linux / iOS / Android。",
      },
      {
        name: "chime",
        tag: "sdk · client-push",
        status: "wip",
        body:
          "客户端使用的 push SDK。负责与 floria 建立长连接、解码通知 envelope、调度本地系统通知。inkson 等客户端通过它接收推送。",
      },
    ],
  },
  {
    id: "identity",
    title: "可选身份与信任服务",
    blurb:
      "v1 的长期 principal 与默认 service DID method 固定为 did:webvh（did.jsonl 历史链 + SCID + witness）。无域名用户的 did.jsonl 默认由自己的 Account Authority 在子域托管；下面这些组件在需要公共托管、独立 witness / mirror 或跨服务商迁移时启用。",
    projects: [
      {
        name: "starid",
        tag: "identity · did:webvh",
        status: "planned",
        body:
          "可选的公共 did:webvh 托管与 high-trust 服务实现。提供 did.jsonl 托管、witness / mirror、handle 绑定与密钥轮换审计。自建 Account Authority 已能承担 did.jsonl 托管，因此 v1 core 不强依赖它。",
      },
    ],
  },
  {
    id: "conformance",
    title: "一致性与测试",
    blurb:
      "把 wire / state / authz / E2EE 的合规性变成可执行用例，让多实现并行开发时仍能保证互操作。",
    projects: [
      {
        name: "cotest",
        tag: "conformance · test-suite",
        status: "wip",
        body:
          "协议级一致性测试套件。模拟单服务器 / 多服务器场景，对 reducer、federation、authz 求值、E2EE profile 做端到端验证；定位类似 Matrix 的 Complement。",
      },
    ],
  },
];
---

<MarketingLayout
  title="Arkret 生态 · Ecosystem"
  description="Arkret 协议生态：spec、SDK、principal server、客户端、push gateway、conformance 测试套件等参考实现的总览。"
>
  {
    tiers.map((tier) => (
      <section class="ak-section" id={tier.id}>
        <div class="ak-shell">
          <div class="ak-section-head">
            <h2>{tier.title}</h2>
            <p>{tier.blurb}</p>
          </div>
          <div class="ak-eco-grid">
            {tier.projects.map((p) =>
              p.href ? (
                <a class="ak-eco-card ak-eco-card--link" href={p.href}>
                  <header class="ak-eco-card-head">
                    <span class="ak-eco-name">{p.name}</span>
                    <span
                      class={`ak-eco-status ak-eco-status--${p.status}`}
                      title={statusLabel[p.status]}
                    >
                      <span class="ak-eco-status-dot" aria-hidden="true" />
                      {statusLabel[p.status]}
                    </span>
                  </header>
                  <div class="ak-eco-tag">{p.tag}</div>
                  <p class="ak-eco-body">{p.body}</p>
                  <span class="ak-eco-more" aria-hidden="true">
                    浏览 →
                  </span>
                </a>
              ) : (
                <article class="ak-eco-card">
                  <header class="ak-eco-card-head">
                    <span class="ak-eco-name">{p.name}</span>
                    <span
                      class={`ak-eco-status ak-eco-status--${p.status}`}
                      title={statusLabel[p.status]}
                    >
                      <span class="ak-eco-status-dot" aria-hidden="true" />
                      {statusLabel[p.status]}
                    </span>
                  </header>
                  <div class="ak-eco-tag">{p.tag}</div>
                  <p class="ak-eco-body">{p.body}</p>
                </article>
              ),
            )}
          </div>
        </div>
      </section>
    ))
  }

</MarketingLayout>

<style is:global>
  /* The first tier section now sits directly under the site nav. Drop the
   * `.ak-section` border-top on it (otherwise we get a thin line right under
   * the nav's own border) and trim its top padding to a comfortable lead-in.
   * `is:global` because the `main` element lives in MarketingLayout, outside
   * this component's scope. */
  body.ak-marketing main > section.ak-section:first-of-type {
    border-top: none;
    padding-top: 3rem;
  }
</style>
