---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ErrorCode from "~/components/ErrorCode.astro";
import CatalogBreadcrumb from "~/components/CatalogBreadcrumb.astro";
import CatalogSource from "~/components/CatalogSource.astro";
import { errorCodes } from "~/lib/artifacts";

export function getStaticPaths() {
  return errorCodes.map((row) => ({ params: { code: row.code } }));
}

const { code } = Astro.params as { code: string };
---

<StarlightPage frontmatter={{ title: code }}>
  <CatalogBreadcrumb label="Error codes" href="/catalog/errors/" />
  <ErrorCode code={code} />
  <CatalogSource
    entries={[
      {
        label: "canonical row",
        path: "artifacts/registry/error-code-registry.json",
        pointer: "#codes",
      },
    ]}
  />
</StarlightPage>
