---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import OperationTable from "~/components/OperationTable.astro";
import { catalogVersion, surfaceGroups } from "~/lib/artifacts";
---

<StarlightPage frontmatter={{ title: "Operations" }}>
  <p>
    canonical: <code>spec/v1/artifacts/registry/contract-catalog.json#operation_registry</code>
    · catalog version <code>{catalogVersion}</code>
    · interactive HTTP shape: <a href="/openapi/">/openapi/</a>
  </p>

  <nav class="cx-surface-jump" aria-label="Surface groups">
    <strong>Jump to surface:</strong>
    <ul>
      {
        surfaceGroups.map((group) => (
          <li>
            <a href={`#surface-${group.surface}`} data-tier={group.tier}>
              <code>{group.surface}</code>
              <span class="cx-surface-tier">{group.tier}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    surfaceGroups.map((group) => (
      <section id={`surface-${group.surface}`}>
        <OperationTable surface={group.surface} />
      </section>
    ))
  }
</StarlightPage>

<style is:global>
  .cx-surface-jump {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    background: var(--sl-color-bg-nav);
    margin: 0.75rem 0 1.5rem;
    font-size: 0.9rem;
  }
  .cx-surface-jump strong {
    margin-right: 0.5rem;
  }
  .cx-surface-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0.4rem 0 0;
  }
  .cx-surface-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    text-decoration: none;
    color: var(--sl-color-text);
  }
  .cx-surface-jump a:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }
  .cx-surface-jump .cx-surface-tier {
    font-size: 0.72rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .cx-surface-jump a[data-tier="extension"] .cx-surface-tier {
    background: color-mix(in srgb, #d97706 22%, transparent);
    color: #d97706;
  }
  .cx-surface-jump a[data-tier="deployment_local"] .cx-surface-tier {
    background: color-mix(in srgb, #6b46c1 22%, transparent);
    color: #6b46c1;
  }
</style>
