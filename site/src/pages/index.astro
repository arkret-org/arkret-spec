---
import MarketingLayout from "~/layouts/MarketingLayout.astro";

const protocolPillars = [
  {
    title: "事实先行",
    body: "每一次行为都转成可验证 Event；应用状态不再依赖数据库私有逻辑，而由可复现 reducer 从事实链计算。",
  },
  {
    title: "对象可投影",
    body: "Space / Flow / Message / Relation 统一成对象语义图，不同客户端可按需求构建视图，不被底层实现锁死。",
  },
  {
    title: "能力分层",
    body: "Profile 明确实现范围；constraint 和 capability 让每个 surface 的权限与合规模型可逐步启用。",
  },
  {
    title: "生态可扩展",
    body: "Registry 与 schema 机制保证新语义在不破坏历史兼容的前提下持续演进。",
  },
];

const engineFlow = [
  {
    step: "01",
    title: "签名事件",
    body: "客户端用 DID/密钥对事件进行签名，产出可核验的提交单元。",
  },
  {
    step: "02",
    title: "约束校验",
    body: "Payload 与 schema 验证通过后，进入 capability / constraint 判定，确保边界满足业务与安全规则。",
  },
  {
    step: "03",
    title: "统一归约",
    body: "所有实现按同一 reducer 语义更新对象状态，避免“各写各的解释器”导致的分叉。",
  },
  {
    step: "04",
    title: "视图投影",
    body: "协作对象被投影为消息、看板、文档、关系等形态，供 UI、搜索或策略层消费。",
  },
];

const entryPoints = [
  {
    title: "中文规范",
    description: "从总览、对象定义到治理约束，一条线读完整体结构。",
    href: "/zh/v1/",
  },
  {
    title: "规范导览",
    description: "按阅读路径快速定位每个章节在实现中的职责。",
    href: "/zh/v1/spec-map/",
  },
  {
    title: "OpenAPI",
    description: "服务端绑定与请求响应契约，帮助快速搭建交付流程。",
    href: "/openapi/",
  },
  {
    title: "Catalog",
    description: "事件类型、Schema、操作与错误码一目了然，便于跨系统联调。",
    href: "/catalog/event-kinds/",
  },
];

const useCases = [
  "企业协作平台",
  "IM 团队与项目管理",
  "跨组织文档协作",
  "Agent to Agent 的可验证协同",
  "高合规 E2EE 场景",
  "教育与金融行业的多方审计",
];
---

<MarketingLayout>
  <section class="cx-hero">
    <div class="cx-shell cx-hero-inner cx-home-hero">
      <p class="cx-kicker">Decentralized Collaboration Protocol</p>
      <h1>
        让协作成为可证明的事实网络，<br />
        而不是“状态同步猜测”
      </h1>
      <p class="cx-lead">
        Contrix 通过统一事件与对象语义，把消息、文档、看板、关系和权限放到一套可复现的数据模型中。不同实现可以
        在同一事实来源上独立开发，但始终得出一致的协作世界。
      </p>
      <div class="cx-hero-highlights">
        <article class="cx-hero-highlight">
          <h3>目标</h3>
          <p>把协作从“界面行为”抽到“规范事实”。</p>
        </article>
        <article class="cx-hero-highlight">
          <h3>方法</h3>
          <p>以 Event、Reducer 和签名为核心，构建确定性可审计链。</p>
        </article>
        <article class="cx-hero-highlight">
          <h3>结果</h3>
          <p>减少互操作摩擦，提高长期可维护性与跨系统可验证性。</p>
        </article>
      </div>
      <div class="cx-cta-row">
        <a class="cx-btn cx-btn-primary" href="/zh/v1/spec-map/">开始阅读</a>
        <a class="cx-btn cx-btn-ghost" href="/zh/v1/overview/architecture/">协议架构</a>
        <a class="cx-btn cx-btn-ghost" href="/openapi/">查看 OpenAPI</a>
      </div>
    </div>
  </section>

  <section class="cx-section">
    <div class="cx-shell">
      <div class="cx-section-head">
        <h2>Contrix 的核心约束</h2>
        <p>协议优先定义事实，接口与行为只围绕事实变更展开。</p>
      </div>
      <div class="cx-feature-grid">
        {
          protocolPillars.map((pillar) => (
            <article class="cx-feature-card">
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cx-section cx-section-elevated">
    <div class="cx-shell">
      <div class="cx-section-head">
        <h2>运行时模型（1 到 4）</h2>
        <p>从事件提交到可见状态，协议定义的是一条最小闭环。</p>
      </div>
      <div class="cx-flow">
        {
          engineFlow.map((item) => (
            <article class="cx-flow-step">
              <span class="cx-flow-step-no">{item.step}</span>
              <div class="cx-flow-body">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cx-section">
    <div class="cx-shell cx-home-grid-2">
      <div>
        <div class="cx-section-head">
          <h2>从规范到实现的入口</h2>
          <p>选择最适合的阅读路径，直接进入你的开发节奏。</p>
        </div>
        <div class="cx-entry-grid">
          {
            entryPoints.map((entry) => (
              <a class="cx-resource" href={entry.href}>
                <span class="cx-resource-title">{entry.title}</span>
                <span class="cx-resource-desc">{entry.description}</span>
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <div class="cx-section-head">
          <h2>优先场景</h2>
          <p>适合对一致性、权限和可审计性有明确要求的协作系统。</p>
        </div>
        <ul class="cx-case-list">
          {
            useCases.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</MarketingLayout>
