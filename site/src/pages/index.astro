---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import { repoUrl, specReleaseTag, specReleaseLabel } from "~/lib/site-meta";

/* Homepage structure, in the order a first-time reader needs it:
 *   1. what it is          — hero lead
 *   2. what the world looks like, and who is authoritative at each layer
 *                          — protocolStack, from overview/architecture.md §3
 *                            (core stack Presentation→Identity) with the
 *                            authority column from the same file's §6 trust
 *                            boundaries.
 *   3. what it covers      — landings, from overview/current-model.md §1.1
 *   4. what you therefore get — guarantees (audit / security / cross-org)
 *   5. where to start reading — entryPoints
 * Keep every entry to one sentence; the spec pages carry the detail. */

const protocolStack = [
  {
    plane: "Presentation",
    name: "客户端界面",
    what: "聊天、看板、时间线、日历、文档——都是同一份事实的不同画法。",
    authority: "派生，可随时重算",
  },
  {
    plane: "Projection",
    name: "本地投影",
    what: "当前状态、搜索和收件箱默认在你自己的设备上算出来，不必交给服务端索引。",
    authority: "派生，不是真相源",
  },
  {
    plane: "Distribution",
    name: "同步与联邦",
    what: "Principal Server 之间交换 Realm 增量；加密内容原样转发，服务器不需要能读懂。",
    authority: "可替换的基础设施",
  },
  {
    plane: "Write",
    name: "签名事件",
    what: "每一次持久修改——消息、任务、文档、通话、权限变更、Agent 产出——都是一条 actor 签名的 Event，按 Realm 划定成员、历史与加密边界。",
    authority: "唯一事实",
    truth: true,
  },
  {
    plane: "Identity",
    name: "身份",
    what: "principal 是一个 did:webvh，带可审计的控制历史；由你或你的组织掌握，不属于任何厂商。",
    authority: "信任根",
  },
];

const landings = [
  {
    concept: "群聊 / 频道",
    body: "Realm 划定成员与历史边界，Strand 承载一个话题，消息挂在它的 discussion track 上。",
  },
  {
    concept: "看板 / 列 / 卡片",
    body: "看板和列都是 Space，卡片是 Strand。拖动改的是对象位置，不是某个视图的本地状态。",
  },
  {
    concept: "Issue / 依赖 / 指派",
    body: "Strand 带粗粒度 stage；依赖、阻塞、指派用 Relation 表达，不藏在自由字段里。",
  },
  {
    concept: "文档 / 长文",
    body: "正文在 Strand 的 synthesis track，讨论在 discussion track，同一件事不用拆成两个产品。",
  },
  {
    concept: "只给一部分人的私密子群",
    body: "Circle 复用父 Realm 的联邦与策略，只裁剪成员、历史与投递，必要时启用独立 MLS group。",
  },
  {
    concept: "和自己的 AI Agent 协作",
    body: "Agent Sidecar 是每个用户在每个 Realm 内的私人工作区，有独立 MLS，不是普通子群。",
  },
];

const guarantees = [
  {
    mark: "可审计",
    title: "历史不需要相信服务器",
    body: "每条修改都由 actor 签名并带因果链，事后任何一方都能离线重放验证。服务器可以拒收、延迟或丢失副本，但伪造不了。",
  },
  {
    mark: "安全",
    title: "权限是凭证，不是后台开关",
    body: "capability 写明资源、动作、时间窗、字段范围与审批要求，可撤销也可委托；成员和设备变更绑定同一个 MLS epoch，移出之后就真的读不到。",
  },
  {
    mark: "跨组织",
    title: "协作不必把数据交出去",
    body: "各方掌握自己的服务器、密钥与数据驻地，通过联邦交换事件；对外协作放在单独的 Realm，不开放内部目录。",
  },
];

const entryPoints = [
  {
    title: "规范导览",
    description: "阅读路径与文档地图",
    href: "/zh/v1/spec-map/",
    badge: "map",
  },
  {
    title: "协议分层",
    description: "Kernel / Collaboration Base / Extension 的边界",
    href: "/zh/v1/overview/protocol-layers/",
    badge: "normative",
  },
  {
    title: "架构与信任边界",
    description: "服务角色、部署拓扑与谁能证明什么",
    href: "/zh/v1/overview/architecture/",
    badge: "normative",
  },
  {
    title: "对象模型",
    description: "对象总览与 typed-id 一览",
    href: "/zh/v1/models/overview/",
    badge: "model",
  },
  {
    title: "OpenAPI",
    description: "HTTP binding 与请求响应契约",
    href: "/openapi/",
    badge: "wire",
  },
  {
    title: "Catalog",
    description: "事件类型、Schema、操作与错误码",
    href: "/catalog/event-kinds/",
    badge: "registry",
  },
];
---

<MarketingLayout>
  <section class="ak-hero">
    <div class="ak-shell ak-hero-inner ak-home-hero">
      <img
        class="ak-hero-brand"
        src="/brand/arkret-logo.svg"
        alt="Arkret logo"
        width="148"
        height="148"
        loading="eager"
        decoding="async"
      />
      <div class="ak-hero-eyebrow">
        <span class="ak-pill ak-pill--accent">
          <span class="ak-pill-dot" aria-hidden="true"></span>
          {specReleaseTag} · {specReleaseLabel}
        </span>
        <span class="ak-pill ak-pill--license">
          <span class="ak-pill-mono">Apache 2.0</span>
          全栈开源 · 商业友好
        </span>
      </div>
      <h1>
        协作软件的<br />
        <span class="ak-h1-accent">去中心化事实层</span>
      </h1>
      <p class="ak-lead">
        Arkret 只规定一件事：什么算作事实。消息、任务、文档、日历、通话和 AI Agent 的产出，
        全都是由 actor 签名、按 Realm 划定边界的 Event，在各方自己托管的服务器之间联邦同步。
        客户端把它们投影成聊天、看板或时间线——界面可以换，事实不变。
      </p>
      <div class="ak-cta-row">
        <a class="ak-btn ak-btn-primary" href="/zh/v1/spec-map/">
          开始阅读规范
          <span aria-hidden="true">→</span>
        </a>
        <a class="ak-btn ak-btn-ghost" href="/ecosystem/">浏览参考实现</a>
        <a class="ak-btn ak-btn-ghost" href={repoUrl} rel="noopener">GitHub</a>
      </div>
    </div>
  </section>

  <section class="ak-section ak-section-tight">
    <div class="ak-shell">
      <div class="ak-section-head">
        <div>
          <span class="ak-section-tag">协议的全貌</span>
          <h2>五层，每层都写明谁说了算</h2>
        </div>
        <p class="ak-section-sub">
          常见系统里这五层混在一个服务端数据库里，于是「谁说了算」永远是那台服务器。
        </p>
      </div>
      <ol class="ak-stack">
        {
          protocolStack.map((row) => (
            <li class={`ak-stack-row${row.truth ? " ak-stack-row--truth" : ""}`}>
              <div class="ak-stack-plane">
                <b>{row.plane}</b>
                <span>{row.name}</span>
              </div>
              <p class="ak-stack-what">{row.what}</p>
              <div class="ak-stack-auth">{row.authority}</div>
            </li>
          ))
        }
      </ol>
      <p class="ak-stack-note">
        另有两个横切层：Confidentiality 决定每一层各自能看到什么，
        让服务器在读不懂正文的前提下也能继续转发；Portability 保证整份历史可导出、
        可重放、可以换一家服务商继续用。
      </p>
    </div>
  </section>

  <section class="ak-section ak-section-elevated">
    <div class="ak-shell">
      <div class="ak-section-head">
        <div>
          <span class="ak-section-tag">覆盖范围</span>
          <h2>同一份事实，投影成你熟悉的形态</h2>
        </div>
        <p class="ak-section-sub">
          Arkret 不把某个产品的对象名搬进协议，而是把常见协作场景拆成更稳定的边界。
        </p>
      </div>
      <div class="ak-concepts">
        {
          landings.map((item) => (
            <article class="ak-concept">
              <div class="ak-concept-tag">{item.concept}</div>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ak-section ak-section-tight">
    <div class="ak-shell">
      <div class="ak-section-head">
        <div>
          <span class="ak-section-tag">因此</span>
          <h2>安全、可审计、跨组织，是结构带来的，不是配置项</h2>
        </div>
      </div>
      <div class="ak-pillar-grid">
        {
          guarantees.map((g) => (
            <article class="ak-pillar-card">
              <span class="ak-pillar-mark">{g.mark}</span>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ak-section">
    <div class="ak-shell">
      <div class="ak-section-head">
        <div>
          <span class="ak-section-tag">入口</span>
          <h2>从规范到实现</h2>
        </div>
        <p class="ak-section-sub">
          zh 下的中文是唯一 normative 权威；artifacts 是语言中立的机读契约。
        </p>
      </div>
      <div class="ak-entry-grid ak-entry-grid--wide">
        {
          entryPoints.map((entry) => (
            <a class="ak-resource" href={entry.href}>
              <div class="ak-resource-row">
                <span class="ak-resource-title">{entry.title}</span>
                <span class="ak-resource-badge">{entry.badge}</span>
              </div>
              <span class="ak-resource-desc">{entry.description}</span>
              <span class="ak-resource-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ak-section ak-section-os">
    <div class="ak-shell">
      <a class="ak-os-banner" href="/ecosystem/">
        <div class="ak-os-banner-text">
          <span class="ak-section-tag">官方实现</span>
          <h2>协议、SDK、服务端、客户端、一致性测试——全部开源</h2>
          <p>
            spec / rust-sdk / soland (principal server) / coauth / sodmin / floria
            (push gateway) / inkson (跨平台客户端) / chime / cotest——开箱即用的完整参考栈。
          </p>
        </div>
        <span class="ak-os-banner-cta">
          浏览生态
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>
</MarketingLayout>
