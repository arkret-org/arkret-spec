---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import { repoUrl, specReleaseTag, specReleaseLabel } from "~/lib/site-meta";

const heroStats = [
  { value: "Signed Events", label: "每条持久修改可独立验签" },
  { value: "Capability Authz", label: "授权链可重放、可撤销、可委托" },
  { value: "MLS Governance", label: "成员与设备变更绑定加密 epoch" },
  { value: "DID Agents", label: "人、设备、Agent 共用同一责任链" },
];

const painPoints = [
  {
    tag: "历史可信",
    title: "能导出历史，不等于历史可验证",
    body:
      "常见协作和社交系统把消息、成员、撤回、权限保存在服务端数据库里。客户端可以验证连接和登录态，却通常不能离线证明「这条历史确实由某个 actor 在某个授权下产生」。Cokret 把持久修改定义为签名 Event, 让同步节点、客户端和审计方都能独立重放。",
  },
  {
    tag: "授权可携带",
    title: "权限不应该只是一段后台配置",
    body:
      "很多系统的「谁能做什么」由服务端 ACL、角色表或控制台配置解释；跨服务迁移、联邦同步或离线审计时，这些规则很难随数据一起被验证。Cokret 用 capability grant 表达主体、资源、动作、时间窗、字段约束和审批要求，授权本身成为可校验对象。",
  },
  {
    tag: "E2EE 治理",
    title: "端到端加密不会自动解决成员治理",
    body:
      "E2EE 保护内容密文，但成员加入、移除、设备撤销、举报与审核仍需要协议把治理状态和密钥状态对齐。Cokret 把 Space policy、成员变更和设备生命周期绑定进 MLS epoch；新消息必须基于新 epoch，避免 UI 状态和加密状态分叉。",
  },
  {
    tag: "Agent 边界",
    title: "Bot token 不足以承载自主 Agent",
    body:
      "平台应用通常通过 API token、scope 和服务端审计来限制自动化行为。面对可规划、可委托、可连续行动的 Agent, 协议还需要记录 acting principal、责任主体、资源边界、时间窗和审批约束。Cokret 让 Agent 以 DID principal 身份签名事件，和人类 actor 共用同一套责任链。",
  },
];

const protocolPillars = [
  {
    mark: "Event",
    title: "签名事件是事实最小单位",
    body:
      "所有持久修改都是 actor 签名的 Event Envelope, prev_refs 形成因果链，event_id 提供幂等。服务端负责同步和索引，但不能替 actor 伪造历史。",
  },
  {
    mark: "Capability",
    title: "权限是凭证，不是后台状态",
    body:
      "每次高价值写入都能追溯到 capability grant: 主体、资源、动作、时间窗、字段约束、最大委托深度和 approval 要求都在协议对象里表达。",
  },
  {
    mark: "MLS",
    title: "治理变更进入加密上下文",
    body:
      "成员变更、设备撤销、policy 升级会被 governance binding 写入 MLS GroupContext。实现不能只改 UI 成员表而忘记推进加密 epoch。",
  },
  {
    mark: "Identity",
    title: "身份不绑定单个服务商账号",
    body:
      "principal 默认使用 did:webvh，带 history chain、SCID 和 witness 证据。Handle 只是可迁移的人类入口，权限主体始终是 DID principal。",
  },
  {
    mark: "Object",
    title: "聊天、任务、文档来自同一事实图",
    body:
      "Realm 是安全、同步、权限和加密边界；Space、Strand、Message、Morph、Relation 组成对象图。UI 通过 projection 呈现聊天、看板、时间线或工作流。",
  },
  {
    mark: "Agent",
    title: "Agent 行为可限权、可回放、可追责",
    body:
      "Agent 持有自己的 DID 和 capability grant, 可以加入 MLS group、签名事件、参与 approval 流程。它的每一步行动都进入同一条审计链。",
  },
];

const engineStrand = [
  {
    step: "01",
    title: "提交事实",
    body: "客户端用 actor DID 私钥签名 Event Envelope, 带 prev_refs、event_id 和目标 Space, 产出可重放的事实单元。",
  },
  {
    step: "02",
    title: "验证授权",
    body: "接收方先验 schema, 再验 capability grant 是否覆盖该资源、动作和字段；高风险动作必须满足 approval 约束。",
  },
  {
    step: "03",
    title: "锚定状态",
    body: "事件进入 Anchor DAG, 获得不依赖全局共识的相对顺序；涉及成员、设备或策略时同步锚定到 MLS governance binding。",
  },
  {
    step: "04",
    title: "投影视图",
    body: "reducer 把对象图投影成消息、看板、时间线或关系视图。不同实现可以有不同 UI, 但共享同一份协议事实。",
  },
];

const entryPoints = [
  {
    title: "中文规范",
    description: "从架构总览、对象模型到治理约束,一条线读完整体结构。",
    href: "/zh/v1/",
    badge: "normative",
  },
  {
    title: "规范导览",
    description: "按阅读路径快速定位每个章节在实现中的职责。",
    href: "/zh/v1/spec-map/",
    badge: "map",
  },
  {
    title: "OpenAPI",
    description: "服务端 HTTP binding 与请求响应契约,Scalar 渲染。",
    href: "/openapi/",
    badge: "wire",
  },
  {
    title: "Catalog",
    description: "事件类型、Schema、操作与错误码一目了然,便于跨系统联调。",
    href: "/catalog/event-kinds/",
    badge: "registry",
  },
];

const useCases = [
  {
    title: "组织自托管协作",
    body: "组织掌握 principal server、密钥、数据驻地和 witness 策略，同时保持协议级互操作。",
  },
  {
    title: "跨组织项目空间",
    body: "Capability grant 是跨域可验证的签名凭证，federation 不需要把权限降级成共享 token。",
  },
  {
    title: "强合规 E2EE 工作区",
    body: "成员、设备、policy 与 MLS epoch 一起收敛，便于审计谁在什么时候仍有解密资格。",
  },
  {
    title: "AI Agent 协作流",
    body: "Agent 行为受时间窗、资源、字段和审批约束，每次写入都能回放到具体责任主体。",
  },
  {
    title: "长期可恢复知识库",
    body: "事件、schema、快照和 frontier 都是协议对象，适合做可迁移、可审计、可重建的组织记忆。",
  },
  {
    title: "多应用同源视图",
    body: "同一 Space 事实可被聊天、看板、文档、目录或自动化工具投影，不需要复制成多个产品数据库。",
  },
];
---

<MarketingLayout>
  <section class="ck-hero">
    <div class="ck-shell ck-hero-inner ck-home-hero">
      <img
        class="ck-hero-brand"
        src="/brand/cokret-logo.svg"
        alt="Cokret logo"
        width="148"
        height="148"
        loading="eager"
        decoding="async"
      />
      <div class="ck-hero-eyebrow">
        <span class="ck-pill ck-pill--accent">
          <span class="ck-pill-dot" aria-hidden="true"></span>
          {specReleaseTag} · {specReleaseLabel}
        </span>
        <span class="ck-pill ck-pill--license">
          <span class="ck-pill-mono">Apache 2.0</span>
          全栈开源 · 商业友好
        </span>
      </div>
      <h1>
        给协作软件的一层<br />
        <span class="ck-h1-accent">可验证事实协议</span>
      </h1>
      <p class="ck-lead">
        Cokret 定义消息、任务、文档、关系和 Agent 行为在网络中的共同真相：
        <strong>谁创建</strong>、<strong>基于什么授权</strong>、
        <strong>处于哪个 Space</strong>、<strong>受哪个加密 epoch 保护</strong>。
        它不是聊天 UI, 也不是区块链；它是一套事件、身份、授权、E2EE 和同步规范，
        让不同实现可以共享同一份可验证协作历史。
      </p>
      <div class="ck-cta-row">
        <a class="ck-btn ck-btn-primary" href="/zh/v1/spec-map/">
          开始阅读规范
          <span aria-hidden="true">→</span>
        </a>
        <a class="ck-btn ck-btn-ghost" href="/ecosystem/">浏览参考实现</a>
        <a class="ck-btn ck-btn-ghost" href={repoUrl} rel="noopener">GitHub</a>
      </div>
      <dl class="ck-hero-stats">
        {
          heroStats.map((stat) => (
            <div class="ck-hero-stat">
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="ck-section ck-section-tight">
    <div class="ck-shell">
      <div class="ck-section-head">
        <div>
          <span class="ck-section-tag">为什么需要新协议</span>
          <h2>现实问题不是「有没有功能」,而是「能不能被验证」</h2>
        </div>
        <p class="ck-section-sub">
          以下问题来自常见系统边界：服务端数据库是事实权威、授权规则留在平台内、
          E2EE 与治理状态分层、自动化身份依赖 token。Cokret 把这些边界提升到协议层处理。
        </p>
      </div>
      <div class="ck-pain-grid">
        {
          painPoints.map((p) => (
            <article class="ck-pain-card">
              <span class="ck-pain-tag">{p.tag}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ck-section ck-section-elevated">
    <div class="ck-shell">
      <div class="ck-section-head">
        <div>
          <span class="ck-section-tag">六根支柱</span>
          <h2>Cokret 先定义协作事实，再定义接口和投影</h2>
        </div>
        <p class="ck-section-sub">
          签名事件、Capability 授权、MLS 治理绑定、去中心化身份、可投影对象图、Agent 责任链。
        </p>
      </div>
      <div class="ck-pillar-grid">
        {
          protocolPillars.map((pillar) => (
            <article class="ck-pillar-card">
              <span class="ck-pillar-mark">{pillar.mark}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ck-section ck-section-tight">
    <div class="ck-shell">
      <div class="ck-section-head">
        <div>
          <span class="ck-section-tag">运行时闭环</span>
          <h2>一次写入,沿 4 个确定性环节变成可见状态</h2>
        </div>
        <p class="ck-section-sub">
          协议规定的不是 UI, 而是「提交事实 → 验证授权 → 锚定状态 → 投影视图」的不可分叉路径。
        </p>
      </div>
      <ol class="ck-strand-rail">
        {
          engineStrand.map((item, i) => (
            <li class="ck-strand-node">
              <div class="ck-strand-node-head">
                <span class="ck-strand-step-no">{item.step}</span>
                {i < engineStrand.length - 1 && (
                  <span class="ck-strand-connector" aria-hidden="true" />
                )}
              </div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="ck-section ck-section-os">
    <div class="ck-shell">
      <a class="ck-os-banner" href="/ecosystem/">
        <div class="ck-os-banner-text">
          <span class="ck-section-tag">官方实现</span>
          <h2>协议、SDK、服务端、客户端、一致性测试——全部开源</h2>
          <p>
            spec / rust-sdk / soland (principal server) / coauth / sodmin / floria
            (push gateway) / yougen (跨平台客户端) / chime / cotest——开箱即用的完整参考栈。
          </p>
        </div>
        <span class="ck-os-banner-cta">
          浏览生态
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <section class="ck-section">
    <div class="ck-shell ck-home-grid-2">
      <div>
        <div class="ck-section-head ck-section-head--stack">
          <span class="ck-section-tag">入口</span>
          <h2>从规范到实现</h2>
          <p class="ck-section-sub">选择最适合的阅读路径,直接进入你的开发节奏。</p>
        </div>
        <div class="ck-entry-grid">
          {
            entryPoints.map((entry) => (
              <a class="ck-resource" href={entry.href}>
                <div class="ck-resource-row">
                  <span class="ck-resource-title">{entry.title}</span>
                  <span class="ck-resource-badge">{entry.badge}</span>
                </div>
                <span class="ck-resource-desc">{entry.description}</span>
                <span class="ck-resource-arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <div class="ck-section-head ck-section-head--stack">
          <span class="ck-section-tag">应用场景</span>
          <h2>适合需要长期可信边界的产品</h2>
          <p class="ck-section-sub">
            当协作历史、权限、加密状态和 Agent 行为都需要被复核时，协议层事实比产品内状态更可靠。
          </p>
        </div>
        <ul class="ck-case-grid">
          {
            useCases.map((u) => (
              <li>
                <span class="ck-case-mark" aria-hidden="true">✦</span>
                <div>
                  <strong>{u.title}</strong>
                  <span>{u.body}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</MarketingLayout>
