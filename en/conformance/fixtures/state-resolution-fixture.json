{
  "suite": "state_resolution",
  "cases": [
    {
      "name": "membership_concurrency",
      "scenario": "member join races with ban",
      "expected": "ban_wins_when_higher_auth_weight"
    },
    {
      "name": "capability_delegate_revoke_race",
      "scenario": "delegation and revoke share causal frontier",
      "expected": "revoked_delegate_fails_closed"
    },
    {
      "name": "schema_policy_update_race",
      "scenario": "policy update and entity write race",
      "expected": "write_validated_against_resolved_policy_state"
    },
    {
      "name": "deterministic_tie_breaker",
      "scenario": "same_hlc_same_auth_weight",
      "expected": "stable_actor_seq_then_event_id_order"
    },
    {
      "name": "board_concurrent_item_move",
      "vector": "cx.vector.state_resolution.board_concurrent_item_move.v1",
      "scenario": "same item moved concurrently to two containers in one board scope",
      "input": {
        "base_state": {
          "scope_container_id": "cx:entity:01js0bd0000000000000000000",
          "relation_kind": "contains",
          "entity_id": "cx:entity:01js0tk0000000000000000000",
          "container_id": "cx:entity:01js0c10000000000000000000",
          "rank": "h0",
          "relation_id": "cx:relation:01js0r10000000000000000000",
          "source_operation_id": "cx:operation:01js0bs1000000000000000000"
        },
        "candidates": [
          {
            "operation_id": "cx:operation:01js0mv1000000000000000000",
            "kind": "cx.container.move_item",
            "actor_id": "did:web:alice.example",
            "hlc": "01970e589d24-0001-11111111",
            "auth_weight": 10,
            "content": {
              "scope_container_id": "cx:entity:01js0bd0000000000000000000",
              "relation_kind": "contains",
              "entity_id": "cx:entity:01js0tk0000000000000000000",
              "from_container_id": "cx:entity:01js0c10000000000000000000",
              "to_container_id": "cx:entity:01js0c20000000000000000000",
              "rank": "mV",
              "expected_position": {
                "container_id": "cx:entity:01js0c10000000000000000000",
                "rank": "h0",
                "relation_id": "cx:relation:01js0r10000000000000000000"
              }
            }
          },
          {
            "operation_id": "cx:operation:01js0mv2000000000000000000",
            "kind": "cx.container.move_item",
            "actor_id": "did:web:bob.example",
            "hlc": "01970e589d24-0002-22222222",
            "auth_weight": 10,
            "content": {
              "scope_container_id": "cx:entity:01js0bd0000000000000000000",
              "relation_kind": "contains",
              "entity_id": "cx:entity:01js0tk0000000000000000000",
              "from_container_id": "cx:entity:01js0c10000000000000000000",
              "to_container_id": "cx:entity:01js0c30000000000000000000",
              "rank": "p0",
              "expected_position": {
                "container_id": "cx:entity:01js0c10000000000000000000",
                "rank": "h0",
                "relation_id": "cx:relation:01js0r10000000000000000000"
              }
            }
          }
        ]
      },
      "expected": {
        "resolved_position": {
          "scope_container_id": "cx:entity:01js0bd0000000000000000000",
          "relation_kind": "contains",
          "entity_id": "cx:entity:01js0tk0000000000000000000",
          "container_id": "cx:entity:01js0c30000000000000000000",
          "rank": "p0",
          "source_operation_id": "cx:operation:01js0mv2000000000000000000"
        },
        "active_position_registers": [
          {
            "state_key": "cx:entity:01js0bd0000000000000000000|contains|cx:entity:01js0tk0000000000000000000",
            "container_id": "cx:entity:01js0c30000000000000000000",
            "rank": "p0",
            "source_operation_id": "cx:operation:01js0mv2000000000000000000"
          }
        ],
        "inactive_source_operation_ids": [
          "cx:operation:01js0bs1000000000000000000",
          "cx:operation:01js0mv1000000000000000000"
        ],
        "conflict_records": [
          {
            "conflict_type": "exclusive_position",
            "state_key": "cx:entity:01js0bd0000000000000000000|contains|cx:entity:01js0tk0000000000000000000",
            "winner": "cx:operation:01js0mv2000000000000000000",
            "losers": ["cx:operation:01js0mv1000000000000000000"],
            "reason": "same auth weight; later HLC wins by deterministic operation order"
          }
        ]
      },
      "assertions": [
        "exactly one active_position_register exists for the state_key",
        "resolved_position container_id, rank, and source_operation_id all come from the same winning cx.container.move_item",
        "loser operation does not remain active in ordinary board projection",
        "conflict_records preserve winner, loser, state_key, and deterministic reason"
      ]
    },
    {
      "name": "board_atomic_field_position_move",
      "scenario": "field-position move updates group value and rank atomically",
      "input": {
        "base_state": {
          "view_id": "cx:view:01js0vw0000000000000000000",
          "entity_id": "cx:entity:01js0tk0000000000000000000",
          "group_by": "fields.status",
          "value": "todo",
          "rank": "h0",
          "source_operation_id": "cx:operation:01js0bs1000000000000000000"
        },
        "candidates": [
          {
            "operation_id": "cx:operation:01js0tm1000000000000000000",
            "kind": "cx.field_position.move",
            "actor_id": "did:web:alice.example",
            "hlc": "01970e589d25-0001-11111111",
            "auth_weight": 10,
            "content": {
              "entity_id": "cx:entity:01js0tk0000000000000000000",
              "view_id": "cx:view:01js0vw0000000000000000000",
              "group_by": "fields.status",
              "to_value": "review",
              "rank": "mV"
            }
          },
          {
            "operation_id": "cx:operation:01js0tm2000000000000000000",
            "kind": "cx.field_position.move",
            "actor_id": "did:web:bob.example",
            "hlc": "01970e589d25-0002-22222222",
            "auth_weight": 10,
            "content": {
              "entity_id": "cx:entity:01js0tk0000000000000000000",
              "view_id": "cx:view:01js0vw0000000000000000000",
              "group_by": "fields.status",
              "to_value": "done",
              "rank": "p0"
            }
          }
        ]
      },
      "expected": {
        "resolved_position": {
          "view_id": "cx:view:01js0vw0000000000000000000",
          "entity_id": "cx:entity:01js0tk0000000000000000000",
          "group_by": "fields.status",
          "value": "done",
          "rank": "p0",
          "source_operation_id": "cx:operation:01js0tm2000000000000000000"
        },
        "conflict_records": [
          {
            "conflict_type": "atomic_position_register",
            "state_key": "cx:view:01js0vw0000000000000000000|cx:entity:01js0tk0000000000000000000|fields.status",
            "winner": "cx:operation:01js0tm2000000000000000000",
            "losers": ["cx:operation:01js0tm1000000000000000000"],
            "reason": "same auth weight; later HLC wins by deterministic operation order"
          }
        ]
      }
    },
    {
      "name": "container_rebalance_assignment",
      "scenario": "rank rebalance rewrites all active edges in stable reducer order",
      "input": {
        "rank_profile": "cx.rank.lexofractional.v1",
        "state_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "active_edges": [
          {
            "relation_id": "cx:relation:01js0r1000000000000000000",
            "entity_id": "cx:entity:01js0tk1000000000000000000",
            "rank": "a0"
          },
          {
            "relation_id": "cx:relation:01js0r2000000000000000000",
            "entity_id": "cx:entity:01js0tk2000000000000000000",
            "rank": "a00"
          },
          {
            "relation_id": "cx:relation:01js0r3000000000000000000",
            "entity_id": "cx:entity:01js0tk3000000000000000000",
            "rank": "a000"
          }
        ],
        "expected_state_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "expected_assignments": [
        {
          "relation_id": "cx:relation:01js0r1000000000000000000",
          "entity_id": "cx:entity:01js0tk1000000000000000000",
          "rank": "F"
        },
        {
          "relation_id": "cx:relation:01js0r2000000000000000000",
          "entity_id": "cx:entity:01js0tk2000000000000000000",
          "rank": "V"
        },
        {
          "relation_id": "cx:relation:01js0r3000000000000000000",
          "entity_id": "cx:entity:01js0tk3000000000000000000",
          "rank": "k"
        }
      ]
    },
    {
      "name": "container_rebalance_cas_conflict",
      "scenario": "rank rebalance submitted against stale ordered-set state hash",
      "input": {
        "state_hash": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "expected_state_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      },
      "expected": "reject_without_partial_assignment"
    }
  ]
}
