{
  "suite": "encoding",
  "cases": {
    "canonical_json": [
      {
        "name": "sorted_object_keys",
        "input": { "b": 2, "a": 1 },
        "canonical": "{\"a\":1,\"b\":2}"
      }
    ],
    "hash_digest": [
      {
        "name": "event_digest_shape",
        "input_ref": "cx:event:demo",
        "expected_pattern": "^sha256:[0-9a-f]{64}$"
      }
    ],
    "proof_payload": [
      {
        "name": "unsigned_not_covered",
        "covered_fields": ["event_id", "kind", "space_id", "content", "proofs"],
        "excluded_fields": ["unsigned"]
      }
    ],
    "hlc": [
      {
        "name": "lexicographic_order_matches_causal_order",
        "values": ["01970e589d21-0004-a13f9c2e", "01970e589d21-0005-a13f9c2e"]
      }
    ],
    "cursor": [
      {
        "name": "opaque_cursor_wraps_frontier",
        "shape": { "v": "1", "x": 1714080000000 }
      }
    ],
    "fractional_rank": [
      {
        "name": "rank_between",
        "left": "a0",
        "right": "a2",
        "expected": "a1"
      },
      {
        "name": "rank_between_start",
        "left": null,
        "right": "U",
        "expected": "E"
      },
      {
        "name": "rank_between_end",
        "left": "U",
        "right": null,
        "expected": "k"
      },
      {
        "name": "rank_dense_insert_extends",
        "left": "a0",
        "right": "a01",
        "expected": "a00"
      },
      {
        "name": "rebalance_assignments_three_items",
        "rank_profile": "cx.rank.lexofractional.v1",
        "ordered_edges": [
          {
            "relation_id": "cx:relation:01js0r1000000000000000000",
            "entity_id": "cx:entity:01js0tk1000000000000000000"
          },
          {
            "relation_id": "cx:relation:01js0r2000000000000000000",
            "entity_id": "cx:entity:01js0tk2000000000000000000"
          },
          {
            "relation_id": "cx:relation:01js0r3000000000000000000",
            "entity_id": "cx:entity:01js0tk3000000000000000000"
          }
        ],
        "expected_assignments": [
          {
            "relation_id": "cx:relation:01js0r1000000000000000000",
            "entity_id": "cx:entity:01js0tk1000000000000000000",
            "rank": "F"
          },
          {
            "relation_id": "cx:relation:01js0r2000000000000000000",
            "entity_id": "cx:entity:01js0tk2000000000000000000",
            "rank": "V"
          },
          {
            "relation_id": "cx:relation:01js0r3000000000000000000",
            "entity_id": "cx:entity:01js0tk3000000000000000000",
            "rank": "k"
          }
        ]
      },
      {
        "name": "rebalance_reject_partial_assignment",
        "active_edge_count": 3,
        "assignment_count": 2,
        "expected": "invalid_rebalance_assignment"
      },
      {
        "name": "rank_reject_invalid_character",
        "input": "a-1",
        "expected": "invalid_rank"
      },
      {
        "name": "rank_reject_too_long",
        "max_length": 128,
        "expected": "invalid_rank"
      }
    ]
  }
}
