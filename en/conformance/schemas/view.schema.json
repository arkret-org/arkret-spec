{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/view.schema.json",
  "title": "Contrix View",
  "type": "object",
  "required": ["id", "type", "space_id", "kind", "query", "created_by", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$" },
    "type": { "const": "view" },
    "schema": { "const": "cx.schema.view.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "kind": {
      "type": "string",
      "enum": [
        "kanban", "list", "table", "calendar", "gantt", "chat", "thread", "forum", "tree",
        "graph", "timeline", "review_queue", "matrix", "document", "dashboard", "activity",
        "inbox", "notifications", "memory_review", "agent_runs", "context_timeline", "moderation_queue"
      ]
    },
    "title": { "type": "string" },
    "query": { "$ref": "#/$defs/query" },
    "visible_fields": { "type": "array", "items": { "$ref": "#/$defs/field_path" } },
    "layout": { "type": "object" },
    "kanban": { "$ref": "#/$defs/kanban_config" },
    "tabular": { "$ref": "#/$defs/tabular_config" },
    "time_window": { "$ref": "#/$defs/time_window_config" },
    "timeline": { "$ref": "#/$defs/timeline_config" },
    "conversation": { "$ref": "#/$defs/conversation_config" },
    "graph": { "$ref": "#/$defs/graph_config" },
    "queue": { "$ref": "#/$defs/queue_config" },
    "matrix": { "$ref": "#/$defs/matrix_config" },
    "document": { "$ref": "#/$defs/document_config" },
    "dashboard": { "$ref": "#/$defs/dashboard_config" },
    "sort": { "type": "array", "items": { "$ref": "#/$defs/sort_spec" } },
    "created_by": { "$ref": "#/$defs/did" },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "kanban" } },
        "required": ["kind"]
      },
      "then": { "required": ["kanban"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "kanban" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "query": {
            "type": "object",
            "required": ["entity_types"],
            "properties": {
              "entity_types": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["list", "table"] } },
        "required": ["kind"]
      },
      "then": { "required": ["tabular"] }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["calendar", "gantt"] } },
        "required": ["kind"]
      },
      "then": { "required": ["time_window"] }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["timeline", "activity", "context_timeline"] } },
        "required": ["kind"]
      },
      "then": { "required": ["timeline"] }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["chat", "thread", "forum"] } },
        "required": ["kind"]
      },
      "then": { "required": ["conversation"] }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["chat", "thread", "forum"] } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "query": {
            "anyOf": [
              { "required": ["anchor_entity_id"] },
              { "required": ["relation"] }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["graph", "tree"] } },
        "required": ["kind"]
      },
      "then": { "required": ["graph"] }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["graph", "tree"] } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "query": { "required": ["relation"] }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "context_timeline" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "query": { "required": ["anchor_entity_id", "context"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["review_queue", "inbox", "notifications", "memory_review", "agent_runs", "moderation_queue"]
          }
        },
        "required": ["kind"]
      },
      "then": { "required": ["queue"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "matrix" } },
        "required": ["kind"]
      },
      "then": { "required": ["matrix"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "document" } },
        "required": ["kind"]
      },
      "then": { "required": ["document"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "dashboard" } },
        "required": ["kind"]
      },
      "then": { "required": ["dashboard"] }
    }
  ],
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "entity_id": { "type": "string", "pattern": "^cx:entity:[0-9a-hjkmnp-z]{26}$" },
    "cursor": { "type": "string", "pattern": "^cx:cursor:[A-Za-z0-9_-]+$" },
    "field_path": { "type": "string", "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$" },
    "filter_value": true,
    "field_filter": {
      "type": "object",
      "required": ["field", "op"],
      "properties": {
        "field": { "$ref": "#/$defs/field_path" },
        "op": {
          "type": "string",
          "enum": ["eq", "neq", "in", "not_in", "lt", "lte", "gt", "gte", "contains", "exists", "prefix", "full_text"]
        },
        "value": { "$ref": "#/$defs/filter_value" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "boolean_filter": {
      "type": "object",
      "properties": {
        "and": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" },
          "minItems": 1
        },
        "or": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" },
          "minItems": 1
        },
        "not": { "$ref": "#/$defs/filter" }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "filter": {
      "oneOf": [
        { "$ref": "#/$defs/field_filter" },
        { "$ref": "#/$defs/boolean_filter" }
      ]
    },
    "relation_query": {
      "type": "object",
      "required": ["kind", "direction"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["out", "in", "both"] },
        "source_entity_id": { "$ref": "#/$defs/entity_id" },
        "source_actor_id": { "$ref": "#/$defs/did" },
        "source_space_id": { "$ref": "#/$defs/space_id" },
        "target_entity_id": { "$ref": "#/$defs/entity_id" },
        "target_actor_id": { "$ref": "#/$defs/did" },
        "target_space_id": { "$ref": "#/$defs/space_id" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 32 }
      },
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["source_entity_id", "source_actor_id"] },
              { "required": ["source_entity_id", "source_space_id"] },
              { "required": ["source_actor_id", "source_space_id"] },
              { "required": ["target_entity_id", "target_actor_id"] },
              { "required": ["target_entity_id", "target_space_id"] },
              { "required": ["target_actor_id", "target_space_id"] }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "sort_spec": {
      "type": "object",
      "required": ["field", "direction"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["asc", "desc"] },
        "nulls": { "type": "string", "enum": ["first", "last"] }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "space_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/space_id" },
          "minItems": 1
        },
        "entity_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "anchor_entity_id": { "$ref": "#/$defs/entity_id" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" }
        },
        "relation": {
          "oneOf": [
            { "$ref": "#/$defs/relation_query" },
            { "type": "null" }
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "event_kinds": {
              "type": "array",
              "items": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" }
            },
            "relation_kinds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "event_tiebreak": { "type": "string", "enum": ["event_id", "operation_id"] }
          },
          "additionalProperties": false
        },
        "order_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort_spec" }
        },
        "projection": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_path" }
        },
        "cursor": {
          "oneOf": [
            { "$ref": "#/$defs/cursor" },
            { "type": "null" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "consistency": {
          "type": "object",
          "properties": {
            "wait_for": { "type": "string", "minLength": 1 },
            "timeout_ms": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "display_column": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/field_path" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "format": {
          "type": "string",
          "enum": ["text", "number", "boolean", "date", "datetime", "duration", "actor", "entity_ref", "badge", "markdown"]
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "hidden": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "tabular_config": {
      "type": "object",
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/display_column" },
          "minItems": 1
        },
        "row_order_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort_spec" },
          "minItems": 1
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "selection_policy": { "type": "string", "enum": ["none", "single", "multiple"], "default": "multiple" },
        "density": { "type": "string", "enum": ["compact", "standard", "comfortable"], "default": "standard" }
      },
      "additionalProperties": false
    },
    "time_window_config": {
      "type": "object",
      "required": ["start_field"],
      "properties": {
        "start_field": { "$ref": "#/$defs/field_path" },
        "end_field": { "$ref": "#/$defs/field_path" },
        "timezone": { "type": "string", "minLength": 1, "default": "UTC" },
        "bucket": { "type": "string", "enum": ["day", "week", "month", "quarter"], "default": "week" },
        "overlap_policy": { "type": "string", "enum": ["include_overlap", "start_within_range"], "default": "include_overlap" },
        "dependency_relation_kinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "timeline_config": {
      "type": "object",
      "required": ["time_field", "order"],
      "properties": {
        "time_field": { "$ref": "#/$defs/field_path" },
        "order": { "type": "string", "enum": ["asc", "desc"] },
        "event_kinds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" }
        },
        "relation_kinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "redaction_policy": { "type": "string", "enum": ["tombstone", "hide"], "default": "tombstone" },
        "tie_break": { "type": "string", "enum": ["event_id", "operation_id", "entity_id"], "default": "event_id" }
      },
      "additionalProperties": false
    },
    "conversation_config": {
      "type": "object",
      "required": ["message_entity_types", "message_time_field", "thread_relation_kind"],
      "properties": {
        "message_entity_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "message_time_field": { "$ref": "#/$defs/field_path" },
        "thread_relation_kind": { "type": "string", "minLength": 1 },
        "reply_relation_kind": { "type": "string", "minLength": 1, "default": "replies_to" },
        "mention_relation_kind": { "type": "string", "minLength": 1, "default": "mentions" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "redaction_policy": { "type": "string", "enum": ["tombstone", "hide"], "default": "tombstone" },
        "read_state_policy": { "type": "string", "enum": ["none", "per_actor", "per_device"], "default": "per_actor" }
      },
      "additionalProperties": false
    },
    "graph_config": {
      "type": "object",
      "required": ["node_entity_types", "edge_relation_kinds", "max_depth"],
      "properties": {
        "node_entity_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "edge_relation_kinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "direction": { "type": "string", "enum": ["out", "in", "both"], "default": "both" },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 32 },
        "cycle_policy": { "type": "string", "enum": ["mark", "truncate", "reject"], "default": "mark" },
        "lazy_link_policy": { "type": "string", "enum": ["emit_stub", "omit"], "default": "emit_stub" },
        "node_order_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort_spec" }
        }
      },
      "additionalProperties": false
    },
    "queue_config": {
      "type": "object",
      "required": ["item_entity_types", "state_field", "state_values"],
      "properties": {
        "item_entity_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "state_field": { "$ref": "#/$defs/field_path" },
        "state_values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "assignee_field": { "$ref": "#/$defs/field_path" },
        "priority_order_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort_spec" },
          "minItems": 1
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "count_policy": { "type": "string", "enum": ["omit", "authorized_estimate", "authorized_exact"], "default": "omit" }
      },
      "additionalProperties": false
    },
    "matrix_config": {
      "type": "object",
      "required": ["rows_by", "columns_by"],
      "properties": {
        "rows_by": { "$ref": "#/$defs/field_path" },
        "columns_by": { "$ref": "#/$defs/field_path" },
        "cell_aggregation": { "type": "string", "enum": ["count", "sum", "min", "max", "latest"], "default": "count" },
        "value_field": { "$ref": "#/$defs/field_path" },
        "row_limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "column_limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "additionalProperties": false
    },
    "document_config": {
      "type": "object",
      "required": ["root_entity_id", "section_relation_kind"],
      "properties": {
        "root_entity_id": { "$ref": "#/$defs/entity_id" },
        "section_relation_kind": { "type": "string", "minLength": 1 },
        "section_order_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort_spec" },
          "minItems": 1
        },
        "render_mode": { "type": "string", "enum": ["plain", "markdown", "rich_blocks"], "default": "rich_blocks" }
      },
      "additionalProperties": false
    },
    "dashboard_widget": {
      "type": "object",
      "required": ["id", "title", "projection", "query"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projection": {
          "type": "string",
          "enum": ["list", "table", "calendar", "gantt", "timeline", "graph", "tree", "matrix", "review_queue", "activity", "inbox", "notifications", "memory_review", "agent_runs", "moderation_queue"]
        },
        "query": { "$ref": "#/$defs/query" },
        "refresh_interval_ms": { "type": "integer", "minimum": 1000 }
      },
      "additionalProperties": false
    },
    "dashboard_config": {
      "type": "object",
      "required": ["widgets"],
      "properties": {
        "widgets": {
          "type": "array",
          "items": { "$ref": "#/$defs/dashboard_widget" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "kanban_column": {
      "type": "object",
      "required": ["key", "title"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rank": { "type": "string", "pattern": "^[0-9A-Za-z]{1,128}$" },
        "wip_limit": { "type": "integer", "minimum": 0 },
        "wip_limit_enforcement": {
          "type": "string",
          "enum": ["warn", "reject", "require_review"]
        }
      },
      "additionalProperties": false
    },
    "kanban_config": {
      "type": "object",
      "required": ["column_model", "card_order_by"],
      "properties": {
        "column_model": { "type": "string", "enum": ["field_value", "collection"] },
        "group_by": { "$ref": "#/$defs/field_path" },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/$defs/kanban_column" },
          "minItems": 1
        },
        "board_entity_id": { "$ref": "#/$defs/entity_id" },
        "column_relation_kind": { "type": "string", "minLength": 1, "default": "contains" },
        "card_relation_kind": { "type": "string", "minLength": 1 },
        "card_order_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/sort_spec" },
          "minItems": 1
        },
        "uncategorized_policy": {
          "type": "string",
          "enum": ["show", "hide", "reject"],
          "default": "show"
        },
        "conflict_policy": {
          "type": "string",
          "enum": ["reducer_winner", "expose_conflict", "reject"],
          "default": "reducer_winner"
        },
        "hidden_count_policy": {
          "type": "string",
          "enum": ["omit", "authorized_estimate", "authorized_exact"],
          "default": "omit"
        },
        "wip_limit_enforcement": {
          "type": "string",
          "enum": ["warn", "reject", "require_review"],
          "default": "warn"
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 500 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "column_model": { "const": "field_value" } },
            "required": ["column_model"]
          },
          "then": { "required": ["group_by", "columns"] }
        },
        {
          "if": {
            "properties": { "column_model": { "const": "collection" } },
            "required": ["column_model"]
          },
          "then": { "required": ["board_entity_id", "card_relation_kind"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
