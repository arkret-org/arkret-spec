{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/cursor.schema.json",
  "title": "Contrix Cursor",
  "type": "object",
  "required": ["v", "t", "s", "x"],
  "properties": {
    "v": { "const": "1" },
    "t": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "s": {
      "type": "object",
      "patternProperties": {
        "^cx:space:[0-9a-hjkmnp-z]{26}$": {
          "type": "object",
          "required": ["p", "o", "h"],
          "properties": {
            "p": { "type": "array", "items": { "type": "string", "pattern": "^cx:(evt|event|operation):[0-9a-hjkmnp-z]{26}$" } },
            "o": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$" },
            "h": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "d": {
      "type": "object",
      "patternProperties": {
        "^.+$": { "type": "string", "pattern": "^cx:(devmsg|device_message):[0-9a-hjkmnp-z]{26}$" }
      },
      "additionalProperties": false
    },
    "x": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
