{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/event-envelope.schema.json",
  "title": "Contrix Event Envelope",
  "type": "object",
  "required": [
    "event_id", "kind", "space_id", "space_version", "actor_id", "actor_seq", "created_at",
    "hlc", "prev_refs", "auth_refs", "content", "proofs"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^cx:(evt|event):[0-9a-hjkmnp-z]{26}$" },
    "kind": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "schema": { "const": "cx.schema.event.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "space_version": { "type": "string", "pattern": "^\\d+$" },
    "actor_id": { "$ref": "#/$defs/did" },
    "actor_seq": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "hlc": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$" },
    "prev_refs": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } },
    "auth_refs": { "type": "array", "items": { "type": "string", "pattern": "^cx:(evt|event|grant|policy):[0-9a-hjkmnp-z]{26}$" } },
    "redacts": { "$ref": "#/$defs/eventRef" },
    "content": { "type": "object" },
    "unsigned": { "type": "object" },
    "proofs": { "type": "array", "items": { "$ref": "#/$defs/proof" }, "minItems": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "cx.field_position.move" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/field_position_move_content" } }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "cx.container.move_item" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/container_move_item_content" } }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "cx.field_position.reorder" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/field_position_reorder_content" } }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "cx.container.rebalance" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/container_rebalance_content" } }
      }
    }
  ],
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rank": { "type": "string", "pattern": "^[0-9A-Za-z]{1,128}$" },
    "entity_id": { "type": "string", "pattern": "^cx:entity:[0-9a-hjkmnp-z]{26}$" },
    "view_id": { "type": "string", "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$" },
    "relation_id": { "type": "string", "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$" },
    "field_path": { "type": "string", "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$" },
    "field_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "eventRef": { "type": "string", "pattern": "^cx:(evt|event|operation):[0-9a-hjkmnp-z]{26}$" },
    "field_position_move_content": {
      "type": "object",
      "required": ["entity_id", "view_id", "group_by", "to_value", "rank"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "view_id": { "$ref": "#/$defs/view_id" },
        "group_by": { "$ref": "#/$defs/field_path" },
        "to_value": { "$ref": "#/$defs/field_value" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/field_value" },
            "rank": { "$ref": "#/$defs/rank" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "field_position_reorder_content": {
      "type": "object",
      "required": ["entity_id", "view_id", "group_by", "rank"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "view_id": { "$ref": "#/$defs/view_id" },
        "group_by": { "$ref": "#/$defs/field_path" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/field_value" },
            "rank": { "$ref": "#/$defs/rank" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "container_move_item_content": {
      "type": "object",
      "required": ["scope_container_id", "relation_kind", "entity_id", "to_container_id", "rank"],
      "properties": {
        "scope_container_id": { "$ref": "#/$defs/entity_id" },
        "relation_kind": { "type": "string", "minLength": 1 },
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "from_container_id": { "$ref": "#/$defs/entity_id" },
        "to_container_id": { "$ref": "#/$defs/entity_id" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "container_id": { "$ref": "#/$defs/entity_id" },
            "rank": { "$ref": "#/$defs/rank" },
            "relation_id": { "$ref": "#/$defs/relation_id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "container_rebalance_content": {
      "type": "object",
      "required": ["scope_container_id", "container_id", "relation_kind", "expected_state_hash", "assignments"],
      "properties": {
        "scope_container_id": { "$ref": "#/$defs/entity_id" },
        "container_id": { "$ref": "#/$defs/entity_id" },
        "relation_kind": { "type": "string", "minLength": 1 },
        "expected_state_hash": { "$ref": "#/$defs/hash" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["entity_id", "relation_id", "rank"],
            "properties": {
              "entity_id": { "$ref": "#/$defs/entity_id" },
              "relation_id": { "$ref": "#/$defs/relation_id" },
              "rank": { "$ref": "#/$defs/rank" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["kind", "alg", "verification_method", "payload_hash", "created_at", "jws"],
      "properties": {
        "kind": { "const": "detached_jws" },
        "alg": { "type": "string", "enum": ["EdDSA", "ES256", "ES384", "ES512"] },
        "verification_method": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+(#.+)?$" },
        "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "domain": { "type": "string" },
        "audience": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "jws": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
