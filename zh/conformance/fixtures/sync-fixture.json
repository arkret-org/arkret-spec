            "groups": [
              {
                "key": "review",
                "title": "Review",
                "source": {
                  "model": "field_value",
                  "field": "fields.status",
                  "value": "review"
                },
                "items": [
                  {
                    "entity": {
                      "id": "cx:entity:01js0tv0000000000000000000",
                      "entity_type": "task",
                      "facets": ["stateful", "rankable", "renderable"],
                      "title": "Visible task"
                    },
                    "position": {
                      "model": "field_value",
                      "container_id": "review",
                      "rank": "F"
                    }
                  }
                ],
                "next_cursor": null,
                "limited": false
              }
            ]
          },
          "rejected_response_fragments": [
            {
              "reason": "hidden_count_policy=omit forbids visible or canonical count exposure",
              "column_key": "review",
              "total_estimate": 1
            },
            {
              "reason": "hidden_count_policy=omit cannot expose canonical hidden membership",
              "column_key": "review",
              "total_estimate": 2
            }
          ]
        },
        {
          "name": "authorized_estimate",
          "hidden_count_policy": "authorized_estimate",
          "allowed_response": {
            "projection": "collection",
            "preset": "kanban",
            "view_id": "cx:view:01js0vw0000000000000000000",
            "frontier": {
              "state_hash": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
            },
            "groups": [
              {
                "key": "review",
                "title": "Review",
                "source": {
                  "model": "field_value",
                  "field": "fields.status",
                  "value": "review"
                },
                "items": [
                  {
                    "entity": {
                      "id": "cx:entity:01js0tv0000000000000000000",
                      "entity_type": "task",
                      "facets": ["stateful", "rankable", "renderable"],
                      "title": "Visible task"
                    },
                    "position": {
                      "model": "field_value",
                      "container_id": "review",
                      "rank": "F"
                    }
                  }
                ],
                "next_cursor": null,
                "limited": false,
                "total_estimate": 1
              }
            ]
          },
          "rejected_response_fragments": [
            {
              "reason": "authorized_estimate is still visibility-trimmed unless separate aggregate policy grants hidden counts",
              "column_key": "review",
              "total_estimate": 2
            }
          ]
        },
        {
          "name": "authorized_exact",
          "hidden_count_policy": "authorized_exact",
          "allowed_response": {
            "projection": "collection",
            "preset": "kanban",
            "view_id": "cx:view:01js0vw0000000000000000000",
            "frontier": {
              "state_hash": "sha256:4444444444444444444444444444444444444444444444444444444444444444"
            },
            "groups": [
              {
                "key": "review",
                "title": "Review",
                "source": {
                  "model": "field_value",
                  "field": "fields.status",
                  "value": "review"
                },
                "items": [
                  {
                    "entity": {
                      "id": "cx:entity:01js0tv0000000000000000000",
                      "entity_type": "task",
                      "facets": ["stateful", "rankable", "renderable"],
                      "title": "Visible task"
                    },
                    "position": {
                      "model": "field_value",
                      "container_id": "review",
                      "rank": "F"
                    }
                  }
                ],
                "next_cursor": null,
                "limited": false,
                "total_estimate": 1
              }
            ]
          },
          "rejected_response_fragments": [
            {
              "reason": "authorized_exact is exact over authorized visible cards, not hidden canonical membership",
              "column_key": "review",
              "total_estimate": 2
            }
          ]
        }
      ],
      "assertions": [
        "each policy case view validates after applying hidden_count_policy to input.base_view.collection.grouping",
        "each allowed_response validates as CollectionProjectionResponse with preset=kanban",
        "each allowed_response.groups[review].items contains only visible_entities",
        "omit case must not return total_estimate",
        "authorized_estimate and authorized_exact may return only visibility-trimmed counts unless separate aggregate policy grants hidden counts",
        "cursor shape and error behavior must not reveal hidden_entities"
      ]
    },
