{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/blob.schema.json",
  "title": "Contrix Blob Metadata",
  "type": "object",
  "required": ["blob_ref", "type", "sha256", "size", "media_type", "created_by", "created_at"],
  "properties": {
    "blob_ref": { "type": "string", "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|sha256:[0-9a-f]{64})$" },
    "type": { "const": "blob" },
    "schema": { "const": "cx.schema.blob.v1" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
    "filename": { "type": "string" },
    "encryption": { "$ref": "./encrypted-envelope.schema.json" },
    "thumbnail_ref": { "type": "string", "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|sha256:[0-9a-f]{64})$" },
    "created_by": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": true
}
