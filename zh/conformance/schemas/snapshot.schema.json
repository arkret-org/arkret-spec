{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/snapshot.schema.json",
  "title": "Contrix Snapshot Manifest",
  "type": "object",
  "required": ["snapshot_ref", "space_id", "state_hash", "frontier", "chunks", "signature"],
  "properties": {
    "snapshot_ref": { "type": "string", "pattern": "^cx:snapshot:[0-9a-hjkmnp-z]{26}$" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "state_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "frontier": {
      "type": "object",
      "required": ["events", "timeline_hlc"],
      "properties": {
        "events": { "type": "array", "items": { "type": "string", "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$" } },
        "timeline_hlc": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{8}$" }
      },
      "additionalProperties": true
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_ref", "sha256", "size_bytes"],
        "properties": {
          "chunk_ref": { "type": "string", "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|sha256:[0-9a-f]{64})$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "signature": { "$ref": "./event-schema.json#/$defs/proof" }
  },
  "additionalProperties": true
}
