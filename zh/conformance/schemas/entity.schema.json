{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/entity.schema.json",
  "title": "Contrix Entity",
  "type": "object",
  "required": ["id", "type", "space_id", "entity_type", "created_by", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^cx:entity:[0-9a-hjkmnp-z]{26}$" },
    "type": { "const": "entity" },
    "schema": { "const": "cx.schema.entity.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "entity_type": { "type": "string" },
    "facets": { "$ref": "#/$defs/entity_facets" },
    "title": { "type": "string", "maxLength": 512 },
    "content": { "type": "object" },
    "fields": { "type": "object" },
    "state": { "type": "string", "enum": ["active", "archived", "deleted", "redacted"] },
    "version": { "type": "integer", "minimum": 0 },
    "created_by": { "$ref": "#/$defs/did" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_by": { "$ref": "#/$defs/did" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "entity_type": { "type": "string", "minLength": 1 },
    "facet_name": {
      "type": "string",
      "enum": [
        "container", "replyable", "schedulable", "assignable", "stateful",
        "rankable", "reviewable", "notifiable", "documentable", "renderable"
      ]
    },
    "facet_selector": {
      "type": "object",
      "properties": {
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/facet_name" },
          "minItems": 1,
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": { "$ref": "#/$defs/facet_name" },
          "minItems": 1,
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": { "$ref": "#/$defs/facet_name" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "relation_kind": { "type": "string", "minLength": 1 },
    "field_path": { "type": "string", "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$" },
    "renderer": {
      "type": "string",
      "enum": ["card", "row", "tile", "compact", "badge", "message", "section", "node"]
    },
    "container_facet": {
      "type": "object",
      "required": ["relation_kinds"],
      "properties": {
        "child_entity_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_type" },
          "minItems": 1
        },
        "child_facets": {
          "$ref": "#/$defs/facet_selector"
        },
        "relation_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation_kind" },
          "minItems": 1,
          "default": ["contains"]
        },
        "ordering": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["none", "field_rank", "relation_rank"], "default": "relation_rank" },
            "rank_field": { "$ref": "#/$defs/field_path" },
            "exclusive_scope": { "type": "string", "enum": ["none", "per_container", "per_root"], "default": "per_root" }
          },
          "additionalProperties": false
        },
        "allowed_renderers": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderer" },
          "minItems": 1
        },
        "count_policy": {
          "type": "string",
          "enum": ["omit", "authorized_estimate", "authorized_exact"],
          "default": "omit"
        }
      },
      "anyOf": [
        { "required": ["child_facets"] },
        { "required": ["child_entity_types"] }
      ],
      "additionalProperties": false
    },
    "replyable_facet": {
      "type": "object",
      "required": ["reply_relation_kind", "time_field"],
      "properties": {
        "reply_entity_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_type" },
          "minItems": 1
        },
        "reply_facets": {
          "$ref": "#/$defs/facet_selector"
        },
        "reply_relation_kind": { "$ref": "#/$defs/relation_kind", "default": "replies_to" },
        "thread_relation_kind": { "$ref": "#/$defs/relation_kind" },
        "time_field": { "$ref": "#/$defs/field_path" },
        "ordering": { "type": "string", "enum": ["asc", "desc", "threaded"], "default": "asc" },
        "redaction_policy": { "type": "string", "enum": ["tombstone", "hide"], "default": "tombstone" },
        "moderation_policy_ref": { "type": "string", "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$" }
      },
      "anyOf": [
        { "required": ["reply_facets"] },
        { "required": ["reply_entity_types"] }
      ],
      "additionalProperties": false
    },
    "schedulable_facet": {
      "type": "object",
      "required": ["start_field"],
      "properties": {
        "start_field": { "$ref": "#/$defs/field_path" },
        "end_field": { "$ref": "#/$defs/field_path" },
        "timezone_field": { "$ref": "#/$defs/field_path" },
        "recurrence_field": { "$ref": "#/$defs/field_path" },
        "dependency_relation_kinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation_kind" }
        }
      },
      "additionalProperties": false
    },
    "assignable_facet": {
      "type": "object",
      "properties": {
        "assignee_relation_kind": { "$ref": "#/$defs/relation_kind", "default": "assigned_to" },
        "assignee_field": { "$ref": "#/$defs/field_path" },
        "allowed_assignee_kinds": {
          "type": "array",
          "items": { "type": "string", "enum": ["actor", "actor_profile", "team", "agent"] },
          "minItems": 1
        }
      },
      "anyOf": [
        { "required": ["assignee_relation_kind"] },
        { "required": ["assignee_field"] }
      ],
      "additionalProperties": false
    },
    "stateful_facet": {
      "type": "object",
      "required": ["state_field", "states"],
      "properties": {
        "state_field": { "$ref": "#/$defs/field_path" },
        "states": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "transition_policy": { "type": "string", "enum": ["free", "declared_edges", "policy_checked"], "default": "policy_checked" }
      },
      "additionalProperties": false
    },
    "rankable_facet": {
      "type": "object",
      "required": ["rank_field"],
      "properties": {
        "rank_field": { "$ref": "#/$defs/field_path" },
        "rank_profile": { "type": "string", "enum": ["lexorank-v1"], "default": "lexorank-v1" },
        "collision_policy": { "type": "string", "enum": ["hlc_actor_tiebreak", "reject"], "default": "hlc_actor_tiebreak" }
      },
      "additionalProperties": false
    },
    "reviewable_facet": {
      "type": "object",
      "required": ["review_state_field"],
      "properties": {
        "review_state_field": { "$ref": "#/$defs/field_path" },
        "reviewer_relation_kind": { "$ref": "#/$defs/relation_kind", "default": "assigned_to" },
        "priority_field": { "$ref": "#/$defs/field_path" },
        "decision_event_kinds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" }
        }
      },
      "additionalProperties": false
    },
    "notifiable_facet": {
      "type": "object",
      "properties": {
        "notification_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "read_state_policy": { "type": "string", "enum": ["none", "per_actor", "per_device"], "default": "per_actor" }
      },
      "additionalProperties": false
    },
    "documentable_facet": {
      "type": "object",
      "properties": {
        "section_relation_kind": { "$ref": "#/$defs/relation_kind", "default": "contains" },
        "section_order_field": { "$ref": "#/$defs/field_path" },
        "body_field": { "$ref": "#/$defs/field_path" },
        "render_mode": { "type": "string", "enum": ["plain", "markdown", "rich_blocks"], "default": "rich_blocks" }
      },
      "additionalProperties": false
    },
    "renderable_facet": {
      "type": "object",
      "required": ["renderers"],
      "properties": {
        "renderers": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderer" },
          "minItems": 1
        },
        "title_field": { "$ref": "#/$defs/field_path" },
        "summary_field": { "$ref": "#/$defs/field_path" },
        "media_field": { "$ref": "#/$defs/field_path" }
      },
      "additionalProperties": false
    },
    "entity_facets": {
      "type": "object",
      "properties": {
        "container": { "$ref": "#/$defs/container_facet" },
        "replyable": { "$ref": "#/$defs/replyable_facet" },
        "schedulable": { "$ref": "#/$defs/schedulable_facet" },
        "assignable": { "$ref": "#/$defs/assignable_facet" },
        "stateful": { "$ref": "#/$defs/stateful_facet" },
        "rankable": { "$ref": "#/$defs/rankable_facet" },
        "reviewable": { "$ref": "#/$defs/reviewable_facet" },
        "notifiable": { "$ref": "#/$defs/notifiable_facet" },
        "documentable": { "$ref": "#/$defs/documentable_facet" },
        "renderable": { "$ref": "#/$defs/renderable_facet" }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
