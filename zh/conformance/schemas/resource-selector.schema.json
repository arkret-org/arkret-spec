{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/resource-selector.schema.json",
  "title": "Contrix Resource Selector",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "space",
        "flow",
        "message",
        "morph",
        "object",
        "relation",
        "view",
        "event",
        "actor",
        "schema",
        "policy",
        "invite",
        "notification",
        "read_marker",
        "blob",
        "*"
      ]
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "object_type": {
      "type": "string"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^cx:(space|flow|message|morph|relation|view|event|policy|invite|blob):[0-9a-hjkmnp-z]{26}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "board_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "list_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^cx:message:[0-9a-hjkmnp-z]{26}$"
    },
    "morph_id": {
      "type": "string",
      "pattern": "^cx:morph:[0-9a-hjkmnp-z]{26}$"
    },
    "morph_type": {
      "type": "string"
    },
    "relation_kind": {
      "type": "string"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$"
    },
    "view_id": {
      "type": "string",
      "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "schema_ref": {
      "type": "string"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "invite_id": {
      "type": "string",
      "pattern": "^cx:invite:[0-9a-hjkmnp-z]{26}$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|sha256:[0-9a-f]{64})$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "exact",
        "subtree",
        "children",
        "space_wide"
      ]
    }
  },
  "additionalProperties": false
}
