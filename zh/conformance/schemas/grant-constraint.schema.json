{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/grant-constraint.schema.json",
  "title": "Contrix Grant Constraint",
  "type": "object",
  "required": [
    "constraint_type",
    "effect"
  ],
  "properties": {
    "constraint_type": {
      "type": "string",
      "enum": [
        "temporal",
        "field_access",
        "type_restriction",
        "scope_limitation",
        "delegation_control",
        "rate_limiting",
        "approval_workflow",
        "claim_based",
        "accountability",
        "encryption_requirement",
        "container_move",
        "visibility_control",
        "resource_limit",
        "edit_window"
      ]
    },
    "effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "not_before": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "fields_write_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_write_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_type_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_type_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "space_kind_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collaboration",
          "personal",
          "project",
          "organization",
          "enclave",
          "board",
          "list"
        ]
      },
      "uniqueItems": true
    },
    "space_kind_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collaboration",
          "personal",
          "project",
          "organization",
          "enclave",
          "board",
          "list"
        ]
      },
      "uniqueItems": true
    },
    "morph_type_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "morph_type_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facet_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      },
      "uniqueItems": true
    },
    "facet_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      },
      "uniqueItems": true
    },
    "allowed_view_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$"
      }
    },
    "allowed_flow_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "denied_flow_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "allowed_space_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "denied_space_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "allowed_view_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_view_renderers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relation_kind_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_from_container_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:(space|flow|morph):[0-9a-hjkmnp-z]{26}$"
      }
    },
    "allowed_to_container_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:(space|flow|morph):[0-9a-hjkmnp-z]{26}$"
      }
    },
    "wip_limit_override": {
      "type": "boolean",
      "default": false
    },
    "denied_view_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "denied_view_renderers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "synthesis",
          "discussion"
        ]
      },
      "uniqueItems": true
    },
    "denied_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "synthesis",
          "discussion"
        ]
      },
      "uniqueItems": true
    },
    "visibility_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "world_readable",
          "shared",
          "invited",
          "joined",
          "restricted"
        ]
      },
      "uniqueItems": true
    },
    "deny_redacted_history": {
      "type": "boolean"
    },
    "blob_max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_total_blob_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "message_edit_window": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "message_redact_window": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "allow_redact_after_window": {
      "type": "boolean"
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "delegation_path": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "prohibit_subdelegation": {
      "type": "boolean"
    },
    "delegation_scope": {
      "type": "string",
      "enum": [
        "narrowing_only",
        "same_scope",
        "custom"
      ]
    },
    "allow_scope_expansion": {
      "type": "boolean"
    },
    "require_parent_reference": {
      "type": "boolean"
    },
    "max_operations": {
      "type": "integer",
      "minimum": 0
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "burst": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string"
    },
    "max_resources": {
      "type": "integer",
      "minimum": 0
    },
    "resource_type": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "before_commit",
        "proposal_then_approve",
        "after_commit_review"
      ]
    },
    "approval_actor_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "approval_relation": {
      "type": "string",
      "enum": [
        "responsible",
        "controller",
        "guardian",
        "space_admin",
        "custom"
      ]
    },
    "timeout": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "auto_reject_on_timeout": {
      "type": "boolean"
    },
    "proposal_morph_type": {
      "type": "string"
    },
    "approval_threshold": {
      "type": "string",
      "enum": [
        "majority",
        "unanimous",
        "quorum",
        "custom"
      ]
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "accountability_required": {
      "type": "boolean"
    },
    "guardian_approval_required": {
      "type": "boolean"
    },
    "controller_approval_required": {
      "type": "boolean"
    },
    "encryption_required": {
      "type": "boolean"
    },
    "key_rotation_period": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "max_key_age": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "require_key_backup": {
      "type": "boolean"
    },
    "approved_key_issuers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "requires_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_type",
          "issuer"
        ],
        "properties": {
          "claim_type": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
          },
          "organization": {
            "type": "string",
            "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
          },
          "status": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "trusted_claim_issuers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "claim_refresh_required": {
      "type": "boolean"
    },
    "claim_max_age": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    }
  },
  "additionalProperties": true
}
