{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/grant-constraint.schema.json",
  "title": "Contrix Grant Constraint",
  "type": "object",
  "required": ["constraint_type", "effect"],
  "properties": {
    "constraint_type": {
      "type": "string",
      "enum": [
        "temporal", "field_access", "type_restriction", "scope_limitation", "delegation_control",
        "rate_limiting", "approval_workflow", "claim_based", "accountability", "encryption_requirement",
        "container_move"
      ]
    },
    "effect": { "type": "string", "enum": ["allow", "deny", "quarantine", "require_review"] },
    "priority": { "type": "integer", "default": 0 },
    "not_before": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "fields_write_allow": { "type": "array", "items": { "type": "string" } },
    "fields_write_deny": { "type": "array", "items": { "type": "string" } },
    "object_type_allow": { "type": "array", "items": { "type": "string" } },
    "object_type_deny": { "type": "array", "items": { "type": "string" } },
    "morph_type_allow": { "type": "array", "items": { "type": "string" } },
    "morph_type_deny": { "type": "array", "items": { "type": "string" } },
    "memory_kind_allow": { "type": "array", "items": { "type": "string" } },
    "memory_kind_deny": { "type": "array", "items": { "type": "string" } },
    "facet_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container", "replyable", "schedulable", "assignable", "stateful",
          "rankable", "reviewable", "notifiable", "documentable", "renderable"
        ]
      },
      "uniqueItems": true
    },
    "facet_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container", "replyable", "schedulable", "assignable", "stateful",
          "rankable", "reviewable", "notifiable", "documentable", "renderable"
        ]
      },
      "uniqueItems": true
    },
    "allowed_view_refs": { "type": "array", "items": { "type": "string", "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$" } },
    "relation_kind_allow": { "type": "array", "items": { "type": "string" } },
    "allowed_from_container_refs": { "type": "array", "items": { "type": "string", "pattern": "^cx:(board|list|card|morph):[0-9a-hjkmnp-z]{26}$" } },
    "allowed_to_container_refs": { "type": "array", "items": { "type": "string", "pattern": "^cx:(board|list|card|morph):[0-9a-hjkmnp-z]{26}$" } },
    "wip_limit_override": { "type": "boolean", "default": false },
    "denied_view_kinds": { "type": "array", "items": { "type": "string" } },
    "max_delegation_depth": { "type": "integer", "minimum": 0 },
    "approval_required": { "type": "boolean" },
    "approval_mode": { "type": "string", "enum": ["before_commit", "proposal_then_approve", "after_commit_review"] },
    "approval_actor_refs": { "type": "array", "items": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" } },
    "approval_relation": { "type": "string", "enum": ["responsible", "controller", "guardian", "space_admin", "custom"] },
    "requires_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_type", "issuer"],
        "properties": {
          "claim_type": { "type": "string" },
          "issuer": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
          "organization": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
          "status": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
