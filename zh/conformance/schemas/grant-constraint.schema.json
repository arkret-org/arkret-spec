{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/grant-constraint.schema.json",
  "title": "Contrix Grant Constraint",
  "type": "object",
  "required": [
    "constraint_type",
    "effect"
  ],
  "properties": {
    "constraint_id": {
      "type": "string",
      "description": "Optional stable identifier of this constraint within the grant; used for diagnostics and overrides."
    },
    "constraint_type": {
      "type": "string",
      "enum": [
        "temporal",
        "field_access",
        "type_restriction",
        "scope_limitation",
        "delegation_control",
        "rate_limiting",
        "approval_workflow",
        "claim_based",
        "accountability",
        "encryption_requirement",
        "container_move",
        "visibility_control",
        "resource_limit",
        "edit_window",
        "device_session"
      ]
    },
    "effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "quarantine",
        "require_review"
      ]
    },
    "evaluation_class": {
      "type": "string",
      "enum": [
        "stateless",
        "grant_local",
        "space_state",
        "external"
      ],
      "description": "Cacheability/dependency hint for the authorization evaluator. stateless = pure function of (constraint, op, now); grant_local = depends on the grant object only; space_state = depends on Space frontier (membership, policy_version, etc.); external = depends on data outside the Space causal frontier (claim revocation status, rate-limit history counts, async approval). Each constraint_type has a canonical evaluation_class declared in constraint-schema.md §2.3; implementations MAY tighten (e.g. grant_local → stateless) but MUST NOT loosen (e.g. external as stateless). Auth evaluators SHOULD use this hint to gate fast-path caching."
    },
    "not_before": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "recurrence": {
      "type": "object",
      "description": "Recurrence rule for temporal constraints. Used by constraint-schema.md §3.1.",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "custom"
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "uniqueItems": true
        },
        "window_start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "window_end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "max_duration": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
      "description": "ISO 8601 duration."
    },
    "max_session_duration": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "inactivity_timeout": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "expires_after": {
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$",
      "description": "ISO 8601 duration; used by approval_workflow constraint instead of expires_after_ms."
    },
    "condition": {
      "type": "object",
      "description": "Conditional predicate for field_access and similar constraints. The `kind` value is a registered named condition from constraint-schema.md §4.1; unknown kinds MUST fail closed. Implementations MUST NOT introduce ad hoc string DSL predicates.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "object_is_owned_by_actor",
            "actor_is_assignee",
            "actor_is_responsible",
            "actor_is_guardian",
            "actor_is_controller",
            "object_in_actor_container",
            "object_is_unencrypted",
            "object_is_encrypted",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": true
    },
    "fields_write_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_write_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_read_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields_read_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitive_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sensitive_handling": {
      "type": "string",
      "enum": [
        "redact",
        "hash",
        "omit"
      ]
    },
    "object_type_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_type_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "space_kind_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collaboration",
          "board",
          "list"
        ]
      },
      "uniqueItems": true
    },
    "space_kind_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "collaboration",
          "board",
          "list"
        ]
      },
      "uniqueItems": true
    },
    "morph_type_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "morph_type_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facet_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      },
      "uniqueItems": true
    },
    "facet_deny": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "container",
          "replyable",
          "schedulable",
          "assignable",
          "stateful",
          "rankable",
          "reviewable",
          "notifiable",
          "documentable",
          "renderable"
        ]
      },
      "uniqueItems": true
    },
    "allowed_view_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$"
      }
    },
    "allowed_flow_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "denied_flow_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "allowed_space_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "denied_space_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
      },
      "uniqueItems": true
    },
    "allowed_view_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_view_renderers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relation_kind_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_from_container_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:(space|flow|morph):[0-9a-hjkmnp-z]{26}$"
      }
    },
    "allowed_to_container_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cx:(space|flow|morph):[0-9a-hjkmnp-z]{26}$"
      }
    },
    "wip_limit_override": {
      "type": "boolean",
      "default": false
    },
    "denied_view_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "denied_view_renderers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "denied_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "visibility_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "world_readable",
          "shared",
          "invited",
          "joined",
          "restricted"
        ]
      },
      "uniqueItems": true
    },
    "deny_redacted_history": {
      "type": "boolean"
    },
    "blob_max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_total_blob_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "message_edit_window": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "message_redact_window": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "allow_redact_after_window": {
      "type": "boolean"
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "delegation_path": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "prohibit_subdelegation": {
      "type": "boolean"
    },
    "delegation_scope": {
      "type": "string",
      "enum": [
        "narrowing_only",
        "same_scope",
        "custom"
      ]
    },
    "allow_scope_expansion": {
      "type": "boolean"
    },
    "require_parent_reference": {
      "type": "boolean"
    },
    "max_operations": {
      "type": "integer",
      "minimum": 0
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "burst": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string"
    },
    "max_resources": {
      "type": "integer",
      "minimum": 0
    },
    "resource_type": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "before_commit",
        "proposal_then_approve",
        "after_commit_review"
      ]
    },
    "approval_actor_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "approval_relation": {
      "type": "string",
      "enum": [
        "responsible",
        "controller",
        "guardian",
        "space_admin",
        "custom"
      ]
    },
    "timeout": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "auto_reject_on_timeout": {
      "type": "boolean"
    },
    "proposal_morph_type": {
      "type": "string"
    },
    "approval_threshold": {
      "type": "string",
      "enum": [
        "majority",
        "unanimous",
        "quorum",
        "custom"
      ]
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "accountability_required": {
      "type": "boolean"
    },
    "guardian_approval_required": {
      "type": "boolean"
    },
    "controller_approval_required": {
      "type": "boolean"
    },
    "encryption_required": {
      "type": "boolean"
    },
    "key_rotation_period": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "max_key_age": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "require_key_backup": {
      "type": "boolean"
    },
    "approved_key_issuers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "requires_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_type"
        ],
        "properties": {
          "claim_type": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
          },
          "trusted_issuers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
            },
            "uniqueItems": true
          },
          "subject_matches_actor": {
            "type": "boolean",
            "description": "If true, the credential subject DID MUST match the actor DID."
          },
          "value_constraints": {
            "type": "object",
            "description": "Per-field equality / membership constraints on credential claims.",
            "additionalProperties": true
          },
          "organization": {
            "type": "string",
            "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
          },
          "status": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "trusted_claim_issuers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
      }
    },
    "claim_refresh_required": {
      "type": "boolean"
    },
    "claim_max_age": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    }
  },
  "additionalProperties": true
}
