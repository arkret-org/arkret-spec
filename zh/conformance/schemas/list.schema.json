{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/list.schema.json",
  "title": "Contrix List",
  "type": "object",
  "required": ["id", "type", "schema", "space_id", "title", "created_by", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^cx:list:[0-9a-hjkmnp-z]{26}$" },
    "type": { "const": "list" },
    "schema": { "const": "cx.schema.list.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "board_id": { "type": "string", "pattern": "^cx:board:[0-9a-hjkmnp-z]{26}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "summary": { "type": "string" },
    "rank": { "type": "string", "pattern": "^[0-9A-Za-z]{1,128}$" },
    "wip_limit": { "type": "integer", "minimum": 0 },
    "fields": { "type": "object" },
    "state": { "type": "string", "enum": ["active", "archived", "deleted"] },
    "created_by": { "$ref": "#/$defs/did" },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": true
}
