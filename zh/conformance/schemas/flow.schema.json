{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/flow.schema.json",
  "title": "Contrix Flow",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema",
    "space_id",
    "title",
    "branches",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "type": {
      "const": "flow"
    },
    "schema": {
      "const": "cx.schema.flow.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "brief": {
      "type": "string",
      "maxLength": 2048
    },
    "summary": {
      "type": "string",
      "maxLength": 8192
    },
    "body": {
      "$ref": "#/$defs/content_block"
    },
    "fields": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted",
        "redacted"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flow_branch"
      },
      "contains": {
        "type": "object",
        "required": [
          "is_primary"
        ],
        "properties": {
          "is_primary": {
            "const": true
          }
        }
      },
      "minContains": 0,
      "maxContains": 1,
      "uniqueItems": true
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_by": {
      "$ref": "#/$defs/did"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "content_type": {
      "type": "string",
      "pattern": "^(cx\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "type",
        "body"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/content_type"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        }
      },
      "additionalProperties": true
    },
    "branch_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "flow_branch": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/branch_name"
        },
        "is_primary": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "template": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "access": {
          "$ref": "#/$defs/branch_access"
        }
      },
      "additionalProperties": true
    },
    "branch_access": {
      "type": "object",
      "properties": {
        "membership": {
          "type": "string",
          "enum": [
            "inherit_flow",
            "inherit_space",
            "branch_scoped"
          ]
        },
        "permissions": {
          "type": "string",
          "enum": [
            "inherit_flow",
            "inherit_space",
            "branch_scoped"
          ]
        },
        "history_visibility": {
          "type": "string",
          "enum": [
            "world_readable",
            "shared",
            "invited",
            "joined",
            "restricted"
          ]
        },
        "e2ee": {
          "type": "string",
          "enum": [
            "inherit_space",
            "inherit_flow",
            "branch_scoped",
            "none"
          ]
        },
        "encryption_profile": {
          "type": "string",
          "enum": [
            "none",
            "mls_rfc9420",
            "external"
          ]
        },
        "membership_policy_ref": {
          "type": "string",
          "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
        },
        "fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
