{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/message.schema.json",
  "title": "Contrix Message",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema",
    "space_id",
    "flow_id",
    "branch",
    "content",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:message:[0-9a-hjkmnp-z]{26}$"
    },
    "type": {
      "const": "message"
    },
    "schema": {
      "const": "cx.schema.message.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Active branch name on the target Flow. v1 reducers only recognise 'discussion' for Message timeline; profiles MAY declare additional branch names carrying Message timelines but v1 interop SHOULD use 'discussion'."
    },
    "content": {
      "$ref": "#/$defs/content_block"
    },
    "fields": {
      "type": "object"
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "redacted": {
      "type": "boolean"
    }
  },
  "$defs": {
    "content_type": {
      "type": "string",
      "pattern": "^(cx\\.content\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*|[a-z0-9][a-z0-9_.-]*\\.[a-z0-9][a-z0-9_.-]*)$"
    },
    "content_block": {
      "type": "object",
      "required": [
        "type",
        "body"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/content_type"
        },
        "body": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "prosemirror_json"
          ]
        },
        "formatted_body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        },
        "reply_context": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^cx:(message|event):[0-9a-hjkmnp-z]{26}$"
            },
            "sender": {
              "$ref": "#/$defs/did"
            },
            "excerpt": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
