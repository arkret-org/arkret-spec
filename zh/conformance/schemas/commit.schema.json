{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/commit.schema.json",
  "title": "Contrix Repo Commit",
  "type": "object",
  "required": ["commit_id", "type", "repo_id", "author", "author_seq", "operations", "created_at", "proofs"],
  "properties": {
    "commit_id": { "type": "string", "pattern": "^cx:commit:[0-9a-hjkmnp-z]{26}$" },
    "type": { "const": "commit" },
    "schema": { "const": "cx.schema.commit.v1" },
    "repo_id": { "type": "string" },
    "author": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "author_seq": { "type": "integer", "minimum": 0 },
    "prev_commit": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operations": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "proofs": { "type": "array", "items": { "$ref": "./event-schema.json#/$defs/proof" }, "minItems": 1 }
  },
  "additionalProperties": true
}
