{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/space.schema.json",
  "title": "Contrix Space",
  "type": "object",
  "required": [
    "id",
    "type",
    "space_version",
    "title",
    "kind",
    "created_by_principal",
    "schema_refs",
    "default_discoverability",
    "default_join_rule",
    "history_visibility",
    "encryption_profile",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "type": {
      "const": "space"
    },
    "schema": {
      "const": "cx.schema.space.v1"
    },
    "space_version": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "kind": {
      "type": "string",
      "enum": [
        "collaboration",
        "personal",
        "project",
        "organization",
        "enclave",
        "board",
        "list"
      ]
    },
    "board_kind": {
      "type": "string",
      "enum": [
        "kanban",
        "scrum",
        "review_queue",
        "intake",
        "custom"
      ],
      "description": "Workflow sub-type; only meaningful when kind=board"
    },
    "default_view_id": {
      "type": "string",
      "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$",
      "description": "Default view for kind=board spaces"
    },
    "rank": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{1,128}$",
      "description": "Fractional-index rank within parent board space; only meaningful when kind=list"
    },
    "wip_limit": {
      "type": "integer",
      "minimum": 0,
      "description": "Work-in-progress limit; only meaningful when kind=list"
    },
    "created_by_principal": {
      "$ref": "#/$defs/did"
    },
    "owning_organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/did"
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "default_discoverability": {
      "type": "string",
      "enum": [
        "public",
        "listed",
        "restricted",
        "unlisted",
        "invite_only",
        "secret"
      ]
    },
    "default_join_rule": {
      "type": "string",
      "enum": [
        "public",
        "invite",
        "knock",
        "restricted",
        "knock_restricted",
        "closed"
      ]
    },
    "history_visibility": {
      "type": "string",
      "enum": [
        "world_readable",
        "shared",
        "invited",
        "joined",
        "restricted"
      ]
    },
    "encryption_profile": {
      "type": "string",
      "enum": [
        "none",
        "mls_rfc9420",
        "external"
      ]
    },
    "federation_policy": {
      "type": "string",
      "enum": [
        "open",
        "restricted",
        "closed",
        "quarantine"
      ]
    },
    "retention_policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "avatar_blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|sha256:[0-9a-f]{64})$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
