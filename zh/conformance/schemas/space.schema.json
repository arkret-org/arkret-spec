{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/space.schema.json",
  "title": "Contrix Space",
  "type": "object",
  "required": [
    "id",
    "schema",
    "space_version",
    "title",
    "kind",
    "created_by_principal",
    "schema_refs",
    "default_discoverability",
    "default_join_rule",
    "history_visibility",
    "encryption_profile",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.space.v1"
    },
    "space_version": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "kind": {
      "type": "string",
      "enum": [
        "collaboration",
        "board",
        "list"
      ],
      "description": "v1 standard Space kinds. 'personal'/'project'/'organization'/'enclave' were removed in v1. The first three's reducer behaviour was identical to 'collaboration'; 'enclave' was a high-assurance variant whose only normative difference (federation_policy MUST NOT be open) now lives on the security_class field. Encode product-level distinctions via Space.fields, schema_refs, labels, or security_class."
    },
    "security_class": {
      "type": "string",
      "enum": [
        "standard",
        "high_assurance"
      ],
      "description": "Optional security class. 'high_assurance' replaces v1's removed kind=enclave: it forbids federation_policy=open and SHOULD use stricter resolver/E2EE/audit defaults. Omitted = 'standard'."
    },
    "boundary_profile": {
      "type": "string",
      "enum": [
        "security_boundary",
        "container"
      ],
      "description": "Whether this Space forms an independent membership/policy/history/E2EE boundary. If omitted, board/list imply container and other standard kinds imply security_boundary."
    },
    "default_view_id": {
      "type": "string",
      "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$",
      "description": "Default view for kind=board spaces"
    },
    "rank": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{1,128}$",
      "description": "Fractional-index rank within parent board space; only meaningful when kind=list"
    },
    "wip_limit": {
      "type": "integer",
      "minimum": 0,
      "description": "Work-in-progress limit; only meaningful when kind=list"
    },
    "created_by_principal": {
      "$ref": "#/$defs/did"
    },
    "owning_organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/did"
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relation_profiles": {
      "type": "array",
      "description": "Optional Relation cardinality and conflict profiles declared by this Space schema/profile.",
      "items": {
        "type": "object",
        "required": [
          "relation_kind",
          "cardinality"
        ],
        "properties": {
          "relation_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "from_type": {
            "type": "string"
          },
          "to_type": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "space",
              "security_boundary",
              "board",
              "global"
            ],
            "default": "space"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one_to_one",
              "one_to_many",
              "many_to_one",
              "many_to_many"
            ]
          },
          "dedupe_key": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "max_to_per_from": {
            "type": "integer",
            "minimum": 1
          },
          "max_from_per_to": {
            "type": "integer",
            "minimum": 1
          },
          "multi_edge": {
            "type": "boolean"
          },
          "rank_field": {
            "type": "string"
          },
          "on_conflict": {
            "type": "string",
            "enum": [
              "reject",
              "close_previous",
              "deterministic_winner",
              "require_review"
            ],
            "default": "deterministic_winner"
          }
        },
        "additionalProperties": true
      }
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "default_discoverability": {
      "type": "string",
      "enum": [
        "public",
        "listed",
        "restricted",
        "unlisted",
        "invite_only",
        "secret"
      ]
    },
    "default_join_rule": {
      "type": "string",
      "enum": [
        "public",
        "invite",
        "knock",
        "restricted",
        "knock_restricted",
        "closed"
      ]
    },
    "history_visibility": {
      "type": "string",
      "enum": [
        "world_readable",
        "shared",
        "invited",
        "joined",
        "restricted"
      ]
    },
    "encryption_profile": {
      "type": "string",
      "enum": [
        "none",
        "mls_rfc9420",
        "external"
      ]
    },
    "federation_policy": {
      "type": "string",
      "enum": [
        "open",
        "restricted",
        "closed",
        "quarantine"
      ]
    },
    "retention_policy_ref": {
      "type": "string",
      "pattern": "^cx:policy:[0-9a-hjkmnp-z]{26}$"
    },
    "avatar_blob_ref": {
      "type": "string",
      "pattern": "^cx:blob:(?:[0-9a-hjkmnp-z]{26}|sha256:[0-9a-f]{64})$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "board",
              "list"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "boundary_profile": {
            "const": "container"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collaboration"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "boundary_profile": {
            "const": "security_boundary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "security_class": {
            "const": "high_assurance"
          }
        },
        "required": [
          "security_class"
        ]
      },
      "then": {
        "properties": {
          "federation_policy": {
            "enum": [
              "closed",
              "restricted",
              "quarantine"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
