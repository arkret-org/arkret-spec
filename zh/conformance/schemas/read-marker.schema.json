{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/read-marker.schema.json",
  "title": "Contrix Read Marker",
  "type": "object",
  "required": ["id", "type", "actor_id", "space_id", "scope", "event_id", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "read_marker" },
    "schema": { "const": "cx.schema.read_marker.v1" },
    "actor_id": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "scope": { "type": "string", "enum": ["space", "subject", "room", "thread", "view", "card", "message", "morph"] },
    "scope_id": { "type": "string" },
    "event_id": { "type": "string", "pattern": "^cx:event:[0-9a-hjkmnp-z]{26}$|^sha256:[0-9a-f]{64}$" },
    "timeline_order_key": { "type": "object" },
    "updated_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": true
}
