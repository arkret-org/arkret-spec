{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/operation.schema.json",
  "title": "Contrix Canonical Operation",
  "type": "object",
  "required": ["operation_id", "type", "operation_type", "space_id", "object_type", "payload", "created_at"],
  "properties": {
    "operation_id": { "type": "string", "pattern": "^cx:operation:[0-9a-hjkmnp-z]{26}$|^sha256:[0-9a-f]{64}$" },
    "type": { "const": "operation" },
    "schema": { "const": "cx.schema.operation.v1" },
    "operation_type": {
      "type": "string",
      "enum": ["create", "update", "delete", "redact", "grant", "revoke", "snapshot_ref", "move", "reorder", "rebalance"]
    },
    "semantic_kind": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "object_id": { "type": "string" },
    "object_type": { "type": "string" },
    "payload": { "type": "object" },
    "idempotency_key": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.task.move" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "move" },
          "object_type": { "const": "entity" },
          "payload": { "$ref": "#/$defs/task_move_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.field_position.move" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "move" },
          "object_type": { "const": "entity" },
          "payload": { "$ref": "#/$defs/task_move_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.relation.move" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "move" },
          "object_type": { "const": "relation" },
          "payload": { "$ref": "#/$defs/relation_move_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.container.move_item" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "move" },
          "object_type": { "const": "relation" },
          "payload": { "$ref": "#/$defs/relation_move_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.task.reorder" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "reorder" },
          "object_type": { "const": "entity" },
          "payload": { "$ref": "#/$defs/task_reorder_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.field_position.reorder" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "reorder" },
          "object_type": { "const": "entity" },
          "payload": { "$ref": "#/$defs/task_reorder_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.relation.rebalance" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "rebalance" },
          "object_type": { "const": "relation" },
          "payload": { "$ref": "#/$defs/relation_rebalance_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "semantic_kind": { "const": "cx.container.rebalance" } },
        "required": ["semantic_kind"]
      },
      "then": {
        "properties": {
          "operation_type": { "const": "rebalance" },
          "object_type": { "const": "relation" },
          "payload": { "$ref": "#/$defs/relation_rebalance_payload" }
        }
      }
    },
    {
      "if": {
        "properties": { "operation_type": { "const": "move" } },
        "required": ["operation_type"]
      },
      "then": {
        "required": ["semantic_kind"],
        "properties": {
          "semantic_kind": {
            "enum": ["cx.field_position.move", "cx.container.move_item", "cx.task.move", "cx.relation.move"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation_type": { "const": "reorder" } },
        "required": ["operation_type"]
      },
      "then": {
        "required": ["semantic_kind"],
        "properties": {
          "semantic_kind": { "enum": ["cx.field_position.reorder", "cx.task.reorder"] }
        }
      }
    },
    {
      "if": {
        "properties": { "operation_type": { "const": "rebalance" } },
        "required": ["operation_type"]
      },
      "then": {
        "required": ["semantic_kind"],
        "properties": {
          "semantic_kind": { "enum": ["cx.container.rebalance", "cx.relation.rebalance"] }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rank": { "type": "string", "pattern": "^[0-9A-Za-z]{1,128}$" },
    "entity_id": { "type": "string", "pattern": "^cx:entity:[0-9a-hjkmnp-z]{26}$" },
    "view_id": { "type": "string", "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$" },
    "relation_id": { "type": "string", "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$" },
    "field_path": { "type": "string", "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)*$" },
    "field_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "task_move_payload": {
      "type": "object",
      "required": ["entity_id", "view_id", "group_by", "to_value", "rank"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "view_id": { "$ref": "#/$defs/view_id" },
        "group_by": { "$ref": "#/$defs/field_path" },
        "to_value": { "$ref": "#/$defs/field_value" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/field_value" },
            "rank": { "$ref": "#/$defs/rank" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "task_reorder_payload": {
      "type": "object",
      "required": ["entity_id", "view_id", "group_by", "rank"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "view_id": { "$ref": "#/$defs/view_id" },
        "group_by": { "$ref": "#/$defs/field_path" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "value": { "$ref": "#/$defs/field_value" },
            "rank": { "$ref": "#/$defs/rank" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "relation_move_payload": {
      "type": "object",
      "required": ["scope_container_id", "relation_kind", "entity_id", "to_container_id", "rank"],
      "properties": {
        "scope_container_id": { "$ref": "#/$defs/entity_id" },
        "relation_kind": { "type": "string", "minLength": 1 },
        "entity_id": { "$ref": "#/$defs/entity_id" },
        "from_container_id": { "$ref": "#/$defs/entity_id" },
        "to_container_id": { "$ref": "#/$defs/entity_id" },
        "rank": { "$ref": "#/$defs/rank" },
        "expected_position": {
          "type": "object",
          "properties": {
            "container_id": { "$ref": "#/$defs/entity_id" },
            "rank": { "$ref": "#/$defs/rank" },
            "relation_id": { "$ref": "#/$defs/relation_id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "relation_rebalance_payload": {
      "type": "object",
      "required": ["scope_container_id", "container_id", "relation_kind", "expected_state_hash", "assignments"],
      "properties": {
        "scope_container_id": { "$ref": "#/$defs/entity_id" },
        "container_id": { "$ref": "#/$defs/entity_id" },
        "relation_kind": { "type": "string", "minLength": 1 },
        "expected_state_hash": { "$ref": "#/$defs/hash" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["entity_id", "relation_id", "rank"],
            "properties": {
              "entity_id": { "$ref": "#/$defs/entity_id" },
              "relation_id": { "$ref": "#/$defs/relation_id" },
              "rank": { "$ref": "#/$defs/rank" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
