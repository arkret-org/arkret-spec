{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/operation.schema.json",
  "title": "Contrix Canonical Operation",
  "type": "object",
  "required": [
    "id",
    "action_id",
    "space_id",
    "payload",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:operation:[0-9a-hjkmnp-z]{26}$|^sha256:[0-9a-f]{64}$"
    },
    "schema": {
      "const": "cx.schema.operation.v1"
    },
    "action_id": {
      "type": "string",
      "pattern": "^cx\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Standard event kind that this operation will produce. action_id alone determines the wire shape; the prior operation_type and object_type fields were derivable from action_id and have been removed."
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "object_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "cx.flow.move"
          }
        },
        "required": [
          "action_id"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/flow_move_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "cx.flow.reorder"
          }
        },
        "required": [
          "action_id"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/flow_reorder_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "rank": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{1,128}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^cx:flow:[0-9a-hjkmnp-z]{26}$"
    },
    "object_ref": {
      "type": "string",
      "pattern": "^(cx:(space|flow|message|morph|relation|view):[0-9a-hjkmnp-z]{26}|did:.+)$"
    },
    "board_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "list_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$"
    },
    "flow_move_payload": {
      "type": "object",
      "required": [
        "board_id",
        "flow_id",
        "to_list_id",
        "rank"
      ],
      "properties": {
        "board_id": {
          "$ref": "#/$defs/board_id"
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "from_list_id": {
          "$ref": "#/$defs/list_id"
        },
        "to_list_id": {
          "$ref": "#/$defs/list_id"
        },
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "expected_position": {
          "type": "object",
          "properties": {
            "list_id": {
              "$ref": "#/$defs/list_id"
            },
            "rank": {
              "$ref": "#/$defs/rank"
            },
            "relation_id": {
              "$ref": "#/$defs/relation_id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "flow_reorder_payload": {
      "type": "object",
      "required": [
        "board_id",
        "flow_id",
        "list_id",
        "rank"
      ],
      "properties": {
        "board_id": {
          "$ref": "#/$defs/board_id"
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "list_id": {
          "$ref": "#/$defs/list_id"
        },
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "expected_position": {
          "type": "object",
          "properties": {
            "rank": {
              "$ref": "#/$defs/rank"
            },
            "relation_id": {
              "$ref": "#/$defs/relation_id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
