{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/relation.schema.json",
  "title": "Contrix Relation",
  "type": "object",
  "required": [
    "id",
    "schema",
    "space_id",
    "relation_kind",
    "from_ref",
    "to_ref",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cx:relation:[0-9a-hjkmnp-z]{26}$"
    },
    "schema": {
      "const": "cx.schema.relation.v1"
    },
    "space_id": {
      "type": "string",
      "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$"
    },
    "relation_kind": {
      "type": "string"
    },
    "from_ref": {
      "$ref": "#/$defs/ref"
    },
    "to_ref": {
      "$ref": "#/$defs/ref"
    },
    "fields": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "redacted"
      ]
    },
    "created_by": {
      "$ref": "#/$defs/did"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^(cx:(space|actor_profile|flow|space|message|morph|relation|event|view):[0-9a-hjkmnp-z]{26}|did:.+)$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": true
}
