{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/mimi-interop.schema.json",
  "title": "Contrix MIMI Interoperability",
  "description": "Provider directory, room binding, and content mapping receipt objects for cx.profile.mimi_interop.v1.",
  "anyOf": [
    { "$ref": "#/$defs/provider_directory" },
    { "$ref": "#/$defs/room_binding" },
    { "$ref": "#/$defs/content_mapping_receipt" }
  ],
  "$defs": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$"
    },
    "mimi_uri": {
      "type": "string",
      "pattern": "^mimi://[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[A-Za-z0-9_+\\-/=:.]{32,}$"
    },
    "provider_directory": {
      "type": "object",
      "required": ["service_type", "supported_profiles", "mimi"],
      "properties": {
        "schema": { "const": "cx.schema.mimi_interop.v1" },
        "service_did": { "$ref": "#/$defs/did" },
        "service_type": { "const": "mimi_provider_facade" },
        "supported_profiles": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "cx.profile.mimi_interop.v1" }
        },
        "mimi": {
          "type": "object",
          "required": ["protocol_draft", "content_draft", "base_url", "provider_id", "features"],
          "properties": {
            "protocol_draft": { "const": "draft-ietf-mimi-protocol-06" },
            "content_draft": { "const": "draft-ietf-mimi-content-08" },
            "room_policy_draft": { "const": "draft-ietf-mimi-room-policy-03" },
            "identifier_draft": { "const": "draft-kohbrok-mimi-identifiers-01" },
            "base_url": { "type": "string", "format": "uri" },
            "provider_id": { "$ref": "#/$defs/mimi_uri" },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "key_material",
                  "room_update",
                  "notify",
                  "submit_message",
                  "group_info",
                  "consent",
                  "identifier_query",
                  "report_abuse",
                  "proxy_download"
                ]
              },
              "uniqueItems": true
            },
            "mls_cipher_suites": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "content_profiles": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "application/mimi-content",
                  "text/plain;charset=utf-8",
                  "text/markdown;variant=GFM-MIMI",
                  "application/vnd.contrix.content+json"
                ]
              },
              "uniqueItems": true
            },
            "room_policy_components": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        },
        "proof": { "type": "object" }
      },
      "additionalProperties": true
    },
    "room_binding": {
      "type": "object",
      "required": ["kind", "state_key", "content"],
      "properties": {
        "schema": { "const": "cx.schema.mimi_interop.v1" },
        "kind": { "const": "cx.mimi.room_binding" },
        "state_key": { "$ref": "#/$defs/mimi_uri" },
        "content": {
          "type": "object",
          "required": ["profile", "mimi_room_uri", "binding_scope", "hub_provider", "local_provider_role"],
          "properties": {
            "profile": { "const": "cx.profile.mimi_interop.v1" },
            "mimi_room_uri": { "$ref": "#/$defs/mimi_uri" },
            "binding_scope": {
              "type": "object",
              "required": ["space_id", "room_id"],
              "properties": {
                "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
                "room_id": { "type": "string", "pattern": "^cx:room:[0-9a-hjkmnp-z]{26}$" }
              },
              "additionalProperties": true
            },
            "hub_provider": { "$ref": "#/$defs/did" },
            "local_provider_role": { "type": "string", "enum": ["hub", "follower", "observer"] },
            "mls_group_id": { "type": "string" },
            "policy_root": { "$ref": "#/$defs/hash" },
            "status": { "type": "string", "enum": ["proposed", "accepted", "revoked", "migrating"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "content_mapping_receipt": {
      "type": "object",
      "required": ["kind", "profile", "mimi_room_uri", "source_format", "target_format", "original_envelope_hash", "mapped_operation_id"],
      "properties": {
        "schema": { "const": "cx.schema.mimi_interop.v1" },
        "kind": { "const": "cx.mimi.mapping_receipt" },
        "profile": { "const": "cx.profile.mimi_interop.v1" },
        "mimi_room_uri": { "$ref": "#/$defs/mimi_uri" },
        "source_format": {
          "type": "string",
          "enum": [
            "application/mimi-content",
            "text/plain;charset=utf-8",
            "text/markdown;variant=GFM-MIMI",
            "application/vnd.contrix.content+json"
          ]
        },
        "target_format": {
          "type": "string",
          "enum": [
            "cx.message.create",
            "cx.message.revise",
            "cx.message.redact",
            "cx.reaction.add",
            "cx.reaction.remove",
            "cx.relation.create",
            "application/mimi-content",
            "application/vnd.contrix.content+json"
          ]
        },
        "original_envelope_hash": { "$ref": "#/$defs/hash" },
        "mapped_operation_id": { "type": "string" },
        "mimi_message_id": { "type": "string" },
        "contrix_event_id": { "type": "string", "pattern": "^cx:(evt|event):[0-9a-hjkmnp-z]{26}$" },
        "accepted_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
      },
      "additionalProperties": true
    }
  }
}
