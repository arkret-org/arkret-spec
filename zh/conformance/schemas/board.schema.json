{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/board.schema.json",
  "title": "Contrix Board",
  "type": "object",
  "required": ["id", "type", "schema", "space_id", "title", "board_kind", "created_by", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^cx:board:[0-9a-hjkmnp-z]{26}$" },
    "type": { "const": "board" },
    "schema": { "const": "cx.schema.board.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "summary": { "type": "string" },
    "board_kind": {
      "type": "string",
      "enum": ["kanban", "scrum", "review_queue", "intake", "custom"]
    },
    "default_view_id": { "type": "string", "pattern": "^cx:view:[0-9a-hjkmnp-z]{26}$" },
    "fields": { "type": "object" },
    "state": { "type": "string", "enum": ["active", "archived", "deleted"] },
    "created_by": { "$ref": "#/$defs/did" },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": true
}
