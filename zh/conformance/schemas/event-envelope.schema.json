{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrix.io/artifacts/schemas/event-envelope.schema.json",
  "title": "Contrix Event Envelope",
  "type": "object",
  "required": [
    "event_id", "kind", "space_id", "space_version", "actor_id", "actor_seq", "created_at",
    "hlc", "prev_refs", "auth_refs", "content", "proofs"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^cx:(evt|event):[0-9a-hjkmnp-z]{26}$" },
    "kind": { "type": "string", "pattern": "^cx\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "schema": { "const": "cx.schema.event.v1" },
    "space_id": { "type": "string", "pattern": "^cx:space:[0-9a-hjkmnp-z]{26}$" },
    "space_version": { "type": "string", "pattern": "^\\d+$" },
    "actor_id": { "$ref": "#/$defs/did" },
    "actor_seq": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "hlc": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{8}-[0-9a-f]{8}$" },
    "prev_refs": { "type": "array", "items": { "$ref": "#/$defs/eventRef" } },
    "auth_refs": { "type": "array", "items": { "type": "string", "pattern": "^cx:(evt|event|grant|policy):[0-9a-hjkmnp-z]{26}$" } },
    "redacts": { "$ref": "#/$defs/eventRef" },
    "content": { "type": "object" },
    "unsigned": { "type": "object" },
    "proofs": { "type": "array", "items": { "$ref": "#/$defs/proof" }, "minItems": 1 }
  },
  "$defs": {
    "did": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "eventRef": { "type": "string", "pattern": "^cx:(evt|event|operation):[0-9a-hjkmnp-z]{26}$" },
    "proof": {
      "type": "object",
      "required": ["kind", "alg", "verification_method", "payload_hash", "created_at", "jws"],
      "properties": {
        "kind": { "const": "detached_jws" },
        "alg": { "type": "string", "enum": ["EdDSA", "ES256", "ES384", "ES512"] },
        "verification_method": { "type": "string", "pattern": "^did:[a-z0-9:.\\-_]+:[^\\s]+(#.+)?$" },
        "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "domain": { "type": "string" },
        "audience": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "jws": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
